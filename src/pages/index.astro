---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroField from '../components/HeroField.astro';
import SimCard from '../components/SimCard.astro';
import TrailCard from '../components/TrailCard.astro';
import AreaIcon from '../components/AreaIcon.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { AREAS } from '../data/tools';
import { SIMS, TRAILS, newest, areaColor } from '../data/explore';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
const fresh = newest(4);
const count = (slug: string) => SIMS.filter((s) => s.area.slug === slug).length;
---

<BaseLayout wide mainClass="home">
  <section class="hero">
    <HeroField />
    <div class="hero-text">
      <h1>Math, made visual.</h1>
      <p class="lead">
        {SIMS.length} interactive simulations that teach the intuition behind
        calculus, linear algebra, deep learning, physics and more. Drag, tune
        and watch the maths move. Made for the classroom, open to everyone.
      </p>
      <div class="hero-actions">
        <a class="btn" href="/simulations">Browse simulations</a>
        <button type="button" class="btn ghost" data-search-open>
          Search <kbd data-search-kbd>Ctrl K</kbd>
        </button>
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="section-head">
      <h2>Areas</h2>
      <a href="/simulations">All {SIMS.length} →</a>
    </div>
    <div class="area-tiles">
      {
        AREAS.map((a) => (
          <a class="area-tile" href={`/simulations/${a.slug}`} style={`--area:${areaColor(a.slug)}`}>
            <AreaIcon area={a} size={36} />
            <span class="area-tile-text">
              <strong>{a.title}</strong>
              <span>{count(a.slug)} simulations</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  {
    fresh.length > 0 && (
      <section class="home-section">
        <div class="section-head">
          <h2>New</h2>
        </div>
        <div class="sim-grid">
          {fresh.map((s) => (
            <SimCard sim={s} showArea />
          ))}
        </div>
      </section>
    )
  }

  <section class="home-section">
    <div class="section-head">
      <h2>Paths</h2>
      <p>A few sims in an order where each one sets up the next.</p>
    </div>
    <div class="trail-grid">
      {TRAILS.slice(0, 6).map((t) => <TrailCard trail={t} />)}
    </div>
    <a class="section-more" href="/simulations#paths">All {TRAILS.length} paths →</a>
  </section>

  {
    posts.length > 0 && (
      <section class="home-section">
        <div class="section-head">
          <h2>Notes</h2>
          <a href="/archive">All notes →</a>
        </div>
        <ul class="note-list">
          {posts.map((p) => (
            <li>
              <a href={`/posts/${p.id}`}>
                <span class="note-title">{p.data.title}</span>
                {p.data.description && <span class="note-desc">{p.data.description}</span>}
                <FormattedDate date={p.data.date} />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
