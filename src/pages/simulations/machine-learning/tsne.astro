---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="machine-learning"
  title="t-SNE"
  description="How do you flatten a cloud of points without losing who sits next to whom? Tie every point to its neighbours with threads, throw them all on a page at random, and let the threads pull while every point pushes the others away. What settles is the t-SNE map."
  shortcuts={['run', 'reset', 'fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="tsne"
          width="1000"
          height="640"
          role="img"
          aria-label="A cloud of points in 3D, threads joining each point to its neighbours, and the same points being pulled into a flat t-SNE map."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'threads: who was near whom', color: '#9aa0ac' },
          { label: 'pull of the threads', color: '#5eead4' },
          { label: 'push from every other point', color: '#f9736a' },
        ]}
        hint="Scroll to zoom · drag to move · on the 3D cloud a drag turns it, shift-drag moves · double-click to reset · hover a point to see its neighbours"
      />
      <Result label="Neighbours kept on the map" />
    </div>

    <div class="sim-panel">
      <Seg
        id="ch"
        label="Chapter"
        attr="c"
        options={[
          { value: '0', label: '1 · The cloud' },
          { value: '1', label: '2 · Neighbours' },
          { value: '2', label: '3 · Flatten' },
          { value: '3', label: '4 · Pull &amp; push' },
          { value: '4', label: '5 · The map' },
        ]}
      />
      <Transport>
        <button type="button" class="btn ghost" id="next">Next chapter →</button>
      </Transport>
      <Seg
        id="data"
        label="Data"
        attr="d"
        options={[
          { value: 'clusters', label: 'Five clusters' },
          { value: 'rings', label: 'Linked rings' },
          { value: 'roll', label: 'Rolled sheet' },
        ]}
      />
      <Slider id="perp" label="Perplexity: neighbours per point" min={3} max={60} value={25} hint={['few, local', 'many, global']} />
      <Readout
        title="Now"
        rows={[
          { id: 'r-it', label: 'iteration' },
          { id: 'r-kl', label: 'mismatch KL(P ‖ Q)' },
          { id: 'r-sg', label: 'bubble sizes σ' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      In chapter 2 the bubbles are <b>not the same size</b>: each grows until it holds the same number of neighbours,
      so it stays small in a tight crowd and gets big in a loose one. <Try id="bubbles" />
    </li>
    <li>
      Straight after the random throw almost no neighbour is kept. Watch the number under the stage climb as the
      threads pull. <Try id="pull" />
    </li>
    <li>
      The loose cluster comes out the <b>same size</b> as the tight ones, and the gaps between clusters are whatever
      the push left them. Only who is next to whom is kept. <Try id="sizes" />
    </li>
    <li>
      Two rings linked like a chain cannot lie flat without crossing, but each ring is still a loop of neighbours:
      the map draws two separate circles. <Try id="rings" />
    </li>
    <li>
      With a perplexity of 3 every point only cares about its two or three closest friends, and the map falls apart
      into many small crumbs. <Try id="tiny" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk } from '../../../lib/draw';
  import { segmented, slider, result, readout, tries } from '../../../lib/panel';
  import { sqDistances, jointP, Embedding, EXAGGERATION } from '../../../lib/tsne';
  import { stageCamera } from '../../../lib/stage-camera';
  import { story, headline, say, glows, withAlpha, mix, isLight, ease, easeOut, beat, lerp, clamp01 } from '../../../lib/story';

  // The whole algorithm as one picture: points in 3D (so the reader can see
  // the truth), a bubble per point that picks its neighbours, threads for
  // those links, a random throw onto a page, and the optimisation as threads
  // pulling against everyone pushing. Exact t-SNE from lib/tsne.
  const PULL = '#5eead4', PUSH = '#f9736a', ACC = '#7c8cff';
  const END = 750;

  const canvas = document.getElementById('tsne') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas);
  const { ink, inv } = stageInk(canvas);
  const glow = glows();
  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  // ---------- data ----------
  const rng = (seed: number) => {
    let s = seed >>> 0 || 1;
    return () => (s = (s * 1664525 + 1013904223) >>> 0) / 4294967296;
  };
  const gauss = (r: () => number) => Math.sqrt(-2 * Math.log(r() + 1e-12)) * Math.cos(2 * Math.PI * r());

  type Pt = [number, number, number];
  type Data = { X: Pt[]; colour: string[] };

  function make(kind: string): Data {
    const r = rng(7), X: Pt[] = [], colour: string[] = [];
    if (kind === 'clusters') {
      const C: [Pt, number, string][] = [
        [[-1.25, 0.55, 0.35], 0.16, '#5eead4'],
        [[1.1, 0.75, -0.55], 0.2, '#7c8cff'],
        [[0.15, -0.65, 1.05], 0.4, '#fbbf24'],
        [[-0.5, -0.8, -1.0], 0.22, '#f472b6'],
        [[1.2, -0.6, 0.55], 0.16, '#a3e635'],
      ];
      for (const [c, s, col] of C)
        for (let k = 0; k < 60; k++) {
          X.push([c[0] + s * gauss(r), c[1] + s * gauss(r), c[2] + s * gauss(r)]);
          colour.push(col);
        }
    } else if (kind === 'rings') {
      for (let ring = 0; ring < 2; ring++)
        for (let k = 0; k < 150; k++) {
          const th = (2 * Math.PI * k) / 150 + 0.02 * gauss(r);
          const a = Math.cos(th), b = Math.sin(th), n = () => 0.05 * gauss(r);
          X.push(ring === 0 ? [-0.5 + a + n(), b + n(), n()] : [0.5 - a + n(), n(), b + n()]);
          const t = (1 + Math.cos(th)) / 2;
          colour.push(ring === 0 ? mix('#5eead4', '#7c8cff', t) : mix('#fbbf24', '#f472b6', t));
        }
    } else {
      for (let k = 0; k < 300; k++) {
        const u = r(), t = 1.5 * Math.PI * (1 + 2 * u);
        X.push([t * Math.cos(t) * 0.11, (r() - 0.5) * 1.6, t * Math.sin(t) * 0.11]);
        colour.push(u < 0.5 ? mix('#5eead4', '#7c8cff', u * 2) : mix('#7c8cff', '#f472b6', u * 2 - 1));
      }
    }
    // centre, and scale to a radius of 1.6
    const m = [0, 0, 0];
    X.forEach((p) => p.forEach((v, k) => (m[k] += v / X.length)));
    let R = 0;
    X.forEach((p) => { for (let k = 0; k < 3; k++) p[k] -= m[k]; R = Math.max(R, Math.hypot(...p)); });
    X.forEach((p) => { for (let k = 0; k < 3; k++) p[k] *= 1.6 / R; });
    return { X, colour };
  }

  const S = { data: 'clusters', perp: 25, ang: 0.6, tilt: 0.32, hover: -1 };
  let data = make(S.data);
  let N = data.X.length;
  // zoom and pan over the whole stage; a plain drag on the 3D cloud turns it instead
  const view = stageCamera(canvas, W, H, {
    canTurn: () => st.chapter() <= 1,
    turn: (dx, dy) => {
      S.ang += dx * 0.01;
      S.tilt = Math.max(-1.2, Math.min(1.2, S.tilt + dy * 0.01));
    },
  });
  let D = new Float64Array(0), P = new Float64Array(0), cond = new Float64Array(0), sigma = new Float64Array(0);
  let threads: [number, number, number][] = [];
  let near3: Set<number>[] = [];
  let focal: number[] = [];
  let emb: Embedding;
  let Y0 = new Float64Array(0);
  let kept = 0, keptAt = -1;
  let klNow = 0;
  let medSigma = 0;
  const K_KEEP = 10;

  function build() {
    data = make(S.data);
    N = data.X.length;
    D = sqDistances(data.X);
    const j = jointP(D, N, S.perp);
    P = j.P; cond = j.cond; sigma = j.sigma;
    // the strongest few links of every point, each pair once
    const seen = new Set<number>();
    threads = [];
    let pmax = 0;
    for (let i = 0; i < N; i++) {
      const order = Array.from({ length: N }, (_, k) => k).filter((k) => k !== i);
      order.sort((a, b) => P[i * N + b] - P[i * N + a]);
      for (const k of order.slice(0, 5)) {
        const key = Math.min(i, k) * N + Math.max(i, k);
        if (seen.has(key)) continue;
        seen.add(key);
        threads.push([i, k, P[i * N + k]]);
        pmax = Math.max(pmax, P[i * N + k]);
      }
    }
    threads.forEach((t) => (t[2] = Math.sqrt(t[2] / pmax)));
    near3 = Array.from({ length: N }, (_, i) => {
      const o = Array.from({ length: N }, (_, k) => k).filter((k) => k !== i);
      o.sort((a, b) => D[i * N + a] - D[i * N + b]);
      return new Set(o.slice(0, K_KEEP));
    });
    // three bubbles to show: the tightest crowd, the loosest, one in between
    const bySigma = Array.from({ length: N }, (_, i) => i).sort((a, b) => sigma[a] - sigma[b]);
    focal = [bySigma[Math.floor(N * 0.05)], bySigma[Math.floor(N * 0.97)], bySigma[Math.floor(N * 0.5)]];
    medSigma = sigma[bySigma[N >> 1]];
    restartMap();
  }

  function restartMap() {
    emb = new Embedding(P, N, 3);
    Y0 = Float64Array.from(emb.Y);
    keptAt = -1;
    fitScale(true);
  }

  /** Run the map to the end at once, for a reader who skips ahead. */
  function settle() {
    while (emb.iter < END) emb.step();
  }

  // ---------- views ----------
  /** 3D view: centre and pixels per unit. */
  const V3 = { cx: 610, cy: 385, s: 175 };
  function project(p: Pt, v = V3, ang = S.ang, tilt = S.tilt) {
    const ca = Math.cos(ang), sa = Math.sin(ang);
    const x = p[0] * ca + p[2] * sa, z = -p[0] * sa + p[2] * ca;
    const ct = Math.cos(tilt), st = Math.sin(tilt);
    const y = p[1] * ct - z * st, z2 = p[1] * st + z * ct;
    const f = 6 / (6 - z2);
    const px = v.cx + x * v.s * f, py = v.cy - y * v.s * f;
    // the inset keeps still; only the main view follows the camera
    return v === V3 ? { x: view.X(px), y: view.Y(py), z: z2, f } : { x: px, y: py, z: z2, f };
  }

  /** The flat page the map lives on. */
  const PAGE = { x: 40, y: 200, w: 920, h: 410 };
  const mapView = { cx: 500, cy: 405, s: 1, target: 1 };
  function fitScale(now = false, Y = emb.Y) {
    const xs: number[] = [], ys: number[] = [];
    for (let i = 0; i < N; i++) { xs.push(Math.abs(Y[2 * i])); ys.push(Math.abs(Y[2 * i + 1])); }
    xs.sort((a, b) => a - b); ys.sort((a, b) => a - b);
    const rx = xs[Math.floor(N * 0.99)] || 1, ry = ys[Math.floor(N * 0.99)] || 1;
    mapView.target = Math.min((PAGE.w / 2 - 40) / rx, (PAGE.h / 2 - 30) / ry);
    if (now) mapView.s = mapView.target;
  }
  const mapXY = (i: number, Y = emb.Y) => ({
    x: view.X(mapView.cx + Y[2 * i] * mapView.s),
    y: view.Y(mapView.cy - Y[2 * i + 1] * mapView.s),
  });

  // screen position of every point this frame, for threads and hovering
  const sx = new Float64Array(400), sy = new Float64Array(400), sr = new Float64Array(400), sa = new Float64Array(400);

  // ---------- chapters ----------
  const chapters = [
    {
      dur: 7,
      title: 'A cloud of points',
      body: 'Each point is a position in a space of many dimensions. Here there are only three, so you can watch. The goal: a flat map where every point keeps the same neighbours.',
    },
    {
      dur: 13,
      title: 'Each point picks its neighbours',
      body: 'Around every point a soft bubble grows until it holds a fixed number of neighbours (the perplexity). Crowded points get small bubbles, loners big ones. Each neighbour gets a thread.',
    },
    {
      dur: 4.2,
      title: 'Throw them on a page',
      body: 'Drop every point at a random spot on a flat page. The picture is now meaningless, but the threads still remember who was near whom.',
    },
    {
      dur: Infinity,
      title: 'Threads pull, everyone pushes',
      body: 'Each thread pulls its two points together. Every pair of points also pushes apart a little, so the page does not collapse into one dot. Repeat until the forces balance.',
    },
    {
      dur: Infinity,
      title: 'The map',
      body: 'Points that were neighbours in 3D are neighbours on the page. Sizes of the islands and the gaps between them are not to scale; only who is next to whom is kept.',
    },
  ];

  /** Seconds the throw waits for each point, so they land one after another. */
  const delay = (i: number) => ((i * 0.618034) % 1) * 0.9;
  let throwAng = 0;

  const st = story({
    chapters,
    enter(i) {
      if (i === 2) { throwAng = S.ang; restartMap(); }
      if (i === 3) restartMap();
      if (i === 4) { if (emb.iter < END) settle(); fitScale(true); }
      keptAt = -1;
    },
    done: (i, t) => (i === 3 ? emb.iter >= END : t >= chapters[i].dur),
    frame,
  });

  // ---------- drawing ----------
  /** Which space the stage shows: the 3D cloud or the page. Crossing over sends the camera home. */
  let world = 0;
  function frame(ch: number, t: number, dt: number) {
    const light = isLight(canvas);
    if (+(ch >= 2) !== world) { world = +(ch >= 2); view.home(); }
    view.tick();
    ctx.clearRect(0, 0, W, H);
    background(light);

    if (ch <= 1) S.ang += dt * 0.28 * (ch === 1 ? 0.35 : 1);
    if (ch === 3 && dt > 0) runMap(t, dt);
    if (ch >= 3) {
      fitScale();
      // zoom out at once when the map spreads, ease in when it shrinks
      mapView.s = mapView.target < mapView.s ? mapView.target : lerp(mapView.s, mapView.target, 0.2);
    }

    // where every point is this frame
    if (ch <= 1) {
      for (let i = 0; i < N; i++) {
        const p = project(data.X[i]);
        sx[i] = p.x; sy[i] = p.y; sr[i] = 3.1 * p.f; sa[i] = 0.55 + 0.45 * clamp01((p.z + 1.6) / 3.2);
      }
    } else if (ch === 2) {
      for (let i = 0; i < N; i++) {
        const p = project(data.X[i], V3, throwAng);
        const q = mapXY(i, Y0);
        const u = ease((t - delay(i)) / 1.7);
        sx[i] = lerp(p.x, q.x, u);
        sy[i] = lerp(p.y, q.y, u) - Math.sin(Math.PI * u) * 60;
        sr[i] = lerp(3.1 * p.f, 3.1, u);
        sa[i] = 1;
      }
    } else {
      for (let i = 0; i < N; i++) {
        const q = mapXY(i);
        sx[i] = q.x; sy[i] = q.y; sr[i] = 3.1; sa[i] = 1;
      }
    }

    if (ch <= 1) floor(ch === 0 ? 1 : 1 - beat(t, 0, 1) * 0.4);
    if (ch >= 2) page(ch === 2 ? beat(t, 0.6, 2.2) : 1, light);

    // on the page, a straggler far out is cut at the edge rather than drawn over the headline
    ctx.save();
    if (ch >= 3) {
      ctx.beginPath();
      ctx.roundRect(PAGE.x, PAGE.y, PAGE.w, PAGE.h, 14);
      ctx.clip();
    }

    // threads
    const threadA = ch === 1 ? beat(t, 10.2, 12.4) : ch === 4 ? 1 - 0.75 * beat(t, 0, 1.5) : ch >= 2 ? 1 : 0;
    if (threadA > 0) drawThreads(threadA * (ch === 1 ? 0.7 : 1), ch >= 2, light);

    if (ch === 1) bubbles(t, light);

    drawPoints(light, ch <= 1);

    if (ch === 3) forces(t);
    if (S.hover >= 0 && ch !== 1) hoverLinks(light);
    ctx.restore();
    if (ch === 4) inset(t, light);

    headline(ctx, ink, { index: ch, count: chapters.length, title: chapters[ch].title, body: chapters[ch].body, t, width: ch === 4 ? 640 : 470 });

    if (view.away) say(ctx, 'double-click to reset the view', W - 16, H - 14, { colour: ink(0.45), size: 12, align: 'right' });
    if (ch === 3) exaggerationBadge(light);
    if (ch >= 3) klSpark();
    panelText(ch);
    eqTick(ch);
  }

  function background(light: boolean) {
    if (light) return;
    const g = ctx.createRadialGradient(W * 0.6, H * 0.6, 50, W * 0.6, H * 0.6, W * 0.75);
    g.addColorStop(0, 'rgba(124,140,255,0.07)');
    g.addColorStop(1, 'rgba(124,140,255,0)');
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, W, H);
  }

  /** A faint grid under the 3D cloud, for depth. */
  function floor(a: number) {
    ctx.save();
    ctx.lineWidth = 1;
    ctx.strokeStyle = ink(0.06 * a);
    ctx.beginPath();
    for (let k = -4; k <= 4; k++) {
      for (const dir of [0, 1]) {
        const p1: Pt = dir ? [k * 0.45, -1.75, -1.8] : [-1.8, -1.75, k * 0.45];
        const p2: Pt = dir ? [k * 0.45, -1.75, 1.8] : [1.8, -1.75, k * 0.45];
        const A = project(p1), B = project(p2);
        ctx.moveTo(A.x, A.y);
        ctx.lineTo(B.x, B.y);
      }
    }
    ctx.stroke();
    ctx.restore();
  }

  function page(a: number, light: boolean) {
    if (a <= 0) return;
    ctx.save();
    ctx.globalAlpha = a;
    ctx.fillStyle = light ? 'rgba(28,30,36,0.03)' : 'rgba(255,255,255,0.025)';
    ctx.strokeStyle = ink(0.1);
    ctx.beginPath();
    ctx.roundRect(PAGE.x, PAGE.y, PAGE.w, PAGE.h, 14);
    ctx.fill();
    ctx.stroke();
    ctx.restore();
  }

  function drawThreads(a: number, flat: boolean, light: boolean) {
    ctx.save();
    if (!light) ctx.globalCompositeOperation = 'lighter';
    ctx.lineWidth = 1;
    for (const [i, j, w] of threads) {
      const len = Math.hypot(sx[i] - sx[j], sy[i] - sy[j]);
      // on the page a long thread is a stretched one: it glows with its tension
      const tension = flat ? clamp01(len / 160) : 0;
      const alpha = a * w * (flat ? 0.12 + 0.4 * tension : 0.35) * (light ? 1.6 : 1);
      if (alpha < 0.01) continue;
      ctx.strokeStyle = withAlpha(data.colour[i], alpha);
      ctx.beginPath();
      ctx.moveTo(sx[i], sy[i]);
      ctx.lineTo(sx[j], sy[j]);
      ctx.stroke();
    }
    ctx.restore();
  }

  function drawPoints(light: boolean, depthSort: boolean) {
    const idx = Array.from({ length: N }, (_, i) => i);
    if (depthSort) idx.sort((a, b) => sr[a] - sr[b]);
    ctx.save();
    // additive glow only for the loose 3D cloud: on the map a tight island would burn white
    if (!light && depthSort) ctx.globalCompositeOperation = 'lighter';
    // zoomed in, the dots grow a little, much less than the space between them
    const grow = Math.min(1.8, Math.max(0.7, Math.sqrt(view.z)));
    for (const i of idx) {
      const r = Math.round(sr[i] * grow * 2) / 2;
      const img = glow(data.colour[i], r, light);
      ctx.globalAlpha = sa[i];
      ctx.drawImage(img, sx[i] - img.width / 4, sy[i] - img.height / 4, img.width / 2, img.height / 2);
    }
    ctx.restore();
  }

  /** Chapter 2: a bubble grows around three points in turn, then every thread appears. */
  function bubbles(t: number, light: boolean) {
    const k = Math.floor(t / 3.4);
    const free = S.hover >= 0 && t > 10;
    if (k > 2 && !free) return;
    const i = free ? S.hover : focal[Math.min(2, k)];
    const tt = free ? 3 : t - k * 3.4;
    const grow = easeOut(tt / 1.3), fade = free ? 1 : 1 - beat(tt, 3.0, 3.4);
    if (fade <= 0) return;
    const p = project(data.X[i]);
    const R = Math.max(1, 2 * sigma[i] * V3.s * p.f * view.z * grow);
    const col = data.colour[i];
    ctx.save();
    const g = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, R);
    g.addColorStop(0, withAlpha(col, 0.28 * fade));
    g.addColorStop(0.7, withAlpha(col, 0.1 * fade));
    g.addColorStop(1, withAlpha(col, 0));
    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.arc(p.x, p.y, R, 0, Math.PI * 2);
    ctx.fill();
    ctx.strokeStyle = withAlpha(col, 0.55 * fade);
    ctx.setLineDash([4, 5]);
    ctx.beginPath();
    ctx.arc(p.x, p.y, R * 0.75, 0, Math.PI * 2);
    ctx.stroke();
    ctx.setLineDash([]);

    // the neighbours it picks, each thread as strong as its probability
    const lineA = beat(tt, 0.5, 1.5) * fade;
    let pm = 0;
    for (let j = 0; j < N; j++) pm = Math.max(pm, cond[i * N + j]);
    if (!light) ctx.globalCompositeOperation = 'lighter';
    for (let j = 0; j < N; j++) {
      const w = cond[i * N + j] / pm;
      if (w < 0.03) continue;
      ctx.strokeStyle = withAlpha(col, lineA * (0.15 + 0.75 * w));
      ctx.lineWidth = 0.6 + 1.8 * w;
      ctx.beginPath();
      ctx.moveTo(p.x, p.y);
      ctx.lineTo(sx[j], sy[j]);
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(sx[j], sy[j], 5 + 3 * w, 0, Math.PI * 2);
      ctx.strokeStyle = withAlpha(col, lineA * 0.8 * w);
      ctx.lineWidth = 1.2;
      ctx.stroke();
    }
    ctx.globalCompositeOperation = 'source-over';
    const crowd = sigma[i] < medSigma ? 'crowded: small bubble' : 'loose: big bubble';
    const lx = p.x + Math.max(R, 30) * 0.75 + 12, ly = p.y - Math.max(R, 30) * 0.5;
    say(ctx, crowd, lx, ly, { colour: col, size: 15, weight: 600, alpha: lineA, halo: inv(0.8) });
    say(ctx, `≈ ${S.perp} neighbours inside`, lx, ly + 20, { colour: ink(0.75), size: 13, alpha: lineA, halo: inv(0.8) });
    ctx.restore();
  }

  /** Iterations per second: slow at first so the forces can be seen, then fast. */
  let acc = 0;
  function runMap(t: number, dt: number) {
    const rate = t < 4 ? 6 : Math.min(160, 6 + (t - 4) ** 2 * 14);
    acc += rate * dt;
    while (acc >= 1 && emb.iter < END) {
      emb.step();
      acc -= 1;
    }
  }

  /** Chapter 4: the pull of one point's threads against the push of everyone. */
  function forces(t: number) {
    const a = S.hover >= 0 ? 1 : 1 - beat(t, 7, 8.5);
    if (a <= 0) return;
    const i = S.hover >= 0 ? S.hover : focal[1];
    const Y = emb.Y, ex = emb.exaggerating ? EXAGGERATION : 1;
    let ax = 0, ay = 0, rx = 0, ry = 0;
    for (let j = 0; j < N; j++) {
      if (j === i) continue;
      const n = emb.num[i * N + j];
      const dx = Y[2 * j] - Y[2 * i], dy = Y[2 * j + 1] - Y[2 * i + 1];
      ax += ex * P[i * N + j] * n * dx;
      ay += ex * P[i * N + j] * n * dy;
      rx -= ((n * n) / emb.Z) * dx;
      ry -= ((n * n) / emb.Z) * dy;
    }
    const big = Math.max(Math.hypot(ax, ay), Math.hypot(rx, ry), 1e-12);
    ctx.save();
    ctx.globalAlpha = a;
    // its threads, bright
    let pm = 0;
    for (let j = 0; j < N; j++) pm = Math.max(pm, P[i * N + j]);
    for (let j = 0; j < N; j++) {
      const w = P[i * N + j] / pm;
      if (w < 0.05) continue;
      ctx.strokeStyle = withAlpha(PULL, 0.15 + 0.6 * w);
      ctx.lineWidth = 0.8 + 1.5 * w;
      ctx.beginPath();
      ctx.moveTo(sx[i], sy[i]);
      ctx.lineTo(sx[j], sy[j]);
      ctx.stroke();
    }
    const fat = (dx: number, dy: number, col: string, label: string) => {
      const m = Math.hypot(dx, dy) / big;
      if (m < 0.02) return;
      const ux = dx / Math.hypot(dx, dy), uy = -dy / Math.hypot(dx, dy);
      const len = 18 + 90 * m;
      const x2 = sx[i] + ux * len, y2 = sy[i] + uy * len;
      ctx.strokeStyle = col;
      ctx.fillStyle = col;
      ctx.lineWidth = 4;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(sx[i], sy[i]);
      ctx.lineTo(x2 - ux * 8, y2 - uy * 8);
      ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(x2, y2);
      ctx.lineTo(x2 - ux * 14 - uy * 8, y2 - uy * 14 + ux * 8);
      ctx.lineTo(x2 - ux * 14 + uy * 8, y2 - uy * 14 - ux * 8);
      ctx.closePath();
      ctx.fill();
      say(ctx, label, x2 + ux * 12, y2 + uy * 12, {
        colour: col, size: 14, weight: 600, align: ux < -0.3 ? 'right' : ux > 0.3 ? 'left' : 'center', halo: inv(0.85),
      });
    };
    fat(ax, ay, PULL, 'pull of its threads');
    fat(rx, ry, PUSH, 'push from everyone');
    ctx.beginPath();
    ctx.arc(sx[i], sy[i], 9, 0, Math.PI * 2);
    ctx.strokeStyle = ink(0.9);
    ctx.lineWidth = 1.5;
    ctx.stroke();
    ctx.restore();
  }

  /** The hovered point's neighbours (from 3D), wherever they are drawn now. */
  function hoverLinks(light: boolean) {
    const i = S.hover;
    ctx.save();
    if (!light) ctx.globalCompositeOperation = 'lighter';
    ctx.strokeStyle = withAlpha(data.colour[i], 0.7);
    ctx.lineWidth = 1.4;
    for (const j of near3[i]) {
      ctx.beginPath();
      ctx.moveTo(sx[i], sy[i]);
      ctx.lineTo(sx[j], sy[j]);
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(sx[j], sy[j], 6, 0, Math.PI * 2);
      ctx.stroke();
    }
    ctx.restore();
    ctx.beginPath();
    ctx.arc(sx[i], sy[i], 9, 0, Math.PI * 2);
    ctx.strokeStyle = ink(0.9);
    ctx.lineWidth = 1.5;
    ctx.stroke();
  }

  /** Chapter 5: the 3D cloud again, small, turning, so the two can be compared. */
  const IN = { x: 740, y: 18, w: 240, h: 170 };
  function inset(t: number, light: boolean) {
    const a = beat(t, 0.3, 1.3);
    if (a <= 0) return;
    const v = { cx: IN.x + IN.w / 2, cy: IN.y + IN.h / 2 + 8, s: 52 };
    const ang = S.ang + t * 0.25;
    ctx.save();
    ctx.globalAlpha = a;
    ctx.fillStyle = light ? 'rgba(255,255,255,0.9)' : 'rgba(13,14,18,0.85)';
    ctx.strokeStyle = ink(0.12);
    ctx.beginPath();
    ctx.roundRect(IN.x, IN.y, IN.w, IN.h, 12);
    ctx.fill();
    ctx.stroke();
    say(ctx, 'the cloud it came from', IN.x + 12, IN.y + 16, { colour: ink(0.55), size: 12 });
    const pts = data.X.map((p, i) => ({ i, ...project(p, v, ang) })).sort((p, q) => p.z - q.z);
    if (!light) ctx.globalCompositeOperation = 'lighter';
    const hi = S.hover >= 0 ? near3[S.hover] : null;
    for (const p of pts) {
      const on = hi ? p.i === S.hover || hi.has(p.i) : true;
      ctx.globalAlpha = a * (on ? 0.9 : 0.15);
      ctx.fillStyle = data.colour[p.i];
      ctx.beginPath();
      ctx.arc(p.x, p.y, (p.i === S.hover ? 3.5 : 1.6) * p.f, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.restore();
  }

  function exaggerationBadge(light: boolean) {
    if (!emb.exaggerating || emb.iter === 0) return;
    const x = PAGE.x + 14, y = PAGE.y + PAGE.h - 24;
    ctx.save();
    ctx.fillStyle = light ? 'rgba(249,115,106,0.12)' : 'rgba(249,115,106,0.14)';
    ctx.beginPath();
    ctx.roundRect(x, y - 13, 360, 26, 13);
    ctx.fill();
    ctx.restore();
    say(ctx, `warm-up: threads pull ${EXAGGERATION}× harder, so groups form first`, x + 12, y, { colour: PUSH, size: 13, weight: 500 });
  }

  /** How wrong the map still is, as a small curve in the corner of the page. */
  function klSpark() {
    const h = emb.history;
    if (h.length < 2) return;
    const x0 = PAGE.x + PAGE.w - 190, y0 = PAGE.y + PAGE.h - 18, w = 170, hh = 46;
    const max = Math.max(...h.map((p) => p.kl));
    ctx.save();
    ctx.strokeStyle = withAlpha(ACC, 0.9);
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    h.forEach((p, k) => {
      const x = x0 + (p.iter / END) * w, y = y0 - (p.kl / max) * hh;
      k ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
    });
    ctx.stroke();
    ctx.restore();
    say(ctx, 'mismatch KL, falling', x0, y0 - hh - 10, { colour: ink(0.5), size: 12 });
  }

  // ---------- numbers ----------
  function keptNow(): number {
    if (keptAt === emb.iter) return kept;
    keptAt = emb.iter;
    let s = 0;
    const Y = emb.Y;
    const d: [number, number][] = [];
    for (let i = 0; i < N; i++) {
      d.length = 0;
      for (let j = 0; j < N; j++) {
        if (j === i) continue;
        d.push([(Y[2 * i] - Y[2 * j]) ** 2 + (Y[2 * i + 1] - Y[2 * j + 1]) ** 2, j]);
      }
      d.sort((a, b) => a[0] - b[0]);
      for (let k = 0; k < K_KEEP; k++) if (near3[i].has(d[k][1])) s++;
    }
    kept = s / (N * K_KEEP);
    klNow = emb.kl();
    return kept;
  }

  let tick = 0;
  const NOTE = `Of each point's ${K_KEEP} nearest neighbours in 3D, the share that are also among its ${K_KEEP} nearest on the page.`;
  function panelText(ch: number) {
    if (tick++ % 12) return;
    const sg = Array.from(sigma).sort((a, b) => a - b);
    setRows({
      'r-it': ch >= 2 ? `${emb.iter}` : '—',
      'r-kl': ch >= 2 ? klNow.toFixed(3) : '—',
      'r-sg': `${sg[Math.floor(N * 0.05)].toFixed(2)} to ${sg[Math.floor(N * 0.95)].toFixed(2)}`,
    });
    if (ch < 2) {
      setResult({ value: '100%', status: 'in 3D, by definition', note: NOTE });
      return;
    }
    const k = keptNow();
    setResult({
      value: `${Math.round(k * 100)}%`,
      status: ch === 2 ? 'thrown at random' : k > 0.6 ? 'neighbourhoods kept' : k > 0.25 ? 'coming together' : 'still a mess',
      note: NOTE,
      colour: ch > 2 && k > 0.6 ? PULL : undefined,
    });
  }

  type Part = string | [string, string];
  const EQ: Part[][] = [
    ['\\text{near in the cloud}', '\\;\\Longrightarrow\\;', '\\text{near on the page}'],
    [['p_{j|i}', ACC], '= \\dfrac{e^{-\\|x_i - x_j\\|^2/2\\sigma_i^2}}{\\sum_k e^{-\\|x_i - x_k\\|^2/2\\sigma_i^2}},', '\\quad 2^{H(p_{\\cdot|i})} = \\text{perplexity}'],
    ['y_i \\sim \\mathcal N(0,\\,10^{-4} I)', '\\quad\\text{(the threads } p_{ij} \\text{ stay)}'],
    ['\\dfrac{\\partial C}{\\partial y_i} = 4\\sum_j \\big(', ['p_{ij}', PULL], '-', ['q_{ij}', PUSH], '\\big)\\,\\dfrac{y_i - y_j}{1+\\|y_i-y_j\\|^2}'],
    ['C = \\mathrm{KL}(P\\,\\|\\,Q) = \\sum_{ij}', ['p_{ij}', PULL], '\\log', ['p_{ij}', PULL], '/', ['q_{ij}', PUSH]],
  ];
  let eqFor = -1;
  function eqTick(ch: number) {
    if (ch === eqFor) return;
    eqFor = ch;
    setEq({ rule: EQ[ch] });
  }

  // ---------- input ----------
  const toLocal = (e: PointerEvent) => {
    const b = canvas.getBoundingClientRect();
    return { x: ((e.clientX - b.left) / b.width) * W, y: ((e.clientY - b.top) / b.height) * H };
  };
  canvas.addEventListener('pointerleave', () => (S.hover = -1));
  canvas.addEventListener('pointermove', (e) => {
    if (view.busy) return;
    const p = toLocal(e);
    let best = -1, bd = 14 * 14;
    for (let i = 0; i < N; i++) {
      const d = (sx[i] - p.x) ** 2 + (sy[i] - p.y) ** 2;
      if (d < bd) { bd = d; best = i; }
    }
    S.hover = best;
  });

  // ---------- panel ----------
  const dataSeg = segmented('data', (v) => { S.data = v; rebuild(); });
  const setPerp = slider('perp', (v) => { S.perp = v; rebuild(); });

  /** New data or perplexity: keep the chapter, redo what it shows. */
  function rebuild() {
    build();
    const c = st.chapter();
    if (c >= 2) st.go(c);
  }

  tries({
    bubbles: () => { st.go(1); st.play(true); },
    pull: () => { st.go(3); st.play(true); },
    sizes: () => { dataSeg.select('clusters'); S.data = 'clusters'; S.perp = 25; setPerp(25); rebuild(); st.go(4); },
    rings: () => { dataSeg.select('rings'); S.data = 'rings'; rebuild(); st.go(0); st.play(true); },
    tiny: () => { S.perp = 3; setPerp(3); rebuild(); st.go(3); st.play(true); },
  });

  build();
  st.start();
</script>
