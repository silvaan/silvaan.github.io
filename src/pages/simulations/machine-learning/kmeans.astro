---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Transport from '../../../components/sim/Transport.astro';
import Actions from '../../../components/sim/Actions.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="machine-learning"
  title="k-Means"
  description="Pick k centers, colour each point by its nearest one, move each center to the mean of its points, and repeat."
  standard
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="km"
          width="1000"
          height="600"
          role="img"
          aria-label="Points coloured by their nearest cluster center, with the centers drawn as large discs."
        ></canvas>
      </div>
      <Caption hint="Click the canvas to add a point" />
      <Result label="Inertia J" />
    </div>

    <div class="sim-panel">
      <Transport step />
      <Actions>
        <button type="button" class="btn ghost" id="regen">Random points</button>
        <button type="button" class="btn ghost" id="clear">Clear points</button>
      </Actions>
      <Slider id="k" label="Clusters k" min={2} max={6} value={3} />
      <Seg
        id="data"
        label="Random data"
        attr="d"
        options={[
          { value: 'blobs', label: 'Blobs' },
          { value: 'uniform', label: 'Uniform' },
          { value: 'moons', label: 'Moons' },
        ]}
      />
      <Readout
        rows={[
          { id: 'r-iter', label: 'iteration' },
          { id: 'r-next', label: 'next step' },
          { id: 'r-points', label: 'points' },
          { id: 'r-status', label: 'status' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Press <b>Step</b> a few times. The two halves of the loop take turns: each
      center slides to the mean of its color, then every point is recolored to
      its nearest center. <Try id="step" label="Step" />
    </li>
    <li>
      Hit <b>Reset</b> a few times on the same points. k-means can settle into
      <b>different</b> groupings, because it finds a local minimum of J, not the
      global one. <Try id="local" />
    </li>
    <li>
      On <b>Moons</b> k-means insists on round, straight-edged clusters and cuts
      each crescent in half: the blind spot DBSCAN fixes. <Try id="moons" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk } from '../../../lib/draw';
  import { el, segmented, slider, transport, result, readout, tries } from '../../../lib/panel';

  type P = { x: number; y: number };
  const PALETTE = ['#7c8cff', '#f59e0b', '#2dd4bf', '#f87171', '#a78bfa', '#34d399'];

  // the loop alternates two half-steps: 'update' moves the centers, 'assign' recolors the points
  type Phase = 'update' | 'assign';
  const state = { k: 3, data: 'blobs', running: false, iter: 0, moved: Infinity, changed: Infinity, phase: 'update' as Phase };
  let pts: P[] = [];
  let centers: P[] = [];
  let assign: number[] = [];

  const canvas = el('km') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink } = stageInk(canvas);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();
  const PAD = 40;
  const rnd = (a: number, b: number) => a + Math.random() * (b - a);

  function genData() {
    pts = [];
    if (state.data === 'uniform') {
      for (let i = 0; i < 300; i++) pts.push({ x: rnd(PAD, W - PAD), y: rnd(PAD, H - PAD) });
    } else if (state.data === 'moons') {
      for (let i = 0; i < 150; i++) {
        const t = Math.PI * (i / 150);
        const r = 190 + rnd(-14, 14);
        pts.push({ x: W / 2 + r * Math.cos(t) - 95, y: H / 2 - r * Math.sin(t) + 60 });
        pts.push({ x: W / 2 + r * Math.cos(t) + 95, y: H / 2 + r * Math.sin(t) - 60 });
      }
    } else {
      const nb = 4;
      const bc = Array.from({ length: nb }, () => ({ x: rnd(PAD + 80, W - PAD - 80), y: rnd(PAD + 70, H - PAD - 70) }));
      for (let i = 0; i < 300; i++) {
        const b = bc[i % nb];
        pts.push({ x: b.x + rnd(-55, 55) + rnd(-20, 20), y: b.y + rnd(-55, 55) + rnd(-20, 20) });
      }
    }
  }

  function initCenters() {
    centers = [];
    state.iter = 0;
    state.moved = Infinity;
    state.changed = Infinity;
    state.phase = 'update';
    if (pts.length === 0) { assign = []; return; }
    const used = new Set<number>();
    let guard = 0;
    while (centers.length < state.k && guard++ < 1000) {
      const i = Math.floor(Math.random() * pts.length);
      if (used.has(i)) continue;
      used.add(i);
      centers.push({ ...pts[i] });
    }
    reassign();
  }

  function nearest(p: P) {
    let best = 0, bd = Infinity;
    for (let c = 0; c < centers.length; c++) {
      const d = (p.x - centers[c].x) ** 2 + (p.y - centers[c].y) ** 2;
      if (d < bd) { bd = d; best = c; }
    }
    return best;
  }
  /** Recolor every point to its nearest center; returns how many changed color. */
  function reassign() {
    const next = pts.map((p) => (centers.length ? nearest(p) : -1));
    let changed = 0;
    next.forEach((a, i) => (changed += a !== assign[i] ? 1 : 0));
    assign = next;
    return changed;
  }

  /** Half a round: either move the centers or recolor the points, taking turns. */
  function stepOnce() {
    if (!centers.length || !pts.length) return;
    if (state.phase === 'assign') {
      state.changed = reassign();
      state.phase = 'update';
      return;
    }
    // points added since the last recolor have no color yet
    if (assign.some((a) => a < 0)) reassign();
    const sum = centers.map(() => ({ x: 0, y: 0, n: 0 }));
    for (let i = 0; i < pts.length; i++) {
      const a = assign[i];
      sum[a].x += pts[i].x;
      sum[a].y += pts[i].y;
      sum[a].n++;
    }
    let moved = 0;
    for (let c = 0; c < centers.length; c++) {
      if (sum[c].n === 0) continue;
      const tx = sum[c].x / sum[c].n, ty = sum[c].y / sum[c].n;
      moved += Math.hypot(tx - centers[c].x, ty - centers[c].y);
      centers[c].x = tx;
      centers[c].y = ty;
    }
    state.iter++;
    state.moved = moved;
    state.phase = 'assign';
  }

  /** Nothing left to do: the centers stopped, or a recolor changed no point. */
  const converged = () => centers.length > 0 && (state.moved < 0.5 || state.changed === 0);

  /** Mean squared distance from each point to its center, in pixels². */
  function inertia() {
    if (!centers.length || !pts.length) return 0;
    let s = 0;
    for (let i = 0; i < pts.length; i++) {
      const c = centers[assign[i]];
      s += (pts[i].x - c.x) ** 2 + (pts[i].y - c.y) ** 2;
    }
    return s / pts.length;
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    if (centers.length) {
      const cell = W / 60;
      for (let i = 0; i < 60; i++)
        for (let j = 0; j < Math.ceil(H / cell); j++) {
          const c = nearest({ x: (i + 0.5) * cell, y: (j + 0.5) * cell });
          ctx.fillStyle = PALETTE[c % PALETTE.length] + '18';
          ctx.fillRect(i * cell, j * cell, cell + 1, cell + 1);
        }
    }
    for (let i = 0; i < pts.length; i++) {
      ctx.fillStyle = assign[i] >= 0 ? PALETTE[assign[i] % PALETTE.length] : ink(0.55);
      ctx.beginPath();
      ctx.arc(pts[i].x, pts[i].y, 3.6, 0, Math.PI * 2);
      ctx.fill();
    }
    for (let c = 0; c < centers.length; c++) {
      ctx.fillStyle = PALETTE[c % PALETTE.length];
      ctx.strokeStyle = ink(1);
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.arc(centers[c].x, centers[c].y, 9, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
    }
    words();
  }

  function words() {
    const J = inertia();
    const done = converged();
    const next = state.phase === 'update' ? 'move centers' : 'recolor points';
    const empty = pts.length === 0;
    setEq({
      rule: ['J = \\frac{1}{n}\\sum_{i=1}^{n} \\lVert x_i - \\mu_{c(i)} \\rVert^2'],
      live: [`J = ${empty ? '—' : J.toFixed(0)}\\;\\text{px}^2`, `\\quad n = ${pts.length}`, `\\quad k = ${state.k}`],
    });
    setResult({
      value: empty ? '—' : J.toFixed(0),
      status: empty ? 'No points yet' : done ? `Iteration ${state.iter} · converged` : `Iteration ${state.iter} · next: ${next}`,
      note: empty
        ? 'Click the canvas to add points, or generate random data.'
        : 'Each round can only lower J, so it stops at a local minimum, not necessarily the best one.',
    });
    setRows({
      'r-iter': String(state.iter),
      'r-points': String(pts.length),
      'r-next': empty || done ? '—' : next,
      'r-status': empty ? 'empty' : done ? 'converged' : state.running ? 'running' : 'ready',
    });
  }

  // --- loop ---------------------------------------------------------------------------

  let acc = 0, last = 0;
  function loop(ts: number) {
    if (!last) last = ts;
    const dt = (ts - last) / 1000;
    last = ts;
    if (state.running) {
      acc += dt;
      if (acc >= 0.35) {
        acc = 0;
        stepOnce();
        if (converged()) {
          state.running = false;
          controls.setRunning(false);
        }
      }
    }
    draw();
    requestAnimationFrame(loop);
  }

  // --- controls ------------------------------------------------------------------------

  const controls = transport({
    onRun: (running) => {
      if (!centers.length) initCenters();
      state.running = running;
    },
    onStep: () => {
      if (!centers.length) initCenters();
      else stepOnce();
    },
    onReset: () => {
      state.running = false;
      controls.setRunning(false);
      initCenters();
    },
  });
  el('regen').addEventListener('click', () => {
    genData();
    initCenters();
  });
  el('clear').addEventListener('click', () => {
    pts = []; centers = []; assign = [];
    state.iter = 0;
    state.running = false;
    controls.setRunning(false);
  });
  const dataSeg = segmented('data', (d) => { state.data = d; genData(); initCenters(); });
  const setK = slider('k', (v) => { state.k = v; initCenters(); });

  canvas.addEventListener('pointerdown', (e) => {
    const rect = canvas.getBoundingClientRect();
    const p = { x: ((e.clientX - rect.left) / rect.width) * W, y: ((e.clientY - rect.top) / rect.height) * H };
    pts.push(p);
    assign.push(centers.length ? nearest(p) : -1);
    state.moved = Infinity;
    state.changed = Infinity;
  });

  function setup(data: string, k: number, run: boolean) {
    state.data = data;
    dataSeg.select(data);
    state.k = k;
    setK(k);
    genData();
    initCenters();
    state.running = run;
    controls.setRunning(run);
  }
  tries({
    step: () => {
      if (!pts.length) setup('blobs', 3, false);
      state.running = false;
      controls.setRunning(false);
      stepOnce();
    },
    local: () => setup('blobs', 3, true),
    moons: () => setup('moons', 2, true),
  });

  genData();
  initCenters();
  requestAnimationFrame(loop);
</script>

<style>
  #km {
    cursor: crosshair;
  }
</style>
