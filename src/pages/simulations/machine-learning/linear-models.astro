---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
import Actions from '../../../components/sim/Actions.astro';
import Checks from '../../../components/sim/Checks.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="machine-learning"
  title="Linear Models"
  description="Linear and logistic regression score the input with the same line, z = wx + b. Draw each residual as a literal square, snap to the least-squares optimum, and watch the same descent fit both models."
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="lm"
          width="1000"
          height="600"
          role="img"
          aria-label="Data points with a fitted line or logistic curve, and the error each point contributes drawn as a vertical gap."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'data', color: '#7c8cff', id: 'legend-data' },
          { label: 'class 1', color: '#5eead4', id: 'legend-class' },
          { label: 'the model', color: '#fbbf24' },
          { label: 'the gap the loss measures', color: '#f87171' },
          { label: 'mean point (x̄, ȳ)', color: '#5eead4', id: 'legend-mean' },
        ]}
        hint="Drag a point to move it · click empty space to add one"
      />
      <Result label="Loss, squared error" />
    </div>

    <div class="sim-panel">
      <Seg id="mode" label="Model" attr="m" options={[{ value: 'reg', label: 'Regression' }, { value: 'clf', label: 'Classification' }]} />
      <Transport step>
        <button type="button" class="btn ghost" id="newdata">New data</button>
      </Transport>
      <Slider id="w" label="Weight w" min={-200} max={500} value={0} display="0.00" />
      <Slider id="b" label="Bias b" min={-300} max={300} value={0} display="0.00" />
      <div id="reg-tools" style="display: contents">
        <Actions>
          <button type="button" class="btn ghost" id="snap">Snap to least squares</button>
        </Actions>
        <Checks
          items={[
            { id: 'squares', label: 'Draw the residuals as squares', checked: true },
            { id: 'ghost', label: 'Show the least-squares line' },
          ]}
        />
      </div>
      <Readout
        rows={[
          { id: 'r-fit', label: 'R²' },
          { id: 'r-sse', label: 'sum of squares Σr²' },
          { id: 'r-opt', label: 'least-squares optimum' },
          { id: 'r-steps', label: 'descent steps' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Switch the <b>Model</b>. The score z = wx + b is the same line either way:
      regression hands it back as the answer, classification squashes it into a
      probability between 0 and 1. <Try id="clf" />
    </li>
    <li>
      Press <b>Run</b> in either model. One descent loop fits both, because the
      gradient comes out identical: (prediction − y)·x, averaged over the points.
      <Try id="run" label="Run" />
    </li>
    <li>
      Each residual is drawn as a square. Tilt the line and the squares grow;
      <b>Snap to least squares</b> gives the smallest total area, and that line
      passes through the mean point (x̄, ȳ). <Try id="worse" />
    </li>
    <li>
      Drag one point far off the trend. Its square dwarfs the rest, so the
      optimum swings toward it: least squares is not <b>robust</b>.
      <Try id="outlier" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk, fixed } from '../../../lib/draw';
  import { el, segmented, slider, check, transport, result, readout, tries } from '../../../lib/panel';

  type Pt = { x: number; y: number };
  type Mode = 'reg' | 'clf';

  const PAD = { l: 56, r: 30, t: 30, b: 46 };
  const XR = [-4, 4] as const;
  const YRR = [-5, 5] as const; // targets, regression
  const YRC = [-0.3, 1.3] as const; // targets, classification
  const LR = 0.3;
  const C0 = '#7c8cff', C1 = '#5eead4', MODEL = '#fbbf24', ERR = '#f87171', MEAN = '#5eead4';

  const state = { mode: 'reg' as Mode, w: 0, b: 0, running: false, steps: 0, seed: 7, squares: true, ghost: false };
  const DATA: Record<Mode, Pt[]> = { reg: [], clf: [] };

  const canvas = el('lm') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink, bg } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));
  const sig = (z: number) => 1 / (1 + Math.exp(-z));
  const pts = () => DATA[state.mode];
  const yr = () => (state.mode === 'reg' ? YRR : YRC);
  const sx = (x: number) => PAD.l + ((x - XR[0]) / (XR[1] - XR[0])) * (W - PAD.l - PAD.r);
  const sy = (y: number) => { const [lo, hi] = yr(); return H - PAD.b - ((y - lo) / (hi - lo)) * (H - PAD.t - PAD.b); };
  const dx = (px: number) => XR[0] + ((px - PAD.l) / (W - PAD.l - PAD.r)) * (XR[1] - XR[0]);
  const dy = (py: number) => { const [lo, hi] = yr(); return lo + ((H - PAD.b - py) / (H - PAD.t - PAD.b)) * (hi - lo); };

  function genData() {
    let s = state.seed >>> 0;
    const r = () => ((s = (s * 1664525 + 1013904223) >>> 0), s / 4294967296);
    const g = () => Math.sqrt(-2 * Math.log(Math.max(1e-9, r()))) * Math.cos(2 * Math.PI * r());
    const reg: Pt[] = [];
    for (let i = 0; i < 18; i++) {
      const x = -3.2 + (6.4 * (i + 0.5)) / 18 + (r() - 0.5) * 0.2;
      reg.push({ x, y: clamp(1.05 * x + 0.5 + g() * 0.5, -4.6, 4.6) });
    }
    const clf: Pt[] = [];
    for (let i = 0; i < 9; i++) {
      clf.push({ x: clamp(-1.4 + g() * 0.9, -3.6, 3.6), y: 0 });
      clf.push({ x: clamp(1.4 + g() * 0.9, -3.6, 3.6), y: 1 });
    }
    DATA.reg = reg;
    DATA.clf = clf;
  }

  function evalModel(w: number, b: number) {
    const P = pts();
    const pred: number[] = [];
    let L = 0, gw = 0, gb = 0;
    for (const p of P) {
      const z = w * p.x + b;
      if (state.mode === 'reg') {
        const e = z - p.y;
        pred.push(z);
        L += 0.5 * e * e;
        gw += e * p.x;
        gb += e;
      } else {
        const q = clamp(sig(z), 1e-9, 1 - 1e-9);
        pred.push(q);
        L += -(p.y * Math.log(q) + (1 - p.y) * Math.log(1 - q));
        gw += (q - p.y) * p.x;
        gb += q - p.y;
      }
    }
    const n = Math.max(1, P.length);
    return { L: L / n, gw: gw / n, gb: gb / n, pred };
  }
  /** The closed-form least-squares line for the regression points, and their mean point. */
  function ols() {
    const P = DATA.reg, n = P.length;
    if (!n) return null;
    let mx = 0, my = 0;
    for (const p of P) { mx += p.x; my += p.y; }
    mx /= n; my /= n;
    let sxx = 0, sxy = 0;
    for (const p of P) { sxx += (p.x - mx) ** 2; sxy += (p.x - mx) * (p.y - my); }
    if (n < 2 || sxx < 1e-9) return { mx, my, w: NaN, b: NaN, sse: NaN };
    const w = sxy / sxx, b = my - w * mx;
    let sse = 0;
    for (const p of P) sse += (p.y - (w * p.x + b)) ** 2;
    return { mx, my, w, b, sse };
  }

  /** R² for regression, plain accuracy for classification. */
  function quality(pred: number[]) {
    const P = pts();
    if (!P.length) return NaN;
    if (state.mode === 'clf') {
      let ok = 0;
      P.forEach((p, i) => (ok += (pred[i] > 0.5 ? 1 : 0) === p.y ? 1 : 0));
      return ok / P.length;
    }
    const mean = P.reduce((s, p) => s + p.y, 0) / P.length;
    let sse = 0, sst = 0;
    P.forEach((p, i) => { sse += (p.y - pred[i]) ** 2; sst += (p.y - mean) ** 2; });
    return sst < 1e-9 ? 1 : 1 - sse / sst;
  }

  function draw() {
    const reg = state.mode === 'reg';
    const P = pts();
    const r = evalModel(state.w, state.b);
    ctx.clearRect(0, 0, W, H);

    ctx.strokeStyle = ink(0.07);
    ctx.lineWidth = 1;
    for (let x = -3; x <= 3; x++) {
      ctx.beginPath();
      ctx.moveTo(sx(x), PAD.t);
      ctx.lineTo(sx(x), H - PAD.b);
      ctx.stroke();
    }
    const yticks = reg ? [-4, -2, 0, 2, 4] : [0, 0.5, 1];
    for (const y of yticks) {
      ctx.beginPath();
      ctx.moveTo(PAD.l, sy(y));
      ctx.lineTo(W - PAD.r, sy(y));
      ctx.stroke();
    }
    ctx.strokeStyle = ink(0.13);
    ctx.strokeRect(PAD.l + 0.5, PAD.t + 0.5, W - PAD.l - PAD.r, H - PAD.t - PAD.b);
    for (let x = -3; x <= 3; x++) label(String(x), sx(x), H - PAD.b + 19, 0.4, 'center', 11);
    for (const y of yticks) label(reg ? String(y) : y.toFixed(1), PAD.l - 9, sy(y) + 4, 0.4, 'right', 11);
    label('x', W - PAD.r, H - PAD.b + 19, 0.5, 'right', 11);
    label(reg ? 'y' : 'class', PAD.l - 9, PAD.t + 2, 0.5, 'right', 11);

    const opt = reg ? ols() : null;
    // in regression each residual is also drawn as a literal square of side |ŷ − y|
    if (reg && state.squares) {
      ctx.save();
      ctx.beginPath();
      ctx.rect(PAD.l, PAD.t, W - PAD.l - PAD.r, H - PAD.t - PAD.b);
      ctx.clip();
      ctx.fillStyle = `${ERR}24`;
      ctx.strokeStyle = `${ERR}66`;
      ctx.lineWidth = 1;
      P.forEach((p, i) => {
        const a = sy(p.y), c = sy(r.pred[i]);
        const side = Math.abs(a - c);
        const dir = p.y >= r.pred[i] ? 1 : -1;
        ctx.fillRect(sx(p.x), Math.min(a, c), dir * side, side);
        ctx.strokeRect(sx(p.x), Math.min(a, c), dir * side, side);
      });
      ctx.restore();
    }

    // the gap each point contributes to the loss
    ctx.strokeStyle = `${ERR}80`;
    ctx.lineWidth = 1.6;
    P.forEach((p, i) => {
      ctx.beginPath();
      ctx.moveTo(sx(p.x), sy(p.y));
      ctx.lineTo(sx(p.x), sy(clamp(r.pred[i], yr()[0], yr()[1])));
      ctx.stroke();
    });

    ctx.save();
    ctx.beginPath();
    ctx.rect(PAD.l, PAD.t, W - PAD.l - PAD.r, H - PAD.t - PAD.b);
    ctx.clip();
    if (opt && state.ghost && Number.isFinite(opt.w)) {
      ctx.setLineDash([7, 6]);
      ctx.strokeStyle = ink(0.45);
      ctx.lineWidth = 1.6;
      ctx.beginPath();
      ctx.moveTo(sx(XR[0]), sy(opt.w * XR[0] + opt.b));
      ctx.lineTo(sx(XR[1]), sy(opt.w * XR[1] + opt.b));
      ctx.stroke();
      ctx.setLineDash([]);
    }
    ctx.strokeStyle = MODEL;
    ctx.lineWidth = 2.6;
    ctx.beginPath();
    for (let i = 0; i <= 200; i++) {
      const x = XR[0] + ((XR[1] - XR[0]) * i) / 200;
      const z = state.w * x + state.b;
      const py = sy(reg ? z : sig(z));
      i ? ctx.lineTo(sx(x), py) : ctx.moveTo(sx(x), py);
    }
    ctx.stroke();
    ctx.restore();

    if (!reg && Math.abs(state.w) > 1e-6) {
      const xb = -state.b / state.w;
      if (xb > XR[0] && xb < XR[1]) {
        ctx.setLineDash([5, 5]);
        ctx.strokeStyle = ink(0.4);
        ctx.lineWidth = 1.4;
        ctx.beginPath();
        ctx.moveTo(sx(xb), PAD.t);
        ctx.lineTo(sx(xb), H - PAD.b);
        ctx.stroke();
        ctx.setLineDash([]);
        label('z = 0', sx(xb) + 7, PAD.t + 15, 0.45, 'left', 11);
      }
    }
    for (const p of P) {
      ctx.fillStyle = reg ? C0 : p.y > 0.5 ? C1 : C0;
      ctx.strokeStyle = bg();
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(sx(p.x), sy(p.y), 6, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
    }
    if (opt) {
      ctx.fillStyle = MEAN;
      ctx.strokeStyle = bg();
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(sx(opt.mx), sy(opt.my), 5, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
      label('(x̄, ȳ)', sx(opt.mx) + 9, sy(opt.my) - 8, 0.6, 'left', 11, MEAN);
    }
    words(r, opt);
  }

  function words(r: ReturnType<typeof evalModel>, opt: ReturnType<typeof ols>) {
    const reg = state.mode === 'reg';
    const n = pts().length;
    const q = quality(r.pred);
    const sign = state.b >= 0 ? '+' : '-';
    setEq({
      rule: [
        ['z = wx + b', C0],
        reg ? ['\\qquad\\hat y = z', MODEL] : ['\\qquad p = \\sigma(z)', MODEL],
        reg ? ['\\qquad L = \\tfrac{1}{2n}\\sum (\\hat y - y)^2', ERR] : ['\\qquad L = -\\tfrac{1}{n}\\sum \\log p_{\\text{correct}}', ERR],
      ],
      live: [
        [`z = ${state.w.toFixed(2)}x ${sign} ${Math.abs(state.b).toFixed(2)}`, C0],
        `\\quad L = ${fixed(r.L, 4)}`,
        [`\\quad \\nabla_w = \\overline{(\\text{pred}-y)\\,x} = ${fixed(r.gw, 3)}`, ERR],
      ],
    });
    el('result-label').textContent = reg ? 'Loss, squared error' : 'Loss, log-loss';
    const sse = 2 * n * r.L; // L is half the mean squared error
    const optSse = opt && Number.isFinite(opt.sse) ? opt.sse : NaN;
    const gap = sse - optSse;
    setResult({
      value: n ? fixed(r.L, 4) : '—',
      colour: ERR,
      status: Number.isNaN(q) ? 'Add some points' : reg ? `R² = ${q.toFixed(3)} · ${state.steps} descent steps` : `Accuracy ${(q * 100).toFixed(0)}% · ${state.steps} descent steps`,
      note: reg
        ? Number.isFinite(gap)
          ? gap < 1e-3 * Math.max(1, optSse)
            ? 'At the least-squares optimum: no line gives the squares a smaller total area, and it passes through (x̄, ȳ).'
            : `The squares total ${sse.toFixed(2)}, which is ${gap.toFixed(2)} more than the least-squares line manages.`
          : 'The prediction is the score itself, and the error it is scored on is squared.'
        : 'The score is squashed into a probability, yet the gradient formula is unchanged.',
    });
    el('r-fit').previousElementSibling!.textContent = reg ? 'R²' : 'accuracy';
    setRows({
      'r-fit': Number.isNaN(q) ? '—' : reg ? q.toFixed(3) : `${(q * 100).toFixed(0)}%`,
      'r-sse': reg && n ? sse.toFixed(3) : '—',
      'r-opt': reg && Number.isFinite(optSse) ? optSse.toFixed(3) : '—',
      'r-steps': String(state.steps),
    });
  }

  // ---- descent ------------------------------------------------------------
  function stepOnce() {
    if (!pts().length) return 0;
    const r = evalModel(state.w, state.b);
    state.w = clamp(state.w - LR * r.gw, -50, 50);
    state.b = clamp(state.b - LR * r.gb, -50, 50);
    state.steps++;
    syncSliders();
    return Math.hypot(r.gw, r.gb);
  }
  function stopRun() {
    state.running = false;
    controls.setRunning(false);
  }
  function resetWeights() {
    state.w = 0;
    state.b = 0;
    state.steps = 0;
    stopRun();
    syncSliders();
  }

  // ---- interaction --------------------------------------------------------
  let drag = -1;
  const snap = (py: number) => (state.mode === 'reg' ? clamp(dy(py), YRR[0], YRR[1]) : dy(py) > 0.5 ? 1 : 0);
  const at = (e: PointerEvent) => {
    const rect = canvas.getBoundingClientRect();
    return { x: ((e.clientX - rect.left) / rect.width) * W, y: ((e.clientY - rect.top) / rect.height) * H };
  };
  canvas.addEventListener('pointerdown', (e) => {
    const { x, y } = at(e);
    if (x < PAD.l - 12 || x > W - PAD.r + 12 || y < PAD.t - 12 || y > H - PAD.b + 12) return;
    canvas.setPointerCapture(e.pointerId);
    const P = pts();
    let best = -1, bd = 16 * 16;
    P.forEach((p, i) => {
      const d = (sx(p.x) - x) ** 2 + (sy(p.y) - y) ** 2;
      if (d < bd) { bd = d; best = i; }
    });
    if (best >= 0) { drag = best; return; }
    P.push({ x: clamp(dx(x), XR[0], XR[1]), y: snap(y) });
    drag = P.length - 1;
    draw();
  });
  canvas.addEventListener('pointermove', (e) => {
    if (drag < 0) return;
    const { x, y } = at(e);
    pts()[drag] = { x: clamp(dx(x), XR[0], XR[1]), y: snap(y) };
    draw();
  });
  const endDrag = () => (drag = -1);
  canvas.addEventListener('pointerup', endDrag);
  canvas.addEventListener('pointercancel', endDrag);

  // ---- controls -----------------------------------------------------------
  const setW = slider('w', (v) => { state.w = v / 100; state.steps = 0; stopRun(); draw(); }, (v) => (v / 100).toFixed(2));
  const setB = slider('b', (v) => { state.b = v / 100; state.steps = 0; stopRun(); draw(); }, (v) => (v / 100).toFixed(2));
  const syncSliders = () => { setW(Math.round(state.w * 100)); setB(Math.round(state.b * 100)); };

  function setMode(m: Mode) {
    state.mode = m;
    modes.select(m);
    const reg = m === 'reg';
    el('legend-class').hidden = reg;
    el('legend-mean').hidden = !reg;
    el('legend-data').textContent = reg ? 'data' : 'class 0';
    el('reg-tools').style.display = reg ? 'contents' : 'none';
    el('r-sse').parentElement!.style.display = reg ? '' : 'none';
    el('r-opt').parentElement!.style.display = reg ? '' : 'none';
    resetWeights();
    draw();
  }
  const modes = segmented('mode', (m) => setMode(m as Mode));

  function snapToOptimum() {
    const o = ols();
    if (!o || !Number.isFinite(o.w)) return;
    stopRun();
    state.w = o.w;
    state.b = o.b;
    state.steps = 0;
    syncSliders();
    draw();
  }
  el('snap').addEventListener('click', snapToOptimum);
  const setSquares = check('squares', (on) => { state.squares = on; draw(); });
  check('ghost', (on) => { state.ghost = on; draw(); });
  const controls = transport({
    onRun: (running) => (state.running = running),
    onStep: () => { stopRun(); stepOnce(); draw(); },
    onReset: () => { resetWeights(); draw(); },
  });
  el('newdata').addEventListener('click', () => {
    state.seed = (Math.random() * 1e6) | 0;
    genData();
    resetWeights();
    draw();
  });

  // ---- loop ---------------------------------------------------------------
  let acc = 0, last = 0;
  function loop(ts: number) {
    if (!last) last = ts;
    const dt = Math.min(0.1, (ts - last) / 1000);
    last = ts;
    if (state.running) {
      acc += dt;
      while (acc >= 0.05) {
        acc -= 0.05;
        if (stepOnce() < 1e-4) { stopRun(); break; }
      }
      draw();
    }
    requestAnimationFrame(loop);
  }

  tries({
    clf: () => {
      setMode('clf');
      controls.setRunning(true);
      state.running = true;
    },
    run: () => {
      if (state.mode !== 'reg') setMode('reg');
      else resetWeights();
      controls.setRunning(true);
      state.running = true;
    },
    worse: () => {
      if (state.mode !== 'reg') setMode('reg');
      stopRun();
      state.squares = true;
      setSquares(true);
      state.w = 0.3;
      state.b = 1.5;
      state.steps = 0;
      syncSliders();
      draw();
    },
    outlier: () => {
      setMode('reg');
      state.seed = 7;
      genData();
      DATA.reg[DATA.reg.length - 2] = { x: 2.6, y: -4.4 };
      state.squares = true;
      setSquares(true);
      snapToOptimum();
    },
  });

  genData();
  setMode('reg');
  requestAnimationFrame(loop);
</script>

<style>
  #lm {
    cursor: crosshair;
    touch-action: none;
  }
</style>
