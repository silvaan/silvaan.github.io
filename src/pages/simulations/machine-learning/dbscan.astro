---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Transport from '../../../components/sim/Transport.astro';
import Actions from '../../../components/sim/Actions.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
---

<SimLayout
  areaSlug="machine-learning"
  title="DBSCAN"
  description="Density-based clustering that needs no k: it floods outward wherever points are packed tightly and labels the sparse leftovers as noise."
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas id="db" width="1000" height="600" role="img" aria-label="Points coloured by the cluster DBSCAN has flooded them into, with noise in grey and a dashed circle showing the radius epsilon."></canvas>
        <canvas id="rc" width="1000" height="600" hidden role="img" aria-label="A handful of points chosen so that one reachability relation holds and another fails, with the verdicts written out."></canvas>
      </div>
      <div id="cl-caption">
        <Caption hint="Click the canvas to add points" />
      </div>
      <div id="rc-caption" hidden>
        <Caption
          legend={[
            { label: 'core', color: 'rgba(232,233,236,0.75)' },
            { label: 'border', color: 'rgba(232,233,236,0.45)' },
            { label: 'noise', color: 'rgba(232,233,236,0.25)' },
            { label: 'everything p reaches', color: 'rgba(124,140,255,0.6)' },
            { label: 'the core that connects them', color: '#5eead4' },
          ]}
          hint="Click a point to move q, then p · dashed circles are ε"
          hintId="rc-hint"
        />
      </div>
      <Result label="Clusters found" />
    </div>

    <div class="sim-panel">
      <Seg id="mode" label="View" attr="m" options={[{ value: 'clusters', label: 'Clusters' }, { value: 'reach', label: 'Reachability' }]} />

      <div id="cl-controls" class="stack">
        <Transport step />
        <Actions>
          <button type="button" class="btn ghost" id="regen">Random points</button>
          <button type="button" class="btn ghost" id="clear">Clear</button>
        </Actions>
        <Seg
          id="data"
          label="Random data"
          attr="d"
          options={[{ value: 'moons', label: 'Moons' }, { value: 'blobs', label: 'Blobs' }, { value: 'noise', label: 'Blobs + noise' }]}
        />
      </div>

      <div id="rc-controls" class="stack" hidden>
        <Seg
          id="rcase"
          label="Case"
          attr="c"
          options={[
            { value: '0', label: 'Both ways' },
            { value: '1', label: 'One way' },
            { value: '2', label: 'Blocked' },
            { value: '3', label: 'Two borders' },
            { value: '4', label: 'Noise' },
            { value: '5', label: 'Not core' },
          ]}
        />
      </div>

      <Slider id="eps" label="Neighborhood ε" min={12} max={90} value={42} />
      <Slider id="mp" label="Min points" min={2} max={12} value={5} />

      <div id="cl-readout">
        <Readout rows={[{ id: 'r-clusters', label: 'clusters found' }, { id: 'r-noise', label: 'noise points' }]} />
      </div>
      <div id="rc-readout" hidden>
        <Readout
          rows={[
            { id: 'r-p', label: 'p is' },
            { id: 'r-q', label: 'q is' },
            { id: 'r-same', label: 'same cluster' },
            { id: 'r-next', label: 'next click sets' },
          ]}
        />
      </div>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Hit <b>Reset</b> then <b>Step</b>. DBSCAN picks a dense point and
      <b>floods outward</b> through neighbors within ε, so a cluster takes on
      whatever shape the data has, even a long crescent.
    </li>
    <li>
      Grey points are <b>noise</b>: they never gather enough ε-neighbors to join
      anyone. Built-in outlier detection, for free.
    </li>
    <li>
      The two knobs fight each other. Too small an <b>ε</b> (or too high
      <b>min points</b>) shatters everything into noise; too large and separate
      clusters <b>merge</b>. The right density sits in between.
    </li>
    <li>
      Open the <b>Reachability</b> view. Everything above rests on three
      relations: q is <b>directly reachable</b> from p when p is a core and q
      lies within ε of it; q is <b>reachable</b> from p when a chain of such
      steps gets there, every point along the way being a core; and p and q are
      <b>connected</b> when some one core reaches both.
    </li>
    <li>
      <b>One way</b> is the case to sit with. A core reaches the border point on
      its fringe, but the border point reaches nothing at all, because the
      definition asks the point you leave <b>from</b> to be a core. Reachability
      is not symmetric, and the whole rest of DBSCAN is arranged around that.
    </li>
    <li>
      <b>Blocked</b> shows what a border point cannot do. It is reached from the
      left cluster, and a point of the right cluster sits within ε of it, yet
      the chain <b>stops</b> there: a hop may only leave a core. Two clusters
      stay two, and the border point simply joins whichever was found first.
    </li>
    <li>
      <b>Two borders</b> is why clusters are defined by connectivity and not by
      reachability. Neither border reaches the other, in either direction, and
      they still belong to the same cluster, because one core in the middle
      reaches both. Drop the connectivity requirement and a cluster would stop
      being a single set.
    </li>
    <li>
      <b>Not core</b> is the trap. The two points sit well within ε of each
      other, and still nothing holds between them: neither is a core, so no
      relation can start anywhere. <b>Being close is not the same as being
      reachable.</b>
    </li>
    <li>
      In any case, drag <b>ε</b> or <b>min points</b> and watch the verdicts
      flip one at a time. Raising min points turns cores into borders, and a
      chain that ran through them dies where they stand.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { arrow, roundRect } from '../../../lib/theorem';
  import { equation } from '../../../lib/equation';
  import { stageInk } from '../../../lib/draw';
  import { el, segmented, slider, transport, result, readout } from '../../../lib/panel';

  type P = { x: number; y: number };
  const PALETTE = ['#7c8cff', '#f59e0b', '#2dd4bf', '#f87171', '#a78bfa', '#34d399', '#f472b6', '#38bdf8'];
  const ACC = '#7c8cff', TEAL = '#5eead4', BAD = '#f87171';

  const state = { data: 'moons', eps: 42, minPts: 5, running: false };
  let mode: 'clusters' | 'reach' = 'clusters';
  let pts: P[] = [];
  let labels: number[] = [];
  let oi = 0, cid = -1, seeds: number[] = [], done = false;

  const canvas = el('db') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink, css } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();
  const PAD = 44;
  const rnd = (a: number, b: number) => a + Math.random() * (b - a);

  function gen() {
    pts = [];
    if (state.data === 'moons') {
      for (let i = 0; i < 130; i++) {
        const t = Math.PI * (i / 130);
        const r = 190 + rnd(-12, 12);
        pts.push({ x: W / 2 + r * Math.cos(t) - 90, y: H / 2 - r * Math.sin(t) + 55 });
        pts.push({ x: W / 2 + r * Math.cos(t) + 90, y: H / 2 + r * Math.sin(t) - 55 });
      }
    } else {
      const nb = 4;
      const bc = Array.from({ length: nb }, () => ({ x: rnd(PAD + 90, W - PAD - 90), y: rnd(PAD + 70, H - PAD - 70) }));
      for (let i = 0; i < 240; i++) {
        const b = bc[i % nb];
        pts.push({ x: b.x + rnd(-40, 40) + rnd(-14, 14), y: b.y + rnd(-40, 40) + rnd(-14, 14) });
      }
      if (state.data === 'noise') for (let i = 0; i < 70; i++) pts.push({ x: rnd(PAD, W - PAD), y: rnd(PAD, H - PAD) });
    }
  }

  function neighbors(i: number) {
    const eps2 = state.eps * state.eps;
    const out: number[] = [];
    for (let j = 0; j < pts.length; j++) {
      if (j === i) continue;
      const dx = pts[i].x - pts[j].x, dy = pts[i].y - pts[j].y;
      if (dx * dx + dy * dy <= eps2) out.push(j);
    }
    return out;
  }
  function restart() {
    labels = new Array(pts.length).fill(-2); // -2 unvisited, -1 noise, >=0 cluster
    oi = 0;
    cid = -1;
    seeds = [];
    done = pts.length === 0;
  }
  function stepOnce() {
    if (seeds.length) {
      const q = seeds.shift()!;
      if (labels[q] === -1) labels[q] = cid; // border reclaimed
      if (labels[q] === -2) {
        labels[q] = cid;
        const nbq = neighbors(q);
        if (nbq.length + 1 >= state.minPts) for (const x of nbq) if (labels[x] < 0) seeds.push(x);
      }
      return;
    }
    while (oi < pts.length && labels[oi] !== -2) oi++;
    if (oi >= pts.length) { done = true; return; }
    const p = oi++;
    const nb = neighbors(p);
    if (nb.length + 1 < state.minPts) labels[p] = -1;
    else {
      cid++;
      labels[p] = cid;
      seeds = nb.slice();
    }
  }
  function runFull() {
    restart();
    let guard = 0;
    while (!done && guard++ < 200000) stepOnce();
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    const seedSet = new Set(seeds);
    for (let i = 0; i < pts.length; i++) {
      const l = labels[i];
      if (l === -2) {
        ctx.strokeStyle = ink(0.35);
        ctx.lineWidth = 1.3;
        ctx.beginPath();
        ctx.arc(pts[i].x, pts[i].y, 3.4, 0, Math.PI * 2);
        ctx.stroke();
      } else {
        ctx.fillStyle = l === -1 ? ink(0.28) : PALETTE[l % PALETTE.length];
        ctx.beginPath();
        ctx.arc(pts[i].x, pts[i].y, l === -1 ? 3 : 4.2, 0, Math.PI * 2);
        ctx.fill();
      }
      if (seedSet.has(i)) {
        ctx.strokeStyle = ink(0.9);
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(pts[i].x, pts[i].y, 7, 0, Math.PI * 2);
        ctx.stroke();
      }
    }
    // ε, to scale
    ctx.strokeStyle = ink(0.5);
    ctx.lineWidth = 1.5;
    ctx.setLineDash([4, 4]);
    ctx.beginPath();
    ctx.arc(60, H - 60, state.eps, 0, Math.PI * 2);
    ctx.stroke();
    ctx.setLineDash([]);
    label('ε', 60, H - 56, 0.6, 'center', 12);
    wordsClusters();
  }

  function wordsClusters() {
    const n = Math.max(0, cid + 1);
    const noise = labels.filter((l) => l === -1).length;
    const unvisited = labels.filter((l) => l === -2).length;
    setEq({
      rule: ['\\text{core}(p): |N_\\varepsilon(p)| \\ge \\text{minPts}', '\\qquad', [`p \\to q:\\ p\\text{ core},\\ q \\in N_\\varepsilon(p)`, ACC]],
      live: [`\\varepsilon = ${state.eps}`, `\\quad\\text{minPts} = ${state.minPts}`, `\\quad n = ${pts.length}`],
    });
    el('result-label').textContent = 'Clusters found';
    setResult({
      value: pts.length ? String(n) : '—',
      status: pts.length ? `${noise} noise points${unvisited ? ` · ${unvisited} still to visit` : ''} · ε = ${state.eps}, min points ${state.minPts}` : 'No points yet',
      note: 'A cluster floods outward from a dense core through its ε-neighbours, so it takes whatever shape the data has. Points that never gather enough neighbours are noise.',
    });
    setRows({ 'r-clusters': String(n), 'r-noise': String(noise) });
  }

  // -------------------------------------------------------------------------
  // Reachability and connectivity, on hand-placed cases small enough to read.
  // -------------------------------------------------------------------------
  type RCase = { title: string; sub: string; eps: number; minPts: number; pts: P[]; p: number; q: number };

  const blob = (cx: number, cy: number): P[] => {
    const out: P[] = [{ x: cx, y: cy }];
    for (let i = 0; i < 6; i++) {
      const a = (i * Math.PI) / 3;
      out.push({ x: cx + 45 * Math.cos(a), y: cy + 45 * Math.sin(a) });
    }
    out.push({ x: cx, y: cy - 22 }, { x: cx, y: cy + 22 });
    return out;
  };
  const clump = (x0: number): P[] => [
    { x: x0, y: 245 }, { x: x0 + 30, y: 215 }, { x: x0 + 30, y: 275 },
    { x: x0 + 60, y: 245 }, { x: x0 + 90, y: 215 }, { x: x0 + 90, y: 275 },
    { x: x0 + 120, y: 245 },
  ];
  const chain: P[] = Array.from({ length: 9 }, (_, i) => ({ x: 120 + i * 75, y: 245 + 55 * Math.sin(i * 0.75) }));

  const CASES: RCase[] = [
    { title: 'Reachable in both directions', sub: 'Two cores with a chain of cores between them: the relation runs either way.', eps: 110, minPts: 3, pts: chain, p: 1, q: 7 },
    { title: 'Reachable one way only', sub: 'A core reaches the border on its fringe, and the border reaches nothing back.', eps: 100, minPts: 5, pts: [...blob(330, 245), { x: 470, y: 245 }], p: 1, q: 9 },
    { title: 'The chain stops at a border', sub: 'The middle point is reached, but no hop may leave it, so the clusters stay apart.', eps: 150, minPts: 6, pts: [...clump(200), { x: 465, y: 245 }, ...clump(610)], p: 3, q: 11 },
    {
      title: 'Two borders joined by one core', sub: 'Neither reaches the other, and they are in one cluster all the same.', eps: 130, minPts: 5,
      pts: [{ x: 450, y: 245 }, { x: 425, y: 205 }, { x: 475, y: 205 }, { x: 425, y: 285 }, { x: 475, y: 285 }, { x: 325, y: 245 }, { x: 575, y: 245 }],
      p: 5, q: 6,
    },
    { title: 'Noise', sub: 'Too far to be reached from any core, and too sparse to reach anything.', eps: 100, minPts: 5, pts: [...blob(330, 245), { x: 700, y: 245 }], p: 0, q: 9 },
    { title: 'Inside ε is not enough', sub: 'The two are well within ε of each other, and neither is a core, so nothing holds.', eps: 100, minPts: 5, pts: [...blob(250, 245), { x: 600, y: 215 }, { x: 668, y: 260 }], p: 9, q: 10 },
  ];
  // clusters here never use the blue of reachability or the teal of connectivity
  const RPAL = ['#f59e0b', '#a78bfa', '#f472b6', '#22d3ee'];
  for (const c of CASES) {
    let lo = Infinity, hi = -Infinity;
    for (const q of c.pts) { lo = Math.min(lo, q.x); hi = Math.max(hi, q.x); }
    const dx = 500 - (lo + hi) / 2;
    c.pts = c.pts.map((q) => ({ x: q.x + dx, y: q.y - 40 }));
  }

  const rst = { ci: 0, eps: CASES[0].eps, minPts: CASES[0].minPts, p: CASES[0].p, q: CASES[0].q, next: 'q' as 'p' | 'q' };
  const rcanvas = el('rc') as HTMLCanvasElement;
  const rc = setupCanvas(rcanvas, () => drawReach());
  const rctx = rc.ctx;
  const { label: rlabel, textWidth: rwidth } = makeText(rctx, ink);

  type Analysis = {
    c: RCase; N: number[][]; core: boolean[]; lab: number[];
    kind: (i: number) => string;
    direct: (a: number, b: number) => boolean;
    reach: (a: number) => { seen: Set<number>; parent: Map<number, number> };
    path: (a: number, b: number) => number[];
    blocked: (a: number) => boolean;
    witness: number;
  };
  function analyse(): Analysis {
    const c = CASES[rst.ci];
    const pt = c.pts;
    const eps2 = rst.eps * rst.eps;
    const N: number[][] = pt.map((_, i) =>
      pt.map((_, j) => j).filter((j) => {
        if (j === i) return false;
        const dx = pt[i].x - pt[j].x, dy = pt[i].y - pt[j].y;
        return dx * dx + dy * dy <= eps2;
      })
    );
    const core = N.map((l) => l.length + 1 >= rst.minPts);
    const lab: number[] = new Array(pt.length).fill(-2);
    let cc = -1;
    for (let i = 0; i < pt.length; i++) {
      if (lab[i] !== -2) continue;
      if (!core[i]) { lab[i] = -1; continue; }
      cc++;
      lab[i] = cc;
      const sd = N[i].slice();
      while (sd.length) {
        const u = sd.shift()!;
        if (lab[u] === -1) lab[u] = cc;
        if (lab[u] === -2) {
          lab[u] = cc;
          if (core[u]) for (const v of N[u]) if (lab[v] < 0) sd.push(v);
        }
      }
    }
    const reach = (a: number) => {
      const parent = new Map<number, number>();
      const seen = new Set<number>([a]);
      const queue: number[] = core[a] ? [a] : [];
      while (queue.length) {
        const u = queue.shift()!;
        for (const v of N[u])
          if (!seen.has(v)) {
            seen.add(v);
            parent.set(v, u);
            if (core[v]) queue.push(v);
          }
      }
      return { seen, parent };
    };
    const path = (a: number, b: number) => {
      const r = reach(a);
      if (!r.seen.has(b) || a === b) return [];
      const out = [b];
      let cur = b;
      while (r.parent.has(cur)) { cur = r.parent.get(cur)!; out.push(cur); }
      return out.reverse();
    };
    const direct = (a: number, b: number) => {
      if (a === b || !core[a]) return false;
      const dx = pt[a].x - pt[b].x, dy = pt[a].y - pt[b].y;
      return dx * dx + dy * dy <= eps2;
    };
    const blocked = (a: number) => {
      const r = reach(a);
      for (const m of r.seen) if (m !== a && !core[m] && N[m].some((v) => !r.seen.has(v))) return true;
      return false;
    };
    let witness = -1, best = Infinity;
    for (let o = 0; o < pt.length; o++) {
      if (!core[o]) continue;
      const r = reach(o);
      if (!r.seen.has(rst.p) || !r.seen.has(rst.q)) continue;
      const cost = path(o, rst.p).length + path(o, rst.q).length;
      if (cost < best) { best = cost; witness = o; }
    }
    const kind = (i: number) => (core[i] ? 'core' : lab[i] >= 0 ? 'border' : 'noise');
    return { c, N, core, lab, kind, direct, reach, path, blocked, witness };
  }

  const dist = (a: P, b: P) => Math.hypot(a.x - b.x, a.y - b.y);
  function hop(a: P, b: P, colour: string, lw = 2) {
    const d = dist(a, b) || 1;
    const ux = (b.x - a.x) / d, uy = (b.y - a.y) / d;
    arrow(rctx, a.x + ux * 10, a.y + uy * 10, b.x - ux * 12, b.y - uy * 12, colour, lw, 8);
  }

  function drawReach() {
    const A = analyse();
    const pt = A.c.pts;
    rctx.clearRect(0, 0, rc.W, rc.H);
    const Rp = A.reach(rst.p);
    const pathPQ = A.path(rst.p, rst.q);
    const pathQP = A.path(rst.q, rst.p);
    const connected = A.witness >= 0;

    rctx.fillStyle = ACC;
    rctx.globalAlpha = 0.36;
    for (const i of Rp.seen) {
      rctx.beginPath();
      rctx.arc(pt[i].x, pt[i].y, 15, 0, Math.PI * 2);
      rctx.fill();
    }
    rctx.globalAlpha = 1;
    rctx.setLineDash([4, 5]);
    rctx.lineWidth = 1.2;
    for (const i of [rst.p, rst.q]) {
      rctx.strokeStyle = ink(0.26);
      rctx.beginPath();
      rctx.arc(pt[i].x, pt[i].y, rst.eps, 0, Math.PI * 2);
      rctx.stroke();
    }
    rctx.setLineDash([]);

    if (pathPQ.length > 1) for (let i = 0; i < pathPQ.length - 1; i++) hop(pt[pathPQ[i]], pt[pathPQ[i + 1]], ACC, 2.2);
    else if (pathQP.length > 1) for (let i = 0; i < pathQP.length - 1; i++) hop(pt[pathQP[i]], pt[pathQP[i + 1]], ACC, 2.2);
    else if (connected)
      for (const t of [rst.p, rst.q]) {
        const pa = A.path(A.witness, t);
        for (let i = 0; i < pa.length - 1; i++) hop(pt[pa[i]], pt[pa[i + 1]], TEAL, 2);
      }

    for (let i = 0; i < pt.length; i++) {
      const k = A.kind(i);
      const col = A.lab[i] >= 0 ? RPAL[A.lab[i] % RPAL.length] : ink(0.34);
      if (k === 'core') {
        rctx.fillStyle = col;
        rctx.beginPath();
        rctx.arc(pt[i].x, pt[i].y, 6.5, 0, Math.PI * 2);
        rctx.fill();
      } else if (k === 'border') {
        rctx.strokeStyle = col;
        rctx.lineWidth = 2;
        rctx.beginPath();
        rctx.arc(pt[i].x, pt[i].y, 5.5, 0, Math.PI * 2);
        rctx.stroke();
      } else {
        rctx.fillStyle = ink(0.34);
        rctx.beginPath();
        rctx.arc(pt[i].x, pt[i].y, 3.4, 0, Math.PI * 2);
        rctx.fill();
      }
    }
    const mark = (i: number, name: string, colour: string, below = false) => {
      rctx.strokeStyle = colour;
      rctx.lineWidth = 1.8;
      rctx.beginPath();
      rctx.arc(pt[i].x, pt[i].y, 13, 0, Math.PI * 2);
      rctx.stroke();
      const t = `${name} · ${A.kind(i)}`;
      const cy = pt[i].y + (below ? 36 : -28);
      const w = rwidth(t, 11.5) + 16;
      rctx.fillStyle = css('--stage-bg', '#0d0e12');
      rctx.globalAlpha = 0.92;
      roundRect(rctx, pt[i].x - w / 2, cy - 11, w, 20, 6);
      rctx.fill();
      rctx.globalAlpha = 1;
      rctx.strokeStyle = ink(0.16);
      rctx.lineWidth = 1;
      rctx.stroke();
      rlabel(t, pt[i].x, cy + 4, 0.9, 'center', 11.5, colour);
    };
    if (connected && pathPQ.length < 2 && pathQP.length < 2 && A.witness !== rst.p && A.witness !== rst.q) mark(A.witness, 'o', TEAL);
    mark(rst.p, 'p', ink(0.9));
    mark(rst.q, 'q', ink(0.9), true);

    drawVerdicts(A, pathPQ, pathQP, connected);
  }

  /** The five verdicts, each with the reason it came out that way. */
  function drawVerdicts(A: Analysis, pathPQ: number[], pathQP: number[], connected: boolean) {
    const pt = A.c.pts;
    const x0 = 80, y0 = 400;
    rlabel('core: minPts points within ε, itself included', x0, y0 - 12, 0.42, 'left', 11);
    rlabel('→ direct · ⇒ chain · ↔ connected', rc.W - x0, y0 - 12, 0.42, 'right', 11);
    rctx.strokeStyle = ink(0.1);
    rctx.beginPath();
    rctx.moveTo(x0, y0);
    rctx.lineTo(rc.W - x0, y0);
    rctx.stroke();

    const d = dist(pt[rst.p], pt[rst.q]);
    const dtxt = `d = ${Math.round(d)}`;
    const directWhy = (a: number, an: string) =>
      A.direct(a, a === rst.p ? rst.q : rst.p) ? `${an} is a core and ${dtxt} ≤ ε`
      : !A.core[a] ? (d <= rst.eps ? `${an} is not a core, even though ${dtxt} ≤ ε` : `${an} is not a core point`)
      : `${dtxt} > ε = ${rst.eps}`;
    const reachWhy = (a: number, an: string, path: number[]) =>
      path.length > 1 ? `${path.length - 1} hop${path.length > 2 ? 's' : ''}, every one of them leaving a core`
      : !A.core[a] ? `${an} is not a core, so no chain can leave it`
      : A.blocked(a) ? 'the chain is stopped at a border point'
      : 'no chain of cores gets there';
    const rows: [string, string, boolean, string][] = [
      ['p → q', 'directly reachable', A.direct(rst.p, rst.q), directWhy(rst.p, 'p')],
      ['q → p', 'directly reachable', A.direct(rst.q, rst.p), directWhy(rst.q, 'q')],
      ['p ⇒ q', 'reachable', pathPQ.length > 1, reachWhy(rst.p, 'p', pathPQ)],
      ['q ⇒ p', 'reachable', pathQP.length > 1, reachWhy(rst.q, 'q', pathQP)],
      ['p ↔ q', 'connected', connected,
        connected
          ? A.witness === rst.p || A.witness === rst.q ? 'one of them is itself the core that reaches both' : 'the core marked o reaches both of them'
          : A.core[rst.p] || A.core[rst.q] ? 'no single core reaches both' : 'neither of them is reached from any core'],
    ];
    rows.forEach(([sym, name, ok, why], i) => {
      const y = y0 + 32 + i * 32;
      rlabel(sym, x0, y, 0.85, 'left', 13);
      rlabel(name, x0 + 90, y, 0.55, 'left', 11.5);
      rlabel(ok ? 'yes' : 'no', x0 + 270, y, 1, 'left', 12.5, ok ? TEAL : BAD);
      rlabel(why, x0 + 318, y, 0.38, 'left', 11);
    });
    wordsReach(A, connected);
  }

  function wordsReach(A: Analysis, connected: boolean) {
    setEq({
      rule: ['\\text{core}(p): |N_\\varepsilon(p)| \\ge \\text{minPts}', '\\qquad', [`p \\to q:\\ p\\text{ core},\\ q \\in N_\\varepsilon(p)`, ACC]],
      live: [`\\varepsilon = ${rst.eps}`, `\\quad\\text{minPts} = ${rst.minPts}`, [`\\quad p\\text{ is }${A.kind(rst.p)}`, ACC], `\\quad q\\text{ is }${A.kind(rst.q)}`],
    });
    el('result-label').textContent = 'p ↔ q connected';
    setResult({
      value: connected ? 'yes' : 'no',
      colour: connected ? TEAL : BAD,
      status: A.c.title,
      note: A.c.sub,
    });
    setRows({
      'r-p': A.kind(rst.p),
      'r-q': A.kind(rst.q),
      'r-same': A.lab[rst.p] >= 0 && A.lab[rst.p] === A.lab[rst.q] ? 'yes' : 'no',
      'r-next': rst.next,
    });
  }

  // -------------------------------------------------------------------------
  // wiring
  // -------------------------------------------------------------------------
  const setEps = slider('eps', (v) => {
    if (mode === 'clusters') { state.eps = v; runFull(); } else rst.eps = v;
  });
  const setMp = slider('mp', (v) => {
    if (mode === 'clusters') { state.minPts = v; runFull(); } else rst.minPts = v;
  });
  const epsEl = el('eps') as HTMLInputElement;

  function showMode() {
    const cl = mode === 'clusters';
    canvas.hidden = !cl;
    rcanvas.hidden = cl;
    for (const id of ['cl-controls', 'cl-readout', 'cl-caption']) el(id).hidden = !cl;
    for (const id of ['rc-controls', 'rc-readout', 'rc-caption']) el(id).hidden = cl;
    // the two views work at different scales, so the slider keeps its own range
    epsEl.min = cl ? '12' : '40';
    epsEl.max = cl ? '90' : '200';
    setEps(cl ? state.eps : rst.eps);
    setMp(cl ? state.minPts : rst.minPts);
  }
  function loadCase(i: number) {
    rst.ci = i;
    rst.eps = CASES[i].eps;
    rst.minPts = CASES[i].minPts;
    rst.p = CASES[i].p;
    rst.q = CASES[i].q;
    rst.next = 'q';
    showMode();
  }

  segmented('mode', (m) => {
    mode = m as 'clusters' | 'reach';
    state.running = false;
    controls.setRunning(false);
    showMode();
  });
  segmented('rcase', (c) => loadCase(+c));
  segmented('data', (d) => { state.data = d; gen(); runFull(); });

  const controls = transport({
    onRun: (running) => {
      if (mode !== 'clusters') { controls.setRunning(false); return; }
      if (done) restart();
      state.running = running;
    },
    onStep: () => {
      if (mode !== 'clusters') return;
      if (done) restart();
      stepOnce();
    },
    onReset: () => {
      if (mode !== 'clusters') return;
      state.running = false;
      controls.setRunning(false);
      restart();
    },
  });
  el('regen').addEventListener('click', () => { gen(); runFull(); });
  el('clear').addEventListener('click', () => {
    pts = [];
    state.running = false;
    controls.setRunning(false);
    restart();
  });

  canvas.addEventListener('pointerdown', (e) => {
    const rect = canvas.getBoundingClientRect();
    pts.push({ x: ((e.clientX - rect.left) / rect.width) * W, y: ((e.clientY - rect.top) / rect.height) * H });
    runFull();
  });
  const rcAt = (e: PointerEvent | MouseEvent) => {
    const rect = rcanvas.getBoundingClientRect();
    const x = ((e.clientX - rect.left) / rect.width) * rc.W;
    const y = ((e.clientY - rect.top) / rect.height) * rc.H;
    const pt = CASES[rst.ci].pts;
    let best = -1, bd = 24;
    for (let i = 0; i < pt.length; i++) {
      const d = dist(pt[i], { x, y });
      if (d < bd) { bd = d; best = i; }
    }
    return best;
  };
  rcanvas.addEventListener('pointerdown', (e) => {
    const i = rcAt(e);
    if (i < 0 || i === rst.p || i === rst.q) return;
    if (rst.next === 'q') { rst.q = i; rst.next = 'p'; } else { rst.p = i; rst.next = 'q'; }
  });
  rcanvas.addEventListener('mousemove', (e) => { rcanvas.style.cursor = rcAt(e) >= 0 ? 'pointer' : 'default'; });

  function loop() {
    if (mode === 'clusters') {
      if (state.running) {
        for (let k = 0; k < 6 && !done; k++) stepOnce();
        if (done) { state.running = false; controls.setRunning(false); }
      }
      draw();
    } else drawReach();
    requestAnimationFrame(loop);
  }

  gen();
  runFull();
  showMode();
  requestAnimationFrame(loop);
</script>

<style>
  /* Both views live in the same stage, so the hidden one has to lose the
     display:block that .sim-stage canvas hands it. */
  .sim-stage canvas[hidden] {
    display: none;
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  #db {
    cursor: crosshair;
  }
</style>
