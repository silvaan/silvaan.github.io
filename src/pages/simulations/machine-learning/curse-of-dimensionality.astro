---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
---

<SimLayout
  areaSlug="machine-learning"
  title="The Curse of Dimensionality"
  description="Add axes and space stops behaving: data spreads until every point is alone, a ball becomes all crust, and every distance becomes the same distance."
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="cod"
          width="1000"
          height="600"
          role="img"
          aria-label="A picture of one high-dimensional effect on the left and the curve of how it grows with the number of dimensions on the right."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'sampled points', color: '#5eead4' },
          { label: 'the current d', color: '#7c8cff' },
          { label: 'what the formula predicts', color: 'rgba(94,234,212,0.9)' },
        ]}
      />
      <Result label="Empty space" />
    </div>

    <div class="sim-panel">
      <Seg
        id="mode"
        label="Which curse"
        attr="m"
        options={[
          { value: 'sparsity', label: 'Empty space' },
          { value: 'shell', label: 'Volume in the crust' },
          { value: 'distance', label: 'All distances equal' },
          { value: 'angles', label: 'Everything orthogonal' },
          { value: 'corners', label: 'Nothing but corners' },
        ]}
      />
      <Slider id="d" label="Dimensions d" min={1} max={120} value={2} />
      <Transport step />
      <div data-for="sparsity">
        <Slider id="frac" label="Fraction of data to capture" min={1} max={50} value={10} display="10%" />
      </div>
      <div data-for="shell">
        <Slider id="eps" label="Crust thickness" min={1} max={40} value={5} display="5%" />
      </div>
      <div data-for="sparsity shell distance angles">
        <Slider id="n" label="Sample points n" min={100} max={1200} step={50} value={600} />
      </div>
      <div class="readout" id="readout"></div>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      <b>Empty space.</b> Cut every axis into 10 bins and the number of cells is
      10<sup>d</sup>. At d = 20 that is a hundred billion billion boxes, and your
      600 points sit in 600 of them. The 2D picture still looks nicely filled,
      which is the trap: <b>every low-dimensional projection lies</b> about how
      crowded the real space is.
    </li>
    <li>
      Watch the curve on the right. To gather 10% of the data you must span
      <b>63% of every axis at d = 5</b> and <b>89% at d = 20</b>. A "local"
      neighbourhood stops being local, so anything built on neighbours (k-NN,
      kernels, histograms) quietly stops being local too.
    </li>
    <li>
      <b>Volume in the crust.</b> Drag d up and watch the dots evacuate the middle
      of the ball. The outer 5% shell holds under 10% of a 2D disc but over
      <b>99% of a 100D ball</b>. Nothing moved: it is just that volume scales like
      r<sup>d</sup>, so almost all of it is near the surface.
    </li>
    <li>
      <b>All distances equal.</b> The cloud around the query point collapses into a
      thin ring: by d = 60 the spread of the distances is only a few percent of
      their mean, and it keeps shrinking like 1/√d. Nearest and farthest stop
      being meaningfully different, which is why exact nearest-neighbour search
      loses its grip in high dimensions.
    </li>
    <li>
      <b>Everything orthogonal.</b> Two random directions have cos θ with mean 0
      and standard deviation <b>1/√d</b>. By d = 100 nearly every pair sits within
      a few degrees of 90°. High-dimensional space is roomy enough for enormous
      numbers of almost-orthogonal directions, which is exactly what makes random
      projections and superposition in embeddings work.
    </li>
    <li>
      <b>Nothing but corners.</b> The ball inscribed in a cube touches all 2d faces
      yet fills <b>1 part in 10<sup>28</sup> of it at d = 50</b>. All the volume
      hides in the 2<sup>d</sup> corners, and the cube's half-diagonal is √d while
      its inradius stays 1: the box is really a spiky sea urchin, not a box.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk } from '../../../lib/draw';
  import { el, segmented, slider, transport, result } from '../../../lib/panel';

  const canvas = el('cod') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();

  const AMBER = '#f59e0b', ACCENT = '#7c8cff', TEAL = '#5eead4';

  // ---------------------------------------------------------------------------
  // Random bank. Every sample is drawn once per seed and stored column-wise, so
  // raising d only appends coordinates to vectors that already exist.
  // ---------------------------------------------------------------------------
  const DMAX = 120, NMAX = 1200;
  function mulberry32(seed: number) {
    let a = seed >>> 0;
    return () => {
      a = (a + 0x6d2b79f5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  function buildBank(seed: number) {
    const r = mulberry32(seed);
    const gauss = () => Math.sqrt(-2 * Math.log(Math.max(1e-12, r()))) * Math.cos(2 * Math.PI * r());
    const nrm = new Float32Array(2 * NMAX * DMAX);
    for (let i = 0; i < nrm.length; i++) nrm[i] = gauss();
    const uni = new Float32Array(NMAX * DMAX);
    for (let i = 0; i < uni.length; i++) uni[i] = r();
    const q = new Float32Array(DMAX);
    for (let i = 0; i < DMAX; i++) q[i] = r();
    const u1 = new Float64Array(NMAX), ang = new Float64Array(NMAX);
    for (let i = 0; i < NMAX; i++) { u1[i] = r(); ang[i] = r() * Math.PI * 2; }
    return { nrm, uni, q, u1, ang };
  }
  let bank = buildBank(7);

  const ballRadii = (d: number, n: number) => {
    const out = new Float64Array(n);
    for (let i = 0; i < n; i++) out[i] = Math.pow(bank.u1[i], 1 / d);
    return out;
  };
  const cosPairs = (d: number, n: number) => {
    const out = new Float64Array(n);
    for (let i = 0; i < n; i++) {
      let ab = 0, aa = 0, bb = 0;
      const oa = 2 * i * DMAX, ob = (2 * i + 1) * DMAX;
      for (let j = 0; j < d; j++) {
        const a = bank.nrm[oa + j], b = bank.nrm[ob + j];
        ab += a * b; aa += a * a; bb += b * b;
      }
      out[i] = ab / Math.sqrt(aa * bb);
    }
    return out;
  };
  const queryDistances = (d: number, n: number) => {
    const out = new Float64Array(n);
    for (let i = 0; i < n; i++) {
      let s = 0;
      for (let j = 0; j < d; j++) { const t = bank.uni[i * DMAX + j] - bank.q[j]; s += t * t; }
      out[i] = Math.sqrt(s);
    }
    return out;
  };
  const occupiedCells = (d: number, n: number) => {
    const seen = new Set<string>();
    for (let i = 0; i < n; i++) {
      let key = '';
      for (let j = 0; j < d; j++) key += String.fromCharCode(48 + ((bank.uni[i * DMAX + j] * 10) | 0));
      seen.add(key);
    }
    return seen.size;
  };
  function lgamma(x: number): number {
    const c = [0.99999999999980993, 676.5203681218851, -1259.1392167224028, 771.32342877765313, -176.61502916214059, 12.507343278686905, -0.13857109526572012, 9.9843695780195716e-6, 1.5056327351493116e-7];
    if (x < 0.5) return Math.log(Math.PI / Math.sin(Math.PI * x)) - lgamma(1 - x);
    x -= 1;
    let a = c[0];
    const t = x + 7.5;
    for (let i = 1; i < 9; i++) a += c[i] / (x + i);
    return 0.5 * Math.log(2 * Math.PI) + (x + 0.5) * Math.log(t) - t + Math.log(a);
  }
  const log10BallOverCube = (d: number) => ((d / 2) * Math.log(Math.PI) - lgamma(d / 2 + 1)) / Math.LN10 - d * Math.log10(2);

  const state = { mode: 'sparsity', d: 2, n: 600, frac: 10, eps: 5, playing: false };
  let cache: any = null, cacheKey = '';
  function data() {
    const key = `${state.mode}|${state.d}|${state.n}`;
    if (key === cacheKey && cache) return cache;
    const d = state.d, n = state.n;
    let val: any = {};
    if (state.mode === 'sparsity') val = { occ: occupiedCells(d, n) };
    else if (state.mode === 'shell') val = { r: ballRadii(d, n) };
    else if (state.mode === 'distance') val = { dist: queryDistances(d, n) };
    else if (state.mode === 'angles') val = { cos: cosPairs(d, n) };
    cacheKey = key;
    cache = val;
    return val;
  }

  // ---------------------------------------------------------------------------
  // Drawing scaffolding: a square picture on the left, a chart on the right.
  // ---------------------------------------------------------------------------
  const pic = { x: 40, y: 60, w: 420, h: 420 };
  const chart = { x: 560, y: 80, w: 400, h: 380 };
  const dom = { x: [0, 1], y: [0, 1] };
  const mx = (v: number) => chart.x + ((v - dom.x[0]) / (dom.x[1] - dom.x[0])) * chart.w;
  const my = (v: number) => chart.y + chart.h - ((v - dom.y[0]) / (dom.y[1] - dom.y[0])) * chart.h;

  type Tick = { v: number; t: string };
  function chartFrame(xd: [number, number], yd: [number, number], xTicks: Tick[], yTicks: Tick[], xTitle: string, yTitle: string) {
    dom.x = xd;
    dom.y = yd;
    ctx.strokeStyle = ink(0.16);
    ctx.lineWidth = 1;
    ctx.strokeRect(chart.x, chart.y, chart.w, chart.h);
    for (const t of yTicks) {
      const y = my(t.v);
      ctx.strokeStyle = ink(0.07);
      ctx.beginPath();
      ctx.moveTo(chart.x, y);
      ctx.lineTo(chart.x + chart.w, y);
      ctx.stroke();
      label(t.t, chart.x - 8, y + 4, 0.45, 'right', 11.5);
    }
    for (const t of xTicks) {
      const x = mx(t.v);
      ctx.strokeStyle = ink(0.16);
      ctx.beginPath();
      ctx.moveTo(x, chart.y + chart.h);
      ctx.lineTo(x, chart.y + chart.h + 5);
      ctx.stroke();
      label(t.t, x, chart.y + chart.h + 20, 0.45, 'center', 11.5);
    }
    label(yTitle, chart.x, chart.y - 12, 0.45, 'left', 11.5);
    label(xTitle, chart.x + chart.w, chart.y + chart.h + 38, 0.45, 'right', 11.5);
  }
  const dTicks: Tick[] = [1, 20, 40, 60, 80, 100, 120].map((v) => ({ v, t: String(v) }));

  function curve(f: (x: number) => number, x0: number, x1: number, colour: string) {
    ctx.strokeStyle = colour;
    ctx.lineWidth = 2;
    ctx.beginPath();
    for (let i = 0; i <= 240; i++) {
      const x = x0 + ((x1 - x0) * i) / 240;
      i === 0 ? ctx.moveTo(mx(x), my(f(x))) : ctx.lineTo(mx(x), my(f(x)));
    }
    ctx.stroke();
  }
  function dMarker(y: number, text: string) {
    const x = mx(state.d);
    ctx.strokeStyle = ink(0.3);
    ctx.setLineDash([3, 4]);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(x, chart.y);
    ctx.lineTo(x, chart.y + chart.h);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = ACCENT;
    ctx.beginPath();
    ctx.arc(x, my(y), 5, 0, Math.PI * 2);
    ctx.fill();
    const flip = x > chart.x + chart.w - 90;
    label(text, flip ? x - 10 : x + 10, Math.max(chart.y + 16, my(y) - 12), 0.95, flip ? 'right' : 'left', 11, ACCENT);
  }
  function pctTicks(max: number): Tick[] {
    const step = [0.01, 0.02, 0.05, 0.1, 0.2, 0.5].find((s) => max / s <= 4) ?? 1;
    const out: Tick[] = [];
    for (let v = 0; v <= max + 1e-9; v += step) out.push({ v, t: `${Math.round(v * 100)}%` });
    return out;
  }
  function histogram(v: ArrayLike<number>, lo: number, hi: number, bins: number) {
    const counts = new Float64Array(bins);
    let n = 0;
    for (let i = 0; i < v.length; i++) {
      const b = Math.floor(((v[i] - lo) / (hi - lo)) * bins);
      if (b >= 0 && b < bins) { counts[b]++; n++; }
    }
    if (n) for (let i = 0; i < bins; i++) counts[i] /= n;
    return counts;
  }
  function drawBars(counts: Float64Array, lo: number, hi: number, colour: string) {
    const bw = (hi - lo) / counts.length;
    ctx.fillStyle = colour;
    for (let i = 0; i < counts.length; i++) {
      if (counts[i] <= 0) continue;
      const x0 = mx(lo + i * bw), x1 = mx(lo + (i + 1) * bw);
      const y = my(counts[i]);
      ctx.fillRect(x0 + 0.5, y, Math.max(1, x1 - x0 - 1), chart.y + chart.h - y);
    }
  }
  function vline(x: number, colour: string, text: string, up = 0) {
    const px = mx(x);
    ctx.strokeStyle = colour;
    ctx.lineWidth = 1.5;
    ctx.setLineDash([4, 4]);
    ctx.beginPath();
    ctx.moveTo(px, chart.y + 6);
    ctx.lineTo(px, chart.y + chart.h);
    ctx.stroke();
    ctx.setLineDash([]);
    if (!text) return;
    const room = chart.x + chart.w - px;
    label(text, room < 90 ? px - 8 : px, chart.y + 18 + up, 0.95, room < 90 ? 'right' : 'center', 11.5, colour);
  }
  const picCentre = () => ({ x: pic.x + pic.w / 2, y: pic.y + pic.h / 2, R: pic.w * 0.45 });
  const picTitle = (text: string) => label(text, pic.x, pic.y - 12, 0.45, 'left', 11.5);
  const picCaption = (text: string) => label(text, pic.x, pic.y + pic.h + 24, 0.42, 'left', 11.5);

  function fromLog10(l: number) {
    if (!isFinite(l)) return '—';
    if (l >= -3 && l < 6) {
      const v = Math.pow(10, l);
      return v >= 1000 ? Math.round(v).toLocaleString() : String(+v.toPrecision(3));
    }
    const p = Math.floor(l);
    return `${Math.pow(10, l - p).toFixed(1)}×10^${p}`;
  }
  const pct = (x: number, dp = 1) => `${(100 * x).toFixed(dp)}%`;
  const sup = (s: string) => s.replace(/\^(-?\d+)/g, '<sup>$1</sup>');
  const plain = (s: string) => s.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();

  const readoutEl = el('readout');
  /** Rows for the panel, and the headline for the result strip. */
  function setPanel(rows: [string, string][], headline: { label: string; value: string; note: string }) {
    readoutEl.innerHTML = rows.map(([k, v]) => `<div class="row"><span>${k}</span><b>${sup(v)}</b></div>`).join('');
    el('result-label').textContent = headline.label;
    setResult({ value: headline.value, colour: ACCENT, status: `d = ${state.d} · ${TAGLINE[state.mode]}`, note: plain(headline.note) });
  }
  const TAGLINE: Record<string, string> = {
    sparsity: 'data thins out faster than you can sample it',
    shell: 'the middle of a ball is a rounding error',
    distance: 'near and far stop being different',
    angles: 'random directions meet at 90°',
    corners: 'a cube is really a spiky urchin',
  };

  // --- Mode 1: empty space -----------------------------------------------------
  function drawSparsity() {
    const d = state.d, n = state.n, f = state.frac / 100;
    const { occ } = data();
    const cell = pic.w / 10;
    const hit = new Set<number>();
    const pts: [number, number][] = [];
    for (let i = 0; i < n; i++) {
      const x = bank.uni[i * DMAX];
      const y = d >= 2 ? bank.uni[i * DMAX + 1] : 0.5;
      pts.push([x, y]);
      hit.add(Math.min(9, (x * 10) | 0) * 10 + Math.min(9, (y * 10) | 0));
    }
    ctx.fillStyle = `${ACCENT}22`;
    for (const k of hit) {
      const cx = Math.floor(k / 10), cy = k % 10;
      ctx.fillRect(pic.x + cx * cell, pic.y + pic.h - (cy + 1) * cell, cell, cell);
    }
    ctx.strokeStyle = ink(0.14);
    ctx.lineWidth = 1;
    for (let i = 0; i <= 10; i++) {
      ctx.beginPath();
      ctx.moveTo(pic.x + i * cell, pic.y);
      ctx.lineTo(pic.x + i * cell, pic.y + pic.h);
      ctx.moveTo(pic.x, pic.y + i * cell);
      ctx.lineTo(pic.x + pic.w, pic.y + i * cell);
      ctx.stroke();
    }
    ctx.fillStyle = TEAL;
    for (const [x, y] of pts) {
      ctx.beginPath();
      ctx.arc(pic.x + x * pic.w, pic.y + pic.h - y * pic.h, 1.7, 0, Math.PI * 2);
      ctx.fill();
    }
    picTitle(`${n} points seen through their first two axes`);
    picCaption(`${hit.size} of these 100 cells are hit · in d = ${d} it is ${occ} of ${fromLog10(d)}`);

    chartFrame([1, DMAX], [0, 1.05], dTicks, [0, 0.25, 0.5, 0.75, 1].map((v) => ({ v, t: v ? `${v * 100}%` : '0' })), 'dimensions d', `side of the box that holds ${state.frac}% of the data`);
    ctx.strokeStyle = ink(0.25);
    ctx.setLineDash([4, 4]);
    ctx.beginPath();
    ctx.moveTo(mx(1), my(1));
    ctx.lineTo(mx(DMAX), my(1));
    ctx.stroke();
    ctx.setLineDash([]);
    label('the whole axis', mx(DMAX) - 8, my(1) - 8, 0.4, 'right', 11.5);
    const edge = (dd: number) => Math.pow(f, 1 / dd);
    curve(edge, 1, DMAX, TEAL);
    dMarker(edge(d), `${pct(edge(d), 0)} of each axis`);

    setEq({
      rule: ['\\text{cells} = 10^{d}', '\\qquad', [`\\text{side holding a fraction } f = f^{1/d}`, TEAL]],
      live: [`10^{${d}} \\text{ cells}`, `\\quad ${occ}\\text{ occupied}`, [`\\quad ${f}^{1/${d}} = ${edge(d).toFixed(3)}`, TEAL]],
    });
    setPanel(
      [
        ['Cells, 10 per axis', fromLog10(d)],
        ['Cells with data in them', String(occ)],
        ['Share of cells occupied', `1 in ${fromLog10(d - Math.log10(occ))}`],
        [`Axis span for ${state.frac}%`, pct(edge(d), 1)],
        ['Points to match d = 1 density', fromLog10(d * Math.log10(n))],
      ],
      { label: `Axis span to hold ${state.frac}% of the data`, value: pct(edge(d), 0), note: `A neighbourhood holding ${state.frac}% of the data needs ${pct(edge(d), 0)} of every axis at d = ${d}. Past a handful of dimensions, "nearby" means "most of the dataset".` }
    );
  }

  // --- Mode 2: volume in the crust ---------------------------------------------
  function drawShell() {
    const d = state.d, n = state.n, eps = state.eps / 100;
    const { r } = data();
    const c = picCentre();
    ctx.fillStyle = `${AMBER}1f`;
    ctx.beginPath();
    ctx.arc(c.x, c.y, c.R, 0, Math.PI * 2);
    ctx.arc(c.x, c.y, c.R * (1 - eps), 0, Math.PI * 2, true);
    ctx.fill();
    ctx.strokeStyle = ink(0.4);
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.arc(c.x, c.y, c.R, 0, Math.PI * 2);
    ctx.stroke();
    ctx.strokeStyle = `${AMBER}99`;
    ctx.lineWidth = 1;
    ctx.setLineDash([3, 4]);
    ctx.beginPath();
    ctx.arc(c.x, c.y, c.R * (1 - eps), 0, Math.PI * 2);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = TEAL;
    for (let i = 0; i < n; i++) {
      const rad = r[i] * c.R;
      ctx.beginPath();
      ctx.arc(c.x + rad * Math.cos(bank.ang[i]), c.y + rad * Math.sin(bank.ang[i]), 1.7, 0, Math.PI * 2);
      ctx.fill();
    }
    picTitle('uniform points inside the ball');
    label(`outer ${state.eps}%`, c.x, c.y - c.R - 10, 1, 'center', 11.5, AMBER);
    picCaption('each dot sits at its true distance from the centre, at an arbitrary angle');

    const bins = 40;
    const counts = histogram(r, 0, 1, bins);
    let maxc = 0;
    for (let i = 0; i < bins; i++) maxc = Math.max(maxc, counts[i]);
    const top = Math.max(0.06, maxc * 1.2);
    chartFrame([0, 1], [0, top], [0, 0.25, 0.5, 0.75, 1].map((v) => ({ v, t: String(v) })), pctTicks(top), 'distance from the centre, r', 'share of the points');
    drawBars(counts, 0, 1, `${TEAL}66`);
    ctx.strokeStyle = TEAL;
    ctx.lineWidth = 2;
    ctx.beginPath();
    for (let i = 0; i < bins; i++) {
      const a = i / bins, b = (i + 1) / bins;
      const p = Math.pow(b, d) - Math.pow(a, d);
      i === 0 ? ctx.moveTo(mx((a + b) / 2), my(p)) : ctx.lineTo(mx((a + b) / 2), my(p));
    }
    ctx.stroke();
    vline(Math.pow(0.5, 1 / d), ACCENT, 'half the volume is past here');

    const inCrust = 1 - Math.pow(1 - eps, d);
    setEq({
      rule: ['V(r) \\propto r^{d}', '\\qquad', ['\\text{crust} = 1 - (1-\\varepsilon)^{d}', AMBER]],
      live: [`d = ${d}`, `\\quad\\varepsilon = ${eps}`, [`\\quad 1 - ${(1 - eps).toFixed(2)}^{${d}} = ${inCrust.toFixed(4)}`, AMBER]],
    });
    setPanel(
      [
        [`Volume in the outer ${state.eps}%`, pct(inCrust, 2)],
        ['Radius splitting it in half', Math.pow(0.5, 1 / d).toFixed(4)],
        ['Mean distance to the centre', (d / (d + 1)).toFixed(4)],
        ['Volume inside half the radius', `1 in ${fromLog10(d * Math.log10(2))}`],
      ],
      { label: `Volume in the outer ${state.eps}%`, value: pct(inCrust, 1), note: `Volume grows like r^d, so a shell of the last ${state.eps}% of the radius carries ${pct(inCrust, 1)} of the ball at d = ${d}. The interior is essentially empty.` }
    );
  }

  // --- Mode 3: all distances equal ---------------------------------------------
  function drawDistance() {
    const d = state.d, n = state.n;
    const { dist } = data();
    const c = picCentre();
    const scale = Math.sqrt(d);
    let lo = Infinity, hi = 0, sum = 0, sum2 = 0;
    for (let i = 0; i < n; i++) {
      const u = dist[i] / scale;
      lo = Math.min(lo, u); hi = Math.max(hi, u); sum += u; sum2 += u * u;
    }
    const mean = sum / n, sd = Math.sqrt(Math.max(0, sum2 / n - mean * mean));
    ctx.strokeStyle = ink(0.14);
    ctx.lineWidth = 1;
    for (const f of [0.25, 0.5, 0.75, 1]) {
      ctx.beginPath();
      ctx.arc(c.x, c.y, c.R * f, 0, Math.PI * 2);
      ctx.stroke();
    }
    ctx.fillStyle = TEAL;
    for (let i = 0; i < n; i++) {
      const rad = (dist[i] / scale) * c.R;
      ctx.beginPath();
      ctx.arc(c.x + rad * Math.cos(bank.ang[i]), c.y + rad * Math.sin(bank.ang[i]), 1.7, 0, Math.PI * 2);
      ctx.fill();
    }
    for (const [v, col] of [[lo, ACCENT], [hi, AMBER]] as [number, string][]) {
      ctx.strokeStyle = col;
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.arc(c.x, c.y, v * c.R, 0, Math.PI * 2);
      ctx.stroke();
    }
    ctx.fillStyle = ACCENT;
    ctx.beginPath();
    ctx.arc(c.x, c.y, 5, 0, Math.PI * 2);
    ctx.fill();
    picTitle('distance from one query point');
    label('nearest', c.x, c.y + lo * c.R + 16, 1, 'center', 11.5, ACCENT);
    label('farthest', c.x, c.y - hi * c.R - 8, 1, 'center', 11.5, AMBER);
    picCaption('every dot at its true distance, angle chosen at random');

    const bins = 44;
    const counts = histogram(Array.from({ length: n }, (_, i) => dist[i] / scale), 0, 1, bins);
    let maxc = 0;
    for (let i = 0; i < bins; i++) maxc = Math.max(maxc, counts[i]);
    const top = Math.max(0.06, maxc * 1.25);
    chartFrame([0, 1], [0, top], [0, 0.25, 0.5, 0.75, 1].map((v) => ({ v, t: String(v) })), pctTicks(top), 'distance ÷ √d', 'share of the points');
    drawBars(counts, 0, 1, `${TEAL}77`);
    vline(lo, ACCENT, '');
    vline(hi, AMBER, '');

    const contrast = (hi - lo) / lo;
    setEq({
      rule: [['\\dfrac{\\sigma(\\text{dist})}{\\mu(\\text{dist})} \\sim \\dfrac{1}{\\sqrt d}', TEAL], '\\qquad', ['\\dfrac{d_{\\max} - d_{\\min}}{d_{\\min}} \\to 0', AMBER]],
      live: [`d = ${d}`, [`\\quad\\sigma/\\mu = ${(sd / mean).toFixed(3)}`, TEAL], [`\\quad (d_{\\max}-d_{\\min})/d_{\\min} = ${contrast.toFixed(2)}`, AMBER]],
    });
    setPanel(
      [
        ['Nearest neighbour', (lo * scale).toFixed(3)],
        ['Farthest point', (hi * scale).toFixed(3)],
        ['(far − near) ÷ near', pct(contrast, 1)],
        ['Spread ÷ mean', pct(sd / mean, 2)],
      ],
      { label: 'Farthest is further than nearest by', value: pct(contrast, 0), note: `The farthest of ${n} points is only ${pct(contrast, 0)} further away than the nearest at d = ${d}. Distances still exist, but they stop ranking anything.` }
    );
  }

  // --- Mode 4: everything orthogonal -------------------------------------------
  function drawAngles() {
    const d = state.d, n = state.n;
    const { cos } = data();
    const c = picCentre();
    ctx.strokeStyle = ink(0.16);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.arc(c.x, c.y, c.R, 0, Math.PI * 2);
    ctx.stroke();
    ctx.strokeStyle = ink(0.2);
    ctx.setLineDash([4, 5]);
    ctx.beginPath();
    ctx.moveTo(c.x, c.y - c.R);
    ctx.lineTo(c.x, c.y + c.R);
    ctx.stroke();
    ctx.setLineDash([]);
    const shown = Math.min(n, 160);
    ctx.lineWidth = 1;
    for (let i = 0; i < shown; i++) {
      const th = Math.acos(Math.max(-1, Math.min(1, cos[i])));
      const s = bank.ang[i] > Math.PI ? 1 : -1;
      ctx.strokeStyle = `${TEAL}66`;
      ctx.beginPath();
      ctx.moveTo(c.x, c.y);
      ctx.lineTo(c.x + c.R * Math.cos(th), c.y + s * c.R * Math.sin(th));
      ctx.stroke();
    }
    ctx.strokeStyle = ACCENT;
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(c.x, c.y);
    ctx.lineTo(c.x + c.R, c.y);
    ctx.stroke();
    picTitle('angle to one fixed direction');
    label('reference', c.x + c.R, c.y - 10, 1, 'right', 11.5, ACCENT);
    label('90°', c.x + 14, c.y - c.R - 8, 0.45, 'left', 11.5);
    picCaption('160 random directions, each drawn at its true angle');

    const bins = 36;
    const theta = Array.from({ length: n }, (_, i) => (Math.acos(cos[i]) * 180) / Math.PI);
    const counts = histogram(theta, 0, 180, bins);
    let maxc = 0;
    for (let i = 0; i < bins; i++) maxc = Math.max(maxc, counts[i]);
    const top = Math.max(0.08, maxc * 1.25);
    chartFrame([0, 180], [0, top], [0, 45, 90, 135, 180].map((v) => ({ v, t: `${v}°` })), pctTicks(top), 'angle between two random vectors', 'share of the pairs');
    drawBars(counts, 0, 180, `${TEAL}66`);
    if (d >= 3) {
      const G = 360;
      const f = new Float64Array(G + 1);
      let tot = 0;
      for (let i = 0; i <= G; i++) { f[i] = Math.pow(Math.sin((Math.PI * i) / G), d - 2); tot += f[i]; }
      ctx.strokeStyle = TEAL;
      ctx.lineWidth = 2;
      ctx.beginPath();
      for (let i = 0; i <= G; i++) {
        const x = (180 * i) / G, y = (f[i] / tot) * (G / bins);
        i === 0 ? ctx.moveTo(mx(x), my(y)) : ctx.lineTo(mx(x), my(y));
      }
      ctx.stroke();
    }
    vline(90, ACCENT, 'orthogonal');

    let near = 0, absSum = 0;
    for (let i = 0; i < n; i++) { absSum += Math.abs(cos[i]); if (theta[i] > 80 && theta[i] < 100) near++; }
    const sdDeg = (180 / Math.PI) * (1 / Math.sqrt(d));
    setEq({
      rule: [['\\cos\\theta \\approx \\mathcal N\\!\\big(0,\\ \\tfrac{1}{d}\\big)', TEAL], '\\qquad', ['\\sigma_{\\cos\\theta} = 1/\\sqrt d', ACCENT]],
      live: [`d = ${d}`, [`\\quad 1/\\sqrt{${d}} = ${(1 / Math.sqrt(d)).toFixed(3)}`, ACCENT], `\\quad\\theta \\approx 90^\\circ \\pm ${sdDeg.toFixed(1)}^\\circ`],
    });
    setPanel(
      [
        ['Mean cos θ', '0 exactly'],
        ['Spread of cos θ', `±${(1 / Math.sqrt(d)).toFixed(3)}`],
        ['Mean |cos θ|', (absSum / n).toFixed(3)],
        ['Typical angle', `90° ± ${sdDeg.toFixed(1)}°`],
        ['Pairs within 80°–100°', pct(near / n, 1)],
      ],
      { label: 'Pairs within 10° of a right angle', value: pct(near / n, 0), note: `cos θ has mean 0 and standard deviation 1/√d, so two random directions in ${d} dimensions land ${pct(near / n, 0)} of the time within 10° of a right angle.` }
    );
  }

  // --- Mode 5: nothing but corners ---------------------------------------------
  function drawCorners() {
    const d = state.d;
    const c = picCentre();
    const R = c.R;
    ctx.beginPath();
    ctx.rect(c.x - R, c.y - R, 2 * R, 2 * R);
    ctx.moveTo(c.x + R, c.y);
    ctx.arc(c.x, c.y, R, 0, Math.PI * 2, true);
    ctx.fillStyle = `${AMBER}30`;
    ctx.fill('evenodd');
    ctx.strokeStyle = ink(0.35);
    ctx.lineWidth = 1.5;
    ctx.strokeRect(c.x - R, c.y - R, 2 * R, 2 * R);
    ctx.strokeStyle = TEAL;
    ctx.beginPath();
    ctx.arc(c.x, c.y, R, 0, Math.PI * 2);
    ctx.stroke();
    ctx.strokeStyle = TEAL;
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(c.x, c.y);
    ctx.lineTo(c.x + R, c.y);
    ctx.stroke();
    ctx.strokeStyle = ACCENT;
    ctx.lineWidth = 1.5;
    ctx.setLineDash([5, 4]);
    ctx.beginPath();
    ctx.moveTo(c.x, c.y);
    ctx.lineTo(c.x + R, c.y - R);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = ACCENT;
    ctx.beginPath();
    ctx.arc(c.x, c.y, 4, 0, Math.PI * 2);
    ctx.fill();
    picTitle('ball inscribed in a cube');
    label('radius 1', c.x + R / 2, c.y + 18, 1, 'center', 11, TEAL);
    label(`√d = ${Math.sqrt(d).toFixed(2)}`, c.x + R - 6, c.y - R - 8, 1, 'right', 11, ACCENT);
    label('corners', c.x - R + 10, c.y + R - 12, 1, 'left', 11, AMBER);
    picCaption('the shaded part of the box lies outside the ball');

    const lo = -95;
    chartFrame([1, DMAX], [lo, 2], dTicks, [{ v: 0, t: '1' }, { v: -20, t: '10^-20' }, { v: -40, t: '10^-40' }, { v: -60, t: '10^-60' }, { v: -80, t: '10^-80' }], 'dimensions d', 'ball volume ÷ cube volume');
    curve((dd) => Math.max(lo, log10BallOverCube(dd)), 1, DMAX, TEAL);
    const ratioLog = log10BallOverCube(d);
    dMarker(Math.max(lo, ratioLog), `1 in ${fromLog10(-ratioLog)}`);

    setEq({
      rule: [['\\dfrac{V_{\\text{ball}}}{V_{\\text{cube}}} = \\dfrac{\\pi^{d/2}}{\\Gamma(d/2+1)\\,2^{d}}', TEAL], '\\qquad', ['\\text{half-diagonal} = \\sqrt d', ACCENT]],
      live: [`d = ${d}`, [`\\quad V_{\\text{ball}}/V_{\\text{cube}} = 10^{${ratioLog.toFixed(1)}}`, TEAL], [`\\quad\\sqrt{${d}} = ${Math.sqrt(d).toFixed(2)}`, ACCENT]],
    });
    setPanel(
      [
        ['Ball ÷ cube volume', `1 in ${fromLog10(-ratioLog)}`],
        ['Cube volume in the corners', ratioLog < -6 ? '99.9999…%' : pct(1 - Math.pow(10, ratioLog), 4)],
        ['Number of corners', fromLog10(d * Math.log10(2))],
        ['Half-diagonal ÷ inradius', `${Math.sqrt(d).toFixed(2)} : 1`],
      ],
      { label: 'Share of the cube inside the ball', value: `1 in ${fromLog10(-ratioLog).replace(/\^(-?\d+)/, '^$1')}`, note: `The ball still touches all ${2 * d} faces, yet at d = ${d} it holds 1 part in ${fromLog10(-ratioLog)} of the box. Corners run off to distance √d while the faces stay at 1.` }
    );
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    if (state.mode === 'sparsity') drawSparsity();
    else if (state.mode === 'shell') drawShell();
    else if (state.mode === 'distance') drawDistance();
    else if (state.mode === 'angles') drawAngles();
    else drawCorners();
  }

  // --- controls --------------------------------------------------------------
  function syncContext() {
    document.querySelectorAll<HTMLElement>('[data-for]').forEach((node) => {
      node.hidden = !node.dataset.for!.split(' ').includes(state.mode);
    });
  }
  const setD = slider('d', (v) => { state.d = v; draw(); });
  slider('n', (v) => { state.n = v; draw(); });
  slider('frac', (v) => { state.frac = v; draw(); }, (v) => `${v}%`);
  slider('eps', (v) => { state.eps = v; draw(); }, (v) => `${v}%`);
  segmented('mode', (m) => { state.mode = m; syncContext(); draw(); });
  const controls = transport({
    onRun: (running) => { state.playing = running; if (running) requestAnimationFrame(tick); },
    onStep: () => { state.d = state.d >= DMAX ? 1 : state.d + 1; setD(state.d); draw(); },
    onReset: () => {
      state.playing = false;
      controls.setRunning(false);
      state.d = 2;
      bank = buildBank(7);
      cacheKey = '';
      setD(state.d);
      draw();
    },
  });

  let acc = 0, last = 0;
  function tick(t: number) {
    if (!state.playing) { last = 0; return; }
    const dt = last ? Math.min(0.1, (t - last) / 1000) : 0;
    last = t;
    acc += dt * 26; // dimensions per second
    if (acc >= 1) {
      const step = Math.floor(acc);
      acc -= step;
      state.d = state.d + step > DMAX ? 1 : state.d + step;
      setD(state.d);
      draw();
    }
    requestAnimationFrame(tick);
  }

  syncContext();
  draw();
</script>

<style>
  :global(#mode.seg) {
    flex-direction: column;
    align-items: stretch;
  }
  :global(#mode.seg button) {
    text-align: left;
  }
</style>
