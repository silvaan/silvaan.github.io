---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
---

<SimLayout
  areaSlug="machine-learning"
  title="Activation Functions"
  description="The nonlinearity between layers lets a network bend, not just scale. Compare the classic activations and their derivatives: where the slope goes flat, learning stalls."
  shortcuts={['fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="act"
          width="1000"
          height="600"
          role="img"
          aria-label="An activation function and its derivative plotted together, with the regions where the derivative is nearly zero shaded."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'activation f(x)', color: '#5eead4' },
          { label: 'derivative f′(x)', color: '#f59e0b' },
          { label: 'saturated, |f′| < 0.1', color: 'rgba(248,113,113,0.6)' },
        ]}
        hint="Click the plot to move x"
      />
      <Result label="Gradient f′(x)" />
    </div>

    <div class="sim-panel">
      <Seg
        id="fn"
        label="Activation"
        attr="f"
        options={[
          { value: 'sigmoid', label: 'Sigmoid' },
          { value: 'tanh', label: 'tanh' },
          { value: 'relu', label: 'ReLU' },
          { value: 'leaky', label: 'Leaky' },
          { value: 'gelu', label: 'GELU' },
          { value: 'softplus', label: 'Softplus' },
        ]}
      />
      <Slider id="x" label="Input x" min={-500} max={500} value={80} display="0.80" />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Teal is the activation, amber is its <b>derivative</b>, the factor every
      gradient gets multiplied by during backprop. Where amber sits near zero,
      that layer barely learns.
    </li>
    <li>
      Drag x into the tails of <b>Sigmoid</b> or <b>tanh</b>: the curve flattens
      and f′ collapses toward 0. Stack many such layers and gradients
      <b>vanish</b>, the problem ReLU was invented to dodge.
    </li>
    <li>
      <b>ReLU</b> keeps a slope of exactly 1 for x &gt; 0 (no vanishing) but is
      flat and <b>dead</b> for x &lt; 0. <b>Leaky</b> and <b>GELU</b> patch that
      dead zone in different ways.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk, fixed } from '../../../lib/draw';
  import { el, segmented, slider, result } from '../../../lib/panel';

  const F = '#5eead4', DF = '#f59e0b';
  const erf = (x: number) => {
    // Abramowitz-Stegun approximation
    const t = 1 / (1 + 0.3275911 * Math.abs(x));
    const y = 1 - (((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t) * Math.exp(-x * x);
    return x >= 0 ? y : -y;
  };
  type Act = { f: (x: number) => number; tex: string; note: string };
  const ACTS: Record<string, Act> = {
    sigmoid: {
      f: (x) => 1 / (1 + Math.exp(-x)),
      tex: '\\sigma(x) = \\dfrac{1}{1 + e^{-x}}',
      note: 'Squashes any input into (0, 1). Smooth, but it saturates at both ends, so its gradient vanishes for large |x|.',
    },
    tanh: {
      f: (x) => Math.tanh(x),
      tex: '\\tanh(x) = \\dfrac{e^{x} - e^{-x}}{e^{x} + e^{-x}}',
      note: 'Like sigmoid but zero-centered, mapping to (−1, 1). Still saturates in the tails.',
    },
    relu: {
      f: (x) => Math.max(0, x),
      tex: '\\mathrm{ReLU}(x) = \\max(0, x)',
      note: 'Cheap and non-saturating for x > 0, where its slope is exactly 1. But it is flat for x < 0, so those neurons can go permanently dead.',
    },
    leaky: {
      f: (x) => (x > 0 ? x : 0.1 * x),
      tex: 'f(x) = \\max(0.1\\,x,\\; x)',
      note: 'A ReLU that leaks a small slope (0.1) for x < 0, so gradients never fully vanish and neurons rarely die.',
    },
    gelu: {
      f: (x) => 0.5 * x * (1 + erf(x / Math.SQRT2)),
      tex: '\\mathrm{GELU}(x) = x\\,\\Phi(x)',
      note: 'A smooth, probabilistic cousin of ReLU. The default activation in most modern transformers.',
    },
    softplus: {
      f: (x) => Math.log(1 + Math.exp(x)),
      tex: '\\mathrm{softplus}(x) = \\log(1 + e^{x})',
      note: 'A smooth approximation of ReLU. Beautifully, its derivative is exactly the sigmoid.',
    },
  };

  const state = { fn: 'sigmoid', x: 0.8 };
  const canvas = el('act') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();

  const PAD = { l: 50, r: 30, t: 30, b: 44 };
  const XR = [-5, 5] as const, YR = [-1.6, 3] as const;
  const f = (x: number) => ACTS[state.fn].f(x);
  const df = (x: number) => (f(x + 1e-4) - f(x - 1e-4)) / 2e-4;
  const sx = (x: number) => PAD.l + ((x - XR[0]) / (XR[1] - XR[0])) * (W - PAD.l - PAD.r);
  const sy = (y: number) => H - PAD.b - ((y - YR[0]) / (YR[1] - YR[0])) * (H - PAD.t - PAD.b);

  function draw() {
    ctx.clearRect(0, 0, W, H);

    // where the gradient has all but vanished
    for (let px = PAD.l; px <= W - PAD.r; px += 3) {
      const x = XR[0] + ((px - PAD.l) / (W - PAD.l - PAD.r)) * (XR[1] - XR[0]);
      if (Math.abs(df(x)) < 0.1) {
        ctx.fillStyle = 'rgba(248,113,113,0.07)';
        ctx.fillRect(px, PAD.t, 3, H - PAD.t - PAD.b);
      }
    }
    ctx.strokeStyle = ink(0.07);
    ctx.lineWidth = 1;
    for (let xv = -5; xv <= 5; xv++) {
      ctx.beginPath();
      ctx.moveTo(sx(xv), PAD.t);
      ctx.lineTo(sx(xv), H - PAD.b);
      ctx.stroke();
      label(String(xv), sx(xv), H - PAD.b + 18, 0.3, 'center', 10.5);
    }
    for (const yv of [-1, 1, 2, 3]) label(String(yv), PAD.l - 10, sy(yv) + 4, 0.3, 'right', 10.5);
    ctx.strokeStyle = ink(0.25);
    ctx.beginPath();
    ctx.moveTo(PAD.l, sy(0));
    ctx.lineTo(W - PAD.r, sy(0));
    ctx.stroke();

    const plot = (g: (x: number) => number, color: string, width: number) => {
      ctx.strokeStyle = color;
      ctx.lineWidth = width;
      ctx.beginPath();
      let pen = false;
      for (let i = 0; i <= 500; i++) {
        const x = XR[0] + ((XR[1] - XR[0]) * i) / 500;
        const y = g(x);
        if (y < YR[0] - 1 || y > YR[1] + 1) { pen = false; continue; }
        pen ? ctx.lineTo(sx(x), sy(y)) : (ctx.moveTo(sx(x), sy(y)), (pen = true));
      }
      ctx.stroke();
    };
    plot(df, DF, 2);
    plot(f, F, 2.8);

    const xv = state.x;
    ctx.strokeStyle = ink(0.4);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(sx(xv), PAD.t);
    ctx.lineTo(sx(xv), H - PAD.b);
    ctx.stroke();
    ctx.fillStyle = F;
    ctx.beginPath();
    ctx.arc(sx(xv), sy(f(xv)), 5.5, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = DF;
    ctx.beginPath();
    ctx.arc(sx(xv), sy(df(xv)), 5, 0, Math.PI * 2);
    ctx.fill();
    label(`x = ${fixed(xv, 2)}`, sx(xv) + 8, PAD.t + 14, 0.6, 'left', 10.5);

    const act = ACTS[state.fn];
    const g = df(xv);
    setEq({
      rule: [[act.tex, F]],
      live: [[`f(${fixed(xv, 2)}) = ${fixed(f(xv), 3)}`, F], [`\\quad f'(${fixed(xv, 2)}) = ${fixed(g, 3)}`, DF]],
    });
    setResult({
      value: fixed(g, 3),
      colour: Math.abs(g) < 0.1 ? '#f87171' : DF,
      status: Math.abs(g) < 0.1 ? `f(x) = ${fixed(f(xv), 3)} · saturated: a layer here barely learns` : `f(x) = ${fixed(f(xv), 3)}`,
      note: act.note,
    });
  }

  const setX = slider('x', (v) => { state.x = v / 100; draw(); }, (v) => fixed(v / 100, 2));
  segmented('fn', (fn) => { state.fn = fn; draw(); });
  canvas.addEventListener('pointerdown', (e) => {
    const rect = canvas.getBoundingClientRect();
    const px = ((e.clientX - rect.left) / rect.width) * W;
    state.x = Math.max(-5, Math.min(5, XR[0] + ((px - PAD.l) / (W - PAD.l - PAD.r)) * (XR[1] - XR[0])));
    setX(Math.round(state.x * 100));
    draw();
  });

  draw();
</script>

<style>
  #act {
    cursor: crosshair;
  }
</style>
