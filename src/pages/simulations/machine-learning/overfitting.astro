---
import SimLayout from '../../../layouts/SimLayout.astro';
import Slider from '../../../components/sim/Slider.astro';
import Actions from '../../../components/sim/Actions.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="machine-learning"
  title="Overfitting"
  description="Fit a polynomial to noisy data and raise its degree. A flexible enough curve threads every training point, and does worse on new data."
  shortcuts={['fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="of"
          width="1000"
          height="600"
          role="img"
          aria-label="Noisy data points with a polynomial fit and the true function, and below them the training and test error against polynomial degree."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'training points', color: '#7c8cff' },
          { label: 'test points', color: 'rgba(154,160,172,0.7)' },
          { label: 'the fit', color: '#f59e0b' },
          { label: 'true function', color: 'rgba(232,233,236,0.45)' },
          { label: 'train error', color: '#5eead4' },
        ]}
      />
      <Result label="Test error" />
    </div>

    <div class="sim-panel">
      <Slider id="d" label="Polynomial degree" min={0} max={11} value={3} />
      <Slider id="l" label="Regularization λ" min={0} max={100} value={0} display="0.000" />
      <Actions>
        <button type="button" class="btn ghost" id="regen">New data</button>
      </Actions>
      <Readout rows={[{ id: 'r-train', label: 'train error' }, { id: 'r-test', label: 'test error' }]} />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Slide the degree up. <b>Train error</b> keeps falling and reaches zero at
      degree 11, where the curve threads all 12 training points.
      <Try id="thread" />
    </li>
    <li>
      <b>Test error</b> in the strip falls, bottoms out, then climbs as the
      curve chases noise: the <b>bias–variance tradeoff</b>. The best degree
      sits in the middle. <Try id="best" />
    </li>
    <li>
      At degree 11, raise <b>λ</b>. Penalising the weights (all but the
      intercept w₀) <b>smooths</b> the curve and brings test error back down
      without lowering the degree. <Try id="ridge" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk, fixed } from '../../../lib/draw';
  import { el, slider, result, readout, tries } from '../../../lib/panel';

  const TRAIN = '#7c8cff', FIT = '#f59e0b', TRAINERR = '#5eead4';
  const N_TRAIN = 12, MAX_D = N_TRAIN - 1; // degree n − 1 can pass through every point
  const state = { degree: 3, lambda: 0 };
  let train: { x: number; y: number }[] = [];
  let test: { x: number; y: number }[] = [];

  const canvas = el('of') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink, inv } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  const TOP = { l: 30, r: 30, t: 20, bottom: 380, b: 26 };
  const STRIP = { x: 60, y: 440, w: W - 150, h: 120 };
  const XR = [-1, 1] as const, YR = [-1.7, 1.7] as const;
  const trueF = (x: number) => 0.85 * Math.sin(Math.PI * x) + 0.15 * x;

  function gen() {
    const noise = () => (Math.random() * 2 - 1) * 0.28;
    train = [];
    for (let i = 0; i < N_TRAIN; i++) {
      const x = Math.max(-1, Math.min(1, -1 + (2 * i) / (N_TRAIN - 1) + (Math.random() * 2 - 1) * 0.03));
      train.push({ x, y: trueF(x) + noise() });
    }
    test = [];
    for (let i = 0; i < 40; i++) {
      const x = Math.random() * 2 - 1;
      test.push({ x, y: trueF(x) + noise() });
    }
  }

  /** Legendre polynomials P₀…P_{m−1} at x: a basis on [−1, 1] that stays well conditioned at high degree. */
  function basis(x: number, m: number) {
    const P = [1, x];
    for (let k = 1; k < m - 1; k++) P.push(((2 * k + 1) * x * P[k] - k * P[k - 1]) / (k + 1));
    return P.slice(0, m);
  }

  /**
   * Ridge fit by least squares on the design matrix stacked over √λ·I, solved
   * with Householder QR rather than the normal equations. The intercept w₀ is
   * left out of the penalty, so λ shrinks the shape of the curve, not its level.
   */
  function fit(degree: number, lambda: number): number[] {
    const m = degree + 1;
    const A: number[][] = [], b: number[] = [];
    for (const p of train) { A.push(basis(p.x, m)); b.push(p.y); }
    const s = Math.sqrt(lambda);
    for (let k = 1; k < m; k++) {
      const row = new Array(m).fill(0);
      row[k] = s;
      A.push(row);
      b.push(0);
    }
    const R = A.length;
    for (let c = 0; c < m; c++) {
      let nrm = 0;
      for (let r = c; r < R; r++) nrm += A[r][c] ** 2;
      nrm = Math.sqrt(nrm);
      if (nrm < 1e-14) continue;
      const v: number[] = [];
      for (let r = c; r < R; r++) v.push(A[r][c]);
      v[0] -= A[c][c] > 0 ? -nrm : nrm;
      let vv = 0;
      for (const t of v) vv += t * t;
      if (vv < 1e-30) continue;
      for (let j = c; j < m; j++) {
        let d = 0;
        for (let r = c; r < R; r++) d += v[r - c] * A[r][j];
        d = (2 * d) / vv;
        for (let r = c; r < R; r++) A[r][j] -= d * v[r - c];
      }
      let d = 0;
      for (let r = c; r < R; r++) d += v[r - c] * b[r];
      d = (2 * d) / vv;
      for (let r = c; r < R; r++) b[r] -= d * v[r - c];
    }
    const w = new Array(m).fill(0);
    for (let i = m - 1; i >= 0; i--) {
      let t = b[i];
      for (let j = i + 1; j < m; j++) t -= A[i][j] * w[j];
      w[i] = Math.abs(A[i][i]) > 1e-12 ? t / A[i][i] : 0;
    }
    return w;
  }
  const evalPoly = (w: number[], x: number) => {
    const P = basis(x, w.length);
    let s = 0;
    for (let k = 0; k < w.length; k++) s += w[k] * P[k];
    return s;
  };
  const mse = (w: number[], set: { x: number; y: number }[]) =>
    set.reduce((s, p) => s + (evalPoly(w, p.x) - p.y) ** 2, 0) / set.length;

  const sx = (x: number) => TOP.l + ((x - XR[0]) / (XR[1] - XR[0])) * (W - TOP.l - TOP.r);
  const sy = (y: number) => TOP.bottom - TOP.b - ((y - YR[0]) / (YR[1] - YR[0])) * (TOP.bottom - TOP.t - TOP.b);

  function drawFit(w: number[]) {
    ctx.strokeStyle = ink(0.07);
    ctx.lineWidth = 1;
    for (let i = 0; i <= 8; i++) {
      const x = XR[0] + ((XR[1] - XR[0]) * i) / 8;
      ctx.beginPath();
      ctx.moveTo(sx(x), TOP.t);
      ctx.lineTo(sx(x), TOP.bottom - TOP.b);
      ctx.stroke();
      label(x.toFixed(2), sx(x), TOP.bottom - TOP.b + 18, 0.3, 'center', 11.5);
    }
    ctx.strokeStyle = ink(0.25);
    ctx.beginPath();
    ctx.moveTo(TOP.l, sy(0));
    ctx.lineTo(W - TOP.r, sy(0));
    ctx.stroke();

    ctx.strokeStyle = ink(0.35);
    ctx.lineWidth = 1.5;
    ctx.setLineDash([6, 5]);
    ctx.beginPath();
    for (let i = 0; i <= 300; i++) {
      const x = XR[0] + ((XR[1] - XR[0]) * i) / 300;
      i === 0 ? ctx.moveTo(sx(x), sy(trueF(x))) : ctx.lineTo(sx(x), sy(trueF(x)));
    }
    ctx.stroke();
    ctx.setLineDash([]);

    ctx.strokeStyle = FIT;
    ctx.lineWidth = 2.6;
    ctx.beginPath();
    let pen = false;
    for (let i = 0; i <= 400; i++) {
      const x = XR[0] + ((XR[1] - XR[0]) * i) / 400;
      const y = evalPoly(w, x);
      if (y < YR[0] - 1 || y > YR[1] + 1) { pen = false; continue; }
      pen ? ctx.lineTo(sx(x), sy(y)) : (ctx.moveTo(sx(x), sy(y)), (pen = true));
    }
    ctx.stroke();

    for (const p of test) {
      ctx.fillStyle = ink(0.35);
      ctx.beginPath();
      ctx.arc(sx(p.x), sy(p.y), 2.2, 0, Math.PI * 2);
      ctx.fill();
    }
    for (const p of train) {
      ctx.fillStyle = TRAIN;
      ctx.strokeStyle = inv(0.9);
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.arc(sx(p.x), sy(p.y), 5.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
    }
  }

  /** Train and test error at every degree, for the current λ. */
  function curves() {
    const tr: number[] = [], te: number[] = [];
    for (let d = 0; d <= MAX_D; d++) {
      const w = fit(d, state.lambda);
      tr.push(mse(w, train));
      te.push(Math.min(2, mse(w, test)));
    }
    return { tr, te };
  }

  function drawStrip() {
    label('error against degree, at this λ', STRIP.x, STRIP.y - 10, 0.45, 'left', 11.5);
    const maxD = MAX_D;
    const { tr, te } = curves();
    const hi = Math.max(0.3, ...te, ...tr) * 1.1;
    const gx = (d: number) => STRIP.x + (d / maxD) * STRIP.w;
    const gy = (v: number) => STRIP.y + (1 - v / hi) * STRIP.h;
    ctx.strokeStyle = ink(0.12);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(STRIP.x, STRIP.y + STRIP.h);
    ctx.lineTo(STRIP.x + STRIP.w, STRIP.y + STRIP.h);
    ctx.stroke();
    for (let d = 0; d <= maxD; d++) label(String(d), gx(d), STRIP.y + STRIP.h + 16, 0.3, 'center', 11);
    label('degree', STRIP.x + STRIP.w, STRIP.y + STRIP.h + 32, 0.3, 'right', 11);
    const plot = (arr: number[], color: string) => {
      ctx.strokeStyle = color;
      ctx.lineWidth = 2;
      ctx.beginPath();
      arr.forEach((v, d) => (d ? ctx.lineTo(gx(d), gy(v)) : ctx.moveTo(gx(d), gy(v))));
      ctx.stroke();
    };
    plot(tr, TRAINERR);
    plot(te, FIT);
    label('test', gx(maxD) + 8, gy(te[maxD]) + 4, 1, 'left', 11.5, FIT);
    label('train', gx(maxD) + 8, gy(tr[maxD]) + 4, 1, 'left', 11.5, TRAINERR);
    ctx.strokeStyle = ink(0.4);
    ctx.setLineDash([4, 4]);
    ctx.beginPath();
    ctx.moveTo(gx(state.degree), STRIP.y);
    ctx.lineTo(gx(state.degree), STRIP.y + STRIP.h);
    ctx.stroke();
    ctx.setLineDash([]);
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    const w = fit(state.degree, state.lambda);
    drawFit(w);
    drawStrip();

    const trainErr = mse(w, train), testErr = mse(w, test);
    const verdict =
      state.degree <= 1 && trainErr > 0.15 ? ['underfitting', 'The curve is too stiff to follow the trend, so both errors stay high: high bias.']
      : testErr > 2 * trainErr && testErr > 0.06 && state.degree >= 5 ? ['overfitting', 'The curve chases the noise in the training points and pays for it on the test points: high variance.']
      : ['fitting well', 'Train and test errors are close: the curve follows the trend without memorising the noise.'];
    setEq({
      rule: [['\\hat y = \\sum_{k=0}^{d} w_k P_k(x)', FIT], '\\quad\\text{minimising}\\quad', ['\\sum_i (y_i - \\hat y_i)^2', TRAINERR], `+ \\lambda\\sum_{k\\ge 1} w_k^2`],
      live: [`d = ${state.degree}`, `\\quad\\lambda = ${state.lambda.toFixed(3)}`, [`\\quad\\text{train} = ${fixed(trainErr, 4)}`, TRAINERR], [`\\quad\\text{test} = ${fixed(testErr, 4)}`, FIT]],
    });
    setResult({
      value: fixed(testErr, 4),
      colour: FIT,
      status: `train error ${fixed(trainErr, 4)} · ${verdict[0]}`,
      note: verdict[1],
    });
    setRows({ 'r-train': fixed(trainErr, 4), 'r-test': fixed(testErr, 4) });
  }

  const lam = (v: number) => (v / 100) ** 2 * 2;
  const setD = slider('d', (v) => { state.degree = v; draw(); });
  const setL = slider('l', (v) => { state.lambda = lam(v); draw(); }, (v) => lam(v).toFixed(3));
  el('regen').addEventListener('click', () => { gen(); draw(); });

  function show(degree: number, l: number) {
    state.degree = degree;
    setD(degree);
    state.lambda = lam(l);
    setL(l);
    draw();
  }
  tries({
    thread: () => show(MAX_D, 0),
    best: () => {
      show(state.degree, 0);
      const { te } = curves();
      show(te.indexOf(Math.min(...te)), 0);
    },
    ridge: () => show(MAX_D, 30),
  });

  gen();
  draw();
</script>
