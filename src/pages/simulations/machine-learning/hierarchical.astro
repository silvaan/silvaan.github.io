---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Transport from '../../../components/sim/Transport.astro';
import Actions from '../../../components/sim/Actions.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
---

<SimLayout
  areaSlug="machine-learning"
  title="Hierarchical Clustering"
  description="Merge the two closest groups over and over until everything is one, and watch the dendrogram grow branch by branch."
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="hc"
          width="1000"
          height="600"
          role="img"
          aria-label="Points coloured by their current cluster on the left, and the dendrogram of merges growing on the right."
        ></canvas>
      </div>
      <Caption hint="Click the left half to add points" />
      <Result label="Clusters" />
    </div>

    <div class="sim-panel">
      <Transport step />
      <Actions>
        <button type="button" class="btn ghost" id="regen">Random points</button>
        <button type="button" class="btn ghost" id="clear">Clear</button>
      </Actions>
      <Seg
        id="link"
        label="Linkage"
        attr="l"
        options={[
          { value: 'average', label: 'Average' },
          { value: 'single', label: 'Single' },
          { value: 'complete', label: 'Complete' },
        ]}
      />
      <Readout rows={[{ id: 'r-merges', label: 'merges done' }, { id: 'r-clusters', label: 'clusters' }, { id: 'r-last', label: 'last merge distance' }]} />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Each <b>Step</b> joins the <b>two nearest groups</b> and records how far
      apart they were as the bar's height. Short bars mean tight, obvious groups;
      tall bars join things only reluctantly.
    </li>
    <li>
      You never chose a number of clusters. One tree holds them at <b>every
      scale</b>: stop early for many small groups, run to the end for one.
    </li>
    <li>
      Switch the <b>linkage</b>. Single-link chains through bridges and can merge
      far things via stepping stones; complete-link keeps clusters compact. Same
      points, different tree.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk } from '../../../lib/draw';
  import { el, segmented, transport, result, readout } from '../../../lib/panel';

  type Node = { x: number; height: number; members: number[]; left?: Node; right?: Node; repL?: number; repR?: number };
  const PALETTE = ['#7c8cff', '#f59e0b', '#2dd4bf', '#f87171', '#a78bfa', '#34d399', '#f472b6', '#38bdf8'];

  const state = { link: 'average', merges: 0, running: false };
  let pts: { x: number; y: number }[] = [];
  let mergeNodes: Node[] = [];
  let leafNodes: Node[] = [];
  let root: Node | null = null;
  let maxH = 1;

  const canvas = el('hc') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();
  const rnd = (a: number, b: number) => a + Math.random() * (b - a);

  const LEFT = { x0: 40, x1: 460, y0: 40, y1: 540 };
  const RIGHT = { x0: 540, x1: 960, y0: 60, y1: 520 };

  function gen() {
    pts = [];
    const nb = 4;
    const bc = Array.from({ length: nb }, () => ({ x: rnd(LEFT.x0 + 60, LEFT.x1 - 60), y: rnd(LEFT.y0 + 60, LEFT.y1 - 60) }));
    for (let i = 0; i < 26; i++) {
      const b = bc[i % nb];
      pts.push({ x: b.x + rnd(-38, 38), y: b.y + rnd(-38, 38) });
    }
  }

  const dist = (a: number, b: number) => Math.hypot(pts[a].x - pts[b].x, pts[a].y - pts[b].y);
  function linkage(A: number[], B: number[]) {
    let best = state.link === 'single' ? Infinity : state.link === 'complete' ? -Infinity : 0;
    let cnt = 0;
    for (const a of A)
      for (const b of B) {
        const d = dist(a, b);
        if (state.link === 'single') best = Math.min(best, d);
        else if (state.link === 'complete') best = Math.max(best, d);
        else { best += d; cnt++; }
      }
    return state.link === 'average' ? best / cnt : best;
  }

  function build() {
    mergeNodes = [];
    leafNodes = pts.map((_, i) => ({ x: 0, height: 0, members: [i] }));
    let clusters = [...leafNodes];
    while (clusters.length > 1) {
      let bi = 0, bj = 1, bd = Infinity;
      for (let i = 0; i < clusters.length; i++)
        for (let j = i + 1; j < clusters.length; j++) {
          const d = linkage(clusters[i].members, clusters[j].members);
          if (d < bd) { bd = d; bi = i; bj = j; }
        }
      const a = clusters[bi], b = clusters[bj];
      const node: Node = { x: 0, height: bd, members: [...a.members, ...b.members], left: a, right: b, repL: a.members[0], repR: b.members[0] };
      clusters = clusters.filter((_, k) => k !== bi && k !== bj);
      clusters.push(node);
      mergeNodes.push(node);
    }
    root = clusters[0] || null;
    maxH = (root && root.height) || 1;
    if (root) {
      let counter = 0;
      const assignX = (n: Node) => {
        if (!n.left) { n.x = counter++; return; }
        assignX(n.left);
        assignX(n.right!);
        n.x = (n.left.x + n.right!.x) / 2;
      };
      assignX(root);
    }
    state.merges = 0;
  }

  function clustersAt(m: number) {
    const parent = pts.map((_, i) => i);
    const find = (a: number): number => {
      while (parent[a] !== a) { parent[a] = parent[parent[a]]; a = parent[a]; }
      return a;
    };
    for (let k = 0; k < m; k++) parent[find(mergeNodes[k].repL!)] = find(mergeNodes[k].repR!);
    const groups = new Map<number, number[]>();
    for (let i = 0; i < pts.length; i++) {
      const r = find(i);
      if (!groups.has(r)) groups.set(r, []);
      groups.get(r)!.push(i);
    }
    const rootColor = new Map<number, string>();
    const roots = [...groups.keys()].sort((a, b) => Math.min(...groups.get(a)!) - Math.min(...groups.get(b)!));
    let ci = 0;
    for (const r of roots) if (groups.get(r)!.length >= 2) rootColor.set(r, PALETTE[ci++ % PALETTE.length]);
    return { find, rootColor, nClusters: groups.size };
  }

  const RULES: Record<string, string> = {
    average: 'd(A,B) = \\frac{1}{|A|\\,|B|}\\sum_{a\\in A}\\sum_{b\\in B} \\lVert a - b\\rVert',
    single: 'd(A,B) = \\min_{a\\in A,\\,b\\in B} \\lVert a - b\\rVert',
    complete: 'd(A,B) = \\max_{a\\in A,\\,b\\in B} \\lVert a - b\\rVert',
  };

  function draw() {
    ctx.clearRect(0, 0, W, H);
    label('the points', LEFT.x0, LEFT.y0 - 12, 0.45, 'left', 10.5);
    label('the dendrogram: bar height is the merge distance', RIGHT.x0, RIGHT.y0 - 30, 0.45, 'left', 10.5);

    if (pts.length === 0) {
      label('click here to add points', LEFT.x0 + 10, LEFT.y0 + 24, 0.4, 'left', 12);
      words(null, 0);
      return;
    }
    const cl = clustersAt(state.merges);
    for (let i = 0; i < pts.length; i++) {
      ctx.fillStyle = cl.rootColor.get(cl.find(i)) || ink(0.4);
      ctx.strokeStyle = ink(0.5);
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(pts[i].x, pts[i].y, 5.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
    }

    if (root && pts.length > 1) {
      const L = pts.length;
      const dx = (x: number) => RIGHT.x0 + (x / (L - 1)) * (RIGHT.x1 - RIGHT.x0);
      const dy = (ht: number) => RIGHT.y1 - (ht / maxH) * (RIGHT.y1 - RIGHT.y0);
      ctx.strokeStyle = ink(0.12);
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(RIGHT.x0 - 10, RIGHT.y1);
      ctx.lineTo(RIGHT.x1 + 10, RIGHT.y1);
      ctx.stroke();
      label('0', RIGHT.x0 - 16, RIGHT.y1 + 4, 0.3, 'right', 10);
      label(maxH.toFixed(0), RIGHT.x0 - 16, RIGHT.y0 + 4, 0.3, 'right', 10);
      for (let k = 0; k < state.merges; k++) {
        const n = mergeNodes[k];
        const col = cl.rootColor.get(cl.find(n.repL!)) || ink(0.4);
        const yTop = dy(n.height);
        const lx = dx(n.left!.x), rx = dx(n.right!.x);
        ctx.strokeStyle = col;
        ctx.lineWidth = 1.8;
        ctx.beginPath();
        ctx.moveTo(lx, dy(n.left!.height));
        ctx.lineTo(lx, yTop);
        ctx.lineTo(rx, yTop);
        ctx.lineTo(rx, dy(n.right!.height));
        ctx.stroke();
      }
      ctx.fillStyle = ink(0.3);
      for (const leaf of leafNodes) {
        ctx.beginPath();
        ctx.arc(dx(leaf.x), dy(0), 1.8, 0, Math.PI * 2);
        ctx.fill();
      }
    }
    words(cl, cl.nClusters);
  }

  function words(cl: { nClusters: number } | null, nClusters: number) {
    const last = state.merges > 0 ? mergeNodes[state.merges - 1].height : null;
    setEq({
      rule: [[RULES[state.link], PALETTE[0]]],
      live: [`\\text{merges} = ${state.merges}`, `\\quad\\text{clusters} = ${nClusters}`, last !== null ? `\\quad\\text{last } d = ${last.toFixed(1)}` : ''],
    });
    setResult({
      value: cl ? String(nClusters) : '—',
      status: cl
        ? state.merges >= mergeNodes.length && mergeNodes.length ? `All ${mergeNodes.length} merges done: everything is one cluster` : `${state.merges} of ${mergeNodes.length} merges done`
        : 'No points yet',
      note: last !== null
        ? `The last merge joined two groups ${last.toFixed(1)} px apart, under ${state.link} linkage. Every merge takes the two closest groups left.`
        : 'Step joins the two nearest groups; the height of each bar in the dendrogram is how far apart they were.',
    });
    setRows({ 'r-merges': String(state.merges), 'r-clusters': String(nClusters), 'r-last': last !== null ? last.toFixed(1) : '—' });
  }

  function loop() {
    if (state.running) {
      if (state.merges < mergeNodes.length) state.merges++;
      else { state.running = false; controls.setRunning(false); }
    }
    draw();
    if (state.running) setTimeout(() => requestAnimationFrame(loop), 260);
    else requestAnimationFrame(loop);
  }

  canvas.addEventListener('pointerdown', (e) => {
    const rect = canvas.getBoundingClientRect();
    const x = ((e.clientX - rect.left) / rect.width) * W;
    const y = ((e.clientY - rect.top) / rect.height) * H;
    if (x > LEFT.x1 + 20) return;
    pts.push({ x: Math.max(LEFT.x0, Math.min(LEFT.x1, x)), y: Math.max(LEFT.y0, Math.min(LEFT.y1, y)) });
    build();
  });

  segmented('link', (l) => { state.link = l; build(); });
  const controls = transport({
    onRun: (running) => {
      if (running && state.merges >= mergeNodes.length) state.merges = 0;
      state.running = running;
    },
    onStep: () => { if (state.merges < mergeNodes.length) state.merges++; },
    onReset: () => { state.merges = 0; state.running = false; controls.setRunning(false); },
  });
  el('regen').addEventListener('click', () => { gen(); build(); });
  el('clear').addEventListener('click', () => {
    pts = []; mergeNodes = []; leafNodes = []; root = null;
    state.merges = 0;
    state.running = false;
    controls.setRunning(false);
  });

  gen();
  build();
  requestAnimationFrame(loop);
</script>

<style>
  #hc {
    cursor: crosshair;
  }
</style>
