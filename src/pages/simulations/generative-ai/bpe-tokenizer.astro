---
import SimLayout from '../../../layouts/SimLayout.astro';
import Slider from '../../../components/sim/Slider.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="generative-ai"
  title="Byte Pair Encoding"
  description="A tokenizer is built by counting: glue the commonest pair of neighbouring symbols into one, and repeat. Then watch a new sentence get cut up."
>
  <div class="sim" id="wrap">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="bpe"
          width="1000"
          height="680"
          role="img"
          aria-label="The training words as chips of symbols that keep merging, the pair counts that decide the next merge, the vocabulary so far, and a new sentence tokenized with it."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'the pair about to merge', color: '#fbbf24' },
          { label: 'the symbol a merge just made', color: '#34d399' },
          { label: 'a learned token', color: '#7c8cff' },
          { label: 'not in the vocabulary', color: '#f9736a' },
        ]}
        hint="▁ marks the start of a word · drag Merges applied to scrub"
      />
      <Result label="Vocabulary size |V|" />
    </div>

    <div class="sim-panel">
      <Transport step />
      <Slider id="m" label="Merges applied" min={0} max={1} value={0} />
      <Slider id="sp" label="Speed" min={1} max={12} value={3} />

      <div class="control">
        <label for="train">Training text</label>
        <textarea id="train" rows="6" spellcheck="false"></textarea>
      </div>

      <div class="control">
        <label for="test">Tokenize this sentence</label>
        <input type="text" id="test" spellcheck="false" />
      </div>

      <Readout
        title="Values"
        rows={[
          { id: 'rwords', label: 'distinct words' },
          { id: 'rbase', label: 'starting alphabet' },
          { id: 'rmerges', label: 'merges learned' },
          { id: 'rvocab', label: 'vocabulary size' },
          { id: 'rtok', label: 'sentence tokens' },
          { id: 'rcpt', label: 'characters per token' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      At zero merges the vocabulary is the alphabet and the sentence costs one
      token per character. <Try id="zero" />
    </li>
    <li>
      Each merge glues the <b>commonest pair</b>, counted over the whole text:
      first <b>a + t</b>, then ▁t + h and ▁th + e, so "the" is now one token. <Try id="three" />
    </li>
    <li>
      After every merge the sentence drops from 27 tokens to 11. <b>flat</b> never appears in training, yet it still tokenizes, as ▁f, l, at. <Try id="all" />
    </li>
    <li>
      A letter the training text never had goes red: it is not in the vocabulary.
      That is why real tokenizers start from the 256 <b>bytes</b>. <Try id="unknown" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, textPx, isCompact } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { el, slider, transport, result, readout, tries } from '../../../lib/panel';

  // ---------------------------------------------------------------------------
  // Byte pair encoding, the whole of it: count neighbouring pairs, glue the
  // commonest into one symbol, repeat. Training is computed once up front and
  // snapshotted after every merge, so the slider can scrub through it in either
  // direction and encoding always uses exactly the merges on screen.
  // ---------------------------------------------------------------------------

  const DEFAULT_TRAIN = `the cat sat on the mat. the cats sat on the mats.
the fat cat sat on the fat mat. the fatter cat sat on the fatter mat.
cats and rats sat on mats. the rat ran and the cats ran faster.
the fattest rat ran fastest of all the rats.`;
  const DEFAULT_TEST = 'the fattest cats ran on a flat mat';

  const MARK = '▁'; // start of a word, the way SentencePiece writes it
  const MAX_MERGES = 60;

  /** Words and punctuation, in order, lowercased. */
  const units = (text: string) => text.toLowerCase().match(/[a-z]+|[^\sa-z]/g) || [];

  /** A word starts as its letters, with the first one carrying the marker. */
  function initialSyms(unit: string): string[] {
    if (!/^[a-z]+$/.test(unit)) return [unit];
    return [MARK + unit[0], ...unit.slice(1).split('')];
  }

  type Merge = { a: string; b: string; count: number };
  type Word = { w: string; f: number };
  type Trained = {
    words: Word[];
    merges: Merge[];
    /** word symbol lists after m merges: snaps[m][i] */
    snaps: string[][][];
    base: string[];
  };

  function mergeInto(syms: string[], a: string, b: string): string[] {
    const out: string[] = [];
    for (let i = 0; i < syms.length; i++) {
      if (i + 1 < syms.length && syms[i] === a && syms[i + 1] === b) {
        out.push(a + b);
        i++;
      } else out.push(syms[i]);
    }
    return out;
  }

  /** Pair counts over the current state, weighted by word frequency. */
  function pairCounts(words: Word[], syms: string[][]) {
    const counts = new Map<string, number>();
    const order: string[] = [];
    syms.forEach((s, i) => {
      for (let j = 0; j + 1 < s.length; j++) {
        const k = s[j] + '\u0000' + s[j + 1];
        if (!counts.has(k)) order.push(k);
        counts.set(k, (counts.get(k) || 0) + words[i].f);
      }
    });
    // ties go to whichever pair was met first, so training is reproducible
    return order
      .map((k) => {
        const [a, b] = k.split('\u0000');
        return { a, b, count: counts.get(k)! };
      })
      .sort((x, y) => y.count - x.count);
  }

  function train(text: string): Trained {
    const freq = new Map<string, number>();
    for (const u of units(text)) freq.set(u, (freq.get(u) || 0) + 1);
    const words: Word[] = [...freq]
      .map(([w, f]) => ({ w, f }))
      .sort((a, b) => b.f - a.f || a.w.localeCompare(b.w));

    let cur = words.map((e) => initialSyms(e.w));
    const base = [...new Set(cur.flat())].sort();
    const snaps: string[][][] = [cur];
    const merges: Merge[] = [];

    for (let step = 0; step < MAX_MERGES; step++) {
      const best = pairCounts(words, cur)[0];
      // a pair that happens once buys nothing: it would just rename one word
      if (!best || best.count < 2) break;
      cur = cur.map((s) => mergeInto(s, best.a, best.b));
      merges.push(best);
      snaps.push(cur);
    }
    return { words, merges, snaps, base };
  }

  const state = { m: 0, speed: 3, running: false, test: DEFAULT_TEST };
  let model = train(DEFAULT_TRAIN);
  let flash = 0;

  const vocabAt = (m: number) => [...model.base, ...model.merges.slice(0, m).map((x) => x.a + x.b)];

  type Tok = { t: string; unknown: boolean };
  /** Standard BPE encoding: replay the learned merges, in order, to exhaustion. */
  function encode(text: string, m: number): Tok[] {
    const known = new Set(vocabAt(m));
    const out: Tok[] = [];
    for (const u of units(text)) {
      let syms = initialSyms(u);
      for (let i = 0; i < m; i++) syms = mergeInto(syms, model.merges[i].a, model.merges[i].b);
      for (const s of syms) out.push({ t: s, unknown: !known.has(s) });
    }
    return out;
  }

  // --- canvas -------------------------------------------------------------------

  const canvas = document.getElementById('bpe') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const cssVar = (n: string) => getComputedStyle(canvas).getPropertyValue(n).trim();
  const inkRGB = () => cssVar('--stage-ink') || '232,233,236';
  const inkA = (a: number) => `rgba(${inkRGB()},${a})`;

  const NEXT = '#fbbf24';  // the pair about to be merged
  const NEW = '#34d399';   // a symbol that a merge just created
  const TOKEN = '#7c8cff'; // a learned token
  const BAD = '#f9736a';   // not in the vocabulary at all

  function hexA(hex: string, a: number) {
    const h = hex.replace('#', '');
    const s = h.length === 3 ? h.split('').map((c) => c + c).join('') : h;
    const n = parseInt(s, 16);
    return `rgba(${(n >> 16) & 255},${(n >> 8) & 255},${n & 255},${a})`;
  }
  const UI = (size: number, weight = 400) =>
    `${weight} ${size}px 'Inter', system-ui, sans-serif`;
  const MONO = (size: number, weight = 400) =>
    `${weight} ${size}px 'JetBrains Mono', ui-monospace, monospace`;

  /** Phone-sized canvas: fewer sections, bigger chips. Set each draw. */
  let compact = false;
  /** A logical font size that stays readable on screen (≥ 11px, ≥ 9.5px on a phone). */
  const fs = (size: number) => textPx(canvas, size, compact ? 9.5 : 11.5, 3);

  function text(
    s: string,
    x: number,
    y: number,
    size: number,
    col: string,
    align: CanvasTextAlign = 'left',
    mono = false,
    weight = 400
  ) {
    const px = fs(size);
    ctx.font = mono ? MONO(px, weight) : UI(px, weight);
    ctx.fillStyle = col;
    ctx.textAlign = align;
    ctx.fillText(s, x, y);
    ctx.textAlign = 'left';
  }
  const measure = (s: string, size: number, mono = true) => {
    const px = fs(size);
    ctx.font = mono ? MONO(px) : UI(px);
    return ctx.measureText(s).width;
  };

  function rr(x: number, y: number, w: number, h: number, r: number) {
    const rad = Math.min(r, Math.abs(w) / 2, Math.abs(h) / 2);
    ctx.beginPath();
    ctx.moveTo(x + rad, y);
    ctx.lineTo(x + w - rad, y);
    ctx.quadraticCurveTo(x + w, y, x + w, y + rad);
    ctx.lineTo(x + w, y + h - rad);
    ctx.quadraticCurveTo(x + w, y + h, x + w - rad, y + h);
    ctx.lineTo(x + rad, y + h);
    ctx.quadraticCurveTo(x, y + h, x, y + h - rad);
    ctx.lineTo(x, y + rad);
    ctx.quadraticCurveTo(x, y, x + rad, y);
    ctx.closePath();
  }
  /** A section title, with an optional note on the right edge `xr`. */
  function title(x: number, y: number, left: string, xr = 0, right = '') {
    text(left, x, y, 15, inkA(0.55), 'left', true);
    if (right) text(right, xr, y, 15, inkA(0.45), 'right', true);
  }

  /** Chip text size, and the chip height and row step that go with it. */
  const chipH = (size: number) => fs(size) + 12;
  /** One symbol, drawn as a chip. Returns the width it took. */
  function chip(s: string, x: number, y: number, size: number, fill: string, stroke: string, col: string) {
    const w = measure(s, size) + (compact ? 12 : 14);
    const h = chipH(size);
    ctx.fillStyle = fill;
    rr(x, y, w, h, 5);
    ctx.fill();
    if (stroke) {
      ctx.strokeStyle = stroke;
      ctx.lineWidth = 1;
      rr(x, y, w, h, 5);
      ctx.stroke();
    }
    text(s, x + w / 2, y + h / 2 + fs(size) * 0.36, size, col, 'center', true);
    return w;
  }

  const X0 = 24, X1 = W - 24;
  /**
   * Where each section sits. A phone drops the pair counts and the list of
   * merges (the pair about to merge is still boxed in the words) so the rest
   * can be big enough to read.
   */
  function layout() {
    return compact
      ? { words: { x: X0, y: 34, w: X1 - X0, rows: 5, cols: 1 }, side: null, vocab: { y: 322, rows: 3 }, enc: { y: 516, rows: 3 } }
      : { words: { x: X0, y: 26, w: 600, rows: 10, cols: 2 }, side: { x: 664, y: 26 }, vocab: { y: 392, rows: 3 }, enc: { y: 540, rows: 3 } };
  }
  type Layout = ReturnType<typeof layout>;

  // --- the words being trained on -------------------------------------------------

  function drawWords(syms: string[][], next: Merge | null, L: Layout) {
    const B = L.words, size = 14, h = chipH(size), rowH = h + (compact ? 5 : 6);
    const n = Math.min(B.rows * B.cols, model.words.length);
    const hidden = model.words.length - n;
    title(B.x, B.y, 'the training words, as symbols', B.x + B.w, hidden ? `+ ${hidden} more` : '');
    const y0 = B.y + 14;
    // one column while the words fit, two when they do not
    const perCol = n <= B.rows ? n : Math.ceil(n / B.cols);
    const colW = B.w / B.cols;
    const countW = measure('12×', 13) + 10;
    for (let i = 0; i < n; i++) {
      const cx = B.x + Math.floor(i / perCol) * colW;
      const y = y0 + (i % perCol) * rowH;
      const clipX = cx + colW - 16;
      text(`${model.words[i].f}×`, cx + countW - 10, y + h / 2 + fs(13) * 0.36, 13, inkA(0.45), 'right', true);
      let x = cx + countW;
      const s = syms[i];
      for (let j = 0; j < s.length; j++) {
        const pad = compact ? 12 : 14;
        if (x + measure(s[j], size) + pad > clipX) {
          text('…', x + 2, y + h / 2 + fs(size) * 0.36, size, inkA(0.4), 'left', true);
          break;
        }
        const pairHere = !!next && s[j] === next.a && j + 1 < s.length && s[j + 1] === next.b;
        // the pair that is about to be merged is boxed wherever it occurs
        const wA = measure(s[j], size) + pad, wB = pairHere ? measure(s[j + 1], size) + pad : 0;
        if (pairHere && x + wA + wB + 10 <= clipX + 4) {
          ctx.fillStyle = hexA(NEXT, 0.16);
          rr(x - 3, y - 3, wA + wB + 10, h + 6, 6);
          ctx.fill();
          ctx.strokeStyle = hexA(NEXT, 0.75);
          ctx.lineWidth = 1;
          rr(x - 3, y - 3, wA + wB + 10, h + 6, 6);
          ctx.stroke();
        }
        const isNew = flash > 0 && state.m > 0 && s[j] === model.merges[state.m - 1].a + model.merges[state.m - 1].b;
        x +=
          chip(
            s[j],
            x,
            y,
            size,
            isNew ? hexA(NEW, 0.25 * flash + 0.1) : inkA(0.07),
            isNew ? hexA(NEW, 0.7) : inkA(0.12),
            s[j].length > 1 ? inkA(0.95) : inkA(0.7)
          ) + 4;
      }
    }
  }

  // --- which pair wins ---------------------------------------------------------------

  function drawPairs(pairs: { a: string; b: string; count: number }[], next: Merge | null, at: { x: number; y: number }) {
    title(at.x, at.y, 'commonest pairs');
    if (!pairs.length) {
      text('nothing left to merge', (at.x + X1) / 2, at.y + 70, 14, inkA(0.4), 'center');
      return;
    }
    const top = pairs.slice(0, 5);
    const maxC = top[0].count;
    const labelW = 120, numW = 34, bx = at.x + labelW + 10, barMax = X1 - bx - numW - 8;
    top.forEach((p, i) => {
      const mid = at.y + 30 + i * 28;
      const win = i === 0 && !!next;
      text(`${p.a} + ${p.b}`, at.x + labelW, mid + 5, 14, win ? NEXT : inkA(0.6), 'right', true);
      ctx.fillStyle = win ? hexA(NEXT, 0.8) : inkA(0.18);
      ctx.fillRect(bx, mid - 7, Math.max(2, (p.count / maxC) * barMax), 14);
      text(String(p.count), X1, mid + 5, 13, inkA(0.6), 'right', true);
    });
  }

  // --- the rules learned so far --------------------------------------------------------

  function drawRules(at: { x: number; y: number }) {
    const y = at.y + 190;
    title(at.x, y, 'merges learned', X1, state.m ? String(state.m) : '');
    if (!state.m) {
      text('none yet', at.x, y + 32, 14, inkA(0.4), 'left', true);
      return;
    }
    const rowH = 26, rows = 5;
    const from = Math.max(0, state.m - rows);
    for (let i = from; i < state.m; i++) {
      const r = model.merges[i];
      const ry = y + 32 + (i - from) * rowH;
      const latest = i === state.m - 1;
      text(String(i + 1), at.x + 26, ry, 13, inkA(0.35), 'right', true);
      text(`${r.a} + ${r.b} → ${r.a + r.b}`, at.x + 40, ry, 14, latest ? NEW : inkA(0.8), 'left', true);
      text(String(r.count), X1, ry, 13, inkA(0.4), 'right', true);
    }
  }

  // --- the vocabulary ---------------------------------------------------------------------

  function drawVocab(L: Layout) {
    const vocab = vocabAt(state.m);
    const size = 14, h = chipH(size), rowH = h + 6;
    title(X0, L.vocab.y, `the vocabulary: ${model.base.length} + ${state.m} learned`);
    let x = X0, y = L.vocab.y + 14, row = 0;
    const plusW = measure('+ 99', 13, true) + 8;
    let hidden = 0;
    for (let i = 0; i < vocab.length; i++) {
      const s = vocab[i];
      const learned = i >= model.base.length;
      const w = measure(s, size) + (compact ? 12 : 14);
      // the last row keeps room for a "+ n" count of what does not fit
      const room = row === L.vocab.rows - 1 ? X1 - plusW : X1;
      if (x + w > room) {
        if (row === L.vocab.rows - 1) { hidden = vocab.length - i; break; }
        x = X0;
        y += rowH;
        row++;
      }
      const isNew = flash > 0 && i === model.base.length + state.m - 1;
      chip(
        s,
        x,
        y,
        size,
        isNew ? hexA(NEW, 0.3 * flash + 0.12) : learned ? hexA(TOKEN, 0.16) : inkA(0.06),
        isNew ? hexA(NEW, 0.8) : learned ? hexA(TOKEN, 0.5) : inkA(0.12),
        learned ? inkA(0.95) : inkA(0.55)
      );
      x += w + 5;
    }
    if (hidden) text(`+ ${hidden}`, x + 4, y + h / 2 + fs(13) * 0.36, 13, inkA(0.5), 'left', true);
  }

  // --- tokenizing a new sentence -------------------------------------------------------

  function drawEncode(toks: Tok[], L: Layout) {
    const size = compact ? 14 : 16, h = chipH(size), rowH = h + 6;
    title(X0, L.enc.y, 'a sentence it never saw', X1, `${toks.length} tokens`);
    let x = X0, y = L.enc.y + 14, row = 0;
    if (!toks.length) text('(type a sentence in the panel)', X0, y + 24, 15, inkA(0.45));
    for (const t of toks) {
      const w = measure(t.t, size) + (compact ? 12 : 14);
      if (x + w > X1) {
        if (++row >= L.enc.rows) break;
        x = X0;
        y += rowH;
      }
      chip(
        t.t,
        x,
        y,
        size,
        t.unknown ? hexA(BAD, 0.2) : hexA(TOKEN, 0.18),
        t.unknown ? hexA(BAD, 0.8) : hexA(TOKEN, 0.55),
        t.unknown ? BAD : inkA(0.98)
      );
      x += w + 5;
    }
  }

  // --- readouts -----------------------------------------------------------------------------

  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  function draw() {
    ctx.clearRect(0, 0, W, H);
    ctx.textBaseline = 'alphabetic';
    const syms = model.snaps[Math.min(state.m, model.snaps.length - 1)];
    const pairs = pairCounts(model.words, syms);
    const next = state.m < model.merges.length ? model.merges[state.m] : null;
    const toks = encode(state.test, state.m);

    compact = isCompact(canvas);
    const L = layout();
    drawWords(syms, next, L);
    if (L.side) {
      drawPairs(pairs, next, L.side);
      drawRules(L.side);
    }
    drawVocab(L);
    drawEncode(toks, L);

    const vocab = model.base.length + state.m;
    const chars = (state.test.match(/\S/g) || []).length;
    const cpt = toks.length ? (chars / toks.length).toFixed(2) : '—';
    setRows({
      rwords: String(model.words.length),
      rbase: String(model.base.length),
      rmerges: `${state.m} of ${model.merges.length}`,
      rvocab: String(vocab),
      rtok: String(toks.length),
      rcpt: cpt,
    });
    setEq({
      rule: [['(a,b)^{*}=\\arg\\max_{(a,b)}\\;\\text{count}(ab)', NEXT], '\\qquad', ['V \\leftarrow V \\cup \\{ab\\}', TOKEN]],
      live: [[`|V| = ${model.base.length} + ${state.m} = ${vocab}`, TOKEN], [`\\quad \\text{tokens} = ${toks.length}`, NEW], `\\quad \\text{chars/token} = ${toks.length ? (chars / toks.length).toFixed(2) : '0'}`],
    });
    setResult({
      value: String(vocab),
      colour: TOKEN,
      status: `${state.m} of ${model.merges.length} merges · the sentence costs ${toks.length} tokens`,
      note: next
        ? `Next merge: ${next.a} + ${next.b} → ${next.a + next.b}, the commonest pair (${next.count} times). Only counting, nothing linguistic.`
        : 'No pair occurs twice any more, so training stops. Frequent words are single tokens; rare ones stay in pieces.',
    });
  }

  // --- loop ---------------------------------------------------------------------------------

  let acc = 0, last = 0;
  function loop(ts: number) {
    if (!last) last = ts;
    const dt = Math.min(0.05, (ts - last) / 1000);
    last = ts;
    if (state.running) {
      acc += dt * state.speed;
      while (acc >= 1) {
        acc -= 1;
        if (state.m < model.merges.length) setM(state.m + 1);
        else stopRun();
      }
    }
    if (flash > 0) flash = Math.max(0, flash - dt * 2);
    draw();
    requestAnimationFrame(loop);
  }

  // --- controls -------------------------------------------------------------------------------

  const mEl = el('m') as HTMLInputElement;
  const setMSlider = slider('m', (v) => { stopRun(); setM(v, true); });
  slider('sp', (v) => (state.speed = v));

  function stopRun() {
    state.running = false;
    controls.setRunning(false);
  }
  function setM(m: number, fromSlider = false) {
    const clamped = Math.max(0, Math.min(model.merges.length, m));
    if (clamped > state.m) flash = 1;
    state.m = clamped;
    if (!fromSlider) setMSlider(clamped);
  }
  function retrain(text: string) {
    model = train(text);
    mEl.max = String(Math.max(1, model.merges.length));
    setM(Math.min(state.m, model.merges.length));
  }
  const controls = transport({
    onRun: (running) => {
      if (!running) return stopRun();
      if (state.m >= model.merges.length) setM(0);
      state.running = true;
    },
    onStep: () => { stopRun(); setM(state.m + 1); },
    onReset: () => { stopRun(); setM(0); },
  });

  const trainEl = el('train') as HTMLTextAreaElement;
  const testEl = el('test') as HTMLInputElement;
  trainEl.value = DEFAULT_TRAIN;
  testEl.value = DEFAULT_TEST;

  let debounce = 0;
  trainEl.addEventListener('input', () => {
    stopRun();
    clearTimeout(debounce);
    // retraining on every keystroke would fight with typing
    debounce = window.setTimeout(() => retrain(trainEl.value), 350);
  });
  testEl.addEventListener('input', () => (state.test = testEl.value));

  /** Back to the default texts, at a given number of merges. */
  function show(m: number, test = DEFAULT_TEST) {
    stopRun();
    if (trainEl.value !== DEFAULT_TRAIN) {
      trainEl.value = DEFAULT_TRAIN;
      retrain(DEFAULT_TRAIN);
    }
    testEl.value = test;
    state.test = test;
    setM(m);
  }
  tries({
    zero: () => show(0),
    three: () => show(3),
    all: () => show(model.merges.length),
    unknown: () => show(model.merges.length, 'the zebra sat'),
  });

  retrain(DEFAULT_TRAIN);
  requestAnimationFrame(loop);
</script>

