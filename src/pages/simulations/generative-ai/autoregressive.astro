---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="generative-ai"
  title="Autoregressive Models"
  description="Give every word a probability, cut the unlikely tail, pick one, append it, repeat. A 40-word vocabulary, so you can watch temperature, top-k and top-p act on all of it."
>
  <div class="sim" id="wrap">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="ar"
          width="1000"
          height="780"
          role="img"
          aria-label="The text generated so far, the probability of every word for the next position with the cut-off drawn in, the strip the random number lands on, and the whole vocabulary as bars."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'kept by the cut, sampled from', color: '#7c8cff' },
          { label: 'the word that was written', color: '#34d399' },
          { label: 'the random number', color: '#fbbf24' },
          { label: 'the tail that was cut', color: '#f9736a' },
        ]}
        hint="Highlighted words are the context · pale bars: the model's own probability, solid: after temperature and the cut"
      />
      <Result label="Kept by the cut" />
    </div>

    <div class="sim-panel">
      <Transport step />
      <Seg id="mode" label="Decoding" attr="m" options={[{ value: 'sample', label: 'Sampling' }, { value: 'greedy', label: 'Greedy' }]} />
      <div class="tunes">
        <Slider id="t" label="Temperature" min={5} max={200} value={80} display="0.80" />
      </div>
      <div class="tunes">
        <Slider id="k" label="Top-k" min={1} max={40} value={40} display="off" />
      </div>
      <div class="tunes">
        <Slider id="p" label="Top-p" min={5} max={100} value={100} display="off" />
      </div>
      <Slider id="n" label="Context length, words" min={1} max={3} value={2} />
      <Slider id="sp" label="Speed" min={1} max={16} value={3} />
      <Readout
        title="Values"
        rows={[
          { id: 'vocab', label: 'vocabulary' },
          { id: 'seen', label: 'seen after this context' },
          { id: 'kept', label: 'kept by the cut' },
          { id: 'mass', label: 'mass kept' },
          { id: 'pick', label: 'last pick' },
          { id: 'bits', label: 'surprise of that pick' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Every one of the 40 words has a bar at every step, never zero. Leave both
      cuts off and run: sooner or later a <b>tail</b> word wins and the sentence
      derails. <Try id="tail" label="Run" />
    </li>
    <li>
      Set <b>top-k</b> to 1. The tallest bar always wins, nothing is random, and
      the text falls into a <b>loop</b>. <Try id="greedy" label="Run" />
    </li>
    <li>
      <b>Top-p</b> keeps the fewest words that add up to p, so "kept by the cut"
      shrinks where the model is sure and grows where it hesitates. <Try id="topp" label="Run" />
    </li>
    <li>
      Drag <b>temperature</b>: the pale bars (the model's own probabilities)
      stay put while the solid ones flatten as T rises. <Try id="hot" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, textPx, isCompact } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { el, segmented, slider, transport, result, readout, tries } from '../../../lib/panel';

  // ---------------------------------------------------------------------------
  // The next-token loop, one panel per stage: the text so far, a probability for
  // every word in the vocabulary, the cut that throws the tail away, the dart
  // that picks one. Counts stand in for a neural network, and a small smoothing
  // term stands in for the softmax: no word is ever exactly impossible.
  // ---------------------------------------------------------------------------

  const CORPUS = `the cat sleeps in the sun . the dog runs in the rain . the cat
    runs to the door . the dog sleeps by the fire . the girl opens the door and
    the cat runs out . the boy feeds the dog by the fire . the rain falls on the
    roof . the sun warms the roof . the cat watches the rain from the window .
    the dog watches the door . the girl calls the dog and the dog runs to the
    girl . the boy calls the cat and the cat sleeps . the night falls and the
    house grows quiet . the cat sleeps by the fire and the dog sleeps by the
    door . in the morning the sun returns and the girl opens the window . the
    boy runs out to the garden . the dog follows the boy . the cat watches from
    the roof . the rain returns in the evening . the house grows warm and the
    fire burns . the girl reads by the window . the boy sleeps . the cat and the
    dog sleep by the fire .`;

  const TOKENS = (CORPUS.toLowerCase().match(/[a-z]+|\./g) || []);
  const VOCAB = [...new Set(TOKENS)].sort((a, b) => {
    const pa = a === '.' ? 1 : 0, pb = b === '.' ? 1 : 0;
    return pa - pb || a.localeCompare(b);
  });
  const V = VOCAB.length;

  /**
   * Every word gets `ALPHA` of a count for free, so the distribution covers the
   * whole vocabulary. Without it an n-gram says "impossible" to most words,
   * which a real model never does, and there would be no tail for top-k and
   * top-p to cut.
   */
  const ALPHA = 0.02;

  const state = {
    greedy: false,
    n: 2,
    temp: 0.8,
    k: V,
    p: 1,
    speed: 3,
    running: false,
  };

  // --- the model --------------------------------------------------------------

  let models: Map<string, Map<string, number>>[] = [];
  let tokens: string[] = [];

  function buildModels() {
    models = [];
    for (let order = 1; order <= 3; order++) {
      const m = new Map<string, Map<string, number>>();
      for (let i = order; i < TOKENS.length; i++) {
        const k = TOKENS.slice(i - order, i).join(' ');
        if (!m.has(k)) m.set(k, new Map());
        const inner = m.get(k)!;
        inner.set(TOKENS[i], (inner.get(TOKENS[i]) || 0) + 1);
      }
      models[order] = m;
    }
  }

  /** The longest slice of recent words the corpus has actually seen. */
  function usedContext(): string[] {
    for (let order = Math.min(state.n, tokens.length); order >= 1; order--) {
      const ctxTok = tokens.slice(-order);
      const m = models[order].get(ctxTok.join(' '));
      if (m && m.size) return ctxTok;
    }
    return [];
  }

  function counts(): Map<string, number> {
    const c = usedContext();
    if (c.length) return models[c.length].get(c.join(' '))!;
    const uni = new Map<string, number>();
    for (const t of TOKENS) uni.set(t, (uni.get(t) || 0) + 1);
    return uni;
  }

  type Cand = {
    w: string;
    /** how often it followed this context in the text */
    n: number;
    /** the model's own probability, smoothing included */
    base: number;
    /** after temperature, before anything is cut */
    q: number;
    /** what the dart actually sees: 0 for a word that was cut */
    final: number;
    kept: boolean;
    cum: number;
  };

  function candidates(): Cand[] {
    const c = counts();
    let N = 0;
    c.forEach((v) => (N += v));
    const denom = N + ALPHA * V;
    const inv = 1 / Math.max(0.05, state.temp);

    const arr: Cand[] = [];
    let z = 0;
    for (const w of VOCAB) {
      const n = c.get(w) || 0;
      const base = (n + ALPHA) / denom;
      const q = Math.pow(base, inv);
      z += q;
      arr.push({ w, n, base, q, final: 0, kept: false, cum: 0 });
    }
    for (const a of arr) a.q /= z || 1;
    arr.sort((a, b) => b.q - a.q || a.w.localeCompare(b.w));

    // top-k first, then top-p inside what survives, the order real samplers use
    let keep = Math.min(arr.length, state.k);
    if (state.p < 1) {
      let acc = 0;
      for (let i = 0; i < keep; i++) {
        acc += arr[i].q;
        if (acc >= state.p - 1e-12) { keep = i + 1; break; }
      }
    }
    if (state.greedy) keep = 1;

    let kz = 0;
    for (let i = 0; i < arr.length; i++) {
      arr[i].kept = i < keep;
      if (arr[i].kept) kz += arr[i].q;
    }
    let cum = 0;
    for (const a of arr) {
      a.final = a.kept ? a.q / (kz || 1) : 0;
      cum += a.final;
      a.cum = cum;
    }
    return arr;
  }

  /** The last dart, kept on screen so the pick can be looked at afterwards. */
  type Shot = {
    ctxStr: string;
    kept: { w: string; p: number }[];
    r: number;
    word: string;
    prob: number;
    base: number;
    cutCount: number;
  };
  let shot: Shot | null = null;
  let flash = 0;

  function contextString() {
    const used = usedContext();
    return (used.length ? used : tokens.slice(-state.n)).join(' ') || '(start)';
  }

  function seed() {
    tokens = ['the'];
    shot = null;
    flash = 0;
  }

  function stepOnce() {
    const cands = candidates();
    const kept = cands.filter((c) => c.kept);
    if (!kept.length) return;
    const r = Math.random();
    let chosen = kept[0];
    if (!state.greedy) {
      let acc = 0;
      chosen = kept[kept.length - 1];
      for (const c of kept) {
        acc += c.final;
        if (r <= acc) { chosen = c; break; }
      }
    }
    shot = {
      ctxStr: contextString(),
      kept: kept.map((c) => ({ w: c.w, p: c.final })),
      r: state.greedy ? -1 : r,
      word: chosen.w,
      prob: chosen.final,
      base: chosen.base,
      cutCount: cands.length - kept.length,
    };
    flash = 1;
    tokens.push(chosen.w);
    if (tokens.length > 150) tokens = tokens.slice(-130);
  }

  // --- canvas -----------------------------------------------------------------

  const canvas = document.getElementById('ar') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const cssVar = (n: string) => getComputedStyle(canvas).getPropertyValue(n).trim();
  const inkRGB = () => cssVar('--stage-ink') || '232,233,236';
  const inkA = (a: number) => `rgba(${inkRGB()},${a})`;

  const KEEP = '#7c8cff';   // survives the cut, and is sampled from
  const CHOSEN = '#34d399'; // the word that was actually written
  const DART = '#fbbf24';   // the random number
  const CUTC = '#f9736a';   // where the tail gets chopped off

  function hexA(hex: string, a: number) {
    const h = hex.replace('#', '');
    const s = h.length === 3 ? h.split('').map((c) => c + c).join('') : h;
    const n = parseInt(s, 16);
    return `rgba(${(n >> 16) & 255},${(n >> 8) & 255},${n & 255},${a})`;
  }

  const UI = (size: number, weight = 400) =>
    `${weight} ${size}px 'Inter', system-ui, sans-serif`;
  const MONO = (size: number) => `${size}px 'JetBrains Mono', ui-monospace, monospace`;

  /** Phone-sized canvas: fewer rows, fewer labels, bigger text. Set each draw. */
  let compact = false;
  /** A logical font size that stays readable on screen (≥ 11px, ≥ 9.5px on a phone). */
  const fs = (size: number) => textPx(canvas, size, compact ? 9.5 : 11.5, 3);

  function text(
    s: string,
    x: number,
    y: number,
    size: number,
    col: string,
    align: CanvasTextAlign = 'left',
    mono = false,
    weight = 400
  ) {
    const px = fs(size);
    ctx.font = mono ? MONO(px) : UI(px, weight);
    ctx.fillStyle = col;
    ctx.textAlign = align;
    ctx.fillText(s, x, y);
    ctx.textAlign = 'left';
  }
  function measure(s: string, size: number, mono = false) {
    const px = fs(size);
    ctx.font = mono ? MONO(px) : UI(px);
    return ctx.measureText(s).width;
  }

  function rr(x: number, y: number, w: number, h: number, r: number) {
    const rad = Math.min(r, Math.abs(w) / 2, Math.abs(h) / 2);
    ctx.beginPath();
    ctx.moveTo(x + rad, y);
    ctx.lineTo(x + w - rad, y);
    ctx.quadraticCurveTo(x + w, y, x + w, y + rad);
    ctx.lineTo(x + w, y + h - rad);
    ctx.quadraticCurveTo(x + w, y + h, x + w - rad, y + h);
    ctx.lineTo(x + rad, y + h);
    ctx.quadraticCurveTo(x, y + h, x, y + h - rad);
    ctx.lineTo(x, y + rad);
    ctx.quadraticCurveTo(x, y, x + rad, y);
    ctx.closePath();
  }
  /** A section title, with an optional note on the right. */
  function title(y: number, left: string, right = '', rightCol = inkA(0.45)) {
    text(left, X0, y, 15, inkA(0.55), 'left', true);
    if (right && !compact) text(right, X1, y, 15, rightCol, 'right', true);
  }

  const X0 = 24, X1 = W - 24;
  /**
   * Where each section sits. A phone gets fewer rows of bigger text, so the
   * same four sections still fit the same canvas.
   */
  function layout() {
    return compact
      ? { text: 34, textRow: 42, textRows: 2, dist: 188, distRow: 40, rows: 6, dart: 538, voc: 676, vocCols: 10, vocGap: 3 }
      : { text: 26, textRow: 30, textRows: 3, dist: 180, distRow: 26, rows: 9, dart: 494, voc: 604, vocCols: 7, vocGap: 4 };
  }

  // --- 1. the text so far ------------------------------------------------------

  /** Sentence case, purely so the toy text reads like text. */
  function shown(i: number) {
    const t = tokens[i];
    return i === 0 || tokens[i - 1] === '.' ? t[0].toUpperCase() + t.slice(1) : t;
  }

  function layoutText(from: number, x0: number, maxW: number) {
    ctx.font = UI(fs(17));
    const spaceW = ctx.measureText(' ').width;
    const out: { s: string; i: number; x: number; row: number; w: number }[] = [];
    let x = x0, row = 0;
    for (let i = from; i < tokens.length; i++) {
      const s = shown(i);
      const w = ctx.measureText(s).width;
      let sep = i > from && s !== '.' ? spaceW : 0;
      if (x + sep + w > x0 + maxW) { x = x0; row++; sep = 0; }
      out.push({ s, i, x: x + sep, row, w });
      x += sep + w;
    }
    return { out, rows: row + 1, endX: x, spaceW };
  }

  function drawText(L: ReturnType<typeof layout>) {
    title(L.text, 'the text so far');
    const x0 = X0 + 4, rowH = L.textRow, maxW = X1 - X0 - 40;
    let from = 0;
    let lay = layoutText(from, x0, maxW);
    while (lay.rows > L.textRows && from < tokens.length - 1) {
      from += compact ? 2 : 4;
      lay = layoutText(from, x0, maxW);
    }
    const y0 = L.text + 14;
    const ctxLen = Math.max(1, usedContext().length || state.n);
    const ctxStart = Math.max(0, tokens.length - ctxLen);
    const px = fs(17);

    for (const t of lay.out) {
      const y = y0 + t.row * rowH;
      const inCtx = t.i >= ctxStart;
      if (inCtx) {
        ctx.fillStyle = hexA(KEEP, 0.18);
        rr(t.x - 4, y, t.w + 8, rowH - 4, 5);
        ctx.fill();
      }
      if (t.i === tokens.length - 1 && flash > 0) {
        ctx.fillStyle = hexA(CHOSEN, 0.3 * flash);
        rr(t.x - 4, y, t.w + 8, rowH - 4, 5);
        ctx.fill();
      }
      text(t.s, t.x, y + (rowH - 4) / 2 + px * 0.36, 17, inCtx ? inkA(1) : inkA(0.62));
    }
    const lastRow = lay.out.length ? lay.out[lay.out.length - 1].row : 0;
    ctx.fillStyle = CHOSEN;
    ctx.fillRect(lay.endX + lay.spaceW, y0 + lastRow * rowH + 4, 2, rowH - 12);
  }

  // --- 2. the distribution ------------------------------------------------------

  function cutReason(keptN: number) {
    if (state.greedy) return 'greedy: only the top word';
    if (state.k <= keptN) return `cut by top-k = ${state.k}`;
    return `cut by top-p = ${state.p.toFixed(2)}`;
  }

  function drawDist(cands: Cand[], L: ReturnType<typeof layout>) {
    const keptN = cands.filter((c) => c.kept).length;
    title(L.dist, `P(next word | "${contextString()}")`, keptN < cands.length ? cutReason(keptN) : '', hexA(CUTC, 0.9));

    const shownRows = cands.slice(0, L.rows);
    const rest = cands.slice(L.rows);

    const labelW = compact ? 130 : 110;
    const lx = X0, bx = lx + labelW + 14;
    const numW = compact ? 120 : 150, cumW = compact ? 0 : 76;
    const barMax = X1 - bx - numW - cumW;
    let maxP = 0.02;
    for (const c of shownRows) maxP = Math.max(maxP, c.base, c.final);

    const rowH = L.distRow, y0 = L.dist + 14, barH = rowH - 8;
    shownRows.forEach((c, i) => {
      const y = y0 + i * rowH;
      const mid = y + rowH / 2;
      text(c.w, lx + labelW, mid + fs(15) * 0.36, 15, c.kept ? inkA(0.95) : inkA(0.38), 'right');
      ctx.fillStyle = inkA(0.14);
      ctx.fillRect(bx, mid - barH / 2, Math.max(1, (c.base / maxP) * barMax), barH);
      if (c.kept) {
        ctx.fillStyle = i === 0 ? KEEP : hexA(KEEP, 0.62);
        ctx.fillRect(bx, mid - barH / 3, Math.max(1, (c.final / maxP) * barMax), (barH * 2) / 3);
      }
      const num = compact
        ? c.kept ? `${(c.final * 100).toFixed(1)}%` : 'cut'
        : `${(c.base * 100).toFixed(1)}% → ${c.kept ? (c.final * 100).toFixed(1) + '%' : 'cut'}`;
      text(num, bx + barMax + numW - 4, mid + fs(14) * 0.36, 14, c.kept ? inkA(0.75) : inkA(0.35), 'right', true);
      if (c.kept && cumW)
        text(`Σ ${(c.cum * 100).toFixed(0)}%`, X1, mid + fs(14) * 0.36, 14, inkA(0.42), 'right', true);
    });

    if (keptN < cands.length && keptN <= shownRows.length) {
      const y = y0 + keptN * rowH;
      ctx.strokeStyle = hexA(CUTC, 0.7);
      ctx.lineWidth = 1.2;
      ctx.setLineDash([5, 4]);
      ctx.beginPath();
      ctx.moveTo(lx, y);
      ctx.lineTo(X1, y);
      ctx.stroke();
      ctx.setLineDash([]);
    }

    if (rest.length) {
      const restKept = rest.filter((c) => c.kept).length;
      const restMass = rest.reduce((s, c) => s + c.final, 0);
      text(
        compact
          ? `+ ${rest.length} more`
          : restKept
            ? `+ ${rest.length} more words, ${restKept} still in play, worth ${(restMass * 100).toFixed(1)}%`
            : `+ ${rest.length} more words, all cut`,
        lx + labelW,
        y0 + shownRows.length * rowH + fs(14) + 6,
        14,
        inkA(0.42),
        compact ? 'right' : 'left',
        true
      );
    }
  }

  // --- 3. the dart ----------------------------------------------------------------

  function drawDart(L: ReturnType<typeof layout>) {
    if (!shot) {
      title(L.dart, 'the dart');
      text(
        compact ? 'press Step' : 'press Step (or the s key) and watch where the dart lands',
        W / 2,
        L.dart + 50,
        15,
        inkA(0.4),
        'center'
      );
      return;
    }
    title(L.dart, `"${shot.ctxStr}"  →  "${shot.word}"`, shot.cutCount ? `${shot.kept.length} on the strip, ${shot.cutCount} cut` : '');

    const sx = X0 + 22, sw = X1 - X0 - 44, sy = L.dart + (compact ? 22 : 20), sh = compact ? 36 : 28;
    let acc = 0;
    shot.kept.forEach((seg, i) => {
      const w = seg.p * sw;
      const win = seg.w === shot!.word;
      ctx.fillStyle = win ? CHOSEN : hexA(KEEP, i % 2 ? 0.4 : 0.62);
      ctx.fillRect(sx + acc, sy, Math.max(0.6, w), sh);
      if (!compact && w > measure(seg.w, 13) + 10)
        text(seg.w, sx + acc + w / 2, sy + sh / 2 + fs(13) * 0.36, 13, win ? '#0d0e12' : inkA(0.95), 'center');
      acc += w;
    });
    ctx.strokeStyle = inkA(0.18);
    ctx.lineWidth = 1;
    ctx.strokeRect(sx, sy, sw, sh);
    if (!compact) {
      text('0', sx - 6, sy + sh / 2 + 5, 13, inkA(0.4), 'right', true);
      text('1', sx + sw + 6, sy + sh / 2 + 5, 13, inkA(0.4), 'left', true);
    }

    const below = sy + sh + fs(14) + 4;
    if (shot.r >= 0) {
      const dx = sx + shot.r * sw;
      ctx.strokeStyle = DART;
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(dx, sy - 6);
      ctx.lineTo(dx, sy + sh + 4);
      ctx.stroke();
      ctx.fillStyle = DART;
      ctx.beginPath();
      ctx.moveTo(dx, sy);
      ctx.lineTo(dx - 5, sy - 9);
      ctx.lineTo(dx + 5, sy - 9);
      ctx.closePath();
      ctx.fill();
      text(
        compact ? `${shot.r.toFixed(3)}` : `random number ${shot.r.toFixed(3)}`,
        dx,
        below,
        14,
        DART,
        dx > sx + sw / 2 ? 'right' : 'left',
        true
      );
    } else {
      text('greedy throws no dart', sx + sw / 2, below, 14, inkA(0.45), 'center', true);
    }
  }

  // --- 4. the whole vocabulary -----------------------------------------------------

  function drawVocab(cands: Cand[], L: ReturnType<typeof layout>) {
    title(L.voc, `all ${V} words`, 'filled part = its probability');
    const byWord = new Map(cands.map((c) => [c.w, c]));
    let maxBase = 0;
    for (const c of cands) maxBase = Math.max(maxBase, c.base);

    const cols = L.vocCols, rows = Math.ceil(V / cols), gap = L.vocGap;
    const y0 = L.voc + 12;
    const areaW = X1 - X0, areaH = H - 6 - y0;
    const cw = areaW / cols;
    const chh = Math.floor((areaH - (rows - 1) * gap) / rows);

    VOCAB.forEach((w, i) => {
      const c = byWord.get(w)!;
      const cx = X0 + (i % cols) * cw;
      const cy = y0 + Math.floor(i / cols) * (chh + gap);
      const cellW = cw - (compact ? 4 : 8);
      const frac = c.base / Math.max(1e-9, maxBase);
      // the cell is the bar: it fills from the left in proportion to the word's
      // own probability, so the whole vocabulary reads as one chart
      const ty = cy + chh / 2 + fs(14) * 0.36;
      ctx.fillStyle = inkA(0.07);
      rr(cx, cy, cellW, chh, 4);
      ctx.fill();
      ctx.fillStyle = hexA(c.kept ? KEEP : CUTC, c.kept ? 0.5 : 0.3);
      rr(cx, cy, Math.max(3, cellW * frac), chh, 4);
      ctx.fill();
      if (c.kept) {
        ctx.strokeStyle = hexA(KEEP, 0.75);
        ctx.lineWidth = 1;
        rr(cx, cy, cellW, chh, 4);
        ctx.stroke();
      }
      if (flash > 0 && shot && shot.word === w) {
        ctx.fillStyle = hexA(CHOSEN, 0.45 * flash);
        rr(cx, cy, cellW, chh, 4);
        ctx.fill();
      }
      if (compact) return;
      text(w, cx + 8, ty, 14, inkA(c.kept ? 0.98 : 0.6));
      text(`${(c.base * 100).toFixed(c.base < 0.01 ? 2 : 0)}%`, cx + cellW - 8, ty, 13, inkA(0.45), 'right', true);
    });
  }

  // --- readouts ---------------------------------------------------------------------

  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  function updateHud(cands: Cand[]) {
    const keptN = cands.filter((c) => c.kept).length;
    const keptMass = cands.reduce((s, c) => s + (c.kept ? c.q : 0), 0);
    const seen = cands.filter((c) => c.n > 0).length;
    const bits = shot ? (-Math.log2(Math.max(1e-9, shot.base))).toFixed(2) : null;
    setRows({
      vocab: String(V),
      seen: String(seen),
      kept: `${keptN} of ${V}`,
      mass: `${(keptMass * 100).toFixed(1)}%`,
      pick: shot ? `${shot.word} (${(shot.prob * 100).toFixed(1)}%)` : '—',
      bits: bits ? `${bits} bits` : '—',
    });
    setEq({
      rule: ['x_{t+1}\\sim P(\\,\\cdot\\mid x_1\\dots x_t)', '\\qquad', [`P_T(w) \\propto P(w)^{1/T}`, DART]],
      live: [[`T = ${state.temp.toFixed(2)}`, DART], [`\\quad k = ${state.greedy ? 1 : state.k}`, KEEP], [`\\quad p = ${state.p.toFixed(2)}`, KEEP]],
    });
    setResult({
      value: `${keptN} of ${V}`,
      colour: state.greedy ? CHOSEN : KEEP,
      status: state.greedy
        ? 'greedy: always the top word'
        : `${(keptMass * 100).toFixed(1)}% of the probability kept · last pick: ${shot ? `${shot.word} (${(shot.prob * 100).toFixed(1)}%)` : 'none yet'}`,
      note: 'The dart only sees what survives the cut, renormalised. With nothing cut, sooner or later a tail word derails the sentence.',
    });
  }

  // --- loop ------------------------------------------------------------------------

  function draw() {
    ctx.clearRect(0, 0, W, H);
    ctx.textBaseline = 'alphabetic';
    compact = isCompact(canvas);
    const cands = candidates();
    const L = layout();
    drawText(L);
    drawDist(cands, L);
    drawDart(L);
    drawVocab(cands, L);
    updateHud(cands);
  }

  let acc = 0, last = 0;
  function loop(ts: number) {
    if (!last) last = ts;
    const dt = Math.min(0.05, (ts - last) / 1000);
    last = ts;
    if (state.running) {
      acc += dt * state.speed;
      while (acc >= 1) { acc -= 1; stepOnce(); }
    }
    if (flash > 0) flash = Math.max(0, flash - dt * 1.6);
    draw();
    requestAnimationFrame(loop);
  }

  // --- controls ----------------------------------------------------------------------

  const wrapEl = el('wrap');
  const setGreedy = (g: boolean) => {
    state.greedy = g;
    wrapEl.classList.toggle('greedy', g);
  };
  const modes = segmented('mode', (m) => setGreedy(m === 'greedy'));

  (el('k') as HTMLInputElement).max = String(V);
  (el('k') as HTMLInputElement).value = String(V);
  slider('n', (v) => (state.n = v));
  const setT = slider('t', (v) => (state.temp = v / 100), (v) => (v / 100).toFixed(2));
  const setK = slider('k', (v) => (state.k = v), (v) => (v >= V ? 'off' : v === 1 ? '1 (greedy)' : String(v)));
  const setP = slider('p', (v) => (state.p = v / 100), (v) => (v >= 100 ? 'off' : (v / 100).toFixed(2)));
  slider('sp', (v) => (state.speed = v));
  const controls = transport({
    onRun: (running) => (state.running = running),
    onStep: () => stepOnce(),
    onReset: () => seed(),
  });

  /** Sampling mode with the given knobs; optionally restart the text and run. */
  function show(o: { temp: number; k: number; p: number; run: boolean }) {
    setGreedy(false);
    modes.select('sample');
    state.temp = o.temp;
    setT(Math.round(o.temp * 100));
    state.k = o.k;
    setK(o.k);
    state.p = o.p;
    setP(Math.round(o.p * 100));
    if (o.run) {
      seed();
      state.running = true;
      controls.setRunning(true);
    }
  }
  tries({
    tail: () => show({ temp: 0.8, k: V, p: 1, run: true }),
    greedy: () => show({ temp: 0.8, k: 1, p: 1, run: true }),
    topp: () => show({ temp: 0.8, k: V, p: 0.9, run: true }),
    hot: () => show({ temp: 1.8, k: V, p: 1, run: false }),
  });

  buildModels();
  setGreedy(false);
  seed();
  requestAnimationFrame(loop);
</script>

<style>
  /* the three knobs only matter when there is a dart to aim */
  .greedy .tunes {
    opacity: 0.4;
    pointer-events: none;
  }
</style>
