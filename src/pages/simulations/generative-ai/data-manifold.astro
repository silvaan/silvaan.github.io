---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Actions from '../../../components/sim/Actions.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
---

<SimLayout
  areaSlug="generative-ai"
  title="The Data Manifold"
  description="An image is one point in a space with a dimension per pixel value. Real images crowd onto a thin sheet inside it; step off the sheet and the picture turns to noise."
  shortcuts={['reset', 'fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="manifold"
          width="1000"
          height="600"
          role="img"
          aria-label="A three-dimensional sketch of pixel space with a thin twisted ribbon for the data manifold and a dot for the current image, with that image previewed beside it."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'the data manifold, high p(x)', color: '#5eead4' },
          { label: 'your current image', color: '#7c8cff' },
          { label: 'a random pixel array', color: '#f59e0b' },
          { label: 'the rest of pixel space', color: 'rgba(160,165,175,0.6)' },
        ]}
        hint="Drag to orbit · scroll to zoom"
      />
      <Result label="Relative density p(x)" />
    </div>

    <div class="sim-panel">
      <Seg
        id="resolution"
        label="Image resolution"
        attr="n"
        active="16"
        options={[{ value: '8', label: '8 × 8' }, { value: '16', label: '16 × 16' }, { value: '32', label: '32 × 32' }]}
      />
      <Slider id="along" label="Move along the manifold" min={0} max={100} value={42} display="42%" />
      <Slider id="distance" label="Step off the manifold" min={-100} max={100} value={0} display="0.00" />
      <Actions>
        <button type="button" class="btn" id="sample-real">Sample p(x)</button>
        <button type="button" class="btn ghost" id="sample-space">Random pixels</button>
        <button type="button" class="btn ghost" id="reset">Reset</button>
      </Actions>
      <Readout rows={[{ id: 'r-dims', label: 'pixel-space dimensions' }, { id: 'r-dist', label: 'distance to the manifold' }]} />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Nudge <b>Step off the manifold</b> just a little. The <b>density collapses</b>
      and the tidy picture crumbles into static: almost every possible array of
      pixel values looks like nothing at all.
    </li>
    <li>
      Move <b>along</b> the ribbon instead. Many pixels change at once, yet the
      image stays coherent. Those correlated changes are exactly why the real-image
      region is <b>low-dimensional</b> compared with the ambient pixel space.
    </li>
    <li>
      Raise the resolution 8 × 8 → 32 × 32. The picture barely changes, but the
      ambient space jumps from <b>192 to 3,072 dimensions</b>. Real photos live in
      millions of dimensions; <b>Random pixels</b> essentially never lands near the
      data by chance, which is precisely why generative models must learn p(x).
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk } from '../../../lib/draw';
  import { el, segmented, slider, result, readout } from '../../../lib/panel';

  const TEAL = '#5eead4', ACCENT = '#7c8cff', AMBER = '#f59e0b';
  const canvas = el('manifold') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink, inv } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  const state = { t: 0.42, d: 0, n: 16, random: false };
  const plot = { x: 30, y: 30, w: 600, h: 540 };
  const PREVIEW = { x: 690, y: 110, size: 270 };
  const camera = { yaw: -0.62, pitch: -0.3, distance: 8.5 };
  let dragging = false;
  let lastPointer = { x: 0, y: 0 };

  type V3 = { x: number; y: number; z: number };
  const curve3 = (t: number): V3 => { const a = (t - 0.5) * Math.PI * 2.25; return { x: (t - 0.5) * 2.5, y: 0.62 * Math.sin(a), z: 0.62 * Math.cos(a) }; };
  const normal3 = (t: number): V3 => { const a = (t - 0.5) * Math.PI * 2.25; return { x: 0, y: Math.cos(a), z: -Math.sin(a) }; };
  function rotate(v: V3): V3 {
    const cy = Math.cos(camera.yaw), sy = Math.sin(camera.yaw), cp = Math.cos(camera.pitch), sp = Math.sin(camera.pitch);
    const x = v.x * cy - v.z * sy, z1 = v.x * sy + v.z * cy;
    return { x, y: v.y * cp - z1 * sp, z: v.y * sp + z1 * cp };
  }
  function project(v: V3) {
    const r = rotate(v);
    const depth = Math.max(0.7, camera.distance + r.z), scale = 430 / depth;
    return { x: plot.x + plot.w / 2 + r.x * scale, y: plot.y + plot.h / 2 - r.y * scale, z: r.z, visible: camera.distance + r.z > 0.5 };
  }
  const density = () => (state.random ? 0 : Math.exp(-10 * state.d * state.d));
  function noise(x: number, y: number, seed = 0) {
    const v = Math.sin(x * 127.1 + y * 311.7 + seed * 74.7) * 43758.5453;
    return v - Math.floor(v);
  }
  function structuredPixel(x: number, y: number, n: number) {
    const u = (x + 0.5) / n, v = (y + 0.5) / n;
    const phase = state.t * Math.PI * 2;
    const horizon = 0.5 + 0.08 * Math.sin(phase);
    const sunX = 0.2 + state.t * 0.62, sunY = 0.22 + 0.05 * Math.cos(phase * 1.4);
    if (Math.hypot(u - sunX, v - sunY) < 0.11) return [255, 202, 92];
    const mountain = horizon - 0.17 * Math.abs(Math.sin(u * 8 + phase)) - 0.05 * Math.sin(u * 19 - phase);
    if (v < mountain) {
      const glow = Math.max(0, 1 - Math.hypot(u - sunX, v - sunY) * 1.5);
      return [58 + 78 * glow, 80 + 72 * glow, 126 + 80 * glow];
    }
    if (v < horizon + 0.13) return [44 + 25 * u, 72 + 20 * u, 91 + 18 * u];
    const water = 0.5 + 0.5 * Math.sin(y * 2.4 + x * 0.8 + phase * 2);
    return [22 + 18 * water, 67 + 35 * water, 83 + 43 * water];
  }
  function pixel(x: number, y: number) {
    if (state.random) return [noise(x, y, 1), noise(x, y, 2), noise(x, y, 3)].map((v) => v * 255);
    const base = structuredPixel(x, y, state.n);
    const mix = Math.min(1, Math.abs(state.d) * 1.25);
    return base.map((v, c) => v * (1 - mix) + noise(x, y, c + Math.round(state.d * 97)) * 255 * mix);
  }

  function drawPreview() {
    const { x: px, y: py, size } = PREVIEW;
    const cell = size / state.n;
    label('x, as the picture it is', px, py - 16, 0.6, 'left', 11);
    ctx.strokeStyle = ink(0.4);
    ctx.lineWidth = 1;
    ctx.strokeRect(px - 6, py - 6, size + 12, size + 12);
    for (let y = 0; y < state.n; y++)
      for (let x = 0; x < state.n; x++) {
        const c = pixel(x, y).map(Math.round);
        ctx.fillStyle = `rgb(${c[0]},${c[1]},${c[2]})`;
        ctx.fillRect(px + x * cell, py + y * cell, Math.ceil(cell), Math.ceil(cell));
      }
    label(`${state.n} × ${state.n} × 3 = ${(state.n * state.n * 3).toLocaleString()} numbers`, px, py + size + 26, 0.45, 'left', 10.5);
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    label('pixel space, three of its thousands of axes', plot.x, plot.y - 12, 0.45, 'left', 10.5);

    for (const size of [2.5, 5, 9]) {
      const corners: V3[] = [];
      for (const x of [-size, size]) for (const y of [-size, size]) for (const z of [-size, size]) corners.push({ x, y, z });
      ctx.strokeStyle = ink(size === 2.5 ? 0.16 : size === 5 ? 0.08 : 0.03);
      ctx.lineWidth = 1;
      for (let i = 0; i < corners.length; i++)
        for (let j = i + 1; j < corners.length; j++) {
          const c0 = corners[i], c1 = corners[j];
          if (+(c0.x !== c1.x) + +(c0.y !== c1.y) + +(c0.z !== c1.z) !== 1) continue;
          const p = project(c0), q = project(c1);
          if (!p.visible || !q.visible) continue;
          ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(q.x, q.y); ctx.stroke();
        }
    }
    const cloud: ReturnType<typeof project>[] = [];
    for (let i = 0; i < 850; i++) {
      const p = project({ x: (noise(i, 2, 4) - 0.5) * 18, y: (noise(i, 3, 5) - 0.5) * 18, z: (noise(i, 7, 6) - 0.5) * 18 });
      if (p.visible && p.x > plot.x && p.x < plot.x + plot.w && p.y > plot.y && p.y < plot.y + plot.h) cloud.push(p);
    }
    cloud.sort((a, b) => b.z - a.z).forEach((p) => {
      ctx.fillStyle = ink(0.08 + (p.z + 1.5) * 0.018);
      ctx.fillRect(p.x, p.y, 1.5, 1.5);
    });

    const strips: { p: ReturnType<typeof project>[]; z: number }[] = [];
    for (let i = 0; i < 72; i++) {
      const t0 = i / 72, t1 = (i + 1) / 72, c0 = curve3(t0), c1 = curve3(t1), n0 = normal3(t0), n1 = normal3(t1), w = 0.105;
      const p = [
        project({ x: c0.x + n0.x * w, y: c0.y + n0.y * w, z: c0.z + n0.z * w }),
        project({ x: c1.x + n1.x * w, y: c1.y + n1.y * w, z: c1.z + n1.z * w }),
        project({ x: c1.x - n1.x * w, y: c1.y - n1.y * w, z: c1.z - n1.z * w }),
        project({ x: c0.x - n0.x * w, y: c0.y - n0.y * w, z: c0.z - n0.z * w }),
      ];
      strips.push({ p, z: p.reduce((s, q) => s + q.z, 0) / 4 });
    }
    strips.sort((a, b) => b.z - a.z).forEach((s) => {
      ctx.beginPath();
      s.p.forEach((p, i) => (i ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y)));
      ctx.closePath();
      ctx.fillStyle = 'rgba(94,234,212,0.34)';
      ctx.fill();
      ctx.strokeStyle = 'rgba(94,234,212,0.65)';
      ctx.stroke();
    });

    const c = curve3(state.t), n = normal3(state.t);
    const base = project(c);
    let q = project({ x: c.x + n.x * state.d * 1.15, y: c.y + n.y * state.d * 1.15, z: c.z + n.z * state.d * 1.15 });
    if (state.random) q = project({ x: 1.18, y: 0.94, z: -0.98 });
    ctx.setLineDash([4, 5]);
    ctx.strokeStyle = ink(0.35);
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(base.x, base.y); ctx.lineTo(q.x, q.y); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = state.random ? AMBER : ACCENT;
    ctx.beginPath(); ctx.arc(q.x, q.y, 8, 0, Math.PI * 2); ctx.fill();
    ctx.strokeStyle = inv(0.75);
    ctx.lineWidth = 2;
    ctx.stroke();
    label('x', q.x + 12, q.y + 4, 1, 'left', 12, state.random ? AMBER : ACCENT);
    drawPreview();

    const den = density();
    const dims = state.n * state.n * 3;
    const region = state.random || den < 0.01 ? 'noise' : den < 0.45 ? 'unlikely' : 'realistic';
    const denText = den < 0.0001 ? '≈ 0%' : `${(den * 100).toFixed(den < 0.1 ? 2 : 0)}%`;
    setEq({
      rule: [['p(\\mathbf x) \\propto e^{-d(\\mathbf x,\\,\\mathcal M)^2 / 2\\sigma^2}', TEAL], '\\qquad\\dim(\\text{pixel space}) = n \\times n \\times 3'],
      live: [state.random ? '\\text{a random point: } d \\gg \\sigma' : `d = ${Math.abs(state.d).toFixed(2)}`, [`\\quad p(\\mathbf x) = ${denText.replace('%', '\\%').replace('≈', '\\approx')}`, TEAL], `\\quad\\dim = ${dims.toLocaleString()}`],
    });
    setResult({
      value: denText,
      colour: region === 'noise' ? AMBER : region === 'unlikely' ? '#facc15' : TEAL,
      status: `${region} · ${dims.toLocaleString()} pixel-space dimensions${state.random ? '' : ` · distance to the manifold ${Math.abs(state.d).toFixed(2)}`}`,
      note: state.random
        ? 'A uniformly random pixel array. It essentially never lands near the data, which is why generative models must learn p(x).'
        : region === 'realistic'
          ? 'On or near the manifold: many pixels change together, yet the picture stays coherent.'
          : 'Off the manifold the density collapses and the picture dissolves into static.',
    });
    setRows({ 'r-dims': dims.toLocaleString(), 'r-dist': state.random ? 'far' : Math.abs(state.d).toFixed(2) });
  }

  const setAlong = slider('along', (v) => { state.t = v / 100; state.random = false; draw(); }, (v) => `${Math.round(v)}%`);
  const setDist = slider('distance', (v) => { state.d = v / 100; state.random = false; draw(); }, (v) => Math.abs(v / 100).toFixed(2));
  segmented('resolution', (n) => { state.n = +n; draw(); });
  const sync = () => { setAlong(Math.round(state.t * 100)); setDist(Math.round(state.d * 100)); draw(); };
  el('sample-real').addEventListener('click', () => { state.t = Math.random(); state.d = (Math.random() - 0.5) * 0.08; state.random = false; sync(); });
  el('sample-space').addEventListener('click', () => { state.random = true; draw(); });
  el('reset').addEventListener('click', () => { state.t = 0.42; state.d = 0; state.random = false; Object.assign(camera, { yaw: -0.62, pitch: -0.3, distance: 8.5 }); sync(); });

  canvas.addEventListener('pointerdown', (e) => { dragging = true; lastPointer = { x: e.clientX, y: e.clientY }; canvas.setPointerCapture(e.pointerId); });
  canvas.addEventListener('pointermove', (e) => {
    if (!dragging) return;
    camera.yaw += (e.clientX - lastPointer.x) * 0.009;
    camera.pitch = Math.max(-1.15, Math.min(1.15, camera.pitch + (e.clientY - lastPointer.y) * 0.009));
    lastPointer = { x: e.clientX, y: e.clientY };
    draw();
  });
  canvas.addEventListener('pointerup', () => (dragging = false));
  canvas.addEventListener('pointercancel', () => (dragging = false));
  canvas.addEventListener('wheel', (e) => {
    e.preventDefault();
    camera.distance = Math.max(3, Math.min(20, camera.distance + e.deltaY * 0.008));
    draw();
  }, { passive: false });

  sync();
</script>

<style>
  #manifold {
    cursor: grab;
    touch-action: none;
  }
  #manifold:active {
    cursor: grabbing;
  }
</style>
