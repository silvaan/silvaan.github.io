---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Checks from '../../../components/sim/Checks.astro';
import Transport from '../../../components/sim/Transport.astro';
import Readout from '../../../components/sim/Readout.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Try from '../../../components/sim/Try.astro';

const WAVE = '#a78bfa', HIT = '#fbbf24';
---

<SimLayout
  areaSlug="physics"
  title="Wavefunction Collapse"
  description="A matter wave spreads through space as a cloud of probability, until something measures it and it is found at one single point. Measure a packet, split it into two places at once, or fire particles one by one at a screen and watch the interference fringes build up dot by dot."
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas id="wf" class="wf-canvas" width="820" height="720" role="img" aria-label="A quantum wave packet drawn in three dimensions as a glowing fog and a shaded plane coloured by its phase. A measurement collapses it to a single point, and on the detector screen each particle lands as one dot."></canvas>
      </div>
      <Caption
        legend={[
          { label: 'probability density |ψ|²', color: WAVE },
          { label: 'phase arg ψ (hue)', color: '#22d3ee', id: 'lg-phase' },
          { label: 'detection', color: HIT },
        ]}
        hint="Click empty space to measure · drag to orbit · scroll to zoom"
      />
      <Result label="Spread σ" />
    </div>

    <div class="sim-panel">
      <Seg
        id="scene"
        label="Scene"
        attr="s"
        options={[
          { value: 'one', label: 'One packet' },
          { value: 'two', label: 'Two places at once' },
          { value: 'screen', label: 'Detector screen' },
        ]}
      />
      <Transport step running>
        <button type="button" class="btn ghost" id="measure">Measure</button>
        <button type="button" class="btn ghost" id="fire" hidden>Fire 100</button>
      </Transport>
      <div id="one-wrap">
        <Slider id="k1" label="Momentum k" min={0} max={3} step={0.1} value={1.2} display="1.2" />
        <Slider id="s1" label="Packet width σ<sub>0</sub>" min={0.3} max={1.2} step={0.05} value={0.55} display="0.55" />
      </div>
      <div id="two-wrap" hidden>
        <Slider id="sep" label="Separation 2a" min={3} max={9} step={0.1} value={7} display="7.0" />
        <Slider id="phi" label="Relative phase φ" min={0} max={6.28} step={0.02} value={0} display="0.00π" />
      </div>
      <div id="res-wrap">
        <Slider id="sm" label="Detector resolution σ<sub>m</sub>" min={0.12} max={0.8} step={0.01} value={0.2} display="0.20" hint={['sharp', 'blurry']} />
      </div>
      <div id="screen-wrap" hidden>
        <Slider id="d3" label="Slit separation d" min={2.5} max={6.5} step={0.1} value={4.5} display="4.5" />
        <Slider id="k3" label="Momentum k" min={4} max={9} step={0.1} value={5.5} display="5.5" />
      </div>
      <Seg
        id="show"
        label="Show"
        options={[
          { value: 'both', label: 'Cloud + plane' },
          { value: 'plane', label: 'Plane' },
          { value: 'cloud', label: 'Cloud' },
        ]}
      />
      <div id="plane-wrap">
        <Seg
          id="plane"
          label="Plane"
          options={[
            { value: 'xy', label: 'XY' },
            { value: 'xz', label: 'XZ' },
            { value: 'yz', label: 'YZ' },
          ]}
        />
        <Slider id="offset" label="Plane offset" min={-6} max={6} step={0.1} value={0} display="0.0" />
      </div>
      <div id="density-wrap">
        <Slider id="density" label="Cloud opacity" min={0.2} max={4} step={0.05} value={1.3} display="1.30" hint={['thin', 'dense']} />
      </div>
      <Checks items={[{ id: 'phase', label: 'Colour by phase', checked: true }]} />
      <Readout
        title="Values"
        rows={[
          { id: 'tOut', label: 'time t' },
          { id: 'sigOut', label: 'width σ(t)' },
          { id: 'meanOut', label: '⟨r⟩' },
          { id: 'lastOut', label: 'last found at' },
          { id: 'countOut', label: 'measurements' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      A free packet <b>spreads</b> as it moves. Measure it and the whole cloud
      collapses to <b>one point</b>, which then spreads again, faster the sharper
      the detector: a narrow σ<sub>m</sub> fixes the position and leaves the
      momentum uncertain. <Try id="spread" />
    </li>
    <li>
      In <b>Two places at once</b> a measurement finds the particle in one place
      only, each about half the time. Let the halves spread into each other first
      and fringes appear: both halves were really there. <Try id="two" />
    </li>
    <li>
      At the <b>detector screen</b> every particle lands as a single dot, wherever
      the wave was. One dot shows no pattern; hundreds of them draw the
      <b>interference fringes</b>. <Try id="screen" />
    </li>
    <li>
      With <b>colour by phase</b> on, the hue turns once every wavelength 2π/k,
      so the stripes on a moving packet are its momentum. Raise k and they
      crowd together. <Try id="phase" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { el, segmented, slider, check, transport, readout, result, tries } from '../../../lib/panel';
  import {
    Camera3D, orbitControls, drawBox, drawBackdrop, drawGizmo, line3, planePoint,
    PlaneShade, fieldRamp, rgba32, type Vec, type PlaneAxis,
  } from '../../../lib/scene3d';
  import { VolumeView } from '../../../lib/volume3d';

  const canvas = el('wf') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const css = (v: string) => getComputedStyle(canvas).getPropertyValue(v).trim();
  const isLight = () => css('--stage-light') === '1';
  const ink = () => css('--stage-ink') || '232,233,236';

  // Units ħ = m = 1. Lengths in box units: the box runs from −HALF to HALF.
  const HALF = 6;
  const TAU = Math.PI * 2;
  const WAVE = '#a78bfa', HIT = '#fbbf24';

  // the detector-screen scene: slit plate, screen, and how far a packet flies
  const XL = -4.8;          // the plate with the two slits
  const X0 = -4.2;          // where a packet starts
  const XS = 4.4;           // the detector screen
  const HIT_AT = XS - 0.4;  // a particle is detected when the packet centre gets here
  const SZ0 = 0.2;          // width of each slit's packet across z
  const SX0 = 0.8, SY0 = 0.8;

  // sim time per second of real time
  const RATE = { one: 0.6, two: 0.6, screen: 0.7 } as const;
  const T_LOOP = 8.5; // scenes 1 and 2 start over after this long

  type Scene = 'one' | 'two' | 'screen';
  type Show = 'both' | 'plane' | 'cloud';

  /**
   * A free Gaussian packet, a product of three 1D packets. Each axis has its
   * own centre x0, momentum k and starting width s0; `t0` is when it was born,
   * and (cre, cim) its complex weight in the superposition.
   */
  type Packet = { x0: number[]; k: number[]; s0: number[]; t0: number; cre: number; cim: number };

  const state = {
    scene: 'one' as Scene,
    show: 'both' as Show,
    plane: 'xy' as PlaneAxis,
    offset: 0,
    density: 1.3, // the fog's opacity κ
    phase: true,
    k1: 1.2,
    s1: 0.55,
    sep: 7,
    phi: 0,
    sm: 0.2,
    d3: 4.5,
    k3: 5.5,
  };

  let t = 0;
  let packets: Packet[] = [];
  let measured: { p: Vec; t: number }[] = [];
  let nMeasured = 0;
  let autoMeasureAt = -1;
  let collapsed = false;
  let collapseAt = -1e9; // real-time ms of the last collapse, for the slow motion after it

  // detector screen: hits on the screen as (y, z) pairs
  const MAXHITS = 6000;
  const hits = new Float32Array(MAXHITS * 2);
  let nHits = 0;
  let flightStart = 0;
  let gapUntil = 0; // real-time ms until the next particle is launched
  let inFlight = false;

  type Flash = { p: Vec; born: number; big: boolean };
  let flashes: Flash[] = [];

  // --- the wave -------------------------------------------------------------------

  // Per packet, per frame: [mu x3, A x3, B x3, k x3, mag, ph0, sigma x3] so
  // ψ needs no allocation: ψ_j(r) = mag · exp(−Σ A D² + i(ph0 + Σ (B D² + k D))), D = r − mu
  const NP = 19;
  let prep = new Float64Array(NP * 4);
  let nPrep = 0;

  function prepare(at: number, list = packets) {
    if (prep.length < list.length * NP) prep = new Float64Array(list.length * NP);
    nPrep = list.length;
    list.forEach((pk, j) => {
      const o = j * NP;
      const tl = Math.max(0, at - pk.t0);
      let mag = Math.hypot(pk.cre, pk.cim), ph = Math.atan2(pk.cim, pk.cre);
      for (let a = 0; a < 3; a++) {
        const s0 = pk.s0[a], k = pk.k[a];
        const tau = tl / (2 * s0 * s0);
        const A = 1 / (4 * s0 * s0 * (1 + tau * tau));
        prep[o + a] = pk.x0[a] + k * tl;
        prep[o + 3 + a] = A;
        prep[o + 6 + a] = A * tau;
        prep[o + 9 + a] = k;
        prep[o + 16 + a] = s0 * Math.sqrt(1 + tau * tau);
        mag *= Math.pow(TAU * s0 * s0, -0.25) * Math.pow(1 + tau * tau, -0.25);
        ph += -0.5 * Math.atan(tau) + 0.5 * k * k * tl;
      }
      prep[o + 12] = mag;
      prep[o + 13] = ph;
    });
  }

  let psiRe = 0, psiIm = 0;
  function psi(x: number, y: number, z: number) {
    let re = 0, im = 0;
    for (let j = 0; j < nPrep; j++) {
      const o = j * NP;
      const dx = x - prep[o], dy = y - prep[o + 1], dz = z - prep[o + 2];
      const e = prep[o + 3] * dx * dx + prep[o + 4] * dy * dy + prep[o + 5] * dz * dz;
      if (e > 40) continue;
      const m = prep[o + 12] * Math.exp(-e);
      const ph = prep[o + 13] + prep[o + 6] * dx * dx + prep[o + 7] * dy * dy + prep[o + 8] * dz * dz
        + prep[o + 9] * dx + prep[o + 10] * dy + prep[o + 11] * dz;
      re += m * Math.cos(ph);
      im += m * Math.sin(ph);
    }
    psiRe = re;
    psiIm = im;
    return re * re + im * im;
  }

  /** Where the wave is allowed to be drawn: inside the box, and between plate and screen in scene 3. */
  function visible(x: number) {
    return state.scene !== 'screen' || (x >= XL && x <= XS);
  }

  // --- scenes ---------------------------------------------------------------------

  function initial(): Packet[] {
    if (state.scene === 'one') {
      const s = state.s1;
      return [{ x0: [-3, 0, 0], k: [state.k1, 0, 0], s0: [s, s, s], t0: 0, cre: 1, cim: 0 }];
    }
    if (state.scene === 'two') {
      const a = state.sep / 2, s = 0.38, r = Math.SQRT1_2;
      return [
        { x0: [-a, 0, 0], k: [0, 0, 0], s0: [s, s, s], t0: 0, cre: r, cim: 0 },
        { x0: [a, 0, 0], k: [0, 0, 0], s0: [s, s, s], t0: 0, cre: r * Math.cos(state.phi), cim: r * Math.sin(state.phi) },
      ];
    }
    return [];
  }

  function screenPackets(t0: number): Packet[] {
    const a = state.d3 / 2, r = Math.SQRT1_2;
    return [
      { x0: [X0, 0, -a], k: [state.k3, 0, 0], s0: [SX0, SY0, SZ0], t0, cre: r, cim: 0 },
      { x0: [X0, 0, a], k: [state.k3, 0, 0], s0: [SX0, SY0, SZ0], t0, cre: r, cim: 0 },
    ];
  }

  const flightTime = () => (HIT_AT - X0) / state.k3;

  function restart(clearRecords = true) {
    t = 0;
    autoMeasureAt = -1;
    collapsed = false;
    packets = initial();
    if (clearRecords) {
      measured = [];
      nMeasured = 0;
      nHits = 0;
      flashes = [];
    }
    if (state.scene === 'screen') launch();
    snap = true;
  }

  function launch() {
    flightStart = t;
    packets = screenPackets(t);
    inFlight = true;
  }

  // --- measuring --------------------------------------------------------------------

  /** Pick an index from unnormalised weights by their running sum. */
  function pick(cdf: Float64Array, n: number) {
    const u = Math.random() * cdf[n - 1];
    let lo = 0, hi = n - 1;
    while (lo < hi) {
      const mid = (lo + hi) >> 1;
      if (cdf[mid] < u) lo = mid + 1;
      else hi = mid;
    }
    return lo;
  }

  const MG = 40;
  const mcdf = new Float64Array(MG * MG * MG);

  /**
   * Sample a position from |ψ|² on a 40³ grid over the box the packets
   * occupy (so a narrow packet still gets fine cells), jittered inside the
   * chosen cell. Then the wave is replaced by a narrow packet at rest there.
   */
  function measure() {
    if (state.scene === 'screen' || !packets.length) return;
    prepare(t);
    const lo = [0, 0, 0], hi = [0, 0, 0];
    for (let a = 0; a < 3; a++) {
      let l = Infinity, h = -Infinity;
      for (let j = 0; j < nPrep; j++) {
        const mu = prep[j * NP + a], s = prep[j * NP + 16 + a];
        l = Math.min(l, mu - 4.5 * s);
        h = Math.max(h, mu + 4.5 * s);
      }
      lo[a] = Math.max(-HALF, l);
      hi[a] = Math.min(HALF, h);
      if (hi[a] - lo[a] < 0.05) { lo[a] = -HALF; hi[a] = HALF; }
    }
    const step = [0, 1, 2].map((a) => (hi[a] - lo[a]) / MG);
    let acc = 0, n = 0;
    for (let i = 0; i < MG; i++) {
      const x = lo[0] + (i + 0.5) * step[0];
      for (let j = 0; j < MG; j++) {
        const y = lo[1] + (j + 0.5) * step[1];
        for (let l = 0; l < MG; l++) {
          acc += psi(x, y, lo[2] + (l + 0.5) * step[2]);
          mcdf[n++] = acc;
        }
      }
    }
    if (!(acc > 0)) return;
    const c = pick(mcdf, n);
    const i = Math.floor(c / (MG * MG)), j = Math.floor(c / MG) % MG, l = c % MG;
    const p = {
      x: lo[0] + (i + Math.random()) * step[0],
      y: lo[1] + (j + Math.random()) * step[1],
      z: lo[2] + (l + Math.random()) * step[2],
    };
    const s = state.sm;
    packets = [{ x0: [p.x, p.y, p.z], k: [0, 0, 0], s0: [s, s, s], t0: t, cre: 1, cim: 0 }];
    measured.push({ p, t });
    if (measured.length > 8) measured.shift();
    nMeasured++;
    collapsed = true;
    collapseAt = performance.now();
    flashes.push({ p, born: performance.now(), big: true });
    autoMeasureAt = -1;
  }

  // the screen: |ψ(XS, y, z)|² at the moment of detection, on a fine (y, z) grid
  const SGY = 80, SGZ = 160;
  const scdf = new Float64Array(SGY * SGZ);
  let screenKey = '';

  function screenCdf() {
    const key = `${state.d3}|${state.k3}`;
    if (key === screenKey) return;
    screenKey = key;
    prepare(flightTime(), screenPackets(0));
    let acc = 0, n = 0;
    for (let j = 0; j < SGY; j++) {
      const y = -HALF + ((j + 0.5) / SGY) * 2 * HALF;
      for (let l = 0; l < SGZ; l++) {
        acc += psi(XS, y, -HALF + ((l + 0.5) / SGZ) * 2 * HALF);
        scdf[n++] = acc;
      }
    }
  }

  function detect(flash: boolean) {
    screenCdf();
    const c = pick(scdf, SGY * SGZ);
    const j = Math.floor(c / SGZ), l = c % SGZ;
    const y = -HALF + ((j + Math.random()) / SGY) * 2 * HALF;
    const z = -HALF + ((l + Math.random()) / SGZ) * 2 * HALF;
    const slot = nHits < MAXHITS ? nHits : Math.floor(Math.random() * MAXHITS);
    hits[slot * 2] = y;
    hits[slot * 2 + 1] = z;
    nHits++;
    const p = { x: XS, y, z };
    if (flash) {
      flashes.push({ p, born: performance.now(), big: true });
      measured = [{ p, t }];
    }
  }

  function fire(n: number) {
    for (let i = 0; i < n; i++) detect(false);
    flashes.push({ p: { x: XS, y: hits[((nHits - 1) % MAXHITS) * 2], z: hits[((nHits - 1) % MAXHITS) * 2 + 1] }, born: performance.now(), big: false });
  }

  // --- time -----------------------------------------------------------------------

  /**
   * Right after a collapse time runs in slow motion for a moment, so the
   * point it collapsed to can be seen before it spreads again.
   */
  function slowmo() {
    const e = (performance.now() - collapseAt) / 1000;
    return e < 0.6 ? 0.04 : Math.min(1, 0.04 + (e - 0.6) / 1.4);
  }

  function advance(dt: number) {
    t += dt * RATE[state.scene] * (state.scene === 'screen' ? 1 : slowmo());
    if (state.scene === 'screen') {
      const now = performance.now();
      if (inFlight && t - flightStart >= flightTime()) {
        detect(true);
        packets = [];
        inFlight = false;
        gapUntil = now + 650;
      } else if (!inFlight && now >= gapUntil) {
        launch();
      }
      return;
    }
    if (autoMeasureAt >= 0 && t >= autoMeasureAt) measure();
    const born = packets.length ? packets[0].t0 : 0;
    if (t - born > T_LOOP) {
      t = 0;
      collapsed = false;
      packets = initial();
      snap = true;
    }
  }

  // --- colour -----------------------------------------------------------------------

  // a cyclic palette for the phase: rose, amber, green, cyan, blue, violet
  const HUES = [
    [244, 114, 182], [251, 191, 36], [74, 222, 128], [34, 211, 238], [96, 165, 250], [167, 139, 250],
  ];
  function hueRGB(h: number) {
    const f = (((h % 1) + 1) % 1) * HUES.length;
    const i = Math.floor(f), u = f - i;
    const a = HUES[i % HUES.length], b = HUES[(i + 1) % HUES.length];
    return [a[0] + (b[0] - a[0]) * u, a[1] + (b[1] - a[1]) * u, a[2] + (b[2] - a[2]) * u];
  }

  const NH = 64;
  let phaseLut = new Uint32Array(NH * 256);
  let plainLut = new Uint32Array(256);
  let lutLight: boolean | null = null;

  function buildLuts() {
    const light = isLight();
    if (light === lutLight) return;
    lutLight = light;
    plainLut = fieldRamp(light);
    phaseLut = new Uint32Array(NH * 256);
    for (let h = 0; h < NH; h++) {
      const c = hueRGB(h / NH);
      for (let k = 0; k < 256; k++) {
        const l = k / 255;
        let r: number, g: number, b: number, al: number;
        if (light) {
          const d = 0.9 - 0.3 * l;
          r = c[0] * d; g = c[1] * d; b = c[2] * d;
          al = Math.min(0.9, 1.1 * Math.pow(l, 0.65));
        } else {
          const v = 0.4 + 0.6 * l, w = Math.max(0, (l - 0.72) / 0.28) * 0.6;
          r = c[0] * v; g = c[1] * v; b = c[2] * v;
          r += (255 - r) * w; g += (255 - g) * w; b += (255 - b) * w;
          al = Math.min(0.92, 1.0 * Math.pow(l, 0.75));
        }
        phaseLut[h * 256 + k] = rgba32(r, g, b, 255 * al);
      }
    }
    wheel = null;
  }

  /** A cheap stand-in for atan2 / 2π: monotonic in the angle, in [0, 1). */
  function turn(b: number, a: number) {
    let d: number;
    if (b >= 0) d = a >= 0 ? b / (a + b + 1e-30) : 1 - a / (b - a);
    else d = a < 0 ? 2 - b / (-a - b) : 3 + a / (a - b);
    return d * 0.25;
  }

  // --- camera and the plane -----------------------------------------------------------

  // centred a little above the canvas middle: the equation bar sits over the top
  const cam = new Camera3D(W, H - 70, { dist: 15, yaw: 0.62, pitch: -0.42, zoom: 0.7 });
  const shade = new PlaneShade(W, H, { half: HALF, grid: 112, step: 1.5 });

  // brightness follows the scene slowly, in log space, so a collapse flares
  // bright for a moment before the exposure catches up
  let refLog = 0;
  let snap = true;

  function samplePlane() {
    let mx = 0;
    const A = shade.a, B = shade.b;
    shade.sample(state.plane, state.offset, (x, y, z, i) => {
      if (!visible(x)) { A[i] = 0; B[i] = 0; return; }
      const r = psi(x, y, z);
      A[i] = psiRe;
      B[i] = psiIm;
      if (r > mx) mx = r;
    });
    return mx;
  }

  function drawPlane() {
    buildLuts();
    const inv = 16 / Math.exp(refLog), norm = 255 / Math.log(17);
    const lutP = phaseLut, lutF = plainLut, byPhase = state.phase;

    shade.render(ctx, cam, state.plane, state.offset, (a, b) => {
      const r = a * a + b * b;
      let li = (Math.log(1 + r * inv) * norm) | 0;
      if (li < 2) return 0;
      if (li > 255) li = 255;
      if (!byPhase) return lutF[li];
      return lutP[(((turn(b, a) * NH) | 0) % NH) * 256 + li];
    });
  }

  function drawPlaneFrame() {
    const light = isLight();
    const col = `rgba(${ink()},${light ? 0.1 : 0.07})`;
    const edge = `rgba(${ink()},${light ? 0.32 : 0.26})`;
    const k = 12;
    for (let i = 0; i <= k; i++) {
      const u = -HALF + (2 * HALF * i) / k;
      const c = i === 0 || i === k ? edge : col;
      line3(ctx, cam, planePoint(state.plane, state.offset, u, -HALF), planePoint(state.plane, state.offset, u, HALF), c, 1);
      line3(ctx, cam, planePoint(state.plane, state.offset, -HALF, u), planePoint(state.plane, state.offset, HALF, u), c, 1);
    }
    const lab = cam.project(planePoint(state.plane, state.offset, HALF, -HALF));
    const axis = { xy: 'z', xz: 'y', yz: 'x' }[state.plane];
    ctx.fillStyle = `rgba(${ink()},0.5)`;
    ctx.font = "500 11px 'JetBrains Mono', monospace";
    ctx.textAlign = 'left';
    ctx.textBaseline = 'middle';
    ctx.fillText(`${state.plane.toUpperCase()} · ${axis} = ${state.offset.toFixed(1)}`, lab.sx + 8, lab.sy);
  }

  // --- the volume ------------------------------------------------------------------

  // ψ is sampled on a GN³ grid over the box the packets occupy (±4σ around
  // each, clamped to the box), so a collapsed packet gets as many cells as a
  // spread one. A packet is a product of three 1D factors, so each axis is
  // evaluated once per packet and the grid is filled by complex products.
  const GN = 72;
  const vol = new Float32Array(GN * GN * GN * 2);
  const fac = new Float64Array(8 * 3 * GN * 2); // per packet, per axis, per cell: re, im
  const facMax = new Float64Array(8 * 3);
  const vLo = [0, 0, 0], vHi = [0, 0, 0];
  let volEmpty = true;
  let mean: Vec = { x: 0, y: 0, z: 0 };
  let sigLen = 1; // a typical width of the packets, which sets the fog's opacity scale

  function sampleVolume() {
    const P = Math.min(8, nPrep);
    volEmpty = true;
    if (!P) return 0;
    for (let a = 0; a < 3; a++) {
      let l = Infinity, h = -Infinity;
      for (let j = 0; j < P; j++) {
        const mu = prep[j * NP + a], s = prep[j * NP + 16 + a];
        l = Math.min(l, mu - 4 * s);
        h = Math.max(h, mu + 4 * s);
      }
      let lo = -HALF, hi = HALF;
      if (a === 0 && state.scene === 'screen') { lo = XL; hi = XS; }
      vLo[a] = Math.max(lo, l);
      vHi[a] = Math.min(hi, h);
      if (vHi[a] - vLo[a] < 1e-3) return 0;
    }
    let sl = 0;
    for (let j = 0; j < P; j++) {
      const o = j * NP;
      sl += Math.cbrt(prep[o + 16] * prep[o + 17] * prep[o + 18]);
      for (let a = 0; a < 3; a++) {
        const step = (vHi[a] - vLo[a]) / GN;
        const A = prep[o + 3 + a], B = prep[o + 6 + a], k = prep[o + 9 + a], mu = prep[o + a];
        const m0 = a === 0 ? prep[o + 12] : 1, p0 = a === 0 ? prep[o + 13] : 0;
        const base = (j * 3 + a) * GN * 2;
        let mx = 0;
        for (let i = 0; i < GN; i++) {
          const D = vLo[a] + (i + 0.5) * step - mu;
          const e = A * D * D;
          const m = e > 60 ? 0 : m0 * Math.exp(-e);
          const ph = p0 + B * D * D + k * D;
          fac[base + i * 2] = m * Math.cos(ph);
          fac[base + i * 2 + 1] = m * Math.sin(ph);
          if (m > mx) mx = m;
        }
        facMax[j * 3 + a] = mx;
      }
    }
    sigLen = sl / P;
    let peak = 0, sw = 0, sx = 0, sy = 0, sz = 0;
    const cr = new Float64Array(P), ci = new Float64Array(P);
    const sx0 = (vHi[0] - vLo[0]) / GN, sy0 = (vHi[1] - vLo[1]) / GN, sz0 = (vHi[2] - vLo[2]) / GN;
    let n = 0;
    for (let l = 0; l < GN; l++) {
      for (let jy = 0; jy < GN; jy++) {
        let live = false;
        for (let p = 0; p < P; p++) {
          const by = ((p * 3 + 1) * GN + jy) * 2, bz = ((p * 3 + 2) * GN + l) * 2;
          const yr = fac[by], yi = fac[by + 1], zr = fac[bz], zi = fac[bz + 1];
          cr[p] = yr * zr - yi * zi;
          ci[p] = yr * zi + yi * zr;
          if ((Math.abs(cr[p]) + Math.abs(ci[p])) * facMax[p * 3] > 1e-9) live = true;
        }
        if (!live) {
          vol.fill(0, n, n + GN * 2);
          n += GN * 2;
          continue;
        }
        let rowW = 0, rowX = 0;
        for (let i = 0; i < GN; i++) {
          let re = 0, im = 0;
          for (let p = 0; p < P; p++) {
            const bx = (p * 3 * GN + i) * 2;
            const xr = fac[bx], xi = fac[bx + 1];
            re += xr * cr[p] - xi * ci[p];
            im += xr * ci[p] + xi * cr[p];
          }
          vol[n++] = re;
          vol[n++] = im;
          const r = re * re + im * im;
          if (r > peak) peak = r;
          rowW += r;
          rowX += r * i;
        }
        sw += rowW;
        sx += rowX;
        sy += rowW * jy;
        sz += rowW * l;
      }
    }
    if (sw > 0)
      mean = {
        x: vLo[0] + (sx / sw + 0.5) * sx0,
        y: vLo[1] + (sy / sw + 0.5) * sy0,
        z: vLo[2] + (sz / sw + 0.5) * sz0,
      };
    volEmpty = peak <= 0;
    return peak;
  }

  // --- the fog: raymarched by the shared volume renderer -------------------------------

  // a WebGL2 canvas stacked under the 2D one, or null without WebGL2 (then
  // only the plane is drawn, in 2D)
  const fog = VolumeView.create(canvas, W, H, 'complex');
  const planeBuf = new Float32Array(112 * 112 * 2);
  let fogColours = '';

  function renderFog(showCloud: boolean, showPlane: boolean) {
    if (!fog) return;
    buildLuts();
    // the same tables the 2D plane uses: hue rows × brightness, or the violet ramp
    const key = `${lutLight}|${state.phase}`;
    if (key !== fogColours) {
      fogColours = key;
      fog.setColours(state.phase ? phaseLut : plainLut);
    }
    fog.render(cam, {
      cloud: showCloud && !volEmpty && nPrep > 0,
      plane: showPlane && nPrep > 0,
      gain: 1 / Math.exp(refLog),
      opacity: state.density,
      len: Math.max(0.05, sigLen),
      phase: state.phase,
      light: isLight(),
      planeAlpha: 0.6,
    });
  }

  // --- scene furniture -----------------------------------------------------------------

  function quad(pts: Vec[]) {
    const pr = pts.map((p) => cam.project(p));
    ctx.moveTo(pr[0].sx, pr[0].sy);
    for (let i = 1; i < pr.length; i++) ctx.lineTo(pr[i].sx, pr[i].sy);
    ctx.closePath();
  }

  function yzRect(x: number, y0: number, y1: number, z0: number, z1: number) {
    return [{ x, y: y0, z: z0 }, { x, y: y1, z: z0 }, { x, y: y1, z: z1 }, { x, y: y0, z: z1 }];
  }

  const SLIT_H = 0.28, SLIT_Z = 1.3;

  function drawPlate() {
    const light = isLight();
    const a = state.d3 / 2;
    ctx.beginPath();
    quad(yzRect(XL, -HALF, HALF, -HALF, HALF));
    quad(yzRect(XL, -SLIT_Z, SLIT_Z, -a - SLIT_H, -a + SLIT_H));
    quad(yzRect(XL, -SLIT_Z, SLIT_Z, a - SLIT_H, a + SLIT_H));
    ctx.fillStyle = light ? 'rgba(71,85,105,0.07)' : 'rgba(148,163,184,0.09)';
    ctx.fill('evenodd');
    ctx.strokeStyle = `rgba(${ink()},${light ? 0.4 : 0.3})`;
    ctx.lineWidth = 1;
    ctx.stroke();
  }

  function drawScreen() {
    const light = isLight();
    ctx.beginPath();
    quad(yzRect(XS, -HALF, HALF, -HALF, HALF));
    ctx.fillStyle = light ? 'rgba(15,23,42,0.05)' : 'rgba(226,232,240,0.06)';
    ctx.fill();
    ctx.strokeStyle = `rgba(${ink()},${light ? 0.45 : 0.36})`;
    ctx.lineWidth = 1.2;
    ctx.stroke();
    const lab = cam.project({ x: XS, y: HALF, z: 0 });
    ctx.fillStyle = `rgba(${ink()},0.55)`;
    ctx.font = "500 11px 'JetBrains Mono', monospace";
    ctx.textAlign = 'center';
    ctx.textBaseline = 'bottom';
    ctx.fillText('detector screen', lab.sx, lab.sy - 6);
  }

  function drawHits() {
    const light = isLight();
    const n = Math.min(nHits, MAXHITS);
    const sz = Math.max(1.6, Math.min(3.4, 3.4 * cam.zoom * (n > 1500 ? 0.8 : 1)));
    ctx.fillStyle = light ? 'rgba(194,65,12,0.95)' : 'rgba(253,224,71,0.85)';
    ctx.beginPath();
    for (let i = 0; i < n; i++) {
      const pr = cam.project({ x: XS, y: hits[i * 2], z: hits[i * 2 + 1] });
      ctx.rect(pr.sx - sz / 2, pr.sy - sz / 2, sz, sz);
    }
    ctx.fill();
  }

  function drawRecords() {
    const light = isLight();
    if (state.scene === 'screen') return;
    measured.forEach((m, i) => {
      const pr = cam.project(m.p);
      if (pr.zc < 0.3) return;
      const age = (measured.length - 1 - i) / 8;
      const al = (1 - age) * (light ? 0.75 : 0.85);
      ctx.strokeStyle = light ? `rgba(180,83,9,${al})` : `rgba(251,191,36,${al})`;
      ctx.lineWidth = 1.4;
      ctx.beginPath();
      ctx.arc(pr.sx, pr.sy, 5, 0, TAU);
      ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(pr.sx - 9, pr.sy); ctx.lineTo(pr.sx - 6, pr.sy);
      ctx.moveTo(pr.sx + 6, pr.sy); ctx.lineTo(pr.sx + 9, pr.sy);
      ctx.moveTo(pr.sx, pr.sy - 9); ctx.lineTo(pr.sx, pr.sy - 6);
      ctx.moveTo(pr.sx, pr.sy + 6); ctx.lineTo(pr.sx, pr.sy + 9);
      ctx.stroke();
    });
  }

  const FLASH_MS = 700;
  function drawFlashes() {
    const now = performance.now();
    const light = isLight();
    flashes = flashes.filter((f) => now - f.born < FLASH_MS);
    ctx.save();
    ctx.globalCompositeOperation = light ? 'source-over' : 'lighter';
    for (const f of flashes) {
      const u = (now - f.born) / FLASH_MS;
      const pr = cam.project(f.p);
      if (pr.zc < 0.3) continue;
      const sc = f.big ? 1 : 0.6;
      const R = (10 + 60 * Math.sqrt(u)) * sc;
      const g = ctx.createRadialGradient(pr.sx, pr.sy, 0, pr.sx, pr.sy, R);
      const al = (1 - u) * (1 - u);
      g.addColorStop(0, light ? `rgba(245,158,11,${0.75 * al})` : `rgba(255,251,235,${al})`);
      g.addColorStop(0.25, `rgba(251,191,36,${0.6 * al})`);
      g.addColorStop(1, 'rgba(251,191,36,0)');
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(pr.sx, pr.sy, R, 0, TAU);
      ctx.fill();
      ctx.strokeStyle = `rgba(251,191,36,${0.8 * al})`;
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.arc(pr.sx, pr.sy, R * 0.8, 0, TAU);
      ctx.stroke();
    }
    ctx.restore();
    // the point itself, solid for a moment after a collapse
    for (const f of flashes) {
      const pr = cam.project(f.p);
      ctx.fillStyle = light ? '#b45309' : '#fffbeb';
      ctx.beginPath();
      ctx.arc(pr.sx, pr.sy, f.big ? 3 : 2, 0, TAU);
      ctx.fill();
    }
  }

  // a small colour wheel: which hue is which phase
  let wheel: HTMLCanvasElement | null = null;
  function drawWheel() {
    if (!state.phase) return;
    const S = 64;
    if (!wheel) {
      wheel = document.createElement('canvas');
      wheel.width = wheel.height = S;
      const g = wheel.getContext('2d')!;
      const img = g.createImageData(S, S);
      const pix = new Uint32Array(img.data.buffer);
      for (let j = 0; j < S; j++)
        for (let i = 0; i < S; i++) {
          const dx = i + 0.5 - S / 2, dy = S / 2 - (j + 0.5);
          const r = Math.hypot(dx, dy) / (S / 2);
          if (r > 1 || r < 0.55) continue;
          const c = hueRGB(Math.atan2(dy, dx) / TAU);
          const d = isLight() ? 0.8 : 1;
          const edge = Math.min(1, (1 - r) * 20, (r - 0.55) * 20);
          pix[j * S + i] = rgba32(c[0] * d, c[1] * d, c[2] * d, 255 * edge);
        }
      g.putImageData(img, 0, 0);
    }
    const x = W - 62, y = H - 54;
    ctx.drawImage(wheel, x - 20, y - 20, 40, 40);
    ctx.fillStyle = `rgba(${ink()},0.6)`;
    ctx.font = "500 11px 'JetBrains Mono', monospace";
    ctx.textAlign = 'center';
    ctx.textBaseline = 'bottom';
    ctx.fillText('arg ψ', x, y - 26);
    ctx.textBaseline = 'middle';
    ctx.textAlign = 'left';
    ctx.fillText('0', x + 24, y);
    ctx.textAlign = 'right';
    ctx.fillText('π', x - 24, y);
  }

  // --- frame ----------------------------------------------------------------------

  // ψ is only resampled when the wave or the plane changed, not when the camera moves
  let bgLight: boolean | null = null;
  let waveKey = '', planeKey = '', peak = 0, planePeak = 0, volPeak = 0;

  function draw() {
    const light = isLight();
    ctx.clearRect(0, 0, W, H);
    // with WebGL the soft backdrop glow sits under the fog, as the GL canvas' own background
    if (!fog) drawBackdrop(ctx, W, H, light);
    else if (bgLight !== light) {
      bgLight = light;
      fog.canvas.style.background = `radial-gradient(circle at 50% 45%, rgba(99,102,241,${light ? 0.06 : 0.12}), rgba(99,102,241,0) 70%), var(--stage-bg)`;
    }
    drawBox(ctx, cam, HALF, ink(), light);

    const showPlane = !fog || state.show !== 'cloud', showCloud = !!fog && state.show !== 'plane';
    const wk = JSON.stringify(packets) + '|' + t + '|' + state.scene;
    const pk = wk + '|' + state.plane + '|' + state.offset;
    if (wk !== waveKey || pk !== planeKey) prepare(t);
    if (showCloud && wk !== waveKey) {
      waveKey = wk;
      volPeak = sampleVolume();
      if (fog) {
        if (volEmpty) fog.clearVolume();
        else fog.setVolume(vol, [GN, GN, GN], [vLo[0], vLo[1], vLo[2]], [vHi[0], vHi[1], vHi[2]]);
      }
    }
    if (showPlane && pk !== planeKey) {
      planeKey = pk;
      planePeak = samplePlane();
      if (fog) {
        const A = shade.a, B = shade.b;
        for (let i = 0; i < A.length; i++) { planeBuf[i * 2] = A[i]; planeBuf[i * 2 + 1] = B[i]; }
        fog.setPlane(planeBuf, shade.grid, state.plane, state.offset, HALF);
      }
    }
    if (!showCloud) waveKey = '';
    if (!showPlane) planeKey = '';
    peak = Math.max(showCloud ? volPeak : 0, showPlane ? planePeak : 0);
    if (peak > 0) {
      const l = Math.log(peak);
      refLog = snap || !refLog ? l : refLog + (l - refLog) * 0.06;
    }
    snap = false;

    renderFog(showCloud, showPlane);
    if (state.scene === 'screen') drawPlate();
    if (showPlane) {
      if (!fog && nPrep) drawPlane();
      drawPlaneFrame();
    }
    if (state.scene === 'screen') {
      drawScreen();
      drawHits();
    }

    drawRecords();
    drawFlashes();
    drawGizmo(ctx, cam, H);
    drawWheel();
    sync();
  }

  // --- words and numbers -------------------------------------------------------------

  const setEq = equation();
  const setResult = result();
  const setRows = readout();
  const f2 = (v: number) => (Math.abs(v) < 0.005 ? '0.00' : v.toFixed(2));
  const vec = (p: Vec) => `(${f2(p.x)}, ${f2(p.y)}, ${f2(p.z)})`;

  let lastSync = 0;
  function sync(force = false) {
    // typesetting is not free: while the sim runs, refresh the words a few times a second
    const now = performance.now();
    if (!force && tr.running() && now - lastSync < 120) return;
    lastSync = now;
    const rule = [
      'i\\hbar\\,\\dfrac{\\partial',
      ['\\psi', WAVE],
      '}{\\partial t}=-\\dfrac{\\hbar^2}{2m}\\nabla^2',
      ['\\psi', WAVE],
      '\\qquad',
      ['P(\\mathbf r)', HIT],
      '=|',
      ['\\psi(\\mathbf r)', WAVE],
      '|^2',
    ] as (string | [string, string])[];
    const last = measured[measured.length - 1];

    if (state.scene === 'screen') {
      const tf = flightTime(), dy = (TAU * tf) / state.d3;
      setEq({
        rule,
        live: [`\\Delta z = \\dfrac{2\\pi\\hbar\\, t}{m d} = \\dfrac{2\\pi \\cdot ${tf.toFixed(2)}}{${state.d3.toFixed(1)}} = ${dy.toFixed(2)}`, `\\qquad N = ${nHits}`],
      });
      setResult({
        value: String(nHits),
        status: inFlight ? `particle ${nHits + 1} in flight · fringe spacing ${dy.toFixed(2)}` : `fringe spacing ${dy.toFixed(2)}`,
        note: nHits < 30
          ? 'Each particle arrives as a single dot: the wave tells you only where a dot is likely, not where it will land.'
          : 'No single dot knows about the fringes, yet together they draw the interference of a wave that went through both slits.',
      });
      setRows({
        tOut: inFlight ? (t - flightStart).toFixed(2) : '—',
        sigOut: inFlight ? `σz ${f2(prep[18])}` : '—',
        meanOut: inFlight && nPrep ? vec(mean) : '—',
        lastOut: last ? `z ${f2(last.p.z)}, y ${f2(last.p.y)}` : '—',
        countOut: `${nHits} detected`,
      });
      return;
    }

    const sig = nPrep ? prep[16] : 0;
    const p0 = packets[0];
    const s0 = p0 ? p0.s0[0] : 0, tl = p0 ? t - p0.t0 : 0;
    setEq({
      rule,
      live: collapsed && last
        ? [`\\text{found at } ${vec(last.p)}`, `\\quad \\sigma(t) = ${f2(s0)}\\sqrt{1+\\left(\\tfrac{${f2(tl)}}{2\\cdot ${f2(s0)}^2}\\right)^2} = ${f2(sig)}`]
        : [`\\sigma(t) = \\sigma_0\\sqrt{1+\\left(\\dfrac{\\hbar t}{2m\\sigma_0^2}\\right)^2} = ${f2(s0)}\\sqrt{1+\\left(\\tfrac{${f2(tl)}}{2\\cdot ${f2(s0)}^2}\\right)^2} = ${f2(sig)}`],
    });
    setResult({
      value: f2(sig),
      status: collapsed
        ? `found at ${vec(last.p)} · ${f2(tl)} after the collapse`
        : state.scene === 'two' ? `two packets ${state.sep.toFixed(1)} apart · t = ${f2(t)}` : `t = ${f2(t)} · k = ${state.k1.toFixed(1)}`,
      note: collapsed
        ? `The measurement left a packet of width ${f2(s0)}; its momentum spread ħ/2σ₀ = ${f2(0.5 / s0)} makes it grow again.`
        : state.scene === 'two'
          ? 'One particle, one wave in two places. Measure and it turns up in only one of them.'
          : 'The packet is not a small ball but a spread of possible positions; a narrower one spreads faster.',
    });
    setRows({
      tOut: f2(t),
      sigOut: f2(sig),
      meanOut: nPrep ? vec(mean) : '—',
      lastOut: last ? vec(last.p) : '—',
      countOut: String(nMeasured),
    });
  }

  // --- controls -------------------------------------------------------------------

  function panelFor() {
    const sc = state.scene;
    el('one-wrap').hidden = sc !== 'one';
    el('two-wrap').hidden = sc !== 'two';
    el('res-wrap').hidden = sc === 'screen';
    el('screen-wrap').hidden = sc !== 'screen';
    el('measure').hidden = sc === 'screen';
    el('fire').hidden = sc !== 'screen';
    el('plane-wrap').hidden = state.show === 'cloud';
    el('density-wrap').hidden = state.show === 'plane' || !fog;
    el('show').closest('.control')!.toggleAttribute('hidden', !fog);
    el('lg-phase').hidden = !state.phase;
    el('result-label').textContent = sc === 'screen' ? 'Particles detected' : 'Spread σ';
    el('scene-hint').textContent = (sc === 'screen'
      ? 'Drag to orbit · scroll to zoom'
      : 'Click empty space to measure · drag to orbit · scroll to zoom') +
      (fog ? '' : ' · WebGL2 is not available here, so only the plane is drawn');
  }

  function setScene(s: Scene) {
    state.scene = s;
    // each scene opens on the view that shows it best
    const scr = s === 'screen';
    cam.yaw = scr ? -1.3 : 0.62;
    cam.pitch = scr ? -0.58 : -0.42;
    cam.zoom = scr ? 0.64 : 0.6;
    state.plane = scr ? 'xz' : 'xy';
    planes.select(state.plane);
    state.offset = 0;
    setOffset(0);
    restart();
    panelFor();
  }

  const tr = transport({
    onRun: () => draw(),
    onStep: () => { advance(0.25); draw(); },
    onReset: () => { restart(); draw(); },
  });
  const scenes = segmented('scene', (s) => { setScene(s as Scene); draw(); });
  const shows = segmented('show', (v) => { state.show = v as Show; panelFor(); draw(); });
  const planes = segmented('plane', (v) => { state.plane = v as PlaneAxis; draw(); });
  const setOffset = slider('offset', (v) => { state.offset = v; draw(); }, (v) => v.toFixed(1));
  slider('density', (v) => { state.density = v; draw(); }, (v) => v.toFixed(2));
  const setPhase = check('phase', (on) => { state.phase = on; panelFor(); draw(); });
  const setK1 = slider('k1', (v) => { state.k1 = v; if (state.scene === 'one') restart(false); draw(); }, (v) => v.toFixed(1));
  const setS1 = slider('s1', (v) => { state.s1 = v; if (state.scene === 'one') restart(false); draw(); }, (v) => v.toFixed(2));
  const setSep = slider('sep', (v) => { state.sep = v; if (state.scene === 'two') restart(false); draw(); }, (v) => v.toFixed(1));
  const setPhi = slider('phi', (v) => { state.phi = v; if (state.scene === 'two' && !collapsed) packets = initial(); draw(); }, (v) => `${(v / Math.PI).toFixed(2)}π`);
  const setSm = slider('sm', (v) => { state.sm = v; }, (v) => v.toFixed(2));
  slider('d3', (v) => { state.d3 = v; if (state.scene === 'screen') restart(); draw(); }, (v) => v.toFixed(1));
  const setK3 = slider('k3', (v) => { state.k3 = v; if (state.scene === 'screen') restart(); draw(); }, (v) => v.toFixed(1));

  el('measure').addEventListener('click', () => { measure(); draw(); });
  el('fire').addEventListener('click', () => { fire(100); draw(); });

  orbitControls(canvas, cam, W, H, {
    changed: () => { if (!tr.running()) draw(); },
    click: () => { if (state.scene !== 'screen') { measure(); draw(); } },
  });

  function view(s: Scene, show: Show = 'both') {
    state.show = show;
    shows.select(show);
    state.phase = true;
    setPhase(true);
    scenes.select(s);
    setScene(s);
    tr.setRunning(true);
  }

  tries({
    spread: () => {
      state.k1 = 1.2; setK1(1.2);
      state.s1 = 0.55; setS1(0.55);
      state.sm = 0.15; setSm(0.15);
      view('one');
      autoMeasureAt = 2.2;
      draw();
    },
    two: () => {
      state.sep = 7; setSep(7);
      state.phi = 0; setPhi(0);
      view('two');
      autoMeasureAt = 0.6;
      draw();
    },
    screen: () => {
      state.k3 = 5.5; setK3(5.5);
      view('screen');
      fire(400);
      draw();
    },
    phase: () => {
      state.k1 = 3; setK1(3);
      state.s1 = 0.9; setS1(0.9);
      view('one', 'plane');
      cam.zoom = 0.8;
      draw();
    },
  });

  let last = 0;
  function loop(ts: number) {
    const dt = last ? Math.min(0.1, (ts - last) / 1000) : 0;
    last = ts;
    if (tr.running()) {
      advance(dt);
      draw();
    } else if (flashes.length) draw();
    requestAnimationFrame(loop);
  }

  setScene('one');
  draw();
  requestAnimationFrame(loop);
</script>

