---
import SimLayout from '../../../layouts/SimLayout.astro';
import Slider from '../../../components/sim/Slider.astro';
import Checks from '../../../components/sim/Checks.astro';
import Transport from '../../../components/sim/Transport.astro';
import Readout from '../../../components/sim/Readout.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="physics"
  title="Quantum Fields"
  description="A field fills all of space, and splitting it into waves turns it into a grid of independent oscillators, one per momentum. Excite a mode into a coherent state and a classical-looking wave appears whose energy comes in steps of ω: those steps are the particles. One mass slider decides how heavy they are, how far they reach and how fast they move."
  shortcuts={['run', 'reset', 'fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas id="qf" width="900" height="660" role="img" aria-label="A scalar field in two dimensions, the grid of momentum modes with their mean occupation numbers, the dispersion relation and the range of the field's correlations."></canvas>
      </div>
      <Caption hint="Click a cell in momentum space to add one quantum on average to that mode, shift-click to remove one; far cells are fast, short-wavelength particles" />
      <Result label="Mean number of quanta" />
    </div>

    <div class="sim-panel">
      <Transport />
      <Slider id="m" label="Mass m" min={0} max={4} step={0.05} value={1} display="1.00" />
      <Slider id="sp" label="Time rate" min={0} max={200} value={100} display="1.0×" />
      <Checks items={[{ id: 'zp', label: 'Add a sample of the vacuum fluctuations' }]} />
      <Readout
        title="Numbers"
        rows={[
          { id: 'nq', label: 'Mean quanta ⟨N⟩' },
          { id: 'en', label: 'Their energy Σ ⟨n⟩ ω' },
          { id: 'mom', label: 'Total momentum |P|' },
          { id: 'gap', label: 'Rest energy of one (gap)' },
          { id: 'range', label: 'Reach of the field 1/m' },
          { id: 'vg', label: 'Last mode: speed |k|/ω' },
          { id: 'rms', label: 'Field size on screen' },
          { id: 'vac', label: 'Vacuum energy Σ ω/2' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Each clicked cell holds a <b>coherent state</b>: a plane wave runs across the
      field in the direction of that k. The opposite cell gives the same
      wavelength going the other way. <Try id="wave" label="Run" />
    </li>
    <li>
      Click the same cell again and again: the energy rises by <b>exactly ω</b> per
      quantum while the mean wave grows only as √⟨n⟩. A state with a definite
      number of quanta would show no mean wave at all. <Try id="steps" />
    </li>
    <li>
      Pull the <b>mass</b> to zero: the dispersion curve drops onto the light cone,
      the gap closes and the correlation never dies off. With mass it dies at
      distance 1/m. <Try id="massless" />
    </li>
    <li>
      Add the <b>vacuum fluctuations</b> to a single quantum: the wave all but
      vanishes in the shimmer of the empty field, so particles are found by
      their modes, not by staring at the field. <Try id="vacuum" label="Run" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { el, slider, check, transport, result, readout, tries } from '../../../lib/panel';

  // ħ = c = 1. The box is 2π wide so momenta are integers, k = (nx, ny).
  const K = 6, NK = 2 * K + 1;   // modes per axis, nx from -6..6
  const NM = NK * NK;            // 169 independent oscillators
  const GRID = 64;               // field render resolution
  const BOX = 2 * Math.PI;
  const WFLOOR = 0.25;           // keeps the k = 0, m = 0 mode from blowing up

  const state = { m: 1, rate: 1, zp: false, t: 0 };
  const occ = new Int32Array(NM);        // mean occupation ⟨n⟩ of each mode's coherent state
  const phase = new Float64Array(NM);    // random phase of each oscillator
  const omega = new Float64Array(NM);
  const kx = new Float64Array(NM), ky = new Float64Array(NM), kmag = new Float64Array(NM);
  let lastMode = -1, hoverMode = -1;

  for (let j = 0; j < NK; j++)
    for (let i = 0; i < NK; i++) {
      const d = j * NK + i;
      kx[d] = i - K;
      ky[d] = j - K;
      kmag[d] = Math.hypot(kx[d], ky[d]);
    }
  // One sample of the vacuum: each mode gets a complex Gaussian amplitude with
  // ⟨|z|²⟩ = 1/(2ω), the ground-state spread every coherent state shares.
  const noiseMag = new Float64Array(NM), noisePhase = new Float64Array(NM);
  function resample() {
    for (let d = 0; d < NM; d++) {
      phase[d] = Math.random() * 2 * Math.PI;
      noiseMag[d] = Math.sqrt(-Math.log(1 - Math.random()));
      noisePhase[d] = Math.random() * 2 * Math.PI;
    }
  }
  resample();
  function computeOmega() {
    for (let d = 0; d < NM; d++)
      omega[d] = Math.max(WFLOOR, Math.sqrt(kmag[d] * kmag[d] + state.m * state.m));
  }

  // --- exact 2D propagator, G(r) ∝ K₀(m r) --------------------------------
  // Abramowitz & Stegun 9.8.1 / 9.8.5 / 9.8.6, good to ~1e-5 relative.
  function I0(x: number) {
    const u = (x / 3.75) ** 2;
    return 1 + 3.5156229 * u + 3.0899424 * u ** 2 + 1.2067492 * u ** 3 +
      0.2659732 * u ** 4 + 0.0360768 * u ** 5 + 0.0045813 * u ** 6;
  }
  function K0(x: number) {
    if (x <= 2) {
      const t = (x / 2) ** 2;
      return -Math.log(x / 2) * I0(x) - 0.57721566 + 0.42278420 * t +
        0.23069756 * t ** 2 + 0.03488590 * t ** 3 + 0.00262698 * t ** 4 +
        0.00010750 * t ** 5 + 0.0000074 * t ** 6;
    }
    const t = 2 / x;
    return (Math.exp(-x) / Math.sqrt(x)) * (1.25331414 - 0.07832358 * t +
      0.02189568 * t ** 2 - 0.01062446 * t ** 3 + 0.00587872 * t ** 4 -
      0.00251540 * t ** 5 + 0.00053208 * t ** 6);
  }

  // --- canvas --------------------------------------------------------------
  const canvas = el('qf') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => {});
  const css = (v: string) => getComputedStyle(canvas).getPropertyValue(v).trim();
  const ink = () => css('--stage-ink') || '232,233,236';
  const ACC = [124, 140, 255], WARM = [245, 158, 11];
  const ACCs = '#7c8cff', WARMs = '#f59e0b';

  const FIELD = { x: 30, y: 64, s: 380 };
  const MODES = { x: 470, y: 64, s: 380 };
  const DISP = { x: 30, y: 528, w: 380, h: 104 };
  const CORR = { x: 470, y: 528, w: 380, h: 104 };
  const CELL = MODES.s / NK;

  const off = document.createElement('canvas');
  off.width = GRID;
  off.height = GRID;
  const offCtx = off.getContext('2d')!;
  const img = offCtx.createImageData(GRID, GRID);

  // e^{i n x} sampled on the render grid, shared by both axes
  const cosT = new Float64Array(NK * GRID), sinT = new Float64Array(NK * GRID);
  for (let n = 0; n < NK; n++)
    for (let g = 0; g < GRID; g++) {
      const v = (n - K) * ((g / GRID) * BOX);
      cosT[n * GRID + g] = Math.cos(v);
      sinT[n * GRID + g] = Math.sin(v);
    }
  const Cre = new Float64Array(NM), Cim = new Float64Array(NM);
  const Sre = new Float64Array(NK * GRID), Sim = new Float64Array(NK * GRID);
  const phi = new Float64Array(GRID * GRID);
  let fieldRms = 0;

  function label(text: string, x: number, y: number, alpha = 0.55, align: CanvasTextAlign = 'left', size = 12) {
    ctx.fillStyle = `rgba(${ink()},${alpha})`;
    ctx.font = `${size}px ui-monospace, monospace`;
    ctx.textAlign = align;
    ctx.fillText(text, x, y);
    ctx.textAlign = 'left';
  }

  /**
   * ⟨φ(x,y)⟩ = Re Σ_k A_k e^{i(k·x + θ_k − ω_k t)}, done as two 1D passes so the
   * cost is O(NK·GRID·NK + GRID²·NK) instead of O(GRID²·NK²).
   */
  function computeField() {
    for (let d = 0; d < NM; d++) {
      // the coherent state's mean field, amplitude ∝ √(⟨n⟩/ω)
      const A = Math.sqrt(occ[d] / omega[d]);
      const a = phase[d] - omega[d] * state.t;
      Cre[d] = A * Math.cos(a);
      Cim[d] = A * Math.sin(a);
      if (state.zp) {
        const z = noiseMag[d] * Math.sqrt(0.5 / omega[d]);
        const b = noisePhase[d] - omega[d] * state.t;
        Cre[d] += z * Math.cos(b);
        Cim[d] += z * Math.sin(b);
      }
    }
    for (let i = 0; i < NK; i++)
      for (let gy = 0; gy < GRID; gy++) {
        let re = 0, im = 0;
        for (let j = 0; j < NK; j++) {
          const d = j * NK + i;
          const cy = cosT[j * GRID + gy], sy = sinT[j * GRID + gy];
          re += Cre[d] * cy - Cim[d] * sy;
          im += Cre[d] * sy + Cim[d] * cy;
        }
        Sre[i * GRID + gy] = re;
        Sim[i * GRID + gy] = im;
      }
    let sum2 = 0;
    for (let gy = 0; gy < GRID; gy++)
      for (let gx = 0; gx < GRID; gx++) {
        let f = 0;
        for (let i = 0; i < NK; i++)
          f += Sre[i * GRID + gy] * cosT[i * GRID + gx] - Sim[i * GRID + gy] * sinT[i * GRID + gx];
        phi[gy * GRID + gx] = f;
        sum2 += f * f;
      }
    fieldRms = Math.sqrt(sum2 / (GRID * GRID));
  }

  function drawField() {
    // Fixed display gain per mode, so adding a quantum visibly brightens the
    // picture instead of being normalised away.
    const scale = state.zp ? 5 : 1.5;
    const px = img.data;
    for (let p = 0; p < GRID * GRID; p++) {
      const t = Math.tanh(phi[p] / scale);
      const c = t < 0 ? ACC : WARM;
      px[p * 4] = c[0];
      px[p * 4 + 1] = c[1];
      px[p * 4 + 2] = c[2];
      px[p * 4 + 3] = Math.min(255, Math.abs(t) * 255) | 0;
    }
    offCtx.putImageData(img, 0, 0);
    ctx.imageSmoothingEnabled = true;
    ctx.drawImage(off, FIELD.x, FIELD.y, FIELD.s, FIELD.s);
    ctx.strokeStyle = `rgba(${ink()},0.22)`;
    ctx.lineWidth = 1;
    ctx.strokeRect(FIELD.x, FIELD.y, FIELD.s, FIELD.s);
    label(state.zp ? 'THE FIELD  ⟨φ⟩ + vacuum sample' : 'THE MEAN FIELD  ⟨φ(x, y)⟩', FIELD.x, FIELD.y - 12, 0.5);
    label('one snapshot in space', FIELD.x + FIELD.s, FIELD.y - 12, 0.3, 'right');
  }

  function drawModes() {
    label('MOMENTUM SPACE  each cell is one oscillator', MODES.x, MODES.y - 12, 0.5);
    label('click to add ⟨n⟩ += 1', MODES.x + MODES.s, MODES.y - 12, 0.3, 'right');
    for (let d = 0; d < NM; d++) {
      const cx = MODES.x + (kx[d] + K) * CELL;
      const cy = MODES.y + (K - ky[d]) * CELL; // +ky drawn upward
      const n = occ[d];
      ctx.fillStyle = n > 0
        ? `rgba(${ACC[0]},${ACC[1]},${ACC[2]},${Math.min(0.95, 0.3 + 0.16 * n)})`
        : `rgba(${ink()},0.05)`;
      ctx.fillRect(cx + 1, cy + 1, CELL - 2, CELL - 2);
      if (n > 0) {
        ctx.fillStyle = 'rgba(10,11,14,0.9)';
        ctx.font = '600 12px ui-monospace, monospace';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(String(n), cx + CELL / 2, cy + CELL / 2);
        ctx.textBaseline = 'alphabetic';
        ctx.textAlign = 'left';
      }
      if (d === hoverMode) {
        ctx.strokeStyle = `rgba(${ink()},0.55)`;
        ctx.lineWidth = 1.5;
        ctx.strokeRect(cx + 1, cy + 1, CELL - 2, CELL - 2);
      }
    }
    // axes through k = 0
    ctx.strokeStyle = `rgba(${ink()},0.28)`;
    ctx.lineWidth = 1;
    const mid = MODES.x + K * CELL + CELL / 2, midY = MODES.y + K * CELL + CELL / 2;
    ctx.beginPath();
    ctx.moveTo(mid, MODES.y);
    ctx.lineTo(mid, MODES.y + MODES.s);
    ctx.moveTo(MODES.x, midY);
    ctx.lineTo(MODES.x + MODES.s, midY);
    ctx.stroke();
    ctx.strokeStyle = `rgba(${ink()},0.22)`;
    ctx.strokeRect(MODES.x, MODES.y, MODES.s, MODES.s);
    label('kx →', MODES.x + MODES.s - 4, midY - 6, 0.35, 'right', 11);
    label('ky ↑', mid + 6, MODES.y + 12, 0.35, 'left', 11);
    label('k = 0, a particle at rest', mid + 6, midY + 14, 0.3, 'left', 11);
  }

  function drawDispersion() {
    const KMAX = 8.6, WMAX = 10;
    const X = (k: number) => DISP.x + (k / KMAX) * DISP.w;
    const Y = (w: number) => DISP.y + DISP.h - (w / WMAX) * DISP.h;
    label('DISPERSION  ω(k) = √(k² + m²)', DISP.x, DISP.y - 12, 0.5);

    ctx.strokeStyle = `rgba(${ink()},0.25)`;
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(DISP.x, DISP.y + DISP.h);
    ctx.lineTo(DISP.x + DISP.w, DISP.y + DISP.h);
    ctx.moveTo(DISP.x, DISP.y);
    ctx.lineTo(DISP.x, DISP.y + DISP.h);
    ctx.stroke();

    // light cone ω = k, the massless limit
    ctx.setLineDash([4, 4]);
    ctx.strokeStyle = `rgba(${ink()},0.3)`;
    ctx.beginPath();
    ctx.moveTo(X(0), Y(0));
    ctx.lineTo(X(WMAX), Y(WMAX));
    ctx.stroke();
    ctx.setLineDash([]);

    ctx.strokeStyle = WARMs;
    ctx.lineWidth = 2;
    ctx.beginPath();
    for (let i = 0; i <= 120; i++) {
      const k = (KMAX * i) / 120;
      const w = Math.sqrt(k * k + state.m * state.m);
      i ? ctx.lineTo(X(k), Y(w)) : ctx.moveTo(X(k), Y(w));
    }
    ctx.stroke();

    // occupied modes sit on the curve
    ctx.fillStyle = ACCs;
    for (let d = 0; d < NM; d++) {
      if (!occ[d]) continue;
      ctx.beginPath();
      ctx.arc(X(kmag[d]), Y(omega[d]), 3.2, 0, Math.PI * 2);
      ctx.fill();
    }

    // the gap
    if (state.m > 0.05) {
      ctx.strokeStyle = `rgba(${ink()},0.5)`;
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(X(0), Y(0));
      ctx.lineTo(X(0), Y(state.m));
      ctx.stroke();
      label(`gap = m = ${state.m.toFixed(2)}`, X(0) + 8, Y(state.m) - 4, 0.6, 'left', 11);
    } else {
      label('no gap: massless', X(0) + 8, Y(0) - 8, 0.6, 'left', 11);
    }
    label('k', DISP.x + DISP.w, DISP.y + DISP.h + 15, 0.35, 'right', 11);
    label('ω', DISP.x - 6, DISP.y + 8, 0.35, 'right', 11);
  }

  function drawCorrelator() {
    label('REACH  ⟨φ(r) φ(0)⟩ ∝ K₀(m r), log scale', CORR.x, CORR.y - 12, 0.5);
    const RMAX = 6, DECADES = 4;
    const meff = Math.max(0.02, state.m);
    const g0 = K0(meff * 0.15);
    const X = (r: number) => CORR.x + (r / RMAX) * CORR.w;
    const Y = (g: number) => {
      const l = Math.log10(Math.max(1e-12, g / g0));
      return CORR.y + Math.min(CORR.h, (-l / DECADES) * CORR.h);
    };

    ctx.strokeStyle = `rgba(${ink()},0.25)`;
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(CORR.x, CORR.y + CORR.h);
    ctx.lineTo(CORR.x + CORR.w, CORR.y + CORR.h);
    ctx.moveTo(CORR.x, CORR.y);
    ctx.lineTo(CORR.x, CORR.y + CORR.h);
    ctx.stroke();

    ctx.strokeStyle = ACCs;
    ctx.lineWidth = 2;
    ctx.beginPath();
    for (let i = 0; i <= 160; i++) {
      const r = 0.15 + ((RMAX - 0.15) * i) / 160;
      const y = Y(K0(meff * r));
      i ? ctx.lineTo(X(r), y) : ctx.moveTo(X(r), y);
    }
    ctx.stroke();

    // the range 1/m
    if (state.m > 0.05 && 1 / state.m < RMAX) {
      const r = 1 / state.m;
      ctx.setLineDash([4, 4]);
      ctx.strokeStyle = WARMs;
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(X(r), CORR.y);
      ctx.lineTo(X(r), CORR.y + CORR.h);
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = WARMs;
      ctx.font = '11px ui-monospace, monospace';
      ctx.fillText(`1/m = ${r.toFixed(2)}`, X(r) + 5, CORR.y + 12);
    } else if (state.m <= 0.05) {
      label('massless: no range at all, it never stops', CORR.x + 10, CORR.y + 16, 0.5, 'left', 11);
    }
    label('distance r', CORR.x + CORR.w, CORR.y + CORR.h + 15, 0.35, 'right', 11);
    label('correlation', CORR.x + 4, CORR.y + CORR.h + 15, 0.35, 'left', 11);
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    drawField();
    drawModes();
    drawDispersion();
    drawCorrelator();
  }

  // --- readouts ------------------------------------------------------------
  const setEq = equation();
  const setResult = result();
  const setRows = readout();
  function updateReadout() {
    let N = 0, E = 0, px = 0, py = 0, vac = 0;
    for (let d = 0; d < NM; d++) {
      N += occ[d];
      E += occ[d] * omega[d];
      px += occ[d] * kx[d];
      py += occ[d] * ky[d];
      vac += omega[d] / 2;
    }
    const P = Math.hypot(px, py);
    const massless = state.m < 0.05;
    setRows({
      nq: String(N),
      en: E.toFixed(2),
      mom: P.toFixed(2),
      gap: massless ? '0 (massless)' : state.m.toFixed(2),
      range: massless ? 'unlimited' : (1 / state.m).toFixed(2),
      vg: lastMode < 0 ? '—' : `${(kmag[lastMode] / omega[lastMode]).toFixed(3)} c`,
      rms: fieldRms.toFixed(2),
      vac: `${vac.toFixed(0)} (set by the grid)`,
    });
    setResult({
      value: String(N),
      colour: ACCs,
      status: `energy Σ ⟨n⟩ω = ${E.toFixed(2)} · momentum |P| = ${P.toFixed(2)} · each quantum costs at least ${massless ? '0' : state.m.toFixed(2)}`,
      note: 'Each excited mode is in a coherent state: its mean field is a definite wave of amplitude ∝ √(⟨n⟩/ω), and the number of quanta is only known on average (Poisson spread √⟨n⟩). A state with exactly n quanta has zero mean field.',
    });
    setEq({
      rule: [
        ['\\langle\\phi_k\\rangle', ACCs],
        '\\propto\\sqrt{\\langle n_k\\rangle/\\omega_k}',
        '\\quad',
        ['\\omega_k = \\sqrt{k^2+m^2}', WARMs],
        '\\quad E = \\sum_k \\langle n_k\\rangle\\,\\omega_k',
      ],
      live: [
        `\\langle N\\rangle = ${N}`,
        [`\\quad E = ${E.toFixed(2)}`, ACCs],
        `\\quad |\\mathbf P| = ${P.toFixed(2)}`,
        [`\\quad m = ${massless ? '0' : state.m.toFixed(2)}`, WARMs],
      ],
    });
  }

  // --- loop ----------------------------------------------------------------
  let dirty = true;
  let last = performance.now();
  function frame(now: number) {
    const dt = Math.min(0.05, (now - last) / 1000);
    last = now;
    if (tp.running() && state.rate > 0) {
      state.t += dt * state.rate;
      dirty = true;
    }
    if (dirty) computeField();
    dirty = false;
    draw();
    updateReadout();
    requestAnimationFrame(frame);
  }

  // --- interaction ---------------------------------------------------------
  function modeAt(e: PointerEvent | MouseEvent) {
    const r = canvas.getBoundingClientRect();
    const sx = ((e.clientX - r.left) / r.width) * W;
    const sy = ((e.clientY - r.top) / r.height) * H;
    if (sx < MODES.x || sx > MODES.x + MODES.s || sy < MODES.y || sy > MODES.y + MODES.s) return -1;
    const i = Math.floor((sx - MODES.x) / CELL);
    const j = K - Math.floor((sy - MODES.y) / CELL) + K; // screen y is flipped
    if (i < 0 || i >= NK || j < 0 || j >= NK) return -1;
    return j * NK + i;
  }
  canvas.addEventListener('mousemove', (e) => (hoverMode = modeAt(e)));
  canvas.addEventListener('mouseleave', () => (hoverMode = -1));
  canvas.addEventListener('click', (e) => {
    const d = modeAt(e);
    if (d < 0) return;
    if (e.shiftKey) occ[d] = Math.max(0, occ[d] - 1);
    else occ[d]++;
    lastMode = d;
    dirty = true;
  });
  canvas.addEventListener('contextmenu', (e) => {
    const d = modeAt(e);
    if (d < 0) return;
    e.preventDefault();
    occ[d] = Math.max(0, occ[d] - 1);
    lastMode = d;
    dirty = true;
  });

  function clearModes() {
    occ.fill(0);
    lastMode = -1;
    resample();
    dirty = true;
  }
  const tp = transport({ onReset: clearModes });

  const setM = slider('m', (v) => { state.m = v; computeOmega(); dirty = true; }, (v) => v.toFixed(2));
  const setSp = slider('sp', (v) => { state.rate = v / 100; }, (v) => `${(v / 100).toFixed(1)}×`);
  const setZp = check('zp', (on) => { state.zp = on; dirty = true; });

  /** One mode, k = (nx, ny), holding n quanta on average. */
  const mode = (nx: number, ny: number) => (ny + K) * NK + (nx + K);
  function show(cells: [number, number, number][], o: { m?: number; zp?: boolean; run?: boolean } = {}) {
    clearModes();
    for (const [nx, ny, n] of cells) {
      occ[mode(nx, ny)] = n;
      lastMode = mode(nx, ny);
    }
    const m = o.m ?? 1;
    state.m = m; setM(m); computeOmega();
    state.rate = 1; setSp(100);
    state.zp = !!o.zp; setZp(state.zp);
    if (o.run) tp.setRunning(true);
    dirty = true;
  }
  tries({
    wave: () => show([[3, 1, 2]], { run: true }),
    steps: () => show([[2, 0, 6]]),
    massless: () => show([[1, 0, 2]], { m: 0 }),
    vacuum: () => show([[2, 1, 1]], { zp: true, run: true }),
  });

  computeOmega();
  requestAnimationFrame(frame);
</script>

