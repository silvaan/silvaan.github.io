---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Transport from '../../../components/sim/Transport.astro';
import Readout from '../../../components/sim/Readout.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="physics"
  title="General Relativity"
  description="Mass bends spacetime. The funnel is the real curved geometry of space around a black hole, the clocks show time running slow deep in the well, and the ruler shows a proper metre swallowing less and less coordinate distance as you fall towards the horizon."
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas id="gr" class="gr-canvas" width="700" height="640" role="img" aria-label="Flamm's paraboloid of the space around a black hole, with clocks ticking at different rates by depth, a probe ring, and a ruler laid along the radial direction."></canvas>
      </div>
      <Caption hint="Drag to orbit, scroll to zoom; the bright ring is the horizon, the white ring is your probe, and colour runs red (slow clocks) to teal (normal)" />
      <Result label="Clock rate at the probe" />
    </div>

    <div class="sim-panel">
      <Transport />
      <Seg
        id="show"
        label="Show"
        options={[
          { value: 'both', label: 'Clocks + ruler' },
          { value: 'clocks', label: 'Clocks' },
          { value: 'ruler', label: 'Ruler' },
        ]}
      />
      <Slider id="rs" label="Schwarzschild radius r<sub>s</sub>" min={6} max={45} value={20} display="2.0" />
      <Slider id="probe" label="Probe radius r" min={0} max={1000} value={250} display="4.0" />
      <Slider id="speed" label="Clock speed" min={0} max={40} value={10} display="1.0×" />
      <Readout
        title="Values"
        rows={[
          { id: 'ratioOut', label: 'r / r<sub>s</sub>' },
          { id: 'dilOut', label: 'Clock rate √(1−r<sub>s</sub>/r)' },
          { id: 'stretchOut', label: 'Ruler stretch 1/√(1−r<sub>s</sub>/r)' },
          { id: 'farOut', label: '1 s here = distant' },
          { id: 'realOut', label: 'Real distance from horizon' },
          { id: 'coordOut', label: 'Coordinate r − r<sub>s</sub>' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Run the clocks. The far ones keep pace, but each clock deeper in the well
      runs <b>slower</b>, at exactly √(1 − rₛ/r). <Try id="clocks" label="Run" />
    </li>
    <li>
      The blocks on the bottom bar are identical real metres placed by their r
      coordinate, so they <b>pile up near the horizon</b>: many real metres fit
      in a small change of r. <Try id="ruler" />
    </li>
    <li>
      Put the probe just outside <b>r = rₛ</b>: its clock almost freezes and the
      ruler stretch blows up, while far away both fade to 1. <Try id="horizon" />
    </li>
    <li>
      Grow <b>rₛ</b> (more mass) and the whole well deepens: the time dilation
      and the stretching reach farther out. <Try id="mass" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { el, segmented, slider, transport, readout, result, tries } from '../../../lib/panel';

  const TAU = Math.PI * 2;
  const RMAX = 10;
  const NORM = 2.0 / RMAX;
  const Y0 = 0.85; // vertical centring offset

  const setEq = equation();
  const setResult = result();
  const setRows = readout();
  const canvas = document.getElementById('gr') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const css = (v: string) => getComputedStyle(canvas).getPropertyValue(v).trim();
  const isLight = () => css('--stage-light') === '1';
  const ink = () => css('--stage-ink') || '232,233,236';

  const CX = W / 2, CY = H / 2;
  const CAM = 4.4, FOCAL = 2.7, SCALE = 250;

  const CLOCK_FR = [0.012, 0.05, 0.14, 0.34, 0.7, 1.0];
  const CLOCK_PHI = -Math.PI / 2;
  const RULER_PHI = Math.PI / 2;
  const RULER_UNIT = 1.15; // proper length per ruler segment

  const state = {
    rs: 2, probe: 4, speed: 1, show: 'both' as 'both' | 'clocks' | 'ruler',
    yaw: 0.62, pitch: -0.5, zoom: 1, running: false,
  };
  let T = 0;
  const clockTau = CLOCK_FR.map(() => 0);
  let probeTau = 0;
  let rulerTicks: number[] = [];

  const zDepth = (r: number) => 2 * Math.sqrt(state.rs * Math.max(0, r - state.rs));
  const dil = (r: number) => Math.sqrt(Math.max(0, 1 - state.rs / r));

  function world(r: number, phi: number) {
    const R = r * NORM;
    return { x: R * Math.cos(phi), y: zDepth(r) * NORM - Y0, z: R * Math.sin(phi) };
  }

  function project(p: { x: number; y: number; z: number }) {
    const cy = Math.cos(state.yaw), sy = Math.sin(state.yaw);
    const cp = Math.cos(state.pitch), sp = Math.sin(state.pitch);
    const x1 = p.x * cy + p.z * sy;
    const z1 = -p.x * sy + p.z * cy;
    const y2 = p.y * cp - z1 * sp;
    const z2 = p.y * sp + z1 * cp;
    const zc = z2 + CAM;
    const s = (FOCAL / Math.max(0.05, zc)) * state.zoom;
    return { sx: CX + x1 * s * SCALE, sy: CY - y2 * s * SCALE, s, zc };
  }
  const projRP = (r: number, phi: number) => project(world(r, phi));

  function dilColor(t: number, alpha = 1) {
    t = Math.max(0, Math.min(1, t));
    const stops = [[235, 80, 70], [240, 190, 70], [45, 212, 191]];
    const seg = t * 2;
    const i = Math.min(1, Math.floor(seg));
    const fr = seg - i;
    const a = stops[i], b = stops[i + 1];
    let r = a[0] + (b[0] - a[0]) * fr;
    let g = a[1] + (b[1] - a[1]) * fr;
    let bl = a[2] + (b[2] - a[2]) * fr;
    if (isLight()) { r *= 0.72; g *= 0.72; bl *= 0.72; }
    return `rgba(${r | 0},${g | 0},${bl | 0},${alpha})`;
  }

  function computeRulerTicks() {
    rulerTicks = [state.rs];
    let acc = 0, threshold = RULER_UNIT;
    const steps = 3000;
    const step = (RMAX - state.rs) / steps;
    for (let i = 1; i <= steps; i++) {
      const rm = state.rs + (i - 0.5) * step;
      acc += (1 / Math.sqrt(Math.max(1e-6, 1 - state.rs / rm))) * step;
      if (acc >= threshold) { rulerTicks.push(state.rs + i * step); threshold += RULER_UNIT; }
    }
  }

  // proper (real) radial distance from the horizon out to r
  function properDist(r: number) {
    if (r <= state.rs) return 0;
    const steps = 500;
    const step = (r - state.rs) / steps;
    let acc = 0;
    for (let i = 0; i < steps; i++) {
      const rm = state.rs + (i + 0.5) * step;
      acc += step / Math.sqrt(Math.max(1e-6, 1 - state.rs / rm));
    }
    return acc;
  }

  function ringPath(r: number) {
    ctx.beginPath();
    const N = 64;
    for (let i = 0; i <= N; i++) {
      const p = projRP(r, (i / N) * TAU);
      i === 0 ? ctx.moveTo(p.sx, p.sy) : ctx.lineTo(p.sx, p.sy);
    }
  }

  function drawFunnel() {
    // radial spokes
    ctx.lineWidth = 1;
    for (let k = 0; k < 24; k++) {
      const phi = (k / 24) * TAU;
      ctx.beginPath();
      for (let i = 0; i <= 40; i++) {
        const r = state.rs + ((RMAX - state.rs) * i) / 40;
        const p = projRP(r, phi);
        i === 0 ? ctx.moveTo(p.sx, p.sy) : ctx.lineTo(p.sx, p.sy);
      }
      ctx.strokeStyle = `rgba(${ink()},0.16)`;
      ctx.stroke();
    }
    // rings at equal coordinate r, coloured by clock rate
    const rings = 22;
    for (let k = 1; k <= rings; k++) {
      const r = state.rs + ((RMAX - state.rs) * k) / rings;
      ringPath(r);
      ctx.strokeStyle = dilColor(dil(r), isLight() ? 0.6 : 0.5);
      ctx.lineWidth = 1.2;
      ctx.stroke();
    }
    // event horizon (throat)
    ringPath(state.rs);
    ctx.fillStyle = isLight() ? 'rgba(20,20,26,0.9)' : 'rgba(0,0,0,0.92)';
    ctx.fill();
    ctx.strokeStyle = '#fbbf24';
    ctx.lineWidth = 2.6;
    ctx.stroke();
  }

  function billboardClock(sx: number, sy: number, radius: number, tau: number, r: number, label?: string) {
    ctx.beginPath();
    ctx.arc(sx, sy, radius, 0, TAU);
    ctx.fillStyle = isLight() ? 'rgba(255,255,255,0.92)' : 'rgba(10,11,15,0.9)';
    ctx.fill();
    ctx.strokeStyle = dilColor(dil(r));
    ctx.lineWidth = 2.2;
    ctx.stroke();
    // hand
    const ang = -tau * 1.7 - Math.PI / 2;
    ctx.beginPath();
    ctx.moveTo(sx, sy);
    ctx.lineTo(sx + Math.cos(ang) * radius * 0.82, sy + Math.sin(ang) * radius * 0.82);
    ctx.strokeStyle = `rgba(${ink()},1)`;
    ctx.lineWidth = Math.max(1.4, radius * 0.11);
    ctx.stroke();
    ctx.beginPath();
    ctx.arc(sx, sy, Math.max(1.5, radius * 0.12), 0, TAU);
    ctx.fillStyle = `rgba(${ink()},1)`;
    ctx.fill();
    if (label) {
      ctx.fillStyle = css('--text-faint') || '#8b93a5';
      ctx.font = "10px 'JetBrains Mono', monospace";
      ctx.textAlign = 'center';
      ctx.fillText(label, sx, sy + radius + 12);
      ctx.textAlign = 'left';
    }
  }

  function drawClocks() {
    const items = CLOCK_FR.map((fr, i) => {
      const r = state.rs + (RMAX - state.rs) * fr;
      const p = projRP(r, CLOCK_PHI);
      return { p, r, tau: clockTau[i] };
    }).sort((a, b) => b.p.zc - a.p.zc);
    for (const it of items) {
      if (it.p.zc <= 0.1) continue;
      billboardClock(it.p.sx, it.p.sy, Math.max(9, 15 * it.p.s), it.tau, it.r);
    }
  }

  const RULER_A = '#7c8cff';
  const RULER_B = '#2dd4bf';

  function drawRuler() {
    // identical proper-length rods laid along the funnel (real space)
    for (let i = 0; i < rulerTicks.length - 1; i++) {
      const rA = rulerTicks[i], rB = rulerTicks[i + 1];
      ctx.beginPath();
      const seg = 8;
      for (let j = 0; j <= seg; j++) {
        const r = rA + ((rB - rA) * j) / seg;
        const p = projRP(r, RULER_PHI);
        j === 0 ? ctx.moveTo(p.sx, p.sy) : ctx.lineTo(p.sx, p.sy);
      }
      ctx.strokeStyle = i % 2 === 0 ? RULER_A : RULER_B;
      ctx.lineWidth = 5;
      ctx.lineCap = 'butt';
      ctx.stroke();
    }
    drawRulerInset();
  }

  // Flat "coordinate map": the SAME identical 1-metre rods, but placed by their
  // r coordinate. Near the horizon a real metre spans little r, so the blocks
  // pile up there: that crowding is the radial stretching, made explicit.
  function drawRulerInset() {
    const x0 = 44, x1 = W - 26, yB = H - 40;
    const rA = state.rs, rB = RMAX;
    const xOf = (r: number) => x0 + ((r - rA) / (rB - rA)) * (x1 - x0);

    ctx.fillStyle = isLight() ? 'rgba(255,255,255,0.82)' : 'rgba(8,9,13,0.72)';
    ctx.fillRect(x0 - 16, yB - 40, x1 - x0 + 34, 66);

    ctx.fillStyle = css('--text-faint') || '#8b93a5';
    ctx.font = "11px 'JetBrains Mono', monospace";
    ctx.fillText('each block = 1 real metre · they crowd into little r near the mass', x0, yB - 26);

    // metre blocks (equal real length, unequal r footprint)
    for (let i = 0; i < rulerTicks.length - 1; i++) {
      const a = xOf(rulerTicks[i]);
      const b = xOf(rulerTicks[i + 1]);
      ctx.fillStyle = i % 2 === 0 ? RULER_A : RULER_B;
      ctx.fillRect(a, yB - 16, Math.max(0.7, b - a - 0.7), 15);
    }

    // coordinate axis + even integer ticks
    ctx.strokeStyle = `rgba(${ink()},0.45)`;
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(x0, yB);
    ctx.lineTo(x1, yB);
    ctx.stroke();
    ctx.fillStyle = css('--text-faint') || '#8b93a5';
    ctx.font = "10px 'JetBrains Mono', monospace";
    ctx.textAlign = 'center';
    for (let r = Math.ceil(rA + 1e-6); r <= rB; r++) {
      const x = xOf(r);
      ctx.beginPath();
      ctx.moveTo(x, yB);
      ctx.lineTo(x, yB + 5);
      ctx.stroke();
      ctx.fillText(String(r), x, yB + 16);
    }
    ctx.fillStyle = '#fbbf24';
    ctx.fillText('rₛ', xOf(rA), yB + 16);
    ctx.textAlign = 'left';

    // probe marker
    const px = Math.max(x0, Math.min(x1, xOf(state.probe)));
    ctx.strokeStyle = `rgba(${ink()},0.95)`;
    ctx.lineWidth = 1.6;
    ctx.beginPath();
    ctx.moveTo(px, yB - 20);
    ctx.lineTo(px, yB + 3);
    ctx.stroke();
  }

  function drawProbe() {
    ringPath(state.probe);
    ctx.strokeStyle = `rgba(${ink()},0.95)`;
    ctx.lineWidth = 2.4;
    ctx.stroke();
    const p = projRP(state.probe, CLOCK_PHI);
    if (p.zc > 0.1) billboardClock(p.sx, p.sy, Math.max(13, 22 * p.s), probeTau, state.probe, `r/rₛ = ${(state.probe / state.rs).toFixed(2)}`);
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    drawFunnel();
    if (state.show !== 'clocks') drawRuler();
    if (state.show !== 'ruler') drawClocks();
    drawProbe();

    const d = dil(state.probe);
    const k = 1 / Math.max(1e-3, d);
    const real = properDist(state.probe);
    setRows({
      ratioOut: (state.probe / state.rs).toFixed(2),
      dilOut: d.toFixed(3),
      stretchOut: k.toFixed(3),
      farOut: `${k.toFixed(2)} s`,
      realOut: `${real.toFixed(2)} m`,
      coordOut: (state.probe - state.rs).toFixed(2),
    });
    setResult({
      value: d.toFixed(3),
      colour: dilColor(d),
      status: `r = ${(state.probe / state.rs).toFixed(2)} rₛ · 1 s here is ${k.toFixed(2)} s far away · ${real.toFixed(2)} m to the horizon covers ${(state.probe - state.rs).toFixed(2)} in r`,
      note: 'Both effects come from one factor, √(1 − rₛ/r). At the horizon it goes to zero, so clocks there stop and the ruler blows up, yet nothing local goes wrong.',
    });
    setEq({
      rule: [
        ['\\dfrac{d\\tau}{dt} = \\sqrt{1-\\dfrac{r_s}{r}}', '#fbbf24'],
        '\\qquad',
        ['d\\ell = \\dfrac{dr}{\\sqrt{1-r_s/r}}', RULER_B],
      ],
      live: [
        `r/r_s = ${(state.probe / state.rs).toFixed(2)}`,
        [`\\quad d\\tau/dt = ${d.toFixed(3)}`, '#fbbf24'],
        [`\\quad d\\ell/dr = ${k.toFixed(3)}`, RULER_B],
      ],
    });
  }

  let last = 0;
  function loop(ts: number) {
    if (!last) last = ts;
    const dt = Math.min(0.05, (ts - last) / 1000);
    last = ts;
    if (state.running) {
      T += dt * state.speed;
      CLOCK_FR.forEach((fr, i) => {
        const r = state.rs + (RMAX - state.rs) * fr;
        clockTau[i] += dt * state.speed * dil(r);
      });
      probeTau += dt * state.speed * dil(state.probe);
    }
    draw();
    requestAnimationFrame(loop);
  }

  // ---- controls ----
  const probeLo = () => state.rs * 1.02;
  const probeOf = (v: number) => probeLo() + (v / 1000) * (RMAX - probeLo());
  const setRsSlider = slider('rs', (v) => {
    state.rs = v / 10;
    if (state.probe < probeLo()) state.probe = probeLo();
    computeRulerTicks();
    syncProbeSlider();
  }, (v) => (v / 10).toFixed(1));
  const setProbeSlider = slider('probe', (v) => { state.probe = probeOf(v); }, (v) => probeOf(v).toFixed(1));
  function syncProbeSlider() {
    const frac = (state.probe - probeLo()) / (RMAX - probeLo());
    setProbeSlider(Math.round(Math.max(0, Math.min(1, frac)) * 1000));
  }
  const setSpeedSlider = slider('speed', (v) => { state.speed = v / 10; }, (v) => (v / 10).toFixed(1) + '×');
  const shows = segmented('show', (v) => { state.show = v as typeof state.show; });
  const tp = transport({
    onRun: (on) => { state.running = on; },
    onReset: () => {
      T = 0;
      probeTau = 0;
      for (let i = 0; i < clockTau.length; i++) clockTau[i] = 0;
    },
  });

  function setup(o: { show: typeof state.show; rs: number; probeR: number; run?: boolean }) {
    state.show = o.show;
    shows.select(o.show);
    state.rs = o.rs;
    setRsSlider(Math.round(o.rs * 10));
    computeRulerTicks();
    state.probe = Math.max(probeLo(), Math.min(RMAX, o.probeR));
    syncProbeSlider();
    if (o.run && !tp.running()) el('run').click();
  }
  tries({
    clocks: () => {
      setup({ show: 'clocks', rs: 2, probeR: 6 });
      if (state.speed < 0.5) { state.speed = 1; setSpeedSlider(10); }
      if (!tp.running()) el('run').click();
    },
    ruler: () => setup({ show: 'ruler', rs: 2, probeR: 2.6 }),
    horizon: () => setup({ show: 'both', rs: 2, probeR: 2.04, run: true }),
    mass: () => setup({ show: 'both', rs: 4, probeR: 6 }),
  });

  // orbit + zoom
  let dragging = false, lx = 0, ly = 0;
  canvas.addEventListener('pointerdown', (e) => {
    dragging = true; lx = e.clientX; ly = e.clientY; canvas.setPointerCapture(e.pointerId);
  });
  canvas.addEventListener('pointermove', (e) => {
    if (!dragging) return;
    state.yaw += (e.clientX - lx) * 0.01;
    state.pitch = Math.max(-1.4, Math.min(0.2, state.pitch + (e.clientY - ly) * 0.01));
    lx = e.clientX; ly = e.clientY;
  });
  const stop = () => (dragging = false);
  canvas.addEventListener('pointerup', stop);
  canvas.addEventListener('pointercancel', stop);
  canvas.addEventListener('wheel', (e) => {
    e.preventDefault();
    state.zoom *= e.deltaY < 0 ? 1.1 : 1 / 1.1;
    state.zoom = Math.max(0.4, Math.min(4, state.zoom));
  }, { passive: false });

  computeRulerTicks();
  syncProbeSlider();
  requestAnimationFrame(loop);
</script>

<style>
  .gr-canvas {
    cursor: grab;
    touch-action: none;
  }
  .gr-canvas:active {
    cursor: grabbing;
  }
</style>
