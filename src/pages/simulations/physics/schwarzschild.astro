---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Transport from '../../../components/sim/Transport.astro';
import Actions from '../../../components/sim/Actions.astro';
import Readout from '../../../components/sim/Readout.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Try from '../../../components/sim/Try.astro';

const AMBER = '#f59e0b', SKY = '#38bdf8', VIOLET = '#c084fc', TEAL = '#2dd4bf';
---

<SimLayout
  areaSlug="physics"
  title="General Relativity"
  description="Mass changes the measure of time and of distance. Hang two clocks above a black hole, a neutron star or the Earth and the low one runs slow, so its light arrives stretched. Lay a ruler between two circles and it comes out longer than the circles allow: space itself is curved."
  shortcuts={['run', 'reset', 'fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="gt"
          width="1000"
          height="620"
          role="img"
          aria-label="Two clocks hovering at different heights above a mass, and a diagram of height against far-away time in which the lower clock sends a light flash upward at each of its ticks."
        ></canvas>
        <canvas
          id="gs"
          width="1000"
          height="620"
          role="img"
          aria-label="The curved space around a mass drawn as Flamm's paraboloid, with two circles and a ruler of equal rungs laid between them, beside the same ruler on a flat sheet, where it overshoots the outer circle."
          hidden
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'clocks', color: AMBER, id: 'lg-clock' },
          { label: 'light', color: SKY, id: 'lg-light' },
          { label: 'clock carried down', color: VIOLET, id: 'lg-twin' },
          { label: 'ruler', color: TEAL, id: 'lg-ruler' },
        ]}
        hint="Drag a clock up or down. The bow-ties are light cones: light from that point can only go inside them, and near the mass they flatten, so light barely climbs."
      />
      <Result label="Low clock, timed by the high clock" />
    </div>

    <div class="sim-panel">
      <Seg
        id="view"
        label="Show"
        attr="v"
        options={[
          { value: 'time', label: 'Time' },
          { value: 'space', label: 'Space' },
        ]}
      />
      <Seg
        id="mass"
        label="Mass"
        attr="m"
        active="bh"
        options={[
          { value: 'earth', label: 'Earth' },
          { value: 'sun', label: 'Sun' },
          { value: 'wd', label: 'White dwarf' },
          { value: 'ns', label: 'Neutron star' },
          { value: 'bh', label: 'Black hole' },
        ]}
      />
      <Slider id="r1" label="Lower radius r<sub>1</sub>" min={0} max={1000} value={33} display="1.25 rₛ" />
      <Slider id="r2" label="Upper radius r<sub>2</sub>" min={0} max={1000} value={713} display="6.00 rₛ" />
      <div id="time-ctl">
        <Transport running>
          <button type="button" class="btn ghost" id="twin">Carry a clock down</button>
        </Transport>
      </div>
      <div id="space-ctl" hidden>
        <Actions>
          <button type="button" class="btn" id="radar">Send a radar pulse</button>
        </Actions>
      </div>
      <Readout
        title="Numbers"
        rows={[
          { id: 'r-body', label: 'Mass' },
          { id: 'r-rs', label: 'Schwarzschild radius r<sub>s</sub> = 2GM/c²' },
          { id: 'r-r1', label: 'r<sub>1</sub>' },
          { id: 'r-r2', label: 'r<sub>2</sub>' },
          { id: 'r-rate1', label: 'Clock rate at r<sub>1</sub>, dτ/dt' },
          { id: 'r-rate2', label: 'Clock rate at r<sub>2</sub>, dτ/dt' },
          { id: 'r-day', label: 'Low clock falls behind, per day' },
          { id: 'r-dr', label: 'Δr = (C<sub>2</sub> − C<sub>1</sub>)/2π' },
          { id: 'r-ruler', label: 'Ruler distance r<sub>1</sub> to r<sub>2</sub>' },
          { id: 'r-radar', label: 'Radar echo, late against 2Δr/c' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Above a <b>black hole</b> the low clock ticks at about half the rate of the high one. Every flash
      takes the same time to climb, so they arrive two high ticks apart: light from below is redshifted.
      <Try id="redshift" />
    </li>
    <li>
      <b>Carry a clock down</b>, let it wait by the low clock and bring it back. It returns younger
      than the clock that stayed up, though it ticked normally the whole way. <Try id="twin" />
    </li>
    <li>
      In <b>Space</b>, a ruler laid between two circles needs more rungs than the gap their
      circumferences give. No flat sheet can do that: space is curved too, not just time.
      <Try id="ruler" />
    </li>
    <li>
      On <b>Earth</b>, a clock at GPS height gains 45.7 µs a day on the ground from gravity alone.
      Its orbital speed takes 7.2 back; uncorrected, the net 38.5 µs would shift a GPS fix by 11 km a day.
      <Try id="gps" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { Camera3D, orbitControls, type Vec } from '../../../lib/scene3d';
  import { el, segmented, slider, transport, result, readout, tries } from '../../../lib/panel';

  // --- the masses ----------------------------------------------------------
  // Everything real is in metres and seconds. The drawing works in units of
  // the drawn Schwarzschild radius u = X·rₛ with c = 1. For the Earth, the Sun
  // and the white dwarf the effects are parts per billion to parts per
  // thousand, so the picture shows the same radii around a mass X times
  // heavier (and says so); every number in the panel is for the real body.
  const G = 6.674e-11, C = 299792458, MSUN = 1.989e30, DAY = 86400;
  const rsOf = (M: number) => (2 * G * M) / (C * C);

  type Key = 'earth' | 'sun' | 'wd' | 'ns' | 'bh';
  interface Body {
    name: string;
    mass: string;
    rs: number; // real Schwarzschild radius, m
    R: number; // surface radius, m (0: no surface)
    X: number; // drawn mass / real mass
    lo: number; // slider range for r, m
    hi: number;
    d1: number; // default radii, m
    d2: number;
    rgb: [string, string]; // body colour, dark and light stage
    surface: string;
    short: string;
    floor: string;
  }
  const B: Record<Key, Body> = (() => {
    const re = 6.371e6, rsun = 6.957e8, rwd = 5.85e6;
    const sbh = rsOf(10 * MSUN), sns = rsOf(1.4 * MSUN);
    return {
      earth: {
        name: 'Earth', mass: '5.97×10²⁴ kg', rs: rsOf(5.972e24), R: re, X: 1.5e8,
        lo: re, hi: 4.5 * re, d1: re, d2: 2.656e7, rgb: ['96,165,250', '37,99,235'], surface: 'ground', short: 'Earth', floor: 'ground',
      },
      sun: {
        name: 'Sun', mass: '1 M☉ = 1.99×10³⁰ kg', rs: rsOf(MSUN), R: rsun, X: 5e4,
        lo: rsun, hi: 4.5 * rsun, d1: rsun, d2: 4 * rsun, rgb: ['251,191,36', '217,119,6'], surface: 'surface', short: 'Sun', floor: 'surface of the Sun',
      },
      wd: {
        name: 'White dwarf (Sirius B)', mass: '1.02 M☉', rs: rsOf(1.02 * MSUN), R: rwd, X: 400,
        lo: rwd, hi: 4.5 * rwd, d1: rwd, d2: 4 * rwd, rgb: ['241,245,249', '148,163,184'], surface: 'surface', short: 'Sirius B', floor: 'surface of Sirius B',
      },
      ns: {
        name: 'Neutron star', mass: '1.4 M☉', rs: sns, R: 1.0e4, X: 1,
        lo: 1.0e4, hi: 10 * sns, d1: 1.0e4, d2: 8 * sns, rgb: ['165,180,252', '79,70,229'], surface: 'surface', short: 'neutron star', floor: 'surface of the neutron star',
      },
      bh: {
        name: 'Black hole', mass: '10 M☉', rs: sbh, R: 0, X: 1,
        lo: 1.02 * sbh, hi: 8 * sbh, d1: 1.25 * sbh, d2: 6 * sbh, rgb: ['0,0,0', '0,0,0'], surface: 'horizon', short: 'black hole', floor: 'event horizon, r = rₛ',
      },
    };
  })();

  const state = {
    view: 'time' as 'time' | 'space',
    key: 'bh' as Key,
    r1: B.bh.d1,
    r2: B.bh.d2,
    running: true,
  };
  const body = () => B[state.key];
  const weak = () => body().X > 1;

  // --- real numbers (stable for rₛ/r ~ 10⁻⁹) ---------------------------------
  const rate = (r: number) => Math.sqrt(1 - body().rs / r);
  /** 1 − √(1 − rₛ/r) without cancelling. */
  const slow = (r: number) => body().rs / r / (1 + rate(r));
  /** Fraction of a high-clock second the low clock loses. */
  const lagFrac = (r1: number, r2: number) =>
    (body().rs / r1 - body().rs / r2) / (rate(r1) + rate(r2)) / rate(r2);
  /** Ruler distance minus Δr: ∫(1/√f − 1) dr with r = rₛ + u², which is smooth. */
  function rulerExtra(r1: number, r2: number) {
    const rs = body().rs, u1 = Math.sqrt(r1 - rs), u2 = Math.sqrt(r2 - rs), n = 400;
    const g = (u: number) => (2 * rs) / (Math.sqrt(rs + u * u) + u);
    const h = (u2 - u1) / n;
    let s = g(u1) + g(u2);
    for (let i = 1; i < n; i++) s += (i % 2 ? 4 : 2) * g(u1 + i * h);
    return (s * h) / 3;
  }
  /** Radar round trip at r₂ minus 2Δr/c, in metres of light travel. */
  function radarExtra(r1: number, r2: number) {
    const rs = body().rs;
    const lg = rs * Math.log((r2 - rs) / (r1 - rs));
    const T = r2 - r1 + lg;
    return 2 * (lg - slow(r2) * T);
  }

  // --- drawn geometry (units of u = X·rₛ, c = 1) -----------------------------
  const unit = () => body().X * body().rs;
  const rho = (r: number) => r / unit();
  const rhoBot = () => (body().R ? rho(body().R) : 1);
  const rhoTop = () => rho(body().hi);
  const fD = (p: number) => 1 - 1 / p;
  /** Proper radial distance, up to a constant. */
  const Dd = (p: number) => Math.sqrt(p * (p - 1)) + Math.log(Math.sqrt(p) + Math.sqrt(p - 1));
  /** Far-away time light needs to climb from p1 to p. */
  const climb = (p1: number, p: number) => p - p1 + Math.log((p - 1) / (p1 - 1));

  /** Increasing function inverse by bisection. */
  function invert(g: (p: number) => number, target: number, a: number, b: number) {
    for (let i = 0; i < 48; i++) {
      const m = (a + b) / 2;
      if (g(m) < target) a = m;
      else b = m;
    }
    return (a + b) / 2;
  }

  // --- formatting ----------------------------------------------------------
  const sig = (x: number, n = 3) =>
    Number(x.toPrecision(n)).toLocaleString('en-US', { maximumFractionDigits: 6 });
  const SUP: Record<string, string> = { '-': '⁻', '0': '⁰', '1': '¹', '2': '²', '3': '³', '4': '⁴', '5': '⁵', '6': '⁶', '7': '⁷', '8': '⁸', '9': '⁹' };
  function sciParts(x: number, d = 2) {
    const e = Math.floor(Math.log10(Math.abs(x)));
    let m = x / 10 ** e;
    if (+m.toFixed(d) >= 10) return { m: (m / 10).toFixed(d), e: e + 1 };
    return { m: m.toFixed(d), e };
  }
  const sci = (x: number, d = 2) => {
    const { m, e } = sciParts(x, d);
    return `${m}×10${String(e).replace(/./g, (c) => SUP[c] ?? c)}`;
  };
  const texSci = (x: number, d = 2) => {
    const { m, e } = sciParts(x, d);
    return `${m}\\times10^{${e}}`;
  };
  function fmtLen(m: number) {
    const a = Math.abs(m);
    if (a < 1e-3) return `${sig(m * 1e6)} µm`;
    if (a < 1) return `${sig(m * 1e3)} mm`;
    if (a < 1e3) return `${sig(m)} m`;
    if (a < 1e6) return `${sig(m / 1e3)} km`;
    if (a < 1e9) return `${Math.round(m / 1e3).toLocaleString('en-US')} km`;
    return `${sig(m / 1e9)} million km`;
  }
  function fmtDur(s: number) {
    const a = Math.abs(s);
    if (a < 1e-9) return `${sig(s * 1e12)} ps`;
    if (a < 1e-6) return `${sig(s * 1e9)} ns`;
    if (a < 1e-3) return `${sig(s * 1e6)} µs`;
    if (a < 1) return `${sig(s * 1e3)} ms`;
    if (a < 120) return `${sig(s)} s`;
    if (a < 7200) return `${sig(s / 60)} min`;
    return `${sig(s / 3600)} h`;
  }
  /** A clock rate: "0.447" when strong, "1 − 6.96×10⁻¹⁰" when weak. */
  const fmtRate = (r: number) => {
    const s = slow(r);
    return s < 1e-3 ? `1 − ${sci(s)}` : (1 - s).toFixed(3);
  };
  /** "1.5×10⁸ times heavier", "400 times heavier". */
  function heavier() {
    const X = body().X;
    if (X < 1e4) return `${X} times heavier`;
    const e = Math.floor(Math.log10(X)), m = +(X / 10 ** e).toFixed(1);
    const pow = `10${String(e).replace(/./g, (c) => SUP[c] ?? c)}`;
    return `${m === 1 ? '' : m + '×'}${pow} times heavier`;
  }
  /** Where a radius sits, for the panel. */
  function fmtR(r: number) {
    const b = body();
    if (!weak()) return `${(r / b.rs).toFixed(2)} rₛ`;
    const alt = r - b.R;
    return alt < 1 ? b.surface : `${fmtLen(alt)} up`;
  }

  // --- theme ---------------------------------------------------------------
  const PAL = {
    amber: ['245,158,11', '217,119,6'],
    sky: ['56,189,248', '2,132,199'],
    violet: ['192,132,252', '147,51,234'],
    teal: ['45,212,191', '13,148,136'],
    rose: ['251,113,133', '225,29,72'],
  };
  type PalKey = keyof typeof PAL;
  const theme = { light: false, ink: '232,233,236', inv: '13,14,18' };
  function readTheme(canvas: HTMLCanvasElement) {
    const cs = getComputedStyle(canvas);
    theme.light = cs.getPropertyValue('--stage-light').trim() === '1';
    theme.ink = cs.getPropertyValue('--stage-ink').trim() || '232,233,236';
    theme.inv = cs.getPropertyValue('--stage-ink-inv').trim() || '13,14,18';
  }
  const ink = (a: number) => `rgba(${theme.ink},${a})`;
  const inv = (a: number) => `rgba(${theme.inv},${a})`;
  const rgb = (k: PalKey) => PAL[k][theme.light ? 1 : 0];
  const col = (k: PalKey, a = 1) => `rgba(${rgb(k)},${a})`;
  const hex = (k: PalKey) => '#' + rgb(k).split(',').map((v) => (+v).toString(16).padStart(2, '0')).join('');
  const bodyRgb = () => body().rgb[theme.light ? 1 : 0];

  const W = 1000, H = 620;
  const cT = el('gt') as HTMLCanvasElement;
  const cS = el('gs') as HTMLCanvasElement;
  let dirtyT = true, dirtyS = true;
  const { ctx: xt } = setupCanvas(cT, () => { dirtyT = true; dirtyS = true; });
  const { ctx: xs } = setupCanvas(cS, () => { dirtyT = true; dirtyS = true; });
  const tT = makeText(xt, ink);
  const tS = makeText(xs, ink);

  function glowDot(ctx: CanvasRenderingContext2D, x: number, y: number, r: number, k: PalKey, a = 1) {
    const g = ctx.createRadialGradient(x, y, 0, x, y, r * 4);
    g.addColorStop(0, col(k, 0.55 * a));
    g.addColorStop(1, col(k, 0));
    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.arc(x, y, r * 4, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = theme.light ? col(k, a) : `rgba(255,255,255,${0.9 * a})`;
    ctx.beginPath();
    ctx.arc(x, y, r, 0, Math.PI * 2);
    ctx.fill();
    if (!theme.light) {
      ctx.strokeStyle = col(k, a);
      ctx.lineWidth = 1.5;
      ctx.stroke();
    }
  }

  function badge(ctx: CanvasRenderingContext2D, label: typeof tT.label) {
    if (!weak()) return;
    const b = body();
    label(`Drawn ${heavier()} so the effect shows. The numbers are for the real ${b.short}.`, 16, 24, 0.5, 'left', 9.5);
    void ctx;
  }

  // ===========================================================================
  // TIME: two hovering clocks, light flashes, and a clock carried down
  // ===========================================================================
  const TW = { x: 130, yTop: 86, yBot: 548 };
  const DG = { x0: 384, x1: 972 };
  const BETA = 0.3; // speed of the carried clock, as measured by the clocks it passes
  const tm = {
    t: 0, // far-away time, drawn units
    start: 0, // when the two clocks were (re)started
    viewStart: 0,
    span: 1, // width of the diagram in far-away time
    trip: null as null | { t0: number; down: number; hold: number; paused?: boolean },
  };

  const derived = () => {
    const p1 = rho(state.r1), p2 = rho(state.r2);
    const pb = rhoBot(), ph = rhoTop();
    const P = 0.45 * (ph - pb); // one tick of proper time
    return { p1, p2, pb, ph, P, a1: Math.sqrt(fD(p1)), a2: Math.sqrt(fD(p2)), T12: climb(p1, p2) };
  };
  let D = derived();
  const baseSpan = () => 16 * D.P;

  const yOf = (p: number) => TW.yBot - ((p - D.pb) / (D.ph - D.pb)) * (TW.yBot - TW.yTop);
  const pOf = (y: number) => D.pb + ((TW.yBot - y) / (TW.yBot - TW.yTop)) * (D.ph - D.pb);
  const left = () => Math.max(tm.viewStart, tm.t - 0.92 * tm.span);
  const xOf = (t: number) => DG.x0 + ((t - left()) / tm.span) * (DG.x1 - DG.x0);

  /** The carried clock: where it is and what it reads at far-away time t. */
  function tripAt(t: number) {
    const tr = tm.trip!;
    const k = Math.sqrt(1 - BETA * BETA) / BETA;
    const s = Math.min(t, tr.t0 + 2 * tr.down + tr.hold) - tr.t0;
    let p: number, tau: number, phase: 'down' | 'hold' | 'up' | 'done';
    if (s < tr.down) {
      // (p₂ − p) + ln((p₂−1)/(p−1)) = β s, decreasing in p
      p = invert((q) => -climb(q, D.p2), -BETA * s, D.p1, D.p2);
      tau = k * (Dd(D.p2) - Dd(p));
      phase = 'down';
    } else if (s < tr.down + tr.hold) {
      p = D.p1;
      tau = k * (Dd(D.p2) - Dd(D.p1)) + D.a1 * (s - tr.down);
      phase = 'hold';
    } else {
      const s2 = s - tr.down - tr.hold;
      p = invert((q) => climb(D.p1, q), BETA * s2, D.p1, D.p2);
      tau = k * (Dd(D.p2) - Dd(D.p1)) + D.a1 * tr.hold + k * (Dd(p) - Dd(D.p1));
      phase = t >= tr.t0 + 2 * tr.down + tr.hold ? 'done' : 'up';
    }
    return { p, tau, home: D.a2 * s, phase };
  }

  function restartClocks() {
    tm.start = tm.t;
    tm.viewStart = tm.t;
    tm.span = baseSpan();
    tm.trip = null;
    dirtyT = true;
  }

  function startTrip() {
    const down = D.T12 / BETA, hold = 4 * D.P;
    const total = 2 * down + hold;
    tm.trip = { t0: tm.t, down, hold };
    tm.span = Math.max(baseSpan(), total / 0.84);
    tm.viewStart = tm.t - 0.04 * tm.span;
    dirtyT = true;
  }

  function dial(x: number, y: number, r: number, turns: number, k: PalKey, glow: number) {
    const ctx = xt;
    if (glow > 0.01) {
      const g = ctx.createRadialGradient(x, y, r, x, y, r + 16);
      g.addColorStop(0, col('sky', 0.6 * glow));
      g.addColorStop(1, col('sky', 0));
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(x, y, r + 16, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.fillStyle = inv(0.94);
    ctx.strokeStyle = col(k);
    ctx.lineWidth = 2.4;
    ctx.beginPath();
    ctx.arc(x, y, r, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();
    ctx.strokeStyle = ink(0.35);
    ctx.lineWidth = 1;
    for (let i = 0; i < 12; i++) {
      const a = (i / 12) * Math.PI * 2;
      ctx.beginPath();
      ctx.moveTo(x + Math.cos(a) * r * 0.74, y + Math.sin(a) * r * 0.74);
      ctx.lineTo(x + Math.cos(a) * r * 0.88, y + Math.sin(a) * r * 0.88);
      ctx.stroke();
    }
    const a = -Math.PI / 2 + turns * Math.PI * 2;
    ctx.strokeStyle = ink(0.95);
    ctx.lineWidth = 2;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(x, y);
    ctx.lineTo(x + Math.cos(a) * r * 0.72, y + Math.sin(a) * r * 0.72);
    ctx.stroke();
    ctx.lineCap = 'butt';
    ctx.fillStyle = col(k);
    ctx.beginPath();
    ctx.arc(x, y, 2.6, 0, Math.PI * 2);
    ctx.fill();
  }

  /** Axis ticks for the height axis: r/rₛ when strong, altitude when weak. */
  function heightTicks() {
    const b = body();
    const out: { p: number; text: string }[] = [];
    if (!weak()) {
      const lo = b.R ? b.R / b.rs : 1, hi = b.hi / b.rs;
      const step = hi - lo > 8 ? 2 : 1;
      for (let v = Math.ceil(lo / step) * step; v <= hi + 1e-9; v += step) out.push({ p: rho(v * b.rs), text: String(v) });
      return { ticks: out, title: 'r / rₛ' };
    }
    const maxAlt = b.hi - b.R;
    const big = maxAlt > 1e8;
    const u = big ? 1e9 : 1e3;
    const raw = maxAlt / u / 5;
    const mag = 10 ** Math.floor(Math.log10(raw));
    const step = [1, 2, 2.5, 5, 10].map((m) => m * mag).find((s) => s >= raw)!;
    for (let v = 0; v * u <= maxAlt + 1; v += step)
      out.push({ p: rho(b.R + v * u), text: big ? String(+v.toFixed(2)) : Math.round(v).toLocaleString('en-US') });
    return { ticks: out, title: big ? 'altitude, million km' : 'altitude, km' };
  }

  function drawTime() {
    readTheme(cT);
    const ctx = xt, { label, textWidth } = tT;
    ctx.clearRect(0, 0, W, H);
    const b = body(), now = tm.t;
    const L = left(), Rt = L + tm.span;
    const y1 = yOf(D.p1), y2 = yOf(D.p2);
    const PX = DG.x1 - DG.x0;
    const pxPerP = (TW.yBot - TW.yTop) / (D.ph - D.pb);

    // ---- the mass below everything
    const bc = bodyRgb();
    const rad = D.pb * pxPerP;
    const cy = TW.yBot + rad;
    ctx.save();
    ctx.beginPath();
    ctx.rect(0, 0, DG.x0 - 70, H);
    ctx.clip();
    if (state.key === 'bh') {
      const g = ctx.createRadialGradient(TW.x, cy, rad, TW.x, cy, rad + 26);
      g.addColorStop(0, col('violet', theme.light ? 0.28 : 0.35));
      g.addColorStop(1, col('violet', 0));
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(TW.x, cy, rad + 26, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = theme.light ? '#111318' : '#000';
    } else {
      const g = ctx.createRadialGradient(TW.x - rad * 0.3, cy - rad * 0.7, rad * 0.1, TW.x, cy, rad);
      g.addColorStop(0, `rgba(${bc},${theme.light ? 0.55 : 0.75})`);
      g.addColorStop(1, `rgba(${bc},${theme.light ? 0.2 : 0.22})`);
      ctx.fillStyle = g;
    }
    ctx.beginPath();
    ctx.arc(TW.x, cy, rad, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();

    // ---- diagram frame: the floor band and the height grid
    ctx.fillStyle = state.key === 'bh' ? ink(0.06) : `rgba(${bc},0.10)`;
    ctx.fillRect(DG.x0, TW.yBot, PX, H - TW.yBot - 4);
    ctx.strokeStyle = state.key === 'bh' ? ink(0.5) : `rgba(${bc},0.8)`;
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(DG.x0, TW.yBot + 0.5);
    ctx.lineTo(DG.x1, TW.yBot + 0.5);
    ctx.stroke();
    label(b.floor, DG.x0 + 6, TW.yBot + 22, 0.55, 'left', 9.5);
    label('far-away time t →', DG.x1, TW.yBot + 46, 0.5, 'right', 9.5);

    const { ticks, title } = heightTicks();
    ctx.lineWidth = 1;
    for (const tk of ticks) {
      const y = Math.round(yOf(tk.p)) + 0.5;
      if (y > TW.yBot - 2) { label(tk.text, DG.x0 - 10, y + 4, 0.45, 'right', 9); continue; }
      ctx.strokeStyle = ink(0.06);
      ctx.beginPath();
      ctx.moveTo(DG.x0, y);
      ctx.lineTo(DG.x1, y);
      ctx.stroke();
      label(tk.text, DG.x0 - 10, y + 4, 0.45, 'right', 9);
    }
    label(title, DG.x0 - 10, TW.yTop - 34, 0.5, 'right', 9);
    ctx.strokeStyle = ink(0.25);
    ctx.beginPath();
    ctx.moveTo(DG.x0 + 0.5, TW.yTop - 20);
    ctx.lineTo(DG.x0 + 0.5, TW.yBot);
    ctx.stroke();

    // ---- light cones: fixed in the picture, because the geometry never changes.
    // Each is the pair of directions light can take from that point, up and down.
    const pxPerT = PX / tm.span;
    for (let i = 0; i < 5; i++) {
      const p = D.pb + (D.ph - D.pb) * (0.1 + (i / 4) * 0.8);
      const y = yOf(p);
      if (Math.abs(y - y1) < 16 || Math.abs(y - y2) < 16) continue;
      const m = fD(p) * (pxPerP / pxPerT);
      const len = 15, n = Math.hypot(1, m);
      const dx = len / n, dy = (len * m) / n;
      for (let j = 0; j < 4; j++) {
        const x = DG.x0 + 74 + j * 150 + (i % 2) * 75;
        if (x + dx > DG.x1 - 4) continue;
        ctx.fillStyle = col('sky', theme.light ? 0.13 : 0.11);
        ctx.strokeStyle = col('sky', theme.light ? 0.4 : 0.32);
        ctx.lineWidth = 1;
        for (const sgn of [1, -1]) {
          ctx.beginPath();
          ctx.moveTo(x, y);
          ctx.lineTo(x + sgn * dx, y - dy);
          ctx.lineTo(x + sgn * dx, y + dy);
          ctx.closePath();
          ctx.fill();
          ctx.beginPath();
          ctx.moveTo(x + sgn * dx, y - dy);
          ctx.lineTo(x - sgn * dx, y + dy);
          ctx.stroke();
        }
      }
    }

    ctx.save();
    ctx.beginPath();
    ctx.rect(DG.x0, 0, PX + 2, H);
    ctx.clip();

    // ---- the two static clocks: worldlines with a bead per tick
    const tA = Math.max(tm.start, L);
    for (const [y, a] of [[y1, D.a1], [y2, D.a2]] as [number, number][]) {
      ctx.strokeStyle = col('amber', 0.85);
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(xOf(tA), y);
      ctx.lineTo(xOf(now), y);
      ctx.stroke();
      const dt = D.P / a;
      const k0 = Math.max(0, Math.ceil((L - tm.start) / dt));
      for (let k = k0; tm.start + k * dt <= now; k++) {
        ctx.fillStyle = col('amber');
        ctx.beginPath();
        ctx.arc(xOf(tm.start + k * dt), y, k % 5 ? 3 : 4.4, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    // ---- flashes: one per tick of the low clock, each the same curve shifted in t
    const dtLow = D.P / D.a1;
    const heads: number[] = [];
    let lastArr: number[] = [];
    {
      const k0 = Math.max(0, Math.ceil((L - D.T12 - tm.start) / dtLow));
      for (let k = k0; tm.start + k * dtLow <= now; k++) {
        const te = tm.start + k * dtLow;
        ctx.strokeStyle = col('sky', 0.8);
        ctx.lineWidth = 1.6;
        ctx.beginPath();
        let first = true;
        const N = 56;
        for (let i = 0; i <= N; i++) {
          // geometric in (p − 1), so the slow start near the mass gets the samples
          const p = 1 + (D.p1 - 1) * ((D.p2 - 1) / (D.p1 - 1)) ** (i / N);
          const t = te + climb(D.p1, p);
          if (t > now) {
            const ph = invert((q) => climb(D.p1, q), now - te, D.p1, D.p2);
            ctx.lineTo(xOf(now), yOf(ph));
            heads.push(ph);
            break;
          }
          if (first) { ctx.moveTo(xOf(t), yOf(p)); first = false; }
          else ctx.lineTo(xOf(t), yOf(p));
        }
        ctx.stroke();
        const ta = te + D.T12;
        if (ta <= now) {
          lastArr.push(ta);
          ctx.strokeStyle = col('sky');
          ctx.fillStyle = inv(1);
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.arc(xOf(ta), y2, 6.5, 0, Math.PI * 2);
          ctx.fill();
          ctx.stroke();
          ctx.fillStyle = col('amber');
        }
      }
      for (const ph of heads) glowDot(ctx, xOf(now), yOf(ph), 3, 'sky');
    }
    // redraw the high beads over the arrival rings, so both read
    {
      const dt = D.P / D.a2;
      const k0 = Math.max(0, Math.ceil((L - tm.start) / dt));
      for (let k = k0; tm.start + k * dt <= now; k++) {
        ctx.fillStyle = col('amber');
        ctx.beginPath();
        ctx.arc(xOf(tm.start + k * dt), y2, k % 5 ? 2.6 : 3.6, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    // ---- the carried clock
    let trip: ReturnType<typeof tripAt> | null = null;
    if (tm.trip) {
      const tr = tm.trip;
      trip = tripAt(now);
      const end = Math.min(now, tr.t0 + 2 * tr.down + tr.hold);
      ctx.strokeStyle = col('violet');
      ctx.lineWidth = 2.6;
      ctx.lineJoin = 'round';
      ctx.beginPath();
      const N = 70;
      let started = false;
      const put = (t: number, p: number) => {
        if (t > end) return false;
        if (!started) { ctx.moveTo(xOf(t), yOf(p)); started = true; }
        else ctx.lineTo(xOf(t), yOf(p));
        return true;
      };
      let ok = true;
      for (let i = 0; i <= N && ok; i++) {
        const p = 1 + (D.p2 - 1) * ((D.p1 - 1) / (D.p2 - 1)) ** (i / N);
        ok = put(tr.t0 + climb(p, D.p2) / BETA, p);
      }
      if (ok) ok = put(tr.t0 + tr.down + tr.hold, D.p1);
      for (let i = 0; i <= N && ok; i++) {
        const p = 1 + (D.p1 - 1) * ((D.p2 - 1) / (D.p1 - 1)) ** (i / N);
        ok = put(tr.t0 + tr.down + tr.hold + climb(D.p1, p) / BETA, p);
      }
      ctx.lineTo(xOf(end), yOf(trip.p));
      ctx.stroke();
      // its own ticks along the way
      const k = Math.sqrt(1 - BETA * BETA) / BETA;
      const tauDown = k * (Dd(D.p2) - Dd(D.p1));
      for (let n = 1; n * D.P <= trip.tau; n++) {
        const tau = n * D.P;
        let t: number, p: number;
        if (tau < tauDown) {
          p = invert(Dd, Dd(D.p2) - tau / k, D.p1, D.p2);
          t = tr.t0 + climb(p, D.p2) / BETA;
        } else if (tau < tauDown + D.a1 * tr.hold) {
          p = D.p1;
          t = tr.t0 + tr.down + (tau - tauDown) / D.a1;
        } else {
          const rest = tau - tauDown - D.a1 * tr.hold;
          p = invert((q) => Dd(q), Dd(D.p1) + rest / k, D.p1, D.p2);
          t = tr.t0 + tr.down + tr.hold + climb(D.p1, p) / BETA;
        }
        ctx.fillStyle = col('violet');
        ctx.beginPath();
        ctx.arc(xOf(t), yOf(p), n % 5 ? 2.6 : 3.8, 0, Math.PI * 2);
        ctx.fill();
      }
      if (trip.phase === 'done') {
        if (!tm.trip.paused) { tm.trip.paused = true; state.running = false; tp.setRunning(false); }
        const xe = xOf(end);
        ctx.strokeStyle = col('violet', 0.9);
        ctx.fillStyle = inv(1);
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(xe, y2, 8, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
      }
    }
    ctx.restore();

    // ---- now
    const xn = xOf(now);
    ctx.strokeStyle = ink(0.28);
    ctx.setLineDash([3, 5]);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(xn + 0.5, TW.yTop - 20);
    ctx.lineTo(xn + 0.5, TW.yBot);
    ctx.stroke();
    ctx.setLineDash([]);
    label('now', xn, TW.yTop - 28, 0.5, 'center', 9);

    // the stretch, written once two flashes are in
    if (lastArr.length >= 2) {
      const a = lastArr[lastArr.length - 2], c = lastArr[lastArr.length - 1];
      const xa = xOf(a), xc = xOf(c);
      const per = (D.a2 / D.a1).toFixed(2);
      const txt = `flashes arrive ${per} high ticks apart`;
      const tw = textWidth(txt, 9);
      const yb = y2 - 15;
      if (xa > DG.x0 && xc - xa > 14) {
        ctx.strokeStyle = col('sky', 0.8);
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        ctx.moveTo(xa, yb + 5);
        ctx.lineTo(xa, yb);
        ctx.lineTo(xc, yb);
        ctx.lineTo(xc, yb + 5);
        ctx.stroke();
        let lx = (xa + xc) / 2;
        lx = Math.max(DG.x0 + tw / 2 + 4, Math.min(DG.x1 - tw / 2, lx));
        ctx.fillStyle = inv(0.8);
        ctx.fillRect(lx - tw / 2 - 4, yb - 19, tw + 8, 16);
        label(txt, lx, yb - 6, 1, 'center', 9, col('sky'));
      }
    }

    // ---- the tower: mast, light climbing it, and the clock faces
    ctx.strokeStyle = ink(0.16);
    ctx.setLineDash([2, 5]);
    ctx.beginPath();
    ctx.moveTo(TW.x + 0.5, TW.yTop - 24);
    ctx.lineTo(TW.x + 0.5, TW.yBot);
    ctx.stroke();
    ctx.setLineDash([]);
    // dotted guides from the clocks to their worldlines
    ctx.strokeStyle = col('amber', 0.25);
    ctx.setLineDash([2, 6]);
    for (const y of [y1, y2]) {
      ctx.beginPath();
      ctx.moveTo(TW.x + 22, y);
      ctx.lineTo(DG.x0, y);
      ctx.stroke();
    }
    ctx.setLineDash([]);
    for (const ph of heads) {
      const y = yOf(ph);
      if (y < y1 - 20 && y > y2 + 20) glowDot(ctx, TW.x, y, 3.2, 'sky');
    }

    const el1 = (now - tm.start) * D.a1, el2 = (now - tm.start) * D.a2;
    const sinceArr = lastArr.length ? (now - lastArr[lastArr.length - 1]) * D.a2 / D.P : 9;
    const sinceEmit = (el1 / D.P) % 1;
    dial(TW.x, y2, 18, el2 / D.P, 'amber', Math.max(0, 1 - sinceArr * 3));
    dial(TW.x, y1, 18, el1 / D.P, 'amber', heads.length || el1 > 0 ? Math.max(0, 1 - sinceEmit * 3) : 0);
    const name = (txt: string, y: number, n: number) => {
      label(txt, TW.x + 28, y - 3, 1, 'left', 10, col('amber'));
      label(`${Math.floor(n)} tick${Math.floor(n) === 1 ? "" : "s"}`, TW.x + 28, y + 15, 0.7, "left", 9.5);
    };
    name('high clock', y2, el2 / D.P);
    name('low clock', y1, el1 / D.P);

    if (trip) {
      const y = yOf(trip.p), x = 54;
      dial(x, y, 15, trip.tau / D.P, 'violet', 0);
      label('carried', x, y - 23, 1, 'center', 9, col('violet'));
      label(`${(trip.tau / D.P).toFixed(1)}`, x, y + 31, 0.8, 'center', 9.5);
      if (trip.phase === 'done') {
        label(`stayed: ${(trip.home / D.P).toFixed(1)}`, TW.x + 28, y2 + 33, 0.7, 'left', 9.5, col('amber'));
      }
    }

    badge(ctx, label);
  }

  // ===========================================================================
  // SPACE: Flamm's paraboloid, a ruler between two circles, and a flat sheet
  // ===========================================================================
  const cam = new Camera3D(640, H + 30, { dist: 4.6, yaw: 0.55, pitch: -0.78, zoom: 0.98 });
  orbitControls(cS, cam, W, H, { changed: () => { dirtyS = true; } });
  /** The ruler's azimuth, from the camera: wherever it looks longest on screen, on the left. */
  const phiR = () => {
    let best = 0, bestLen = -1;
    for (let j = 0; j < 90; j++) {
      const phi = (j / 90) * Math.PI * 2;
      const a = cam.project(wpt(D.p1, phi)), b = cam.project(wpt(D.p2, phi));
      const len = Math.hypot(b.sx - a.sx, b.sy - a.sy) - (b.sx > a.sx ? 1e3 : 0);
      if (len > bestLen) { bestLen = len; best = phi; }
    }
    return best;
  };
  const sw = () => 1.5 / D.ph;

  /** Embedding height of the curved space: outside 2√(p − 1), inside a uniform star a spherical cap. */
  function zEmb(p: number) {
    const pb = D.pb;
    if (state.key === 'bh' || p >= pb) return 2 * Math.sqrt(Math.max(0, p - 1));
    const a = Math.sqrt(pb ** 3);
    return 2 * Math.sqrt(pb - 1) - a * Math.sqrt(1 - (p * p) / (a * a)) + a * Math.sqrt(1 - (pb * pb) / (a * a));
  }
  const zTop = () => zEmb(D.ph);
  function wpt(p: number, phi: number, lift = 0): Vec {
    const s = sw();
    return { x: p * s * Math.cos(phi), y: (zEmb(p) - zTop()) * s + 0.62 + lift, z: p * s * Math.sin(phi) };
  }

  type Item = { z: number; draw: () => void };
  const radar = { on: false, s: 0, done: false };

  function rungs() {
    const ell = (D.ph - D.pb) / 26; // proper length of one rung, drawn units
    const d1 = Dd(D.p1), d2 = Dd(D.p2);
    const n = (d2 - d1) / ell;
    const pts = [D.p1];
    for (let k = 1; k < n; k++) pts.push(invert(Dd, d1 + k * ell, D.p1, D.p2));
    pts.push(D.p2);
    return { ell, n, pts, gap: (D.p2 - D.p1) / ell, D: d2 - d1 };
  }

  function drawSpace() {
    readTheme(cS);
    const ctx = xs, { label } = tS;
    ctx.clearRect(0, 0, W, H);
    const items: Item[] = [];
    const proj = (v: Vec) => cam.project(v);

    // ---- the surface
    const rings: number[] = [];
    if (state.key === 'bh') {
      for (let i = 0; i <= 40; i++) rings.push(1 + (D.ph - 1) * (i / 40) ** 2);
    } else {
      for (let i = 0; i <= 9; i++) rings.push((D.pb * i) / 9);
      for (let i = 1; i <= 34; i++) rings.push(D.pb + (D.ph - D.pb) * (i / 34) ** 1.5);
    }
    const NS = 72;
    const L = { x: -0.35, y: 0.9, z: 0.25 };
    const ln = Math.hypot(L.x, L.y, L.z);
    const base = theme.light ? [84, 98, 230] : [124, 140, 255];
    const bg = theme.light ? [255, 255, 255] : [13, 14, 18];
    const bcol = bodyRgb().split(',').map(Number);
    const grid: Vec[] = [];
    for (let i = 0; i < rings.length; i++) for (let j = 0; j < NS; j++) grid.push(wpt(rings[i], (j / NS) * Math.PI * 2));
    const P2 = grid.map(proj);
    for (let i = 0; i < rings.length - 1; i++) {
      const inside = state.key !== 'bh' && rings[i + 1] <= D.pb + 1e-9;
      for (let j = 0; j < NS; j++) {
        const j2 = (j + 1) % NS;
        const a = grid[i * NS + j], b = grid[i * NS + j2], c = grid[(i + 1) * NS + j2], d = grid[(i + 1) * NS + j];
        const pa = P2[i * NS + j], pb = P2[i * NS + j2], pc = P2[(i + 1) * NS + j2], pd = P2[(i + 1) * NS + j];
        // normal from the diagonals, which stays good where a ring shrinks to a point
        const ux = c.x - a.x, uy = c.y - a.y, uz = c.z - a.z;
        const vx = b.x - d.x, vy = b.y - d.y, vz = b.z - d.z;
        let nx = uy * vz - uz * vy, ny = uz * vx - ux * vz, nz = ux * vy - uy * vx;
        const nn = Math.hypot(nx, ny, nz) || 1;
        nx /= nn; ny /= nn; nz /= nn;
        const lam = Math.abs(nx * L.x + ny * L.y + nz * L.z) / ln;
        const mixc = inside ? (theme.light ? 0.35 + 0.35 * lam : 0.3 + 0.45 * lam) : (theme.light ? 0.07 + 0.2 * lam : 0.1 + 0.3 * lam);
        const src = inside ? (state.key === 'bh' ? base : bcol) : base;
        const fill = `rgb(${src.map((v, q) => Math.round(bg[q] + (v - bg[q]) * mixc)).join(',')})`;
        const z = (pa.zc + pb.zc + pc.zc + pd.zc) / 4;
        items.push({
          z,
          draw: () => {
            ctx.fillStyle = fill;
            ctx.strokeStyle = fill;
            ctx.lineWidth = 0.8;
            ctx.beginPath();
            ctx.moveTo(pa.sx, pa.sy);
            ctx.lineTo(pb.sx, pb.sy);
            ctx.lineTo(pc.sx, pc.sy);
            ctx.lineTo(pd.sx, pd.sy);
            ctx.closePath();
            ctx.fill();
            ctx.stroke();
          },
        });
      }
    }
    // coordinate grid: rings at equal steps of r, and spokes
    const seg = (a: Vec, b: Vec, style: () => void, bias = 0.05) => {
      const pa = proj(a), pb = proj(b);
      items.push({
        z: (pa.zc + pb.zc) / 2 - bias,
        draw: () => {
          style();
          ctx.beginPath();
          ctx.moveTo(pa.sx, pa.sy);
          ctx.lineTo(pb.sx, pb.sy);
          ctx.stroke();
        },
      });
    };
    const gridStyle = () => { ctx.strokeStyle = ink(theme.light ? 0.16 : 0.13); ctx.lineWidth = 1; };
    for (let k = 1; k < 14; k++) {
      const p = D.pb + ((D.ph - D.pb) * k) / 14;
      for (let j = 0; j < NS; j++) seg(wpt(p, (j / NS) * Math.PI * 2), wpt(p, ((j + 1) / NS) * Math.PI * 2), gridStyle);
    }
    for (let s = 0; s < 12; s++) {
      const phi = (s / 12) * Math.PI * 2;
      for (let i = 0; i < rings.length - 1; i++) {
        if (rings[i + 1] < D.pb - 1e-9) continue;
        seg(wpt(rings[i], phi), wpt(rings[i + 1], phi), gridStyle);
      }
    }
    // the horizon or the surface
    const rimStyle = () => {
      ctx.strokeStyle = state.key === 'bh' ? ink(0.7) : `rgba(${bodyRgb()},0.95)`;
      ctx.lineWidth = 2;
    };
    for (let j = 0; j < NS; j++) seg(wpt(D.pb, (j / NS) * Math.PI * 2), wpt(D.pb, ((j + 1) / NS) * Math.PI * 2), rimStyle, 0.1);
    // the two circles
    const circStyle = () => { ctx.strokeStyle = ink(0.92); ctx.lineWidth = 2.4; };
    for (const p of [D.p1, D.p2])
      for (let j = 0; j < 96; j++)
        seg(wpt(p, (j / 96) * Math.PI * 2, 0.004), wpt(p, ((j + 1) / 96) * Math.PI * 2, 0.004), circStyle, 0.12);

    const PHI_R = phiR();
    const ru = rungs();

    // radar pulse, beside the ruler
    let pulse: number | null = null;
    if (radar.on || radar.done) {
      const r = radarState();
      pulse = r.p;
    }

    items.sort((a, b) => b.z - a.z);
    for (const it of items) it.draw();

    // ---- the ruler, drawn over the sheet: equal rungs of proper length down the wall
    const scr = (p: number, lift = 0.006) => proj(wpt(p, PHI_R, lift));
    // the straight reference: Δr laid flat, level with C₂, ending where the ruler ends
    let dashMid = { x: 0, y: 0 };
    {
      const top = (p: number) => {
        const q = wpt(p, PHI_R, 0.006);
        return proj({ x: q.x, y: wpt(D.p2, PHI_R, 0.006).y, z: q.z });
      };
      const A = top(D.p1), Bp = scr(D.p2), S = scr(D.p1);
      ctx.strokeStyle = ink(0.35);
      ctx.lineWidth = 1;
      ctx.setLineDash([2, 4]);
      ctx.beginPath();
      ctx.moveTo(S.sx, S.sy);
      ctx.lineTo(A.sx, A.sy);
      ctx.stroke();
      ctx.strokeStyle = ink(0.75);
      ctx.lineWidth = 2;
      ctx.setLineDash([7, 5]);
      ctx.beginPath();
      ctx.moveTo(A.sx, A.sy);
      ctx.lineTo(Bp.sx, Bp.sy);
      ctx.stroke();
      ctx.setLineDash([]);
      // a tick every rung length along it
      const len = Math.hypot(Bp.sx - A.sx, Bp.sy - A.sy) || 1;
      const nx = -(Bp.sy - A.sy) / len, ny = (Bp.sx - A.sx) / len;
      ctx.lineWidth = 1.2;
      for (let k = 0; k <= ru.gap + 1e-9; k++) {
        const t = top(D.p1 + k * ru.ell);
        ctx.beginPath();
        ctx.moveTo(t.sx - nx * 4, t.sy - ny * 4);
        ctx.lineTo(t.sx + nx * 4, t.sy + ny * 4);
        ctx.stroke();
      }
      dashMid = { x: (A.sx + Bp.sx) / 2, y: (A.sy + Bp.sy) / 2 };
    }
    for (let k = 0; k < ru.pts.length - 1; k++) {
      const a = ru.pts[k], b = ru.pts[k + 1];
      const pts = [0, 0.2, 0.4, 0.6, 0.8, 1].map((f) => scr(a + (b - a) * f));
      const w = Math.max(5, 9 * pts[2].s);
      const path = () => {
        ctx.beginPath();
        pts.forEach((q, i) => (i ? ctx.lineTo(q.sx, q.sy) : ctx.moveTo(q.sx, q.sy)));
      };
      ctx.lineCap = 'butt';
      ctx.strokeStyle = inv(0.85);
      ctx.lineWidth = w + 3;
      path();
      ctx.stroke();
      ctx.strokeStyle = k % 2 ? col('teal', 0.5) : col('teal');
      ctx.lineWidth = w;
      path();
      ctx.stroke();
    }
    if (pulse !== null && radar.on) {
      const q = proj(wpt(pulse, PHI_R + 0.08, 0.01));
      glowDot(ctx, q.sx, q.sy, 3.4, 'sky');
    }

    // ---- labels on the curved sheet
    const rightmost = (p: number) => {
      let best = proj(wpt(p, 0));
      for (let j = 1; j < 48; j++) {
        const q = proj(wpt(p, (j / 48) * Math.PI * 2));
        if (q.sx > best.sx) best = q;
      }
      return best;
    };
    const l1 = rightmost(D.p1), l2 = rightmost(D.p2);
    label('C₁ = 2πr₁', l1.sx + 8, l1.sy + 4, 0.85, 'left', 9.5);
    label('C₂ = 2πr₂', Math.min(l2.sx + 8, 560), l2.sy + 4, 0.85, 'left', 9.5);
    {
      // the two counts, on either side of the ruler's chord on screen, clear of both lines
      const S = proj(wpt(D.p1, PHI_R, 0.006)), E = proj(wpt(D.p2, PHI_R, 0.006));
      const cl = Math.hypot(E.sx - S.sx, E.sy - S.sy) || 1;
      const nx = -(E.sy - S.sy) / cl, ny = (E.sx - S.sx) / cl;
      const cm = { x: (S.sx + E.sx) / 2, y: (S.sy + E.sy) / 2 };
      const side = (dashMid.x - cm.x) * nx + (dashMid.y - cm.y) * ny >= 0 ? 1 : -1;
      const tag = (txt: string, x: number, y: number, sgn: number, colour: string, alpha: number) => {
        const tw = tS.textWidth(txt, 9.5);
        const off = 16 + Math.abs(nx) * (tw / 2 + 4) + Math.abs(ny) * 9;
        const lx = Math.max(tw / 2 + 8, Math.min(630 - tw / 2, x + sgn * nx * off));
        const ly = y + sgn * ny * off;
        ctx.fillStyle = inv(0.78);
        ctx.fillRect(lx - tw / 2 - 4, ly - 12, tw + 8, 17);
        label(txt, lx, ly + 1, alpha, 'center', 9.5, colour);
      };
      const mid = proj(wpt(invert(Dd, Dd(D.p1) + ru.D / 2, D.p1, D.p2), PHI_R, 0.006));
      tag(`ruler: ${ru.n.toFixed(1)} rungs`, mid.sx, mid.sy, -side, col('teal'), 1);
      tag(`Δr flat: ${ru.gap.toFixed(1)} rungs`, dashMid.x, dashMid.y, side, ink(0.85), 0.85);
    }
    label("the curved space around the mass (Flamm's paraboloid)", 18, H - 16, 0.5, 'left', 9);

    // ---- the flat sheet on the right
    const FX0 = 652;
    ctx.strokeStyle = ink(0.1);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(FX0 - 12.5, 46);
    ctx.lineTo(FX0 - 12.5, H - 30);
    ctx.stroke();
    const cxF = 816, cyF = 352, RM = 158;
    const reach = D.p1 + ru.D;
    const sf = RM / reach;
    label('the same ruler on a flat sheet', cxF, 72, 0.6, 'center', 10);
    // body
    if (state.key === 'bh') ctx.fillStyle = theme.light ? '#111318' : '#000';
    else ctx.fillStyle = `rgba(${bodyRgb()},${theme.light ? 0.4 : 0.5})`;
    ctx.beginPath();
    ctx.arc(cxF, cyF, D.pb * sf, 0, Math.PI * 2);
    ctx.fill();
    if (state.key === 'bh') {
      ctx.strokeStyle = ink(0.5);
      ctx.lineWidth = 1;
      ctx.stroke();
    }
    ctx.strokeStyle = ink(0.92);
    ctx.lineWidth = 2;
    for (const p of [D.p1, D.p2]) {
      ctx.beginPath();
      ctx.arc(cxF, cyF, p * sf, 0, Math.PI * 2);
      ctx.stroke();
    }
    const ang = Math.PI * 0.8;
    label('C₁', cxF + Math.cos(ang) * D.p1 * sf - 6, cyF + Math.sin(ang) * D.p1 * sf + 16, 0.8, 'right', 9.5);
    label('C₂', cxF + Math.cos(ang) * D.p2 * sf - 6, cyF + Math.sin(ang) * D.p2 * sf + 16, 0.8, 'right', 9.5);
    // rungs, straight up from C₁
    const fy = (p: number) => cyF - p * sf;
    for (let k = 0; k < Math.ceil(ru.n); k++) {
      const a = D.p1 + k * ru.ell, b = Math.min(D.p1 + (k + 1) * ru.ell, reach);
      const over = a >= D.p2 - 1e-9;
      ctx.strokeStyle = over ? col('rose', k % 2 ? 0.55 : 1) : col('teal', k % 2 ? 0.55 : 1);
      ctx.lineWidth = 7;
      ctx.beginPath();
      ctx.moveTo(cxF, fy(a));
      ctx.lineTo(cxF, fy(b));
      ctx.stroke();
      if (!over && b > D.p2) {
        ctx.strokeStyle = col('rose', k % 2 ? 0.55 : 1);
        ctx.beginPath();
        ctx.moveTo(cxF, fy(D.p2));
        ctx.lineTo(cxF, fy(b));
        ctx.stroke();
      }
    }
    // bracket on the overshoot
    const yA = fy(D.p2), yB = fy(reach);
    if (yA - yB > 2) {
      ctx.strokeStyle = col('rose', 0.9);
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      ctx.moveTo(cxF + 9, yA);
      ctx.lineTo(cxF + 14, yA);
      ctx.lineTo(cxF + 14, yB);
      ctx.lineTo(cxF + 9, yB);
      ctx.stroke();
      const extra = ru.n - ru.gap;
      label(`${extra.toFixed(1)} rungs past C₂`, cxF + 20, (yA + yB) / 2 + 4, 1, 'left', 9.5, col('rose'));
    }
    // flat radar ghost
    if (radar.on || radar.done) {
      const r = radarState();
      if (radar.on && r.flatP !== null) glowDot(ctx, cxF - 14, fy(r.flatP), 3, 'sky', 0.7);
    }
    const lx = FX0, ly = H - 70;
    label(`gap from the circles  Δr = ${ru.gap.toFixed(1)} rungs`, lx, ly, 0.75, 'left', 9.5);
    label(`laid along the ruler  ${ru.n.toFixed(1)} rungs`, lx, ly + 20, 1, 'left', 9.5, col('teal'));
    if (radar.on || radar.done) {
      const r = radarState();
      const txt = radar.done
        ? `radar echo: ${r.ratio.toFixed(2)}× the flat-space time 2Δr/c`
        : r.flatBack ? 'flat-space echo is back; the real one is not' : 'radar pulse on its way';
      label(txt, lx, ly + 40, 1, 'left', 9.5, col('sky'));
    }

    badge(ctx, label);
  }

  /** The radar pulse, in the proper time σ of the clock at r₂ that sends it. */
  function radarState() {
    const sigReal = 2 * D.a2 * D.T12, sigFlat = 2 * (D.p2 - D.p1);
    const s = radar.s;
    const t = s / D.a2; // far-away time since sending
    let p: number | null = null;
    if (t < D.T12) p = invert((q) => -climb(q, D.p2), -t, D.p1, D.p2);
    else if (t < 2 * D.T12) p = invert((q) => climb(D.p1, q), t - D.T12, D.p1, D.p2);
    let flatP: number | null = null;
    if (s < sigFlat / 2) flatP = D.p2 - s;
    else if (s < sigFlat) flatP = D.p1 + (s - sigFlat / 2);
    return { p, flatP, flatBack: s >= sigFlat, ratio: sigReal / sigFlat, total: sigReal };
  }

  // ===========================================================================
  // words, numbers, equation
  // ===========================================================================
  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  function sync() {
    const b = body();
    const AM = hex('amber'), TE = hex('teal');
    const s1 = slow(state.r1);
    const x1 = state.r1 / b.rs;
    const rateTex = s1 < 1e-3 ? `1 - ${texSci(s1)}` : (1 - s1).toFixed(3);
    const strTex = s1 < 1e-3 ? `1 + ${texSci(s1 / (1 - s1))}` : (1 / (1 - s1)).toFixed(3);
    setEq({
      rule: [
        'ds^2 =',
        ['-\\left(1-\\frac{r_s}{r}\\right)c^2\\,dt^2', AM],
        ['+\\,\\dfrac{dr^2}{1-r_s/r}', TE],
        '+\\,r^2\\,d\\Omega^2',
      ],
      live: [
        `r_1 = ${x1 > 999 ? texSci(x1) : x1.toFixed(2)}\\,r_s`,
        [`\\quad d\\tau/dt = ${rateTex}`, AM],
        [`\\quad d\\ell/dr = ${strTex}`, TE],
      ],
    });

    const lag = lagFrac(state.r1, state.r2);
    const extra = rulerExtra(state.r1, state.r2);
    const dr = state.r2 - state.r1;
    const echo = radarExtra(state.r1, state.r2) / C;
    setRows({
      'r-body': `${b.name}, ${b.mass}`,
      'r-rs': fmtLen(b.rs),
      'r-r1': weak() ? `${fmtLen(state.r1)} (${fmtR(state.r1)})` : `${fmtR(state.r1)} = ${fmtLen(state.r1)}`,
      'r-r2': weak() ? `${fmtLen(state.r2)} (${fmtR(state.r2)})` : `${fmtR(state.r2)} = ${fmtLen(state.r2)}`,
      'r-rate1': fmtRate(state.r1),
      'r-rate2': fmtRate(state.r2),
      'r-day': fmtDur(lag * DAY),
      'r-dr': fmtLen(dr),
      'r-ruler': weak() ? `Δr + ${fmtLen(extra)}` : `${fmtLen(dr + extra)} = ${((dr + extra) / dr).toFixed(3)} Δr`,
      'r-radar': fmtDur(echo),
    });

    if (state.view === 'time') syncTimeResult(lag);
    else syncSpaceResult(extra, dr, echo);
  }

  const isGps = () => state.key === 'earth' && Math.abs(state.r2 - 2.656e7) < 2.5e5 && state.r1 - B.earth.R < 2e4;

  function syncTimeResult(lag: number) {
    const b = body();
    const ratio = D.a1 / D.a2;
    const realRatio = 1 - lag;
    if (tm.trip) {
      const tr = tripAt(tm.t);
      const tt = tr.tau / D.P, th = tr.home / D.P;
      el('result-label').textContent = 'Clock carried down, against the one that stayed';
      const phase = { down: 'on its way down', hold: 'waiting by the low clock', up: 'climbing back', done: 'back home' }[tr.phase];
      setResult({
        value: `${tt.toFixed(1)} vs ${th.toFixed(1)} ticks`,
        colour: hex('violet'),
        status: tr.phase === 'done'
          ? `Back home and ${(th - tt).toFixed(1)} ticks younger: ${((100 * (th - tt)) / th).toFixed(0)}% less time went by for it`
          : `${phase[0].toUpperCase()}${phase.slice(1)}`,
        note: weak()
          ? `Drawn ${heavier()}. For the real ${b.short}, every day a clock spends at r₁ instead of r₂ leaves it ${fmtDur(lag * DAY)} behind.`
          : 'Neither clock ever ran oddly where it was. Between the same parting and meeting, the path that dips towards the mass simply contains less time.',
      });
      return;
    }
    el('result-label').textContent = 'Low clock, timed by the high clock';
    if (!weak()) {
      setResult({
        value: ratio.toFixed(3),
        colour: hex('amber'),
        status: `Flashes sent once a tick arrive every ${(1 / ratio).toFixed(2)} high ticks · far away, the rates are ${D.a1.toFixed(3)} and ${D.a2.toFixed(3)}`,
        note: 'Every flash takes the same far-away time to climb, so the flashes arrive as far apart as they left. The high clock ticks faster and counts more of its own ticks in between: the low clock runs slow, and its light arrives redshifted.',
      });
      return;
    }
    let note = `Pound and Rebka measured this redshift in 1959 over a 22.5 m tower: 2.5×10⁻¹⁵. Here the ratio is 1 − ${sci(lag)}.`;
    if (state.key === 'earth' && isGps()) {
      const sr = (b.rs / (4 * state.r2)) * DAY;
      note = `GPS satellites orbit at ${fmtLen(state.r2 - b.R)} and ${(Math.sqrt((G * 5.972e24) / state.r2) / 1000).toFixed(1)} km/s. Speed slows them by ${fmtDur(sr)} a day, so they gain ${fmtDur(lag * DAY - sr)} net, and are built to tick slow by exactly that.`;
    } else if (state.key === 'sun') note = `Sunlight leaves the surface redshifted by 1 − ${sci(slow(b.R))}, seen in the solar spectrum as a 0.6 km/s shift.`;
    else if (state.key === 'wd') note = `Light from the surface of Sirius B arrives redshifted as if it were receding at ${(slow(b.R) * C / 1000).toFixed(0)} km/s; astronomers measure about 80.`;
    setResult({
      value: `−${fmtDur(lag * DAY)} / day`,
      colour: hex('amber'),
      status: `Rate ratio 1 − ${sci(lag)} · its flashes arrive stretched by the same factor`,
      note,
    });
  }


  function syncSpaceResult(extra: number, dr: number, echo: number) {
    const b = body();
    el('result-label').textContent = 'Ruler distance from r₁ to r₂';
    if (!weak()) {
      setResult({
        value: `${((dr + extra) / dr).toFixed(2)} × Δr`,
        colour: hex('teal'),
        status: `Ruler ${((dr + extra) / b.rs).toFixed(2)} rₛ = ${fmtLen(dr + extra)}; the circumferences give Δr = ${(dr / b.rs).toFixed(2)} rₛ = ${fmtLen(dr)}`,
        note: `Two circles of circumference C₁ and C₂ would be Δr = (C₂ − C₁)/2π apart on a flat sheet. The ruler says farther, so space itself is curved. A radar echo from r₁ comes back ${fmtDur(echo)} later than 2Δr/c.`,
      });
      return;
    }
    setResult({
      value: `Δr + ${fmtLen(extra)}`,
      colour: hex('teal'),
      status: `Δr = ${fmtLen(dr)} from the circumferences · a radar echo is ${fmtDur(echo)} late`,
      note: `Tiny, but real: the radar delay is the Shapiro effect, measured with echoes off Venus and Mercury as they passed behind the Sun. Drawn ${heavier()}.`,
    });
  }

  // ===========================================================================
  // controls
  // ===========================================================================
  const fmtSlider = (r: number) => fmtR(r);
  const toV = (r: number) => Math.round(((r - body().lo) / (body().hi - body().lo)) * 1000);
  const toR = (v: number) => body().lo + ((body().hi - body().lo) * v) / 1000;
  const GAP = () => 0.09 * (body().hi - body().lo);

  const set1 = slider('r1', (v) => setR1(toR(v)), (v) => fmtSlider(toR(v)));
  const set2 = slider('r2', (v) => setR2(toR(v)), (v) => fmtSlider(toR(v)));
  function setR1(r: number) {
    state.r1 = Math.max(body().lo, Math.min(r, state.r2 - GAP()));
    set1(toV(state.r1));
    configChanged();
  }
  function setR2(r: number) {
    state.r2 = Math.min(body().hi, Math.max(r, state.r1 + GAP()));
    set2(toV(state.r2));
    configChanged();
  }
  function configChanged() {
    D = derived();
    restartClocks();
    radar.on = false;
    radar.done = false;
    dirtyS = true;
    sync();
  }

  const views = segmented('view', (v) => setView(v as 'time' | 'space'));
  function setView(v: 'time' | 'space') {
    state.view = v;
    views.select(v);
    cT.hidden = v !== 'time';
    cS.hidden = v !== 'space';
    el('time-ctl').hidden = v !== 'time';
    el('space-ctl').hidden = v !== 'space';
    for (const id of ['lg-clock', 'lg-twin']) el(id).style.display = v === 'time' ? '' : 'none';
    el('lg-ruler').style.display = v === 'space' ? '' : 'none';
    el('scene-hint').textContent = v === 'time'
      ? 'Drag a clock up or down. The bow-ties are light cones: light from that point can only go inside them, and near the mass they flatten, so light barely climbs.'
      : 'Drag to turn the sheet, scroll to zoom. The faint rings are equal steps of r: near the mass one rung spans fewer of them.';
    dirtyT = dirtyS = true;
    sync();
  }

  const masses = segmented('mass', (k) => setMass(k as Key));
  function setMass(k: Key, r1?: number, r2?: number) {
    state.key = k;
    masses.select(k);
    const b = body();
    state.r1 = r1 ?? b.d1;
    state.r2 = r2 ?? b.d2;
    set1(toV(state.r1));
    set2(toV(state.r2));
    configChanged();
  }

  const tp = transport({
    onRun: (on) => { state.running = on; },
    onReset: () => { tm.t = 0; restartClocks(); sync(); },
  });
  const run = () => { state.running = true; tp.setRunning(true); };

  el('twin').addEventListener('click', () => { startTrip(); run(); sync(); });
  el('radar').addEventListener('click', () => {
    radar.on = true;
    radar.done = false;
    radar.s = 0;
    dirtyS = true;
  });

  // drag the clocks
  let dragging: 0 | 1 | 2 = 0;
  const local = (e: PointerEvent) => {
    const r = cT.getBoundingClientRect();
    return { x: ((e.clientX - r.left) / r.width) * W, y: ((e.clientY - r.top) / r.height) * H };
  };
  const pick = (y: number) => {
    const d1 = Math.abs(y - yOf(D.p1)), d2 = Math.abs(y - yOf(D.p2));
    if (Math.min(d1, d2) > 22) return 0;
    return d1 < d2 ? 1 : 2;
  };
  cT.addEventListener('pointerdown', (e) => {
    const p = local(e);
    dragging = pick(p.y);
    if (dragging) cT.setPointerCapture(e.pointerId);
  });
  cT.addEventListener('pointermove', (e) => {
    const p = local(e);
    if (!dragging) {
      cT.style.cursor = pick(p.y) ? 'ns-resize' : 'default';
      return;
    }
    const r = pOf(p.y) * unit();
    if (dragging === 1) setR1(r);
    else setR2(r);
  });
  const drop = () => { dragging = 0; };
  cT.addEventListener('pointerup', drop);
  cT.addEventListener('pointercancel', drop);

  tries({
    redshift: () => {
      setView('time');
      setMass('bh');
      run();
    },
    twin: () => {
      setView('time');
      if (state.key !== 'bh' && state.key !== 'ns') setMass('bh');
      startTrip();
      run();
      sync();
    },
    ruler: () => {
      setView('space');
      setMass('bh', 1.05 * B.bh.rs, 4 * B.bh.rs);
    },
    gps: () => {
      setView('time');
      setMass('earth', B.earth.R, 2.656e7);
      run();
    },
  });

  // --- the loop --------------------------------------------------------------
  let last = 0, lastSync = 0;
  function frame(ts: number) {
    const dt = last ? Math.min(0.05, (ts - last) / 1000) : 0;
    last = ts;
    if (state.view === 'time') {
      if (state.running) {
        tm.t += dt * 1.15 * D.P;
        dirtyT = true;
      }
      if (dirtyT) {
        drawTime();
        dirtyT = false;
        if (ts - lastSync > 120) { sync(); lastSync = ts; }
      }
    } else {
      if (radar.on) {
        const r = radarState();
        radar.s += dt * (D.p2 - D.p1) / 1.6;
        if (radar.s >= r.total) { radar.s = r.total; radar.on = false; radar.done = true; }
        dirtyS = true;
      }
      if (dirtyS) {
        drawSpace();
        dirtyS = false;
      }
    }
    requestAnimationFrame(frame);
  }

  set1(toV(state.r1));
  set2(toV(state.r2));
  configChanged();
  setView('time');
  requestAnimationFrame(frame);
</script>

<style>
  :global(#gt[hidden]),
  :global(#gs[hidden]),
  :global(#time-ctl[hidden]),
  :global(#space-ctl[hidden]) {
    display: none !important;
  }
  #gs {
    cursor: grab;
    touch-action: none;
  }
  #gs:active {
    cursor: grabbing;
  }
  #gt {
    touch-action: none;
  }
</style>
