---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Checks from '../../../components/sim/Checks.astro';
import Transport from '../../../components/sim/Transport.astro';
import Readout from '../../../components/sim/Readout.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Try from '../../../components/sim/Try.astro';

const E_COLOR = '#60a5fa', B_COLOR = '#f87171';
---

<SimLayout
  areaSlug="physics"
  title="Electromagnetic Waves"
  description="Shake a charge and watch its field ripple outward as a glowing shell, at the speed the medium allows. Build a dipole antenna to see its radiation glow as a doughnut round the wire, with E and B turning transverse in 3D, or switch to statics for the Coulomb field lines of fixed charges and the magnetic circles round a wire."
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas id="em3d" class="em-canvas" width="820" height="720" role="img" aria-label="Charges in three dimensions with the electric and magnetic fields they make: arrows on a plane or through a volume for radiating charges, field lines for static charges and a current-carrying wire."></canvas>
      </div>
      <Caption
        legend={[
          { label: 'electric field E', color: E_COLOR },
          { label: 'magnetic field B', color: B_COLOR },
          { label: 'field strength √(εE² + B²/μ)', color: '#a78bfa', id: 'lg-heat' },
        ]}
        hint="Drag a charge to move it · drag empty space to orbit · scroll to zoom"
      />
      <Result label="Wave speed in this medium" />
    </div>

    <div class="sim-panel">
      <Seg
        id="scene"
        label="Scene"
        attr="s"
        options={[
          { value: 'charge', label: 'Free charge' },
          { value: 'dipole', label: 'Dipole antenna' },
          { value: 'statics', label: 'Statics' },
        ]}
      />
      <Transport step running>
        <button type="button" class="btn ghost" id="shake">Shake</button>
        <button type="button" class="btn ghost" id="newq" hidden>New charges</button>
        <button type="button" class="btn ghost" id="flip" hidden>Flip current</button>
      </Transport>
      <Seg
        id="field"
        label="Show"
        options={[
          { value: 'e', label: 'E' },
          { value: 'b', label: 'B' },
          { value: 'both', label: 'E + B' },
          { value: 'off', label: 'Off' },
        ]}
      />
      <div id="view-wrap">
        <Seg
          id="view"
          label="Field strength"
          options={[
            { value: 'both', label: 'Fog + plane' },
            { value: 'plane', label: 'Plane' },
            { value: 'fog', label: 'Fog' },
            { value: 'off', label: 'Off' },
          ]}
        />
        <div id="fogop-wrap">
          <Slider id="fogop" label="Fog opacity" min={0.2} max={3} step={0.05} value={1} display="1.00" hint={['thin', 'dense']} />
        </div>
      </div>
      <div id="layout-wrap">
        <Seg
          id="layout"
          label="Arrows"
          options={[
            { value: 'plane', label: 'On a plane' },
            { value: 'volume', label: 'Volume (3D)' },
          ]}
        />
      </div>
      <div id="plane-wrap">
        <Seg
          id="plane"
          label="Plane"
          options={[
            { value: 'xy', label: 'XY' },
            { value: 'xz', label: 'XZ' },
            { value: 'yz', label: 'YZ' },
          ]}
        />
        <Slider id="offset" label="Plane offset" min={-6} max={6} step={0.1} value={0} display="0.0" />
      </div>
      <Slider id="density" label="Density" min={1} max={8} step={1} value={4} display="15 × 15" />
      <div id="look-wrap">
        <Checks items={[{ id: 'fronts', label: 'Wavefronts', checked: true }]} />
      </div>
      <Slider id="eps" label="Permittivity ε<sub>r</sub>" min={1} max={80} step={0.1} value={1} display="1.0" />
      <Slider id="mu" label="Permeability μ<sub>r</sub>" min={1} max={10} step={0.1} value={1} display="1.0" />
      <Slider id="sigma" label="Loss σ" min={0} max={2} step={0.02} value={0} display="0.00" />
      <div id="freq-wrap">
        <Slider id="freq" label="Antenna frequency f" min={0.1} max={1.5} step={0.05} value={0.55} display="0.55" />
      </div>
      <Readout
        rows={[
          { id: 'nOut', label: 'n = √(ε<sub>r</sub> μ<sub>r</sub>)' },
          { id: 'vOut', label: 'v = c / n' },
          { id: 'etaOut', label: 'η = η<sub>0</sub> √(μ<sub>r</sub> / ε<sub>r</sub>)' },
          { id: 'lambdaOut', label: 'λ = v / f' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      <b>Shake</b> the charge and a glowing shell races outward at the wave speed: the
      charge <b>radiates</b>. Held still, its field just stands there, because
      only acceleration makes waves. <Try id="jiggle" label="Shake it" />
    </li>
    <li>
      The dipole antenna's radiation glows as a <b>doughnut</b>, dark along the
      antenna's own axis, with shells half a wavelength apart streaming outward.
      Far out, E, B and the direction of travel are all at right angles: the
      wave is <b>transverse</b>. <Try id="dipole" />
    </li>
    <li>
      Raise <b>ε<sub>r</sub></b> and the wave slows to c/n. The rings, one
      wavelength apart, crowd together and the impedance η drops. <Try id="medium" />
    </li>
    <li>
      In <b>Statics</b> the number of lines on a charge is proportional to |q|,
      so a −2 next to a +1 draws extra lines in from infinity. The B circles
      spread out with distance because B falls as 1/r. <Try id="statics" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { el, segmented, slider, check, transport, readout, result, tries } from '../../../lib/panel';
  import { Camera3D, fieldRamp } from '../../../lib/scene3d';
  import { VolumeView } from '../../../lib/volume3d';

  const canvas = el('em3d') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const css = (v: string) => getComputedStyle(canvas).getPropertyValue(v).trim();
  const isLight = () => css('--stage-light') === '1';
  const ink = () => css('--stage-ink') || '232,233,236';

  const CAM = 17;
  const cam = new Camera3D(W, H, { dist: CAM, yaw: 0.72, pitch: -0.42, zoom: 0.9 });

  // the scene has its own units: lengths in box units u (the box is 15 u
  // across), times in one time unit t. Light in vacuum covers C_VIS u per t.
  const BOX = 7.5;
  const FIELD_MIN = -7.1;
  const FIELD_MAX = 7.1;
  const SPAN = FIELD_MAX - FIELD_MIN;
  const C_VIS = 1.08;
  const AMP = 0.38;

  // The motion is integrated in fixed steps and every charge keeps one sample
  // per step, so the retarded lookups never see the frame-to-frame jitter of
  // the browser's clock. That jitter, differentiated twice, is what used to
  // make the radiation arrows tremble.
  const DT = 1 / 120;
  const HN = 36000; // 300 time units of history: enough for the slowest medium

  const ETA0 = 376.730313668;
  const TAU = Math.PI * 2;

  const E_COLOR = '#60a5fa';
  const B_COLOR = '#f87171';
  const E_RGB: RGB = [96, 165, 250];
  const B_RGB: RGB = [248, 113, 113];

  // a dragged charge chases the pointer on a critically damped spring, and the
  // pointer itself is low-passed first, so its acceleration is continuous
  const SPRING = 16;
  const AIM_TAU = 0.05;
  const AMAX = 9;

  const WIRE_X = 2.6;
  const WIRE_B = 0.08; // the wire's |B| at unit distance, for the statics fog

  type RGB = [number, number, number];
  type Vec = { x: number; y: number; z: number };
  type Kin = { p: Vec; v: Vec; a: Vec };
  type Scene = 'charge' | 'dipole' | 'statics';
  type Charge = {
    id: number;
    q: number;
    p: Vec;
    v: Vec;
    a: Vec;
    origin: Vec;
    target: Vec;
    aim: Vec;
    phase: number;
    mode: 'manual' | 'osc';
    buf: Float64Array;
    /** Steps before this one are all equal to it: the charge sat still. */
    since: number;
    shakeFrom: number;
    /** The last step it moved on. */
    activeStep: number;
  };

  const V = {
    add: (a: Vec, b: Vec): Vec => ({ x: a.x + b.x, y: a.y + b.y, z: a.z + b.z }),
    sub: (a: Vec, b: Vec): Vec => ({ x: a.x - b.x, y: a.y - b.y, z: a.z - b.z }),
    mul: (a: Vec, s: number): Vec => ({ x: a.x * s, y: a.y * s, z: a.z * s }),
    dot: (a: Vec, b: Vec) => a.x * b.x + a.y * b.y + a.z * b.z,
    cross: (a: Vec, b: Vec): Vec => ({
      x: a.y * b.z - a.z * b.y,
      y: a.z * b.x - a.x * b.z,
      z: a.x * b.y - a.y * b.x,
    }),
    norm: (a: Vec) => Math.hypot(a.x, a.y, a.z),
    unit: (a: Vec): Vec => {
      const m = Math.hypot(a.x, a.y, a.z) || 1;
      return { x: a.x / m, y: a.y / m, z: a.z / m };
    },
    mix: (a: Vec, b: Vec, f: number): Vec => ({
      x: a.x + (b.x - a.x) * f,
      y: a.y + (b.y - a.y) * f,
      z: a.z + (b.z - a.z) * f,
    }),
    zero: (): Vec => ({ x: 0, y: 0, z: 0 }),
  };

  const state = {
    epsR: 1,
    muR: 1,
    sigma: 0,
    freq: 0.55,
    plane: 'xy' as 'xy' | 'xz' | 'yz',
    planePos: 0,
    layout: 'plane' as 'plane' | 'volume',
    density: 4,
    view: 'both' as 'both' | 'plane' | 'fog' | 'off',
    fogOpacity: 1,
    fronts: true,
    fieldMode: 'e' as 'e' | 'b' | 'both' | 'off',
    scene: 'charge' as Scene,
    current: 1,
    selectedId: 1,
  };

  let step = 0; // the newest integrated step; time = step · DT
  let acc = 0;
  let moved = 0; // bumped whenever a charge jumps without time passing
  const now = () => step * DT;

  let nextId = 1;
  let charges: Charge[] = [];

  const n = () => Math.sqrt(state.epsR * state.muR);
  const visualC = () => C_VIS / Math.sqrt(Math.max(0.05, state.epsR * state.muR));
  const eta = () => ETA0 * Math.sqrt(state.muR / state.epsR);
  /** Wavelength in box units: the distance the wave covers in one period. */
  const lambda = () => visualC() / state.freq;

  // --- charges and their history ---------------------------------------------------

  function oscKin(c: Charge, t: number): Kin {
    const w = TAU * state.freq;
    const ph = w * t + c.phase;
    return {
      p: { x: c.origin.x, y: c.origin.y + AMP * Math.sin(ph), z: c.origin.z },
      v: { x: 0, y: AMP * w * Math.cos(ph), z: 0 },
      a: { x: 0, y: -AMP * w * w * Math.sin(ph), z: 0 },
    };
  }

  function writeHist(c: Charge, k: number) {
    const o = (((k % HN) + HN) % HN) * 9, b = c.buf;
    b[o] = c.p.x; b[o + 1] = c.p.y; b[o + 2] = c.p.z;
    b[o + 3] = c.v.x; b[o + 4] = c.v.y; b[o + 5] = c.v.z;
    b[o + 6] = c.a.x; b[o + 7] = c.a.y; b[o + 8] = c.a.z;
  }

  function readHist(c: Charge, k: number): Kin {
    const o = (((k % HN) + HN) % HN) * 9, b = c.buf;
    return {
      p: { x: b[o], y: b[o + 1], z: b[o + 2] },
      v: { x: b[o + 3], y: b[o + 4], z: b[o + 5] },
      a: { x: b[o + 6], y: b[o + 7], z: b[o + 8] },
    };
  }

  /** Where the charge was, how fast and how hard it was accelerating at time t. */
  function kin(c: Charge, t: number): Kin {
    if (c.mode === 'osc') return oscKin(c, t);
    const lo = Math.max(c.since, step - HN + 1);
    const f = t / DT;
    if (f <= lo) return readHist(c, lo);
    if (f >= step) return readHist(c, step);
    const k0 = Math.floor(f), u = f - k0;
    const A = readHist(c, k0), B = readHist(c, k0 + 1);
    return { p: V.mix(A.p, B.p, u), v: V.mix(A.v, B.v, u), a: V.mix(A.a, B.a, u) };
  }

  /** Forget the past: the charge has always sat where it is now. */
  function settle(c: Charge) {
    c.v = V.zero();
    c.a = V.zero();
    c.aim = { ...c.p };
    c.target = { ...c.p };
    c.since = step;
    writeHist(c, step);
  }

  function makeCharge(q = 1, p: Vec = V.zero(), mode: Charge['mode'] = 'manual', phase = 0): Charge {
    const c: Charge = {
      id: nextId++,
      q,
      p: { ...p },
      v: V.zero(),
      a: V.zero(),
      origin: { ...p },
      target: { ...p },
      aim: { ...p },
      phase,
      mode,
      buf: new Float64Array(HN * 9),
      since: step,
      shakeFrom: -1,
      activeStep: -1e9,
    };
    if (mode === 'osc') Object.assign(c, oscKin(c, now()));
    settle(c);
    return c;
  }

  /** An oscillating charge grabbed by the pointer: keep its past as it was. */
  function toManual(c: Charge) {
    if (c.mode === 'manual') return;
    for (let k = step - HN + 1; k <= step; k++) {
      Object.assign(c, oscKin(c, k * DT));
      writeHist(c, k);
    }
    c.since = step - HN + 1;
    Object.assign(c, oscKin(c, now()));
    c.mode = 'manual';
    c.activeStep = step;
    c.aim = { ...c.p };
    c.target = { ...c.p };
  }

  // --- scenes ---------------------------------------------------------------------

  function setScene(s: Scene) {
    state.scene = s;
    step = 0;
    acc = 0;
    nextId = 1;
    if (s === 'charge') charges = [makeCharge(1)];
    else if (s === 'dipole') {
      const d = 0.55;
      charges = [
        makeCharge(1, { x: 0, y: d, z: 0 }, 'osc', 0),
        makeCharge(-1, { x: 0, y: -d, z: 0 }, 'osc', Math.PI),
      ];
    } else {
      charges = [makeCharge(1, { x: -2.2, y: 0, z: 0 }), makeCharge(-1, { x: -0.2, y: 0, z: 0 })];
    }
    state.selectedId = charges[0].id;
    linesDirty = true;
    exposure = 0;
    volExpo = 0;
    volKey = '';
    genHalf = 0;
    panelFor();
  }

  /** Two to four charges of either sign; same-sign sets are allowed. */
  function randomCharges() {
    const k = 2 + Math.floor(Math.random() * 3);
    nextId = 1;
    charges = [];
    for (let i = 0; i < k; i++) {
      const q = (Math.random() < 0.5 ? 1 : -1) * (0.6 + Math.random() * 0.8);
      charges.push(makeCharge(+q.toFixed(1), {
        x: -2.6 + Math.random() * 3.2,
        y: -1.4 + Math.random() * 2.8,
        z: -1.4 + Math.random() * 2.8,
      }));
    }
    state.selectedId = charges[0].id;
    linesDirty = true;
  }

  const SHAKE_F = 0.75, SHAKE_N = 2;
  function shake() {
    const c = charges.find((q) => q.mode === 'manual');
    if (!c) return;
    c.origin = { ...c.target };
    c.shakeFrom = now();
    tr.setRunning(true);
  }

  function integrate() {
    step++;
    const t = now();
    const k = 1 - Math.exp(-DT / AIM_TAU);
    for (const c of charges) {
      if (c.mode === 'osc') {
        Object.assign(c, oscKin(c, t));
        continue;
      }
      if (c.shakeFrom >= 0) {
        const s = (t - c.shakeFrom) * SHAKE_F;
        if (s >= SHAKE_N) { c.shakeFrom = -1; c.target = { ...c.origin }; }
        else c.target = V.add(c.origin, { x: 0.6 * Math.sin(TAU * s), y: 0, z: 0 });
      }
      c.aim = V.mix(c.aim, c.target, k);
      const a = V.sub(V.mul(V.sub(c.aim, c.p), SPRING * SPRING), V.mul(c.v, 2 * SPRING));
      c.v = V.add(c.v, V.mul(a, DT));
      c.p = V.add(c.p, V.mul(c.v, DT));
      c.a = a;
      if (a.x * a.x + a.y * a.y + a.z * a.z > 1e-10 || c.v.x * c.v.x + c.v.y * c.v.y + c.v.z * c.v.z > 1e-10) c.activeStep = step;
      writeHist(c, step);
    }
  }

  function advance(dt: number) {
    acc += dt;
    let guard = 0;
    while (acc >= DT && guard++ < 12) {
      integrate();
      acc -= DT;
    }
    if (guard >= 12) acc = 0;
  }

  // --- the field ------------------------------------------------------------------

  // The field is summed in plain numbers rather than vector objects: the
  // shading asks for it at thousands of points every frame.
  const K9 = new Float64Array(9);
  const F6 = new Float64Array(6);

  /** kin(), written into K9 as p, v, a without allocating. */
  function kinInto(c: Charge, t: number) {
    if (c.mode === 'osc') {
      const w = TAU * state.freq, ph = w * t + c.phase, sn = Math.sin(ph);
      K9[0] = c.origin.x; K9[1] = c.origin.y + AMP * sn; K9[2] = c.origin.z;
      K9[3] = 0; K9[4] = AMP * w * Math.cos(ph); K9[5] = 0;
      K9[6] = 0; K9[7] = -AMP * w * w * sn; K9[8] = 0;
      return;
    }
    const b = c.buf;
    const lo = Math.max(c.since, step - HN + 1);
    let f = t / DT;
    if (f < lo) f = lo;
    if (f > step) f = step;
    const k0 = Math.min(step - 1, Math.floor(f));
    if (k0 < lo) {
      const o = (((lo % HN) + HN) % HN) * 9;
      for (let i = 0; i < 9; i++) K9[i] = b[o + i];
      return;
    }
    const u = f - k0;
    const o0 = (((k0 % HN) + HN) % HN) * 9, o1 = ((((k0 + 1) % HN) + HN) % HN) * 9;
    for (let i = 0; i < 9; i++) K9[i] = b[o0 + i] + (b[o1 + i] - b[o0 + i]) * u;
  }

  /** E and B at (x, y, z), written into F6 as Ex Ey Ez Bx By Bz. */
  function fieldInto(x: number, y: number, z: number) {
    let ex = 0, ey = 0, ez = 0, bx = 0, by = 0, bz = 0;
    const cVis = visualC(), t = now();
    const c2 = Math.max(0.05, cVis * cVis), c1 = Math.max(0.05, cVis);
    const sig = state.sigma, eps = state.epsR;
    for (const src of charges) {
      // solve the retarded time t_ret = t − |p − x(t_ret)|/v by iteration, so
      // the field genuinely trails the source
      // (plain square roots: Math.hypot is several times slower, and this runs
      // for every cell of the fog)
      let dx = x - src.p.x, dy = y - src.p.y, dz = z - src.p.z;
      let tRet = t - Math.max(0.04, Math.sqrt(dx * dx + dy * dy + dz * dz)) / cVis;
      for (let it = 0; it < 2; it++) {
        kinInto(src, tRet);
        dx = x - K9[0]; dy = y - K9[1]; dz = z - K9[2];
        tRet = t - Math.max(0.04, Math.sqrt(dx * dx + dy * dy + dz * dz)) / cVis;
      }
      kinInto(src, tRet);
      const Rx = x - K9[0], Ry = y - K9[1], Rz = z - K9[2];
      const r = Math.max(0.045, Math.sqrt(Rx * Rx + Ry * Ry + Rz * Rz));
      const nx = Rx / r, ny = Ry / r, nz = Rz / r;
      const att = sig ? Math.exp(-sig * r) : 1;
      let ax = K9[6], ay = K9[7], az = K9[8];
      const am = Math.sqrt(ax * ax + ay * ay + az * az);
      if (am > AMAX) { const s = AMAX / am; ax *= s; ay *= s; az *= s; }

      const kn = (0.16 * src.q * att) / (eps * (r * r + 0.025));
      const nex = nx * kn, ney = ny * kn, nez = nz * kn;
      // n × (n × a) = n (n·a) − a
      const kr = (0.075 * src.q * att) / (c2 * r), na = nx * ax + ny * ay + nz * az;
      const rex = (nx * na - ax) * kr, rey = (ny * na - ay) * kr, rez = (nz * na - az) * kr;
      ex += nex + rex; ey += ney + rey; ez += nez + rez;

      const vx = K9[3], vy = K9[4], vz = K9[5], kv = 0.65 / c2;
      bx += (vy * nez - vz * ney) * kv + (ny * rez - nz * rey) / c1;
      by += (vz * nex - vx * nez) * kv + (nz * rex - nx * rez) / c1;
      bz += (vx * ney - vy * nex) * kv + (nx * rey - ny * rex) / c1;
    }
    F6[0] = ex; F6[1] = ey; F6[2] = ez; F6[3] = bx; F6[4] = by; F6[5] = bz;
  }

  function fieldAt(p: Vec) {
    fieldInto(p.x, p.y, p.z);
    return { E: { x: F6[0], y: F6[1], z: F6[2] }, B: { x: F6[3], y: F6[4], z: F6[5] } };
  }

  // --- camera ---------------------------------------------------------------------

  // the shared orbit camera (scene3d), so the volume renderer sees the same view
  const worldToCamera = (p: Vec) => cam.toCam(p);
  const cameraToWorld = (p: Vec): Vec => cam.toWorld(p);
  const camForward = () => cam.forward();
  const camRight = () => cam.right();
  const project = (p: Vec) => cam.project(p);

  /** Where the pointer ray meets the plane through `q` with normal `nrm`. */
  function hitPlane(sx: number, sy: number, q: Vec, nrm: Vec): Vec | null {
    const p = cam.hitPlane(sx, sy, q, nrm);
    if (!p) return null;
    const cl = (v: number) => Math.max(-BOX, Math.min(BOX, v));
    return { x: cl(p.x), y: cl(p.y), z: cl(p.z) };
  }

  /** Depth cue: near things full strength, the far side of the box dimmer. */
  const cue = (zc: number) => cam.fog(zc, BOX);

  // --- the plane ------------------------------------------------------------------

  const AXIS = { xy: 'z', xz: 'y', yz: 'x' } as const;

  function planePoint(u: number, v: number): Vec {
    const d = state.planePos;
    if (state.plane === 'xy') return { x: u, y: v, z: d };
    if (state.plane === 'xz') return { x: u, y: d, z: v };
    return { x: d, y: u, z: v };
  }

  function planeNormal(): Vec {
    return state.plane === 'xy' ? { x: 0, y: 0, z: 1 } : state.plane === 'xz' ? { x: 0, y: 1, z: 0 } : { x: 1, y: 0, z: 0 };
  }

  // The shading: the field strength √(εE² + B²/μ) is sampled on a coarse grid over the
  // plane, then every screen pixel casts its ray onto the plane and reads the
  // grid there, so the shading sits in true perspective under the arrows. The
  // exposure follows the scene slowly, so the pattern stays readable whether
  // the field is a faint ripple or a strong near field.
  const HG = 112;
  const vals = new Float32Array(HG * HG);
  const tmp = new Float32Array(HG * HG);
  let heatKey = '';
  let exposure = 0;

  const HS = 1.5;
  const hsW = Math.ceil(W / HS), hsH = Math.ceil(H / HS);
  const heatScr = document.createElement('canvas');
  heatScr.width = hsW;
  heatScr.height = hsH;
  const hsctx = heatScr.getContext('2d')!;
  const hsimg = hsctx.createImageData(hsW, hsH);
  const hsPix = new Uint32Array(hsimg.data.buffer);

  let lut = new Uint8ClampedArray(0);
  let lut32 = new Uint32Array(0);
  let lutLight: boolean | null = null;
  function buildLut() {
    const light = isLight();
    if (light === lutLight) return;
    lutLight = light;
    const stops: number[][] = light
      ? [[0, 199, 210, 254, 0], [0.3, 165, 180, 252, 0.35], [0.65, 99, 102, 241, 0.5], [1, 49, 46, 129, 0.68]]
      : [[0, 49, 46, 129, 0], [0.3, 79, 70, 229, 0.32], [0.65, 139, 92, 246, 0.5], [1, 233, 213, 255, 0.72]];
    lut = new Uint8ClampedArray(256 * 4);
    for (let k = 0; k < 256; k++) {
      const t = k / 255;
      let i = 1;
      while (i < stops.length - 1 && t > stops[i][0]) i++;
      const a = stops[i - 1], b = stops[i];
      const u = Math.max(0, Math.min(1, (t - a[0]) / (b[0] - a[0])));
      for (let c = 0; c < 3; c++) lut[k * 4 + c] = a[c + 1] + (b[c + 1] - a[c + 1]) * u;
      lut[k * 4 + 3] = 255 * (a[4] + (b[4] - a[4]) * u);
    }
    lut32 = new Uint32Array(lut.buffer);
    vol?.setColours(fieldRamp(light));
  }

  function updateHeat() {
    const key = [step, moved, state.epsR, state.muR, state.sigma, state.freq, state.plane, state.planePos, state.scene].join('|');
    if (key === heatKey) return false;
    heatKey = key;
    for (let j = 0; j < HG; j++) {
      const v = FIELD_MIN + ((j + 0.5) / HG) * SPAN;
      for (let i = 0; i < HG; i++) {
        const u = FIELD_MIN + ((i + 0.5) / HG) * SPAN;
        const P = planePoint(u, v);
        fieldInto(P.x, P.y, P.z);
        vals[j * HG + i] = Math.sqrt(
          state.epsR * (F6[0] * F6[0] + F6[1] * F6[1] + F6[2] * F6[2]) +
          (F6[3] * F6[3] + F6[4] * F6[4] + F6[5] * F6[5]) / state.muR
        );
      }
    }
    // a light [1 2 1] blur each way: a kink thinner than one cell then reads as
    // a smooth band instead of a row of blocks
    for (const [di, dj] of [[1, 0], [0, 1]]) {
      tmp.set(vals);
      for (let j = 0; j < HG; j++)
        for (let i = 0; i < HG; i++) {
          const i0 = Math.max(0, i - di), i1 = Math.min(HG - 1, i + di);
          const j0 = Math.max(0, j - dj), j1 = Math.min(HG - 1, j + dj);
          vals[j * HG + i] = 0.25 * tmp[j0 * HG + i0] + 0.5 * tmp[j * HG + i] + 0.25 * tmp[j1 * HG + i1];
        }
    }
    const sorted = Float32Array.from(vals).sort();
    const q = Math.max(1e-4, sorted[Math.floor(sorted.length * 0.9)]);
    exposure = exposure ? exposure * 0.94 + q * 0.06 : q;
    return true;
  }

  function drawHeat() {
    updateHeat();
    buildLut();
    const k = cam.k, CX = cam.cx, CY = cam.cy;
    const o = cam.eye();
    const fw = camForward(), rt = camRight(), up = cameraToWorld({ x: 0, y: 1, z: 0 });
    // pick the plane's own axes: n is the normal, (u, v) the in-plane pair, in
    // the same order planePoint() uses
    const pick = (q: Vec): [number, number, number] =>
      state.plane === 'xy' ? [q.x, q.y, q.z] : state.plane === 'xz' ? [q.x, q.z, q.y] : [q.y, q.z, q.x];
    const [ou, ov, on] = pick(o), [fu, fv, fn] = pick(fw), [ru, rv, rn] = pick(rt), [uu, uv, un] = pick(up);

    // only the rectangle the plane covers on screen needs work
    let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
    for (const [a, b] of [[FIELD_MIN, FIELD_MIN], [FIELD_MAX, FIELD_MIN], [FIELD_MIN, FIELD_MAX], [FIELD_MAX, FIELD_MAX]]) {
      const pr = project(planePoint(a, b));
      if (pr.zc < 0.3) { x0 = 0; y0 = 0; x1 = W; y1 = H; break; }
      x0 = Math.min(x0, pr.sx); x1 = Math.max(x1, pr.sx); y0 = Math.min(y0, pr.sy); y1 = Math.max(y1, pr.sy);
    }
    const px0 = Math.max(0, Math.floor(x0 / HS)), px1 = Math.min(hsW, Math.ceil(x1 / HS) + 1);
    const py0 = Math.max(0, Math.floor(y0 / HS)), py1 = Math.min(hsH, Math.ceil(y1 / HS) + 1);
    if (px1 <= px0 || py1 <= py0) return;

    const inv = 3 / exposure, norm = 255 / Math.log(1 + 24);
    const gs = HG / SPAN, pos = state.planePos;
    const pix = hsPix;
    pix.fill(0);
    for (let py = py0; py < py1; py++) {
      const b = -((py + 0.5) * HS - CY) / k;
      const row = py * hsW;
      for (let px = px0; px < px1; px++) {
        const a = ((px + 0.5) * HS - CX) / k;
        const dn = fn + rn * a + un * b;
        if (dn > -1e-6 && dn < 1e-6) continue;
        const t = (pos - on) / dn;
        if (t <= 0) continue;
        const gu = (ou + (fu + ru * a + uu * b) * t - FIELD_MIN) * gs - 0.5;
        const gv = (ov + (fv + rv * a + uv * b) * t - FIELD_MIN) * gs - 0.5;
        if (gu < -0.5 || gv < -0.5 || gu > HG - 0.5 || gv > HG - 0.5) continue;
        let i0 = gu | 0, j0 = gv | 0;
        if (i0 > HG - 2) i0 = HG - 2;
        if (j0 > HG - 2) j0 = HG - 2;
        if (gu < 0) i0 = 0;
        if (gv < 0) j0 = 0;
        let fu2 = gu - i0, fv2 = gv - j0;
        fu2 = fu2 < 0 ? 0 : fu2 > 1 ? 1 : fu2;
        fv2 = fv2 < 0 ? 0 : fv2 > 1 ? 1 : fv2;
        const r0 = j0 * HG + i0;
        const val =
          (vals[r0] + (vals[r0 + 1] - vals[r0]) * fu2) * (1 - fv2) +
          (vals[r0 + HG] + (vals[r0 + HG + 1] - vals[r0 + HG]) * fu2) * fv2;
        let li = (Math.log(1 + val * inv) * norm) | 0;
        if (li > 255) li = 255;
        pix[row + px] = lut32[li];
      }
    }
    hsctx.putImageData(hsimg, 0, 0, px0, py0, px1 - px0, py1 - py0);
    ctx.save();
    ctx.imageSmoothingEnabled = true;
    ctx.drawImage(heatScr, px0, py0, px1 - px0, py1 - py0, px0 * HS, py0 * HS, (px1 - px0) * HS, (py1 - py0) * HS);
    ctx.restore();
  }

  // --- the fog ----------------------------------------------------------------------

  // The same field strength √(εE² + B²/μ), sampled on a 3D grid over the box and
  // raymarched in WebGL2 as glowing fog; the plane's shading goes into the same
  // pass, so fog in front of the plane covers it and fog behind it stays behind.
  // Without WebGL2 the plane falls back to the 2D shading above and there is no fog.
  const vol = VolumeView.create(canvas, W, H, 'scalar');
  if (!vol) state.view = 'plane';

  // The dipole is symmetric about its axis (y), so its field strength depends on
  // (ρ, y) alone: one row of RN radii per grid layer in y, then the full DG³ grid
  // is read off that table. Other scenes are sampled cell by cell, more coarsely.
  const DG = 64, GG = 44, SG = 48;
  const RN = 160, RMAX = BOX * Math.SQRT2 + 0.1;
  const volData = new Float32Array(DG * DG * DG);
  const rtab = new Float32Array(RN * DG);
  const colK = new Int32Array(DG * DG), colF = new Float32Array(DG * DG);
  for (let l = 0; l < DG; l++)
    for (let i = 0; i < DG; i++) {
      const x = -BOX + ((i + 0.5) * 2 * BOX) / DG, z = -BOX + ((l + 0.5) * 2 * BOX) / DG;
      const f = (Math.hypot(x, z) / RMAX) * (RN - 1);
      const k = Math.min(RN - 2, Math.floor(f));
      colK[l * DG + i] = k;
      colF[l * DG + i] = f - k;
    }
  const pick = new Float32Array(4096);
  // how the strength becomes fog density: density = s^pw / (1 + s^pw / cap) − floor,
  // with s the strength over the exposure (the pct quantile for the antenna, a
  // fixed ref for free and static charges); gain and len set how thick it looks
  const TUNE = { pw: 1.8, pct: 0.96, cap: 2, floor: 0.18, refC: 0.24, refS: 0.16, gain: 1.3, lgain: 1.4, len: 1.4 };
  let volKey = '';
  let volExpo = 0;

  /** √(εE² + B²/μ) of the field in F6. */
  const strength = () => Math.sqrt(
    state.epsR * (F6[0] * F6[0] + F6[1] * F6[1] + F6[2] * F6[2]) +
    (F6[3] * F6[3] + F6[4] * F6[4] + F6[5] * F6[5]) / state.muR
  );

  const symmetric = () =>
    state.scene === 'dipole' && charges.every((c) => c.mode === 'osc' && c.origin.x === 0 && c.origin.z === 0);

  /** The (ρ, y) table of the dipole's strength. */
  function sampleDipole() {
    const h = (2 * BOX) / DG;
    for (let j = 0; j < DG; j++) {
      const y = -BOX + (j + 0.5) * h;
      for (let k = 0; k < RN; k++) {
        fieldInto((k * RMAX) / (RN - 1), y, 0);
        rtab[j * RN + k] = strength();
      }
    }
  }

  /** The table read off at grid cell n, before the full grid exists. */
  function dipoleCell(n: number) {
    const i = n % DG, j = Math.floor(n / DG) % DG, l = Math.floor(n / (DG * DG));
    const c = l * DG + i, k = j * RN + colK[c];
    return rtab[k] + (rtab[k + 1] - rtab[k]) * colF[c];
  }

  function fillDipole() {
    let n = 0;
    for (let l = 0; l < DG; l++)
      for (let j = 0; j < DG; j++) {
        const row = j * RN;
        for (let i = 0; i < DG; i++) {
          const c = l * DG + i, k = row + colK[c];
          volData[n++] = rtab[k] + (rtab[k + 1] - rtab[k]) * colF[c];
        }
      }
  }

  /** Sample z-slices [l0, l1) of a G³ grid cell by cell. */
  function sampleGrid(G: number, l0 = 0, l1 = G) {
    const h = (2 * BOX) / G;
    const statics = state.scene === 'statics';
    const showE = !statics || state.fieldMode !== 'b', showB = statics && state.fieldMode !== 'e';
    let n = l0 * G * G;
    for (let l = l0; l < l1; l++) {
      const z = -BOX + (l + 0.5) * h;
      for (let j = 0; j < G; j++) {
        const y = -BOX + (j + 0.5) * h;
        for (let i = 0; i < G; i++) {
          const x = -BOX + (i + 0.5) * h;
          if (!statics) {
            fieldInto(x, y, z);
            volData[n++] = strength();
            continue;
          }
          // statics: |E| of the charges and |B| = μ₀I/2πr of the wire, each if shown
          let e2 = 0, b2 = 0;
          if (showE) {
            fieldInto(x, y, z);
            e2 = state.epsR * (F6[0] * F6[0] + F6[1] * F6[1] + F6[2] * F6[2]);
          }
          if (showB) {
            const r2 = (x - WIRE_X) * (x - WIRE_X) + z * z;
            const b = WIRE_B / Math.sqrt(r2 + 0.02);
            b2 = (b * b) / state.muR;
          }
          volData[n++] = Math.sqrt(e2 + b2);
        }
      }
    }
  }

  /**
   * True when every charge has sat still for longer than light takes to cross
   * the box: then the field is static and the fog needn't be resampled.
   */
  const quiet = () =>
    charges.every((c) => c.mode === 'manual' && (step - c.activeStep) * DT * visualC() > 4 * BOX);

  // a free charge's grid is sampled in two halves on consecutive frames, so the
  // cost is spread evenly instead of landing on one frame
  let genHalf = 0;

  /** Resample the fog if anything it depends on changed. */
  function updateVolume() {
    const statics = state.scene === 'statics';
    const sym = symmetric();
    if (genHalf) {
      sampleGrid(GG, GG >> 1, GG);
      genHalf = 0;
    } else {
      const key = [
        statics || quiet() ? 'still' : step, moved, state.epsR, state.muR, state.sigma, state.freq, state.scene,
        statics ? state.fieldMode + state.current + charges.map((c) => `${c.q},${c.p.x},${c.p.y},${c.p.z}`).join(';') : '',
      ].join('|');
      if (key === volKey) return;
      const first = !volKey;
      volKey = key;
      if (sym) sampleDipole();
      else if (statics) sampleGrid(SG);
      else if (first) sampleGrid(GG);
      else {
        sampleGrid(GG, 0, GG >> 1);
        genHalf = 1;
        return;
      }
    }
    const G = sym ? DG : statics ? SG : GG;
    const N = G * G * G;

    // exposure: the antenna's steady pattern is scaled to a high percentile of a
    // spread-out subsample, followed slowly. A free or static charge gets a fixed
    // scale instead, so its Coulomb glow keeps one size and a pulse it sends out
    // fades as it spreads, as it should.
    if (state.scene === 'dipole') {
      const stride = Math.max(1, Math.floor(N / pick.length));
      let m = 0;
      for (let i = stride >> 1; i < N && m < pick.length; i += stride) pick[m++] = sym ? dipoleCell(i) : volData[i];
      const sorted = pick.subarray(0, m).sort();
      const q = Math.max(1e-4, sorted[Math.floor(m * TUNE.pct)]);
      volExpo = volExpo ? volExpo * 0.92 + q * 0.08 : q;
    } else volExpo = statics ? TUNE.refS : TUNE.refC;

    // the stored density rises a little faster than the strength and saturates
    // softly, so the radiation's shells stand apart from the gaps between them
    // and the strong near field doesn't swallow the rest
    const inv = 1 / volExpo, pw = TUNE.pw, cap = TUNE.cap, floor = TUNE.floor;
    const map = (a: Float32Array, len: number) => {
      for (let i = 0; i < len; i++) {
        let v = Math.pow(a[i] * inv, pw);
        v = v / (1 + v / cap) - floor;
        a[i] = v > 0 ? v : 0;
      }
    };
    if (sym) {
      map(rtab, rtab.length);
      fillDipole();
    } else map(volData, N);
    vol!.setVolume(volData.subarray(0, N), [G, G, G], [-BOX, -BOX, -BOX], [BOX, BOX, BOX]);
  }

  /** Draw the GL layer: the fog and/or the shaded plane. */
  function renderGL(fogOn: boolean, shadeOn: boolean) {
    if (!vol) return;
    buildLut();
    if (fogOn) updateVolume();
    if (shadeOn) {
      updateHeat();
      vol.setPlane(vals, HG, state.plane, state.planePos, FIELD_MAX);
    }
    const light = isLight();
    vol.render(cam, {
      cloud: fogOn,
      plane: shadeOn,
      gain: light ? TUNE.lgain : TUNE.gain,
      planeGain: 1 / (8 * Math.max(1e-4, exposure)),
      opacity: state.fogOpacity * (light ? 0.8 : 1),
      len: TUNE.len,
      light,
      planeAlpha: 0.55,
    });
  }

  function drawPlaneFrame() {
    const col = `rgba(${ink()},${isLight() ? 0.12 : 0.09})`;
    const edge = `rgba(${ink()},${isLight() ? 0.34 : 0.3})`;
    const k = 12;
    for (let i = 0; i <= k; i++) {
      const u = FIELD_MIN + (SPAN * i) / k;
      const c = i === 0 || i === k ? edge : col;
      line3(planePoint(u, FIELD_MIN), planePoint(u, FIELD_MAX), c, 1);
      line3(planePoint(FIELD_MIN, u), planePoint(FIELD_MAX, u), c, 1);
    }
    const lab = project(planePoint(FIELD_MAX, FIELD_MIN));
    ctx.fillStyle = `rgba(${ink()},0.5)`;
    ctx.font = "500 11px 'JetBrains Mono', monospace";
    ctx.textAlign = 'left';
    ctx.textBaseline = 'middle';
    ctx.fillText(`${state.plane.toUpperCase()} · ${AXIS[state.plane]} = ${state.planePos.toFixed(1)}`, lab.sx + 8, lab.sy);
  }

  function line3(a: Vec, b: Vec, color: string, width = 1.2) {
    const pa = project(a), pb = project(b);
    if (pa.zc <= 0.1 || pb.zc <= 0.1) return;
    ctx.strokeStyle = color;
    ctx.lineWidth = width;
    ctx.beginPath();
    ctx.moveTo(pa.sx, pa.sy);
    ctx.lineTo(pb.sx, pb.sy);
    ctx.stroke();
  }

  function drawBox() {
    const s = BOX;
    const c = [
      { x: -s, y: -s, z: -s }, { x: s, y: -s, z: -s }, { x: s, y: s, z: -s }, { x: -s, y: s, z: -s },
      { x: -s, y: -s, z: s }, { x: s, y: -s, z: s }, { x: s, y: s, z: s }, { x: -s, y: s, z: s },
    ];
    const edges = [[0, 1], [1, 2], [2, 3], [3, 0], [4, 5], [5, 6], [6, 7], [7, 4], [0, 4], [1, 5], [2, 6], [3, 7]];
    for (const [i, j] of edges) {
      const z = (worldToCamera(c[i]).zc + worldToCamera(c[j]).zc) / 2;
      line3(c[i], c[j], `rgba(${ink()},${(isLight() ? 0.26 : 0.2) * cue(z)})`, 1);
    }
  }

  function drawBackdrop() {
    const g = ctx.createRadialGradient(W / 2, H * 0.45, 20, W / 2, H / 2, Math.max(W, H) * 0.7);
    if (isLight()) {
      g.addColorStop(0, 'rgba(99,102,241,0.06)');
      g.addColorStop(1, 'rgba(99,102,241,0)');
    } else {
      g.addColorStop(0, 'rgba(99,102,241,0.12)');
      g.addColorStop(1, 'rgba(13,14,18,0)');
    }
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, W, H);
  }

  // --- arrows ---------------------------------------------------------------------

  /** Sample points: a k × k grid on the plane, or a k × k × k lattice. */
  function samples() {
    const pts: Vec[] = [];
    if (state.layout === 'plane') {
      const k = 7 + 2 * state.density;
      for (let i = 0; i < k; i++)
        for (let j = 0; j < k; j++)
          pts.push(planePoint(FIELD_MIN + (SPAN * i) / (k - 1), FIELD_MIN + (SPAN * j) / (k - 1)));
      return { pts, spacing: SPAN / (k - 1) };
    }
    const k = 3 + state.density;
    const lo = FIELD_MIN + 0.3, span = SPAN - 0.6;
    for (let i = 0; i < k; i++)
      for (let j = 0; j < k; j++)
        for (let l = 0; l < k; l++)
          pts.push({ x: lo + (span * i) / (k - 1), y: lo + (span * j) / (k - 1), z: lo + (span * l) / (k - 1) });
    return { pts, spacing: span / (k - 1) };
  }

  const ARROW_GAIN = 2.9;

  /**
   * A 3D arrow centred on its sample point. Its length grows smoothly with the
   * field and shrinks smoothly to nothing at a node, so an arrow passing
   * through zero fades out and back instead of flipping in a blink. The head
   * is a flat cone turned to face the camera, so an arrow pointing at you
   * foreshortens like a real one.
   */
  function drawArrow(p: Vec, f: Vec, mag: number, rgb: RGB, spacing: number) {
    const strength = 1 - Math.exp(-mag * ARROW_GAIN * (state.layout === 'volume' ? 1.8 : 1));
    if (strength < 0.015) return;
    const u = V.mul(f, 1 / mag);
    const len = spacing * (state.layout === 'volume' ? 0.85 : 0.9) * strength;
    const tail = V.sub(p, V.mul(u, len / 2));
    const tip = V.add(p, V.mul(u, len / 2));
    const h = Math.min(len * 0.4, spacing * 0.24);
    let w = V.cross(u, camForward());
    if (V.norm(w) < 1e-3) w = camRight();
    w = V.mul(V.unit(w), h * 0.32);
    const base = V.sub(tip, V.mul(u, h));

    const a = project(tail), b = project(tip), m = project(base);
    const l = project(V.add(base, w)), r = project(V.sub(base, w));
    if (a.zc < 0.3 || b.zc < 0.3) return;

    const depth = cue((a.zc + b.zc) / 2);
    const fade = strength < 0.12 ? strength / 0.12 : 1;
    const alpha = (0.3 + 0.7 * strength) * depth * fade * (fogShown ? 0.82 : 1);
    const lift = isLight() ? 0 : 0.3 * strength;
    const cr = Math.round(rgb[0] + (255 - rgb[0]) * lift);
    const cg = Math.round(rgb[1] + (255 - rgb[1]) * lift);
    const cb = Math.round(rgb[2] + (255 - rgb[2]) * lift);
    const col = `rgba(${cr},${cg},${cb},${alpha})`;

    const px = Math.max(0.6, Math.min(2, a.s / 0.25));
    ctx.strokeStyle = col;
    ctx.lineCap = 'round';
    ctx.lineWidth = (1 + 1.8 * strength) * px * (fogShown ? 0.72 : 1);
    ctx.beginPath();
    ctx.moveTo(a.sx, a.sy);
    ctx.lineTo(m.sx, m.sy);
    ctx.stroke();

    ctx.fillStyle = col;
    ctx.beginPath();
    ctx.moveTo(b.sx, b.sy);
    ctx.lineTo(l.sx, l.sy);
    ctx.lineTo(r.sx, r.sy);
    ctx.closePath();
    ctx.fill();
  }

  // --- wavefronts -----------------------------------------------------------------

  /**
   * One spherical front per period. On a plane each front is drawn where it
   * cuts the plane, a true circle in 3D; in the volume view it is the sphere's
   * outline. A free charge only marks a front when it was accelerating as it
   * emitted it, so a still charge sends nothing out.
   */
  function drawFronts() {
    const cVis = visualC();
    const maxR = FIELD_MAX * 1.2;
    const dipole = state.scene === 'dipole';
    const interval = dipole ? 1 / state.freq : 0.45;
    const nRings = Math.min(70, Math.ceil(maxR / cVis / interval) + 1);
    const base = isLight() ? 0.4 : 0.32;
    const srcs = dipole ? [null] : charges;
    const t = now();
    const t0 = Math.floor(t / interval) * interval;

    for (const src of srcs) {
      for (let i = 0; i < nRings; i++) {
        const tEmit = t0 - i * interval;
        const r = (t - tEmit) * cVis;
        if (r <= 0.05 || r > maxR) continue;
        let weight = 1, e: Vec = V.zero();
        if (src) {
          let am = 0;
          for (let s = 0; s < 6; s++) am = Math.max(am, V.norm(kin(src, tEmit - (s * interval) / 6).a));
          weight = Math.min(1, am / 3);
          if (weight < 0.03) continue;
          e = kin(src, tEmit).p;
        }
        const alpha = base * weight * (1 - r / maxR) * Math.exp(-state.sigma * r);
        ctx.strokeStyle = `rgba(${ink()},${alpha})`;
        ctx.lineWidth = 1.1;

        if (state.layout === 'volume') {
          const c = project(e), edge = project(V.add(e, V.mul(camRight(), r)));
          if (c.zc < 0.3) continue;
          ctx.beginPath();
          ctx.arc(c.sx, c.sy, Math.abs(edge.sx - c.sx), 0, TAU);
          ctx.stroke();
          continue;
        }

        const ax = AXIS[state.plane];
        const dz = state.planePos - e[ax];
        if (r * r <= dz * dz) continue;
        const rc = Math.sqrt(r * r - dz * dz);
        const [ua, va] = state.plane === 'xy' ? ['x', 'y'] : state.plane === 'xz' ? ['x', 'z'] : ['y', 'z'];
        ctx.beginPath();
        let pen = false;
        for (let s = 0; s <= 96; s++) {
          const th = (s / 96) * TAU;
          const cu = e[ua as 'x'] + rc * Math.cos(th), cv = e[va as 'x'] + rc * Math.sin(th);
          if (Math.abs(cu) > FIELD_MAX || Math.abs(cv) > FIELD_MAX) { pen = false; continue; }
          const pr = project(planePoint(cu, cv));
          if (!pen) { ctx.moveTo(pr.sx, pr.sy); pen = true; } else ctx.lineTo(pr.sx, pr.sy);
        }
        ctx.stroke();
      }
    }
  }

  // --- charges --------------------------------------------------------------------

  function drawCharge(c: Charge) {
    const p = project(c.p);
    if (p.zc <= 0.3) return;
    const r = Math.max(6, 12 * p.s * (0.7 + 0.3 * Math.min(2, Math.abs(c.q))));
    const pos = c.q >= 0;
    const [cr, cg, cb] = pos ? [248, 113, 113] : [96, 165, 250];

    const glow = ctx.createRadialGradient(p.sx, p.sy, r * 0.5, p.sx, p.sy, r * 2.8);
    glow.addColorStop(0, `rgba(${cr},${cg},${cb},0.35)`);
    glow.addColorStop(1, `rgba(${cr},${cg},${cb},0)`);
    ctx.fillStyle = glow;
    ctx.beginPath();
    ctx.arc(p.sx, p.sy, r * 2.8, 0, TAU);
    ctx.fill();

    const ball = ctx.createRadialGradient(p.sx - r * 0.35, p.sy - r * 0.4, r * 0.1, p.sx, p.sy, r);
    ball.addColorStop(0, `rgb(${Math.min(255, cr + 70)},${Math.min(255, cg + 70)},${Math.min(255, cb + 70)})`);
    ball.addColorStop(1, `rgb(${Math.round(cr * 0.62)},${Math.round(cg * 0.62)},${Math.round(cb * 0.62)})`);
    ctx.fillStyle = ball;
    ctx.beginPath();
    ctx.arc(p.sx, p.sy, r, 0, TAU);
    ctx.fill();
    if (c.id === state.selectedId && state.scene !== 'dipole') {
      ctx.strokeStyle = `rgba(${ink()},0.85)`;
      ctx.lineWidth = 1.6;
      ctx.beginPath();
      ctx.arc(p.sx, p.sy, r + 3, 0, TAU);
      ctx.stroke();
    }

    ctx.fillStyle = '#ffffff';
    ctx.font = `700 ${Math.max(10, r * 1.25)}px system-ui, sans-serif`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(pos ? '+' : '−', p.sx, p.sy + 0.5);
  }

  function drawAntenna() {
    const top = project({ x: 0, y: 1.15, z: 0 }), bot = project({ x: 0, y: -1.15, z: 0 });
    const mid1 = project({ x: 0, y: 0.08, z: 0 }), mid2 = project({ x: 0, y: -0.08, z: 0 });
    ctx.lineCap = 'round';
    for (const [a, b] of [[top, mid1], [mid2, bot]]) {
      ctx.strokeStyle = isLight() ? 'rgba(100,116,139,0.85)' : 'rgba(148,163,184,0.7)';
      ctx.lineWidth = 4;
      ctx.beginPath();
      ctx.moveTo(a.sx, a.sy);
      ctx.lineTo(b.sx, b.sy);
      ctx.stroke();
    }
    ctx.fillStyle = isLight() ? '#b45309' : '#fbbf24';
    ctx.beginPath();
    ctx.arc((mid1.sx + mid2.sx) / 2, (mid1.sy + mid2.sy) / 2, 3, 0, TAU);
    ctx.fill();
  }

  function drawGizmo() {
    const ox = 50, oy = H - 50, len = 28;
    const axes = [
      { v: { x: 1, y: 0, z: 0 }, c: '#f87171', l: 'x' },
      { v: { x: 0, y: 1, z: 0 }, c: '#4ade80', l: 'y' },
      { v: { x: 0, y: 0, z: 1 }, c: '#60a5fa', l: 'z' },
    ];
    const pr = axes
      .map((a) => {
        const cam = worldToCamera(a.v);
        return { ex: ox + cam.x * len, ey: oy - cam.y * len, depth: cam.z, c: a.c, l: a.l };
      })
      .sort((a, b) => b.depth - a.depth);
    ctx.lineWidth = 2;
    ctx.font = "600 11px 'JetBrains Mono', monospace";
    ctx.textAlign = 'left';
    ctx.textBaseline = 'alphabetic';
    for (const a of pr) {
      ctx.strokeStyle = a.c;
      ctx.fillStyle = a.c;
      ctx.beginPath();
      ctx.moveTo(ox, oy);
      ctx.lineTo(a.ex, a.ey);
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(a.ex, a.ey, 2.4, 0, TAU);
      ctx.fill();
      ctx.fillText(a.l, a.ex + 4, a.ey - 4);
    }
  }

  // --- statics: traced field lines ------------------------------------------------

  type Line = { pts: Vec[]; kind: 'e' | 'b' };
  let lines: Line[] = [];
  let linesDirty = true;
  const linesPerQ = () => 4 + 3 * state.density;

  /** The Coulomb field of the charges where they sit now. */
  function coulomb(p: Vec): Vec {
    let E = V.zero();
    for (const c of charges) {
      const R = V.sub(p, c.p);
      const r = V.norm(R) + 1e-4;
      E = V.add(E, V.mul(R, c.q / (r * r * r)));
    }
    return E;
  }

  /** Evenly spread directions on the unit sphere. */
  function fib(k: number): Vec[] {
    const out: Vec[] = [];
    const ga = Math.PI * (3 - Math.sqrt(5));
    for (let i = 0; i < k; i++) {
      const y = 1 - ((i + 0.5) / k) * 2;
      const r = Math.sqrt(Math.max(0, 1 - y * y));
      out.push({ x: Math.cos(ga * i) * r, y, z: Math.sin(ga * i) * r });
    }
    return out;
  }

  /**
   * Every charge seeds a number of lines proportional to |q|. A + charge traces
   * along E until the line ends on a − charge or leaves the box. A − charge
   * traces backward; if that lands on a + charge the line is one the + charge
   * already drew and is dropped, otherwise it is a line coming in from infinity.
   */
  function buildStatics() {
    lines = [];
    const DS = 0.06, SEED = 0.2, HIT = 0.16;
    for (const c of charges) {
      const sign = Math.sign(c.q);
      for (const d of fib(Math.max(2, Math.round(linesPerQ() * Math.abs(c.q))))) {
        const pts: Vec[] = [];
        let p = V.add(c.p, V.mul(d, SEED));
        let ended = false;
        for (let s = 0; s < 600; s++) {
          pts.push(p);
          const e = coulomb(p);
          const m = V.norm(e);
          if (m < 1e-6) break;
          p = V.add(p, V.mul(e, (sign * DS) / m));
          if (V.norm(p) > FIELD_MAX) break;
          const sink = charges.find((o) => o !== c && Math.sign(o.q) === -sign && V.norm(V.sub(p, o.p)) < HIT);
          if (sink) { ended = true; pts.push(sink.p); break; }
        }
        if (sign < 0 && ended) continue;
        if (pts.length < 3) continue;
        lines.push({ pts: sign > 0 ? pts : pts.reverse(), kind: 'e' });
      }
    }

    // circles round a wire along y. Equal ratios between radii put equal
    // numbers of circles in each doubling of r, so their density falls as 1/r
    // just like |B| = μ₀I / 2πr.
    const K = 72;
    const rings = 3 + Math.floor(state.density / 2);
    for (const y of [-2.2, 0, 2.2]) {
      for (let i = 0; i < rings; i++) {
        const r = 0.28 * Math.pow(1.6, (i * 4) / Math.max(1, rings - 1));
        const pts: Vec[] = [];
        for (let j = 0; j <= K; j++) {
          // current along +y: B = ŷ × r̂ runs from +x towards −z
          const a = state.current * (j / K) * TAU;
          pts.push({ x: WIRE_X + r * Math.cos(a), y, z: -r * Math.sin(a) });
        }
        lines.push({ pts, kind: 'b' });
      }
    }
    linesDirty = false;
  }

  function arrowHead(ax: number, ay: number, bx: number, by: number, col: string) {
    const ang = Math.atan2(by - ay, bx - ax);
    const s = 7;
    ctx.fillStyle = col;
    ctx.beginPath();
    ctx.moveTo(bx, by);
    ctx.lineTo(bx - s * Math.cos(ang - 0.42), by - s * Math.sin(ang - 0.42));
    ctx.lineTo(bx - s * Math.cos(ang + 0.42), by - s * Math.sin(ang + 0.42));
    ctx.closePath();
    ctx.fill();
  }

  function drawWire() {
    const a = project({ x: WIRE_X, y: -BOX, z: 0 });
    const b = project({ x: WIRE_X, y: BOX, z: 0 });
    ctx.lineCap = 'round';
    for (const [w, c] of [[8, isLight() ? 'rgba(146,64,14,0.35)' : 'rgba(0,0,0,0.45)'], [5, '#d97706'], [1.6, '#fde68a']] as [number, string][]) {
      ctx.strokeStyle = c;
      ctx.lineWidth = w;
      ctx.beginPath();
      ctx.moveTo(a.sx, a.sy);
      ctx.lineTo(b.sx, b.sy);
      ctx.stroke();
    }
    for (let t = -3; t <= 3; t += 1.5) {
      const p0 = project({ x: WIRE_X, y: t * state.current, z: 0 });
      const p1 = project({ x: WIRE_X, y: (t + 0.4) * state.current, z: 0 });
      arrowHead(p0.sx, p0.sy, p1.sx, p1.sy, isLight() ? '#92400e' : '#fff7ed');
    }
  }

  function drawFieldLines() {
    if (linesDirty) buildStatics();
    const showE = state.fieldMode === 'e' || state.fieldMode === 'both';
    const showB = state.fieldMode === 'b' || state.fieldMode === 'both';
    for (const ln of lines) {
      if (ln.kind === 'e' ? !showE : !showB) continue;
      const rgb = ln.kind === 'e' ? (isLight() ? [37, 99, 235] : [150, 180, 255]) : isLight() ? [220, 38, 38] : [248, 113, 113];
      const mid = ln.pts[Math.floor(ln.pts.length / 2)];
      const col = `rgba(${rgb[0]},${rgb[1]},${rgb[2]},${0.78 * cue(worldToCamera(mid).zc)})`;
      ctx.strokeStyle = col;
      ctx.lineWidth = 1.6;
      ctx.lineJoin = 'round';
      ctx.beginPath();
      let pen = false;
      for (const p of ln.pts) {
        const pr = project(p);
        if (pr.zc <= 0.3) { pen = false; continue; }
        if (!pen) { ctx.moveTo(pr.sx, pr.sy); pen = true; } else ctx.lineTo(pr.sx, pr.sy);
      }
      ctx.stroke();
      // a head every 1.5 u along the line, so the direction reads everywhere
      const every = ln.kind === 'e' ? 25 : Math.floor(ln.pts.length / 3);
      for (let i = Math.floor(every * 0.6); i < ln.pts.length; i += every) {
        if (i < 1) continue;
        const a = project(ln.pts[i - 1]), b = project(ln.pts[i]);
        if (a.zc > 0.3 && b.zc > 0.3) arrowHead(a.sx, a.sy, b.sx, b.sy, col);
      }
    }
  }

  // --- frame ----------------------------------------------------------------------

  type Item = { z: number; draw: () => void };

  /** What the field-strength view shows right now. */
  function looks() {
    const statics = state.scene === 'statics';
    const fog = !!vol && (statics ? state.view !== 'off' : state.view === 'fog' || state.view === 'both');
    const shade = !statics && (state.view === 'plane' || state.view === 'both');
    const plane = !statics && (state.layout === 'plane' || shade);
    return { fog, shade, plane };
  }
  let fogShown = false;

  function draw() {
    ctx.clearRect(0, 0, W, H);
    const look = looks();
    fogShown = look.fog;
    renderGL(look.fog, look.shade);
    drawBackdrop();
    drawBox();

    const items: Item[] = [];

    if (state.scene === 'statics') {
      if (state.fieldMode === 'b' || state.fieldMode === 'both') drawWire();
      drawFieldLines();
    } else {
      if (look.shade && !vol) drawHeat();
      if (look.plane) drawPlaneFrame();
      if (state.fronts) drawFronts();
      if (state.scene === 'dipole') drawAntenna();
      if (state.fieldMode !== 'off') {
        const showE = state.fieldMode !== 'b', showB = state.fieldMode !== 'e';
        const { pts, spacing } = samples();
        for (const p of pts) {
          const f = fieldAt(p);
          const z = worldToCamera(p).zc;
          const eM = V.norm(f.E), bM = V.norm(f.B);
          if (showE && eM > 1e-6) items.push({ z, draw: () => drawArrow(p, f.E, eM, E_RGB, spacing) });
          if (showB && bM > 1e-6) items.push({ z: z - 1e-3, draw: () => drawArrow(p, f.B, bM, B_RGB, spacing) });
        }
      }
    }

    for (const c of charges) items.push({ z: worldToCamera(c.p).zc, draw: () => drawCharge(c) });
    items.sort((a, b) => b.z - a.z);
    for (const it of items) it.draw();

    drawGizmo();
    sync();
  }

  // --- words and numbers -------------------------------------------------------------

  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  function densityLabel() {
    if (state.scene === 'statics') return `${linesPerQ()} lines / unit q`;
    if (state.layout === 'volume') {
      const k = 3 + state.density;
      return `${k} × ${k} × ${k}`;
    }
    const k = 7 + 2 * state.density;
    return `${k} × ${k}`;
  }

  function sync() {
    el('densityval').textContent = densityLabel();
    setRows({
      nOut: n().toFixed(3),
      vOut: `${visualC().toFixed(3)} u/t`,
      etaOut: `${eta().toFixed(1)} Ω`,
      lambdaOut: state.scene === 'dipole' ? `${lambda().toFixed(2)} u` : '—',
    });

    if (state.scene === 'statics') {
      const pos = charges.filter((c) => c.q > 0), neg = charges.filter((c) => c.q < 0);
      const qs = charges.map((c) => (c.q > 0 ? '+' : '−') + Math.abs(c.q).toFixed(1)).join('  ');
      setEq({
        rule: [
          ['\\mathbf E', E_COLOR],
          '=\\sum_i \\dfrac{q_i\\,\\hat{\\mathbf r}_i}{4\\pi\\varepsilon_0 r_i^{2}}',
          '\\qquad',
          ['\\mathbf B', B_COLOR],
          '=\\dfrac{\\mu_0 I}{2\\pi r}\\,\\hat{\\boldsymbol\\varphi}',
        ],
        live: [
          `\\text{lines} = ${linesPerQ()}\\,|q|`,
          `\\quad I \\text{ along } ${state.current > 0 ? '+y' : '-y'}`,
        ],
      });
      setResult({
        value: qs,
        status: `${pos.length} positive, ${neg.length} negative · current ${state.current > 0 ? 'up' : 'down'} the wire`,
        note: 'E lines start on + and end on −, or run off to infinity, and never cross. B lines close on themselves: there is no magnetic charge to start on.',
      });
      return;
    }

    setEq({
      rule: [
        ['\\mathbf E_{\\text{rad}}', E_COLOR],
        '\\propto \\dfrac{q\\,\\hat{\\mathbf n}\\times(\\hat{\\mathbf n}\\times\\mathbf a)}{v^{2}\\,r}\\Big|_{t-r/v}',
        '\\qquad',
        ['\\mathbf B', B_COLOR],
        '=\\dfrac{\\hat{\\mathbf n}\\times\\mathbf E}{v}',
      ],
      live: state.scene === 'dipole'
        ? [`v = \\dfrac{c}{n} = \\dfrac{c}{${n().toFixed(2)}}`, `\\quad \\lambda = \\dfrac{v}{f} = ${lambda().toFixed(2)}\\,\\text{u}`]
        : [`v = \\dfrac{c}{n} = \\dfrac{c}{${n().toFixed(2)}}`, `\\quad |\\mathbf a| = ${V.norm(charges[0]?.a ?? V.zero()).toFixed(2)}`],
    });
    setResult({
      value: `${(1 / n()).toFixed(3)} c`,
      status: state.scene === 'dipole'
        ? `n = ${n().toFixed(3)} · η = ${eta().toFixed(1)} Ω · λ = ${lambda().toFixed(2)} u (box ${2 * BOX} u)`
        : `n = ${n().toFixed(3)} · η = ${eta().toFixed(1)} Ω`,
      note: state.scene === 'dipole'
        ? 'The rings are one wavelength apart. Far out, E and B are at right angles to each other and to the direction of travel.'
        : 'Only an accelerating charge radiates; a still or steadily moving one just carries its Coulomb field along.',
    });
  }

  // --- controls -------------------------------------------------------------------

  function panelFor() {
    const statics = state.scene === 'statics';
    el('newq').hidden = !statics;
    el('flip').hidden = !statics;
    el('shake').hidden = state.scene !== 'charge';
    el('layout-wrap').hidden = statics;
    const look = looks();
    el('plane-wrap').hidden = !look.plane;
    el('look-wrap').hidden = statics;
    el('freq-wrap').hidden = state.scene !== 'dipole';
    el('fogop-wrap').hidden = !look.fog;
    el('lg-heat').hidden = !look.fog && !look.shade;
    // statics has no plane; without WebGL2 there is no fog
    const vb = (v: string) => el('view').querySelector(`[data-v="${v}"]`) as HTMLElement;
    vb('plane').hidden = vb('both').hidden = statics;
    if (!vol) vb('fog').hidden = vb('both').hidden = true;
    el('view-wrap').hidden = statics && !vol;
    views.select(statics ? (state.view === 'off' ? 'off' : 'fog') : state.view);
    el('result-label').textContent = statics ? 'Field lines' : 'Wave speed in this medium';
  }

  const tr = transport({
    onStep: () => { for (let i = 0; i < 4; i++) integrate(); draw(); },
    onReset: () => { setScene(state.scene); draw(); },
  });
  const scenes = segmented('scene', (s) => { setScene(s as Scene); draw(); });
  const fields = segmented('field', (v) => { state.fieldMode = v as typeof state.fieldMode; draw(); });
  const layouts = segmented('layout', (v) => { state.layout = v as typeof state.layout; panelFor(); draw(); });
  const planes = segmented('plane', (v) => { state.plane = v as typeof state.plane; draw(); });
  const setOffset = slider('offset', (v) => { state.planePos = v; draw(); }, (v) => v.toFixed(1));
  const setDensity = slider('density', (v) => { state.density = v; linesDirty = true; draw(); }, () => densityLabel());
  const views = segmented('view', (v) => {
    // in statics the only choices are fog or nothing; keep the plane choice for later
    if (state.scene !== 'statics' || v === 'off' || state.view === 'off' || state.view === 'plane') state.view = v as typeof state.view;
    panelFor();
    draw();
  });
  const setFogOp = slider('fogop', (v) => { state.fogOpacity = v; draw(); }, (v) => v.toFixed(2));
  check('fronts', (on) => { state.fronts = on; draw(); });
  const setEps = slider('eps', (v) => { state.epsR = v; draw(); }, (v) => v.toFixed(1));
  slider('mu', (v) => { state.muR = v; draw(); }, (v) => v.toFixed(1));
  slider('sigma', (v) => { state.sigma = v; draw(); }, (v) => v.toFixed(2));
  slider('freq', (v) => { state.freq = v; draw(); }, (v) => v.toFixed(2));

  el('shake').addEventListener('click', () => { shake(); draw(); });
  el('newq').addEventListener('click', () => { randomCharges(); draw(); });
  el('flip').addEventListener('click', () => { state.current *= -1; linesDirty = true; draw(); });

  function show(s: Scene, field: typeof state.fieldMode, layout: typeof state.layout, epsR = 1, view: typeof state.view = 'both') {
    state.layout = layout;
    layouts.select(layout);
    state.plane = 'xy';
    planes.select('xy');
    state.planePos = 0;
    setOffset(0);
    state.view = vol ? view : view === 'off' ? 'off' : 'plane';
    state.fogOpacity = 1;
    setFogOp(1);
    state.fieldMode = field;
    fields.select(field);
    state.epsR = epsR;
    setEps(epsR);
    scenes.select(s);
    setScene(s);
    tr.setRunning(true);
    draw();
  }

  tries({
    jiggle: () => { show('charge', 'e', 'plane'); shake(); },
    dipole: () => {
      state.density = 2;
      setDensity(2);
      show('dipole', 'both', 'volume', 1, 'fog');
      cam.pitch = -0.5;
    },
    medium: () => show('dipole', 'e', 'plane', 4),
    statics: () => {
      show('statics', 'both', 'plane');
      charges = [makeCharge(1, { x: -2.4, y: 0, z: 0 }), makeCharge(-2, { x: -0.6, y: 0, z: 0 })];
      state.selectedId = charges[0].id;
      linesDirty = true;
      draw();
    },
  });

  // --- pointer --------------------------------------------------------------------

  let dragging: Charge | null = null;
  let orbiting = false;
  let lastX = 0;
  let lastY = 0;

  // pointer position in the canvas' logical coordinate space (the same space
  // project() draws into), regardless of how the canvas is scaled on screen
  function toLocal(e: PointerEvent) {
    const rect = canvas.getBoundingClientRect();
    return { x: ((e.clientX - rect.left) / rect.width) * W, y: ((e.clientY - rect.top) / rect.height) * H };
  }

  canvas.addEventListener('contextmenu', (e) => e.preventDefault());

  canvas.addEventListener('pointerdown', (e) => {
    lastX = e.clientX;
    lastY = e.clientY;
    canvas.setPointerCapture(e.pointerId);
    if (e.button === 2 || e.altKey || e.shiftKey) { orbiting = true; return; }

    const loc = toLocal(e);
    let best: Charge | null = null, bestD = Infinity;
    for (const c of charges) {
      const p = project(c.p);
      const d = Math.hypot(loc.x - p.sx, loc.y - p.sy);
      if (d < bestD) { bestD = d; best = c; }
    }
    if (best && bestD < 34) {
      state.selectedId = best.id;
      toManual(best);
      best.shakeFrom = -1;
      dragging = best;
      return;
    }
    orbiting = true;
  });

  canvas.addEventListener('pointermove', (e) => {
    if (orbiting) {
      cam.yaw += (e.clientX - lastX) * 0.01;
      cam.pitch = Math.max(-1.45, Math.min(1.45, cam.pitch + (e.clientY - lastY) * 0.01));
      lastX = e.clientX;
      lastY = e.clientY;
      if (!tr.running() || state.scene === 'statics') draw();
      return;
    }
    const c = dragging;
    if (!c) return;
    // drag in a plane through the charge: the active arrow plane's orientation,
    // or facing the camera in the volume view
    const nrm = state.layout === 'plane' && state.scene !== 'statics' ? planeNormal() : camForward();
    const loc = toLocal(e);
    const p = hitPlane(loc.x, loc.y, c.p, nrm);
    if (!p) return;
    c.target = p;
    c.origin = { ...p };
    if (!tr.running() || state.scene === 'statics') {
      // paused, or static charges: jump there, as if it had always sat there
      c.p = { ...p };
      settle(c);
      moved++;
      linesDirty = true;
      draw();
    }
  });

  const stopDrag = () => { dragging = null; orbiting = false; };
  canvas.addEventListener('pointerup', stopDrag);
  canvas.addEventListener('pointercancel', stopDrag);

  canvas.addEventListener('wheel', (e) => {
    e.preventDefault();
    cam.zoom *= e.deltaY < 0 ? 1.1 : 1 / 1.1;
    cam.zoom = Math.max(0.35, Math.min(5.5, cam.zoom));
    if (!tr.running() || state.scene === 'statics') draw();
  }, { passive: false });

  let last = 0;
  function loop(ts: number) {
    const dt = last ? Math.min(0.1, (ts - last) / 1000) : 0;
    last = ts;
    if (tr.running() && state.scene !== 'statics') {
      advance(dt);
      draw();
    }
    requestAnimationFrame(loop);
  }

  setScene('charge');
  draw();
  requestAnimationFrame(loop);
</script>

<style>
  .em-canvas {
    cursor: grab;
    touch-action: none;
  }

  .em-canvas:active {
    cursor: grabbing;
  }
</style>
