---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Transport from '../../../components/sim/Transport.astro';
import Readout from '../../../components/sim/Readout.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="physics"
  title="Special Relativity"
  description="Space and time are one fabric. Boost to a moving frame and its grid skews: clocks tick slow, rulers shrink, and simultaneity comes apart. Yet every arrow in spacetime keeps one length that all observers agree on."
  shortcuts={['run', 'reset', 'fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="fv"
          width="900"
          height="660"
          role="img"
          aria-label="A spacetime diagram with the lab grid, the skewed grid of a boosted observer, the light cone, and either a draggable event or a four-vector read in both frames."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'ct′ axis (moving clock)', color: '#5eead4' },
          { label: 'x′ axis (moving now)', color: '#7c8cff' },
          { label: 'event / four-vector', color: '#f59e0b' },
          { label: 'invariant hyperbola', color: '#34d399' },
        ]}
        hint="Drag the event (or the arrowhead in Displacement). Run sweeps the observer's speed back and forth."
      />
      <Result label="Lorentz factor γ" />
    </div>

    <div class="sim-panel">
      <Seg
        id="mode"
        label="View"
        attr="m"
        options={[
          { value: 'grid', label: 'Grid / events' },
          { value: 'disp', label: 'Displacement' },
          { value: 'vel', label: 'Four-velocity' },
          { value: 'mom', label: 'Four-momentum' },
        ]}
      />
      <Slider id="b" label="Observer boost β = v/c" min={-0.88} max={0.88} step={0.01} value={0} display="0.00" />
      <div data-for="vel">
        <Slider id="u" label="Particle speed β<sub>u</sub>" min={-0.92} max={0.92} step={0.01} value={0.6} display="0.60" />
      </div>
      <div data-for="mom">
        <Slider id="e" label="Energy E" min={0.6} max={3.8} step={0.01} value={2} display="2.00" />
        <Slider id="m" label="Rest mass m" min={0} max={3} step={0.01} value={1.2} display="1.20" hint={['massless', 'heavy']} />
      </div>
      <Transport />
      <Readout
        title="Numbers"
        rows={[
          { id: 'r-g', label: 'Lorentz factor γ' },
          { id: 'r-lab', label: 'Lab components (ct, x)' },
          { id: 'r-mov', label: 'Boosted components (ct′, x′)' },
          { id: 'r-s2', label: 'Invariant s²' },
        ]}
      >
        <div class="readout" id="rows-extra"></div>
      </Readout>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Boost the observer. The indigo mesh and both primed axes <b>scissor toward the light cone</b>,
      but the dashed 45° cone never moves: light has one speed for everyone. <Try id="skew" label="Sweep" />
    </li>
    <li>
      Put the event on the lab x axis and boost. The lab calls it simultaneous with the origin, but the
      indigo line through it (the mover's "now") tilts away: <b>simultaneity is relative</b>. <Try id="simul" />
    </li>
    <li>
      The first tick of the moving clock sits at lab height γ (<b>time dilation</b>), while the amber rod,
      2 long in its own frame, covers only 2/γ of the lab x axis (<b>length contraction</b>). <Try id="dilate" />
    </li>
    <li>
      In <b>Displacement</b> the arrow never moves while its components change, and (ct)² − x² stays fixed:
      the minus sign makes the change in one square cancel the change in the other. Every reading lands on the
      same hyperbola. <Try id="invariant" label="Sweep" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { el, segmented, slider, transport, result, readout, tries } from '../../../lib/panel';

  type Mode = 'grid' | 'disp' | 'vel' | 'mom';

  const state = {
    mode: 'grid' as Mode,
    beta: 0,
    ubeta: 0.6,
    E: 2.0,
    m: 1.2,
    // draggable tip for displacement mode (lab coords: x, ct)
    dx: 1.1,
    dct: 2.6,
    // draggable event for grid mode
    ex: 2,
    ect: 1.2,
  };
  const ROD = 2; // proper length of the ruler that rides with the observer

  const canvas = el('fv') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const css = (n: string) => getComputedStyle(canvas).getPropertyValue(n).trim();
  const ink = () => css('--stage-ink') || '232,233,236';
  const inkInv = () => css('--stage-ink-inv') || '13,14,18';

  const ACC = '#7c8cff'; // x' axis, space component
  const TEAL = '#5eead4'; // ct' axis, time component
  const WARM = '#f59e0b'; // the four-vector / event / ruler
  const OUT = '#34d399'; // the invariant

  const O = { x: 330, y: 330 };
  const U = 66;
  const R = 4.2; // half-extent of the diagram, in units
  const COL = { x: 646, w: 226 }; // right-hand column
  const CB = COL.x + COL.w / 2; // baseline centre for signed bars
  const BAR = 100; // half-length of a full-scale bar

  const toPx = (x: number, ct: number) => ({ px: O.x + x * U, py: O.y - ct * U });

  function tint(hex: string, a: number) {
    const n = parseInt(hex.slice(1), 16);
    return `rgba(${(n >> 16) & 255},${(n >> 8) & 255},${n & 255},${a})`;
  }
  function text(t: string, x: number, y: number, a = 0.55, al: CanvasTextAlign = 'left', size = 12, weight = '', colour = '') {
    ctx.fillStyle = colour || `rgba(${ink()},${a})`;
    ctx.font = `${weight} ${size}px ui-monospace, monospace`.trim();
    ctx.textAlign = al;
    ctx.fillText(t, x, y);
    ctx.textAlign = 'left';
  }
  function line(a: { px: number; py: number }, b: { px: number; py: number }) {
    ctx.beginPath();
    ctx.moveTo(a.px, a.py);
    ctx.lineTo(b.px, b.py);
    ctx.stroke();
  }

  // --- the vector, per mode -------------------------------------------------
  // Everything is returned in lab components (v0 = time part, v1 = space part).
  type Vec = { v0: number; v1: number; name: string; t0: string; t1: string };

  function vec(): Vec {
    if (state.mode === 'vel') {
      const g = 1 / Math.sqrt(1 - state.ubeta * state.ubeta);
      return { v0: g, v1: g * state.ubeta, name: 'Uᵘ', t0: 'γc', t1: 'γv' };
    }
    if (state.mode === 'mom') {
      const m = Math.min(state.m, state.E);
      const p = Math.sqrt(Math.max(0, state.E * state.E - m * m));
      return { v0: state.E, v1: p, name: 'Pᵘ', t0: 'E/c', t1: 'p' };
    }
    if (state.mode === 'grid') return { v0: state.ect, v1: state.ex, name: 'event', t0: 'ct', t1: 'x' };
    return { v0: state.dct, v1: state.dx, name: 'Δsᵘ', t0: 'cΔt', t1: 'Δx' };
  }

  const gamma = () => 1 / Math.sqrt(1 - state.beta * state.beta);
  /** Components the boosted observer reads. */
  function primed(v: Vec) {
    const g = gamma(), b = state.beta;
    return { p0: g * (v.v0 - b * v.v1), p1: g * (v.v1 - b * v.v0) };
  }
  /** A point given in the boosted frame, placed on the lab diagram. */
  const fromPrimed = (xp: number, ctp: number) => {
    const g = gamma(), b = state.beta;
    return toPx(g * (xp + b * ctp), g * (ctp + b * xp));
  };

  // --- diagram --------------------------------------------------------------
  function clipDiagram() {
    ctx.save();
    ctx.beginPath();
    ctx.rect(O.x - R * U - 2, O.y - R * U - 2, 2 * R * U + 4, 2 * R * U + 4);
    ctx.clip();
  }

  function drawGrid() {
    ctx.strokeStyle = `rgba(${ink()},0.09)`;
    ctx.lineWidth = 1;
    for (let n = -4; n <= 4; n++) {
      line(toPx(n, -R), toPx(n, R));
      line(toPx(-R, n), toPx(R, n));
    }
    ctx.strokeStyle = `rgba(${ink()},0.28)`;
    ctx.lineWidth = 1.4;
    line(toPx(-R, 0), toPx(R, 0));
    line(toPx(0, -R), toPx(0, R));
  }

  /** The moving observer's own grid: lines of constant x′ and constant ct′. */
  function drawMesh() {
    const L = 2 * R;
    ctx.strokeStyle = tint(ACC, 0.28);
    ctx.lineWidth = 1;
    for (let n = -8; n <= 8; n++) {
      line(fromPrimed(n, -L), fromPrimed(n, L));
      line(fromPrimed(-L, n), fromPrimed(L, n));
    }
  }

  function drawCone() {
    ctx.strokeStyle = `rgba(${ink()},0.42)`;
    ctx.setLineDash([6, 5]);
    ctx.lineWidth = 1.5;
    for (const s of [1, -1]) line(toPx(-R, -R * s), toPx(R, R * s));
    ctx.setLineDash([]);
  }

  /** The curve of every tip sharing this invariant: all observers land on it. */
  function drawHyperbola(s2: number, up: boolean, right: boolean, alpha = 0.55) {
    if (Math.abs(s2) < 0.004) return;
    ctx.strokeStyle = tint(OUT, alpha);
    ctx.lineWidth = 1.6;
    ctx.beginPath();
    const N = 200;
    for (let i = 0; i <= N; i++) {
      const t = -R + (2 * R * i) / N;
      const pt = s2 > 0
        ? toPx(t, (up ? 1 : -1) * Math.sqrt(s2 + t * t))
        : toPx((right ? 1 : -1) * Math.sqrt(-s2 + t * t), t);
      i === 0 ? ctx.moveTo(pt.px, pt.py) : ctx.lineTo(pt.px, pt.py);
    }
    ctx.stroke();
  }

  function drawPrimedAxes() {
    const g = gamma(), b = state.beta;
    // basis vectors of the boosted frame, written in lab coordinates (x, ct)
    const et = { x: g * b, ct: g }; // one tick of ct'
    const ex = { x: g, ct: g * b }; // one tick of x'
    const axis = (d: { x: number; ct: number }, color: string, label: string) => {
      const k = R / Math.max(Math.abs(d.x), Math.abs(d.ct));
      ctx.strokeStyle = tint(color, 0.85);
      ctx.lineWidth = 2.2;
      line(toPx(-d.x * k, -d.ct * k), toPx(d.x * k, d.ct * k));
      // unit ticks along the axis
      ctx.fillStyle = tint(color, 0.7);
      for (let n = 1; n <= 4; n++) {
        for (const s of [1, -1]) {
          const t = toPx(s * n * d.x, s * n * d.ct);
          ctx.beginPath(); ctx.arc(t.px, t.py, 2, 0, Math.PI * 2); ctx.fill();
        }
      }
      const tip = toPx(d.x * k * 0.92, d.ct * k * 0.92);
      ctx.fillStyle = tint(color, 1);
      ctx.font = '600 13px ui-monospace, monospace';
      ctx.fillText(label, tip.px + 8, tip.py - 4);
    };
    axis(et, TEAL, 'ct′');
    axis(ex, ACC, 'x′');
    return { et, ex };
  }

  function arrow(fx: number, fy: number, tx: number, ty: number, color: string, w = 2.6) {
    const a = Math.atan2(ty - fy, tx - fx);
    const len = Math.hypot(tx - fx, ty - fy);
    if (len < 1) return;
    const head = Math.min(13, len * 0.4);
    ctx.strokeStyle = color;
    ctx.lineWidth = w;
    ctx.beginPath();
    ctx.moveTo(fx, fy);
    ctx.lineTo(tx - Math.cos(a) * head * 0.8, ty - Math.sin(a) * head * 0.8);
    ctx.stroke();
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.moveTo(tx, ty);
    ctx.lineTo(tx - Math.cos(a - 0.4) * head, ty - Math.sin(a - 0.4) * head);
    ctx.lineTo(tx - Math.cos(a + 0.4) * head, ty - Math.sin(a + 0.4) * head);
    ctx.closePath();
    ctx.fill();
  }

  function axisLabels() {
    text('x (space) →', O.x + R * U, O.y + 20, 0.4, 'right', 11);
    text('↑ ct (time)', O.x + 10, O.y - R * U + 4, 0.4, 'left', 11);
  }

  /** One arrow, its shadows on the boosted axes, and the hyperbola it rides. */
  function drawVectorDiagram(v: Vec, s2: number) {
    clipDiagram();
    drawGrid();
    drawHyperbola(s2, v.v0 >= 0, v.v1 >= 0);
    drawCone();
    const { et, ex } = drawPrimedAxes();

    const tip = toPx(v.v1, v.v0);
    const { p0, p1 } = primed(v);

    // the parallelogram that reads the components off the boosted axes
    const A = toPx(p0 * et.x, p0 * et.ct); // foot on the ct′ axis
    const B = toPx(p1 * ex.x, p1 * ex.ct); // foot on the x′ axis
    ctx.setLineDash([4, 4]);
    ctx.lineWidth = 1.4;
    ctx.strokeStyle = tint(TEAL, 0.65);
    line(tip, A);
    ctx.strokeStyle = tint(ACC, 0.65);
    line(tip, B);
    ctx.setLineDash([]);
    for (const [pt, col] of [[A, TEAL], [B, ACC]] as const) {
      ctx.fillStyle = tint(col, 1);
      ctx.beginPath(); ctx.arc(pt.px, pt.py, 4.5, 0, Math.PI * 2); ctx.fill();
    }

    // the component pair, replotted on the lab grid: it rides the hyperbola
    const gh = toPx(p1, p0);
    ctx.strokeStyle = tint(OUT, 0.9);
    ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(gh.px, gh.py, 6, 0, Math.PI * 2); ctx.stroke();

    // the four-vector, drawn last so it sits on top
    const org = toPx(0, 0);
    arrow(org.px, org.py, tip.px, tip.py, tint(WARM, 1), 3);
    ctx.restore();

    ctx.fillStyle = tint(WARM, 1);
    ctx.font = '600 14px ui-monospace, monospace';
    ctx.fillText(v.name, tip.px + 11, tip.py - 9);
    axisLabels();
  }

  /** The moving observer's mesh, a draggable event, a moving clock and a moving rod. */
  function drawGridDiagram(v: Vec) {
    const g = gamma(), b = state.beta;
    const { p0: ctp, p1: xp } = primed(v);
    clipDiagram();
    drawGrid();
    drawMesh();

    // the rod rests in the moving frame between x′ = 0 and x′ = ROD: its worldsheet
    ctx.fillStyle = tint(WARM, 0.08);
    ctx.beginPath();
    const c1 = fromPrimed(0, -3 * R), c2 = fromPrimed(0, 3 * R), c3 = fromPrimed(ROD, 3 * R), c4 = fromPrimed(ROD, -3 * R);
    ctx.moveTo(c1.px, c1.py); ctx.lineTo(c2.px, c2.py); ctx.lineTo(c3.px, c3.py); ctx.lineTo(c4.px, c4.py);
    ctx.closePath();
    ctx.fill();
    ctx.strokeStyle = tint(WARM, 0.35);
    ctx.lineWidth = 1;
    line(c3, c4);

    // the unit hyperbola: every observer's first clock tick sits on it
    drawHyperbola(1, true, true, 0.4);
    drawCone();
    drawPrimedAxes();

    // time dilation: the moving clock's tick ct′ = 1 is at lab height γ
    const tick = fromPrimed(0, 1);
    ctx.strokeStyle = tint(TEAL, 0.8);
    ctx.setLineDash([3, 3]);
    ctx.lineWidth = 1.2;
    line(tick, toPx(0, g));
    ctx.setLineDash([]);
    ctx.fillStyle = tint(TEAL, 1);
    ctx.beginPath(); ctx.arc(tick.px, tick.py, 5, 0, Math.PI * 2); ctx.fill();
    const onAxis = toPx(0, g);
    ctx.fillRect(onAxis.px - 6, onAxis.py - 1.5, 12, 3);
    text(`ct = γ = ${g.toFixed(2)}`, onAxis.px + (b >= 0 ? -10 : 10), onAxis.py - 6, 1, b >= 0 ? 'right' : 'left', 11, '600', tint(TEAL, 1));

    // length contraction: at lab time ct = 0 the rod spans only ROD/γ
    const r0 = toPx(0, 0), r1 = toPx(ROD / g, 0);
    ctx.strokeStyle = tint(WARM, 1);
    ctx.lineWidth = 6;
    ctx.lineCap = 'round';
    line(r0, r1);
    // along the mover's own now (ct′ = 0) it is the full ROD
    ctx.strokeStyle = tint(ACC, 0.9);
    ctx.lineWidth = 3;
    line(fromPrimed(0, 0), fromPrimed(ROD, 0));
    ctx.lineCap = 'butt';
    text(`L = ${ROD}/γ = ${(ROD / g).toFixed(2)}`, (r0.px + r1.px) / 2, r0.py + 20, 1, 'center', 11, '600', tint(WARM, 1));

    // lines of simultaneity through the event: the lab's (flat) and the mover's (tilted)
    const ep = toPx(v.v1, v.v0);
    ctx.setLineDash([5, 4]);
    ctx.lineWidth = 1.4;
    ctx.strokeStyle = `rgba(${ink()},0.45)`;
    line(toPx(-R, v.v0), toPx(R, v.v0));
    ctx.strokeStyle = tint(ACC, 0.95);
    line(fromPrimed(-3 * R, ctp), fromPrimed(3 * R, ctp));
    // and where it is for the mover: a line of constant x′
    ctx.strokeStyle = tint(TEAL, 0.45);
    ctx.lineWidth = 1;
    line(fromPrimed(xp, -3 * R), fromPrimed(xp, 3 * R));
    ctx.setLineDash([]);

    // the lab's and the mover's "now" at the event cut the time axes here
    const labNow = toPx(0, v.v0), movNow = fromPrimed(0, ctp);
    ctx.fillStyle = `rgba(${ink()},0.7)`;
    ctx.beginPath(); ctx.arc(labNow.px, labNow.py, 3, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = tint(ACC, 1);
    ctx.beginPath(); ctx.arc(movNow.px, movNow.py, 3.5, 0, Math.PI * 2); ctx.fill();

    ctx.fillStyle = tint(WARM, 1);
    ctx.strokeStyle = `rgba(${inkInv()},0.75)`;
    ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(ep.px, ep.py, 7, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
    ctx.restore();

    text('event', ep.px + 11, ep.py - 9, 1, 'left', 13, '600', tint(WARM, 1));
    axisLabels();
  }

  // --- component bars -------------------------------------------------------
  function bar(y: number, value: number, scale: number, color: string, label: string) {
    const w = Math.max(-BAR, Math.min(BAR, value * scale));
    ctx.fillStyle = `rgba(${ink()},0.07)`;
    ctx.fillRect(CB - BAR, y - 9, BAR * 2, 18);
    ctx.fillStyle = tint(color, 0.9);
    ctx.fillRect(CB, y - 9, w, 18);
    ctx.strokeStyle = `rgba(${ink()},0.3)`;
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(CB, y - 12); ctx.lineTo(CB, y + 12); ctx.stroke();
    text(label, COL.x, y - 15, 0.45, 'left', 11);
    text(value.toFixed(3), COL.x + COL.w, y - 15, 0.8, 'right', 11, '600');
  }

  function drawColumn(v: Vec, s2: number) {
    const { p0, p1 } = primed(v);
    const s = Math.sqrt(Math.abs(s2));
    const mx = Math.max(1.2, Math.abs(v.v0), Math.abs(v.v1), Math.abs(p0), Math.abs(p1), s);
    const scale = BAR / mx;

    ctx.strokeStyle = `rgba(${ink()},0.12)`;
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(COL.x - 22, 60); ctx.lineTo(COL.x - 22, H - 60); ctx.stroke();

    text('LAB FRAME', COL.x, 84, 0.5, 'left', 11, '600');
    bar(122, v.v0, scale, TEAL, v.t0);
    bar(168, v.v1, scale, ACC, v.t1);

    text(`OBSERVER AT β = ${state.beta.toFixed(2)}`, COL.x, 244, 0.5, 'left', 11, '600');
    bar(282, p0, scale, TEAL, v.t0 + '′');
    bar(328, p1, scale, ACC, v.t1 + '′');

    if (state.mode === 'grid') {
      const g = gamma();
      text('MOVING CLOCK', COL.x, 404, 0.5, 'left', 11, '600');
      text(`1 tick of ct′ = ${g.toFixed(3)} of ct`, COL.x, 426, 0.8, 'left', 11, '600', tint(TEAL, 1));
      text('time dilation: it runs slow by γ', COL.x, 446, 0.45, 'left', 11);
      text('MOVING ROD', COL.x, 488, 0.5, 'left', 11, '600');
      text(`own length L₀ = ${ROD.toFixed(3)}`, COL.x, 510, 0.8, 'left', 11, '600', tint(ACC, 1));
      text(`lab length L = ${(ROD / g).toFixed(3)}`, COL.x, 530, 0.8, 'left', 11, '600', tint(WARM, 1));
      text('length contraction: L = L₀/γ', COL.x, 550, 0.45, 'left', 11);
      return;
    }

    text('INVARIANT LENGTH', COL.x, 424, 0.5, 'left', 11, '600');
    ctx.fillStyle = `rgba(${ink()},0.07)`;
    ctx.fillRect(COL.x, 452, COL.w, 20);
    ctx.fillStyle = tint(OUT, 0.9);
    ctx.fillRect(COL.x, 452, Math.min(COL.w, s * scale), 20);
    text(s2 >= 0 ? s.toFixed(3) : `${s.toFixed(3)} (spacelike)`, COL.x, 446, 0.8, 'left', 11, '600');

    const kind = state.mode === 'disp'
      ? (s2 > 0.004 ? 'proper time cΔτ' : s2 < -0.004 ? 'proper length' : 'lightlike, zero')
      : state.mode === 'vel'
        ? 'always c, for everyone'
        : 'the rest mass mc';
    text(kind, COL.x, 490, 0.45, 'left', 11);
    text('s² = (ct)² − x²', COL.x, 516, 0.5, 'left', 12, '600');
    text(`= ${(v.v0 * v.v0).toFixed(2)} − ${(v.v1 * v.v1).toFixed(2)} = ${s2.toFixed(3)}`, COL.x, 536, 0.45, 'left', 11);
    text(`= ${(p0 * p0).toFixed(2)} − ${(p1 * p1).toFixed(2)} = ${(p0 * p0 - p1 * p1).toFixed(3)}`, COL.x, 556, 0.45, 'left', 11);
    text('same number, different reader', COL.x, 580, 0.4, 'left', 11);
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    const v = vec();
    const s2 = v.v0 * v.v0 - v.v1 * v.v1;
    text(state.mode === 'grid' ? 'TWO GRIDS, ONE SPACETIME' : 'ONE ARROW, MANY READINGS', 40, 42, 0.5, 'left', 12, '600');
    if (state.mode === 'grid') drawGridDiagram(v);
    else drawVectorDiagram(v, s2);
    drawColumn(v, s2);
    sync(v, s2);
  }

  // --- the words and numbers ------------------------------------------------
  const setEq = equation();
  const setResult = result();
  const setRows = readout();
  const extra = el('rows-extra');
  let lastExtra = '';
  const row = (a: string, b: string) => `<div class="row"><span>${a}</span><b>${b}</b></div>`;
  const f2 = (x: number) => x.toFixed(2);

  function sync(v: Vec, s2: number) {
    const g = gamma(), b = state.beta;
    const { p0, p1 } = primed(v);
    setRows({
      'r-g': g.toFixed(3),
      'r-lab': `(${f2(v.v0)}, ${f2(v.v1)})`,
      'r-mov': `(${f2(p0)}, ${f2(p1)})`,
      'r-s2': s2.toFixed(3),
    });

    let html = '';
    if (state.mode === 'grid') {
      html =
        row('Moving clock tick, in lab time', g.toFixed(3)) +
        row(`Rod length (own ${ROD})`, (ROD / g).toFixed(3));
    } else if (state.mode === 'disp') {
      html = row('Character', s2 > 0.004 ? 'timelike' : s2 < -0.004 ? 'spacelike' : 'lightlike');
      if (s2 > 0.004) html += row('Proper time cΔτ', Math.sqrt(s2).toFixed(3));
    } else if (state.mode === 'vel') {
      const gu = 1 / Math.sqrt(1 - state.ubeta * state.ubeta);
      html = row('Particle γ', gu.toFixed(3)) + row('U·U', s2.toFixed(3) + ' = c²');
    } else {
      html =
        row('Momentum p', v.v1.toFixed(3)) +
        row('Speed p/E', state.E > 0 ? (v.v1 / state.E).toFixed(3) : '—') +
        row('E² − p²', s2.toFixed(3) + ' = m²');
    }
    if (html !== lastExtra) { extra.innerHTML = html; lastExtra = html; }

    if (state.mode === 'grid') {
      el('result-label').textContent = 'Lorentz factor γ';
      setEq({
        rule: [
          ["ct' = \\gamma\\,(ct - \\beta x)", TEAL],
          ',\\quad',
          ["x' = \\gamma\\,(x - \\beta\\,ct)", ACC],
          ',\\quad \\gamma = 1/\\sqrt{1-\\beta^2}',
        ],
        live: [
          `\\beta = ${b.toFixed(2)},\\ \\gamma = ${g.toFixed(3)}:\\quad`,
          [`(ct, x) = (${f2(v.v0)}, ${f2(v.v1)})`, WARM],
          '\\ \\mapsto\\ ',
          [`(${f2(p0)},`, TEAL],
          [`\\,${f2(p1)})`, ACC],
        ],
      });
      setResult({
        value: g.toFixed(3),
        status: `The event is at ct = ${f2(v.v0)}, x = ${f2(v.v1)} in the lab and ct′ = ${f2(p0)}, x′ = ${f2(p1)} for the moving observer`,
        note: `The moving clock ticks once per ${g.toFixed(2)} lab units and the moving rod measures ${(ROD / g).toFixed(2)} instead of ${ROD}. The two grids disagree on time and distance but agree on (ct)² − x² = ${s2.toFixed(2)}.`,
      });
      return;
    }

    const name = state.mode === 'disp' ? '\\Delta s^2' : state.mode === 'vel' ? 'U\\cdot U' : 'P\\cdot P';
    const t0 = state.mode === 'disp' ? '(c\\Delta t)^2' : state.mode === 'vel' ? '(\\gamma_u c)^2' : '(E/c)^2';
    const t1 = state.mode === 'disp' ? '\\Delta x^2' : state.mode === 'vel' ? '(\\gamma_u v)^2' : 'p^2';
    const tail = state.mode === 'vel' ? '= c^2' : state.mode === 'mom' ? '= (mc)^2' : '';
    el('result-label').textContent = 'Invariant length s²';
    setEq({
      rule: [[name, OUT], '=', [t0, TEAL], '-', [t1, ACC], tail],
      live: [
        [`${f2(v.v0)}^2`, TEAL], '-', [`${f2(v.v1)}^2`, ACC], '=',
        [`${f2(p0)}^2`, TEAL], '-', [`${f2(p1)}^2`, ACC], '=',
        [s2.toFixed(3), OUT],
      ],
    });
    setResult({
      value: s2.toFixed(3),
      colour: OUT,
      status: `γ = ${g.toFixed(3)} · lab reads (${f2(v.v0)}, ${f2(v.v1)}) · the boosted observer reads (${f2(p0)}, ${f2(p1)}) · both give ${(p0 * p0 - p1 * p1).toFixed(3)}`,
      note: 'Every observer sees different components, and every observer computes the same (ct)² − x². That is what makes it a four-vector.',
    });
  }

  // --- controls -------------------------------------------------------------
  function syncVisibility() {
    document.querySelectorAll<HTMLElement>('[data-for]').forEach((n) => {
      n.style.display = n.dataset.for === state.mode ? '' : 'none';
    });
  }

  const modes = segmented('mode', (m) => { state.mode = m as Mode; syncVisibility(); draw(); });
  const setB = slider('b', (v) => { state.beta = v; draw(); }, (v) => v.toFixed(2));
  const setU = slider('u', (v) => { state.ubeta = v; draw(); }, (v) => v.toFixed(2));
  const setE = slider('e', (v) => { state.E = v; draw(); }, (v) => v.toFixed(2));
  const setM = slider('m', (v) => { state.m = v; draw(); }, (v) => v.toFixed(2));

  // sweep the observer so the arrow's stubbornness is impossible to miss
  let raf = 0, t0 = 0;
  function loop(now: number) {
    const b = 0.88 * Math.sin((now - t0) / 1400);
    state.beta = b;
    setB(+b.toFixed(2));
    draw();
    raf = requestAnimationFrame(loop);
  }
  function start() {
    cancelAnimationFrame(raf);
    // start the sine where the slider is now, so the sweep does not jump
    t0 = performance.now() - 1400 * Math.asin(Math.max(-1, Math.min(1, state.beta / 0.88)));
    raf = requestAnimationFrame(loop);
  }
  function stop() { cancelAnimationFrame(raf); raf = 0; }

  const tp = transport({
    onRun: (on) => (on ? start() : stop()),
    onReset: () => {
      stop();
      tp.setRunning(false);
      Object.assign(state, { beta: 0, ubeta: 0.6, E: 2, m: 1.2, dx: 1.1, dct: 2.6, ex: 2, ect: 1.2 });
      setB(0); setU(0.6); setE(2); setM(1.2);
      draw();
    },
  });
  // any hand on the boost slider takes over from the sweep
  el('b').addEventListener('input', () => { if (tp.running()) { stop(); tp.setRunning(false); } });

  // --- dragging the event / arrowhead ---------------------------------------
  let dragging = false;
  function setTip(e: PointerEvent) {
    const rect = canvas.getBoundingClientRect();
    const mx = ((e.clientX - rect.left) / rect.width) * W;
    const my = ((e.clientY - rect.top) / rect.height) * H;
    const x = Math.max(-R, Math.min(R, (mx - O.x) / U));
    const ct = Math.max(-R, Math.min(R, (O.y - my) / U));
    if (state.mode === 'grid') { state.ex = x; state.ect = ct; }
    else { state.dx = x; state.dct = ct; }
    draw();
  }
  canvas.addEventListener('pointerdown', (e) => {
    if (state.mode !== 'grid' && state.mode !== 'disp') return;
    const rect = canvas.getBoundingClientRect();
    const mx = ((e.clientX - rect.left) / rect.width) * W;
    if (mx > O.x + R * U + 10) return; // clicks on the readout column do nothing
    dragging = true;
    canvas.setPointerCapture(e.pointerId);
    setTip(e);
  });
  canvas.addEventListener('pointermove', (e) => dragging && setTip(e));
  const release = () => (dragging = false);
  canvas.addEventListener('pointerup', release);
  canvas.addEventListener('pointercancel', release);

  // --- what to observe ------------------------------------------------------
  function show(mode: Mode, beta: number, sweep = false) {
    stop();
    state.mode = mode;
    modes.select(mode);
    syncVisibility();
    state.beta = beta;
    setB(beta);
    tp.setRunning(sweep);
    if (sweep) start();
    draw();
  }
  tries({
    skew: () => show('grid', 0, true),
    simul: () => { state.ex = 2.5; state.ect = 0; show('grid', 0.5); },
    dilate: () => { state.ex = 2; state.ect = 1.2; show('grid', 0.8); },
    invariant: () => { state.dx = 1.1; state.dct = 2.6; show('disp', 0, true); },
  });

  syncVisibility();
  draw();
</script>

<style>
  #fv {
    cursor: crosshair;
    touch-action: none;
  }
</style>
