---
import SimLayout from '../../../layouts/SimLayout.astro';
import Transport from '../../../components/sim/Transport.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Checks from '../../../components/sim/Checks.astro';
import Readout from '../../../components/sim/Readout.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="physics"
  title="Ideal Gas"
  description="A few hundred argon atoms in a glass cylinder under a piston, and nothing else. Pressure is the drumming of their impacts, temperature is how fast they fly, and PV = NkT is not a law you have to be told: it is what the counting adds up to."
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas id="gas" class="gas-canvas" width="1000" height="640" role="img" aria-label="Argon atoms flying inside a glass cylinder closed by a piston above and a heater plate below, coloured from blue when slow to red when fast. Beside it a pressure gauge, a thermometer and a small plot that shows either the P-V path or the speed histogram against the Maxwell-Boltzmann curve."></canvas>
      </div>
      <Caption
        legend={[
          { label: 'slow atom', color: '#4078ff' },
          { label: 'fast atom', color: '#ff4050' },
          { label: 'wall hit', color: '#f59e0b' },
          { label: 'NkT/V', color: '#34d399' },
        ]}
        hint="Drag the piston to squeeze or expand · drag anywhere else to orbit · scroll to zoom · click the plot to switch it. The atoms are hard spheres 0.5 nm across with the mass of argon, in a cylinder 24 nm wide. Because they take up a little room themselves, a hard squeeze reads a few percent above NkT/V."
      />
      <Result label="Pressure, measured" />
    </div>

    <div class="sim-panel">
      <Transport step running />
      <Seg
        id="walls"
        label="Heater plate"
        attr="w"
        options={[
          { value: 'bath', label: 'Held at T' },
          { value: 'insulated', label: 'Insulated' },
        ]}
      />
      <Slider id="temp" label="Plate temperature" min={50} max={1200} step={10} value={300} display="300 K" hint={['cold', 'hot']} />
      <Slider id="piston" label="Piston height" min={8} max={30} step={0.5} value={30} display="30.0 nm" hint={['squeezed', 'roomy']} />
      <Slider id="n" label="Atoms N" min={50} max={600} step={10} value={300} />
      <Seg
        id="plot"
        label="Side plot"
        attr="p"
        options={[
          { value: 'pv', label: 'P-V path' },
          { value: 'speed', label: 'Speeds' },
        ]}
      />
      <Slider id="rate" label="Time rate" min={0.25} max={2} step={0.25} value={1} display="1.00× (100 ps/s)" />
      <Checks
        items={[
          { id: 'sparks', label: 'Spark at every wall hit', checked: true },
          { id: 'trail', label: 'Trace one atom' },
        ]}
      />
      <Readout
        title="Numbers"
        rows={[
          { id: 'r-p', label: 'Pressure, measured' },
          { id: 'r-law', label: 'NkT/V' },
          { id: 'r-ratio', label: 'Ratio (10 s average)' },
          { id: 'r-t', label: 'Gas temperature' },
          { id: 'r-plate', label: 'Plate temperature' },
          { id: 'r-v', label: 'Volume V' },
          { id: 'r-vrms', label: 'Speed v<sub>rms</sub>' },
          { id: 'r-hits', label: 'Wall hits per ns' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      With the plate held at T, push the piston from 30 nm down to 15. Once the plate has
      taken back the heat of squeezing, the atoms fly as fast as before but hit a box half
      the size twice as often: <b>P doubles when V halves</b>, back on the isotherm. <Try id="boyle" />
    </li>
    <li>
      Insulate the plate and squeeze to a third. Atoms bounce off the advancing piston
      faster, like a ball off a swung bat: the gas <b>heats up</b> by about 2× and glows
      hotter, and its path climbs close to the steeper adiabat. <Try id="adiabat" />
    </li>
    <li>
      Hold the piston still and turn the plate from 300 K up to 900 K. Faster atoms hit
      harder and more often, so the pressure <b>triples</b> with the temperature. <Try id="heat" />
    </li>
    <li>
      Reset starts every atom at the <b>same speed</b>. Collisions alone spread the
      histogram onto the <b>Maxwell-Boltzmann</b> curve within seconds; the traced atom
      shows the zigzag of collisions doing it. <Try id="mb" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { segmented, slider, check, transport, result, readout, tries } from '../../../lib/panel';
  import { Camera3D, orbitControls, drawBackdrop, V, type Vec, type Projected } from '../../../lib/scene3d';

  // --- physics ---------------------------------------------------------------
  // Hard spheres with the mass of argon in a cylinder, in nanometres and
  // picoseconds (so velocities are in nm/ps = km/s). R and h bound where the
  // atom centres can go, which is the volume the gas law is about; the glass
  // and the piston are drawn half an atom further out.
  const KB = 1.380649e-23;
  const MASS = 6.6335e-26; // kg, argon
  const KM = (KB / MASS) * 1e-6; // kT/m in (nm/ps)² per kelvin
  const PA = MASS * 1e33; // (nm/ps) / (nm² · ps) of impulse flux → pascals
  const A_R = 0.25; // atom radius, nm
  const D = 2 * A_R;
  const R = 12; // cylinder radius for the centres, nm
  const HMIN = 8, HMAX = 30;
  const DT = 0.1; // ps per integration step
  const BASE = 100; // ps of gas time per second of watching, at 1×
  // The piston is held to 30 m/s, slow next to the atoms' 400 m/s. In a box
  // this small an atom crosses it between collisions, so a faster piston
  // pumps in noticeably more energy than the reversible adiabat allows.
  const PISTON_MAX = 0.03; // nm/ps
  const TAU_FAST = 150, TAU_SLOW = 1000; // ps, gauge and ratio averages
  const MAXN = 600;

  const X = new Float64Array(MAXN), Y = new Float64Array(MAXN), Z = new Float64Array(MAXN);
  const VX = new Float64Array(MAXN), VY = new Float64Array(MAXN), VZ = new Float64Array(MAXN);

  const state = {
    n: 300,
    temp: 300,
    walls: 'bath' as 'bath' | 'insulated',
    target: 30, // where the piston is asked to go, nm
    h: 30, // where it is
    u: 0, // its velocity, nm/ps
    rate: 1,
    running: true,
    sparks: true,
    trail: false,
    plot: 'pv' as 'pv' | 'speed',
  };

  // measured and predicted pressure, both averaged the same way
  const avg = { pf: 0, lf: 0, ps: 0, ls: 0, t: 0, T: 300, hits: 0, hitT: 0, hitRate: 0 };
  let simT = 0;

  const volume = (h = state.h) => Math.PI * R * R * h; // nm³
  const area = () => 2 * Math.PI * R * state.h + 2 * Math.PI * R * R;

  function gauss() {
    return Math.sqrt(-2 * Math.log(1 - Math.random())) * Math.cos(2 * Math.PI * Math.random());
  }
  function kinT() {
    let s = 0;
    for (let i = 0; i < state.n; i++) s += VX[i] * VX[i] + VY[i] * VY[i] + VZ[i] * VZ[i];
    return state.n ? s / state.n / (3 * KM) : 0;
  }

  /** A fresh gas: random non-overlapping places, every atom at the same speed. */
  function build() {
    const N = state.n;
    state.h = state.target;
    state.u = 0;
    const v0 = Math.sqrt(3 * KM * state.temp);
    for (let i = 0; i < N; i++) {
      for (let tries = 0; tries < 200; tries++) {
        const r = (R - 0.01) * Math.sqrt(Math.random()), a = Math.random() * 2 * Math.PI;
        const x = r * Math.cos(a), z = r * Math.sin(a), y = Math.random() * state.h;
        let ok = true;
        for (let j = 0; j < i && ok; j++) {
          const dx = X[j] - x, dy = Y[j] - y, dz = Z[j] - z;
          if (dx * dx + dy * dy + dz * dz < D * D * 1.2) ok = false;
        }
        X[i] = x; Y[i] = y; Z[i] = z;
        if (ok) break;
      }
      // a uniformly random direction
      const cz = 2 * Math.random() - 1, ph = 2 * Math.PI * Math.random(), sz = Math.sqrt(1 - cz * cz);
      VX[i] = v0 * sz * Math.cos(ph);
      VY[i] = v0 * cz;
      VZ[i] = v0 * sz * Math.sin(ph);
    }
    const T = kinT();
    const law = (N * T) / volume() * KB * 1e27;
    Object.assign(avg, { pf: law, lf: law, ps: law, ls: law, t: 0, T, hits: 0, hitT: 0, hitRate: 0 });
    simT = 0;
    sparks.length = 0;
    trail.length = 0;
    path.length = 0;
    histEMA.fill(0);
    histFresh = true;
  }

  type Spark = { x: number; y: number; z: number; life: number };
  const sparks: Spark[] = [];
  function spark(x: number, y: number, z: number) {
    if (!state.sparks || sparks.length > 220 || Math.random() > 0.5) return;
    sparks.push({ x, y, z, life: 1 });
  }

  /** The heater plate re-emits an atom from its own temperature, flux weighted. */
  function plateBounce(i: number) {
    const vp = Math.sqrt(KM * state.temp);
    VY[i] = vp * Math.sqrt(-2 * Math.log(1 - Math.random() * 0.999999));
    VX[i] = vp * gauss();
    VZ[i] = vp * gauss();
  }

  // cell list for the atom-atom collisions
  const CS = 1; // nm, at least one diameter
  const GX = Math.ceil((2 * R + 2) / CS), GY = Math.ceil((HMAX + 2) / CS);
  const head = new Int32Array(GX * GY * GX), next = new Int32Array(MAXN);
  const cellOf = (x: number, y: number, z: number) => {
    const cx = Math.min(GX - 1, Math.max(0, Math.floor((x + R + 1) / CS)));
    const cy = Math.min(GY - 1, Math.max(0, Math.floor((y + 1) / CS)));
    const cz = Math.min(GX - 1, Math.max(0, Math.floor((z + R + 1) / CS)));
    return [cx, cy, cz];
  };

  function collide() {
    const N = state.n;
    head.fill(-1);
    for (let i = 0; i < N; i++) {
      const [cx, cy, cz] = cellOf(X[i], Y[i], Z[i]);
      const k = (cy * GX + cz) * GX + cx;
      next[i] = head[k];
      head[k] = i;
    }
    for (let i = 0; i < N; i++) {
      const [cx, cy, cz] = cellOf(X[i], Y[i], Z[i]);
      for (let dy = -1; dy <= 1; dy++) {
        const yy = cy + dy;
        if (yy < 0 || yy >= GY) continue;
        for (let dz = -1; dz <= 1; dz++) {
          const zz = cz + dz;
          if (zz < 0 || zz >= GX) continue;
          for (let dx = -1; dx <= 1; dx++) {
            const xx = cx + dx;
            if (xx < 0 || xx >= GX) continue;
            for (let j = head[(yy * GX + zz) * GX + xx]; j >= 0; j = next[j]) {
              if (j <= i) continue;
              const rx = X[j] - X[i], ry = Y[j] - Y[i], rz = Z[j] - Z[i];
              const d2 = rx * rx + ry * ry + rz * rz;
              if (d2 >= D * D || d2 === 0) continue;
              const d = Math.sqrt(d2);
              const nx = rx / d, ny = ry / d, nz = rz / d;
              const rel = (VX[j] - VX[i]) * nx + (VY[j] - VY[i]) * ny + (VZ[j] - VZ[i]) * nz;
              if (rel >= 0) continue; // already separating
              // equal masses: swap the components along the line of centres
              VX[i] += rel * nx; VY[i] += rel * ny; VZ[i] += rel * nz;
              VX[j] -= rel * nx; VY[j] -= rel * ny; VZ[j] -= rel * nz;
              const push = (D - d) / 2;
              X[i] -= nx * push; Y[i] -= ny * push; Z[i] -= nz * push;
              X[j] += nx * push; Y[j] += ny * push; Z[j] += nz * push;
            }
          }
        }
      }
    }
  }

  function step(dt: number) {
    const N = state.n;
    // The piston chases its target through a speed limit and a short ramp, so
    // however fast the slider moves the wall itself never jumps.
    const gap = state.target - state.h;
    const want = Math.max(-PISTON_MAX, Math.min(PISTON_MAX, gap / 20));
    state.u += (want - state.u) * Math.min(1, dt / 3);
    if (Math.abs(gap) < 0.01) { state.h = state.target; state.u = 0; }
    else {
      let move = state.u * dt;
      if (Math.abs(move) > Math.abs(gap)) move = gap;
      state.h += move;
    }
    const h = state.h, u = state.u;

    let imp = 0, hits = 0;
    for (let i = 0; i < N; i++) {
      X[i] += VX[i] * dt; Y[i] += VY[i] * dt; Z[i] += VZ[i] * dt;
      // Side wall: rough, so an atom keeps its speed but leaves in a random
      // direction (cosine law). That shares energy between up-down and
      // sideways motion, the way real walls do, and adds or removes none.
      const r2 = X[i] * X[i] + Z[i] * Z[i];
      if (r2 > R * R) {
        const r = Math.sqrt(r2), nx = X[i] / r, nz = Z[i] / r;
        X[i] = nx * R; Z[i] = nz * R;
        const vn = VX[i] * nx + VZ[i] * nz;
        if (vn > 0) {
          const sp = Math.hypot(VX[i], VY[i], VZ[i]);
          const c = Math.sqrt(Math.random()), sn = Math.sqrt(1 - c * c), ph = 2 * Math.PI * Math.random();
          const t1 = sn * Math.cos(ph) * sp, t2 = sn * Math.sin(ph) * sp;
          VX[i] = -c * sp * nx - t1 * nz;
          VZ[i] = -c * sp * nz + t1 * nx;
          VY[i] = t2;
          imp += vn + c * sp; hits++;
          spark(X[i] * (1 + A_R / R), Y[i], Z[i] * (1 + A_R / R));
        }
      }
      // heater plate below: re-emits at its temperature, or a mirror when insulated
      if (Y[i] < 0) {
        Y[i] = -Y[i];
        if (VY[i] < 0) {
          const before = VY[i];
          if (state.walls === 'bath') plateBounce(i);
          else VY[i] = -VY[i];
          imp += VY[i] - before; hits++;
          spark(X[i], -A_R, Z[i]);
        }
      }
      // piston above: a mirror in its own frame, so a moving piston does work
      if (Y[i] > h) {
        Y[i] = h;
        if (VY[i] > u) {
          const before = VY[i];
          VY[i] = 2 * u - VY[i];
          imp += before - VY[i]; hits++;
        }
      }
    }
    collide();

    // Pressure is impulse per area per time. Both it and the law are smoothed
    // with the same window, so their ratio is fair even while things change.
    simT += dt;
    avg.t += dt;
    const T = kinT();
    const pNow = (imp / (area() * dt)) * PA;
    const law = ((N * T) / volume()) * KB * 1e27;
    const af = Math.max(dt / TAU_FAST, dt / avg.t), as = Math.max(dt / TAU_SLOW, dt / avg.t);
    avg.pf += (pNow - avg.pf) * af;
    avg.lf += (law - avg.lf) * af;
    avg.ps += (pNow - avg.ps) * as;
    avg.ls += (law - avg.ls) * as;
    avg.T += (T - avg.T) * Math.max(dt / 40, dt / avg.t);
    avg.hits += hits;
    avg.hitT += dt;
    if (avg.hitT > 50) {
      avg.hitRate = (avg.hits / avg.hitT) * 1000;
      avg.hits = 0;
      avg.hitT = 0;
    }
  }

  /** NkT/V right now, in pascals: where the gas sits on the P-V diagram. */
  const lawNow = () => ((state.n * avg.T) / volume()) * KB * 1e27;

  function advance(seconds: number) {
    const ps = seconds * BASE * state.rate;
    if (!(ps > 0)) return;
    const n = Math.min(60, Math.max(1, Math.round(ps / DT)));
    for (let k = 0; k < n; k++) step(ps / n);
    if (state.trail) {
      trail.push({ x: X[0], y: Y[0], z: Z[0] });
      if (trail.length > 260) trail.shift();
    }
  }

  // --- canvas ----------------------------------------------------------------
  const canvas = document.getElementById('gas') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const css = (v: string) => getComputedStyle(canvas).getPropertyValue(v).trim();
  let INK = '232,233,236', LIGHT = false, BG = [13, 14, 18];
  function readTheme() {
    INK = css('--stage-ink') || '232,233,236';
    LIGHT = css('--stage-light') === '1';
    const bg = css('--stage-bg') || '#0d0e12';
    const m = bg.match(/^#([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})/i);
    BG = m ? [parseInt(m[1], 16), parseInt(m[2], 16), parseInt(m[3], 16)] : LIGHT ? [255, 255, 255] : [13, 14, 18];
  }
  const ink = (a: number) => `rgba(${INK},${a})`;
  /** An opaque grey between the stage background (0) and the ink (1). */
  const grey = (t: number) => {
    const k = INK.split(',').map(Number);
    return `rgb(${BG.map((b, i) => Math.round(b + (k[i] - b) * t)).join(',')})`;
  };

  const P_COL = '#f59e0b', T_COL = '#f43f5e', V_COL = '#7c8cff', LAW = '#34d399', ADI = '#c084fc';

  // Speed colours: blue when slow through cyan and yellow to red when fast.
  // Fixed in m/s, so heating the gas visibly shifts it towards red.
  const RAMP_DARK = [[64, 120, 255], [40, 200, 255], [250, 220, 90], [255, 140, 50], [255, 64, 80]];
  const RAMP_LIGHT = [[37, 99, 235], [6, 172, 212], [234, 179, 8], [249, 115, 22], [225, 29, 72]];
  const VSCALE = 1.32; // nm/ps at the top of the ramp
  const NB = 24;
  function rampAt(stops: number[][], s: number) {
    s = Math.max(0, Math.min(1, s)) * (stops.length - 1);
    const i = Math.min(stops.length - 2, Math.floor(s)), f = s - i;
    return stops[i].map((v, k) => Math.round(v + (stops[i + 1][k] - v) * f));
  }
  const bucket = (v: number) => Math.min(NB - 1, Math.floor((v / VSCALE) * NB));
  const speedRGB = (v: number) => rampAt(LIGHT ? RAMP_LIGHT : RAMP_DARK, v / VSCALE);

  function makeSprite(paint: (g: CanvasRenderingContext2D) => void) {
    const s = document.createElement('canvas');
    s.width = s.height = 64;
    paint(s.getContext('2d')!);
    return s;
  }
  const glowSprites: HTMLCanvasElement[] = [];
  let ballSprites: HTMLCanvasElement[] = [];
  let ballsLight: boolean | null = null;
  for (let b = 0; b < NB; b++) {
    const c = rampAt(RAMP_DARK, (b + 0.5) / NB);
    glowSprites.push(makeSprite((g) => {
      const gr = g.createRadialGradient(32, 32, 0, 32, 32, 32);
      gr.addColorStop(0, `rgba(${c},0.5)`);
      gr.addColorStop(0.35, `rgba(${c},0.16)`);
      gr.addColorStop(1, `rgba(${c},0)`);
      g.fillStyle = gr;
      g.fillRect(0, 0, 64, 64);
    }));
  }
  function buildBalls() {
    ballsLight = LIGHT;
    ballSprites = [];
    for (let b = 0; b < NB; b++) {
      const c = rampAt(LIGHT ? RAMP_LIGHT : RAMP_DARK, (b + 0.5) / NB);
      const dark = c.map((v) => Math.round(v * (LIGHT ? 0.62 : 0.45)));
      ballSprites.push(makeSprite((g) => {
        const gr = g.createRadialGradient(24, 22, 2, 32, 32, 31);
        gr.addColorStop(0, LIGHT ? `rgb(${c.map((v) => Math.round(v + (255 - v) * 0.55))})` : `rgb(${c.map((v) => Math.round(v + (255 - v) * 0.7))})`);
        gr.addColorStop(0.45, `rgb(${c})`);
        gr.addColorStop(1, `rgb(${dark})`);
        g.fillStyle = gr;
        g.beginPath();
        g.arc(32, 32, 31, 0, Math.PI * 2);
        g.fill();
      }));
    }
  }
  const sparkSprite = makeSprite((g) => {
    const gr = g.createRadialGradient(32, 32, 0, 32, 32, 32);
    gr.addColorStop(0, 'rgba(255,236,170,1)');
    gr.addColorStop(0.25, 'rgba(245,158,11,0.75)');
    gr.addColorStop(1, 'rgba(245,158,11,0)');
    g.fillStyle = gr;
    g.fillRect(0, 0, 64, 64);
  });

  // --- the 3D scene ----------------------------------------------------------
  const SCENE_W = 630;
  const YC = 17; // nm, the height the camera looks at
  const cam = new Camera3D(SCENE_W, H + 30, { dist: 10, yaw: 0.55, pitch: -0.36, zoom: 1.42 });
  const w3 = (x: number, y: number, z: number): Vec => ({ x: x / 10, y: (y - YC) / 10, z: z / 10 });
  const proj = (x: number, y: number, z: number) => cam.project(w3(x, y, z));

  const RIM_N = 72;
  const COS = Array.from({ length: RIM_N }, (_, k) => Math.cos((2 * Math.PI * k) / RIM_N));
  const SIN = Array.from({ length: RIM_N }, (_, k) => Math.sin((2 * Math.PI * k) / RIM_N));
  function rim(y: number, r: number): Projected[] {
    return COS.map((c, k) => proj(r * c, y, r * SIN[k]));
  }
  type Pt = { sx: number; sy: number };
  function hull(pts: Pt[]): Pt[] {
    const p = pts.slice().sort((a, b) => a.sx - b.sx || a.sy - b.sy);
    const cr = (o: Pt, a: Pt, b: Pt) => (a.sx - o.sx) * (b.sy - o.sy) - (a.sy - o.sy) * (b.sx - o.sx);
    const lo: Pt[] = [], up: Pt[] = [];
    for (const q of p) {
      while (lo.length >= 2 && cr(lo[lo.length - 2], lo[lo.length - 1], q) <= 0) lo.pop();
      lo.push(q);
    }
    for (let i = p.length - 1; i >= 0; i--) {
      const q = p[i];
      while (up.length >= 2 && cr(up[up.length - 2], up[up.length - 1], q) <= 0) up.pop();
      up.push(q);
    }
    return lo.slice(0, -1).concat(up.slice(0, -1));
  }
  function polyPath(pts: Pt[]) {
    ctx.beginPath();
    pts.forEach((q, i) => (i ? ctx.lineTo(q.sx, q.sy) : ctx.moveTo(q.sx, q.sy)));
    ctx.closePath();
  }
  function inPoly(pts: Pt[], x: number, y: number) {
    let inside = false;
    for (let i = 0, j = pts.length - 1; i < pts.length; j = i++) {
      const a = pts[i], b = pts[j];
      if (a.sy > y !== b.sy > y && x < ((b.sx - a.sx) * (y - a.sy)) / (b.sy - a.sy) + a.sx) inside = !inside;
    }
    return inside;
  }
  /** The near or far half of a projected rim, as a stroked arc. */
  function strokeRim(pts: Projected[], front: boolean, color: string, width: number) {
    const mid = pts.reduce((s, q) => s + q.zc, 0) / pts.length;
    ctx.strokeStyle = color;
    ctx.lineWidth = width;
    ctx.beginPath();
    for (let k = 0; k <= RIM_N; k++) {
      const a = pts[k % RIM_N], b = pts[(k + 1) % RIM_N];
      const isFront = (a.zc + b.zc) / 2 < mid;
      if (isFront !== front) continue;
      ctx.moveTo(a.sx, a.sy);
      ctx.lineTo(b.sx, b.sy);
    }
    ctx.stroke();
  }

  const RG = R + A_R; // glass radius
  const GLASS_TOP = HMAX + 4;
  const PISTON_T = 1.6;
  const ROD = 6;
  let pistonHull: Pt[] = [];
  let knob = { sx: 0, sy: 0, r: 0 };

  function plateRGB() {
    return speedRGB(Math.sqrt(3 * KM * state.temp));
  }

  function drawScene() {
    ctx.save();
    ctx.beginPath();
    ctx.rect(0, 0, SCENE_W, H);
    ctx.clip();
    const bath = state.walls === 'bath';
    const pc = plateRGB();

    const bot = rim(-A_R, RG), top = rim(GLASS_TOP, RG);
    const plateTop = rim(-A_R, RG - 0.05), plateBot = rim(-A_R - 1.8, RG + 0.6);
    const glassHull = hull([...bot, ...top]);

    // the warm glow the plate throws, under everything
    if (bath && !LIGHT) {
      const c = proj(0, -A_R, 0);
      const k = c.s * cam.scale * 1.3;
      const glow = Math.min(1, state.temp / 900);
      ctx.save();
      ctx.translate(c.sx, c.sy);
      ctx.scale(1, 0.42);
      const g = ctx.createRadialGradient(0, 0, 0, 0, 0, k * 2.2);
      g.addColorStop(0, `rgba(${pc},${0.10 + 0.22 * glow})`);
      g.addColorStop(1, `rgba(${pc},0)`);
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(0, 0, k * 2.2, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    // glass body and the back halves of its rims
    polyPath(glassHull);
    const left = Math.min(...glassHull.map((q) => q.sx)), right = Math.max(...glassHull.map((q) => q.sx));
    const gg = ctx.createLinearGradient(left, 0, right, 0);
    gg.addColorStop(0, ink(LIGHT ? 0.05 : 0.045));
    gg.addColorStop(0.5, ink(0.012));
    gg.addColorStop(1, ink(LIGHT ? 0.06 : 0.05));
    ctx.fillStyle = gg;
    ctx.fill();
    strokeRim(top, false, ink(LIGHT ? 0.22 : 0.18), 1.2);
    strokeRim(bot, false, ink(LIGHT ? 0.22 : 0.18), 1.2);

    // heater plate: side band, then its top face
    polyPath(hull([...plateTop, ...plateBot]));
    ctx.fillStyle = grey(LIGHT ? 0.32 : 0.22);
    ctx.fill();
    polyPath(plateTop);
    const pcen = proj(0, -A_R, 0);
    const pr = Math.max(...plateTop.map((q) => Math.abs(q.sx - pcen.sx)));
    if (bath) {
      const glow = 0.35 + 0.65 * Math.min(1, state.temp / 900);
      ctx.save();
      ctx.clip();
      ctx.fillStyle = grey(LIGHT ? 0.12 : 0.12);
      ctx.fillRect(pcen.sx - pr - 2, pcen.sy - pr, 2 * pr + 4, 2 * pr);
      ctx.translate(pcen.sx, pcen.sy);
      ctx.scale(1, Math.max(0.05, (Math.max(...plateTop.map((q) => q.sy)) - pcen.sy) / pr));
      const g = ctx.createRadialGradient(0, 0, 0, 0, 0, pr);
      g.addColorStop(0, `rgba(${pc},${0.95 * glow})`);
      g.addColorStop(0.7, `rgba(${pc},${0.55 * glow})`);
      g.addColorStop(1, `rgba(${pc},${0.25 * glow})`);
      ctx.fillStyle = g;
      ctx.fillRect(-pr, -pr, 2 * pr, 2 * pr);
      ctx.restore();
      // the heating coil, as a few concentric rings
      for (const f of [0.35, 0.6, 0.85]) {
        strokeRim(rim(-A_R, RG * f), true, `rgba(${pc},${LIGHT ? 0.55 : 0.5})`, 1);
        strokeRim(rim(-A_R, RG * f), false, `rgba(${pc},${LIGHT ? 0.4 : 0.3})`, 1);
      }
    } else {
      ctx.fillStyle = grey(LIGHT ? 0.16 : 0.16);
      ctx.fill();
      // hatching reads as "insulating"
      ctx.save();
      ctx.clip();
      ctx.strokeStyle = ink(0.12);
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (let x = pcen.sx - pr - 80; x < pcen.sx + pr + 80; x += 9) {
        ctx.moveTo(x, pcen.sy + 60);
        ctx.lineTo(x + 60, pcen.sy - 60);
      }
      ctx.stroke();
      ctx.restore();
    }
    strokeRim(plateTop, true, ink(0.35), 1);

    drawAtoms();

    // piston: the slab, its face, the rod and the knob you grab
    const yb = state.h + A_R, yt = yb + PISTON_T;
    const pb = rim(yb, RG - 0.1), pt = rim(yt, RG - 0.1);
    pistonHull = hull([...pb, ...pt]);
    polyPath(pistonHull);
    const pl = Math.min(...pistonHull.map((q) => q.sx)), prr = Math.max(...pistonHull.map((q) => q.sx));
    const sg = ctx.createLinearGradient(pl, 0, prr, 0);
    sg.addColorStop(0, grey(LIGHT ? 0.5 : 0.3));
    sg.addColorStop(0.35, grey(LIGHT ? 0.28 : 0.52));
    sg.addColorStop(1, grey(LIGHT ? 0.55 : 0.24));
    ctx.fillStyle = sg;
    ctx.fill();
    polyPath(pt);
    const tg = ctx.createLinearGradient(pl, 0, prr, 0);
    tg.addColorStop(0, grey(LIGHT ? 0.2 : 0.36));
    tg.addColorStop(0.5, grey(LIGHT ? 0.1 : 0.46));
    tg.addColorStop(1, grey(LIGHT ? 0.24 : 0.3));
    ctx.fillStyle = tg;
    ctx.fill();
    strokeRim(pt, true, ink(LIGHT ? 0.45 : 0.4), 1);
    strokeRim(pt, false, ink(LIGHT ? 0.3 : 0.28), 1);
    strokeRim(pb, true, ink(LIGHT ? 0.45 : 0.35), 1);
    const r0 = proj(0, yt, 0), r1 = proj(0, yt + ROD, 0);
    ctx.lineCap = 'round';
    ctx.strokeStyle = grey(LIGHT ? 0.45 : 0.5);
    ctx.lineWidth = Math.max(3, 0.8 * r0.s * cam.scale * 0.1);
    ctx.beginPath();
    ctx.moveTo(r0.sx, r0.sy);
    ctx.lineTo(r1.sx, r1.sy);
    ctx.stroke();
    ctx.lineCap = 'butt';
    knob = { sx: r1.sx, sy: r1.sy, r: Math.max(7, 1.4 * r1.s * cam.scale * 0.1) };
    const kg = ctx.createRadialGradient(knob.sx - knob.r * 0.35, knob.sy - knob.r * 0.4, 1, knob.sx, knob.sy, knob.r);
    kg.addColorStop(0, '#c7ceff');
    kg.addColorStop(0.5, V_COL);
    kg.addColorStop(1, '#3f4bb8');
    ctx.fillStyle = kg;
    ctx.beginPath();
    ctx.arc(knob.sx, knob.sy, knob.r, 0, Math.PI * 2);
    ctx.fill();
    if (hover || dragging === 'piston') {
      ctx.strokeStyle = 'rgba(124,140,255,0.7)';
      ctx.lineWidth = 2;
      polyPath(pistonHull);
      ctx.stroke();
    }

    // where the piston is heading, while it catches up
    if (Math.abs(state.target - state.h) > 0.3) {
      const gt = rim(state.target + A_R, RG - 0.1);
      ctx.setLineDash([4, 4]);
      strokeRim(gt, true, 'rgba(124,140,255,0.75)', 1.4);
      strokeRim(gt, false, 'rgba(124,140,255,0.4)', 1.4);
      ctx.setLineDash([]);
    }

    // front halves of the glass, a highlight, and the sides
    strokeRim(bot, true, ink(LIGHT ? 0.4 : 0.32), 1.3);
    strokeRim(top, true, ink(LIGHT ? 0.4 : 0.32), 1.3);
    const lft = glassHull.reduce((a, q) => (q.sx < a.sx ? q : a));
    const rgt = glassHull.reduce((a, q) => (q.sx > a.sx ? q : a));
    const sil = (yA: number, yB: number, sideRight: boolean) => {
      // the generator of the cylinder on the silhouette, found from the rim
      const rimA = sideRight ? rim(yA, RG).reduce((a, q) => (q.sx > a.sx ? q : a)) : rim(yA, RG).reduce((a, q) => (q.sx < a.sx ? q : a));
      const rimB = sideRight ? rim(yB, RG).reduce((a, q) => (q.sx > a.sx ? q : a)) : rim(yB, RG).reduce((a, q) => (q.sx < a.sx ? q : a));
      ctx.beginPath();
      ctx.moveTo(rimA.sx, rimA.sy);
      ctx.lineTo(rimB.sx, rimB.sy);
      ctx.stroke();
    };
    ctx.strokeStyle = ink(LIGHT ? 0.4 : 0.32);
    ctx.lineWidth = 1.3;
    sil(-A_R, GLASS_TOP, false);
    sil(-A_R, GLASS_TOP, true);
    // a soft vertical reflection on the glass, left of centre
    const hx = lft.sx + (rgt.sx - lft.sx) * 0.16;
    const y0 = lft.sy - 30, y1 = lft.sy + 0.75 * (proj(0, -A_R, 0).sy - lft.sy);
    const hl = ctx.createLinearGradient(0, y0, 0, y1);
    hl.addColorStop(0, 'rgba(255,255,255,0)');
    hl.addColorStop(0.3, LIGHT ? 'rgba(255,255,255,0.55)' : 'rgba(255,255,255,0.05)');
    hl.addColorStop(1, 'rgba(255,255,255,0)');
    ctx.fillStyle = hl;
    ctx.fillRect(hx - 4, y0, 8, y1 - y0);

    drawHeightBar();
    drawSceneLabels(plateBot);
    ctx.restore();
  }

  /** A dimension line beside the cylinder: the height that sets V. */
  function drawHeightBar() {
    const rt = cam.right();
    const hx = { x: rt.x, z: rt.z };
    const m = Math.hypot(hx.x, hx.z) || 1;
    const off = RG + 3.2;
    const x = (hx.x / m) * off, z = (hx.z / m) * off;
    const a = proj(x, 0, z), b = proj(x, state.h, z);
    ctx.strokeStyle = V_COL;
    ctx.fillStyle = V_COL;
    ctx.lineWidth = 1.4;
    ctx.beginPath();
    ctx.moveTo(a.sx, a.sy);
    ctx.lineTo(b.sx, b.sy);
    ctx.moveTo(a.sx - 5, a.sy);
    ctx.lineTo(a.sx + 5, a.sy);
    ctx.moveTo(b.sx - 5, b.sy);
    ctx.lineTo(b.sx + 5, b.sy);
    ctx.stroke();
    ctx.font = '600 13px ui-monospace, monospace';
    ctx.textAlign = 'left';
    const my = (a.sy + b.sy) / 2, lx = Math.max(a.sx, b.sx) + 10;
    ctx.fillText(`h ${state.h.toFixed(1)} nm`, lx, my - 4);
    ctx.font = '12px ui-monospace, monospace';
    ctx.fillStyle = 'rgba(124,140,255,0.85)';
    ctx.fillText(`V ${(volume() / 1000).toFixed(2)}×10³ nm³`, lx, my + 13);
  }

  function drawSceneLabels(plateBot: Projected[]) {
    const low = plateBot.reduce((a, q) => (q.sy > a.sy ? q : a));
    const bath = state.walls === 'bath';
    ctx.font = '13px ui-monospace, monospace';
    ctx.textAlign = 'center';
    ctx.fillStyle = bath ? `rgb(${plateRGB()})` : ink(0.55);
    ctx.fillText(bath ? `heater plate held at ${state.temp} K` : 'insulated base: no heat in or out', low.sx, Math.min(H - 10, low.sy + 20));
    ctx.textAlign = 'left';
    if (!touched) {
      ctx.font = '12px ui-monospace, monospace';
      ctx.fillStyle = ink(0.6);
      ctx.fillText('drag the piston', knob.sx + knob.r + 8, knob.sy + 4);
    }
    // the gas temperature, in the corner of the scene
    ctx.font = '12px ui-monospace, monospace';
    ctx.fillStyle = ink(0.55);
    ctx.fillText(
      bath ? 'plate held at T: the gas settles at its temperature' : 'insulated: energy enters only as piston work',
      18, 24
    );
  }

  // atoms and sparks, far to near
  const order = new Int32Array(MAXN + 260);
  const depth = new Float64Array(MAXN + 260);
  const scr: Projected[] = [];
  const trail: { x: number; y: number; z: number }[] = [];

  function drawAtoms() {
    const N = state.n;
    if (ballsLight !== LIGHT) buildBalls();
    const items = N + sparks.length;
    for (let i = 0; i < N; i++) {
      scr[i] = proj(X[i], Y[i], Z[i]);
      depth[i] = scr[i].zc;
    }
    for (let k = 0; k < sparks.length; k++) {
      const s = sparks[k];
      scr[N + k] = proj(s.x, s.y, s.z);
      depth[N + k] = scr[N + k].zc + 0.001;
    }
    for (let i = 0; i < items; i++) order[i] = i;
    const ord = Array.from(order.subarray(0, items)).sort((a, b) => depth[b] - depth[a]);
    const tau = 2.4 * state.rate; // ps of motion behind each streak
    const fogNear = cam.dist - 1.6, fogFar = cam.dist + 1.6;
    ctx.lineCap = 'round';
    for (const i of ord) {
      const p = scr[i];
      const fog = 0.45 + 0.55 * Math.max(0, Math.min(1, (fogFar - p.zc) / (fogFar - fogNear)));
      const pxPerNm = p.s * cam.scale * 0.1;
      if (i >= N) {
        const s = sparks[i - N];
        const g = (LIGHT ? 2 + 6 * s.life : 3 + 9 * s.life) * Math.max(0.6, pxPerNm / 14);
        ctx.globalAlpha = s.life * (LIGHT ? 0.75 : 0.9) * fog;
        if (!LIGHT) ctx.globalCompositeOperation = 'lighter';
        ctx.drawImage(sparkSprite, p.sx - g, p.sy - g, 2 * g, 2 * g);
        ctx.globalCompositeOperation = 'source-over';
        ctx.globalAlpha = 1;
        continue;
      }
      const v = Math.hypot(VX[i], VY[i], VZ[i]);
      const b = bucket(v);
      const rgb = rampAt(LIGHT ? RAMP_LIGHT : RAMP_DARK, (b + 0.5) / NB);
      const r = Math.max(2.4, A_R * 1.35 * pxPerNm);
      // motion streak
      const q = proj(X[i] - VX[i] * tau, Y[i] - VY[i] * tau, Z[i] - VZ[i] * tau);
      const sg = ctx.createLinearGradient(p.sx, p.sy, q.sx, q.sy);
      sg.addColorStop(0, `rgba(${rgb},${(LIGHT ? 0.45 : 0.5) * fog})`);
      sg.addColorStop(1, `rgba(${rgb},0)`);
      ctx.strokeStyle = sg;
      ctx.lineWidth = r * 1.3;
      ctx.beginPath();
      ctx.moveTo(p.sx, p.sy);
      ctx.lineTo(q.sx, q.sy);
      ctx.stroke();
      if (!LIGHT) {
        ctx.globalCompositeOperation = 'lighter';
        ctx.globalAlpha = 0.75 * fog;
        const g = r * 6;
        ctx.drawImage(glowSprites[b], p.sx - g / 2, p.sy - g / 2, g, g);
        ctx.globalCompositeOperation = 'source-over';
      }
      ctx.globalAlpha = LIGHT ? 0.55 + 0.45 * fog : fog;
      ctx.drawImage(ballSprites[b], p.sx - r, p.sy - r, 2 * r, 2 * r);
      ctx.globalAlpha = 1;
    }
    ctx.lineCap = 'butt';
    if (state.trail && trail.length > 1) {
      ctx.lineWidth = 1.4;
      for (let k = 1; k < trail.length; k++) {
        const a = proj(trail[k - 1].x, trail[k - 1].y, trail[k - 1].z);
        const b = proj(trail[k].x, trail[k].y, trail[k].z);
        ctx.strokeStyle = ink((0.85 * k) / trail.length);
        ctx.beginPath();
        ctx.moveTo(a.sx, a.sy);
        ctx.lineTo(b.sx, b.sy);
        ctx.stroke();
      }
      const p = scr[0];
      ctx.strokeStyle = ink(0.9);
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.arc(p.sx, p.sy, 9, 0, Math.PI * 2);
      ctx.stroke();
    }
  }

  // --- instruments -----------------------------------------------------------
  const COL_X = 642;
  const GA = { x: 742, y: 128, r: 88 };
  const TH = { x: 905, top: 36, bot: 168, bulb: 12 };
  const PL = { x: 690, y: 330, w: 282, h: 236 };
  const P_SCALES = [4, 8, 20, 40, 80, 200, 400, 800, 1600, 3200, 6400]; // kPa, each quarter a round number
  const T_SCALES = [400, 800, 1600, 3200]; // K
  const V_SCALES = [500, 1000, 1500, 2000, 3000, 4000]; // m/s
  let pScale = 200, tScale = 800, vScale = 1500, plotPScale = 200;
  let needle = 0;

  function ranged(list: number[], cur: number, v: number) {
    let i = list.indexOf(cur);
    if (i < 0) i = 0;
    while (i < list.length - 1 && v > 0.92 * list[i]) i++;
    while (i > 0 && v < 0.7 * list[i - 1]) i--;
    return list[i];
  }

  function txt(s: string, x: number, y: number, o: { size?: number; color?: string; align?: CanvasTextAlign; weight?: string } = {}) {
    ctx.font = `${o.weight ?? ''} ${o.size ?? 12}px ui-monospace, monospace`;
    ctx.fillStyle = o.color ?? ink(0.55);
    ctx.textAlign = o.align ?? 'left';
    ctx.fillText(s, x, y);
    ctx.textAlign = 'left';
  }
  const fmtKPa = (pa: number) => {
    const k = pa / 1000;
    return k < 10 ? k.toFixed(2) : k < 100 ? k.toFixed(1) : k.toFixed(0);
  };

  function drawGauge(dtReal: number) {
    const { x, y, r } = GA;
    const a0 = 0.75 * Math.PI, sweep = 1.5 * Math.PI;
    pScale = ranged(P_SCALES, pScale, Math.max(avg.pf, avg.lf) / 1000);
    const ang = (kpa: number) => a0 + sweep * Math.max(0, Math.min(1.02, kpa / pScale));
    // face
    const fg = ctx.createRadialGradient(x, y - r * 0.3, r * 0.1, x, y, r);
    fg.addColorStop(0, ink(LIGHT ? 0.02 : 0.07));
    fg.addColorStop(1, ink(LIGHT ? 0.06 : 0.03));
    ctx.fillStyle = fg;
    ctx.beginPath();
    ctx.arc(x, y, r, 0, Math.PI * 2);
    ctx.fill();
    ctx.strokeStyle = ink(0.28);
    ctx.lineWidth = 1.5;
    ctx.stroke();
    // the arc, coloured up to the needle
    ctx.lineWidth = 5;
    ctx.strokeStyle = ink(0.08);
    ctx.beginPath();
    ctx.arc(x, y, r - 12, a0, a0 + sweep);
    ctx.stroke();
    const target = ang(avg.pf / 1000);
    needle = needle ? needle + (target - needle) * Math.min(1, dtReal * 10) : target;
    ctx.strokeStyle = 'rgba(245,158,11,0.55)';
    ctx.beginPath();
    ctx.arc(x, y, r - 12, a0, needle);
    ctx.stroke();
    // ticks
    for (let k = 0; k <= 20; k++) {
      const a = a0 + (sweep * k) / 20, major = k % 5 === 0;
      const r1 = r - 18, r2 = r - (major ? 30 : 24);
      ctx.strokeStyle = ink(major ? 0.6 : 0.3);
      ctx.lineWidth = major ? 1.6 : 1;
      ctx.beginPath();
      ctx.moveTo(x + Math.cos(a) * r1, y + Math.sin(a) * r1);
      ctx.lineTo(x + Math.cos(a) * r2, y + Math.sin(a) * r2);
      ctx.stroke();
      if (major) {
        const v = (pScale * k) / 20;
        txt(String(v), x + Math.cos(a) * (r - 42), y + Math.sin(a) * (r - 42) + 4, { size: 11, align: 'center', color: ink(0.55) });
      }
    }
    // where NkT/V says the needle should be
    const al = ang(avg.lf / 1000);
    ctx.fillStyle = LAW;
    ctx.beginPath();
    ctx.moveTo(x + Math.cos(al) * (r - 9), y + Math.sin(al) * (r - 9));
    ctx.lineTo(x + Math.cos(al - 0.06) * (r + 3), y + Math.sin(al - 0.06) * (r + 3));
    ctx.lineTo(x + Math.cos(al + 0.06) * (r + 3), y + Math.sin(al + 0.06) * (r + 3));
    ctx.closePath();
    ctx.fill();
    // needle
    if (!LIGHT) {
      ctx.shadowColor = 'rgba(245,158,11,0.7)';
      ctx.shadowBlur = 8;
    }
    ctx.strokeStyle = P_COL;
    ctx.lineWidth = 2.5;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(x - Math.cos(needle) * 12, y - Math.sin(needle) * 12);
    ctx.lineTo(x + Math.cos(needle) * (r - 16), y + Math.sin(needle) * (r - 16));
    ctx.stroke();
    ctx.shadowBlur = 0;
    ctx.lineCap = 'butt';
    ctx.fillStyle = grey(0.5);
    ctx.beginPath();
    ctx.arc(x, y, 6, 0, Math.PI * 2);
    ctx.fill();
    txt('kPa', x, y + 30, { size: 11, align: 'center', color: ink(0.45) });
    txt(fmtKPa(avg.pf), x, y + 54, { size: 18, align: 'center', color: P_COL, weight: '600' });
    txt(`${(avg.pf / 101325).toFixed(2)} atm`, x, y + 70, { size: 11, align: 'center', color: ink(0.45) });
    txt('pressure, from impacts', x, 246, { size: 12, align: 'center', color: ink(0.6) });
  }

  function drawThermo() {
    const { x, top, bot, bulb } = TH;
    const Tg = avg.T;
    tScale = ranged(T_SCALES, tScale, Math.max(Tg, state.temp));
    const yAt = (T: number) => bot - 12 - (bot - 12 - top) * Math.max(0, Math.min(1.03, T / tScale));
    const w = 10;
    ctx.fillStyle = ink(LIGHT ? 0.05 : 0.06);
    ctx.strokeStyle = ink(0.3);
    ctx.lineWidth = 1.2;
    ctx.beginPath();
    ctx.moveTo(x - w / 2, bot - 4);
    ctx.lineTo(x - w / 2, top + w / 2);
    ctx.arc(x, top + w / 2, w / 2, Math.PI, 0);
    ctx.lineTo(x + w / 2, bot - 4);
    ctx.arc(x, bot + 6, bulb, -Math.PI / 2 + 0.4, -Math.PI / 2 - 0.4 + 2 * Math.PI);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
    // the column
    const yT = yAt(Tg);
    ctx.fillStyle = T_COL;
    if (!LIGHT) { ctx.shadowColor = 'rgba(244,63,94,0.6)'; ctx.shadowBlur = 8; }
    ctx.fillRect(x - 2.5, yT, 5, bot - yT);
    ctx.beginPath();
    ctx.arc(x, bot + 6, bulb - 4, 0, Math.PI * 2);
    ctx.fill();
    ctx.shadowBlur = 0;
    // scale
    for (let k = 0; k <= 4; k++) {
      const T = (tScale * k) / 4, yy = yAt(T);
      ctx.strokeStyle = ink(0.4);
      ctx.beginPath();
      ctx.moveTo(x + w / 2 + 3, yy);
      ctx.lineTo(x + w / 2 + 9, yy);
      ctx.stroke();
      txt(String(T), x + w / 2 + 13, yy + 4, { size: 11, color: ink(0.5) });
    }
    // where the plate is
    if (state.walls === 'bath') {
      const yp = yAt(state.temp);
      ctx.fillStyle = `rgb(${plateRGB()})`;
      ctx.beginPath();
      ctx.moveTo(x - w / 2 - 3, yp);
      ctx.lineTo(x - w / 2 - 11, yp - 5);
      ctx.lineTo(x - w / 2 - 11, yp + 5);
      ctx.closePath();
      ctx.fill();
      txt('plate', x - w / 2 - 14, yp + 4, { size: 11, align: 'right', color: ink(0.55) });
    }
    txt(`${Tg.toFixed(0)} K`, x, 222, { size: 17, align: 'center', color: T_COL, weight: '600' });
    txt('gas temperature', x, 246, { size: 12, align: 'center', color: ink(0.6) });
  }

  // P-V path, sampled while running
  const path: { v: number; p: number }[] = [];
  let pathClock = 0;
  // speed histogram, smoothed over a few frames
  const BINS = 30;
  const histEMA = new Float64Array(BINS);
  let histFresh = true;

  function frameBox(title: string, legend: [string, string, 'line' | 'dash' | 'dot' | 'bar'][]) {
    txt(title, PL.x - 44, PL.y - 22, { size: 12, color: ink(0.75), weight: '600' });
    let lx = PL.x + PL.w;
    ctx.font = '11px ui-monospace, monospace';
    for (let k = legend.length - 1; k >= 0; k--) {
      const [label, col, kind] = legend[k];
      const tw = ctx.measureText(label).width;
      txt(label, lx, PL.y - 22, { size: 11, align: 'right', color: ink(0.6) });
      const sx = lx - tw - 22;
      ctx.strokeStyle = col;
      ctx.fillStyle = col;
      ctx.lineWidth = 2;
      if (kind === 'dot') {
        ctx.beginPath();
        ctx.arc(sx + 8, PL.y - 26, 4, 0, Math.PI * 2);
        ctx.fill();
      } else if (kind === 'bar') ctx.fillRect(sx + 3, PL.y - 31, 10, 9);
      else {
        if (kind === 'dash') ctx.setLineDash([4, 3]);
        ctx.beginPath();
        ctx.moveTo(sx, PL.y - 26);
        ctx.lineTo(sx + 16, PL.y - 26);
        ctx.stroke();
        ctx.setLineDash([]);
      }
      lx = sx - 12;
    }
    ctx.strokeStyle = ink(0.3);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(PL.x, PL.y);
    ctx.lineTo(PL.x, PL.y + PL.h);
    ctx.lineTo(PL.x + PL.w, PL.y + PL.h);
    ctx.stroke();
  }

  function drawPV() {
    const Vmax = volume(HMAX) / 1000; // 10³ nm³
    const VminPlot = 0;
    let pm = Math.max(avg.pf, avg.lf);
    for (const q of path) pm = Math.max(pm, q.p);
    plotPScale = ranged(P_SCALES, plotPScale, pm / 1000);
    const Pmax = plotPScale;
    const xAt = (v: number) => PL.x + ((v - VminPlot) / (Vmax * 1.04 - VminPlot)) * PL.w;
    const yAt = (p: number) => PL.y + PL.h - (p / Pmax) * PL.h;
    frameBox('P-V', [['isotherm', LAW, 'line'], ['adiabat', ADI, 'dash'], ['path', P_COL, 'line']]);
    // grid and ticks
    for (let k = 1; k <= 4; k++) {
      const y = yAt((Pmax * k) / 4);
      ctx.strokeStyle = ink(0.07);
      ctx.beginPath();
      ctx.moveTo(PL.x, y);
      ctx.lineTo(PL.x + PL.w, y);
      ctx.stroke();
      txt(String((Pmax * k) / 4), PL.x - 6, y + 4, { size: 11, align: 'right', color: ink(0.45) });
    }
    txt('kPa', PL.x - 6, PL.y + PL.h + 4, { size: 11, align: 'right', color: P_COL });
    for (let v = 2; v <= Vmax; v += 2) {
      const x = xAt(v);
      ctx.strokeStyle = ink(0.3);
      ctx.beginPath();
      ctx.moveTo(x, PL.y + PL.h);
      ctx.lineTo(x, PL.y + PL.h + 4);
      ctx.stroke();
      txt(String(v), x, PL.y + PL.h + 16, { size: 11, align: 'center', color: ink(0.45) });
    }
    txt('V (10³ nm³)', PL.x + PL.w, PL.y + PL.h + 32, { size: 11, align: 'right', color: V_COL });
    // isotherm and adiabat through where the law puts the gas now
    const vc = volume() / 1000, pc = lawNow() / 1000;
    ctx.save();
    ctx.beginPath();
    ctx.rect(PL.x, PL.y, PL.w, PL.h);
    ctx.clip();
    const curve = (gamma: number, col: string, dash: boolean) => {
      ctx.strokeStyle = col;
      ctx.lineWidth = 1.6;
      if (dash) ctx.setLineDash([5, 4]);
      ctx.beginPath();
      for (let k = 0; k <= 80; k++) {
        const v = 0.25 + (Vmax * 1.04 - 0.25) * (k / 80);
        const p = pc * Math.pow(vc / v, gamma);
        const y = Math.max(PL.y - 10, yAt(p));
        k ? ctx.lineTo(xAt(v), y) : ctx.moveTo(xAt(v), y);
      }
      ctx.stroke();
      ctx.setLineDash([]);
    };
    curve(1, LAW, false);
    curve(5 / 3, ADI, true);
    // the path actually taken
    if (path.length > 1) {
      ctx.strokeStyle = 'rgba(245,158,11,0.75)';
      ctx.lineWidth = 2;
      ctx.lineJoin = 'round';
      ctx.beginPath();
      path.forEach((q, i) => {
        const x = xAt(q.v / 1000), y = yAt(q.p / 1000);
        i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
      });
      ctx.stroke();
    }
    ctx.restore();
    const cx = xAt(vc), cy = Math.max(PL.y, yAt(lawNow() / 1000));
    if (!LIGHT) { ctx.shadowColor = 'rgba(245,158,11,0.8)'; ctx.shadowBlur = 10; }
    ctx.fillStyle = P_COL;
    ctx.beginPath();
    ctx.arc(cx, cy, 5, 0, Math.PI * 2);
    ctx.fill();
    ctx.shadowBlur = 0;
  }

  function drawSpeeds() {
    const N = state.n;
    const T = Math.max(1, kinT());
    const vp = Math.sqrt(2 * KM * T) * 1000; // most probable speed, m/s
    const prev = vScale;
    vScale = ranged(V_SCALES, vScale, 3.2 * vp);
    if (prev !== vScale) histFresh = true;
    const bw = vScale / BINS;
    const counts = new Float64Array(BINS);
    for (let i = 0; i < N; i++) {
      const v = Math.hypot(VX[i], VY[i], VZ[i]) * 1000;
      const b = Math.floor(v / bw);
      if (b < BINS) counts[b]++;
    }
    for (let b = 0; b < BINS; b++) {
      const dens = counts[b] / (N * bw);
      histEMA[b] = histFresh ? dens : histEMA[b] + (dens - histEMA[b]) * 0.12;
    }
    histFresh = false;
    const a = KM * T * 1e6; // kT/m in m²/s²
    const mb = (v: number) => 4 * Math.PI * Math.pow(1 / (2 * Math.PI * a), 1.5) * v * v * Math.exp((-v * v) / (2 * a));
    const peak = mb(Math.sqrt(2 * a));
    const ymax = peak * 1.35;
    const xAt = (v: number) => PL.x + (v / vScale) * PL.w;
    const yAt = (f: number) => PL.y + PL.h - Math.min(1, f / ymax) * PL.h;
    frameBox('speeds', [['atoms', `rgb(${speedRGB(0.55)})`, 'bar'], ['Maxwell-Boltzmann', ink(0.85), 'line']]);
    for (let b = 0; b < BINS; b++) {
      const v = (b + 0.5) * bw;
      const y = yAt(histEMA[b]);
      ctx.fillStyle = `rgba(${speedRGB(v / 1000)},${LIGHT ? 0.75 : 0.8})`;
      ctx.fillRect(xAt(b * bw) + 1, y, PL.w / BINS - 2, PL.y + PL.h - y);
      if (histEMA[b] > ymax) txt('↑', xAt(v), PL.y + 2, { size: 12, align: 'center', color: ink(0.7) });
    }
    ctx.strokeStyle = ink(0.85);
    ctx.lineWidth = 2;
    ctx.beginPath();
    for (let k = 0; k <= 120; k++) {
      const v = (vScale * k) / 120;
      k ? ctx.lineTo(xAt(v), yAt(mb(v))) : ctx.moveTo(xAt(v), yAt(mb(v)));
    }
    ctx.stroke();
    const vStep = vScale <= 1000 ? 250 : vScale <= 2000 ? 500 : 1000;
    for (let v = 0; v <= vScale; v += vStep) {
      txt(String(v), xAt(v), PL.y + PL.h + 16, { size: 11, align: 'center', color: ink(0.45) });
    }
    txt('speed (m/s)', PL.x + PL.w, PL.y + PL.h + 32, { size: 11, align: 'right', color: ink(0.55) });
    txt(`curve at T = ${T.toFixed(0)} K`, PL.x + PL.w - 4, PL.y + 14, { size: 11, align: 'right', color: ink(0.55) });
    // the speed that sets the temperature
    const vr = Math.sqrt(3 * a);
    ctx.strokeStyle = 'rgba(244,63,94,0.7)';
    ctx.setLineDash([3, 3]);
    ctx.beginPath();
    ctx.moveTo(xAt(vr), PL.y + 20);
    ctx.lineTo(xAt(vr), PL.y + PL.h);
    ctx.stroke();
    ctx.setLineDash([]);
    txt('v_rms', xAt(vr), PL.y + 12, { size: 11, color: T_COL, align: 'center' });
  }

  function drawInstruments(dtReal: number) {
    ctx.fillStyle = ink(LIGHT ? 0.025 : 0.03);
    ctx.beginPath();
    ctx.roundRect(COL_X, 12, W - COL_X - 12, H - 24, 14);
    ctx.fill();
    drawGauge(dtReal);
    drawThermo();
    ctx.strokeStyle = ink(0.08);
    ctx.beginPath();
    ctx.moveTo(COL_X + 16, 264);
    ctx.lineTo(W - 28, 264);
    ctx.stroke();
    if (state.plot === 'pv') drawPV();
    else drawSpeeds();
  }

  let lastDt = 0.016;
  function draw() {
    readTheme();
    ctx.clearRect(0, 0, W, H);
    drawBackdrop(ctx, SCENE_W, H, LIGHT);
    drawScene();
    drawInstruments(lastDt);
  }

  // --- text ------------------------------------------------------------------
  const setEq = equation();
  const setResult = result();
  const setRows = readout();
  function note() {
    if (Math.abs(state.u) > 1e-4 && state.walls === 'insulated')
      return state.u < 0
        ? 'The piston is moving in: atoms come back off it faster, so the gas heats as it is squeezed.'
        : 'The piston is backing off: atoms come back off it slower, so the gas cools as it expands.';
    if (state.walls === 'bath' && Math.abs(avg.T - state.temp) > 0.12 * state.temp)
      return `The gas is ${avg.T < state.temp ? 'warming towards' : 'cooling towards'} the plate: each atom that touches it leaves at the plate's temperature.`;
    return 'Pressure is impacts: the momentum the atoms hand the walls each second, per square metre. Count it and PV = NkT comes out.';
  }
  function updateText() {
    const ratio = avg.ls > 0 ? avg.ps / avg.ls : 0;
    const T = avg.T;
    setEq({
      rule: [['P', P_COL], ['V', V_COL], '\\;=\\;N k_B', ['T', T_COL]],
      live: [
        [`P = ${fmtKPa(avg.pf)}\\,\\text{kPa}`, P_COL],
        [`\\quad \\tfrac{Nk_BT}{V} = ${fmtKPa(avg.lf)}\\,\\text{kPa}`, LAW],
        `\\quad \\text{ratio } ${ratio.toFixed(3)}`,
      ],
    });
    setResult({
      value: `${fmtKPa(avg.pf)} kPa`,
      colour: P_COL,
      status: `NkT/V predicts ${fmtKPa(avg.lf)} kPa · ratio ${ratio.toFixed(3)} over 10 s · T ${T.toFixed(0)} K · V ${(volume() / 1000).toFixed(2)}×10³ nm³`,
      note: note(),
    });
    setRows({
      'r-p': `${fmtKPa(avg.pf)} kPa`,
      'r-law': `${fmtKPa(avg.lf)} kPa`,
      'r-ratio': ratio.toFixed(3),
      'r-t': `${T.toFixed(1)} K`,
      'r-plate': state.walls === 'bath' ? `${state.temp} K` : 'insulated',
      'r-v': `${(volume() / 1000).toFixed(2)}×10³ nm³`,
      'r-vrms': `${(Math.sqrt(3 * KM * kinT()) * 1000).toFixed(0)} m/s`,
      'r-hits': avg.hitRate ? avg.hitRate.toFixed(0) : '—',
    });
  }

  // --- loop ------------------------------------------------------------------
  let last = performance.now(), textClock = 1;
  function tick(dtReal: number) {
    advance(dtReal);
    pathClock += dtReal;
    if (pathClock > 0.08) {
      pathClock = 0;
      path.push({ v: volume(), p: lawNow() });
      if (path.length > 500) path.shift();
    }
  }
  function frame(now: number) {
    const dtReal = Math.min(0.05, Math.max(0, (now - last) / 1000));
    last = now;
    lastDt = dtReal;
    if (state.running) tick(dtReal);
    for (let k = sparks.length - 1; k >= 0; k--) {
      sparks[k].life -= dtReal * 4;
      if (sparks[k].life <= 0) sparks.splice(k, 1);
    }
    draw();
    textClock += dtReal;
    if (textClock > 0.15) {
      textClock = 0;
      updateText();
    }
    requestAnimationFrame(frame);
  }

  // --- controls --------------------------------------------------------------
  const tp = transport({
    onRun: (on) => { state.running = on; },
    onStep: () => {
      state.running = false;
      tp.setRunning(false);
      tick(1 / 30);
      updateText();
    },
    onReset: build,
  });
  const walls = segmented('walls', (v) => {
    state.walls = v as 'bath' | 'insulated';
    path.length = 0;
  });
  const setTemp = slider('temp', (v) => { state.temp = v; }, (v) => `${v} K`);
  const setPiston = slider('piston', (v) => { state.target = v; touched = true; }, (v) => `${v.toFixed(1)} nm`);
  const setN = slider('n', (v) => { state.n = v; build(); });
  const plot = segmented('plot', (v) => { state.plot = v as 'pv' | 'speed'; histFresh = true; });
  const rateText = (v: number) => `${v.toFixed(2)}× (${Math.round(v * BASE)} ps/s)`;
  const setRate = slider('rate', (v) => { state.rate = v; }, rateText);
  check('sparks', (on) => { state.sparks = on; if (!on) sparks.length = 0; });
  const setTrail = check('trail', (on) => { state.trail = on; trail.length = 0; });

  // dragging the piston, orbiting everywhere else
  let dragging: 'none' | 'piston' | 'panel' = 'none';
  let hover = false, touched = false, grabOffset = 0;
  const heightAt = (sx: number, sy: number) => {
    const f = cam.forward();
    const n = V.unit({ x: f.x, y: 0, z: f.z });
    const hit = cam.hitPlane(sx, sy, w3(0, state.h, 0), n);
    return hit ? hit.y * 10 + YC : null;
  };
  const overPiston = (x: number, y: number) =>
    x < SCENE_W && (inPoly(pistonHull, x, y) || Math.hypot(x - knob.sx, y - knob.sy) < knob.r + 8);
  orbitControls(canvas, cam, W, H, {
    changed: () => {
      cam.pitch = Math.max(-1.3, Math.min(-0.08, cam.pitch));
      if (!state.running) draw();
    },
    grab: (x, y) => {
      if (x > COL_X) {
        dragging = 'panel';
        if (x > PL.x - 50 && y > PL.y - 40 && y < PL.y + PL.h + 40) {
          state.plot = state.plot === 'pv' ? 'speed' : 'pv';
          plot.select(state.plot);
          histFresh = true;
          if (!state.running) draw();
        }
        return true;
      }
      if (!overPiston(x, y)) return false;
      const hy = heightAt(x, y);
      if (hy === null) return false;
      dragging = 'piston';
      touched = true;
      grabOffset = state.h - hy;
      canvas.style.cursor = 'grabbing';
      return true;
    },
    drag: (x, y) => {
      if (dragging !== 'piston') return;
      const hy = heightAt(x, y);
      if (hy === null) return;
      const t = Math.round(Math.max(HMIN, Math.min(HMAX, hy + grabOffset)) * 2) / 2;
      state.target = t;
      setPiston(t);
      if (!state.running) draw();
    },
    release: () => {
      dragging = 'none';
      canvas.style.cursor = '';
    },
  });
  canvas.addEventListener('pointermove', (e) => {
    if (dragging !== 'none') return;
    const r = canvas.getBoundingClientRect();
    const x = ((e.clientX - r.left) / r.width) * W, y = ((e.clientY - r.top) / r.height) * H;
    hover = overPiston(x, y);
    canvas.style.cursor = hover ? 'grab' : x > COL_X && y > PL.y - 40 ? 'pointer' : '';
  });

  /** A fresh gas with the piston at `from`, then sent to `to`, running. */
  function scene(o: { walls: 'bath' | 'insulated'; from: number; to?: number; temp?: number; heatTo?: number; plot: 'pv' | 'speed'; trail?: boolean; n?: number }) {
    state.walls = o.walls;
    walls.select(o.walls);
    state.temp = o.temp ?? 300;
    setTemp(state.temp);
    state.n = o.n ?? 300;
    setN(state.n);
    state.rate = 1;
    setRate(1);
    state.plot = o.plot;
    plot.select(o.plot);
    state.trail = !!o.trail;
    setTrail(state.trail);
    state.target = o.from;
    build();
    state.target = o.to ?? o.from;
    setPiston(state.target);
    if (o.heatTo) {
      state.temp = o.heatTo;
      setTemp(o.heatTo);
    }
    state.running = true;
    tp.setRunning(true);
  }
  tries({
    boyle: () => scene({ walls: 'bath', from: 30, to: 15, plot: 'pv' }),
    adiabat: () => scene({ walls: 'insulated', from: 30, to: 10, plot: 'pv' }),
    heat: () => scene({ walls: 'bath', from: 20, heatTo: 900, plot: 'pv' }),
    mb: () => scene({ walls: 'insulated', from: 30, plot: 'speed', trail: true }),
  });

  build();
  requestAnimationFrame(frame);
</script>

<style>
  .gas-canvas {
    touch-action: none;
  }
</style>
