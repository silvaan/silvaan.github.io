  .wave-canvas {
    cursor: crosshair;
    touch-action: none;
  }
  .scale-hint {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: var(--text-faint);
    margin-top: 3px;
  }
  .note {
    font-size: 0.82rem;
    color: var(--text-faint);
    margin: 0;
    line-height: 1.55;
  }
</style>
