---
import SimLayout from '../../../layouts/SimLayout.astro';
import Transport from '../../../components/sim/Transport.astro';
import Actions from '../../../components/sim/Actions.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Checks from '../../../components/sim/Checks.astro';
import Readout from '../../../components/sim/Readout.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Try from '../../../components/sim/Try.astro';

const U_COL = '#f59e0b', UB_COL = '#0ea5e9', A_COL = '#ec4899';
---

<SimLayout
  areaSlug="physics"
  title="Wave Equation"
  description="A drum skin where every point accelerates toward the average of its four neighbours. Put a probe anywhere and watch that pull live: down on a crest, up in a trough, nothing on a straight slope. Swap in the heat equation and the same pull only slides the point into place."
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas id="wave" class="wave-canvas" width="900" height="640" role="img" aria-label="A membrane drawn as a lit 3D surface, coloured teal where it is above rest and orange where it is below, with a probe point and its four neighbours marked on it. A lens panel magnifies that five-point neighbourhood from the side: the point's height, the average height of its neighbours, and the acceleration the gap between them causes. Below, a strip plots the kinetic and potential energy over time."></canvas>
      </div>
      <Caption
        legend={[
          { label: 'above rest', color: '#2dd4bf', id: 'leg-up' },
          { label: 'below rest', color: '#ff7a5c', id: 'leg-down' },
          { label: 'probe height u', color: U_COL },
          { label: 'neighbour average ū', color: UB_COL },
          { label: 'acceleration a', color: A_COL, id: 'leg-a' },
        ]}
        hint="Click the skin to drop a pulse; hold and drag to pull a finger through it. Drag the yellow probe (or pick Move the probe) to inspect any point. Drag off the skin (or right-drag) to orbit, scroll to zoom."
      />
      <Result label="Neighbours’ pull on the probe, ū − u" />
    </div>

    <div class="sim-panel">
      <Transport step running />
      <Seg
        id="tap"
        label="Clicking the skin"
        attr="t"
        options={[
          { value: 'pulse', label: 'Drops a pulse' },
          { value: 'probe', label: 'Moves the probe' },
        ]}
      />
      <Actions>
        <button type="button" class="btn" id="drop">Drop a pulse</button>
        <button type="button" class="btn ghost" id="two">Two pulses</button>
        <button type="button" class="btn ghost" id="calm">Calm</button>
      </Actions>
      <Seg
        id="shape"
        label="Drum"
        attr="s"
        options={[
          { value: 'square', label: 'Square' },
          { value: 'round', label: 'Round' },
        ]}
      />
      <Seg
        id="edge"
        label="Edge"
        attr="e"
        options={[
          { value: 'fixed', label: 'Fixed' },
          { value: 'free', label: 'Free' },
          { value: 'open', label: 'Open water' },
        ]}
      />
      <Slider id="speed" label="Wave speed" min={20} max={150} step={5} value={50} display="c = 0.50" hint={['slow', 'fast']} />
      <Slider id="damp" label="Damping γ" min={0} max={100} step={1} value={0} display="0 /s" hint={['none', 'heavy']} />
      <Checks
        items={[
          { id: 'heat', label: 'Diffuse instead (heat equation)' },
          { id: 'pull', label: 'Colour by pull, ∇²u' },
          { id: 'rain', label: 'Rain' },
        ]}
      />
      <Readout
        title="Numbers"
        rows={[
          { id: 'r-u', label: 'Probe height u' },
          { id: 'r-ub', label: 'Neighbour average ū' },
          { id: 'r-a', label: 'Acceleration a' },
          { id: 'r-e', label: 'Energy left' },
          { id: 'r-k', label: 'Kinetic' },
          { id: 'r-v', label: 'Potential' },
          { id: 'r-t', label: 'Time since reset' },
          { id: 'r-grid', label: 'Grid' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Watch the probe as a <b>ring passes</b>. On the crest its neighbours sit lower, so ū is below u
      and the arrow points down; in the trough behind, it points up. <Try id="ring" />
    </li>
    <li>
      Put the probe on the <b>flank of a wide bump</b>. The skin is steep there, but what the
      uphill neighbours add the downhill ones take away: their average lands on the probe and there
      is no pull. Only curvature counts. <Try id="slope" />
    </li>
    <li>
      Switch to the <b>heat equation</b>: the same gap now sets the velocity, not the acceleration.
      The probe on a bump slides toward its neighbours and never dips below rest, so the bump sags
      in place. Untick it and the point shoots straight past rest. <Try id="heat" />
    </li>
    <li>
      Drop <b>two pulses</b> with the probe between them. The pulls just add, so the rings cross and
      come out the other side as if the other had never been there. <Try id="two" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import type { Part } from '../../../lib/equation';
  import { Camera3D, orbitControls, drawBackdrop, V } from '../../../lib/scene3d';
  import type { Vec } from '../../../lib/scene3d';
  import { el, segmented, slider, check, transport, result, readout, tries } from '../../../lib/panel';

  // --- the membrane ----------------------------------------------------------
  // N × N cells over [-1, 1]², leapfrog in time: u⁺ = 2u − u⁻ + r²∇²u with the
  // Courant number r = c·dt/h fixed at 0.5 (2D needs r ≤ 1/√2). Wave speed sets
  // how many steps run per second, so changing it never risks the blow-up.
  const N = 160;
  const NN = N * N;
  const h = 2 / N;
  const R = 0.5, R2 = R * R;
  const HEAT_A = 0.2; // D·dt/h² per step when diffusing (explicit Euler needs ≤ 0.25)
  const SPONGE = 0.26; // width of the soaking band at an open edge

  let u = new Float32Array(NN), uo = new Float32Array(NN), un = new Float32Array(NN);
  const inside = new Uint8Array(NN);
  const nb = new Int32Array(4 * NN); // neighbour index, −1 = a fixed edge (u = 0), self = a free edge
  const sponge = new Float32Array(NN);
  const rimSrc = new Int32Array(NN); // drawing only: inside cell an outside cell copies, −1 none
  const lap = new Float32Array(NN);
  const px = (i: number) => -1 + (i + 0.5) * h; // world x (and z) of a cell centre

  const KE = '#7c8cff', PE = '#c084fc';
  // the probe's colours: the same hues as the equation, a shade lighter on the dark stage
  const U_EQ = '#f59e0b', UB_EQ = '#0ea5e9', A_EQ = '#ec4899';
  const PAL = {
    dark: { u: '#fbbf24', ub: '#38bdf8', a: '#f472b6' },
    light: { u: '#d97706', ub: '#0284c7', a: '#db2777' },
  };

  const state = {
    shape: 'square',
    edge: 'fixed',
    c: 0.5,
    gamma: 0,
    heat: false,
    pull: false,
    rain: false,
    tap: 'pulse',
    running: true,
    t: 0,
    acc: 0, // fractional steps carried between frames
    eRef: 0, // energy the last disturbance left in the skin
  };

  /** Steps per second: c·dt/h = R, so steps/s = c / (R h). */
  const stepsPerSec = () => state.c / (R * h);
  const D = () => HEAT_A * h * h * stepsPerSec();

  function buildGrid() {
    const round = state.shape === 'round';
    for (let j = 0; j < N; j++)
      for (let i = 0; i < N; i++) {
        const k = j * N + i, x = px(i), z = px(j);
        const d = round ? Math.hypot(x, z) : Math.max(Math.abs(x), Math.abs(z));
        inside[k] = !round || d < 1 ? 1 : 0;
        // open water soaks waves up in a round band, so it reads as a pond with no edge
        const s = (Math.hypot(x, z) - (1 - SPONGE)) / SPONGE;
        sponge[k] = state.edge === 'open' && s > 0 ? 0.32 * Math.min(1, s) ** 2 : 0;
      }
    const free = state.edge !== 'fixed';
    for (let j = 0; j < N; j++)
      for (let i = 0; i < N; i++) {
        const k = j * N + i;
        const ns = [i > 0 ? k - 1 : -2, i < N - 1 ? k + 1 : -2, j > 0 ? k - N : -2, j < N - 1 ? k + N : -2];
        for (let q = 0; q < 4; q++) {
          let n = ns[q];
          if (n >= 0 && !inside[n]) n = -2;
          nb[4 * k + q] = n === -2 ? (free ? k : -1) : n;
        }
      }
    for (let k = 0; k < NN; k++) if (!inside[k]) { u[k] = 0; uo[k] = 0; }
    // Cells just outside a round drum borrow their nearest inside neighbour's
    // height when drawn, so a free rim ends cleanly instead of in teeth.
    rimSrc.fill(-1);
    if (round)
      for (let j = 0; j < N; j++)
        for (let i = 0; i < N; i++) {
          const k = j * N + i;
          if (inside[k]) continue;
          let best = -1, bd = 9;
          for (let dj = -2; dj <= 2; dj++)
            for (let di = -2; di <= 2; di++) {
              const ii = i + di, jj = j + dj;
              if (ii < 0 || jj < 0 || ii >= N || jj >= N || !inside[jj * N + ii]) continue;
              const dd = di * di + dj * dj;
              if (dd < bd) { bd = dd; best = jj * N + ii; }
            }
          rimSrc[k] = best;
        }
  }

  function laplacian(a: Float32Array, out: Float32Array) {
    for (let k = 0; k < NN; k++) {
      if (!inside[k]) { out[k] = 0; continue; }
      const b = 4 * k;
      let s = -4 * a[k];
      for (let q = 0; q < 4; q++) { const n = nb[b + q]; if (n >= 0) s += a[n]; }
      out[k] = s;
    }
  }

  let finger: { x: number; z: number } | null = null;
  function step() {
    const gBase = (state.gamma / stepsPerSec()) / 2;
    if (state.heat) {
      laplacian(u, lap);
      for (let k = 0; k < NN; k++) {
        if (!inside[k]) continue;
        un[k] = (u[k] + HEAT_A * lap[k]) / (1 + 2 * (gBase + sponge[k]));
      }
      uo.set(u);
    } else {
      for (let k = 0; k < NN; k++) {
        if (!inside[k]) { un[k] = 0; continue; }
        const b = 4 * k;
        let s = -4 * u[k];
        for (let q = 0; q < 4; q++) { const n = nb[b + q]; if (n >= 0) s += u[n]; }
        const g = gBase + sponge[k];
        un[k] = (2 * u[k] - (1 - g) * uo[k] + R2 * s) / (1 + g);
      }
      const t = uo; uo = u; u = un; un = t;
    }
    if (state.heat) { const t = u; u = un; un = t; }
    if (finger) press(finger.x, finger.z);
    state.t += 1 / stepsPerSec();
  }

  /** A finger held in the water pins it a little below rest under the fingertip. */
  function press(x: number, z: number) {
    const s = 0.055, rad = Math.ceil((2.5 * s) / h);
    const ci = Math.round((x + 1) / h - 0.5), cj = Math.round((z + 1) / h - 0.5);
    for (let j = cj - rad; j <= cj + rad; j++)
      for (let i = ci - rad; i <= ci + rad; i++) {
        if (i < 0 || j < 0 || i >= N || j >= N) continue;
        const k = j * N + i;
        if (!inside[k]) continue;
        const d2 = ((px(i) - x) ** 2 + (px(j) - z) ** 2) / (s * s);
        const w = Math.exp(-d2) * 0.18;
        const target = -0.45;
        const nu = u[k] + (target - u[k]) * w;
        if (!state.heat) uo[k] += nu - u[k]; // move it without kicking it
        u[k] = nu;
      }
  }

  // --- energy ---------------------------------------------------------------
  // The leapfrog keeps ½|u⁺ − u|² + ½r²⟨∇u⁺, ∇u⟩ exactly constant, so that is
  // the energy shown: kinetic from the step, potential from the stretch.
  let eK = 0, eV = 0;
  function energy() {
    let k2 = 0, v2 = 0;
    for (let k = 0; k < NN; k++) {
      if (!inside[k]) continue;
      const a = u[k], b = state.heat ? u[k] : uo[k];
      if (!state.heat) k2 += (a - b) * (a - b);
      const o = 4 * k;
      for (let q = 0; q < 4; q++) {
        const n = nb[o + q];
        if (n === -1) v2 += a * b;
        else if (n > k) v2 += (a - u[n]) * (b - (state.heat ? u[n] : uo[n]));
      }
    }
    eK = 0.5 * k2;
    eV = 0.5 * R2 * v2;
  }
  const eTot = () => eK + eV;
  /** Anything that pumps energy in resets what "100%" means. */
  function injected() {
    peaksH.length = 0;
    peaksP.length = 0;
    energy();
    state.eRef = Math.max(eTot(), 1e-12);
  }

  // --- disturbances ---------------------------------------------------------
  function bump(x: number, z: number, amp = 1, s = 0.07) {
    const rad = Math.ceil((3 * s) / h);
    const ci = Math.round((x + 1) / h - 0.5), cj = Math.round((z + 1) / h - 0.5);
    for (let j = cj - rad; j <= cj + rad; j++)
      for (let i = ci - rad; i <= ci + rad; i++) {
        if (i < 0 || j < 0 || i >= N || j >= N) continue;
        const k = j * N + i;
        if (!inside[k]) continue;
        const g = amp * Math.exp(-((px(i) - x) ** 2 + (px(j) - z) ** 2) / (s * s));
        u[k] += g;
        uo[k] += g; // released from rest
      }
    fronts.push({ x, z, t: state.t });
    if (fronts.length > 6) fronts.shift();
  }
  function drop(x: number, z: number, amp = 1) {
    bump(x, z, amp);
    injected();
    mark('drop');
  }
  function calm() {
    u.fill(0); uo.fill(0);
    fronts.length = 0;
    clearProbeTrace();
    finger = null;
    state.t = 0;
    trace.length = 0;
    marks.length = 0;
    injected();
  }

  // --- drawing --------------------------------------------------------------
  const canvas = el('wave') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const VH = 532; // the 3D view; the energy strip sits below it
  const VW = W - 150; // the drum is centred left of the lens panel
  const TR = { x: 64, y: VH + 30, w: W - 96, h: H - VH - 46 };
  const cam = new Camera3D(VW, VH, { dist: 5.4, yaw: 0.62, pitch: -0.62, zoom: 1.5 });
  const A = 0.4; // world height of u = 1

  const css = (v: string) => getComputedStyle(canvas).getPropertyValue(v).trim();
  let ink = '232,233,236', light = false;
  const readTheme = () => {
    ink = css('--stage-ink') || '232,233,236';
    light = css('--stage-light') === '1';
  };
  readTheme();
  window.addEventListener('themechange', () => { readTheme(); draw(); });

  // ---- WebGL2 surface ----
  const VS_SURF = `#version 300 es
  precision highp float;
  in vec2 aG;
  uniform sampler2D uF;
  uniform float uN, uA;
  uniform vec4 uCam;   // yaw, pitch, dist, k
  uniform vec2 uHalf;  // half the view in logical pixels
  out vec2 vUV;
  out vec3 vW;
  vec4 project(vec3 p) {
    float cy = cos(uCam.x), sy = sin(uCam.x), cp = cos(uCam.y), sp = sin(uCam.y);
    float x1 = p.x * cy + p.z * sy, z1 = -p.x * sy + p.z * cy;
    float y2 = p.y * cp - z1 * sp, z2 = p.y * sp + z1 * cp;
    float zc = z2 + uCam.z;
    return vec4(x1 * uCam.w / uHalf.x, y2 * uCam.w / uHalf.y, ((zc - 0.3) / 30.0 * 2.0 - 1.0) * zc, zc);
  }
  void main() {
    vUV = (aG + 0.5) / uN;
    float y = texelFetch(uF, ivec2(aG), 0).r * uA;
    vW = vec3(vUV.x * 2.0 - 1.0, y, vUV.y * 2.0 - 1.0);
    gl_Position = project(vW);
  }`;

  const FS_SURF = `#version 300 es
  precision highp float;
  in vec2 vUV;
  in vec3 vW;
  uniform sampler2D uF;
  uniform float uN, uA, uGain, uPull, uRound, uOpen, uLight, uSponge;
  uniform vec3 uL, uEye, uBase, uUp, uDown, uInk, uSky;
  out vec4 o;
  void main() {
    float r = length(vW.xz);
    if (uRound > 0.5 && r > 1.0) discard;
    float alpha = uOpen > 0.5 ? 1.0 - smoothstep(1.0 - uSponge * 1.15, 1.0 - uSponge * 0.1, r) : 1.0;
    if (alpha < 0.004) discard;
    float e = 1.0 / uN;
    vec4 f = texture(uF, vUV);
    float hx = texture(uF, vUV + vec2(e, 0.0)).r - texture(uF, vUV - vec2(e, 0.0)).r;
    float hz = texture(uF, vUV + vec2(0.0, e)).r - texture(uF, vUV - vec2(0.0, e)).r;
    vec3 n = normalize(vec3(-hx * uA / (4.0 * e), 1.0, -hz * uA / (4.0 * e)));
    vec3 v = normalize(uEye - vW);
    if (dot(n, v) < 0.0) n = -n;
    float val = (uPull > 0.5 ? f.g : f.r * uGain);
    float m = pow(clamp(abs(val), 0.0, 1.0), 0.75);
    vec3 tint = val >= 0.0 ? uUp : uDown;
    vec3 col = mix(uBase, tint, m * (uLight > 0.5 ? 0.92 : 0.85));
    // a faint weave on the skin so its shape reads in 3D
    vec2 g = abs(fract(vW.xz * 6.0 - 0.5) - 0.5) / fwidth(vW.xz * 6.0);
    float weave = 1.0 - smoothstep(0.0, 1.2, min(g.x, g.y));
    col = mix(col, uInk, weave * (uLight > 0.5 ? 0.07 : 0.06));
    float diff = max(dot(n, uL), 0.0);
    vec3 hv = normalize(uL + v);
    float spec = pow(max(dot(n, hv), 0.0), 70.0);
    float fres = pow(1.0 - max(dot(n, v), 0.0), 3.0);
    vec3 lit = col * (uLight > 0.5 ? 0.5 + 0.55 * diff : 0.42 + 0.68 * diff);
    if (uLight > 0.5) {
      lit += vec3(1.0) * spec * 0.3;
    } else {
      lit += tint * m * 0.28 + uSky * fres * 0.35 + vec3(0.9, 0.95, 1.0) * spec * 0.6;
    }
    o = vec4(lit * alpha, alpha);
  }`;

  const VS_SHELL = `#version 300 es
  precision highp float;
  in vec3 aP;
  in vec3 aN;
  uniform vec4 uCam;
  uniform vec2 uHalf;
  out vec3 vN;
  out vec3 vW;
  vec4 project(vec3 p) {
    float cy = cos(uCam.x), sy = sin(uCam.x), cp = cos(uCam.y), sp = sin(uCam.y);
    float x1 = p.x * cy + p.z * sy, z1 = -p.x * sy + p.z * cy;
    float y2 = p.y * cp - z1 * sp, z2 = p.y * sp + z1 * cp;
    float zc = z2 + uCam.z;
    return vec4(x1 * uCam.w / uHalf.x, y2 * uCam.w / uHalf.y, ((zc - 0.3) / 30.0 * 2.0 - 1.0) * zc, zc);
  }
  void main() { vN = aN; vW = aP; gl_Position = project(aP); }`;

  const FS_SHELL = `#version 300 es
  precision highp float;
  in vec3 vN;
  in vec3 vW;
  uniform vec3 uL, uEye, uCol;
  out vec4 o;
  void main() {
    vec3 n = normalize(vN);
    vec3 v = normalize(uEye - vW);
    float diff = max(dot(n, uL), 0.0);
    float spec = pow(max(dot(n, normalize(uL + v)), 0.0), 40.0);
    o = vec4(uCol * (0.45 + 0.6 * diff) + vec3(spec * 0.25), 1.0);
  }`;

  type Gl = {
    gl: WebGL2RenderingContext;
    glc: HTMLCanvasElement;
    surf: WebGLProgram;
    shell: WebGLProgram;
    vaoSurf: WebGLVertexArrayObject;
    nIdx: number;
    vaoShell: WebGLVertexArrayObject;
    shellBuf: WebGLBuffer;
    nShell: number;
    tex: WebGLTexture;
    U: Record<string, WebGLUniformLocation | null>;
  };

  function compile(gl: WebGL2RenderingContext, vs: string, fs: string) {
    const sh = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s) ?? 'shader');
      return s;
    };
    const p = gl.createProgram()!;
    gl.attachShader(p, sh(gl.VERTEX_SHADER, vs));
    gl.attachShader(p, sh(gl.FRAGMENT_SHADER, fs));
    gl.linkProgram(p);
    if (!gl.getProgramParameter(p, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(p) ?? 'link');
    return p;
  }

  function makeGl(): Gl | null {
    const glc = document.createElement('canvas');
    const gl = glc.getContext('webgl2', { premultipliedAlpha: true, alpha: true, antialias: true });
    if (!gl) return null;
    try {
      const surf = compile(gl, VS_SURF, FS_SURF);
      const shell = compile(gl, VS_SHELL, FS_SHELL);
      const U: Record<string, WebGLUniformLocation | null> = {};
      for (const n of ['uF', 'uN', 'uA', 'uCam', 'uHalf', 'uGain', 'uPull', 'uRound', 'uOpen', 'uLight', 'uSponge',
        'uL', 'uEye', 'uBase', 'uUp', 'uDown', 'uInk', 'uSky']) U['s.' + n] = gl.getUniformLocation(surf, n);
      for (const n of ['uCam', 'uHalf', 'uL', 'uEye', 'uCol']) U['h.' + n] = gl.getUniformLocation(shell, n);

      // the skin: one vertex per cell, two triangles per square of four
      const vaoSurf = gl.createVertexArray()!;
      gl.bindVertexArray(vaoSurf);
      const g = new Float32Array(2 * NN);
      for (let j = 0; j < N; j++) for (let i = 0; i < N; i++) { g[2 * (j * N + i)] = i; g[2 * (j * N + i) + 1] = j; }
      const vb = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, vb);
      gl.bufferData(gl.ARRAY_BUFFER, g, gl.STATIC_DRAW);
      const la = gl.getAttribLocation(surf, 'aG');
      gl.enableVertexAttribArray(la);
      gl.vertexAttribPointer(la, 2, gl.FLOAT, false, 0, 0);
      const idx = new Uint32Array(6 * (N - 1) * (N - 1));
      let q = 0;
      for (let j = 0; j < N - 1; j++)
        for (let i = 0; i < N - 1; i++) {
          const a = j * N + i;
          idx.set([a, a + 1, a + N, a + 1, a + N + 1, a + N], q);
          q += 6;
        }
      const ib = gl.createBuffer();
      gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, ib);
      gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, idx, gl.STATIC_DRAW);

      const vaoShell = gl.createVertexArray()!;
      gl.bindVertexArray(vaoShell);
      const shellBuf = gl.createBuffer()!;
      gl.bindBuffer(gl.ARRAY_BUFFER, shellBuf);
      const lp = gl.getAttribLocation(shell, 'aP'), ln = gl.getAttribLocation(shell, 'aN');
      gl.enableVertexAttribArray(lp);
      gl.vertexAttribPointer(lp, 3, gl.FLOAT, false, 24, 0);
      gl.enableVertexAttribArray(ln);
      gl.vertexAttribPointer(ln, 3, gl.FLOAT, false, 24, 12);
      gl.bindVertexArray(null);

      const tex = gl.createTexture()!;
      gl.bindTexture(gl.TEXTURE_2D, tex);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA16F, N, N, 0, gl.RGBA, gl.FLOAT, null);
      return { gl, glc, surf, shell, vaoSurf, nIdx: idx.length, vaoShell, shellBuf, nShell: 0, tex, U };
    } catch (err) {
      console.warn('wave-equation: WebGL2 setup failed', err);
      return null;
    }
  }
  const G = makeGl();

  /** The drum frame: a lit rim with a short wall, square or round. */
  function buildShell() {
    if (!G) return;
    const out: number[] = [];
    const quad = (p: number[][], n: number[][]) => {
      for (const k of [0, 1, 2, 0, 2, 3]) out.push(...p[k], ...n[k]);
    };
    const s0 = 1 + h * 0.5, s1 = s0 + 0.07, yt = 0.02, yb = -0.2, yi = -0.05;
    if (state.shape === 'square') {
      for (const [nx, nz] of [[1, 0], [0, 1], [-1, 0], [0, -1]]) {
        const tx = -nz, tz = nx;
        const P = (s: number, sign: number, y: number) => [nx * s + tx * s * sign, y, nz * s + tz * s * sign];
        const up = [0, 1, 0], outN = [nx, 0, nz], inN = [-nx, 0, -nz], dn = [0, -1, 0];
        quad([P(s0, -1, yt), P(s0, 1, yt), P(s1, 1, yt), P(s1, -1, yt)], [up, up, up, up]);
        quad([P(s1, -1, yt), P(s1, 1, yt), P(s1, 1, yb), P(s1, -1, yb)], [outN, outN, outN, outN]);
        quad([P(s0, -1, yi), P(s0, 1, yi), P(s0, 1, yt), P(s0, -1, yt)], [inN, inN, inN, inN]);
        quad([P(s0, -1, yb), P(s1, -1, yb), P(s1, 1, yb), P(s0, 1, yb)], [dn, dn, dn, dn]);
      }
    } else {
      const S = 120;
      const r0 = 1 + h * 0.3, r1 = r0 + 0.06;
      for (let q = 0; q < S; q++) {
        const a = (q / S) * 2 * Math.PI, b = ((q + 1) / S) * 2 * Math.PI;
        const ca = Math.cos(a), sa = Math.sin(a), cb = Math.cos(b), sb = Math.sin(b);
        const up = [0, 1, 0], dn = [0, -1, 0];
        quad([[ca * r0, yt, sa * r0], [cb * r0, yt, sb * r0], [cb * r1, yt, sb * r1], [ca * r1, yt, sa * r1]], [up, up, up, up]);
        quad([[ca * r1, yt, sa * r1], [cb * r1, yt, sb * r1], [cb * r1, yb, sb * r1], [ca * r1, yb, sa * r1]],
          [[ca, 0, sa], [cb, 0, sb], [cb, 0, sb], [ca, 0, sa]]);
        quad([[ca * r0, yi, sa * r0], [cb * r0, yi, sb * r0], [cb * r0, yt, sb * r0], [ca * r0, yt, sa * r0]],
          [[-ca, 0, -sa], [-cb, 0, -sb], [-cb, 0, -sb], [-ca, 0, -sa]]);
        quad([[ca * r0, yb, sa * r0], [ca * r1, yb, sa * r1], [cb * r1, yb, sb * r1], [cb * r0, yb, sb * r0]], [dn, dn, dn, dn]);
      }
    }
    const gl = G.gl;
    gl.bindBuffer(gl.ARRAY_BUFFER, G.shellBuf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(out), gl.STATIC_DRAW);
    G.nShell = out.length / 6;
  }

  const pack = new Float32Array(4 * NN);
  let gainH = 1, gainP = 1;
  const peaksH: number[] = [], peaksP: number[] = [];
  function upload() {
    laplacian(u, lap);
    let pk = 0, pl = 0;
    for (let k = 0; k < NN; k++) {
      if (!inside[k]) continue;
      pk = Math.max(pk, Math.abs(u[k]));
      if (sponge[k] === 0) pl = Math.max(pl, Math.abs(lap[k]));
    }
    // colour gain follows the tallest point of the last few seconds, so a
    // sloshing skin passing through flat really fades instead of being re-stretched
    peaksH.push(pk); peaksP.push(pl);
    if (peaksH.length > 50) { peaksH.shift(); peaksP.shift(); }
    gainH = 1 / Math.max(0.12, ...peaksH);
    gainP = 1 / Math.max(1e-4, ...peaksP);
    for (let k = 0; k < NN; k++) {
      pack[4 * k] = u[k];
      pack[4 * k + 1] = lap[k] * gainP;
    }
    if (state.edge !== 'fixed')
      for (let k = 0; k < NN; k++) {
        const s = rimSrc[k];
        if (s < 0) continue;
        pack[4 * k] = pack[4 * s];
        pack[4 * k + 1] = pack[4 * s + 1];
      }
  }

  const hex3 = (c: string) => [1, 3, 5].map((o) => parseInt(c.slice(o, o + 2), 16) / 255);
  let glScale = 1;
  function renderGl(g: Gl) {
    const gl = g.gl, U = g.U;
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    const w = Math.round(VW * dpr * glScale), hh = Math.round(VH * dpr * glScale);
    if (g.glc.width !== w || g.glc.height !== hh) { g.glc.width = w; g.glc.height = hh; }
    gl.viewport(0, 0, w, hh);
    gl.clearColor(0, 0, 0, 0);
    gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
    gl.enable(gl.DEPTH_TEST);
    gl.enable(gl.BLEND);
    gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);

    // light from over the viewer's left shoulder, so the skin is always lit
    const L = V.unit(V.add(V.add(V.mul(cam.right(), -0.45), V.mul(cam.up(), 0.75)), V.mul(cam.forward(), -0.55)));
    const Lw = V.unit({ x: L.x, y: Math.abs(L.y) + 0.6, z: L.z });
    const eye = cam.eye();
    const camv = [cam.yaw, cam.pitch, cam.dist, cam.k] as const;

    if (state.edge === 'fixed' && g.nShell) {
      gl.useProgram(g.shell);
      gl.bindVertexArray(g.vaoShell);
      gl.uniform4f(U['h.uCam'], ...camv);
      gl.uniform2f(U['h.uHalf'], VW / 2, VH / 2);
      gl.uniform3f(U['h.uL'], Lw.x, Lw.y, Lw.z);
      gl.uniform3f(U['h.uEye'], eye.x, eye.y, eye.z);
      const col = light ? [0.78, 0.8, 0.85] : [0.22, 0.24, 0.31];
      gl.uniform3f(U['h.uCol'], col[0], col[1], col[2]);
      gl.drawArrays(gl.TRIANGLES, 0, g.nShell);
    }

    gl.useProgram(g.surf);
    gl.bindVertexArray(g.vaoSurf);
    gl.activeTexture(gl.TEXTURE0);
    gl.bindTexture(gl.TEXTURE_2D, g.tex);
    gl.texSubImage2D(gl.TEXTURE_2D, 0, 0, 0, N, N, gl.RGBA, gl.FLOAT, pack);
    gl.uniform1i(U['s.uF'], 0);
    gl.uniform1f(U['s.uN'], N);
    gl.uniform1f(U['s.uA'], A);
    gl.uniform4f(U['s.uCam'], ...camv);
    gl.uniform2f(U['s.uHalf'], VW / 2, VH / 2);
    gl.uniform1f(U['s.uGain'], gainH);
    gl.uniform1f(U['s.uPull'], state.pull ? 1 : 0);
    gl.uniform1f(U['s.uRound'], state.shape === 'round' ? 1 : 0);
    gl.uniform1f(U['s.uOpen'], state.edge === 'open' ? 1 : 0);
    gl.uniform1f(U['s.uSponge'], SPONGE);
    gl.uniform1f(U['s.uLight'], light ? 1 : 0);
    gl.uniform3f(U['s.uL'], Lw.x, Lw.y, Lw.z);
    gl.uniform3f(U['s.uEye'], eye.x, eye.y, eye.z);
    const [base, up, down, inkC, sky] = light
      ? [[0.82, 0.86, 0.92], hex3('#0d9488'), hex3('#ea580c'), [0.1, 0.11, 0.14], [1, 1, 1]]
      : [[0.13, 0.15, 0.21], hex3('#2dd4bf'), hex3('#ff7a5c'), [0.93, 0.94, 0.96], [0.45, 0.5, 0.95]];
    gl.uniform3f(U['s.uBase'], base[0], base[1], base[2]);
    gl.uniform3f(U['s.uUp'], up[0], up[1], up[2]);
    gl.uniform3f(U['s.uDown'], down[0], down[1], down[2]);
    gl.uniform3f(U['s.uInk'], inkC[0], inkC[1], inkC[2]);
    gl.uniform3f(U['s.uSky'], sky[0], sky[1], sky[2]);
    gl.drawElements(gl.TRIANGLES, g.nIdx, gl.UNSIGNED_INT, 0);
    gl.bindVertexArray(null);
    ctx.drawImage(g.glc, 0, 0, VW, VH);
  }

  // ---- 2D fallback: the same field seen from straight above ----
  const flat = document.createElement('canvas');
  flat.width = flat.height = N;
  const fctx = flat.getContext('2d')!;
  const fimg = fctx.createImageData(N, N);
  function renderFlat() {
    const up = light ? [13, 148, 136] : [45, 212, 191], dn = light ? [234, 88, 12] : [255, 122, 92];
    const base = light ? [240, 242, 246] : [30, 34, 46];
    const d = fimg.data;
    for (let k = 0; k < NN; k++) {
      const v = state.pull ? pack[4 * k + 1] : u[k] * gainH;
      const m = Math.min(1, Math.abs(v)) ** 0.75, t = v >= 0 ? up : dn;
      for (let c = 0; c < 3; c++) d[4 * k + c] = base[c] + (t[c] - base[c]) * m;
      d[4 * k + 3] = inside[k] ? 255 : 0;
    }
    fctx.putImageData(fimg, 0, 0);
    const s = VH - 60;
    ctx.imageSmoothingEnabled = true;
    ctx.drawImage(flat, (VW - s) / 2, 40, s, s);
    ctx.fillStyle = `rgba(${ink},0.6)`;
    ctx.font = '12px ui-monospace, monospace';
    ctx.textAlign = 'center';
    ctx.fillText('WebGL2 is not available here, so the skin is shown from above, flat.', VW / 2, 24);
    ctx.textAlign = 'left';
  }

  // ---- overlay: free-edge outline, expanding front guides, energy strip ----
  const fronts: { x: number; z: number; t: number }[] = [];
  function polyline3(pts: Vec[], style: string, dash: number[] = []) {
    ctx.strokeStyle = style;
    ctx.setLineDash(dash);
    ctx.lineWidth = 1.2;
    ctx.beginPath();
    pts.forEach((p, i) => {
      const q = cam.project(p);
      i ? ctx.lineTo(q.sx, q.sy) : ctx.moveTo(q.sx, q.sy);
    });
    ctx.stroke();
    ctx.setLineDash([]);
  }
  function outline(s: number, y = 0): Vec[] {
    if (state.shape === 'round') return Array.from({ length: 97 }, (_, q) => ({ x: s * Math.cos((q / 96) * 2 * Math.PI), y, z: s * Math.sin((q / 96) * 2 * Math.PI) }));
    return [{ x: -s, y, z: -s }, { x: s, y, z: -s }, { x: s, y, z: s }, { x: -s, y, z: s }, { x: -s, y, z: -s }];
  }
  function drawOverlay() {
    if (state.edge === 'free') polyline3(outline(1), `rgba(${ink},0.35)`, [5, 5]);
    if (state.heat || !G) return;
    // where a front released at speed c should be by now
    for (const f of fronts) {
      const r = state.c * (state.t - f.t);
      const age = r / 1.1;
      if (r < 0.12 || age > 1) continue;
      const pts: Vec[] = [];
      for (let q = 0; q <= 72; q++) {
        const a = (q / 72) * 2 * Math.PI;
        const x = f.x + r * Math.cos(a), z = f.z + r * Math.sin(a);
        const d = state.shape === 'round' ? Math.hypot(x, z) : Math.max(Math.abs(x), Math.abs(z));
        pts.push({ x, y: d < 1 ? 0.002 : NaN, z });
      }
      ctx.strokeStyle = `rgba(${ink},${0.32 * (1 - age)})`;
      ctx.setLineDash([3, 5]);
      ctx.lineWidth = 1;
      ctx.beginPath();
      let pen = false;
      for (const p of pts) {
        if (Number.isNaN(p.y)) { pen = false; continue; }
        const q = cam.project(p);
        pen ? ctx.lineTo(q.sx, q.sy) : ctx.moveTo(q.sx, q.sy);
        pen = true;
      }
      ctx.stroke();
      ctx.setLineDash([]);
    }
  }

  // --- the probe: one point and its four neighbours -------------------------
  // The solver's own stencil is one cell wide, a few pixels on screen, so the
  // probe reads its neighbours S cells out instead. Same rule, coarser ruler:
  // ∇²u ≈ (u_E + u_W + u_N + u_S − 4u) / H² = 4(ū − u) / H².
  const S = 4, HS = S * h;
  const probe = { i: 0, j: 0 };
  const P = { u: 0, ub: 0, nb: [0, 0, 0, 0], gap: 0, a: 0 }; // nb: E, W, N, S
  const pu: number[] = [], pg: number[] = []; // the probe's u and ū − u, one per frame
  const LSPAN = 240;
  let zScale = 0.05; // height scale of the probe's history, follows the tallest of the five points
  let dScale = 0.004; // vertical scale of the lens: the largest neighbour gap lately
  let probeScreen = { sx: -99, sy: -99 };

  function probeOk(i: number, j: number) {
    for (const [di, dj] of [[0, 0], [S, 0], [-S, 0], [0, S], [0, -S]]) {
      const ii = i + di, jj = j + dj;
      if (ii < 0 || jj < 0 || ii >= N || jj >= N || !inside[jj * N + ii]) return false;
    }
    return true;
  }
  function clearProbeTrace() {
    pu.length = 0;
    pg.length = 0;
    dScale = 0.004;
    zScale = 0.05;
  }
  /** Put the probe on the cell under (x, z), pulled in until all four neighbours are on the skin. */
  function setProbe(x: number, z: number) {
    let i = Math.max(S, Math.min(N - 1 - S, Math.round((x + 1) / h - 0.5)));
    let j = Math.max(S, Math.min(N - 1 - S, Math.round((z + 1) / h - 0.5)));
    while (!probeOk(i, j)) { i += Math.sign(N / 2 - i); j += Math.sign(N / 2 - j); }
    if (i === probe.i && j === probe.j) return;
    probe.i = i;
    probe.j = j;
    clearProbeTrace();
    readProbe();
  }
  function readProbe() {
    const k = probe.j * N + probe.i;
    P.u = u[k];
    P.nb[0] = u[k + S]; P.nb[1] = u[k - S]; P.nb[2] = u[k - S * N]; P.nb[3] = u[k + S * N];
    P.ub = (P.nb[0] + P.nb[1] + P.nb[2] + P.nb[3]) / 4;
    P.gap = P.ub - P.u;
    const lapH = (4 * P.gap) / (HS * HS);
    P.a = state.heat ? D() * lapH : state.c * state.c * lapH;
  }
  const lensPeak = () => Math.max(Math.abs(P.u), ...P.nb.map(Math.abs));
  function recordProbe() {
    pu.push(P.u);
    pg.push(P.gap);
    if (pu.length > LSPAN) { pu.shift(); pg.shift(); }
  }
  type Verdict = 'calm' | 'none' | 'down' | 'up';
  function verdict(): Verdict {
    const spread = Math.max(...P.nb.map((v) => Math.abs(v - P.u)));
    if (Math.max(Math.abs(P.u), spread) < 1e-3) return 'calm';
    if (Math.abs(P.gap) < Math.max(0.08 * spread, 0.004 * zScale)) return 'none';
    return P.gap < 0 ? 'down' : 'up';
  }
  const VERDICT_WAVE = { calm: 'at rest', none: 'no net pull', down: 'pulled down', up: 'pulled up' };
  const VERDICT_HEAT = { calm: 'at rest', none: 'not moving', down: 'sliding down', up: 'sliding up' };

  /** Stems and beads on the 3D skin: the probe and the four points it listens to. */
  function drawProbe3D() {
    const pal = light ? PAL.light : PAL.dark;
    const at = (i: number, j: number, v: number): Vec => ({ x: px(i), y: v * A, z: px(j) });
    const pts = [
      [probe.i + S, probe.j, P.nb[0]], [probe.i - S, probe.j, P.nb[1]],
      [probe.i, probe.j - S, P.nb[2]], [probe.i, probe.j + S, P.nb[3]],
    ];
    const c = cam.project(at(probe.i, probe.j, P.u));
    probeScreen = { sx: c.sx, sy: c.sy };
    // a faint leader to the lens, so the two read as one thing
    ctx.strokeStyle = `rgba(${ink},0.16)`;
    ctx.setLineDash([2, 4]);
    ctx.beginPath();
    ctx.moveTo(c.sx, c.sy);
    ctx.lineTo(LP.x, LP.y + 26);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.lineWidth = 1.4;
    for (const [i, j, v] of pts) {
      const b = cam.project(at(i, j, 0)), t = cam.project(at(i, j, v));
      ctx.strokeStyle = `rgba(${ink},0.55)`;
      ctx.beginPath();
      ctx.moveTo(b.sx, b.sy);
      ctx.lineTo(t.sx, t.sy);
      ctx.stroke();
      ctx.fillStyle = `rgba(${ink},0.9)`;
      ctx.beginPath();
      ctx.arc(t.sx, t.sy, 2.6, 0, 2 * Math.PI);
      ctx.fill();
    }
    const b = cam.project(at(probe.i, probe.j, 0));
    ctx.strokeStyle = pal.u;
    ctx.lineWidth = 1.8;
    ctx.beginPath();
    ctx.moveTo(b.sx, b.sy);
    ctx.lineTo(c.sx, c.sy);
    ctx.stroke();
    ctx.globalAlpha = 0.35;
    ctx.lineWidth = 1.2;
    ctx.beginPath();
    ctx.arc(c.sx, c.sy, 11, 0, 2 * Math.PI);
    ctx.stroke();
    ctx.globalAlpha = 1;
    ctx.fillStyle = pal.u;
    ctx.strokeStyle = light ? 'rgba(255,255,255,0.9)' : 'rgba(10,12,18,0.9)';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.arc(c.sx, c.sy, 4.8, 0, 2 * Math.PI);
    ctx.fill();
    ctx.stroke();
    ctx.lineWidth = 1;
  }

  function arrow(x: number, y0: number, y1: number, colour: string, width: number) {
    const len = y1 - y0, dir = Math.sign(len);
    if (Math.abs(len) < 2) return;
    const head = Math.min(8, Math.abs(len) * 0.6);
    ctx.strokeStyle = colour;
    ctx.fillStyle = colour;
    ctx.lineWidth = width;
    ctx.beginPath();
    ctx.moveTo(x, y0);
    ctx.lineTo(x, y1 - dir * head * 0.8);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(x, y1);
    ctx.lineTo(x - head * 0.6, y1 - dir * head);
    ctx.lineTo(x + head * 0.6, y1 - dir * head);
    ctx.closePath();
    ctx.fill();
    ctx.lineWidth = 1;
  }

  /**
   * The lens: the five-point neighbourhood seen from the side, magnified about
   * the probe so the small height differences, the only thing the rule reads,
   * fill the panel. Under it, the probe's recent history.
   */
  const LP = { x: W - 256, y: 12, w: 244, h: 348 };
  function drawLens() {
    const pal = light ? PAL.light : PAL.dark;
    const { x, y, w } = LP;
    const spread = Math.max(...P.nb.map((v) => Math.abs(v - P.u)));
    dScale = Math.max(0.004, 1.1 * spread, dScale * 0.97);
    zScale = Math.max(0.05, 1.15 * lensPeak(), zScale * 0.985);
    ctx.fillStyle = light ? 'rgba(255,255,255,0.9)' : 'rgba(17,19,27,0.86)';
    ctx.strokeStyle = `rgba(${ink},0.14)`;
    ctx.beginPath();
    ctx.roundRect(x, y, w, LP.h, 10);
    ctx.fill();
    ctx.stroke();
    label('THE PROBE AND ITS 4 NEIGHBOURS', x + 14, y + 22, 0.5, 'left', 9.5);
    const v = verdict();
    const words = (state.heat ? VERDICT_HEAT : VERDICT_WAVE)[v];
    const glyph = v === 'down' ? '↓ ' : v === 'up' ? '↑ ' : '';
    ctx.fillStyle = v === 'down' || v === 'up' ? pal.a : `rgba(${ink},0.62)`;
    ctx.font = '600 14px ui-sans-serif, system-ui, sans-serif';
    ctx.fillText(glyph + words, x + 14, y + 44);
    label(state.heat ? 'arrow = velocity, v = D∇²u' : 'arrow = acceleration, a = c²∇²u', x + 14, y + 62, 0.5, 'left', 10);

    // side view, north–south receding so all four neighbours show
    const box = { t: y + 70, b: y + 262 };
    const cx = x + 132, base = y + 168, dx = 66, zx = 30, zy = 16;
    const G = 60 / dScale;
    const at = [
      { x: cx + dx, y: base, n: 'E' }, { x: cx - dx, y: base, n: 'W' },
      { x: cx + zx, y: base - zy, n: 'N' }, { x: cx - zx, y: base + zy, n: 'S' },
    ];
    const lift = (q: { x: number; y: number }, d: number) => ({ x: q.x, y: q.y - d * G }); // d: height above the probe
    const restDy = P.u * G; // rest sits this far below the probe's level
    ctx.save();
    ctx.beginPath();
    ctx.rect(x + 1, box.t, w - 2, box.b - box.t);
    ctx.clip();
    // rest level, wherever it falls
    const restY = base + restDy;
    ctx.strokeStyle = `rgba(${ink},0.24)`;
    ctx.setLineDash([3, 4]);
    ctx.beginPath();
    ctx.moveTo(at[1].x - 10, restY); ctx.lineTo(at[0].x + 10, restY);
    ctx.moveTo(at[3].x - 6, restY + zy + 3); ctx.lineTo(at[2].x + 6, restY - zy - 3);
    ctx.stroke();
    ctx.setLineDash([]);
    const gapMid = (base + base - P.gap * G) / 2, gapShown = Math.abs(P.gap * G) > 4;
    if (restY > box.t + 8 && restY < box.b - 4 && !(gapShown && Math.abs(restY - gapMid) < 14))
      label('rest', x + 14, restY + 4, 0.45, 'left', 10);
    // stems from rest up to each point
    const T = at.map((q, n) => lift(q, P.nb[n] - P.u));
    const C = { x: cx, y: base };
    ctx.lineWidth = 1.2;
    for (const n of [2, 1, 0, 3]) {
      ctx.strokeStyle = `rgba(${ink},0.32)`;
      ctx.beginPath(); ctx.moveTo(at[n].x, at[n].y + restDy); ctx.lineTo(T[n].x, T[n].y); ctx.stroke();
    }
    ctx.strokeStyle = pal.u;
    ctx.globalAlpha = 0.6;
    ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(cx, restY); ctx.lineTo(cx, base); ctx.stroke();
    ctx.globalAlpha = 1;
    // the skin through the five points
    ctx.strokeStyle = `rgba(${ink},0.4)`;
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(T[1].x, T[1].y); ctx.lineTo(C.x, C.y); ctx.lineTo(T[0].x, T[0].y);
    ctx.moveTo(T[3].x, T[3].y); ctx.lineTo(C.x, C.y); ctx.lineTo(T[2].x, T[2].y);
    ctx.stroke();
    // the average of the four: one level through all their stems
    const UB = at.map((q) => lift(q, P.gap));
    ctx.fillStyle = light ? 'rgba(2,132,199,0.08)' : 'rgba(56,189,248,0.09)';
    ctx.strokeStyle = pal.ub;
    ctx.setLineDash([4, 3]);
    ctx.lineWidth = 1.4;
    ctx.beginPath();
    ctx.moveTo(UB[0].x, UB[0].y); ctx.lineTo(UB[2].x, UB[2].y); ctx.lineTo(UB[1].x, UB[1].y); ctx.lineTo(UB[3].x, UB[3].y);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
    ctx.setLineDash([]);
    const ubY = base - P.gap * G;
    ctx.beginPath(); ctx.moveTo(cx - 10, ubY); ctx.lineTo(cx + 10, ubY); ctx.stroke();
    ctx.fillStyle = pal.ub;
    ctx.font = 'italic 600 14px ui-serif, Georgia, serif';
    ctx.fillText('ū', UB[0].x + 9, UB[0].y + 5);
    // neighbour beads, back to front
    for (const n of [2, 1, 0, 3]) {
      ctx.fillStyle = `rgba(${ink},0.92)`;
      ctx.beginPath(); ctx.arc(T[n].x, T[n].y, 4.2, 0, 2 * Math.PI); ctx.fill();
      label(at[n].n, T[n].x + (n === 1 ? -8 : 8), T[n].y + (n === 2 ? -6 : n === 3 ? 14 : 4), 0.45, n === 1 ? 'right' : 'left', 10);
    }
    // the gap ū − u: a bracket left of the point
    const gx = x + 48;
    if (Math.abs(ubY - C.y) > 4) {
      ctx.strokeStyle = `rgba(${ink},0.3)`;
      ctx.setLineDash([1.5, 3]);
      ctx.beginPath(); ctx.moveTo(gx + 4, C.y); ctx.lineTo(cx - 8, C.y); ctx.stroke();
      ctx.setLineDash([]);
      ctx.strokeStyle = `rgba(${ink},0.6)`;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(gx - 3, C.y); ctx.lineTo(gx + 3, C.y);
      ctx.moveTo(gx, C.y); ctx.lineTo(gx, ubY);
      ctx.moveTo(gx - 3, ubY); ctx.lineTo(gx + 3, ubY);
      ctx.stroke();
      ctx.fillStyle = `rgba(${ink},0.7)`;
      ctx.font = 'italic 12px ui-serif, Georgia, serif';
      ctx.textAlign = 'right';
      ctx.fillText('ū − u', gx - 5, (C.y + ubY) / 2 + 4);
      ctx.textAlign = 'left';
    }
    // the point itself
    ctx.fillStyle = pal.u;
    ctx.strokeStyle = light ? 'rgba(255,255,255,0.95)' : 'rgba(10,12,18,0.95)';
    ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.arc(C.x, C.y, 6.5, 0, 2 * Math.PI); ctx.fill(); ctx.stroke();
    ctx.font = 'italic 600 14px ui-serif, Georgia, serif';
    ctx.fillText('u', C.x - 4, C.y + (ubY > C.y + 4 ? -11 : 21));
    // what the gap does: an acceleration (waves) or a velocity (heat)
    const L = Math.max(-84, Math.min(84, 3 * (ubY - C.y)));
    const ax = cx + 17;
    arrow(ax, C.y, C.y + L, pal.a, 2.8);
    if (Math.abs(L) >= 10) {
      ctx.fillStyle = pal.a;
      ctx.font = 'italic 600 14px ui-serif, Georgia, serif';
      ctx.fillText(state.heat ? 'v' : 'a', ax + 8, C.y + L * 0.6 + 5);
    }
    ctx.restore();
    if (restY <= box.t + 2 || restY >= box.b - 2)
      label(restY < box.t ? 'rest ↑' : 'rest ↓', x + w - 12, restY < box.t ? box.t + 12 : box.b - 6, 0.45, 'right', 10);
    label('gaps magnified', x + w - 12, y + 44, 0.35, 'right', 9.5);

    // history: height and pull at the probe over the last few seconds
    const sx0 = x + 30, sw = w - 44, sy = y + 314, sh = 22;
    ctx.strokeStyle = `rgba(${ink},0.12)`;
    ctx.beginPath(); ctx.moveTo(x + 12, y + 270.5); ctx.lineTo(x + w - 12, y + 270.5); ctx.stroke();
    ctx.strokeStyle = `rgba(${ink},0.2)`;
    ctx.beginPath(); ctx.moveTo(sx0, sy + 0.5); ctx.lineTo(sx0 + sw, sy + 0.5); ctx.stroke();
    ctx.font = 'italic 600 13px ui-serif, Georgia, serif';
    ctx.fillStyle = pal.u;
    ctx.fillText('u', x + 14, sy - 6);
    ctx.fillStyle = pal.a;
    ctx.fillText(state.heat ? 'v' : 'a', x + 14, sy + 16);
    label('AT THE PROBE, OVER TIME', x + 14, y + 286, 0.42, 'left', 9.5);
    const n = pu.length;
    if (n > 1) {
      const xs = (q: number) => sx0 + sw - ((n - 1 - q) / (LSPAN - 1)) * sw;
      let gMax = 1e-4;
      for (const g of pg) gMax = Math.max(gMax, Math.abs(g));
      const line = (arr: number[], scale: number, colour: string) => {
        ctx.strokeStyle = colour;
        ctx.lineWidth = 1.6;
        ctx.beginPath();
        for (let q = 0; q < n; q++) {
          const yy = sy - Math.max(-1.1, Math.min(1.1, arr[q] / scale)) * sh;
          q ? ctx.lineTo(xs(q), yy) : ctx.moveTo(xs(q), yy);
        }
        ctx.stroke();
      };
      line(pg, gMax, pal.a);
      line(pu, zScale, pal.u);
      ctx.lineWidth = 1;
    }
  }

  const trace: { k: number; v: number }[] = [];
  const marks: { f: number; text: string }[] = [];
  let frameNo = 0;
  const SPAN = 600;
  function mark(text: string) {
    marks.push({ f: frameNo, text });
    if (marks.length > 12) marks.shift();
  }
  function label(text: string, x: number, y: number, alpha = 0.55, align: CanvasTextAlign = 'left', size = 11) {
    ctx.fillStyle = `rgba(${ink},${alpha})`;
    ctx.font = `${size}px ui-monospace, monospace`;
    ctx.textAlign = align;
    ctx.fillText(text, x, y);
    ctx.textAlign = 'left';
  }
  function drawStrip() {
    const top = TR.y, bot = TR.y + TR.h;
    ctx.strokeStyle = `rgba(${ink},0.1)`;
    ctx.beginPath();
    ctx.moveTo(14, VH + 6.5);
    ctx.lineTo(W - 14, VH + 6.5);
    ctx.stroke();
    label(state.heat ? 'energy over time (all potential while diffusing)' : 'energy over time', TR.x, top - 10, 0.55);
    let mx = state.eRef;
    for (const p of trace) mx = Math.max(mx, p.k + p.v);
    mx = mx * 1.12 || 1;
    const x0 = frameNo - SPAN;
    const xAt = (f: number) => TR.x + ((f - x0) / SPAN) * TR.w;
    const yAt = (e: number) => bot - (e / mx) * TR.h;
    ctx.strokeStyle = `rgba(${ink},0.18)`;
    ctx.beginPath();
    ctx.moveTo(TR.x, bot + 0.5);
    ctx.lineTo(TR.x + TR.w, bot + 0.5);
    ctx.stroke();
    const yr = Math.round(yAt(state.eRef)) + 0.5;
    ctx.setLineDash([4, 4]);
    ctx.strokeStyle = `rgba(${ink},0.25)`;
    ctx.beginPath();
    ctx.moveTo(TR.x, yr);
    ctx.lineTo(TR.x + TR.w, yr);
    ctx.stroke();
    ctx.setLineDash([]);
    label('put in', TR.x - 8, yr + 4, 0.45, 'right', 10);
    label('0', TR.x - 8, bot + 4, 0.35, 'right', 10);
    if (trace.length > 1) {
      const start = frameNo - trace.length + 1;
      const band = (lo: (p: { k: number; v: number }) => number, hi: (p: { k: number; v: number }) => number, colour: string) => {
        ctx.beginPath();
        for (let i = 0; i < trace.length; i++) {
          const x = xAt(start + i), y = yAt(hi(trace[i]));
          i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
        }
        for (let i = trace.length - 1; i >= 0; i--) ctx.lineTo(xAt(start + i), yAt(lo(trace[i])));
        ctx.closePath();
        ctx.fillStyle = colour;
        ctx.fill();
      };
      band(() => 0, (p) => p.v, light ? 'rgba(192,132,252,0.45)' : 'rgba(192,132,252,0.42)');
      band((p) => p.v, (p) => p.v + p.k, light ? 'rgba(124,140,255,0.5)' : 'rgba(124,140,255,0.5)');
      ctx.strokeStyle = `rgba(${ink},0.85)`;
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      for (let i = 0; i < trace.length; i++) {
        const x = xAt(start + i), y = yAt(trace[i].k + trace[i].v);
        i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
      }
      ctx.stroke();
      ctx.lineWidth = 1;
    }
    let lastX = -1e9;
    for (const m of marks) {
      if (m.f < x0) continue;
      const x = Math.round(xAt(m.f)) + 0.5;
      const room = x - lastX > 64;
      if (room) lastX = x;
      ctx.strokeStyle = `rgba(${ink},0.3)`;
      ctx.beginPath();
      ctx.moveTo(x, top);
      ctx.lineTo(x, bot);
      ctx.stroke();
      const right = x > TR.x + TR.w - 80;
      if (room) label(m.text, right ? x - 4 : x + 4, top + 8, 0.5, right ? 'right' : 'left', 10);
    }
    // the split right now, at the end of the strip
    const e = eTot() || 1;
    label(`kinetic ${((100 * eK) / e).toFixed(0)}%`, TR.x + TR.w, top - 10, 0.9, 'right');
    ctx.fillStyle = KE;
    ctx.fillRect(TR.x + TR.w - ctx.measureText(`kinetic ${((100 * eK) / e).toFixed(0)}%`).width - 14, top - 18, 8, 8);
    const pv = `potential ${((100 * eV) / e).toFixed(0)}%`;
    const kw = ctx.measureText(`kinetic ${((100 * eK) / e).toFixed(0)}%`).width + 30;
    label(pv, TR.x + TR.w - kw, top - 10, 0.9, 'right');
    ctx.fillStyle = PE;
    ctx.fillRect(TR.x + TR.w - kw - ctx.measureText(pv).width - 14, top - 18, 8, 8);
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    ctx.save();
    ctx.beginPath();
    ctx.rect(0, 0, W, VH);
    ctx.clip();
    drawBackdrop(ctx, W, VH, light);
    upload();
    if (G) renderGl(G);
    else renderFlat();
    drawOverlay();
    readProbe();
    if (G) drawProbe3D();
    ctx.restore();
    drawLens();
    drawStrip();
  }

  // --- readouts -------------------------------------------------------------
  const setEq = equation();
  const setResult = result();
  const setRows = readout();
  const pct = (x: number) => `${(100 * x).toFixed(1)}%`;
  const num = (v: number, d = 3) => (Math.abs(v) < 0.5 * 10 ** -d ? 0 : v).toFixed(d);
  const big = (v: number) => num(v, Math.abs(v) >= 100 ? 0 : Math.abs(v) >= 10 ? 1 : 2);
  function note(v: Verdict) {
    if (v === 'calm') return 'Everything is at rest, so every point already sits at its neighbours’ average. Click the skin to drop a pulse.';
    if (state.heat) {
      if (v === 'none') return 'Diffusing, and the neighbours’ average matches the probe, so it stays put. With no momentum, nothing can carry it past.';
      return `Diffusing: the gap sets the probe’s velocity, not its acceleration. It slides ${v} toward its neighbours’ average and stops when it gets there, so it never overshoots and nothing travels.`;
    }
    if (v === 'none') return 'Opposite neighbours cancel: their average matches the probe, so it feels no pull, tilted or not. Only curvature makes a force.';
    return `Its neighbours sit ${v === 'down' ? 'lower' : 'higher'} on average, so the probe is pulled ${v}, harder the bigger the gap. It keeps the speed it gains and overshoots their level: that momentum is what makes waves travel.`;
  }
  function updateText() {
    const e = eTot(), left = e / (state.eRef || 1);
    const ek = e ? eK / e : 0, ev = e ? eV / e : 0;
    const v = verdict();
    const gapTex = ['\\nabla^2 u \\approx \\dfrac{4\\,(', ['\\bar u', UB_EQ], '-', ['u', U_EQ], ')}{h^2}'] as Part[];
    const live: Part[] = [['\\bar u', UB_EQ], '-', ['u', U_EQ], `= ${num(P.gap)}`, '\\;\\Rightarrow\\;'];
    if (state.heat) {
      setEq({
        rule: [['\\dfrac{\\partial u}{\\partial t}', A_EQ], '=', 'D\\,\\nabla^2 u', state.gamma > 0 ? '-\\,\\gamma u' : '', '\\qquad', ...gapTex],
        live: [...live, [`v = ${big(P.a)}`, A_EQ], `\\quad D = ${D().toFixed(4)},\\; h = ${HS.toFixed(2)}`],
      });
    } else {
      setEq({
        rule: [['\\dfrac{\\partial^2 u}{\\partial t^2}', A_EQ], '=', 'c^2\\,\\nabla^2 u', state.gamma > 0 ? '-\\,\\gamma\\dfrac{\\partial u}{\\partial t}' : '', '\\qquad', ...gapTex],
        live: [...live, [`a = ${big(P.a)}`, A_EQ], `\\quad c = ${state.c.toFixed(2)},\\; h = ${HS.toFixed(2)}`],
      });
    }
    const words = (state.heat ? VERDICT_HEAT : VERDICT_WAVE)[v];
    setResult({
      value: v === 'calm' ? 'calm' : num(P.gap).replace('-', '−'),
      colour: v === 'down' || v === 'up' ? A_EQ : undefined,
      status: v === 'calm' ? 'nothing to pull'
        : state.heat ? `velocity v = D∇²u = ${big(P.a).replace('-', '−')} /s · ${words}`
        : `acceleration a = c²∇²u = ${big(P.a).replace('-', '−')} · ${words}`,
      note: note(v),
    });
    setRows({
      'r-u': num(P.u),
      'r-ub': num(P.ub),
      'r-a': state.heat ? `v = ${big(P.a)} /s` : big(P.a),
      'r-e': e < 1e-10 ? '0' : pct(left),
      'r-k': state.heat ? 'none (no momentum)' : pct(ek),
      'r-v': pct(ev),
      'r-t': `${state.t.toFixed(2)} s`,
      'r-grid': `${N} × ${N}, ${Math.round(stepsPerSec())} steps / s; probe looks ${S} cells out`,
    });
  }

  // --- loop -----------------------------------------------------------------
  let last = performance.now(), rainAt = 0, slowAvg = 16;
  function advance(n: number) {
    for (let q = 0; q < n; q++) step();
  }
  function frame(now: number) {
    const dt = Math.min(0.05, (now - last) / 1000);
    last = now;
    if (state.running) {
      state.acc += dt * stepsPerSec();
      const n = Math.min(12, Math.floor(state.acc));
      state.acc -= n;
      if (state.acc > 2) state.acc = 0;
      advance(n);
      if (state.rain && now > rainAt) {
        rainAt = now + 650 + Math.random() * 600;
        const a = Math.random() * 2 * Math.PI, r = Math.sqrt(Math.random()) * 0.7;
        bump(r * Math.cos(a), r * Math.sin(a), 0.35 + Math.random() * 0.3, 0.05);
      }
      energy();
      if (finger || state.rain) state.eRef = Math.max(state.eRef, eTot());
      frameNo++;
      trace.push({ k: eK, v: eV });
      if (trace.length > SPAN) trace.shift();
      readProbe();
      recordProbe();
    } else energy();
    const t0 = performance.now();
    draw();
    updateText();
    // SwiftShader and slow GPUs: render the 3D view at a lower resolution
    slowAvg = slowAvg * 0.9 + (performance.now() - t0) * 0.1;
    if (slowAvg > 34 && glScale > 0.55) { glScale = Math.max(0.55, glScale - 0.15); slowAvg = 20; }
    else if (slowAvg < 10 && glScale < 1) { glScale = Math.min(1, glScale + 0.15); slowAvg = 20; }
    requestAnimationFrame(frame);
  }

  // --- pointer --------------------------------------------------------------
  function hit(x: number, y: number) {
    if (y > VH) return null;
    const p = cam.hitPlane(x, y, { x: 0, y: 0, z: 0 }, { x: 0, y: 1, z: 0 });
    if (!p) return null;
    const d = state.shape === 'round' ? Math.hypot(p.x, p.z) : Math.max(Math.abs(p.x), Math.abs(p.z));
    return d < 0.97 ? p : null;
  }
  let downAt: { x: number; y: number } | null = null;
  let probeDrag = false;
  const inLens = (x: number, y: number) => x >= LP.x && x <= LP.x + LP.w && y >= LP.y && y <= LP.y + LP.h;
  const nearProbe = (x: number, y: number) => !!G && Math.hypot(x - probeScreen.sx, y - probeScreen.sy) < 16;
  function moveProbe(x: number, y: number) {
    const p = hit(x, y);
    if (!p) return;
    setProbe(p.x, p.z);
    if (!state.running) { draw(); updateText(); }
  }
  orbitControls(canvas, cam, W, H, {
    changed: () => { if (!state.running) draw(); },
    grab: (x, y) => {
      if (inLens(x, y)) return true; // the lens is not the skin: swallow the press
      if (nearProbe(x, y) || (state.tap === 'probe' && hit(x, y))) {
        probeDrag = true;
        canvas.style.cursor = 'grabbing';
        if (!nearProbe(x, y)) moveProbe(x, y);
        return true;
      }
      const p = hit(x, y);
      if (!p) return false;
      downAt = { x, y };
      drop(p.x, p.z, state.heat ? 1 : 0.9);
      if (!state.running) { energy(); draw(); updateText(); }
      return true;
    },
    drag: (x, y) => {
      if (probeDrag) return moveProbe(x, y);
      if (!downAt || Math.hypot(x - downAt.x, y - downAt.y) < 6) return;
      const p = hit(x, y);
      if (!finger && p) mark('finger');
      finger = p ? { x: p.x, z: p.z } : null;
    },
    release: () => { finger = null; downAt = null; probeDrag = false; canvas.style.cursor = ''; },
  });
  canvas.addEventListener('pointermove', (e) => {
    if (e.buttons) return;
    const r = canvas.getBoundingClientRect();
    const x = ((e.clientX - r.left) / r.width) * W, y = ((e.clientY - r.top) / r.height) * H;
    canvas.style.cursor = nearProbe(x, y) ? 'grab' : inLens(x, y) ? 'default' : '';
  });

  // --- controls -------------------------------------------------------------
  const tp = transport({
    onRun: (on) => { state.running = on; },
    onStep: () => {
      state.running = false;
      tp.setRunning(false);
      advance(Math.max(1, Math.round(stepsPerSec() / 30)));
      energy();
      frameNo++;
      trace.push({ k: eK, v: eV });
      readProbe();
      recordProbe();
      draw();
      updateText();
    },
    onReset: () => start(),
  });
  function start() {
    calm();
    drop(-0.28, -0.18);
  }
  el('drop').addEventListener('click', () => {
    const a = Math.random() * 2 * Math.PI, r = 0.15 + Math.random() * 0.45;
    drop(r * Math.cos(a), r * Math.sin(a));
  });
  el('two').addEventListener('click', twoPulses);
  el('calm').addEventListener('click', calm);
  function twoPulses() {
    bump(-0.42, -0.12, 0.9);
    bump(0.42, 0.12, 0.9);
    injected();
    mark('two drops');
  }

  const tapSeg = segmented('tap', (v) => {
    state.tap = v;
    if (!state.running) draw();
  });
  const shapeSeg = segmented('shape', (v) => {
    state.shape = v;
    buildGrid();
    buildShell();
    setProbe(px(probe.i), px(probe.j));
    start();
  });
  const edgeSeg = segmented('edge', (v) => {
    state.edge = v;
    buildGrid();
    injected();
  });
  const setSpeed = slider('speed', (v) => { state.c = v / 100; }, (v) => `c = ${(v / 100).toFixed(2)}`);
  const setDamp = slider('damp', (v) => { state.gamma = v / 50; }, (v) => (v ? `${(v / 50).toFixed(2)} /s` : '0 /s'));

  const legUp = el('leg-up'), legDown = el('leg-down'), legA = el('leg-a');
  const setHeat = check('heat', (on) => setDiffuse(on));
  function setDiffuse(on: boolean) {
    state.heat = on;
    legA.textContent = on ? 'velocity v' : 'acceleration a';
    uo.set(u); // whatever was moving stops: diffusion has no momentum
    fronts.length = 0;
    injected();
    mark(on ? 'diffuse' : 'wave');
  }
  const setPull = check('pull', (on) => setPullColour(on));
  function setPullColour(on: boolean) {
    state.pull = on;
    legUp.textContent = on ? 'pulled up (∇²u > 0)' : 'above rest';
    legDown.textContent = on ? 'pulled down (∇²u < 0)' : 'below rest';
    if (!state.running) draw();
  }
  const setRain = check('rain', (on) => { state.rain = on; });

  /** Put every control back to a known state before a Try sets its own. */
  function scene(o: { shape?: string; edge?: string; heat?: boolean; c?: number; probe: [number, number] }) {
    state.shape = o.shape ?? 'square';
    shapeSeg.select(state.shape);
    state.edge = o.edge ?? 'fixed';
    edgeSeg.select(state.edge);
    buildGrid();
    buildShell();
    state.heat = !!o.heat; setHeat(state.heat);
    legA.textContent = state.heat ? 'velocity v' : 'acceleration a';
    setPull(false); setPullColour(false);
    state.rain = false; setRain(false);
    state.gamma = 0; setDamp(0);
    state.c = o.c ?? 0.5; setSpeed(state.c * 100);
    state.tap = 'pulse'; tapSeg.select('pulse');
    calm();
    setProbe(...o.probe);
    state.running = true;
    tp.setRunning(true);
  }
  tries({
    ring: () => { scene({ edge: 'open', c: 0.3, probe: [0.4, 0.12] }); drop(0, 0); },
    slope: () => {
      // a wide bump, held still: its flank at r = σ is steep but has no curvature
      scene({ probe: [0.3, 0] });
      bump(0, 0, 0.8, 0.3);
      fronts.length = 0;
      injected();
      mark('wide bump');
      state.running = false;
      tp.setRunning(false);
    },
    heat: () => {
      scene({ heat: true, probe: [0, 0] });
      bump(0, 0, 1);
      injected();
      mark('bump');
    },
    two: () => { scene({ edge: 'open', c: 0.4, probe: [0, 0] }); twoPulses(); },
  });

  buildGrid();
  buildShell();
  setProbe(0.3, 0.24);
  start();
  requestAnimationFrame(frame);
