---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Checks from '../../../components/sim/Checks.astro';
import Transport from '../../../components/sim/Transport.astro';
import Readout from '../../../components/sim/Readout.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Try from '../../../components/sim/Try.astro';

const CLOUD = '#a78bfa', HIT = '#fbbf24', PLUS = '#f472b6', MINUS = '#22d3ee';
---

<SimLayout
  areaSlug="physics"
  title="Atomic Orbitals"
  description="The exact hydrogen orbitals ψnlm drawn as glowing clouds of probability, with their spherical shells and nodal planes, the phase winding of m and the signed lobes of chemistry. Measure the electron and it turns up at one point; measure hundreds of atoms and the dots draw the orbital. Superpose two states and the cloud starts to slosh: the origin of emitted light."
  shortcuts={['run', 'reset', 'fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="ao"
          class="ao-canvas"
          width="820"
          height="720"
          role="img"
          aria-label="A hydrogen orbital drawn in three dimensions as a glowing fog coloured by the phase of the wavefunction, with an optional shaded slice through it. Measurements appear as dots."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'probability density |ψ|²', color: CLOUD },
          { label: 'phase arg ψ (hue)', color: MINUS, id: 'lg-phase' },
          { label: 'ψ &gt; 0', color: PLUS, id: 'lg-plus' },
          { label: 'ψ &lt; 0', color: MINUS, id: 'lg-minus' },
          { label: 'measured position', color: HIT },
        ]}
        hint="Click empty space to measure · drag to orbit · scroll to zoom"
      />
      <Result label="Energy" />
    </div>

    <div class="sim-panel">
      <Seg
        id="mode"
        label="State"
        attr="s"
        options={[
          { value: 'orb', label: 'Orbital' },
          { value: 'sup', label: 'Superposition' },
        ]}
      />
      <div id="orb-wrap">
        <Seg
          id="preset"
          label="Preset"
          attr="p"
          active="3dz2"
          options={[
            { value: '1s', label: '1s' },
            { value: '2s', label: '2s' },
            { value: '2pz', label: '2p<sub>z</sub>' },
            { value: '3s', label: '3s' },
            { value: '3dz2', label: '3d<sub>z²</sub>' },
            { value: '3dxy', label: '3d<sub>xy</sub>' },
            { value: '4fxyz', label: '4f<sub>xyz</sub>' },
          ]}
        />
        <Slider id="n" label="Shell n" min={1} max={5} step={1} value={3} display="3" />
        <Slider id="l" label="Angular momentum l" min={0} max={2} step={1} value={2} display="2 (d)" />
        <Slider id="m" label="Magnetic number m" min={-2} max={2} step={1} value={0} display="0" />
        <Checks items={[{ id: 'real', label: 'Real orbitals (p<sub>x</sub>, d<sub>xy</sub>, …): sign as colour' }]} />
      </div>
      <div id="sup-wrap" hidden>
        <Seg
          id="sup"
          label="Mix"
          attr="m"
          options={[
            { value: 's-pz', label: '1s + 2p<sub>z</sub>' },
            { value: 's-p1', label: '1s + 2p<sub>+1</sub>' },
            { value: 'pz-dz2', label: '2p<sub>z</sub> + 3d<sub>z²</sub>' },
            { value: '2s-pz', label: '2s + 2p<sub>z</sub>' },
          ]}
        />
      </div>
      <Transport running>
        <button type="button" class="btn ghost" id="measure">Measure</button>
        <button type="button" class="btn ghost" id="measure200">Measure 200</button>
      </Transport>
      <Seg
        id="show"
        label="Show"
        active="cloud"
        options={[
          { value: 'both', label: 'Cloud + plane' },
          { value: 'plane', label: 'Plane' },
          { value: 'cloud', label: 'Cloud' },
        ]}
      />
      <div id="plane-wrap" hidden>
        <Seg
          id="plane"
          label="Plane"
          options={[
            { value: 'xz', label: 'XZ' },
            { value: 'xy', label: 'XY' },
            { value: 'yz', label: 'YZ' },
          ]}
        />
        <Slider id="offset" label="Plane offset" min={-0.9} max={0.9} step={0.01} value={0} display="0.0 a₀" />
      </div>
      <div id="cut-wrap">
        <Checks items={[{ id: 'cut', label: 'Cut away the quarter facing you' }]} />
      </div>
      <div id="density-wrap">
        <Slider id="density" label="Cloud opacity" min={0.2} max={4} step={0.05} value={1.2} display="1.20" hint={['thin', 'dense']} />
      </div>
      <Readout
        title="Values"
        rows={[
          { id: 'r-E', label: 'energy E<sub>n</sub>' },
          { id: 'r-rmean', label: '⟨r⟩ = (3n² − l(l+1))/2' },
          { id: 'r-rgrid', label: '⟨r⟩ on the grid' },
          { id: 'r-rmp', label: 'most probable r' },
          { id: 'r-nodes', label: 'nodes: radial / angular' },
          { id: 'r-norm', label: '∑|ψ|²ΔV on the grid' },
          { id: 'r-dip', label: '⟨z⟩ (dipole)' },
          { id: 'r-box', label: 'box half-width' },
          { id: 'r-t', label: 'time t' },
          { id: 'r-count', label: 'measurements' },
          { id: 'r-avg', label: 'mean measured r' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Cut a quarter out of <b>3s</b> and two dark spherical shells split the cloud:
      the <b>radial nodes</b>, n − l − 1 = 2 of them. Across each one ψ changes sign,
      so the colour flips. <Try id="shells" />
    </li>
    <li>
      With m = +1 the 2p cloud is a <b>doughnut</b> round the z axis and its hue turns
      once around it: that winding e<sup>iφ</sup> is the angular momentum.
      Tick <b>Real orbitals</b> and the same states become the p<sub>x</sub> and
      p<sub>y</sub> dumbbells, with a nodal plane between their two lobes. <Try id="winding" />
    </li>
    <li>
      Each measurement finds the electron at <b>one point</b>. Measure 200 atoms and
      the dots draw the orbital, and their mean distance from the nucleus closes in
      on ⟨r⟩. <Try id="born" />
    </li>
    <li>
      An orbital is <b>stationary</b>: |ψ|² never moves, only its phase turns. Mix
      1s with 2p<sub>z</sub> and the cloud sloshes up and down once every 0.41 fs,
      a charge oscillating at the frequency of the 10.2 eV light it emits
      (Lyman α, 122 nm). <Try id="slosh" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { el, segmented, slider, check, transport, readout, result, tries } from '../../../lib/panel';
  import {
    Camera3D, orbitControls, drawBox, drawBackdrop, line3, planePoint, PlaneShade, rgba32,
    type Vec, type PlaneAxis,
  } from '../../../lib/scene3d';
  import { VolumeView } from '../../../lib/volume3d';

  const canvas = el('ao') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const css = (v: string) => getComputedStyle(canvas).getPropertyValue(v).trim();
  const isLight = () => css('--stage-light') === '1';
  const ink = () => css('--stage-ink') || '232,233,236';

  const CLOUD = '#a78bfa';
  const TAU = Math.PI * 2;
  const EV = 27.211386; // eV per hartree
  const FS = 0.02418884; // fs per atomic unit of time
  const NM = 45.563353; // λ in nm = NM / ΔE in hartree

  // The box in world units runs from −HW to HW; one world unit is `s` bohr,
  // so the box always fills the view and the label says how big it is.
  // World y is up, and it is the physics z axis: physics (x, y, z) sits at world (x, z, −y).
  const HW = 6;
  const GN = 80;
  const N3 = GN * GN * GN;
  const CELL = (2 * HW) / GN;
  const cw = new Float64Array(GN).map((_, i) => -HW + (i + 0.5) * CELL);

  // --- hydrogen ------------------------------------------------------------------------

  const fact = (k: number) => { let f = 1; for (let i = 2; i <= k; i++) f *= i; return f; };

  /** Generalised Laguerre L_k^a(x) by the three-term recurrence. */
  function laguerre(k: number, a: number, x: number) {
    if (k === 0) return 1;
    let p0 = 1, p1 = 1 + a - x;
    for (let j = 1; j < k; j++) {
      const p2 = ((2 * j + 1 + a - x) * p1 - (j + a) * p0) / (j + 1);
      p0 = p1;
      p1 = p2;
    }
    return p1;
  }

  /** The radial function R_nl(r), atomic units, ∫ R² r² dr = 1. */
  function radial(n: number, l: number, r: number) {
    const rho = (2 * r) / n;
    const N = Math.sqrt(Math.pow(2 / n, 3) * fact(n - l - 1) / (2 * n * fact(n + l)));
    return N * Math.exp(-rho / 2) * Math.pow(rho, l) * laguerre(n - l - 1, 2 * l + 1, rho);
  }

  /** P_l^m(x) / (1 − x²)^(m/2) for m ≥ 0, without the Condon–Shortley sign. */
  function legendreQ(l: number, am: number, x: number) {
    let pmm = 1;
    for (let i = 1; i <= am; i++) pmm *= 2 * i - 1;
    if (l === am) return pmm;
    let p0 = pmm, p1 = x * (2 * am + 1) * pmm;
    for (let ll = am + 2; ll <= l; ll++) {
      const p2 = ((2 * ll - 1) * x * p1 - (ll + am - 1) * p0) / (ll - am);
      p0 = p1;
      p1 = p2;
    }
    return p1;
  }

  // per (n, l): the radius holding 99.2 % of the probability, the most probable radius
  const R99: number[][] = [], RMP: number[][] = [];
  for (let n = 1; n <= 5; n++) {
    R99[n] = [];
    RMP[n] = [];
    for (let l = 0; l < n; l++) {
      let cum = 0, best = 0, rb = 0, r99 = 0;
      const dr = 0.005;
      for (let r = dr / 2; r < 140; r += dr) {
        const v = radial(n, l, r), p = v * v * r * r * dr;
        cum += p;
        if (p > best) { best = p; rb = r; }
        if (!r99 && cum > 0.992) r99 = r;
        if (r99 && r > rb + 1) break;
      }
      R99[n][l] = r99;
      RMP[n][l] = rb;
    }
  }
  const boxHalf = (n: number, l: number) => {
    const r = R99[n][l] * 0.92;
    return r < 8 ? Math.ceil(r * 2) / 2 : Math.ceil(r);
  };
  const energy = (n: number) => -0.5 / (n * n);

  type Orb = { n: number; l: number; m: number; real: boolean };

  // ψ at one point: a radial table lookup, the Legendre recurrence and ((x + iy)/r)^|m|
  const NT = 2048;
  type Prep = { T: Float64Array; step: number; N: number; l: number; am: number; kind: number; sign: number };
  function prepOrb(o: Orb, rMax: number): Prep {
    const T = new Float64Array(NT + 2), step = rMax / NT;
    for (let i = 0; i < NT + 2; i++) T[i] = radial(o.n, o.l, i * step);
    const am = Math.abs(o.m);
    const N = Math.sqrt(((2 * o.l + 1) / (4 * Math.PI)) * (fact(o.l - am) / fact(o.l + am)));
    // 0 complex m ≥ 0, 1 complex m < 0, 2 real cos mφ, 3 real sin |m|φ
    const kind = o.real && o.m !== 0 ? (o.m > 0 ? 2 : 3) : o.m >= 0 ? 0 : 1;
    return { T, step, N: kind >= 2 ? N * Math.SQRT2 : N, l: o.l, am, kind, sign: am % 2 ? -1 : 1 };
  }

  let oRe = 0, oIm = 0;
  function evalPsi(P: Prep, x: number, y: number, z: number) {
    const r = Math.sqrt(x * x + y * y + z * z);
    let u = r / P.step;
    if (u > NT) u = NT;
    const i = u | 0, f = u - i;
    const R = P.T[i] + (P.T[i + 1] - P.T[i]) * f;
    if (r < 1e-9) {
      oRe = P.l === 0 ? R * P.N : 0;
      oIm = 0;
      return;
    }
    const inv = 1 / r;
    const a = R * P.N * legendreQ(P.l, P.am, z * inv);
    let er = 1, ei = 0;
    const cr = x * inv, ci = y * inv;
    for (let k = 0; k < P.am; k++) {
      const t = er * cr - ei * ci;
      ei = er * ci + ei * cr;
      er = t;
    }
    switch (P.kind) {
      case 0: oRe = P.sign * a * er; oIm = P.sign * a * ei; break;
      case 1: oRe = a * er; oIm = -a * ei; break;
      case 2: oRe = a * er; oIm = 0; break;
      default: oRe = a * ei; oIm = 0;
    }
  }

  /** ψ on the GN³ grid of a box of half-width h bohr, as (re, im) pairs. */
  const cache = new Map<string, Float32Array>();
  function grid(o: Orb, h: number) {
    const key = `${o.n}|${o.l}|${o.m}|${o.real && o.m !== 0}|${h}`;
    const hit = cache.get(key);
    if (hit) return hit;
    const s = h / HW;
    const P = prepOrb(o, h * 1.75);
    const out = new Float32Array(N3 * 2);
    let q = 0;
    for (let k = 0; k < GN; k++) {
      const py = -cw[k] * s;
      for (let j = 0; j < GN; j++) {
        const pz = cw[j] * s;
        for (let i = 0; i < GN; i++) {
          evalPsi(P, cw[i] * s, py, pz);
          out[q++] = oRe;
          out[q++] = oIm;
        }
      }
    }
    if (cache.size > 6) cache.delete(cache.keys().next().value!);
    cache.set(key, out);
    return out;
  }

  // world radius of every voxel, for ⟨r⟩
  const RW = new Float32Array(N3);
  for (let k = 0, q = 0; k < GN; k++)
    for (let j = 0; j < GN; j++)
      for (let i = 0; i < GN; i++) RW[q++] = Math.hypot(cw[i], cw[j], cw[k]);

  // --- the state ------------------------------------------------------------------------

  type Mode = 'orb' | 'sup';
  type Show = 'both' | 'plane' | 'cloud';
  type PhysPlane = 'xz' | 'xy' | 'yz';

  const SUPS: Record<string, [Orb, Orb]> = {
    's-pz': [{ n: 1, l: 0, m: 0, real: false }, { n: 2, l: 1, m: 0, real: false }],
    's-p1': [{ n: 1, l: 0, m: 0, real: false }, { n: 2, l: 1, m: 1, real: false }],
    'pz-dz2': [{ n: 2, l: 1, m: 0, real: false }, { n: 3, l: 2, m: 0, real: false }],
    '2s-pz': [{ n: 2, l: 0, m: 0, real: false }, { n: 2, l: 1, m: 0, real: false }],
  };
  const PRESETS: Record<string, Orb> = {
    '1s': { n: 1, l: 0, m: 0, real: false },
    '2s': { n: 2, l: 0, m: 0, real: false },
    '2pz': { n: 2, l: 1, m: 0, real: false },
    '3s': { n: 3, l: 0, m: 0, real: false },
    '3dz2': { n: 3, l: 2, m: 0, real: false },
    '3dxy': { n: 3, l: 2, m: -2, real: true },
    '4fxyz': { n: 4, l: 3, m: -2, real: true },
  };

  const state = {
    mode: 'orb' as Mode,
    orb: { n: 3, l: 2, m: 0, real: false } as Orb,
    sup: 's-pz',
    show: 'cloud' as Show,
    plane: 'xz' as PhysPlane,
    offset: 0, // fraction of the box half-width
    density: 1.2,
    cut: false,
  };

  let t = 0; // atomic units of time
  let h = 1; // box half-width, bohr
  let s = 1; // bohr per world unit
  let A: Float32Array = new Float32Array(0), B: Float32Array | null = null;
  let Ea = 0, Eb = 0;
  let rate = 1; // atomic time units per second of real time
  let ref = 1; // a typical density of the state, which sets the exposure
  let peakRho = 1;
  let stateVer = 0;

  const vol = new Float32Array(N3 * 2);
  let composedT = NaN, composedVer = -1;
  const stats = { norm: 0, r: 0, x: 0, y: 0, z: 0 };

  function orbsNow(): Orb[] {
    return state.mode === 'orb' ? [state.orb] : SUPS[state.sup];
  }

  function prepare() {
    const list = orbsNow();
    h = Math.max(...list.map((o) => boxHalf(o.n, o.l)));
    if (state.mode === 'sup') h = Math.min(h, 24);
    s = h / HW;
    A = grid(list[0], h);
    B = list[1] ? grid(list[1], h) : null;
    Ea = energy(list[0].n);
    Eb = list[1] ? energy(list[1].n) : Ea;
    // what turns in 5 s on screen: the phase of an orbital, or the beat of a mixture
    const w = B && Math.abs(Eb - Ea) > 1e-9 ? Math.abs(Eb - Ea) : Math.abs(Ea);
    rate = TAU / w / 5;
    t = 0;
    stateVer++;
    compose();
    // the exposure: the probability-weighted geometric mean of the density, a
    // level typical of where the electron is, which a bright core does not dominate
    let s1 = 0, sl = 0, pk = 0;
    for (let i = 0; i < N3; i++) {
      const re = vol[2 * i], im = vol[2 * i + 1], p = re * re + im * im;
      if (p <= 0) continue;
      s1 += p;
      sl += p * Math.log(p);
      if (p > pk) pk = p;
    }
    ref = s1 > 0 ? Math.exp(sl / s1) : 1;
    peakRho = pk || 1;
    planeVer = -1;
    clearDots();
  }

  /** ψ(t) on the grid: each stationary part only turns its phase, e^(−iEt). */
  function compose() {
    if (composedT === t && composedVer === stateVer) return;
    composedT = t;
    composedVer = stateVer;
    // a real orbital is drawn as its spatial part, so its colours stay the sign of ψ;
    // in time it only picks up the overall phase e^(−iEt), which no measurement sees
    const tt = signed() ? 0 : t;
    const ca = Math.cos(Ea * tt), sa = -Math.sin(Ea * tt);
    const dV = Math.pow(CELL * s, 3);
    let n = 0, sr = 0, sx = 0, sy = 0, sz = 0;
    let q = 0;
    if (!B) {
      for (let k = 0; k < GN; k++)
        for (let j = 0; j < GN; j++) {
          let row = 0, rx = 0;
          for (let i = 0; i < GN; i++, q++) {
            const ar = A[2 * q], ai = A[2 * q + 1];
            const re = ar * ca - ai * sa, im = ar * sa + ai * ca;
            vol[2 * q] = re;
            vol[2 * q + 1] = im;
            const p = re * re + im * im;
            row += p;
            rx += p * cw[i];
            sr += p * RW[q];
          }
          n += row; sx += rx; sz += row * cw[j]; sy -= row * cw[k];
        }
    } else {
      const r2 = Math.SQRT1_2;
      const cb = Math.cos(Eb * t) * r2, sb = -Math.sin(Eb * t) * r2;
      const ca2 = ca * r2, sa2 = sa * r2;
      for (let k = 0; k < GN; k++)
        for (let j = 0; j < GN; j++) {
          let row = 0, rx = 0;
          for (let i = 0; i < GN; i++, q++) {
            const ar = A[2 * q], ai = A[2 * q + 1], br = B[2 * q], bi = B[2 * q + 1];
            const re = ar * ca2 - ai * sa2 + br * cb - bi * sb;
            const im = ar * sa2 + ai * ca2 + br * sb + bi * cb;
            vol[2 * q] = re;
            vol[2 * q + 1] = im;
            const p = re * re + im * im;
            row += p;
            rx += p * cw[i];
            sr += p * RW[q];
          }
          n += row; sx += rx; sz += row * cw[j]; sy -= row * cw[k];
        }
    }
    stats.norm = n * dV;
    stats.r = n > 0 ? (sr / n) * s : 0;
    stats.x = n > 0 ? (sx / n) * s : 0;
    stats.y = n > 0 ? (sy / n) * s : 0;
    stats.z = n > 0 ? (sz / n) * s : 0;
    cdfVer = -1;
    volDirty = true;
  }

  // --- the slice ------------------------------------------------------------------------

  // the physics planes on the world's axes: XZ holds the z axis, so it stands upright
  const WORLD_PLANE: Record<PhysPlane, PlaneAxis> = { xz: 'xy', xy: 'xz', yz: 'yz' };
  const worldOffset = () => (state.plane === 'xz' ? -1 : 1) * state.offset * HW;
  const PG = 128;
  const planeA = new Float32Array(PG * PG * 2), planeB = new Float32Array(PG * PG * 2);
  const planeBuf = new Float32Array(PG * PG * 2), planeUp = new Float32Array(PG * PG * 2);
  let planeVer = -1, planeKey = '';

  function samplePlane() {
    const key = `${stateVer}|${state.plane}|${state.offset}`;
    if (key === planeKey) return;
    planeKey = key;
    const list = orbsNow();
    const wp = WORLD_PLANE[state.plane], off = worldOffset();
    const preps = list.map((o) => prepOrb(o, h * 1.75));
    for (let j = 0; j < PG; j++) {
      const v = -HW + ((j + 0.5) / PG) * 2 * HW;
      for (let i = 0; i < PG; i++) {
        const u = -HW + ((i + 0.5) / PG) * 2 * HW;
        const p = planePoint(wp, off, u, v);
        const q = (j * PG + i) * 2;
        evalPsi(preps[0], p.x * s, -p.z * s, p.y * s);
        planeA[q] = oRe;
        planeA[q + 1] = oIm;
        if (preps[1]) {
          evalPsi(preps[1], p.x * s, -p.z * s, p.y * s);
          planeB[q] = oRe;
          planeB[q + 1] = oIm;
        }
      }
    }
    planeVer = -1;
  }

  let planeT = NaN;
  function composePlane() {
    samplePlane();
    if (planeVer === stateVer && planeT === t) return false;
    planeVer = stateVer;
    planeT = t;
    const tt = signed() ? 0 : t;
    const ca = Math.cos(Ea * tt), sa = -Math.sin(Ea * tt);
    if (!B) {
      for (let q = 0; q < PG * PG; q++) {
        const ar = planeA[2 * q], ai = planeA[2 * q + 1];
        planeBuf[2 * q] = ar * ca - ai * sa;
        planeBuf[2 * q + 1] = ar * sa + ai * ca;
      }
    } else {
      const r2 = Math.SQRT1_2;
      const cb = Math.cos(Eb * t) * r2, sb = -Math.sin(Eb * t) * r2, ca2 = ca * r2, sa2 = sa * r2;
      for (let q = 0; q < PG * PG; q++) {
        const ar = planeA[2 * q], ai = planeA[2 * q + 1], br = planeB[2 * q], bi = planeB[2 * q + 1];
        planeBuf[2 * q] = ar * ca2 - ai * sa2 + br * cb - bi * sb;
        planeBuf[2 * q + 1] = ar * sa2 + ai * ca2 + br * sb + bi * cb;
      }
    }
    return true;
  }

  // --- measuring ------------------------------------------------------------------------

  const cdf = new Float64Array(N3);
  let cdfVer = -1;
  const MAXD = 4000;
  const dots = new Float32Array(MAXD * 3);
  let nDots = 0, nMeasured = 0, sumR = 0;
  let collapsed = false, reprepareAt = -1, pending = 0;
  let lastHit: Vec | null = null;

  type Flash = { p: Vec; born: number; big: boolean };
  let flashes: Flash[] = [];

  function clearDots() {
    nDots = 0;
    nMeasured = 0;
    sumR = 0;
    pending = 0;
    collapsed = false;
    reprepareAt = -1;
    lastHit = null;
    flashes = [];
  }

  /** Born rule: a voxel picked with probability |ψ|²ΔV, then a point inside it. */
  function sample(): Vec | null {
    compose();
    if (cdfVer !== composedVer * 1e6 + composedT) {
      let acc = 0;
      for (let i = 0; i < N3; i++) {
        acc += vol[2 * i] * vol[2 * i] + vol[2 * i + 1] * vol[2 * i + 1];
        cdf[i] = acc;
      }
      cdfVer = composedVer * 1e6 + composedT;
    }
    const total = cdf[N3 - 1];
    if (!(total > 0)) return null;
    const u = Math.random() * total;
    let lo = 0, hi = N3 - 1;
    while (lo < hi) {
      const mid = (lo + hi) >> 1;
      if (cdf[mid] < u) lo = mid + 1;
      else hi = mid;
    }
    const i = lo % GN, j = Math.floor(lo / GN) % GN, k = Math.floor(lo / (GN * GN));
    return {
      x: -HW + (i + Math.random()) * CELL,
      y: -HW + (j + Math.random()) * CELL,
      z: -HW + (k + Math.random()) * CELL,
    };
  }

  function record(p: Vec, flash: 'big' | 'small' | 'none') {
    const slot = nDots < MAXD ? nDots++ : Math.floor(Math.random() * MAXD);
    dots[slot * 3] = p.x;
    dots[slot * 3 + 1] = p.y;
    dots[slot * 3 + 2] = p.z;
    nMeasured++;
    sumR += Math.hypot(p.x, p.y, p.z) * s;
    lastHit = p;
    if (flash !== 'none') flashes.push({ p, born: performance.now(), big: flash === 'big' });
  }

  /** One fresh atom, one measurement: the cloud collapses to the point it was found at. */
  function measureOne() {
    const p = sample();
    if (!p) return;
    record(p, 'big');
    collapsed = true;
    pending = 0;
    reprepareAt = performance.now() + 1700;
  }

  function measureMany(k: number) {
    collapsed = true;
    pending += k;
    reprepareAt = -1;
  }

  // --- colour ---------------------------------------------------------------------------

  // a cyclic palette for the phase: rose, amber, green, cyan, blue, violet. The
  // signed palette of the real orbitals uses its two ends: rose for +, cyan for −.
  const HUES = [
    [244, 114, 182], [251, 191, 36], [74, 222, 128], [34, 211, 238], [96, 165, 250], [167, 139, 250],
  ];
  function hueRGB(hh: number) {
    const f = (((hh % 1) + 1) % 1) * HUES.length;
    const i = Math.floor(f), u = f - i;
    const a = HUES[i % HUES.length], b = HUES[(i + 1) % HUES.length];
    return [a[0] + (b[0] - a[0]) * u, a[1] + (b[1] - a[1]) * u, a[2] + (b[2] - a[2]) * u];
  }
  const PLUS_RGB = HUES[0], MINUS_RGB = HUES[3];
  function signRGB(hh: number) {
    const w = (1 - Math.cos(TAU * hh)) / 2;
    return [0, 1, 2].map((c) => PLUS_RGB[c] + (MINUS_RGB[c] - PLUS_RGB[c]) * w);
  }

  const NH = 64;
  function table(light: boolean, col: (hh: number) => number[]) {
    const out = new Uint32Array(NH * 256);
    for (let r = 0; r < NH; r++) {
      const c = col(r / NH);
      for (let k = 0; k < 256; k++) {
        const l = k / 255;
        let cr: number, cg: number, cb: number, al: number;
        if (light) {
          const d = 1 - 0.15 * l;
          cr = c[0] * d; cg = c[1] * d; cb = c[2] * d;
          al = Math.min(0.9, 1.1 * Math.pow(l, 0.65));
        } else {
          const v = 0.4 + 0.6 * l, w = Math.max(0, (l - 0.72) / 0.28) * 0.6;
          cr = c[0] * v; cg = c[1] * v; cb = c[2] * v;
          cr += (255 - cr) * w; cg += (255 - cg) * w; cb += (255 - cb) * w;
          al = Math.min(0.92, Math.pow(l, 0.75));
        }
        out[r * 256 + k] = rgba32(cr, cg, cb, 255 * al);
      }
    }
    return out;
  }

  const signed = () => state.mode === 'orb' && state.orb.real;
  let lut = new Uint32Array(NH * 256);
  let lutKey = '';
  function ensureLut() {
    const key = `${isLight()}|${signed()}`;
    if (key === lutKey) return false;
    lutKey = key;
    lut = table(isLight(), signed() ? signRGB : hueRGB);
    vv?.setColours(lut);
    wheel = null;
    return true;
  }

  /** A cheap stand-in for atan2 / 2π: monotonic in the angle, in [0, 1). */
  function turn(b: number, a: number) {
    let d: number;
    if (b >= 0) d = a >= 0 ? b / (a + b + 1e-30) : 1 - a / (b - a);
    else d = a < 0 ? 2 - b / (-a - b) : 3 + a / (a - b);
    return d * 0.25;
  }

  // --- the view -------------------------------------------------------------------------

  const cam = new Camera3D(W, H, { dist: 24, yaw: 0.62, pitch: 0.36, zoom: 0.8 });
  const vv = VolumeView.create(canvas, W, H, 'complex');
  const shade = vv ? null : new PlaneShade(W, H, { half: HW, grid: PG, step: 1.5 });
  let volDirty = true;

  // What goes to the GPU: ψ scaled so the densest point is 1, since half floats
  // lose tiny numbers (the r^l near the nucleus), with what is left of them set
  // to an exact zero, and the cutaway: the quarter of the box (all heights) on
  // the camera's side is emptied so the shells inside show. It follows the camera.
  const up = new Float32Array(N3 * 2);
  let cutQ = -1;
  function quarter() {
    if (!state.cut) return -1;
    const e = cam.eye();
    return (e.x > 0 ? 1 : 0) + (e.z > 0 ? 2 : 0);
  }
  let vis = 1; // how much of the cloud is there: 0 right after a measurement
  const TINY = 1e-4;
  function forGPU(src: Float32Array, dst: Float32Array, n: number) {
    const k = 1 / Math.sqrt(peakRho);
    for (let i = 0; i < n * 2; i++) {
      const v = src[i] * k;
      dst[i] = v > TINY || v < -TINY ? v : 0;
    }
  }
  function upload(q: number) {
    forGPU(vol, up, N3);
    if (q >= 0) {
      const half = GN / 2;
      const i0 = q & 1 ? half : 0, k0 = q & 2 ? half : 0;
      for (let k = k0; k < k0 + half; k++)
        for (let j = 0; j < GN; j++) up.fill(0, ((k * GN + j) * GN + i0) * 2, ((k * GN + j) * GN + i0 + half) * 2);
    }
    return up;
  }

  function drawPlaneFrame() {
    const light = isLight();
    const wp = WORLD_PLANE[state.plane], off = worldOffset();
    const col = `rgba(${ink()},${light ? 0.1 : 0.07})`;
    const edge = `rgba(${ink()},${light ? 0.32 : 0.26})`;
    const k = 12;
    for (let i = 0; i <= k; i++) {
      const u = -HW + (2 * HW * i) / k;
      const c = i === 0 || i === k ? edge : col;
      line3(ctx, cam, planePoint(wp, off, u, -HW), planePoint(wp, off, u, HW), c, 1);
      line3(ctx, cam, planePoint(wp, off, -HW, u), planePoint(wp, off, HW, u), c, 1);
    }
    const lab = cam.project(planePoint(wp, off, HW, -HW));
    const axis = { xz: 'y', xy: 'z', yz: 'x' }[state.plane];
    ctx.fillStyle = `rgba(${ink()},0.5)`;
    ctx.font = "500 11px 'JetBrains Mono', monospace";
    ctx.textAlign = 'left';
    ctx.textBaseline = 'middle';
    ctx.fillText(`${state.plane.toUpperCase()} · ${axis} = ${(state.offset * h).toFixed(1)} a₀`, lab.sx + 8, lab.sy);
  }

  // physics axes through the nucleus, z upright
  const PAX = [
    { v: { x: 1, y: 0, z: 0 }, c: '248,113,113', l: 'x' },
    { v: { x: 0, y: 0, z: -1 }, c: '74,222,128', l: 'y' },
    { v: { x: 0, y: 1, z: 0 }, c: '96,165,250', l: 'z' },
  ];

  function drawAxes() {
    const light = isLight();
    for (const a of PAX) {
      const e = { x: a.v.x * HW, y: a.v.y * HW, z: a.v.z * HW };
      line3(ctx, cam, { x: -e.x, y: -e.y, z: -e.z }, e, `rgba(${a.c},${light ? 0.32 : 0.22})`, 1);
    }
  }

  function drawGizmo() {
    const ox = 50, oy = H - 50, len = 28;
    const pr = PAX.map((a) => {
      const c = cam.toCam(a.v);
      return { ex: ox + c.x * len, ey: oy - c.y * len, depth: c.z, c: `rgb(${a.c})`, l: a.l };
    }).sort((a, b) => b.depth - a.depth);
    ctx.lineWidth = 2;
    ctx.font = "600 11px 'JetBrains Mono', monospace";
    ctx.textAlign = 'left';
    ctx.textBaseline = 'alphabetic';
    for (const a of pr) {
      ctx.strokeStyle = a.c;
      ctx.fillStyle = a.c;
      ctx.beginPath();
      ctx.moveTo(ox, oy);
      ctx.lineTo(a.ex, a.ey);
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(a.ex, a.ey, 2.4, 0, TAU);
      ctx.fill();
      ctx.fillText(a.l, a.ex + 4, a.ey - 4);
    }
  }

  /** The length of one box edge, written along the front bottom edge. */
  function drawScale() {
    const light = isLight();
    // the bottom edge nearest the camera, among the four along world x and z
    const cands = [
      [{ x: -HW, y: -HW, z: HW }, { x: HW, y: -HW, z: HW }],
      [{ x: -HW, y: -HW, z: -HW }, { x: HW, y: -HW, z: -HW }],
      [{ x: HW, y: -HW, z: -HW }, { x: HW, y: -HW, z: HW }],
      [{ x: -HW, y: -HW, z: -HW }, { x: -HW, y: -HW, z: HW }],
    ];
    let best = cands[0], bz = Infinity;
    for (const c of cands) {
      const z = cam.toCam({ x: (c[0].x + c[1].x) / 2, y: -HW, z: (c[0].z + c[1].z) / 2 }).zc;
      if (z < bz) { bz = z; best = c; }
    }
    const a = cam.project(best[0]), b = cam.project(best[1]);
    const mx = (a.sx + b.sx) / 2, my = (a.sy + b.sy) / 2;
    ctx.save();
    ctx.translate(mx, my);
    let ang = Math.atan2(b.sy - a.sy, b.sx - a.sx);
    if (ang > Math.PI / 2) ang -= Math.PI;
    if (ang < -Math.PI / 2) ang += Math.PI;
    ctx.rotate(ang);
    ctx.fillStyle = `rgba(${ink()},${light ? 0.6 : 0.5})`;
    ctx.font = "500 11px 'JetBrains Mono', monospace";
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';
    ctx.fillText(`${(2 * h).toFixed(h < 8 ? 1 : 0)} a₀`, 0, 6);
    ctx.restore();
  }

  function drawNucleus() {
    const p = cam.project({ x: 0, y: 0, z: 0 });
    const light = isLight();
    ctx.fillStyle = light ? 'rgba(28,30,36,0.85)' : 'rgba(255,255,255,0.9)';
    ctx.beginPath();
    ctx.arc(p.sx, p.sy, 1.8, 0, TAU);
    ctx.fill();
  }

  function drawDots() {
    if (!nDots) return;
    const light = isLight();
    const n = Math.min(nDots, MAXD);
    const sz = Math.max(1.6, Math.min(3, 2.6 * cam.zoom / 0.8 * (n > 600 ? 0.75 : 1)));
    const col = light ? '180,83,9' : '253,224,71';
    // three depth bins: far dots dimmer
    for (let b = 0; b < 3; b++) {
      ctx.fillStyle = `rgba(${col},${(light ? 0.95 : 0.9) * (0.45 + 0.275 * b)})`;
      ctx.beginPath();
      for (let i = 0; i < n; i++) {
        const q = { x: dots[i * 3], y: dots[i * 3 + 1], z: dots[i * 3 + 2] };
        const pr = cam.project(q);
        const f = cam.fog(pr.zc, HW);
        const bin = f < 0.6 ? 0 : f < 0.8 ? 1 : 2;
        if (bin !== b) continue;
        ctx.rect(pr.sx - sz / 2, pr.sy - sz / 2, sz, sz);
      }
      ctx.fill();
    }
  }

  function drawHit() {
    if (!collapsed || !lastHit || pending > 0) return;
    const light = isLight();
    const pr = cam.project(lastHit);
    const g = ctx.createRadialGradient(pr.sx, pr.sy, 0, pr.sx, pr.sy, 14);
    g.addColorStop(0, light ? 'rgba(245,158,11,0.55)' : 'rgba(255,251,235,0.9)');
    g.addColorStop(0.35, 'rgba(251,191,36,0.35)');
    g.addColorStop(1, 'rgba(251,191,36,0)');
    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.arc(pr.sx, pr.sy, 14, 0, TAU);
    ctx.fill();
    ctx.strokeStyle = light ? 'rgba(180,83,9,0.85)' : 'rgba(251,191,36,0.9)';
    ctx.lineWidth = 1.4;
    ctx.beginPath();
    ctx.moveTo(pr.sx - 11, pr.sy); ctx.lineTo(pr.sx - 6, pr.sy);
    ctx.moveTo(pr.sx + 6, pr.sy); ctx.lineTo(pr.sx + 11, pr.sy);
    ctx.moveTo(pr.sx, pr.sy - 11); ctx.lineTo(pr.sx, pr.sy - 6);
    ctx.moveTo(pr.sx, pr.sy + 6); ctx.lineTo(pr.sx, pr.sy + 11);
    ctx.stroke();
  }

  const FLASH_MS = 700;
  function drawFlashes() {
    const now = performance.now();
    const light = isLight();
    flashes = flashes.filter((f) => now - f.born < FLASH_MS);
    if (!flashes.length) return;
    ctx.save();
    ctx.globalCompositeOperation = light ? 'source-over' : 'lighter';
    for (const f of flashes) {
      const u = (now - f.born) / FLASH_MS;
      const pr = cam.project(f.p);
      if (pr.zc < 0.3) continue;
      const R = (10 + 60 * Math.sqrt(u)) * (f.big ? 1 : 0.3);
      const al = (1 - u) * (1 - u) * (f.big ? 1 : 0.6);
      const g = ctx.createRadialGradient(pr.sx, pr.sy, 0, pr.sx, pr.sy, R);
      g.addColorStop(0, light ? `rgba(245,158,11,${0.75 * al})` : `rgba(255,251,235,${al})`);
      g.addColorStop(0.25, `rgba(251,191,36,${0.6 * al})`);
      g.addColorStop(1, 'rgba(251,191,36,0)');
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(pr.sx, pr.sy, R, 0, TAU);
      ctx.fill();
      if (f.big) {
        ctx.strokeStyle = `rgba(251,191,36,${0.8 * al})`;
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.arc(pr.sx, pr.sy, R * 0.8, 0, TAU);
        ctx.stroke();
      }
    }
    ctx.restore();
  }

  // the legend in the corner: a colour wheel for the phase, two swatches for the sign
  let wheel: HTMLCanvasElement | null = null;
  function drawLegend() {
    const light = isLight();
    const x = W - 62, y = H - 54;
    ctx.font = "500 11px 'JetBrains Mono', monospace";
    ctx.fillStyle = `rgba(${ink()},0.6)`;
    if (signed()) {
      const sw = (c: number[], yy: number, txt: string) => {
        const d = light ? 0.8 : 1;
        ctx.fillStyle = `rgb(${c[0] * d},${c[1] * d},${c[2] * d})`;
        ctx.beginPath();
        ctx.arc(x - 14, yy, 6, 0, TAU);
        ctx.fill();
        ctx.fillStyle = `rgba(${ink()},0.65)`;
        ctx.textAlign = 'left';
        ctx.textBaseline = 'middle';
        ctx.fillText(txt, x - 2, yy);
      };
      sw(PLUS_RGB, y - 10, 'ψ > 0');
      sw(MINUS_RGB, y + 10, 'ψ < 0');
      return;
    }
    const S = 64;
    if (!wheel) {
      wheel = document.createElement('canvas');
      wheel.width = wheel.height = S;
      const g = wheel.getContext('2d')!;
      const img = g.createImageData(S, S);
      const pix = new Uint32Array(img.data.buffer);
      for (let j = 0; j < S; j++)
        for (let i = 0; i < S; i++) {
          const dx = i + 0.5 - S / 2, dy = S / 2 - (j + 0.5);
          const r = Math.hypot(dx, dy) / (S / 2);
          if (r > 1 || r < 0.55) continue;
          const c = hueRGB(Math.atan2(dy, dx) / TAU);
          const d = light ? 0.8 : 1;
          const edge = Math.min(1, (1 - r) * 20, (r - 0.55) * 20);
          pix[j * S + i] = rgba32(c[0] * d, c[1] * d, c[2] * d, 255 * edge);
        }
      g.putImageData(img, 0, 0);
    }
    ctx.drawImage(wheel, x - 20, y - 20, 40, 40);
    ctx.fillStyle = `rgba(${ink()},0.6)`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'bottom';
    ctx.fillText('arg ψ', x, y - 26);
    ctx.textBaseline = 'middle';
    ctx.textAlign = 'left';
    ctx.fillText('0', x + 24, y);
    ctx.textAlign = 'right';
    ctx.fillText('π', x - 24, y);
  }

  // --- frame ----------------------------------------------------------------------------

  let bgLight: boolean | null = null;
  const EXPOSE = 0.8, PLANE_EXPOSE = 0.15, LEN = 2;

  function draw() {
    const light = isLight();
    ensureLut();
    ctx.clearRect(0, 0, W, H);
    if (!vv) drawBackdrop(ctx, W, H, light);
    else if (bgLight !== light) {
      bgLight = light;
      vv.canvas.style.background = `radial-gradient(circle at 50% 45%, rgba(99,102,241,${light ? 0.06 : 0.12}), rgba(99,102,241,0) 70%), var(--stage-bg)`;
    }
    drawBox(ctx, cam, HW, ink(), light);
    drawAxes();

    const showPlane = !vv || state.show !== 'cloud', showCloud = !!vv && state.show !== 'plane';
    compose();
    if (vv) {
      const q = quarter();
      if (volDirty || q !== cutQ) {
        vv.setVolume(upload(q), [GN, GN, GN], [-HW, -HW, -HW], [HW, HW, HW]);
        volDirty = false;
        cutQ = q;
      }
      if (showPlane && composePlane()) vv.setPlane((forGPU(planeBuf, planeUp, PG * PG), planeUp), PG, WORLD_PLANE[state.plane], worldOffset(), HW);
      vv.render(cam, {
        cloud: showCloud && vis > 0.01,
        plane: showPlane && vis > 0.01,
        gain: ((light ? 2.2 : 1) * EXPOSE * peakRho / ref) * vis,
        planeGain: (PLANE_EXPOSE * peakRho / ref) * vis,
        opacity: state.density,
        len: LEN,
        phase: true,
        light,
        planeAlpha: 0.55,
      });
    } else if (shade && vis > 0.01) {
      composePlane();
      for (let q = 0; q < PG * PG; q++) {
        shade.a[q] = planeBuf[2 * q];
        shade.b[q] = planeBuf[2 * q + 1];
      }
      const inv = (16 * PLANE_EXPOSE * vis) / ref, norm = 255 / Math.log(17);
      shade.render(ctx, cam, WORLD_PLANE[state.plane], worldOffset(), (a, b) => {
        let li = (Math.log(1 + (a * a + b * b) * inv) * norm) | 0;
        if (li < 2) return 0;
        if (li > 255) li = 255;
        return lut[(((turn(b, a) * NH) | 0) % NH) * 256 + li];
      });
    }
    if (showPlane) drawPlaneFrame();
    drawNucleus();
    drawDots();
    drawHit();
    drawFlashes();
    drawGizmo();
    drawLegend();
    drawScale();
    sync();
  }

  // --- words and numbers ---------------------------------------------------------------

  const LETTER = 'spdfg';
  const REAL: Record<string, [string, string]> = {
    '1,1': ['x', 'x'], '1,-1': ['y', 'y'], '1,0': ['z', 'z'],
    '2,0': ['z²', 'z^2'], '2,1': ['xz', 'xz'], '2,-1': ['yz', 'yz'], '2,2': ['x²−y²', 'x^2-y^2'], '2,-2': ['xy', 'xy'],
    '3,0': ['z³', 'z^3'], '3,1': ['xz²', 'xz^2'], '3,-1': ['yz²', 'yz^2'], '3,2': ['z(x²−y²)', 'z(x^2-y^2)'],
    '3,-2': ['xyz', 'xyz'], '3,3': ['x(x²−3y²)', 'x(x^2-3y^2)'], '3,-3': ['y(3x²−y²)', 'y(3x^2-y^2)'],
  };
  const sgn = (m: number) => (m > 0 ? `+${m}` : m < 0 ? `−${-m}` : '0');
  /** A plain-text name: "3d xy", "2p m = +1". */
  function name(o: Orb) {
    const base = `${o.n}${LETTER[o.l]}`;
    if (o.l === 0) return base;
    const r = REAL[`${o.l},${o.m}`];
    if (o.real && o.m !== 0 && r) return `${base} ${r[0]}`;
    if (o.real && o.m !== 0) return `${base}, real m = ${sgn(o.m)}`;
    if (o.m === 0 && r) return `${base} ${r[0]}`;
    return `${base}, m = ${sgn(o.m)}`;
  }
  function texName(o: Orb) {
    const base = `${o.n}${LETTER[o.l]}`;
    const r = REAL[`${o.l},${o.m}`];
    if (o.l > 0 && (o.real || o.m === 0) && r) return `${base}_{${r[1]}}`;
    return `${o.n}${o.l}${o.m < 0 ? `\\bar{${-o.m}}` : o.m}`;
  }
  const f2 = (v: number) => (Math.abs(v) < 0.005 ? '0.00' : v.toFixed(2));
  const minus = (v: string) => v.replace('-', '−');

  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  let lastSync = 0;
  function sync(force = false) {
    const now = performance.now();
    if (!force && tr.running() && now - lastSync < 150) return;
    lastSync = now;
    const rule: (string | [string, string])[] = [
      '\\hat H',
      ['\\psi_{nlm}', CLOUD],
      '=E_n',
      ['\\psi_{nlm}', CLOUD],
      ',\\qquad E_n=-13.6\\,\\text{eV}/n^2',
    ];
    const tfs = t * FS;
    const count = nMeasured ? String(nMeasured) : '0';
    const avg = nMeasured ? `${f2(sumR / nMeasured)} a₀` : '—';
    const box = `±${h.toFixed(h < 8 ? 1 : 0)} a₀`;
    const dip = `${minus(f2(stats.z))} a₀`;

    if (state.mode === 'orb') {
      const o = state.orb;
      const E = energy(o.n) * EV;
      const rMean = (3 * o.n * o.n - o.l * (o.l + 1)) / 2;
      setEq({
        rule,
        live: [
          `\\psi_{${texName(o)}}=R_{${o.n}${o.l}}(r)\\,${o.real && o.m !== 0 ? 'Y_{' + o.l + (o.m < 0 ? ',' : ',+') + o.m + '}' : 'Y_{' + o.l + '}^{' + o.m + '}'}(\\theta,\\varphi),\\quad E_{${o.n}}=-\\tfrac{13.6}{${o.n * o.n}}\\,\\text{eV}=${E.toFixed(2)}\\,\\text{eV}`,
        ],
      });
      const nr = o.n - o.l - 1;
      setResult({
        value: `${minus(E.toFixed(2))} eV`,
        status: `${name(o)} · ${nr} radial node${nr === 1 ? '' : 's'}, ${o.l} angular · ⟨r⟩ = ${rMean} a₀`,
        note: pending > 0
          ? `Measuring fresh atoms one after another: ${nMeasured} so far.`
          : nMeasured > 1
            ? `${nMeasured} atoms, ${nMeasured} dots. Their mean distance ${f2(sumR / nMeasured)} a₀ heads for ⟨r⟩ = ${rMean} a₀.`
            : collapsed
              ? 'Found at one point. The cloud was where the electron could be found, not a smeared-out electron.'
              : o.real
                ? 'The chemistry picture: colour is the sign of ψ. In time the whole orbital only turns its overall phase, so nothing here moves.'
                : tr.running()
                  ? 'A stationary state: |ψ|² never changes, only the phase turns, at the rate E/ħ.'
                  : 'The fog is |ψ|²: dense where the electron is likely to be found, dark at the nodes.',
      });
      setRows({
        'r-E': `${minus(E.toFixed(3))} eV`,
        'r-rmean': `${rMean.toFixed(1)} a₀`,
        'r-rgrid': `${f2(stats.r)} a₀`,
        'r-rmp': `${RMP[o.n][o.l].toFixed(2)} a₀`,
        'r-nodes': `${nr} / ${o.l}`,
        'r-norm': f2(stats.norm),
        'r-dip': dip,
        'r-box': box,
        'r-t': `${tfs.toFixed(3)} fs`,
        'r-count': count,
        'r-avg': avg,
      });
      return;
    }

    const [a, b] = SUPS[state.sup];
    const dE = Math.abs(energy(b.n) - energy(a.n));
    const eV = dE * EV;
    const ta = texName(a), tb = texName(b);
    setEq({
      rule,
      live: dE > 1e-9
        ? [`\\psi=\\tfrac{1}{\\sqrt2}\\big(\\psi_{${ta}}e^{-iE_{${a.n}}t/\\hbar}+\\psi_{${tb}}e^{-iE_{${b.n}}t/\\hbar}\\big),\\quad \\hbar\\omega=E_{${b.n}}-E_{${a.n}}=${eV.toFixed(2)}\\,\\text{eV}`]
        : [`\\psi=\\tfrac{1}{\\sqrt2}\\big(\\psi_{${ta}}+\\psi_{${tb}}\\big)e^{-iE_{${a.n}}t/\\hbar},\\quad E_{${a.n}}=E_{${b.n}}`],
    });
    const lam = dE > 1e-9 ? NM / dE : 0;
    const period = dE > 1e-9 ? (TAU / dE) * FS : 0;
    setResult({
      value: dE > 1e-9 ? `${lam.toFixed(1)} nm` : 'none',
      status: dE > 1e-9
        ? `ħω = ${eV.toFixed(2)} eV · period ${period.toFixed(3)} fs · ${lam < 400 ? 'ultraviolet' : lam < 700 ? 'visible red' : 'infrared'}`
        : 'equal energies: nothing beats',
      note: dE > 1e-9
        ? state.sup === 's-p1'
          ? 'The lopsided cloud swings round the z axis: a charge going in a circle, which emits circularly polarised light.'
          : 'The two parts turn their phases at different rates, so their overlap beats and the charge sloshes along z, emitting light of this wavelength.'
        : 'Both parts have the same energy, so their phases turn together: a lopsided hybrid that stays put and emits nothing.',
    });
    setRows({
      'r-E': `⟨E⟩ ${minus((((energy(a.n) + energy(b.n)) / 2) * EV).toFixed(3))} eV`,
      'r-rmean': '—',
      'r-rgrid': `${f2(stats.r)} a₀`,
      'r-rmp': '—',
      'r-nodes': '—',
      'r-norm': f2(stats.norm),
      'r-dip': dip,
      'r-box': box,
      'r-t': `${tfs.toFixed(3)} fs`,
      'r-count': count,
      'r-avg': avg,
    });
  }

  // --- controls -------------------------------------------------------------------------

  function panelFor() {
    const sup = state.mode === 'sup';
    el('orb-wrap').hidden = sup;
    el('sup-wrap').hidden = !sup;
    el('plane-wrap').hidden = state.show === 'cloud' && !!vv;
    el('density-wrap').hidden = state.show === 'plane' || !vv;
    el('cut-wrap').hidden = state.show === 'plane' || !vv;
    el('show').closest('.control')!.toggleAttribute('hidden', !vv);
    el('lg-phase').hidden = signed();
    el('lg-plus').hidden = !signed();
    el('lg-minus').hidden = !signed();
    el('result-label').textContent = sup ? 'Emitted light λ' : 'Energy';
    if (!vv) el('scene-hint').textContent = 'Click empty space to measure · drag to orbit · scroll to zoom · WebGL2 is not available here, so only the slice is drawn';
  }

  function lLabel(l: number) { return `${l} (${LETTER[l]})`; }

  function syncOrbControls() {
    const o = state.orb;
    const lIn = el('l') as HTMLInputElement, mIn = el('m') as HTMLInputElement;
    lIn.max = String(o.n - 1);
    mIn.min = String(-o.l);
    mIn.max = String(o.l);
    setN(o.n);
    setL(o.l);
    setM(o.m);
    setReal(o.real);
    // the m slider says which orbital it is
    el('mval').textContent = mText(o.m);
  }

  function mText(m: number) {
    const o = state.orb;
    const r = REAL[`${o.l},${m}`];
    return o.real && m !== 0 && r ? `${sgn(m)} · ${r[0]}` : sgn(m);
  }

  function setOrb(o: Partial<Orb>, fromPreset = false) {
    const c = { ...state.orb, ...o };
    c.n = Math.max(1, Math.min(5, c.n));
    c.l = Math.max(0, Math.min(c.n - 1, c.l));
    c.m = Math.max(-c.l, Math.min(c.l, c.m));
    state.orb = c;
    if (!fromPreset) {
      const k = Object.keys(PRESETS).find((p) => {
        const q = PRESETS[p];
        return q.n === c.n && q.l === c.l && q.m === c.m && (q.real === c.real || c.m === 0);
      });
      if (k) presets.select(k);
      else presets.clear();
    }
    syncOrbControls();
    prepare();
    panelFor();
    draw();
  }

  const tr = transport({
    onRun: () => draw(),
    onReset: () => { prepare(); vis = 1; draw(); },
  });
  const modes = segmented('mode', (v) => { state.mode = v as Mode; prepare(); panelFor(); draw(); });
  const presets = segmented('preset', (v) => { setOrb(PRESETS[v], true); });
  const sups = segmented('sup', (v) => { state.sup = v; prepare(); panelFor(); draw(); });
  const setN = slider('n', (v) => setOrb({ n: v }), (v) => String(v));
  const setL = slider('l', (v) => setOrb({ l: v }), lLabel);
  const setM = slider('m', (v) => setOrb({ m: v }), mText);
  const setReal = check('real', (on) => setOrb({ real: on }));
  const shows = segmented('show', (v) => { state.show = v as Show; panelFor(); draw(); });
  const planes = segmented('plane', (v) => { state.plane = v as PhysPlane; draw(); });
  const setOffset = slider('offset', (v) => { state.offset = v; draw(); }, (v) => `${(v * h).toFixed(1)} a₀`);
  slider('density', (v) => { state.density = v; draw(); }, (v) => v.toFixed(2));
  const setCut = check('cut', (on) => { state.cut = on; draw(); });

  el('measure').addEventListener('click', () => { measureOne(); draw(); });
  el('measure200').addEventListener('click', () => { measureMany(200); draw(); });

  orbitControls(canvas, cam, W, H, {
    changed: () => draw(),
    click: () => { measureOne(); draw(); },
  });

  function view(o: { show?: Show; plane?: PhysPlane; offset?: number; yaw?: number; pitch?: number; zoom?: number; cut?: boolean }) {
    state.cut = o.cut ?? false;
    setCut(state.cut);
    state.show = o.show ?? 'cloud';
    shows.select(state.show);
    state.plane = o.plane ?? 'xz';
    planes.select(state.plane);
    state.offset = o.offset ?? 0;
    setOffset(state.offset);
    cam.yaw = o.yaw ?? 0.62;
    cam.pitch = o.pitch ?? 0.36;
    cam.zoom = o.zoom ?? 0.8;
  }

  function orbital(o: Orb) {
    state.mode = 'orb';
    modes.select('orb');
    const k = Object.keys(PRESETS).find((p) => {
      const q = PRESETS[p];
      return q.n === o.n && q.l === o.l && q.m === o.m && (q.real === o.real || o.m === 0);
    });
    if (k) presets.select(k);
    else presets.clear();
    state.orb = { ...o };
    syncOrbControls();
    prepare();
    vis = 1;
    panelFor();
  }

  tries({
    shells: () => {
      view({ show: 'cloud', cut: true, pitch: 0.5 });
      orbital(PRESETS['3s']);
      draw();
    },
    winding: () => {
      view({ show: 'both', plane: 'xy', pitch: 1.0 });
      orbital({ n: 2, l: 1, m: 1, real: false });
      tr.setRunning(true);
      draw();
    },
    born: () => {
      view({});
      orbital({ n: 3, l: 2, m: 0, real: true });
      measureMany(200);
      draw();
    },
    slosh: () => {
      view({ yaw: 0.62, pitch: 0.12 });
      state.mode = 'sup';
      modes.select('sup');
      state.sup = 's-pz';
      sups.select('s-pz');
      prepare();
      vis = 1;
      panelFor();
      tr.setRunning(true);
      draw();
    },
  });

  let lastTs = 0;
  function loop(ts: number) {
    const dt = lastTs ? Math.min(0.1, (ts - lastTs) / 1000) : 0;
    lastTs = ts;
    const now = performance.now();
    let need = false;
    if (tr.running()) {
      t += dt * rate;
      need = true;
    }
    if (pending > 0) {
      const k = Math.min(pending, Math.max(1, Math.round(dt * 150)));
      for (let i = 0; i < k; i++) {
        const p = sample();
        if (p) record(p, i === 0 ? 'small' : 'none');
      }
      pending -= k;
      if (pending <= 0) {
        pending = 0;
        reprepareAt = now + 900;
      }
      need = true;
    }
    if (collapsed && reprepareAt > 0 && now >= reprepareAt) {
      collapsed = false;
      reprepareAt = -1;
    }
    const target = collapsed ? 0 : 1;
    if (vis !== target) {
      vis = target < vis ? Math.max(0, vis - dt / 0.25) : Math.min(1, vis + dt / 0.7);
      need = true;
    }
    if (flashes.length) need = true;
    if (need) draw();
    requestAnimationFrame(loop);
  }

  syncOrbControls();
  prepare();
  panelFor();
  draw();
  requestAnimationFrame(loop);
</script>

<style>
  .ao-canvas {
    cursor: grab;
    touch-action: none;
  }

  .ao-canvas:active {
    cursor: grabbing;
  }
</style>
