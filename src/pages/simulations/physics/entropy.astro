---
import SimLayout from '../../../layouts/SimLayout.astro';
import Transport from '../../../components/sim/Transport.astro';
import Actions from '../../../components/sim/Actions.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Checks from '../../../components/sim/Checks.astro';
import Readout from '../../../components/sim/Readout.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="physics"
  title="Entropy"
  description="Lift the wall and a gas fills its box. Every collision could run backwards, and flipping every velocity really does send the gas home. Entropy counts the arrangements that look alike, S = k ln Ω, and chaos is why that count wins."
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas id="ent" width="900" height="600" role="img" aria-label="A gas of colliding particles in a box divided into cells, held in one half by a wall, with the entropy of the cell counts plotted over time below."></canvas>
      </div>
      <Caption
        legend={[
          { label: 'gas A', color: '#7c8cff' },
          { label: 'gas B', color: '#f59e0b', id: 'leg-b' },
          { label: 'where they started (after a flip)', color: '#8b909c' },
        ]}
        hint="Entropy only sees the cells: Ω counts the ways to place the particles so every cell holds the same number. Finer cells see more detail, so S and its ceiling both grow."
      />
      <Result label="Entropy S/k" />
    </div>

    <div class="sim-panel">
      <Transport step running />
      <Actions>
        <button type="button" class="btn" id="lift">Lift the wall</button>
        <button type="button" class="btn ghost" id="flip">Flip velocities</button>
        <button type="button" class="btn ghost" id="nudge">Flip + nudge 10⁻⁹</button>
      </Actions>
      <Seg
        id="mode"
        label="Start"
        attr="m"
        options={[
          { value: 'one', label: 'Gas in one half' },
          { value: 'two', label: 'Two gases' },
        ]}
      />
      <Slider id="np" label="Particles N" min={6} max={400} step={2} value={240} />
      <Slider id="cells" label="Cells" min={0} max={4} value={2} display="32" hint={['coarse', 'fine']} />
      <Slider id="spd" label="Speed" min={1} max={40} value={10} display="10 steps / frame" />
      <Checks items={[{ id: 'grid', label: 'Shade the cells by count', checked: true }]} />
      <Readout
        title="Numbers"
        rows={[
          { id: 'r-omega', label: 'Ways to arrange Ω' },
          { id: 'r-s', label: 'Entropy S/k = ln Ω' },
          { id: 'r-max', label: 'Largest possible S/k' },
          { id: 'r-t', label: 'Steps since the wall lifted' },
          { id: 'r-back', label: 'Return to the start' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Lift the wall and the gas fills the box. Every collision could run backwards,
      yet <b>S</b> climbs to its ceiling and stays there. <Try id="lift" label="Lift the wall" />
    </li>
    <li>
      <b>Flip every velocity</b> and the film runs in reverse: the gas crowds back into
      its rings and S falls to where it began. The laws have no arrow of time. <Try id="flip" />
    </li>
    <li>
      Flip again, but first move one particle by a <b>billionth</b> of the box.
      Collisions blow that error up and the gas never finds its way home. <Try id="nudge" />
    </li>
    <li>
      With <b>6 particles</b> and two cells, all of them land in one half every few
      seconds. The second law is a law of large numbers. <Try id="few" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { el, segmented, slider, check, transport, result, readout, tries } from '../../../lib/panel';

  // --- physics -------------------------------------------------------------
  // Soft disks in a 2.25 × 1 box, integrated with integer leapfrog
  // (x' = 2x − x₋ + round(F)) on a 2^30 lattice. The update is exactly
  // invertible, so swapping current and previous positions replays the past
  // bit for bit, and a nudge of one lattice unit is a nudge of ~10⁻⁹.
  const LX = 2.25, LY = 1, R = 0.012, SIG = 2 * R, K = 0.08, KW = 0.16, V0 = 0.0008;
  const Q = 2 ** 30;
  const MAXN = 400;

  const X = new Float64Array(MAXN), Y = new Float64Array(MAXN);
  const PX = new Float64Array(MAXN), PY = new Float64Array(MAXN);
  const FX = new Float64Array(MAXN), FY = new Float64Array(MAXN);
  const xs = new Float64Array(MAXN), ys = new Float64Array(MAXN);
  const species = new Uint8Array(MAXN);
  const X0 = new Float64Array(MAXN), Y0 = new Float64Array(MAXN);

  const CELLS: [number, number][] = [[2, 1], [4, 2], [8, 4], [16, 8], [32, 16]];
  const state = {
    N: 240,
    mode: 'one',
    cells: 2,
    speed: 10,
    grid: true,
    running: true,
    wall: true,
    wallFade: 1,
    dir: 1, // +1 forwards, −1 after an odd number of flips
    t: 0, // film time in steps; runs backwards after a flip
    t0: -1, // film time when the wall lifted, −1 while it stands
    flipped: false, // flipped since the wall lifted, so the start rings show
    nudged: false,
    back: '' as '' | 'exact' | 'missed',
    backErr: 0,
    hold: 0,
  };

  const gauss = () => Math.sqrt(-2 * Math.log(1 - Math.random())) * Math.cos(2 * Math.PI * Math.random());

  /** Fill a region on a jittered lattice so no two disks start overlapping. */
  function place(from: number, count: number, x0: number, x1: number, kind: number) {
    const w = x1 - x0 - 2 * R, h = LY - 2 * R;
    const cols = Math.max(1, Math.round(Math.sqrt((count * w) / h)));
    const rows = Math.ceil(count / cols);
    const dx = w / cols, dy = h / rows;
    const slots = Array.from({ length: cols * rows }, (_, k) => k);
    for (let k = slots.length - 1; k > 0; k--) {
      const j = (Math.random() * (k + 1)) | 0;
      [slots[k], slots[j]] = [slots[j], slots[k]];
    }
    for (let k = 0; k < count; k++) {
      const i = from + k, c = slots[k] % cols, r = (slots[k] / cols) | 0;
      const x = x0 + R + dx * (c + 0.5 + 0.3 * (Math.random() - 0.5));
      const y = R + dy * (r + 0.5 + 0.3 * (Math.random() - 0.5));
      X[i] = Math.round(x * Q);
      Y[i] = Math.round(y * Q);
      PX[i] = X[i] - Math.round(gauss() * V0 * Q);
      PY[i] = Y[i] - Math.round(gauss() * V0 * Q);
      species[i] = kind;
    }
  }

  function build() {
    const N = state.N;
    if (state.mode === 'one') place(0, N, 0, LX / 2, 0);
    else {
      const a = Math.ceil(N / 2);
      place(0, a, 0, LX / 2, 0);
      place(a, N - a, LX / 2, LX, 1);
    }
    Object.assign(state, { wall: true, wallFade: 1, dir: 1, t: 0, t0: -1, flipped: false, nudged: false, back: '', hold: 0 });
    // let it settle behind the wall so the start looks like a gas, not a lattice
    for (let k = 0; k < 500; k++) step();
    state.t = 0;
    trace.length = 0;
    marks.length = 0;
    frameNo = 0;
    cellsChanged();
  }

  function step() {
    const N = state.N;
    for (let i = 0; i < N; i++) {
      xs[i] = X[i] / Q;
      ys[i] = Y[i] / Q;
      FX[i] = 0;
      FY[i] = 0;
    }
    const w = LX / 2;
    for (let i = 0; i < N; i++) {
      const xi = xs[i], yi = ys[i];
      for (let j = i + 1; j < N; j++) {
        const dx = xi - xs[j];
        if (dx > SIG || dx < -SIG) continue;
        const dy = yi - ys[j];
        if (dy > SIG || dy < -SIG) continue;
        const d2 = dx * dx + dy * dy;
        if (d2 >= SIG * SIG) continue;
        const d = Math.sqrt(d2);
        const f = (K * (SIG - d)) / d;
        FX[i] += f * dx; FY[i] += f * dy;
        FX[j] -= f * dx; FY[j] -= f * dy;
      }
      if (xi < R) FX[i] += KW * (R - xi);
      else if (xi > LX - R) FX[i] -= KW * (xi - LX + R);
      if (yi < R) FY[i] += KW * (R - yi);
      else if (yi > LY - R) FY[i] -= KW * (yi - LY + R);
      if (state.wall) {
        if (xi < w) { if (xi > w - R) FX[i] -= KW * (xi - w + R); }
        else if (xi < w + R) FX[i] += KW * (w + R - xi);
      }
    }
    for (let i = 0; i < N; i++) {
      const nx = 2 * X[i] - PX[i] + Math.round(FX[i] * Q);
      const ny = 2 * Y[i] - PY[i] + Math.round(FY[i] * Q);
      PX[i] = X[i]; PY[i] = Y[i];
      X[i] = nx; Y[i] = ny;
    }
    state.t += state.dir;
    // Running backwards through the moment the wall lifted: compare with it.
    if (state.flipped && state.dir < 0 && state.t === state.t0) {
      let err = 0, same = 0;
      for (let i = 0; i < N; i++) {
        err += ((X[i] - X0[i]) ** 2 + (Y[i] - Y0[i]) ** 2) / (Q * Q);
        if (X[i] === X0[i] && Y[i] === Y0[i]) same++;
      }
      state.backErr = Math.sqrt(err / N);
      state.back = same === N ? 'exact' : 'missed';
      state.hold = performance.now() + 1800;
      mark(state.back === 'exact' ? 'back at the start' : 'should be home', '');
    }
  }

  function lift() {
    if (!state.wall) return;
    state.wall = false;
    state.t0 = state.t;
    X0.set(X); Y0.set(Y);
    mark('wall lifted', '');
  }

  /** Swap current and previous positions: the same laws now replay the past. */
  function flip(nudge: boolean) {
    for (let i = 0; i < state.N; i++) {
      let a = X[i]; X[i] = PX[i]; PX[i] = a;
      a = Y[i]; Y[i] = PY[i]; PY[i] = a;
    }
    state.dir = -state.dir;
    state.t += state.dir;
    if (nudge) X[0] += 1;
    state.flipped = state.t0 >= 0;
    state.nudged = nudge;
    state.back = '';
    mark(nudge ? 'flip + nudge' : 'flip', nudge ? '245,158,11' : '124,140,255');
  }

  // --- entropy of the cell counts -------------------------------------------
  const lnFact = new Float64Array(MAXN + 1);
  for (let i = 1; i <= MAXN; i++) lnFact[i] = lnFact[i - 1] + Math.log(i);
  let counts = new Int32Array(0), countsB = new Int32Array(0);
  let sMax = 1, sHalf = 0;

  /** ln of the multinomial N!/Π nᵢ! at its most even split. */
  function lnEven(n: number, m: number) {
    const q = Math.floor(n / m), rem = n - q * m;
    return lnFact[n] - (m - rem) * lnFact[q] - rem * lnFact[q + 1];
  }
  function cellsChanged() {
    const [c, r] = CELLS[state.cells];
    counts = new Int32Array(c * r);
    countsB = new Int32Array(c * r);
    const N = state.N, a = state.mode === 'one' ? N : Math.ceil(N / 2);
    sMax = lnEven(a, c * r) + (N - a ? lnEven(N - a, c * r) : 0);
    // the most S can be while each gas keeps to its own half
    const h = (c * r) / 2;
    sHalf = lnEven(a, h) + (N - a ? lnEven(N - a, h) : 0);
  }
  function entropy() {
    const [c, r] = CELLS[state.cells];
    counts.fill(0);
    countsB.fill(0);
    let nA = 0;
    for (let i = 0; i < state.N; i++) {
      const cx = Math.min(c - 1, Math.max(0, Math.floor((X[i] / Q / LX) * c)));
      const cy = Math.min(r - 1, Math.max(0, Math.floor((Y[i] / Q / LY) * r)));
      if (species[i]) countsB[cy * c + cx]++;
      else { counts[cy * c + cx]++; nA++; }
    }
    let s = lnFact[nA] + lnFact[state.N - nA];
    for (let k = 0; k < counts.length; k++) s -= lnFact[counts[k]] + lnFact[countsB[k]];
    return s;
  }

  // --- drawing -------------------------------------------------------------
  const canvas = document.getElementById('ent') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const css = (v: string) => getComputedStyle(canvas).getPropertyValue(v).trim();
  const ink = () => css('--stage-ink') || '232,233,236';
  const light = () => css('--stage-light') === '1';
  const ACC = '#7c8cff', WARM = '#f59e0b';
  const RGB = [[124, 140, 255], [245, 158, 11]];

  const BOX = { x: 22, y: 18, w: W - 44, h: (W - 44) / LX };
  const PXU = BOX.w / LX; // pixels per box unit
  const TR = { x: 60, y: BOX.y + BOX.h + 58, w: W - 90, h: H - (BOX.y + BOX.h + 58) - 26 };

  /** A soft round glow, drawn additively behind each particle on dark stages. */
  function sprite(rgb: number[]) {
    const s = document.createElement('canvas');
    s.width = s.height = 64;
    const g = s.getContext('2d')!;
    const grad = g.createRadialGradient(32, 32, 0, 32, 32, 32);
    grad.addColorStop(0, `rgba(${rgb},0.55)`);
    grad.addColorStop(0.35, `rgba(${rgb},0.18)`);
    grad.addColorStop(1, `rgba(${rgb},0)`);
    g.fillStyle = grad;
    g.fillRect(0, 0, 64, 64);
    return s;
  }
  const GLOW = RGB.map(sprite);

  const trace: number[] = [];
  const marks: { f: number; text: string; rgb: string }[] = [];
  let frameNo = 0;
  const SPAN = 720; // frames of history in the strip
  function mark(text: string, rgb: string) {
    marks.push({ f: frameNo, text, rgb });
  }

  function label(text: string, x: number, y: number, alpha = 0.55, align: CanvasTextAlign = 'left', size = 11) {
    ctx.fillStyle = `rgba(${ink()},${alpha})`;
    ctx.font = `${size}px ui-monospace, monospace`;
    ctx.textAlign = align;
    ctx.fillText(text, x, y);
    ctx.textAlign = 'left';
  }

  function drawCells() {
    const [c, r] = CELLS[state.cells];
    const cw = BOX.w / c, ch = BOX.h / r;
    if (state.grid) {
      const mean = state.N / (c * r);
      for (let k = 0; k < counts.length; k++) {
        const n = counts[k] + countsB[k];
        if (!n) continue;
        const fa = counts[k] / n;
        const rgb = RGB[0].map((v, j) => Math.round(v * fa + RGB[1][j] * (1 - fa)));
        ctx.fillStyle = `rgba(${rgb},${Math.min(0.32, (0.11 * n) / Math.max(mean, 0.5))})`;
        ctx.fillRect(BOX.x + (k % c) * cw, BOX.y + ((k / c) | 0) * ch, cw, ch);
      }
    }
    ctx.strokeStyle = `rgba(${ink()},${c > 16 ? 0.05 : 0.09})`;
    ctx.lineWidth = 1;
    ctx.beginPath();
    for (let i = 1; i < c; i++) {
      const x = Math.round(BOX.x + i * cw) + 0.5;
      ctx.moveTo(x, BOX.y);
      ctx.lineTo(x, BOX.y + BOX.h);
    }
    for (let j = 1; j < r; j++) {
      const y = Math.round(BOX.y + j * ch) + 0.5;
      ctx.moveTo(BOX.x, y);
      ctx.lineTo(BOX.x + BOX.w, y);
    }
    ctx.stroke();
    // the macrostate itself, printed while the cells are big enough to read
    if (c * r <= 32) {
      ctx.font = `${c * r <= 8 ? 15 : 12}px ui-monospace, monospace`;
      ctx.textAlign = 'right';
      for (let k = 0; k < counts.length; k++) {
        const x = BOX.x + ((k % c) + 1) * cw - 6, y = BOX.y + ((k / c) | 0) * ch + (c * r <= 8 ? 20 : 16);
        if (state.mode === 'one') {
          ctx.fillStyle = `rgba(${ink()},0.42)`;
          ctx.fillText(String(counts[k]), x, y);
        } else {
          // gas B's count on the right, gas A's just left of it
          const b = String(countsB[k]);
          ctx.fillStyle = `rgba(${RGB[1]},0.75)`;
          ctx.fillText(b, x, y);
          ctx.fillStyle = `rgba(${RGB[0]},0.75)`;
          ctx.fillText(String(counts[k]), x - ctx.measureText(b + ' ').width, y);
        }
      }
      ctx.textAlign = 'left';
    }
  }

  function drawGas() {
    const N = state.N, dark = !light();
    const r = Math.max(2.5, R * PXU);
    // where every particle stood when the wall lifted, once the film is reversed
    if (state.flipped && state.dir < 0) {
      ctx.strokeStyle = `rgba(${ink()},0.28)`;
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (let i = 0; i < N; i++) {
        const x = BOX.x + (X0[i] / Q) * PXU, y = BOX.y + (Y0[i] / Q) * PXU;
        ctx.moveTo(x + r + 2, y);
        ctx.arc(x, y, r + 2, 0, Math.PI * 2);
      }
      ctx.stroke();
    }
    const streak = Math.min(16, 1.6 * state.speed);
    ctx.lineCap = 'round';
    for (let s = 0; s < 2; s++) {
      const rgb = RGB[s];
      // short motion streaks
      ctx.strokeStyle = `rgba(${rgb},${dark ? 0.35 : 0.3})`;
      ctx.lineWidth = r * 1.1;
      ctx.beginPath();
      for (let i = 0; i < N; i++) {
        if (species[i] !== s) continue;
        const x = BOX.x + (X[i] / Q) * PXU, y = BOX.y + (Y[i] / Q) * PXU;
        const vx = ((X[i] - PX[i]) / Q) * PXU, vy = ((Y[i] - PY[i]) / Q) * PXU;
        ctx.moveTo(x, y);
        ctx.lineTo(x - vx * streak, y - vy * streak);
      }
      ctx.stroke();
      if (dark) {
        ctx.globalCompositeOperation = 'lighter';
        const g = r * 5.5;
        for (let i = 0; i < N; i++) {
          if (species[i] !== s) continue;
          ctx.drawImage(GLOW[s], BOX.x + (X[i] / Q) * PXU - g / 2, BOX.y + (Y[i] / Q) * PXU - g / 2, g, g);
        }
        ctx.globalCompositeOperation = 'source-over';
      }
      ctx.fillStyle = s ? WARM : ACC;
      ctx.beginPath();
      for (let i = 0; i < N; i++) {
        if (species[i] !== s) continue;
        const x = BOX.x + (X[i] / Q) * PXU, y = BOX.y + (Y[i] / Q) * PXU;
        ctx.moveTo(x + r, y);
        ctx.arc(x, y, r, 0, Math.PI * 2);
      }
      ctx.fill();
    }
    ctx.lineCap = 'butt';
  }

  function drawBox() {
    ctx.fillStyle = `rgba(${ink()},0.025)`;
    ctx.fillRect(BOX.x, BOX.y, BOX.w, BOX.h);
    drawCells();
    drawGas();
    ctx.strokeStyle = `rgba(${ink()},0.32)`;
    ctx.lineWidth = 1.5;
    ctx.strokeRect(BOX.x, BOX.y, BOX.w, BOX.h);
    if (state.wallFade > 0) {
      // the wall slides up out of the box as it is lifted
      const x = BOX.x + BOX.w / 2;
      const top = BOX.y - (1 - state.wallFade) * BOX.h;
      ctx.save();
      ctx.beginPath();
      ctx.rect(BOX.x, BOX.y, BOX.w, BOX.h);
      ctx.clip();
      ctx.fillStyle = `rgba(${ink()},${0.75 * state.wallFade + 0.1})`;
      ctx.fillRect(x - 2, top, 4, BOX.h);
      ctx.restore();
    }
    if (state.hold > performance.now()) {
      const ok = state.back === 'exact';
      const text = ok
        ? 'back at the exact starting state, every particle to the last bit'
        : `missed: off by ${state.backErr.toFixed(2)} box heights on average`;
      ctx.font = '600 14px ui-monospace, monospace';
      const tw = ctx.measureText(text).width;
      const cx = BOX.x + BOX.w / 2, cy = BOX.y + BOX.h / 2;
      ctx.fillStyle = light() ? 'rgba(255,255,255,0.88)' : 'rgba(13,14,18,0.82)';
      ctx.fillRect(cx - tw / 2 - 14, cy - 18, tw + 28, 34);
      ctx.fillStyle = ok ? ACC : WARM;
      ctx.textAlign = 'center';
      ctx.fillText(text, cx, cy + 4);
      ctx.textAlign = 'left';
    }
  }

  function drawTrace() {
    const top = TR.y, bot = TR.y + TR.h;
    label('S / k over time', TR.x, top - 14, 0.55);
    label(`ceiling ${sMax.toFixed(1)}`, TR.x + TR.w, top - 4, 0.45, 'right');
    label(sMax.toFixed(0), TR.x - 8, top + 4, 0.35, 'right');
    ctx.strokeStyle = `rgba(${ink()},0.22)`;
    ctx.setLineDash([4, 4]);
    ctx.beginPath();
    ctx.moveTo(TR.x, top + 0.5);
    ctx.lineTo(TR.x + TR.w, top + 0.5);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.strokeStyle = `rgba(${ink()},0.18)`;
    ctx.beginPath();
    ctx.moveTo(TR.x, bot + 0.5);
    ctx.lineTo(TR.x + TR.w, bot + 0.5);
    ctx.stroke();

    // The axis starts a little under the one-half ceiling, so the climb that
    // matters (N ln 2 for one gas) fills the strip instead of a sliver at the top.
    let lo = sHalf - 0.25 * (sMax - sHalf);
    for (const v of trace) if (v < lo) lo = v;
    lo = Math.max(0, lo);
    label(lo.toFixed(0), TR.x - 8, bot, 0.35, 'right');
    const x0 = frameNo - SPAN;
    const xAt = (f: number) => TR.x + ((f - x0) / SPAN) * TR.w;
    const yAt = (s: number) => bot - Math.max(0, Math.min(1.02, (s - lo) / (sMax - lo || 1))) * TR.h;
    if (sHalf > lo) {
      const y = Math.round(yAt(sHalf)) + 0.5;
      ctx.strokeStyle = `rgba(${ink()},0.16)`;
      ctx.setLineDash([2, 4]);
      ctx.beginPath();
      ctx.moveTo(TR.x, y);
      ctx.lineTo(TR.x + TR.w, y);
      ctx.stroke();
      ctx.setLineDash([]);
      label(state.mode === 'one' ? 'best with all in one half' : 'best while unmixed', TR.x + TR.w, y - 4, 0.4, 'right', 10);
      label(sHalf.toFixed(0), TR.x - 8, y + 4, 0.35, 'right');
    }
    for (const m of marks) {
      if (m.f < x0) continue;
      const x = Math.round(xAt(m.f)) + 0.5;
      const rgb = m.rgb || ink();
      ctx.strokeStyle = `rgba(${rgb},0.45)`;
      ctx.beginPath();
      ctx.moveTo(x, top);
      ctx.lineTo(x, bot);
      ctx.stroke();
      ctx.fillStyle = `rgba(${rgb},0.8)`;
      ctx.font = '10px ui-monospace, monospace';
      ctx.textAlign = x > TR.x + TR.w - 90 ? 'right' : 'left';
      ctx.fillText(m.text, x + (ctx.textAlign === 'right' ? -4 : 4), bot - 5);
      ctx.textAlign = 'left';
    }
    if (trace.length > 1) {
      const start = frameNo - trace.length + 1;
      ctx.beginPath();
      ctx.moveTo(xAt(start), bot);
      for (let i = 0; i < trace.length; i++) ctx.lineTo(xAt(start + i), yAt(trace[i]));
      ctx.lineTo(xAt(frameNo), bot);
      ctx.closePath();
      const g = ctx.createLinearGradient(0, top, 0, bot);
      g.addColorStop(0, 'rgba(124,140,255,0.28)');
      g.addColorStop(1, 'rgba(124,140,255,0.02)');
      ctx.fillStyle = g;
      ctx.fill();
      ctx.strokeStyle = ACC;
      ctx.lineWidth = 2;
      ctx.beginPath();
      for (let i = 0; i < trace.length; i++) {
        const x = xAt(start + i), y = yAt(trace[i]);
        i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
      }
      ctx.stroke();
      ctx.lineWidth = 1;
    }
  }

  let S = 0;
  function draw() {
    ctx.clearRect(0, 0, W, H);
    drawBox();
    drawTrace();
  }

  // --- readouts ------------------------------------------------------------
  const pow10 = (ln: number) => {
    const e = ln / Math.LN10;
    return e < 6 ? Math.round(Math.exp(ln)).toLocaleString() : `10^${e.toFixed(1)}`;
  };
  const texPow10 = (ln: number) => {
    const e = ln / Math.LN10;
    return e < 6 ? String(Math.round(Math.exp(ln))) : `10^{${e.toFixed(1)}}`;
  };
  const setEq = equation();
  const setResult = result();
  const setRows = readout();
  function note() {
    if (state.wall) return state.mode === 'one'
      ? 'The gas is held in the left half. Lift the wall and watch the count.'
      : 'Two gases, one on each side. Lift the wall and they mix.';
    if (state.hold > performance.now() || state.back)
      return state.back === 'exact'
        ? 'Every particle retraced its path exactly. Running the film backwards breaks no law, it just needs every velocity flipped perfectly.'
        : 'One particle was a billionth of the box off. Each collision magnifies such an error, so after a few dozen of them the return is hopeless.';
    if (state.dir < 0) return state.nudged
      ? 'A billionth of the box off, and collisions are amplifying it. Watch whether the gas makes it home.'
      : 'Every velocity flipped: the same laws now replay the past and the gas heads home.';
    return 'Each collision is reversible, yet the gas only spreads: almost every arrangement of the particles looks spread out.';
  }
  function updateText() {
    const [c, r] = CELLS[state.cells];
    const M = c * r;
    const two = state.mode === 'two';
    setEq({
      rule: two
        ? [['S = k\\ln\\Omega', ACC], '\\quad \\Omega = \\Omega_A\\,\\Omega_B,\\;\\; \\Omega_A = \\dfrac{N_A!}{n_1!\\,n_2!\\cdots n_M!}']
        : [['S = k\\ln\\Omega', ACC], '\\quad \\Omega = \\dfrac{N!}{n_1!\\,n_2!\\cdots n_M!}'],
      live: [
        `M = ${M}`,
        `\\quad \\Omega \\approx ${texPow10(S)}`,
        [`\\quad S/k = ${S.toFixed(1)}`, ACC],
        `\\quad \\max = ${sMax.toFixed(1)}`,
      ],
    });
    const pct = (100 * S) / (sMax || 1);
    setResult({
      value: S.toFixed(1),
      status: `${pct.toFixed(0)}% of the ceiling ${sMax.toFixed(1)} · Ω ≈ ${pow10(S)} arrangements · ${M} cells`,
      note: note(),
    });
    setRows({
      'r-omega': pow10(S),
      'r-s': S.toFixed(2),
      'r-max': sMax.toFixed(2),
      'r-t': state.t0 < 0 ? 'wall still in' : String(state.t - state.t0),
      'r-back': state.back === 'exact' ? 'exact, to the bit' : state.back === 'missed' ? `missed by ${state.backErr.toFixed(3)}` : '—',
    });
  }

  // --- loop ----------------------------------------------------------------
  let last = performance.now();
  function advance(n: number) {
    for (let k = 0; k < n; k++) {
      step();
      if (state.hold > performance.now()) break;
    }
  }
  function frame(now: number) {
    const dt = Math.min(0.05, (now - last) / 1000);
    last = now;
    if (!state.wall && state.wallFade > 0) state.wallFade = Math.max(0, state.wallFade - dt * 2.5);
    if (state.running && state.hold <= now) {
      advance(state.speed);
      if (pending && state.t - state.t0 >= pending.at && state.dir > 0) {
        flip(pending.nudge);
        pending = null;
      }
      S = entropy();
      frameNo++;
      trace.push(S);
      if (trace.length > SPAN) trace.shift();
    } else S = entropy();
    draw();
    updateText();
    requestAnimationFrame(frame);
  }

  // --- controls ------------------------------------------------------------
  let pending: { at: number; nudge: boolean } | null = null;
  const tp = transport({
    onRun: (on) => { state.running = on; },
    onStep: () => {
      state.running = false;
      tp.setRunning(false);
      state.hold = 0;
      advance(state.speed);
      S = entropy();
      frameNo++;
      trace.push(S);
      if (trace.length > SPAN) trace.shift();
    },
    onReset: () => { pending = null; build(); },
  });
  el('lift').addEventListener('click', lift);
  el('flip').addEventListener('click', () => { pending = null; flip(false); });
  el('nudge').addEventListener('click', () => { pending = null; flip(true); });

  const legB = el('leg-b');
  const mode = segmented('mode', (v) => {
    state.mode = v;
    legB.hidden = v !== 'two';
    pending = null;
    build();
  });
  legB.hidden = true;
  const setN = slider('np', (v) => { state.N = v; pending = null; build(); });
  const cellText = (v: number) => String(CELLS[v][0] * CELLS[v][1]);
  const setCells = slider('cells', (v) => {
    state.cells = v;
    cellsChanged();
    trace.length = 0;
  }, cellText);
  const setSpeed = slider('spd', (v) => { state.speed = v; }, (v) => `${v} steps / frame`);
  check('grid', (on) => { state.grid = on; });

  /** Start over, lift the wall, and optionally flip after `flipAt` steps. */
  function scene(o: { N?: number; cells?: number; speed?: number; mode?: string; flipAt?: number; nudge?: boolean }) {
    state.mode = o.mode ?? 'one';
    mode.select(state.mode);
    legB.hidden = state.mode !== 'two';
    state.N = o.N ?? 240;
    setN(state.N);
    state.cells = o.cells ?? 2;
    setCells(state.cells);
    state.speed = o.speed ?? 10;
    setSpeed(state.speed);
    build();
    lift();
    pending = o.flipAt ? { at: o.flipAt, nudge: !!o.nudge } : null;
    state.running = true;
    tp.setRunning(true);
  }
  tries({
    lift: () => scene({}),
    flip: () => scene({ flipAt: 2400 }),
    nudge: () => scene({ flipAt: 2400, nudge: true }),
    few: () => scene({ N: 6, cells: 0, speed: 30 }),
  });

  build();
  requestAnimationFrame(frame);
</script>
