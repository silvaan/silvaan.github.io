---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SimCard from '../../components/SimCard.astro';
import TrailCard from '../../components/TrailCard.astro';
import AreaIcon from '../../components/AreaIcon.astro';
import { AREAS } from '../../data/tools';
import { SIMS, TRAILS, areaColor } from '../../data/explore';

export function getStaticPaths() {
  return AREAS.map((area) => ({
    params: { area: area.slug },
    props: { area },
  }));
}

const { area } = Astro.props;
const sims = SIMS.filter((s) => s.area.slug === area.slug);
const trails = TRAILS.filter((t) => t.steps.some((k) => k.startsWith(area.slug + '/')));
---

<BaseLayout title={area.title} description={area.description} wide image={sims.find((s) => s.og)?.og}>
  <div class="breadcrumb">
    <a href="/simulations">Simulations</a>
    <span>/</span>
    <span>{area.title}</span>
  </div>

  <div class="page-head area-page-head" style={`--area:${areaColor(area.slug)}`}>
    <AreaIcon area={area} size={48} />
    <div>
      <h1>{area.title}</h1>
      <p class="lead">{area.description} {sims.length} simulations.</p>
    </div>
  </div>

  <div class="sim-grid">
    {sims.map((s) => <SimCard sim={s} />)}
  </div>

  {
    trails.length > 0 && (
      <section class="area-section">
        <header class="area-section-head">
          <div>
            <h2>Paths through {area.title.toLowerCase()}</h2>
          </div>
        </header>
        <div class="trail-grid">
          {trails.map((t) => (
            <TrailCard trail={t} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
