---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SimCard from '../../components/SimCard.astro';
import TrailCard from '../../components/TrailCard.astro';
import AreaIcon from '../../components/AreaIcon.astro';
import { AREAS } from '../../data/tools';
import { SIMS, TRAILS, areaColor } from '../../data/explore';

const inArea = (slug: string) => SIMS.filter((s) => s.area.slug === slug);
---

<BaseLayout
  title="Simulations"
  description={`${SIMS.length} interactive simulations across ${AREAS.length} areas, from calculus and linear algebra to deep learning, physics, biology and cosmology.`}
  wide
>
  <div class="page-head">
    <h1>Simulations</h1>
    <p class="lead">
      {SIMS.length} interactive simulations across {AREAS.length} areas. Everything
      runs live in the browser: drag, tune and watch the maths move.
    </p>
  </div>

  <nav class="area-filter" aria-label="Filter by area">
    <button type="button" data-filter="" aria-pressed="true">All <span>{SIMS.length}</span></button>
    {
      AREAS.map((a) => (
        <button type="button" data-filter={a.slug} aria-pressed="false" style={`--area:${areaColor(a.slug)}`}>
          <i />
          {a.title} <span>{inArea(a.slug).length}</span>
        </button>
      ))
    }
    <button type="button" data-filter="paths" aria-pressed="false">Paths <span>{TRAILS.length}</span></button>
  </nav>

  {
    AREAS.map((a) => (
      <section class="area-section" id={a.slug} data-area={a.slug} style={`--area:${areaColor(a.slug)}`}>
        <header class="area-section-head">
          <AreaIcon area={a} />
          <div>
            <h2>
              <a href={`/simulations/${a.slug}`}>{a.title}</a>
            </h2>
            <p>{a.description}</p>
          </div>
        </header>
        <div class="sim-grid">
          {inArea(a.slug).map((s) => (
            <SimCard sim={s} />
          ))}
        </div>
      </section>
    ))
  }

  <section class="area-section" id="paths" data-area="paths">
    <header class="area-section-head">
      <div>
        <h2>Paths</h2>
        <p>Sims in an order where each one sets up the next, often across areas.</p>
      </div>
    </header>
    <div class="trail-grid">
      {TRAILS.map((t) => <TrailCard trail={t} />)}
    </div>
  </section>
</BaseLayout>

<script>
  // The chips filter the page; the hash keeps the choice so it can be linked.
  const nav = document.querySelector<HTMLElement>('.area-filter')!;
  const buttons = Array.from(nav.querySelectorAll<HTMLButtonElement>('button'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('.area-section'));
  const known = new Set(sections.map((s) => s.dataset.area));

  function apply(slug: string, scroll = false) {
    if (!known.has(slug)) slug = '';
    for (const b of buttons) b.setAttribute('aria-pressed', String((b.dataset.filter ?? '') === slug));
    for (const s of sections) s.hidden = !!slug && s.dataset.area !== slug;
    if (scroll) nav.scrollIntoView({ block: 'start' });
  }

  function fromHash() {
    const h = decodeURIComponent(location.hash.slice(1));
    // a link to one path opens the paths view on that card
    if (h.startsWith('path-')) {
      apply('paths');
      document.getElementById(h)?.scrollIntoView({ block: 'center' });
    } else apply(h);
  }

  for (const b of buttons)
    b.addEventListener('click', () => {
      const slug = b.dataset.filter ?? '';
      history.replaceState(null, '', slug ? `#${slug}` : location.pathname);
      apply(slug, true);
    });
  window.addEventListener('hashchange', fromHash);
  fromHash();
</script>
