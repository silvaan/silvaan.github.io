---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AREAS } from '../../data/tools';
---

<BaseLayout
  title="Simulations"
  description="Interactive math simulations grouped by area: calculus, linear algebra, deep learning, statistics and physics."
  wide
>
  <div class="page-head">
    <span class="eyebrow">Playground</span>
    <h1>Simulations</h1>
    <p class="lead">
      Interactive simulations, grouped by area. Everything runs live in the
      browser, drag, tune and watch the maths move.
    </p>
  </div>

  {
    AREAS.map((area) => (
      <section class="area-block">
        <div class="area-head">
          <span class="area-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d={area.icon} />
            </svg>
          </span>
          <div>
            <h2><a href={`/simulations/${area.slug}`}>{area.title}</a></h2>
            <p>{area.description}</p>
          </div>
        </div>

        <div class="card-grid">
          {area.simulators.map((sim) =>
            sim.status === 'soon' ? (
              <div class="card" style="opacity:.6">
                <h3>{sim.title}</h3>
                <p>{sim.description}</p>
                <div class="card-foot">
                  <span class="badge-soon">coming soon</span>
                </div>
              </div>
            ) : (
              <a class="card" href={sim.href}>
                <h3>{sim.title}</h3>
                <p>{sim.description}</p>
                <div class="card-foot">
                  <span>Open simulator</span>
                  <span class="arrow">→</span>
                </div>
              </a>
            )
          )}
        </div>
      </section>
    ))
  }
</BaseLayout>

<style>
  .area-block {
    margin-top: 44px;
  }
  .area-head {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 18px;
  }
  .area-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .area-icon svg {
    width: 22px;
    height: 22px;
  }
  .area-head h2 {
    margin: 0;
    font-size: 1.25rem;
  }
  .area-head h2 a {
    color: var(--text);
  }
  .area-head h2 a:hover {
    color: var(--accent);
  }
  .area-head p {
    margin: 3px 0 0;
    font-size: 0.92rem;
    color: var(--text-muted);
  }
</style>
