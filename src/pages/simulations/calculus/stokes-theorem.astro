---
import SimLayout from '../../../layouts/SimLayout.astro';
---

<SimLayout
  areaSlug="calculus"
  title="Stokes' Theorem"
  description="Tile a surface in space with tiny loops and add up the spin of each one. Every interior edge is shared by two loops that walk it in opposite directions, so it cancels, and the whole sum falls onto the single curve around the edge. Then bend the surface: the answer refuses to change."
>
  <div class="sim">
    <div class="sim-stage">
      <canvas id="stokes" class="s-canvas" width="1000" height="900"></canvas>
    </div>

    <div class="sim-panel">
      <div class="control">
        <label>Field</label>
        <div class="seg" id="field">
          <button data-f="rot" class="active">Rotation</button>
          <button data-f="shear">Shear</button>
          <button data-f="source">Source</button>
          <button data-f="eddy">Eddy</button>
        </div>
      </div>

      <div class="control">
        <label>Surface (same boundary)</label>
        <div class="seg" id="surf">
          <button data-s="flat" class="active">Flat disc</button>
          <button data-s="dome">Dome</button>
          <button data-s="bowl">Bowl</button>
        </div>
      </div>

      <div class="control">
        <label>Mesh <b id="nval">6</b></label>
        <input type="range" id="n" min="1" max="12" step="1" value="6" />
        <div class="scale-hint"><span>one big loop</span><span>many tiny ones</span></div>
      </div>

      <div class="control">
        <label>Boundary radius <b id="aval">1.20</b></label>
        <input type="range" id="size" min="50" max="170" step="2" value="120" />
      </div>

      <label class="check"><input type="checkbox" id="cancel" checked /> Show the cancelling edges</label>
      <label class="check"><input type="checkbox" id="fieldarr" checked /> Show the field</label>

      <div class="readout">
        <div class="row"><span id="l1">Circulation round the edge</span><b id="r1">—</b></div>
        <div class="row"><span id="l2">Curl flux through surface</span><b id="r2">—</b></div>
        <div class="row"><span id="l3">Patches</span><b id="r3">—</b></div>
        <div class="row"><span id="l4">Probe: circulation</span><b id="r4">—</b></div>
        <div class="row"><span id="l5">Probe: curl·n</span><b id="r5">—</b></div>
      </div>

      <p style="font-size:.82rem;color:var(--text-faint);margin:0;line-height:1.5">
        Drag to orbit. <b>Click any patch</b> to make it the probe. Both integrals
        are computed by brute force from the field, never assumed equal.
      </p>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Click one patch and look at the enlarged loop. Walk its rim and ask on each
      edge whether the field pushes you forward (green) or holds you back (red).
      The four answers added together are that patch's circulation, and divided
      by its area they are <b>curl·n</b>: the spin the field has about that
      patch's own normal.
    </li>
    <li>
      Only the component of the curl <b>along the normal</b> counts. Tilt the
      surface with the Dome or Bowl and watch a patch's number change even
      though the field did not. A paddle wheel only spins about its own axle.
    </li>
    <li>
      Now the picture that is the proof. Every interior edge belongs to two
      neighbouring patches, and they walk it in opposite directions, so it is
      added once and subtracted once. <b>Every interior edge dies.</b> What is
      left over is the one curve with no patch on its far side: the boundary.
    </li>
    <li>
      Raise the <b>Mesh</b> and watch the readout. Hundreds of tiny circulations
      keep summing to the same single walk around the edge. That collapse is the
      whole content of the theorem.
    </li>
    <li>
      Here is the punchline. Switch between <b>Flat disc</b>, <b>Dome</b> and
      <b>Bowl</b>. These are wildly different surfaces with wildly different
      patches, yet the circulation number does not move at all, because all three
      share the same rim. <b>Stokes' theorem does not care what you stretch
      across the loop</b>, only what the loop is.
    </li>
    <li>
      Choose <b>Source</b>. The flow blasts outward, but nothing anywhere is
      spinning, so every patch reads zero and so does the walk around the edge.
      Spreading is not spinning, and curl is blind to it.
    </li>
    <li>
      Choose <b>Eddy</b>, where the spin is concentrated near the middle. Now the
      patches disagree loudly with one another, and only their sum matches the
      boundary walk. Then bend the surface again: the patches all change, and the
      total still refuses to.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText, subHtml } from '../../../lib/sim';

  // ---------------------------------------------------------------------------
  // Stokes' theorem, computed rather than asserted. The boundary integral is
  // walked numerically round the rim curve; the surface side sums (∇×F)·n dA
  // over every patch of a parametrised surface. Nothing forces them to agree.
  // ---------------------------------------------------------------------------

  type V = { x: number; y: number; z: number };
  const v = (x: number, y: number, z: number): V => ({ x, y, z });
  const add = (a: V, b: V): V => v(a.x + b.x, a.y + b.y, a.z + b.z);
  const sub = (a: V, b: V): V => v(a.x - b.x, a.y - b.y, a.z - b.z);
  const mul = (a: V, s: number): V => v(a.x * s, a.y * s, a.z * s);
  const dot = (a: V, b: V) => a.x * b.x + a.y * b.y + a.z * b.z;
  const cross = (a: V, b: V): V =>
    v(a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x);
  const len = (a: V) => Math.hypot(a.x, a.y, a.z);

  type Field = 'rot' | 'shear' | 'source' | 'eddy';
  type Surf = 'flat' | 'dome' | 'bowl';

  const state = {
    field: 'rot' as Field,
    surf: 'flat' as Surf,
    n: 6,
    a: 1.2, // boundary radius
    showCancel: true,
    showField: true,
    yaw: 0.7,
    pitch: 0.5,
    sel: -1,
  };

  function fieldAt(p: V): V {
    switch (state.field) {
      case 'rot': return v(-p.y * 0.8, p.x * 0.8, 0);
      case 'shear': return v(p.z * 0.9, 0, p.x * 0.2);
      case 'source': return mul(p, 0.7);
      case 'eddy': {
        const e = Math.exp(-(p.x * p.x + p.y * p.y) * 0.8);
        return v(-p.y * 2.2 * e, p.x * 2.2 * e, 0);
      }
    }
  }

  function curlAt(p: V): V {
    const h = 1e-3;
    const d = (f: (q: V) => number, ax: 'x' | 'y' | 'z') => {
      const a = v(p.x, p.y, p.z), b = v(p.x, p.y, p.z);
      a[ax] += h; b[ax] -= h;
      return (f(a) - f(b)) / (2 * h);
    };
    const Fx = (q: V) => fieldAt(q).x, Fy = (q: V) => fieldAt(q).y, Fz = (q: V) => fieldAt(q).z;
    return v(
      d(Fz, 'y') - d(Fy, 'z'),
      d(Fx, 'z') - d(Fz, 'x'),
      d(Fy, 'x') - d(Fx, 'y')
    );
  }

  /**
   * The surface, over the unit disc in polar coordinates. All three share the
   * identical rim at r = 1, which is the entire point of the exercise.
   */
  function surfPoint(r: number, th: number): V {
    const R = state.a;
    const x = R * r * Math.cos(th), y = R * r * Math.sin(th);
    let z = 0;
    if (state.surf === 'dome') z = 0.95 * R * (1 - r * r);
    else if (state.surf === 'bowl') z = -0.95 * R * (1 - r * r);
    return v(x, y, z);
  }
  /** Outward-ish normal times the local area element, from the parametrisation. */
  function surfNormalArea(r: number, th: number, dr: number, dth: number): { n: V; dA: number } {
    const e = 1e-4;
    const pr = mul(sub(surfPoint(r + e, th), surfPoint(r - e, th)), 1 / (2 * e));
    const pt = mul(sub(surfPoint(r, th + e), surfPoint(r, th - e)), 1 / (2 * e));
    const c = cross(pr, pt); // right-handed with the anticlockwise rim
    const mag = len(c);
    return { n: mag > 1e-12 ? mul(c, 1 / mag) : v(0, 0, 1), dA: mag * dr * dth };
  }

  /** The rim curve, shared by every surface. */
  const rimPoint = (th: number) => surfPoint(1, th);

  function rimCirculation(m = 720): number {
    let total = 0;
    for (let i = 0; i < m; i++) {
      const t0 = (i / m) * Math.PI * 2, t1 = ((i + 1) / m) * Math.PI * 2;
      const A = rimPoint(t0), B = rimPoint(t1);
      const mid = mul(add(A, B), 0.5);
      total += dot(fieldAt(mid), sub(B, A));
    }
    return total;
  }

  /** Circulation round the rim of one patch, walked anticlockwise in (r, th). */
  function patchEdges(r0: number, r1: number, t0: number, t1: number): [V, V][] {
    const A = surfPoint(r0, t0), B = surfPoint(r1, t0);
    const C = surfPoint(r1, t1), D = surfPoint(r0, t1);
    return [[A, B], [B, C], [C, D], [D, A]];
  }
  function edgeWork(a: V, b: V, m = 6): number {
    let s = 0;
    for (let i = 0; i < m; i++) {
      const p = add(a, mul(sub(b, a), (i + 0.5) / m));
      s += dot(fieldAt(p), mul(sub(b, a), 1 / m));
    }
    return s;
  }

  // --- patches, cached ---------------------------------------------------------

  type Patch = { c: V; n: V; dA: number; cn: number; flux: number; r0: number; r1: number; t0: number; t1: number };
  let patches: Patch[] = [];
  let rimCirc = 0;
  let curlFlux = 0;
  let convergence: number[] = []; // mismatch, as a fraction of the total absolute spin
  let absScale = 1;
  let dirty = true;

  function buildPatches(N: number): { list: Patch[]; sum: number; abs: number } {
    const list: Patch[] = [];
    let sum = 0;
    let abs = 0;
    const NT = Math.max(3, N * 3); // angular divisions
    for (let i = 0; i < N; i++)
      for (let j = 0; j < NT; j++) {
        const r0 = i / N, r1 = (i + 1) / N;
        const t0 = (j / NT) * Math.PI * 2, t1 = ((j + 1) / NT) * Math.PI * 2;
        const rm = (r0 + r1) / 2, tm = (t0 + t1) / 2;
        const { n, dA } = surfNormalArea(rm, tm, r1 - r0, t1 - t0);
        const c = surfPoint(rm, tm);
        const cn = dot(curlAt(c), n);
        list.push({ c, n, dA, cn, flux: cn * dA, r0, r1, t0, t1 });
        sum += cn * dA;
        abs += Math.abs(cn) * dA;
      }
    return { list, sum, abs };
  }

  function rebuild() {
    const built = buildPatches(state.n);
    patches = built.list;
    curlFlux = built.sum;
    rimCirc = rimCirculation();
    // A plain ratio is useless here: patches spinning opposite ways can cancel
    // until the true total is nearly zero, and dividing by that explodes even
    // when both sides agree perfectly. Measure the mismatch against the total
    // *absolute* spin instead, which never vanishes for a field that does
    // anything at all.
    absScale = Math.max(buildPatches(14).abs, 1e-9);
    convergence = [];
    for (let N = 1; N <= 12; N++) {
      const s = buildPatches(N).sum;
      convergence.push(Math.abs(s - rimCirc) / absScale);
    }
    if (state.sel >= patches.length) state.sel = -1;
    if (state.sel < 0 && patches.length) {
      // open on an off-centre patch, where the tilt and the spin both show
      let best = 0, bd = Infinity;
      patches.forEach((q, i) => {
        const d = (q.c.x - state.a * 0.55) ** 2 + q.c.y ** 2;
        if (d < bd) { bd = d; best = i; }
      });
      state.sel = best;
    }
    dirty = false;
  }
  const probePatch = () => (state.sel >= 0 && state.sel < patches.length ? patches[state.sel] : null);

  // --- canvas -------------------------------------------------------------------

  const canvas = document.getElementById('stokes') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const cssVar = (n: string) => getComputedStyle(canvas).getPropertyValue(n).trim();
  const inkRGB = () => cssVar('--stage-ink') || '232,233,236';
  const inkA = (al: number) => `rgba(${inkRGB()},${al})`;
  const { label } = makeText(ctx, inkA);

  const WITH = '#34d399';
  const AGAINST = '#ff7a5c';
  const ACC = '#7c8cff';
  const WARN = '#f59e0b';
  const DIM = '#8a8f9c';

  // Shared by all three theorem simulators, so they read as one family.
  const SCENE = { x: 20, y: 84, w: 640, h: 600 };
  const PROBE = { x: 676, y: 84, w: 304, h: 300 };
  const CANCEL = { x: 676, y: 404, w: 304, h: 280 };
  const SUM = { x: 20, y: 704, w: 960, h: 176 };

  function rr(x: number, y: number, w: number, h: number, r: number) {
    const rad = Math.min(r, Math.abs(w) / 2, Math.abs(h) / 2);
    ctx.beginPath();
    ctx.moveTo(x + rad, y);
    ctx.arcTo(x + w, y, x + w, y + h, rad);
    ctx.arcTo(x + w, y + h, x, y + h, rad);
    ctx.arcTo(x, y + h, x, y, rad);
    ctx.arcTo(x, y, x + w, y, rad);
    ctx.closePath();
  }
  function panel(pn: { x: number; y: number; w: number; h: number }, title: string) {
    ctx.strokeStyle = inkA(0.1);
    ctx.lineWidth = 1;
    rr(pn.x, pn.y, pn.w, pn.h, 10);
    ctx.stroke();
    label(title, pn.x + 2, pn.y - 9, 0.5, 'left', 11);
  }

  /**
   * Everything a panel draws stays inside that panel. Without this, a large
   * region or a long arrow simply spills across its neighbours.
   */
  function clipped(pn: { x: number; y: number; w: number; h: number }, fn: () => void) {
    ctx.save();
    rr(pn.x + 1, pn.y + 1, pn.w - 2, pn.h - 2, 10);
    ctx.clip();
    fn();
    ctx.restore();
  }

  type View = { cx: number; cy: number; scale: number };
  const CAM = 16, FOCAL = 12;
  function proj(p: V, view: View) {
    const cy = Math.cos(state.yaw), sy = Math.sin(state.yaw);
    const xr = p.x * cy + p.y * sy;
    const yr = -p.x * sy + p.y * cy;
    const cp = Math.cos(state.pitch), sp = Math.sin(state.pitch);
    const depth = p.z * sp + yr * cp + CAM;
    const k = FOCAL / Math.max(0.4, depth);
    return {
      x: view.cx + xr * k * view.scale,
      y: view.cy + (-p.z * cp + yr * sp) * k * view.scale,
      d: depth,
    };
  }
  // The boundary radius more than triples across its slider, so the view
  // reframes to fit rather than overflowing into the neighbouring panels.
  const FIT = (half: number, reach: number) => (half - 34) / (reach * (FOCAL / CAM));
  const sceneView = (): View => ({
    cx: SCENE.x + SCENE.w / 2,
    cy: SCENE.y + SCENE.h / 2 + 6,
    // Fixed at 1.4a: the dome's apex reaches √(a² + (0.95a)²) ≈ 1.38a, and
    // holding the same reach for all three surfaces keeps the framing steady
    // when you switch between them, which is the whole comparison.
    scale: FIT(Math.min(SCENE.w, SCENE.h) / 2, state.a * 1.4),
  });

  function line3(a: V, b: V, view: View, col: string, lw: number) {
    const p = proj(a, view), q = proj(b, view);
    ctx.strokeStyle = col;
    ctx.lineWidth = lw;
    ctx.beginPath();
    ctx.moveTo(p.x, p.y);
    ctx.lineTo(q.x, q.y);
    ctx.stroke();
  }
  function arrow3(from: V, to: V, view: View, col: string, lw = 2, head = 7) {
    const p = proj(from, view), q = proj(to, view);
    ctx.strokeStyle = col;
    ctx.fillStyle = col;
    ctx.lineWidth = lw;
    ctx.beginPath();
    ctx.moveTo(p.x, p.y);
    ctx.lineTo(q.x, q.y);
    ctx.stroke();
    const a = Math.atan2(q.y - p.y, q.x - p.x);
    ctx.beginPath();
    ctx.moveTo(q.x, q.y);
    ctx.lineTo(q.x - head * Math.cos(a - 0.4), q.y - head * Math.sin(a - 0.4));
    ctx.lineTo(q.x - head * Math.cos(a + 0.4), q.y - head * Math.sin(a + 0.4));
    ctx.closePath();
    ctx.fill();
  }
  /** An arrow sitting at the middle of an edge, showing which way it is walked. */
  function edgeArrow3(a: V, b: V, view: View, col: string, lw: number, frac = 0.5) {
    const mid = mul(add(a, b), 0.5);
    const d = mul(sub(b, a), frac / 2);
    arrow3(sub(mid, d), add(mid, d), view, col, lw, lw * 3);
  }

  // --- the scene ------------------------------------------------------------------

  function drawScene() {
    panel(SCENE, 'THE SURFACE, TILED WITH LITTLE LOOPS');
    const view = sceneView();

    clipped(SCENE, () => {

    if (state.showField) {
      const items: { p: V; f: V; d: number }[] = [];
      const R = state.a * 1.5;
      for (let i = 0; i < 5; i++)
        for (let j = 0; j < 5; j++)
          for (let k = 0; k < 4; k++) {
            const p = v(
              -R + (2 * R * i) / 4,
              -R + (2 * R * j) / 4,
              -R * 0.8 + (1.6 * R * k) / 3
            );
            items.push({ p, f: fieldAt(p), d: proj(p, view).d });
          }
      items.sort((x, y) => y.d - x.d);
      const maxF = Math.max(...items.map((i) => len(i.f)), 1e-6);
      for (const it of items) {
        const L = len(it.f);
        if (L < 1e-6) continue;
        const reach = (R * 0.24 * L) / maxF;
        arrow3(it.p, add(it.p, mul(it.f, reach / L)), view, inkA(0.16), 1.2, 4);
      }
    }

    // the patches, painted by their own curl·n and drawn far to near
    const ref = Math.max(...patches.map((p) => Math.abs(p.cn)), 1e-6);
    const order = patches
      .map((p, i) => ({ i, d: proj(p.c, view).d }))
      .sort((a, b) => b.d - a.d);
    for (const { i } of order) {
      const p = patches[i];
      const quad = [
        surfPoint(p.r0, p.t0), surfPoint(p.r1, p.t0),
        surfPoint(p.r1, p.t1), surfPoint(p.r0, p.t1),
      ];
      ctx.beginPath();
      quad.forEach((q, k) => {
        const s = proj(q, view);
        k ? ctx.lineTo(s.x, s.y) : ctx.moveTo(s.x, s.y);
      });
      ctx.closePath();
      const t = Math.max(-1, Math.min(1, p.cn / ref));
      ctx.fillStyle = t >= 0
        ? `rgba(52,211,153,${0.08 + Math.abs(t) * 0.3})`
        : `rgba(255,122,92,${0.08 + Math.abs(t) * 0.3})`;
      ctx.fill();
      ctx.strokeStyle = inkA(0.12);
      ctx.lineWidth = 1;
      ctx.stroke();

      if (state.showCancel && state.n > 1 && p.r1 < 0.999) {
        // the outer edge of this patch is shared with the ring beyond it
        const A = surfPoint(p.r1, p.t0), B = surfPoint(p.r1, p.t1);
        edgeArrow3(A, B, view, 'rgba(124,140,255,0.5)', 1.1, 0.5);
        edgeArrow3(B, A, view, 'rgba(255,122,92,0.5)', 1.1, 0.5);
      }

      if (i === state.sel) {
        ctx.strokeStyle = WARN;
        ctx.lineWidth = 2.6;
        ctx.stroke();
        const nb = add(p.c, mul(p.n, state.a * 0.4));
        arrow3(p.c, nb, view, WARN, 2, 7);
      }
    }

    // the boundary: the survivor, coloured by whether the field helps or fights
    const M = 72;
    for (let i = 0; i < M; i++) {
      const A = rimPoint((i / M) * Math.PI * 2);
      const B = rimPoint(((i + 1) / M) * Math.PI * 2);
      const w = edgeWork(A, B, 2);
      line3(A, B, view, w >= 0 ? WITH : AGAINST, 4);
    }
    for (let i = 0; i < 8; i++) {
      const t = (i / 8) * Math.PI * 2;
      const A = rimPoint(t), B = rimPoint(t + 0.12);
      const w = edgeWork(A, B, 2);
      arrow3(A, B, view, w >= 0 ? WITH : AGAINST, 4, 10);
    }
    });

    label('drag to orbit · click a patch', SCENE.x + 10, SCENE.y + SCENE.h - 14, 0.4, 'left', 11);
    label(`${patches.length} patches`, SCENE.x + SCENE.w - 10, SCENE.y + 22, 0.7, 'right', 12, ACC);
    label('bold rim = the survivor', SCENE.x + 10, SCENE.y + 22, 0.55, 'left', 11, WITH);
  }

  // --- the probe patch --------------------------------------------------------------

  function drawProbe() {
    panel(PROBE, 'ONE PATCH, ENLARGED');
    const p = probePatch();
    if (!p) {
      label('click a patch in the scene', PROBE.x + PROBE.w / 2, PROBE.y + PROBE.h / 2, 0.5, 'center', 12, DIM);
      return;
    }
    // Re-centre the patch at the origin and blow it up, keeping its orientation
    // so the tilt of the normal stays honest.
    const edges = patchEdges(p.r0, p.r1, p.t0, p.t1);
    const works = edges.map(([a, b]) => edgeWork(a, b, 8));
    const scaleUp = (state.a * 0.9) / Math.max(...edges.map(([a]) => len(sub(a, p.c))), 1e-6);
    const localPt = (q: V) => mul(sub(q, p.c), scaleUp);
    const view: View = { cx: PROBE.x + PROBE.w / 2, cy: PROBE.y + 120, scale: 120 };

    clipped(PROBE, () => {

    // the field around the patch
    for (const [a, b] of edges) {
      const q = mul(add(a, b), 0.5);
      const f = fieldAt(q);
      const L = len(f) || 1;
      const at = localPt(q);
      arrow3(at, add(at, mul(f, (state.a * 0.5) / L)), view, inkA(0.22), 1.2, 5);
    }

    edges.forEach(([a, b], i) => {
      const col = works[i] >= 0 ? WITH : AGAINST;
      line3(localPt(a), localPt(b), view, col, 3.4);
      edgeArrow3(localPt(a), localPt(b), view, col, 3, 0.5);
    });
    // the normal it is measured about
    arrow3(v(0, 0, 0), mul(p.n, state.a * 0.75), view, WARN, 2.4, 8);
    });

    const circ = works.reduce((s, x) => s + x, 0);
    let y = PROBE.y + 224;
    label(`∮ round this patch = ${circ >= 0 ? '+' : ''}${circ.toFixed(4)}`, PROBE.x + 16, y, 0.7, 'left', 11, circ >= 0 ? WITH : AGAINST);
    y += 17;
    label(`÷ area ${p.dA.toFixed(4)}`, PROBE.x + 16, y, 0.45, 'left', 10);
    y += 20;
    label(`curl·n = ${p.cn.toFixed(3)}`, PROBE.x + 16, y, 0.9, 'left', 14, WARN);
    y += 20;
    label(`n = (${p.n.x.toFixed(2)}, ${p.n.y.toFixed(2)}, ${p.n.z.toFixed(2)})`, PROBE.x + 16, y, 0.45, 'left', 10, WARN);
  }

  // --- why the interior cancels ---------------------------------------------------------

  function drawCancel() {
    panel(CANCEL, 'WHY ONLY THE RIM SURVIVES');
    const view: View = { cx: CANCEL.x + CANCEL.w / 2, cy: CANCEL.y + 84, scale: 94 };
    const u = 0.55;

    clipped(CANCEL, () => {
    // two patches meeting along a shared edge, drawn flat for clarity
    const quads: [V[], string][] = [
      [[v(-2 * u, -u, 0), v(0, -u, 0), v(0, u, 0), v(-2 * u, u, 0)], 'rgba(124,140,255,0.12)'],
      [[v(0, -u, 0), v(2 * u, -u, 0), v(2 * u, u, 0), v(0, u, 0)], 'rgba(255,122,92,0.12)'],
    ];
    for (const [q, fill] of quads) {
      ctx.beginPath();
      q.forEach((pt, i) => {
        const s = proj(pt, view);
        i ? ctx.lineTo(s.x, s.y) : ctx.moveTo(s.x, s.y);
      });
      ctx.closePath();
      ctx.fillStyle = fill;
      ctx.fill();
      ctx.strokeStyle = inkA(0.3);
      ctx.lineWidth = 1.4;
      ctx.stroke();
    }
    line3(v(0, -u, 0), v(0, u, 0), view, WARN, 3);
    edgeArrow3(v(-0.05, -u * 0.85, 0.02), v(-0.05, u * 0.85, 0.02), view, ACC, 2.4, 0.85);
    edgeArrow3(v(0.05, u * 0.85, 0.02), v(0.05, -u * 0.85, 0.02), view, AGAINST, 2.4, 0.85);
    });

    let y = CANCEL.y + 164;
    label('one patch walks this edge one way', CANCEL.x + 16, y, 0.75, 'left', 11, ACC);
    y += 16;
    label('its neighbour walks it back', CANCEL.x + 16, y, 0.75, 'left', 11, AGAINST);
    y += 22;
    label('Added once, subtracted once, gone.', CANCEL.x + 16, y, 0.5, 'left', 10);
    y += 14;
    label('Every interior edge cancels in pairs,', CANCEL.x + 16, y, 0.5, 'left', 10);
    y += 14;
    label('so the entire sum falls onto the one', CANCEL.x + 16, y, 0.5, 'left', 10);
    y += 14;
    label('curve with no neighbour: the boundary.', CANCEL.x + 16, y, 0.5, 'left', 10);
    y += 20;
    label('This is why the surface may be anything', CANCEL.x + 16, y, 0.5, 'left', 10, WARN);
    y += 14;
    label('at all, as long as the rim is the same.', CANCEL.x + 16, y, 0.5, 'left', 10, WARN);
  }

  // --- the two sides ----------------------------------------------------------------------

  function drawSum() {
    panel(SUM, 'THE SUM OF ALL THE PATCHES, AND THE ONE WALK ROUND THE EDGE');
    const zero = Math.abs(rimCirc) < 1e-6 && Math.abs(curlFlux) < 1e-6;
    const x0 = SUM.x + 24;
    const y = SUM.y + 34;

    label('∮ F·dr   round the boundary', x0, y, 0.6, 'left', 12, WITH);
    label(rimCirc.toFixed(4), x0, y + 30, 0.95, 'left', 22, WITH);
    label('the same rim for all three surfaces', x0, y + 52, 0.4, 'left', 10);

    const x1 = SUM.x + 350;
    label(`∬ (∇×F)·n dA   over ${patches.length} patches`, x1, y, 0.6, 'left', 12, ACC);
    label(curlFlux.toFixed(4), x1, y + 30, 0.95, 'left', 22, ACC);
    const names: Record<Surf, string> = { flat: 'a flat disc', dome: 'a dome', bowl: 'a bowl' };
    label(`across ${names[state.surf]}`, x1, y + 52, 0.4, 'left', 10);

    const gx = SUM.x + 700, gw = 250, gy = SUM.y + 34, gh = 92;
    const hi = Math.max(1e-6, Math.max(...convergence) * 1.1);
    const Y = (e: number) => gy + gh - (Math.min(hi, e) / hi) * gh;
    ctx.strokeStyle = inkA(0.18);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(gx, gy);
    ctx.lineTo(gx, gy + gh);
    ctx.lineTo(gx + gw, gy + gh);
    ctx.stroke();
    ctx.strokeStyle = WITH;
    ctx.setLineDash([4, 4]);
    ctx.beginPath();
    ctx.moveTo(gx, Y(0));
    ctx.lineTo(gx + gw, Y(0));
    ctx.stroke();
    ctx.setLineDash([]);
    {
      ctx.strokeStyle = ACC;
      ctx.lineWidth = 2;
      ctx.beginPath();
      convergence.forEach((r, i) => {
        const x = gx + (i / (convergence.length - 1)) * gw;
        i ? ctx.lineTo(x, Y(r)) : ctx.moveTo(x, Y(r));
      });
      ctx.stroke();
      const i = state.n - 1;
      ctx.fillStyle = WARN;
      ctx.beginPath();
      ctx.arc(gx + (i / (convergence.length - 1)) * gw, Y(convergence[i]), 4.5, 0, Math.PI * 2);
      ctx.fill();
    }
    label('mismatch', gx, gy - 6, 0.5, 'left', 10, ACC);
    label('0', gx - 6, Y(0) + 3, 0.5, 'right', 9, WITH);
    label('mesh  1 → 12', gx, gy + gh + 15, 0.4, 'left', 10);

    if (zero)
      label('both are zero: nothing here is spinning', x0, SUM.y + SUM.h - 16, 0.6, 'left', 12, WITH);
    else {
      const err = (Math.abs(curlFlux - rimCirc) / absScale) * 100;
      label(
        `they differ by ${err < 0.05 ? 'less than 0.1' : err.toFixed(1)}% of the total spin, and bending the surface moves neither one`,
        x0, SUM.y + SUM.h - 16, 0.6, 'left', 12, WITH
      );
    }
  }

  // --- readouts ---------------------------------------------------------------------------

  const el = (id: string) => document.getElementById(id) as HTMLElement;
  const setRow = (n: number, lab: string, val: string, col?: string) => {
    el('l' + n).innerHTML = subHtml(lab);
    const b = el('r' + n);
    b.textContent = val;
    if (col) b.style.color = col;
    else b.style.removeProperty('color');
  };
  function updateReadout() {
    const p = probePatch();
    setRow(1, 'Circulation round the edge', rimCirc.toFixed(4), WITH);
    setRow(2, 'Curl flux through surface', curlFlux.toFixed(4), ACC);
    setRow(3, 'Patches', String(patches.length));
    setRow(4, 'Probe: circulation', p ? p.flux.toExponential(2) : '—');
    setRow(5, 'Probe: curl·n', p ? p.cn.toFixed(3) : '—', WARN);
  }

  // --- loop ----------------------------------------------------------------------------------

  function draw() {
    if (dirty) rebuild();
    ctx.clearRect(0, 0, W, H);
    label("Stokes' Theorem", 20, 30, 0.85, 'left', 15);
    label('bend the surface all you like: only its rim decides the answer', 20, 54, 0.5, 'left', 11, WITH);
    drawScene();
    drawProbe();
    drawCancel();
    drawSum();
    updateReadout();
  }

  // --- interaction -----------------------------------------------------------------------------

  let dragging = false, lx = 0, ly = 0, moved = 0;
  canvas.addEventListener('pointerdown', (e) => {
    dragging = true;
    moved = 0;
    lx = e.clientX;
    ly = e.clientY;
    canvas.setPointerCapture(e.pointerId);
  });
  canvas.addEventListener('pointermove', (e) => {
    if (!dragging) return;
    const dx = e.clientX - lx, dy = e.clientY - ly;
    moved += Math.abs(dx) + Math.abs(dy);
    state.yaw += dx * 0.01;
    state.pitch = Math.max(-1.35, Math.min(1.35, state.pitch + dy * 0.008));
    lx = e.clientX;
    ly = e.clientY;
    draw();
  });
  canvas.addEventListener('pointerup', (e) => {
    if (dragging && moved < 6) {
      const r = canvas.getBoundingClientRect();
      const mx = ((e.clientX - r.left) / r.width) * W;
      const my = ((e.clientY - r.top) / r.height) * H;
      if (mx > SCENE.x && mx < SCENE.x + SCENE.w && my > SCENE.y && my < SCENE.y + SCENE.h) {
        const view = sceneView();
        let best = -1, bestD = 1e9, bestDepth = 1e9;
        patches.forEach((p, i) => {
          const s = proj(p.c, view);
          const d = Math.hypot(s.x - mx, s.y - my);
          if (d < 28 && (d < bestD - 5 || (Math.abs(d - bestD) <= 5 && s.d < bestDepth))) {
            best = i;
            bestD = d;
            bestDepth = s.d;
          }
        });
        if (best >= 0) state.sel = best;
        draw();
      }
    }
    dragging = false;
  });
  canvas.addEventListener('pointercancel', () => (dragging = false));

  // --- controls -----------------------------------------------------------------------------------

  function bindRange(id: string, apply: (n: number) => void) {
    const inp = el(id) as HTMLInputElement;
    inp.addEventListener('input', () => {
      apply(+inp.value);
      dirty = true;
      draw();
    });
    apply(+inp.value);
  }
  bindRange('n', (n) => {
    state.n = n;
    el('nval').textContent = String(n);
    state.sel = -1;
  });
  bindRange('size', (n) => {
    state.a = n / 100;
    el('aval').textContent = state.a.toFixed(2);
    state.sel = -1;
  });
  (el('cancel') as HTMLInputElement).addEventListener('change', (e) => {
    state.showCancel = (e.target as HTMLInputElement).checked;
    draw();
  });
  (el('fieldarr') as HTMLInputElement).addEventListener('change', (e) => {
    state.showField = (e.target as HTMLInputElement).checked;
    draw();
  });
  function seg(id: string, apply: (val: string) => void) {
    el(id).addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      if (!btn) return;
      document.querySelectorAll(`#${id} button`).forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      apply((btn.dataset.f ?? btn.dataset.s) as string);
      state.sel = -1;
      dirty = true;
      draw();
    });
  }
  seg('field', (val) => (state.field = val as Field));
  seg('surf', (val) => (state.surf = val as Surf));

  rebuild();
  draw();
</script>

