---
import SimLayout from '../../../layouts/SimLayout.astro';
---

<SimLayout
  areaSlug="calculus"
  title="Stokes' Theorem"
  description="Stretch any surface across a wobbly loop and chop it into little patches. Each patch spins by the amount of curl poking through it, neighbours share every inner edge and walk it both ways, and the whole sum collapses onto the one curve around the edge. Then bend the surface and watch the answer refuse to move."
>
  <div class="sim">
    <div class="sim-stage">
      <canvas id="stokes" class="st-canvas" width="900" height="640"></canvas>
    </div>

    <div class="sim-panel">
      <div class="control">
        <label>View</label>
        <div class="seg" id="view">
          <button data-v="2d" class="active">Flat</button>
          <button data-v="3d">In space</button>
        </div>
      </div>

      <div class="control" id="shapewrap">
        <label>Surface across the same loop</label>
        <div class="seg" id="shape">
          <button data-s="dome" class="active">Dome</button>
          <button data-s="bowl">Bowl</button>
          <button data-s="crumple">Crumpled</button>
        </div>
      </div>

      <div class="control">
        <label>Field</label>
        <div class="seg" id="field">
          <button data-f="rot" class="active">Rotation</button>
          <button data-f="slant">Sideways spin</button>
          <button data-f="eddy">Eddy</button>
          <button data-f="source">Source</button>
        </div>
      </div>

      <div class="control">
        <label>Patches <b id="nval">—</b></label>
        <input type="range" id="mesh" min="6" max="24" step="2" value="12" />
        <div class="scale-hint"><span>a few big ones</span><span>hundreds of tiny ones</span></div>
      </div>

      <label class="check"
        ><input type="checkbox" id="cancel" /> Cancel the shared edges</label
      >
      <label class="check"
        ><input type="checkbox" id="showfield" checked /> Show the field</label
      >

      <div class="readout">
        <div class="row"><span>Walk around the edge</span><b id="rim">—</b></div>
        <div class="row"><span>Spin added over the patches</span><b id="sum">—</b></div>
        <div class="row"><span>Patch you picked</span><b id="pcirc">—</b></div>
        <div class="row"><span>…its curl·n</span><b id="pcurl">—</b></div>
        <div class="row"><span>Gap between the two</span><b id="gap">—</b></div>
      </div>

      <p class="note">
        Drag to orbit, click any patch to open it up on the right. Every number
        is measured from the field itself.
      </p>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Click a patch. The panel on the right opens it up and asks one question on
      each edge: <b>does the field push me along, or hold me back?</b> Add the four
      and you have that patch's spin. Divide by its area and you have <b>the curl
      poking through it</b>, the only part of the curl that patch can feel.
    </li>
    <li>
      Tick <b>cancel the shared edges</b>. Every inner edge belongs to two patches
      that walk it in opposite directions, so it is added once and subtracted
      once. The whole mesh dissolves and leaves <b>one bold loop: the edge of the
      surface</b>. That collapse is the theorem.
    </li>
    <li>
      Now the punchline. Switch between <b>dome</b>, <b>bowl</b> and <b>crumpled</b>.
      Every patch changes, the normals point all over the place, and the total
      does not move by a hair, <b>because all three surfaces share the same
      edge</b>.
    </li>
    <li>
      The number on the left never moves at all, <b>not when you bend the surface
      and not when you chop it finer</b>, because it is a walk around the one curve
      all of them hang from. The sum on the right creeps up to meet it as the
      patches get smaller and cover the surface more honestly.
    </li>
    <li>
      Choose <b>sideways spin</b>, where the curl points along y and never up. A
      flat surface feels nothing at all. Bend it into a dome and patches light up
      teal on one side and orange on the other, yet they still add to zero. Only
      the component <b>through</b> the patch counts, and only the edge decides the
      total.
    </li>
    <li>
      Choose <b>source</b>: the flow blasts outward, nothing anywhere spins, every
      patch reads zero and so does the walk around the edge. Spreading is not
      spinning, and curl is blind to it.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import {
    HUE,
    V2,
    V3,
    v2,
    v3,
    add,
    sub,
    mul,
    dot,
    cross,
    len,
    unit,
    wobble,
    work3,
    circulation3,
    vectorArea,
    centroid3,
    gridCells,
    arrow,
    tick,
    polyPath,
    roundRect,
    inside,
    ease,
    signColour,
    project,
    orbit,
    type Cam,
    type Proj,
  } from '../../../lib/theorem';

  type Field = 'rot' | 'slant' | 'eddy' | 'source';
  type Shape = 'dome' | 'bowl' | 'crumple';

  const state = {
    view: '2d' as '2d' | '3d',
    shape: 'dome' as Shape,
    field: 'rot' as Field,
    mesh: 12,
    cancel: false,
    showField: true,
    sel: -1,
    fade: 0,
  };

  function F(p: V3): V3 {
    switch (state.field) {
      case 'rot':
        return v3(-p.y * 0.8, p.x * 0.8, 0);
      case 'slant':
        return v3(p.z * 1.1, 0, 0); // curl points along +y, never up
      case 'eddy': {
        const e = Math.exp(-(p.x * p.x + p.y * p.y) * 1.6);
        return v3(-p.y * 2.6 * e, p.x * 2.6 * e, 0);
      }
      case 'source':
        return mul(p, 0.8);
    }
  }

  // --- the loop, and the surfaces stretched across it ------------------------
  const R = wobble([
    [3, 0.16, 0.6],
    [2, 0.09, -1.1],
    [5, -0.06, 2.0],
  ]);
  const phi = (p: V2) => Math.hypot(p.x, p.y) - R(Math.atan2(p.y, p.x));
  const HALF = 1.34;

  // The edge itself, sampled finely. Every surface hangs from this one curve,
  // so the walk around it depends on neither the mesh nor the shape.
  const LOOP: V3[] = Array.from({ length: 900 }, (_, i) => {
    const th = (2 * Math.PI * i) / 900;
    return v3(R(th) * Math.cos(th), R(th) * Math.sin(th), 0);
  });

  /** Height above the plane. Every shape dies at the loop, so all of them hang
   *  from the very same edge. */
  function height(p: V2) {
    if (state.view === '2d') return 0;
    const th = Math.atan2(p.y, p.x);
    const u = Math.min(1, Math.hypot(p.x, p.y) / R(th));
    const b = 1 - u * u;
    switch (state.shape) {
      case 'dome':
        return 0.78 * b;
      case 'bowl':
        return -0.78 * b;
      case 'crumple':
        return 0.72 * b * (0.5 + 0.9 * u * Math.sin(3 * th + 1.1));
    }
  }
  const lift = (p: V2): V3 => v3(p.x, p.y, height(p));

  type Edge = { a: V3; b: V3; rim: boolean };
  type Patch = {
    poly: V3[];
    edges: Edge[];
    c: V3;
    n: V3;
    area: number;
    circ: number;
    curlN: number;
  };

  let patches: Patch[] = [];
  let rimCirc = 0;
  let patchSum = 0;
  let absSum = 0;
  let maxCurl = 1;

  function build() {
    patches = [];
    patchSum = 0;
    absSum = 0;
    maxCurl = 1e-9;

    for (const cell of gridCells(phi, state.mesh, HALF)) {
      const poly = cell.poly.map(lift);
      const A = vectorArea(poly);
      const area = len(A);
      if (area < 1e-9) continue;
      const circ = circulation3(F, poly, 4);
      const curlN = circ / area;
      maxCurl = Math.max(maxCurl, Math.abs(curlN));
      patches.push({
        poly,
        edges: cell.edges.map((e) => ({
          a: lift(e.a),
          b: lift(e.b),
          rim: e.rim,
        })),
        c: centroid3(poly),
        n: mul(A, 1 / area),
        area,
        circ,
        curlN,
      });
      patchSum += circ;
      absSum += Math.abs(circ);
    }

    // one walk around the real edge, with nothing to do with the mesh
    rimCirc = circulation3(F, LOOP, 2);
    if (state.sel >= patches.length) state.sel = -1;
  }

  /** How far apart the two sides are, against the total spin in play. */
  const gap = () => Math.abs(patchSum - rimCirc) / Math.max(absSum, 1e-9);

  // --- canvas ---------------------------------------------------------------
  const canvas = document.getElementById('stokes') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const css = (n: string, f = '') =>
    getComputedStyle(canvas).getPropertyValue(n).trim() || f;
  const ink = (a: number) => `rgba(${css('--stage-ink', '232,233,236')},${a})`;
  const { label } = makeText(ctx, ink);
  const accent = () => css('--accent', '#7c8cff');
  const fmt = (v: number) => (Math.abs(v) < 5e-5 ? '0.0000' : v.toFixed(4));

  const CARD = { x: 612, y: 64, w: 268, h: 300 };
  const flatCam: Cam = {
    yaw: 0,
    pitch: Math.PI / 2 - 0.001,
    dist: 6,
    f: 1150,
    cx: 300,
    cy: 286,
  };
  const spaceCam: Cam = {
    yaw: -0.66,
    pitch: 0.4,
    dist: 5.6,
    f: 1150,
    cx: 300,
    cy: 300,
  };
  const cam = () => (state.view === '2d' ? flatCam : spaceCam);
  const P = (p: V3): Proj => project(cam(), p);
  const selected = () => (state.sel >= 0 ? patches[state.sel] : null);

  function drawField() {
    if (!state.showField) return;
    const G = 8;
    const layers = state.view === '2d' ? [0] : [-0.5, 0.25, 1];
    for (let i = 0; i <= G; i++)
      for (let j = 0; j <= G; j++)
        for (const z of layers) {
          const p = v3(-1.5 + (3 * i) / G, -1.5 + (3 * j) / G, z);
          const f = F(p);
          if (len(f) < 1e-4) continue;
          const a = P(p),
            b = P(add(p, mul(f, 0.18)));
          const dx = b.x - a.x,
            dy = b.y - a.y;
          tick(ctx, a.x, a.y, dx, dy, Math.min(30, Math.hypot(dx, dy)), ink(0.3), 1.5);
        }
  }

  /** A circular arrow lying in the patch's own plane, turning about its normal. */
  function spinInPlane(p: Patch, radius: number, colour: string, lw: number) {
    const n = p.curlN >= 0 ? p.n : mul(p.n, -1);
    const ref = Math.abs(n.z) < 0.9 ? v3(0, 0, 1) : v3(1, 0, 0);
    const u = unit(cross(ref, n));
    const v = cross(n, u);
    const pts: Proj[] = [];
    const turn = Math.PI * 1.55;
    for (let i = 0; i <= 22; i++) {
      const a = 0.4 + (turn * i) / 22;
      pts.push(
        P(add(p.c, add(mul(u, radius * Math.cos(a)), mul(v, radius * Math.sin(a)))))
      );
    }
    ctx.strokeStyle = colour;
    ctx.lineWidth = lw;
    ctx.lineCap = 'round';
    ctx.beginPath();
    pts.forEach((q, i) => (i ? ctx.lineTo(q.x, q.y) : ctx.moveTo(q.x, q.y)));
    ctx.stroke();
    const a = pts[pts.length - 1],
      b = pts[pts.length - 3];
    const ang = Math.atan2(a.y - b.y, a.x - b.x);
    const h = Math.max(5.5, lw * 3.2);
    ctx.fillStyle = colour;
    ctx.beginPath();
    ctx.moveTo(a.x + h * 0.5 * Math.cos(ang), a.y + h * 0.5 * Math.sin(ang));
    ctx.lineTo(a.x - h * Math.cos(ang - 0.45), a.y - h * Math.sin(ang - 0.45));
    ctx.lineTo(a.x - h * Math.cos(ang + 0.45), a.y - h * Math.sin(ang + 0.45));
    ctx.closePath();
    ctx.fill();
  }

  function drawScene() {
    drawField();

    // patches and the pieces of the edge, interleaved by depth so the near half
    // of the loop passes in front of the surface and the far half behind it
    type Item = { d: number; patch?: number; seg?: [V3, V3] };
    const items: Item[] = patches.map((p, i) => ({ d: P(p.c).d, patch: i }));
    const STEP = 6; // the loop is sampled far finer than the eye needs
    for (let k = 0; k < LOOP.length; k += STEP) {
      const a = LOOP[k],
        b = LOOP[(k + STEP) % LOOP.length];
      items.push({ d: P(mul(add(a, b), 0.5)).d, seg: [a, b] });
    }
    items.sort((x, y) => y.d - x.d);

    const seam = 0.16 * (1 - ease(state.fade));
    for (const item of items) {
      if (item.seg) {
        const a = P(item.seg[0]),
          b = P(item.seg[1]);
        ctx.strokeStyle = accent();
        ctx.lineWidth = 3;
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);
        ctx.stroke();
        continue;
      }
      const i = item.patch!;
      const p = patches[i];
      const pts = p.poly.map(P);
      polyPath(ctx, pts);
      const facing = state.view === '2d' ? 1 : 0.55 + 0.45 * Math.abs(p.n.z);
      ctx.fillStyle = signColour(
        p.curlN,
        (0.07 + 0.34 * Math.min(1, Math.abs(p.curlN) / maxCurl)) * facing
      );
      ctx.fill();
      if (seam > 0.01) {
        ctx.strokeStyle = ink(seam);
        ctx.lineWidth = 1;
        ctx.stroke();
      }
      const room = Math.sqrt(p.area) * (cam().f / P(p.c).d) * 0.3;
      if (room > 3.5)
        spinInPlane(
          p,
          Math.sqrt(p.area) * 0.3,
          signColour(p.curlN, 0.72),
          Math.max(1.3, room * 0.15)
        );
      if (i === state.sel) {
        polyPath(ctx, pts);
        ctx.strokeStyle = HUE.pick;
        ctx.lineWidth = 2.5;
        ctx.stroke();
        const a = P(p.c),
          b = P(add(p.c, mul(p.n, 0.38)));
        arrow(ctx, a.x, a.y, b.x, b.y, HUE.pick, 2, 8);
      }
    }

    // arrows spaced evenly along the walk round the edge
    const mid = P(v3(0, 0, 0));
    let since = 40;
    for (let k = 0; k < LOOP.length; k++) {
      const A = LOOP[k],
        B = LOOP[(k + 1) % LOOP.length];
      const a = P(A),
        b = P(B);
      since += Math.hypot(b.x - a.x, b.y - a.y);
      if (since < 56) continue;
      since = 0;
      const C = LOOP[(k + 14) % LOOP.length];
      const c = P(C);
      const mx = (a.x + c.x) / 2,
        my = (a.y + c.y) / 2;
      const gx = mx - mid.x,
        gy = my - mid.y,
        gl = Math.hypot(gx, gy) || 1;
      const w = work3(F, A, C, 3);
      tick(
        ctx,
        mx + (gx / gl) * 13,
        my + (gy / gl) * 13,
        c.x - a.x,
        c.y - a.y,
        20,
        w >= 0 ? HUE.with : HUE.against,
        2.4
      );
    }
  }

  // --- the picked patch, opened up ------------------------------------------
  function drawCard() {
    const sel = selected();
    ctx.save();
    roundRect(ctx, CARD.x, CARD.y, CARD.w, CARD.h, 12);
    ctx.fillStyle = ink(0.04);
    ctx.fill();
    ctx.strokeStyle = ink(0.12);
    ctx.lineWidth = 1;
    ctx.stroke();
    ctx.clip();
    if (!sel) {
      label(
        'click any patch to open it up',
        CARD.x + CARD.w / 2,
        CARD.y + CARD.h / 2,
        0.3,
        'center',
        11
      );
      ctx.restore();
      return;
    }

    label('ONE PATCH, OPENED UP', CARD.x + 16, CARD.y + 24, 0.45, 'left', 11);

    // lay the patch flat on its own plane, keeping x roughly to the right so
    // the square does not arrive tilted, then fit it into the card
    const n = sel.n;
    const ref = Math.abs(n.x) < 0.9 ? v3(1, 0, 0) : v3(0, 1, 0);
    const u = unit(sub(ref, mul(n, dot(ref, n))));
    const v = cross(n, u);
    const flat = (p: V3) => {
      const d = sub(p, sel.c);
      return v2(dot(d, u), dot(d, v));
    };
    const fp = sel.poly.map(flat);
    let x0 = Infinity,
      x1 = -Infinity,
      y0 = Infinity,
      y1 = -Infinity;
    for (const p of fp) {
      x0 = Math.min(x0, p.x);
      x1 = Math.max(x1, p.x);
      y0 = Math.min(y0, p.y);
      y1 = Math.max(y1, p.y);
    }
    const box = { x: CARD.x + 24, y: CARD.y + 42, w: CARD.w - 48, h: 146 };
    const s = Math.min(box.w / (x1 - x0 || 1), box.h / (y1 - y0 || 1)) * 0.74;
    const cx = box.x + box.w / 2,
      cy = box.y + box.h / 2;
    const mx = (x0 + x1) / 2,
      my = (y0 + y1) / 2;
    const q = (p: V3) => {
      const f = flat(p);
      return { x: cx + (f.x - mx) * s, y: cy - (f.y - my) * s };
    };

    polyPath(ctx, sel.poly.map(q));
    ctx.fillStyle = signColour(sel.curlN, 0.1);
    ctx.fill();

    for (const e of sel.edges) {
      const w = work3(F, e.a, e.b, 4);
      const a = q(e.a),
        b = q(e.b);
      const col = w >= 0 ? HUE.with : HUE.against;
      ctx.strokeStyle = col;
      ctx.lineWidth = 3;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(a.x, a.y);
      ctx.lineTo(b.x, b.y);
      ctx.stroke();
      tick(ctx, (a.x + b.x) / 2, (a.y + b.y) / 2, b.x - a.x, b.y - a.y, 22, col, 2.4);
      const m = mul(add(e.a, e.b), 0.5);
      const fv = F(m);
      const mp = q(m);
      tick(ctx, mp.x, mp.y, dot(fv, u), -dot(fv, v), 28, ink(0.45), 1.5);
    }

    const y = CARD.y + 214;
    label('add the four edges', CARD.x + 16, y, 0.4, 'left', 10.5);
    label(
      `${sel.circ >= 0 ? '+' : ''}${fmt(sel.circ)}`,
      CARD.x + CARD.w - 16,
      y,
      0.95,
      'right',
      13,
      signColour(sel.curlN, 1)
    );
    label('÷ area', CARD.x + 16, y + 26, 0.4, 'left', 10.5);
    label(sel.area.toFixed(4), CARD.x + CARD.w - 16, y + 26, 0.7, 'right', 12);
    label('= curl·n', CARD.x + 16, y + 52, 0.4, 'left', 10.5);
    label(
      sel.curlN.toFixed(3),
      CARD.x + CARD.w - 16,
      y + 52,
      0.95,
      'right',
      13,
      HUE.pick
    );
    ctx.restore();

    const c = P(sel.c);
    ctx.strokeStyle = ink(0.18);
    ctx.setLineDash([3, 4]);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(c.x, c.y);
    ctx.lineTo(CARD.x, CARD.y + CARD.h / 2);
    ctx.stroke();
    ctx.setLineDash([]);
  }

  function drawStrip() {
    const y = 556;
    ctx.strokeStyle = ink(0.1);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(24, y - 26);
    ctx.lineTo(W - 24, y - 26);
    ctx.stroke();
    const g = gap();
    label('ONE WALK AROUND THE EDGE', 24, y, 0.42, 'left', 11);
    label(fmt(rimCirc), 24, y + 34, 1, 'left', 24, accent());
    label(g < 5e-4 ? '=' : '≈', 300, y + 30, 0.5, 'center', 22);
    label(
      `THE SPIN OF ALL ${patches.length} PATCHES, ADDED UP`,
      348,
      y,
      0.42,
      'left',
      11
    );
    label(fmt(patchSum), 348, y + 34, 1, 'left', 24, HUE.with);
    label(
      state.view === '2d'
        ? 'flatten it and this is exactly Green’s theorem'
        : 'bend it all you like: only the edge decides',
      24,
      y + 62,
      0.4,
      'left',
      11
    );
    label(
      `the patches miss ${(100 * g).toFixed(2)}% of it, less as they shrink`,
      W - 24,
      y + 62,
      0.4,
      'right',
      11
    );
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    ctx.save();
    ctx.beginPath();
    ctx.rect(0, 14, 598, 514);
    ctx.clip();
    drawScene();
    ctx.restore();
    drawCard();
    drawStrip();
    label(
      state.view === '2d'
        ? 'click any patch · teal spins one way, orange the other'
        : 'drag to orbit · click any patch',
      24,
      520,
      0.4,
      'left',
      11
    );
    sync();
  }

  function sync() {
    const sel = selected();
    const set = (id: string, v: string) =>
      ((document.getElementById(id) as HTMLElement).textContent = v);
    set('rim', fmt(rimCirc));
    set('sum', fmt(patchSum));
    set('pcirc', sel ? `${sel.circ >= 0 ? '+' : ''}${fmt(sel.circ)}` : '—');
    set('pcurl', sel ? sel.curlN.toFixed(3) : '—');
    set('nval', String(patches.length));
    set('gap', `${(100 * gap()).toFixed(2)}%`);
    (document.getElementById('shapewrap') as HTMLElement).style.display =
      state.view === '3d' ? '' : 'none';
  }

  /** Open on a patch away from the middle, where the edges disagree. */
  function pickDefault() {
    state.sel = patches.findIndex(
      (p) => p.c.x > 0.3 && p.c.y > 0.25 && p.poly.length === 4
    );
  }

  // --- cancelling animation -------------------------------------------------
  let raf = 0;
  function animate() {
    const target = state.cancel ? 1 : 0;
    const step = 0.055;
    if (Math.abs(state.fade - target) < step) {
      state.fade = target;
      draw();
      raf = 0;
      return;
    }
    state.fade += Math.sign(target - state.fade) * step;
    draw();
    raf = requestAnimationFrame(animate);
  }
  const kick = () => {
    if (!raf) raf = requestAnimationFrame(animate);
  };

  // --- interaction ----------------------------------------------------------
  function pick(x: number, y: number) {
    const order = patches
      .map((p, i) => ({ p, i, d: P(p.c).d }))
      .sort((a, b) => a.d - b.d);
    for (const { p, i } of order)
      if (inside(p.poly.map(P), x, y)) {
        state.sel = state.sel === i ? -1 : i;
        draw();
        return;
      }
    state.sel = -1;
    draw();
  }

  orbit(canvas, spaceCam, draw, {
    enabled: () => state.view === '3d',
    onTap: pick,
  });

  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const segment = (id: string, fn: (v: string) => void) =>
    $(id).addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      $(id)
        .querySelectorAll('button')
        .forEach((x) => x.classList.remove('active'));
      b.classList.add('active');
      fn(Object.values(b.dataset)[0] as string);
    });

  segment('view', (v) => {
    state.view = v as '2d' | '3d';
    build();
    pickDefault();
    draw();
  });
  segment('shape', (s) => {
    state.shape = s as Shape;
    build();
    draw();
  });
  segment('field', (f) => {
    state.field = f as Field;
    build();
    draw();
  });
  $('mesh').addEventListener('input', (e) => {
    state.mesh = +(e.target as HTMLInputElement).value;
    build();
    pickDefault();
    draw();
  });
  ($('cancel') as HTMLInputElement).addEventListener('change', (e) => {
    state.cancel = (e.target as HTMLInputElement).checked;
    kick();
  });
  ($('showfield') as HTMLInputElement).addEventListener('change', (e) => {
    state.showField = (e.target as HTMLInputElement).checked;
    draw();
  });

  build();
  pickDefault();
  draw();
</script>

