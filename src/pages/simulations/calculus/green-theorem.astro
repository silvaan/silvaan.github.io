---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Checks from '../../../components/sim/Checks.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
---

<SimLayout
  areaSlug="calculus"
  title="Green's Theorem"
  description="Chop the region inside a loop into little squares and give each one its own walk around its rim. Neighbours share every inner edge and walk it in opposite directions, so all of it cancels: what survives is one walk around the outside, and it equals all the spin inside."
  shortcuts={['fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas id="green" class="gt-canvas" width="900" height="546" role="img" aria-label="A wobbly region chopped into squares, each tinted by the sign of its curl, with the picked square opened up on the right showing the field along each of its four edges."></canvas>
      </div>
      <Caption
        legend={[{ label: 'spins anticlockwise', color: '#34d399' }, { label: 'spins clockwise', color: '#ff7a5c' }, { label: 'the square you picked', color: '#f59e0b' }]}
        hint="Click any square to open it up on the right"
      />
      <Result label="Square you picked" />
    </div>

    <div class="sim-panel">
      <Seg id="field" label="Field" attr="f" active="eddy" options={[{ value: 'eddy', label: 'Eddy' }, { value: 'rot', label: 'Rotation' }, { value: 'source', label: 'Source' }, { value: 'two', label: 'Two-sided' }]} />
      <Slider id="mesh" label="Squares" min={6} max={28} step={2} value={14} hint={['a few big ones', 'hundreds of tiny ones']} />
      <Checks items={[{ id: 'cancel', label: 'Cancel the shared edges' }, { id: 'showfield', label: 'Show the field', checked: true }]} />
      <Readout rows={[{ id: 'rim', label: 'walk around the loop' }, { id: 'sum', label: 'spin added over the squares' }, { id: 'gap', label: 'gap between the two' }]} />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Click a square. The panel on the right opens it up and puts an arrow on
      each of its four edges: <b>teal where the field pushes you along</b> the way
      you are walking, <b>orange where it holds you back</b>. Add the four and you
      have that square's circulation. Divide by its area and you have <b>curl</b>,
      which is all curl ever was.
    </li>
    <li>
      Every circle in the region is one of those little walks, drawn as the spin
      it adds up to. Teal turns anticlockwise, orange turns clockwise, and the
      size is how hard.
    </li>
    <li>
      Now tick <b>cancel the shared edges</b>. Every inner edge is walked twice,
      once by each of the two squares that share it, and in opposite directions,
      so it is added once and subtracted once. Watch the whole grid dissolve and
      leave <b>a single bold loop: the rim, the only edges with nobody on the far
      side</b>.
    </li>
    <li>
      That is the whole theorem, and you can watch it arrive. The number on the
      left <b>never moves</b>, because it is a walk around the real loop and knows
      nothing about your grid. Drag <b>squares</b> and the sum on the right climbs
      to meet it: squares can only approximate a curved region, and the finer they
      are the less of it they miss.
    </li>
    <li>
      Try <b>source</b>: the flow blasts outward, every square is flat and the rim
      walk is zero. Spreading is not spinning. Then try <b>two-sided</b>, where
      teal and orange squares fight each other and only their <b>signed</b> total
      survives to match the rim.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { el, segmented, slider, check, result, readout } from '../../../lib/panel';
  import { stageInk } from '../../../lib/draw';
  import {
    HUE,
    V2,
    v2,
    wobble,
    work2,
    circulation2,
    gridCells,
    tick,
    spin,
    polyPath,
    roundRect,
    inside,
    ease,
    signColour,
    type GridCell,
  } from '../../../lib/theorem';

  type Field = 'rot' | 'source' | 'eddy' | 'two';

  const state = {
    field: 'eddy' as Field,
    mesh: 14,
    cancel: false,
    showField: true,
    sel: -1,
    fade: 0,
  };

  function F(p: V2): V2 {
    switch (state.field) {
      case 'rot':
        return v2(-p.y * 0.8, p.x * 0.8);
      case 'source':
        return v2(p.x * 0.8, p.y * 0.8);
      case 'eddy': {
        const e = Math.exp(-(p.x * p.x + p.y * p.y) * 1.6);
        return v2(-p.y * 2.6 * e, p.x * 2.6 * e);
      }
      case 'two':
        return v2(0, 1.1 * Math.sin(2.4 * p.x));
    }
  }

  // --- the region: one wobbly closed curve, written as an implicit shape -----
  const R = wobble([
    [3, 0.16, 0.6],
    [2, 0.09, -1.1],
    [5, -0.06, 2.0],
  ]);
  const phi = (p: V2) => Math.hypot(p.x, p.y) - R(Math.atan2(p.y, p.x));
  const HALF = 1.34;

  // The loop itself, sampled finely. This is the thing the rim integral is
  // taken over, so that number never depends on how the inside was chopped up.
  const LOOP: V2[] = Array.from({ length: 900 }, (_, i) => {
    const th = (2 * Math.PI * i) / 900;
    return v2(R(th) * Math.cos(th), R(th) * Math.sin(th));
  });

  type Tile = GridCell & { circ: number; curl: number };

  let tiles: Tile[] = [];
  let rimCirc = 0;
  let tileSum = 0;
  let absSum = 0;
  let maxCurl = 1;

  function build() {
    tiles = [];
    tileSum = 0;
    absSum = 0;
    maxCurl = 1e-9;
    for (const cell of gridCells(phi, state.mesh, HALF)) {
      const circ = circulation2(F, cell.poly, 4);
      const curl = circ / cell.area;
      maxCurl = Math.max(maxCurl, Math.abs(curl));
      tiles.push({ ...cell, circ, curl });
      tileSum += circ;
      absSum += Math.abs(circ);
    }
    // one walk around the real loop, with nothing to do with the grid
    rimCirc = circulation2(F, LOOP, 2);
    if (state.sel >= tiles.length) state.sel = -1;
  }

  /** How far apart the two sides are, against the total spin in play. */
  const gap = () => Math.abs(tileSum - rimCirc) / Math.max(absSum, 1e-9);

  // --- canvas ---------------------------------------------------------------
  const setEq = equation();
  const setResult = result();
  const setRows = readout();
  const canvas = el('green') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { css, ink } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const accent = () => css('--accent', '#7c8cff');
  const fmt = (v: number) => (Math.abs(v) < 5e-5 ? '0.0000' : v.toFixed(4));

  const SC = { cx: 300, cy: 286, s: 186 };
  const CARD = { x: 612, y: 64, w: 268, h: 300 };
  const px = (p: V2) => ({ x: SC.cx + p.x * SC.s, y: SC.cy - p.y * SC.s });
  const selected = () => (state.sel >= 0 ? tiles[state.sel] : null);

  function drawField() {
    if (!state.showField) return;
    const G = 13;
    for (let i = 0; i <= G; i++)
      for (let j = 0; j <= G; j++) {
        const p = v2(-1.5 + (3 * i) / G, -1.5 + (3 * j) / G);
        const f = F(p);
        const m = Math.hypot(f.x, f.y);
        if (m < 1e-4) continue;
        const a = px(p);
        tick(ctx, a.x, a.y, f.x, -f.y, Math.min(30, 12 + m * 13), ink(0.32), 1.6);
      }
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    ctx.save();
    ctx.beginPath();
    ctx.rect(0, 14, 598, 514);
    ctx.clip();

    drawField();

    // the squares, tinted by which way they spin
    const seam = 0.16 * (1 - ease(state.fade));
    for (const t of tiles) {
      polyPath(ctx, t.poly.map(px));
      ctx.fillStyle = signColour(
        t.curl,
        0.05 + 0.3 * Math.min(1, Math.abs(t.curl) / maxCurl)
      );
      ctx.fill();
      if (seam > 0.01) {
        ctx.strokeStyle = ink(seam);
        ctx.lineWidth = 1;
        ctx.stroke();
      }
    }

    // one circular arrow per square: the spin living inside it
    for (const t of tiles) {
      const c = px(t.c);
      const room = Math.sqrt(t.area) * SC.s * 0.34;
      const r = room * (0.34 + 0.66 * Math.min(1, Math.abs(t.curl) / maxCurl));
      spin(
        ctx,
        c.x,
        c.y,
        Math.min(room, r),
        t.curl,
        signColour(t.curl, 0.72),
        Math.max(1.3, room * 0.15)
      );
    }

    // the loop itself, which is what the walk on the left of the strip follows
    ctx.strokeStyle = accent();
    ctx.lineWidth = 3;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    polyPath(ctx, LOOP.map(px));
    ctx.stroke();

    // arrows spaced evenly along the walk
    const cen = px(v2(0, 0));
    let since = 40;
    for (let k = 0; k < LOOP.length; k++) {
      const A = LOOP[k],
        B = LOOP[(k + 1) % LOOP.length];
      const a = px(A),
        b = px(B);
      since += Math.hypot(b.x - a.x, b.y - a.y);
      if (since < 54) continue;
      since = 0;
      const step = 14;
      const C = LOOP[(k + step) % LOOP.length];
      const c = px(C);
      const mx = (a.x + c.x) / 2,
        my = (a.y + c.y) / 2;
      const gx = mx - cen.x,
        gy = my - cen.y,
        gl = Math.hypot(gx, gy) || 1;
      const w = work2(F, A, C, 3);
      tick(
        ctx,
        mx + (gx / gl) * 13,
        my + (gy / gl) * 13,
        c.x - a.x,
        c.y - a.y,
        20,
        w >= 0 ? HUE.with : HUE.against,
        2.4
      );
    }

    const sel = selected();
    if (sel) {
      polyPath(ctx, sel.poly.map(px));
      ctx.strokeStyle = HUE.pick;
      ctx.lineWidth = 2.5;
      ctx.stroke();
    }
    ctx.restore();

    drawCard();
    sync();
  }

  // --- the picked square, opened up -----------------------------------------
  function drawCard() {
    const sel = selected();
    ctx.save();
    roundRect(ctx, CARD.x, CARD.y, CARD.w, CARD.h, 12);
    ctx.fillStyle = ink(0.04);
    ctx.fill();
    ctx.strokeStyle = ink(0.12);
    ctx.lineWidth = 1;
    ctx.stroke();
    ctx.clip();
    if (!sel) {
      label(
        'click any square to open it up',
        CARD.x + CARD.w / 2,
        CARD.y + CARD.h / 2,
        0.3,
        'center',
        11
      );
      ctx.restore();
      return;
    }

    label('one square, opened up', CARD.x + 16, CARD.y + 24, 0.45, 'left', 11);

    let x0 = Infinity,
      x1 = -Infinity,
      y0 = Infinity,
      y1 = -Infinity;
    for (const p of sel.poly) {
      x0 = Math.min(x0, p.x);
      x1 = Math.max(x1, p.x);
      y0 = Math.min(y0, p.y);
      y1 = Math.max(y1, p.y);
    }
    const box = { x: CARD.x + 24, y: CARD.y + 42, w: CARD.w - 48, h: 146 };
    const s = Math.min(box.w / (x1 - x0 || 1), box.h / (y1 - y0 || 1)) * 0.74;
    const cx = box.x + box.w / 2,
      cy = box.y + box.h / 2;
    const mx = (x0 + x1) / 2,
      my = (y0 + y1) / 2;
    const q = (p: V2) => ({ x: cx + (p.x - mx) * s, y: cy - (p.y - my) * s });

    polyPath(ctx, sel.poly.map(q));
    ctx.fillStyle = signColour(sel.curl, 0.1);
    ctx.fill();

    for (const e of sel.edges) {
      const w = work2(F, e.a, e.b, 4);
      const a = q(e.a),
        b = q(e.b);
      const col = w >= 0 ? HUE.with : HUE.against;
      ctx.strokeStyle = col;
      ctx.lineWidth = 3;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(a.x, a.y);
      ctx.lineTo(b.x, b.y);
      ctx.stroke();
      tick(ctx, (a.x + b.x) / 2, (a.y + b.y) / 2, b.x - a.x, b.y - a.y, 22, col, 2.4);
      // what the field is doing where you are walking
      const m = v2((e.a.x + e.b.x) / 2, (e.a.y + e.b.y) / 2);
      const fv = F(m);
      const mp = q(m);
      tick(ctx, mp.x, mp.y, fv.x, -fv.y, 28, ink(0.45), 1.5);
    }

    const y = CARD.y + 214;
    label('add the four edges', CARD.x + 16, y, 0.4, 'left', 10.5);
    label(
      `${sel.circ >= 0 ? '+' : ''}${fmt(sel.circ)}`,
      CARD.x + CARD.w - 16,
      y,
      0.95,
      'right',
      13,
      signColour(sel.curl, 1)
    );
    label('÷ area', CARD.x + 16, y + 26, 0.4, 'left', 10.5);
    label(sel.area.toFixed(4), CARD.x + CARD.w - 16, y + 26, 0.7, 'right', 12);
    label('= curl', CARD.x + 16, y + 52, 0.4, 'left', 10.5);
    label(
      sel.curl.toFixed(3),
      CARD.x + CARD.w - 16,
      y + 52,
      0.95,
      'right',
      13,
      HUE.pick
    );
    ctx.restore();

    const c = px(sel.c);
    ctx.strokeStyle = ink(0.18);
    ctx.setLineDash([3, 4]);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(c.x, c.y);
    ctx.lineTo(CARD.x, CARD.y + CARD.h / 2);
    ctx.stroke();
    ctx.setLineDash([]);
  }


  function sync() {
    const sel = selected();
    setEq({
      rule: [['\\oint_{\\partial R}\\mathbf{F}\\cdot d\\mathbf{r}', accent()], '=', ['\\iint_R\\Big(\\frac{\\partial Q}{\\partial x}-\\frac{\\partial P}{\\partial y}\\Big)dA', HUE.with]],
      live: [[`${fmt(rimCirc)}\\text{ round the loop}`, accent()], '\\approx', [`${fmt(tileSum)}\\text{ over ${tiles.length} squares}`, HUE.with], `\\quad${(100 * gap()).toFixed(2)}\\%\\text{ short}`],
    });
    setRows({ rim: fmt(rimCirc), sum: fmt(tileSum), gap: `${(100 * gap()).toFixed(2)}%` });
    el('meshval').textContent = `${tiles.length} squares`;
    const uniform = state.field === 'rot' || state.field === 'source';
    setResult({
      value: sel ? `${sel.circ >= 0 ? '+' : ''}${fmt(sel.circ)}` : '—',
      colour: sel ? (sel.circ >= 0 ? HUE.with : HUE.against) : undefined,
      status: sel
        ? `its circulation · curl ${sel.curl.toFixed(3)} · centred at (${sel.c.x.toFixed(2)}, ${sel.c.y.toFixed(2)})${sel.full ? '' : ' · cut by the rim'}`
        : 'click any square to open it up',
      note: uniform
        ? state.field === 'rot'
          ? 'This field spins the same everywhere, so every full square reports the same curl; only the squares cut by the rim differ. Pick Eddy to see it vary.'
          : 'A pure source has no spin at all: every square reports zero, and so does the walk round the loop.'
        : 'The walk is measured on the true loop, not on the grid. Every shared edge is walked twice in opposite directions and cancels, so only the rim survives.',
    });
  }

  // --- cancelling animation -------------------------------------------------
  let raf = 0;
  function animate() {
    const target = state.cancel ? 1 : 0;
    const step = 0.055;
    if (Math.abs(state.fade - target) < step) {
      state.fade = target;
      draw();
      raf = 0;
      return;
    }
    state.fade += Math.sign(target - state.fade) * step;
    draw();
    raf = requestAnimationFrame(animate);
  }
  const kick = () => {
    if (!raf) raf = requestAnimationFrame(animate);
  };

  // --- interaction ----------------------------------------------------------
  canvas.addEventListener('pointerdown', (e) => {
    const b = canvas.getBoundingClientRect();
    const x = ((e.clientX - b.left) / b.width) * W;
    const y = ((e.clientY - b.top) / b.height) * H;
    for (let i = 0; i < tiles.length; i++)
      if (inside(tiles[i].poly.map(px), x, y)) {
        state.sel = state.sel === i ? -1 : i;
        draw();
        return;
      }
    state.sel = -1;
    draw();
  });

  segmented('field', (f) => {
    state.field = f as Field;
    build();
    draw();
  });
  slider('mesh', (v) => {
    state.mesh = v;
    state.sel = -1;
    build();
    draw();
  }, (v) => `${v} × ${v} grid`);
  check('cancel', (on) => {
    state.cancel = on;
    kick();
  });
  check('showfield', (on) => {
    state.showField = on;
    draw();
  });

  build();
  state.sel = tiles.findIndex((t) => t.full && t.c.x > 0.35 && t.c.y > 0.3);
  draw();
</script>

<style>
  .gt-canvas {
    cursor: pointer;
    touch-action: none;
  }
</style>
