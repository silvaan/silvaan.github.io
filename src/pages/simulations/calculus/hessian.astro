---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Checks from '../../../components/sim/Checks.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
---

<SimLayout
  areaSlug="calculus"
  title="The Hessian"
  description="A surface does not have one second derivative. It bends by a different amount in every direction you could walk, and the four numbers of the Hessian hold all of them at once. Its eigenvectors are the two directions that bend the most and the least, and their signs decide whether you are standing in a bowl, on a dome or on a saddle."
  shortcuts={['fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="hs"
          width="1000"
          height="600"
          role="img"
          aria-label="A contour map with a movable point, the gradient and the two eigenvectors of the Hessian drawn on it, the matrix and its eigenvalues, and the surface sliced along each eigenvector."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'a direction that curves upward', color: '#5eead4' },
          { label: 'a direction that curves downward', color: '#f87171' },
          { label: 'the gradient, which knows nothing about bending', color: '#f59e0b' },
        ]}
        hint="Drag anywhere on the map to move the point"
      />
      <Result label="Standing on" />
    </div>

    <div class="sim-panel">
      <Seg
        id="fn"
        label="Surface"
        attr="f"
        active="saddle"
        options={[
          { value: 'bowl', label: 'Bowl' },
          { value: 'saddle', label: 'Saddle' },
          { value: 'valley', label: 'Narrow valley' },
          { value: 'ripples', label: 'Ripples' },
          { value: 'hills', label: 'Two hills' },
        ]}
      />
      <Checks
        items={[
          { id: 'eig', label: 'The eigenvectors of the Hessian', checked: true },
          { id: 'quad', label: 'What the quadratic approximation says', checked: true },
          { id: 'grad', label: 'The gradient', checked: true },
        ]}
      />
      <Readout
        rows={[
          { id: 'r-xx', label: 'f<sub>xx</sub>' },
          { id: 'r-xy', label: 'f<sub>xy</sub>' },
          { id: 'r-yy', label: 'f<sub>yy</sub>' },
          { id: 'r-l1', label: 'λ<sub>1</sub>, the larger' },
          { id: 'r-l2', label: 'λ<sub>2</sub>, the smaller' },
          { id: 'r-cond', label: 'strongest ÷ weakest bending' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Walk the point around. The gradient tells you which way is downhill and
      nothing else, while the two coloured axes tell you how the ground bends,
      and they are not the same question. On a level spot the gradient vanishes
      entirely and the axes carry on saying something.
    </li>
    <li>
      The two axes are the eigenvectors, and they are always at right angles,
      because a Hessian is symmetric. Along one the surface bends the most it
      can; along the other, the least. Every other direction bends somewhere in
      between, which is the whole content of the four numbers.
    </li>
    <li>
      The two slices on the right are the surface cut along each axis, with the
      parabola that matches it drawn through. Their curvature is λ<sub>1</sub>
      and λ<sub>2</sub>, so the eigenvalues are not abstract: they are the second
      derivatives you would measure by walking those two ways.
    </li>
    <li>
      Choose <b>Saddle</b>. One eigenvalue is positive and one negative, one
      slice curves up while the other curves down, and the point is a minimum
      and a maximum at the same time depending on which way you face. Both
      eigenvalues positive is a bowl, both negative a dome, and that test is the
      whole second-derivative test in two dimensions.
    </li>
    <li>
      Choose <b>Narrow valley</b>. The two eigenvalues differ by a factor of
      thirty, so the ellipse is a long thin cigar and the ratio in the panel is
      large. That ratio is the condition number, and it is exactly what makes
      <a href="/simulations/deep-learning/gradient-descent">gradient descent</a>
      zigzag: a step that suits the sharp direction is far too small for the
      gentle one.
    </li>
    <li>
      Choose <b>Ripples</b> or <b>Two hills</b> and move about. The Hessian is
      not one matrix for the surface but a different matrix at every point, and
      the axes turn as you go. Everything here is a statement about the
      neighbourhood of one point, which is what
      <a href="/simulations/calculus/curvature">second derivatives</a> always
      are.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk, roundRect, arrow } from '../../../lib/draw';
  import { el, segmented, check, result, readout } from '../../../lib/panel';

  const UP = '#5eead4';
  const DOWN = '#f87171';
  const GRAD = '#f59e0b';
  const QUAD = '#a78bfa';

  const FNS: Record<string, (x: number, y: number) => number> = {
    bowl: (x, y) => 0.55 * x * x + 1.35 * y * y,
    saddle: (x, y) => 0.75 * x * x - 0.85 * y * y,
    valley: (x, y) => 0.07 * x * x + 2.1 * y * y,
    ripples: (x, y) => 1.1 * Math.sin(1.5 * x) * Math.cos(1.5 * y),
    hills: (x, y) =>
      1.7 * Math.exp(-((x - 0.85) ** 2 + (y - 0.6) ** 2)) -
      1.4 * Math.exp(-1.2 * ((x + 0.9) ** 2 + (y + 0.7) ** 2)),
  };

  const state = { fn: 'saddle', p: [0.6, 0.5], eig: true, quad: true, grad: true };

  const canvas = el('hs') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink, inv } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  // --- the derivatives, measured rather than differentiated -------------------
  // Every second derivative on this page comes from the same three-height rule
  // the curvature page is about, taken in two directions and across them.
  const EPS = 2e-3;
  const F = (x: number, y: number) => FNS[state.fn](x, y);
  function derivs(x: number, y: number) {
    const h = EPS;
    const f0 = F(x, y);
    const fx = (F(x + h, y) - F(x - h, y)) / (2 * h);
    const fy = (F(x, y + h) - F(x, y - h)) / (2 * h);
    const fxx = (F(x + h, y) - 2 * f0 + F(x - h, y)) / (h * h);
    const fyy = (F(x, y + h) - 2 * f0 + F(x, y - h)) / (h * h);
    const fxy = (F(x + h, y + h) - F(x + h, y - h) - F(x - h, y + h) + F(x - h, y - h)) / (4 * h * h);
    return { f0, fx, fy, fxx, fxy, fyy };
  }
  /** A symmetric two by two always has two real eigenvalues at right angles. */
  function eigen(a: number, b: number, d: number) {
    const tr = a + d, det = a * d - b * b;
    const disc = Math.sqrt(Math.max(0, (tr * tr) / 4 - det));
    const l1 = tr / 2 + disc, l2 = tr / 2 - disc;
    const v1 = Math.abs(b) > 1e-9 ? [b, l1 - a] : a >= d ? [1, 0] : [0, 1];
    const n = Math.hypot(v1[0], v1[1]) || 1;
    const e1 = [v1[0] / n, v1[1] / n];
    return { l1, l2, e1, e2: [-e1[1], e1[0]] };
  }

  // --- layout ----------------------------------------------------------------
  const MAP = { x: 44, y: 104, w: 460, h: 460 };
  const HB = { x: 560, y: 128, w: 400, h: 132 };
  const CS = [
    { x: 560, y: 318, w: 400, h: 108 },
    { x: 560, y: 468, w: 400, h: 108 },
  ];
  const R = 2.4;
  const px = (x: number) => MAP.x + ((x + R) / (2 * R)) * MAP.w;
  const py = (y: number) => MAP.y + MAP.h - ((y + R) / (2 * R)) * MAP.h;
  const PPU = MAP.w / (2 * R);
  const toW = (sx: number, sy: number) => [
    ((sx - MAP.x) / MAP.w) * 2 * R - R,
    ((MAP.y + MAP.h - sy) / MAP.h) * 2 * R - R,
  ];

  function panel(b: { x: number; y: number; w: number; h: number }) {
    ctx.fillStyle = inv(0.45);
    roundRect(ctx, b.x, b.y, b.w, b.h, 10);
    ctx.fill();
    ctx.strokeStyle = ink(0.12);
    ctx.lineWidth = 1;
    roundRect(ctx, b.x + 0.5, b.y + 0.5, b.w - 1, b.h - 1, 10);
    ctx.stroke();
  }

  /** Contours by marching squares, so the map reads as a landscape. */
  function contours() {
    const N = 96;
    const g: number[][] = [];
    let lo = Infinity, hi = -Infinity;
    for (let j = 0; j <= N; j++) {
      const row: number[] = [];
      for (let i = 0; i <= N; i++) {
        const v = F(-R + (i / N) * 2 * R, -R + (j / N) * 2 * R);
        row.push(v);
        lo = Math.min(lo, v);
        hi = Math.max(hi, v);
      }
      g.push(row);
    }
    const gx = (i: number) => MAP.x + (i / N) * MAP.w;
    const gy = (j: number) => MAP.y + MAP.h - (j / N) * MAP.h;
    // a wash first, so high and low ground are told apart at a glance
    for (let j = 0; j < N; j++)
      for (let i = 0; i < N; i++) {
        const t = (g[j][i] - lo) / Math.max(1e-9, hi - lo);
        ctx.fillStyle = `rgba(124,140,255,${0.03 + 0.2 * t})`;
        ctx.fillRect(gx(i), gy(j + 1), MAP.w / N + 1, MAP.h / N + 1);
      }
    ctx.strokeStyle = ink(0.16);
    ctx.lineWidth = 1;
    ctx.beginPath();
    for (let k = 1; k < 14; k++) {
      const lv = lo + ((hi - lo) * k) / 14;
      for (let j = 0; j < N; j++)
        for (let i = 0; i < N; i++) {
          const a = g[j][i], b = g[j][i + 1], c = g[j + 1][i + 1], d = g[j + 1][i];
          const pts: number[][] = [];
          const cross = (v0: number, v1: number, x0: number, y0: number, x1: number, y1: number) => {
            if (v0 === v1 || (v0 < lv) === (v1 < lv)) return;
            const t = (lv - v0) / (v1 - v0);
            pts.push([x0 + t * (x1 - x0), y0 + t * (y1 - y0)]);
          };
          cross(a, b, gx(i), gy(j), gx(i + 1), gy(j));
          cross(b, c, gx(i + 1), gy(j), gx(i + 1), gy(j + 1));
          cross(c, d, gx(i + 1), gy(j + 1), gx(i), gy(j + 1));
          cross(d, a, gx(i), gy(j + 1), gx(i), gy(j));
          if (pts.length === 2) {
            ctx.moveTo(pts[0][0], pts[0][1]);
            ctx.lineTo(pts[1][0], pts[1][1]);
          }
        }
    }
    ctx.stroke();
  }

  function map() {
    const [x, y] = state.p;
    const D = derivs(x, y);
    const E = eigen(D.fxx, D.fxy, D.fyy);
    label('the surface, from above', MAP.x, MAP.y - 34, 0.55, 'left', 13);
    label('contours of equal height', MAP.x, MAP.y - 16, 0.32, 'left', 11);
    panel(MAP);
    ctx.save();
    roundRect(ctx, MAP.x, MAP.y, MAP.w, MAP.h, 10);
    ctx.clip();
    contours();

    // what the quadratic says about the neighbourhood
    if (state.quad) {
      const s = 0.9;
      ctx.strokeStyle = QUAD;
      ctx.lineWidth = 1.6;
      if (E.l1 * E.l2 > 1e-6) {
        // definite: level sets of ½dᵀHd are ellipses on the eigenvectors
        const c = 0.5 * Math.max(Math.abs(E.l1), Math.abs(E.l2)) * s * s;
        const r1 = Math.sqrt(Math.abs((2 * c) / E.l1)), r2 = Math.sqrt(Math.abs((2 * c) / E.l2));
        ctx.save();
        ctx.translate(px(x), py(y));
        ctx.rotate(-Math.atan2(E.e1[1], E.e1[0]));
        ctx.beginPath();
        ctx.ellipse(0, 0, r1 * PPU, r2 * PPU, 0, 0, Math.PI * 2);
        ctx.restore();
        ctx.stroke();
      } else if (E.l1 * E.l2 < -1e-6) {
        // a saddle: the two directions in which it is flat to second order
        const t = Math.sqrt(Math.abs(E.l1 / E.l2));
        for (const sgn of [1, -1]) {
          const dx = E.e1[0] + sgn * t * E.e2[0], dy = E.e1[1] + sgn * t * E.e2[1];
          const n = Math.hypot(dx, dy);
          ctx.setLineDash([5, 5]);
          ctx.beginPath();
          ctx.moveTo(px(x - (dx / n) * 1.6), py(y - (dy / n) * 1.6));
          ctx.lineTo(px(x + (dx / n) * 1.6), py(y + (dy / n) * 1.6));
          ctx.stroke();
          ctx.setLineDash([]);
        }
      }
    }

    if (state.grad) {
      const gm = Math.hypot(D.fx, D.fy);
      if (gm > 1e-4) {
        const L = Math.min(1.4, 0.35 + gm * 0.28);
        ctx.strokeStyle = GRAD;
        ctx.fillStyle = GRAD;
        ctx.lineWidth = 2.4;
        arrow(ctx, px(x), py(y), px(x + (D.fx / gm) * L), py(y + (D.fy / gm) * L), 8);
      }
    }

    if (state.eig) {
      const big = Math.max(Math.abs(E.l1), Math.abs(E.l2), 1e-6);
      for (const [l, e] of [[E.l1, E.e1], [E.l2, E.e2]] as [number, number[]][]) {
        const L = 0.35 + 1.1 * Math.sqrt(Math.abs(l) / big);
        const c = l >= 0 ? UP : DOWN;
        ctx.strokeStyle = c;
        ctx.fillStyle = c;
        ctx.lineWidth = 2.8;
        arrow(ctx, px(x), py(y), px(x + e[0] * L), py(y + e[1] * L), 8);
        arrow(ctx, px(x), py(y), px(x - e[0] * L), py(y - e[1] * L), 8);
      }
    }

    ctx.fillStyle = ink(0.95);
    ctx.strokeStyle = inv(0.85);
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(px(x), py(y), 6, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();
    ctx.restore();
    return { D, E };
  }

  function board(D: ReturnType<typeof derivs>, E: ReturnType<typeof eigen>) {
    label('the four numbers, and what they come to', HB.x, HB.y - 34, 0.55, 'left', 13);
    label('this matrix belongs to this point alone', HB.x, HB.y - 16, 0.32, 'left', 11);
    panel(HB);
    const n2 = (v: number) => (Math.abs(v) < 5e-3 ? 0 : v).toFixed(2);
    const cx = HB.x + 96, cy = HB.y + HB.h / 2;
    ctx.strokeStyle = ink(0.45);
    ctx.lineWidth = 1.6;
    for (const s of [-1, 1]) {
      const bx = cx + s * 74;
      ctx.beginPath();
      ctx.moveTo(bx - s * 7, cy - 40);
      ctx.lineTo(bx, cy - 40);
      ctx.lineTo(bx, cy + 40);
      ctx.lineTo(bx - s * 7, cy + 40);
      ctx.stroke();
    }
    label(n2(D.fxx), cx - 34, cy - 12, 0.95, 'center', 14);
    label(n2(D.fxy), cx + 34, cy - 12, 0.95, 'center', 14);
    label(n2(D.fxy), cx - 34, cy + 22, 0.95, 'center', 14);
    label(n2(D.fyy), cx + 34, cy + 22, 0.95, 'center', 14);
    label('H', cx - 96, cy + 6, 0.6, 'center', 15);

    const lx = HB.x + 226;
    label('its eigenvalues', lx, HB.y + 26, 0.4, 'left', 11);
    label(`λ₁ = ${n2(E.l1)}`, lx, HB.y + 56, 0.95, 'left', 15, E.l1 >= 0 ? UP : DOWN);
    label(`λ₂ = ${n2(E.l2)}`, lx, HB.y + 84, 0.95, 'left', 15, E.l2 >= 0 ? UP : DOWN);
    label(E.l1 * E.l2 > 0 ? 'same sign: a bowl or a dome' : 'opposite signs: a saddle', lx, HB.y + 110, 0.35, 'left', 11);
  }

  /** The surface cut along one eigenvector, with the parabola of that eigenvalue. */
  function slice(k: 0 | 1, e: number[], l: number, D: ReturnType<typeof derivs>) {
    const b = CS[k];
    const [x, y] = state.p;
    label(`walking along ${k === 0 ? 'the first' : 'the second'} axis`, b.x, b.y - 34, 0.55, 'left', 13);
    label(`it bends by λ${k === 0 ? '₁' : '₂'} = ${l.toFixed(2)}`, b.x, b.y - 16, 0.32, 'left', 11, l >= 0 ? UP : DOWN);
    panel(b);
    const T = 1.5;
    const vals: number[] = [];
    for (let i = 0; i <= 120; i++) {
      const t = -T + (i / 120) * 2 * T;
      vals.push(F(x + e[0] * t, y + e[1] * t));
    }
    let lo = Infinity, hi = -Infinity;
    for (const v of vals) { lo = Math.min(lo, v); hi = Math.max(hi, v); }
    const q = (t: number) => D.f0 + 0.5 * l * t * t;
    for (const t of [-T, T]) { lo = Math.min(lo, q(t)); hi = Math.max(hi, q(t)); }
    const pad = Math.max(1e-4, (hi - lo) * 0.18);
    const sx = (t: number) => b.x + 8 + ((t + T) / (2 * T)) * (b.w - 16);
    const sy = (v: number) => b.y + b.h - 8 - ((v - lo + pad) / (hi - lo + 2 * pad)) * (b.h - 16);
    ctx.strokeStyle = `${QUAD}aa`;
    ctx.setLineDash([5, 5]);
    ctx.lineWidth = 1.8;
    ctx.beginPath();
    for (let i = 0; i <= 120; i++) {
      const t = -T + (i / 120) * 2 * T;
      i ? ctx.lineTo(sx(t), sy(q(t))) : ctx.moveTo(sx(t), sy(q(t)));
    }
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.strokeStyle = l >= 0 ? UP : DOWN;
    ctx.lineWidth = 2.4;
    ctx.beginPath();
    vals.forEach((v, i) => {
      const t = -T + (i / 120) * 2 * T;
      i ? ctx.lineTo(sx(t), sy(v)) : ctx.moveTo(sx(t), sy(v));
    });
    ctx.stroke();
    ctx.fillStyle = ink(0.95);
    ctx.beginPath();
    ctx.arc(sx(0), sy(D.f0), 4.5, 0, Math.PI * 2);
    ctx.fill();
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    const { D, E } = map();
    board(D, E);
    slice(0, E.e1, E.l1, D);
    slice(1, E.e2, E.l2, D);

    const n2 = (v: number) => (Math.abs(v) < 5e-3 ? 0 : v).toFixed(3);
    const flat = Math.max(Math.abs(E.l1), Math.abs(E.l2)) < 0.02;
    const kind = flat
      ? 'flat ground'
      : E.l1 > 0 && E.l2 > 0
        ? 'a bowl'
        : E.l1 < 0 && E.l2 < 0
          ? 'a dome'
          : 'a saddle';
    const big = Math.max(Math.abs(E.l1), Math.abs(E.l2));
    const small = Math.min(Math.abs(E.l1), Math.abs(E.l2));
    const cond = small > 1e-6 ? big / small : Infinity;
    setEq({
      rule: [
        ['f(p + d) \\approx f(p) + \\nabla f^{\\top} d + \\tfrac12\\, d^{\\top} H d', GRAD],
        '\\qquad',
        ['H e_i = \\lambda_i e_i', UP],
      ],
      live: [
        [`\\lambda_1 = ${n2(E.l1)}`, E.l1 >= 0 ? UP : DOWN],
        [`\\quad \\lambda_2 = ${n2(E.l2)}`, E.l2 >= 0 ? UP : DOWN],
        `\\quad \\text{${kind}}`,
      ],
    });
    setRows({
      'r-xx': n2(D.fxx),
      'r-xy': n2(D.fxy),
      'r-yy': n2(D.fyy),
      'r-l1': n2(E.l1),
      'r-l2': n2(E.l2),
      'r-cond': Number.isFinite(cond) ? `${cond.toFixed(1)}×` : '∞',
    });
    setResult({
      value: kind,
      colour: kind === 'a bowl' ? UP : kind === 'a dome' ? DOWN : kind === 'a saddle' ? GRAD : undefined,
      status: `λ₁ = ${n2(E.l1)}, λ₂ = ${n2(E.l2)} · the strongest bending is ${Number.isFinite(cond) ? `${cond.toFixed(1)} times` : 'infinitely many times'} the weakest · the gradient here is ${Math.hypot(D.fx, D.fy).toFixed(3)} long`,
      note:
        kind === 'a saddle'
          ? 'One direction curves up and the other curves down, so this point is a minimum and a maximum at once and neither answer is wrong. The gradient is powerless to tell you this; only the second derivatives can.'
          : kind === 'flat ground'
            ? 'Both eigenvalues have gone to nothing, so the surface is flat to second order here and the quadratic approximation is a plane. Whatever happens next is decided by the third derivatives.'
            : cond > 12
              ? 'The two eigenvalues are wildly different, so the ellipse is a long thin cigar. Any method that takes the same size of step in every direction will cross the narrow way far too fast and crawl along the long way.'
              : kind === 'a bowl'
                ? 'Both directions curve upward, so every way you could walk from here goes up, and the point is a genuine minimum. That is the second-derivative test: not one number but the signs of two.'
                : 'Both directions curve downward, so every way from here goes down and the point is a genuine maximum.',
    });
  }

  // --- interaction -----------------------------------------------------------
  let drag = false;
  const local = (e: PointerEvent) => {
    const r = canvas.getBoundingClientRect();
    return { x: ((e.clientX - r.left) / r.width) * W, y: ((e.clientY - r.top) / r.height) * H };
  };
  const put = (p: { x: number; y: number }) => {
    const w = toW(p.x, p.y);
    state.p = [Math.max(-R + 0.1, Math.min(R - 0.1, w[0])), Math.max(-R + 0.1, Math.min(R - 0.1, w[1]))];
    draw();
  };
  canvas.addEventListener('pointerdown', (e) => {
    const p = local(e);
    if (p.x < MAP.x || p.x > MAP.x + MAP.w || p.y < MAP.y || p.y > MAP.y + MAP.h) return;
    drag = true;
    try { canvas.setPointerCapture(e.pointerId); } catch { /* synthetic pointers need no capture */ }
    put(p);
  });
  canvas.addEventListener('pointermove', (e) => {
    const p = local(e);
    const over = p.x >= MAP.x && p.x <= MAP.x + MAP.w && p.y >= MAP.y && p.y <= MAP.y + MAP.h;
    canvas.style.cursor = drag || over ? 'crosshair' : 'default';
    if (drag) put(p);
  });
  const drop = () => { drag = false; };
  canvas.addEventListener('pointerup', drop);
  canvas.addEventListener('pointercancel', drop);

  segmented('fn', (f) => {
    state.fn = f;
    state.p = f === 'ripples' ? [0.5, 0.4] : f === 'hills' ? [-0.2, -0.1] : [0.6, 0.5];
    draw();
  });
  check('eig', (on) => { state.eig = on; draw(); });
  check('quad', (on) => { state.quad = on; draw(); });
  check('grad', (on) => { state.grad = on; draw(); });

  draw();
</script>
