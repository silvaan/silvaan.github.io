---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Checks from '../../../components/sim/Checks.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="calculus"
  title="Partial Derivatives"
  description="A surface has a slope for every direction you could walk. Freeze y and slide a plane through it to get ∂f/∂x, freeze x for ∂f/∂y, then turn the plane to any direction u and watch D_u f = ∇f·u peak along the gradient."
  shortcuts={['fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas id="pd" class="pd-canvas" width="900" height="540" role="img" aria-label="A surface cut by vertical planes through a point, each leaving one curve with its tangent line, the gradient arrow and level curves on the floor, and a card that flattens the chosen slice into an ordinary graph."></canvas>
      </div>
      <Caption
        legend={[
          { label: 'y held still: ∂f/∂x', color: 'rgb(245,158,11)' },
          { label: 'x held still: ∂f/∂y', color: 'rgb(56,189,248)' },
          { label: 'direction u: D<sub>u</sub>f', color: 'rgb(167,139,250)' },
          { label: 'gradient ∇f', color: 'rgb(52,211,153)' },
        ]}
        hint="Drag to orbit · scroll to zoom · click a slice to select it"
      />
      <Result label="∂f/∂x at your point" />
    </div>
    <div class="sim-panel">
      <Seg id="surf" label="Surface" attr="s" options={[{ value: 'bowl', label: 'Bowl' }, { value: 'saddle', label: 'Saddle' }, { value: 'twist', label: 'Twist' }, { value: 'hill', label: 'Hill' }]} />
      <Seg id="slice" label="Which slice" attr="w" options={[{ value: 'x', label: '∂f/∂x' }, { value: 'y', label: '∂f/∂y' }, { value: 'u', label: 'Direction u' }]} />
      <Slider id="a" label="Point x" min={-1.5} max={1.5} step={0.05} value={0.8} display="0.80" />
      <Slider id="b" label="Point y" min={-1.5} max={1.5} step={0.05} value={-0.6} display="−0.60" />
      <Slider id="theta" label="Direction θ of u" min={0} max={360} step={1} value={30} display="30°" />
      <Checks items={[{ id: 'tplane', label: 'Show the plane the two tangent lines span' }]} />
      <Readout
        title="Values"
        rows={[
          { id: 'rx', label: '∂f/∂x' },
          { id: 'ry', label: '∂f/∂y' },
          { id: 'ru', label: 'D<sub>u</sub>f = ∇f·u' },
          { id: 'rg', label: 'steepest slope |∇f|' },
          { id: 'rf', label: 'height f(x, y)' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Each plane freezes one variable, so inside it the surface is an ordinary
      curve (redrawn in the card). Its slope is the <b>partial derivative</b>. <Try id="slice" />
    </li>
    <li>
      On <b>Twist</b> (f = 0.8xy), ∂f/∂x = 0.8y: slide y across zero and the
      slope along x flips sign. <Try id="twist" />
    </li>
    <li>
      Pick <b>Direction u</b> and line it up with the green ∇f arrow:
      D<sub>u</sub>f = ∇f·u reaches its largest value, exactly |∇f|. <Try id="peak" />
    </li>
    <li>
      Turn u a quarter turn, along the <b>level curve</b> through the point
      (the bold contour on the floor): the slice is flat there and D<sub>u</sub>f = 0. <Try id="level" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { el, segmented, slider, check, result, readout, tries } from '../../../lib/panel';
  import {
    V3,
    v3,
    sub,
    cross,
    unit,
    dot,
    project,
    orbit,
    inside,
    roundRect,
    type Cam,
    type Proj,
  } from '../../../lib/theorem';

  type Which = 'x' | 'y' | 'u';
  type Surf = {
    f: (x: number, y: number) => number;
    fx: (x: number, y: number) => number;
    fy: (x: number, y: number) => number;
    eq: string;
    ex: string;
    ey: string;
  };

  const SURF: Record<string, Surf> = {
    bowl: {
      f: (x, y) => 0.5 * x * x + 0.5 * y * y,
      fx: (x) => x,
      fy: (_x, y) => y,
      eq: 'f(x, y) = ½x² + ½y²',
      ex: '∂f/∂x = x',
      ey: '∂f/∂y = y',
    },
    saddle: {
      f: (x, y) => 0.5 * x * x - 0.5 * y * y,
      fx: (x) => x,
      fy: (_x, y) => -y,
      eq: 'f(x, y) = ½x² − ½y²',
      ex: '∂f/∂x = x',
      ey: '∂f/∂y = −y',
    },
    twist: {
      f: (x, y) => 0.8 * x * y,
      fx: (_x, y) => 0.8 * y,
      fy: (x) => 0.8 * x,
      eq: 'f(x, y) = 0.8xy',
      ex: '∂f/∂x = 0.8y',
      ey: '∂f/∂y = 0.8x',
    },
    hill: {
      f: (x, y) => 1.7 * Math.exp(-(x * x + y * y) / 2),
      fx: (x, y) => -x * 1.7 * Math.exp(-(x * x + y * y) / 2),
      fy: (x, y) => -y * 1.7 * Math.exp(-(x * x + y * y) / 2),
      eq: 'f(x, y) = 1.7e^−(x²+y²)/2',
      ex: '∂f/∂x = −x · f(x, y)',
      ey: '∂f/∂y = −y · f(x, y)',
    },
  };

  const state = {
    surf: 'bowl',
    a: 0.8,
    b: -0.6,
    which: 'x' as Which,
    theta: 30, // degrees, the direction of u
    tplane: false,
  };

  // amber holds y still, blue holds x still, violet walks along u
  const RGB = { x: '245,158,11', y: '56,189,248', u: '167,139,250' };
  const col = (w: Which, alpha: number) => `rgba(${RGB[w]},${alpha})`;
  const other = (w: Which): Which => (w === 'x' ? 'y' : 'x');
  const GRAD = (alpha: number) => `rgba(52,211,153,${alpha})`;

  /** The horizontal direction each slice walks in. */
  const dirOf = (w: Which): [number, number] => {
    if (w === 'x') return [1, 0];
    if (w === 'y') return [0, 1];
    const t = (state.theta * Math.PI) / 180;
    return [Math.cos(t), Math.sin(t)];
  };
  /** The slice's slope: the derivative of f along its direction, ∇f·d. */
  const slope = (w: Which) => {
    const [dx, dy] = dirOf(w);
    return cur().fx(state.a, state.b) * dx + cur().fy(state.a, state.b) * dy;
  };
  /** The range of t for which (a, b) + t·d stays inside the drawn square. */
  function span(w: Which): [number, number] {
    const [dx, dy] = dirOf(w);
    let lo = -Infinity, hi = Infinity;
    for (const [p, d] of [[state.a, dx], [state.b, dy]]) {
      if (Math.abs(d) < 1e-9) continue;
      const t1 = (-D - p) / d, t2 = (D - p) / d;
      lo = Math.max(lo, Math.min(t1, t2));
      hi = Math.min(hi, Math.max(t1, t2));
    }
    return [lo, hi];
  }
  /** The slices on screen: both partials, or the one directional slice. */
  const shown = (): Which[] => (state.which === 'u' ? ['u'] : [other(state.which), state.which]);

  const D = 1.6; // the surface is drawn over [−D, D]²
  const cur = () => SURF[state.surf];

  // The drawn height is (f − mid)·K, so every surface fills the same box. The
  // same map is applied to the traces and the tangent lines, so a line tangent
  // to the surface stays tangent on screen; only the printed numbers are raw.
  let mid = 0,
    K = 1,
    ZH = 1.4;
  // the surface's own full range of heights, shared by the card's graph so a
  // slice that only shifts up or down still visibly shifts
  let flo = 0,
    fhi = 1;
  // the largest |∇f| on the square, so the gradient arrow has a scale
  let gref = 1;

  function calibrate() {
    const { f } = cur();
    let lo = Infinity,
      hi = -Infinity;
    for (let i = 0; i <= 48; i++)
      for (let j = 0; j <= 48; j++) {
        const v = f(-D + (2 * D * i) / 48, -D + (2 * D * j) / 48);
        lo = Math.min(lo, v);
        hi = Math.max(hi, v);
      }
    flo = lo;
    fhi = hi;
    gref = 1e-6;
    for (let i = 0; i <= 24; i++)
      for (let j = 0; j <= 24; j++) {
        const x = -D + (2 * D * i) / 24, y = -D + (2 * D * j) / 24;
        gref = Math.max(gref, Math.hypot(cur().fx(x, y), cur().fy(x, y)));
      }
    mid = (lo + hi) / 2;
    const half = (hi - lo) / 2 || 1;
    K = Math.max(0.35, Math.min(1.5, 1.15 / half));
    ZH = half * K + 0.22;
  }

  const zw = (x: number, y: number) => (cur().f(x, y) - mid) * K;
  const world = (x: number, y: number): V3 => v3(x, y, zw(x, y));

  // --- canvas ---------------------------------------------------------------
  const setEq = equation();
  const setResult = result();
  const setRows = readout();
  const canvas = el('pd') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const css = (n: string, f = '') =>
    getComputedStyle(canvas).getPropertyValue(n).trim() || f;
  const ink = (a: number) => `rgba(${css('--stage-ink', '232,233,236')},${a})`;
  const inv = (a: number) =>
    `rgba(${css('--stage-ink-inv', '13,14,18')},${a})`;
  const { label, textWidth } = makeText(ctx, ink);
  const fmt = (v: number) =>
    (Math.abs(v) < 5e-4 ? 0 : v).toFixed(3).replace('-', '−');
  const signed = (v: number) => (v >= 0 ? '+' : '') + fmt(v);

  const cam: Cam = {
    yaw: -0.62,
    pitch: -0.46,
    dist: 7.6,
    f: 660,
    cx: 300,
    cy: 262,
  };
  const CARD = { x: 616, y: 26, w: 262, h: 486 };
  const GR = { x: 634, y: 64, w: 226, h: 132 };
  const px = (p: V3) => project(cam, p);
  const LIGHT = unit(v3(-0.42, -0.55, 0.72));

  // --- the two slices -------------------------------------------------------
  /** The curve the plane cuts out of the surface, in world coordinates. */
  function trace(w: Which, n = 120): V3[] {
    const [dx, dy] = dirOf(w);
    const [lo, hi] = span(w);
    const out: V3[] = [];
    for (let i = 0; i <= n; i++) {
      const t = lo + ((hi - lo) * i) / n;
      out.push(world(state.a + t * dx, state.b + t * dy));
    }
    return out;
  }

  /** Two ends of the tangent line, kept inside the plane's rectangle. */
  function tangent(w: Which): [V3, V3] {
    const { a, b } = state;
    const [dx, dy] = dirOf(w);
    const s = K * slope(w);
    const z0 = zw(a, b);
    const [rlo, rhi] = span(w);
    // clip to the box so the line never escapes its own plane
    let lo = Math.max(-0.95, rlo),
      hi = Math.min(0.95, rhi);
    if (Math.abs(s) > 1e-6) {
      const t1 = (ZH - z0) / s,
        t2 = (-ZH - z0) / s;
      lo = Math.max(lo, Math.min(t1, t2));
      hi = Math.min(hi, Math.max(t1, t2));
    }
    const at = (t: number): V3 => v3(a + t * dx, b + t * dy, z0 + s * t);
    return [at(lo), at(hi)];
  }

  /** The four corners of a cutting plane, anticlockwise. */
  function planeCorners(w: Which): V3[] {
    const [dx, dy] = dirOf(w);
    const [lo, hi] = span(w);
    const x0 = state.a + lo * dx, y0 = state.b + lo * dy;
    const x1 = state.a + hi * dx, y1 = state.b + hi * dy;
    return [v3(x0, y0, -ZH), v3(x1, y1, -ZH), v3(x1, y1, ZH), v3(x0, y0, ZH)];
  }

  // --- painter's list -------------------------------------------------------
  type Face = { q: Proj[]; d: number; fill: string; stroke: string };
  const faces: Face[] = [];

  function pushQuad(pts: V3[], fill: string, stroke: string) {
    const q = pts.map(px);
    if (q.some((p) => p.d < 0.4)) return;
    faces.push({ q, d: q.reduce((s, p) => s + p.d, 0) / q.length, fill, stroke });
  }

  function surfaceFaces() {
    const M = 30;
    const at = (i: number) => -D + (2 * D * i) / M;
    for (let i = 0; i < M; i++)
      for (let j = 0; j < M; j++) {
        const p = [
          world(at(i), at(j)),
          world(at(i + 1), at(j)),
          world(at(i + 1), at(j + 1)),
          world(at(i), at(j + 1)),
        ];
        const n = unit(cross(sub(p[1], p[0]), sub(p[3], p[0])));
        const lam = Math.abs(dot(n, LIGHT));
        pushQuad(p, ink(0.07 + 0.3 * lam), ink(0.08));
      }
  }

  function planeFaces(w: Which) {
    const on = state.which === w;
    const C = 22,
      R = 10;
    const [c0, c1, , c3] = planeCorners(w);
    const u = sub(c1, c0),
      v = sub(c3, c0);
    const P = (s: number, t: number): V3 =>
      v3(c0.x + u.x * s + v.x * t, c0.y + u.y * s + v.y * t, c0.z + u.z * s + v.z * t);
    for (let i = 0; i < C; i++)
      for (let j = 0; j < R; j++) {
        const s0 = i / C,
          s1 = (i + 1) / C,
          t0 = j / R,
          t1 = (j + 1) / R;
        pushQuad(
          [P(s0, t0), P(s1, t0), P(s1, t1), P(s0, t1)],
          col(w, on ? 0.075 : 0.028),
          'transparent'
        );
      }
  }

  function tangentPlaneFaces() {
    const { a, b } = state;
    const z0 = zw(a, b);
    const sx = K * cur().fx(a, b),
      sy = K * cur().fy(a, b);
    const L = 0.8,
      M = 6;
    const P = (s: number, t: number): V3 =>
      v3(a + s, b + t, z0 + sx * s + sy * t);
    for (let i = 0; i < M; i++)
      for (let j = 0; j < M; j++) {
        const s0 = -L + (2 * L * i) / M,
          s1 = -L + (2 * L * (i + 1)) / M,
          t0 = -L + (2 * L * j) / M,
          t1 = -L + (2 * L * (j + 1)) / M;
        pushQuad([P(s0, t0), P(s1, t0), P(s1, t1), P(s0, t1)], ink(0.14), ink(0.05));
      }
  }

  /** The outline of that patch, so it reads as one flat sheet through the point. */
  function tangentPlaneEdge() {
    const { a, b } = state;
    const z0 = zw(a, b);
    const sx = K * cur().fx(a, b),
      sy = K * cur().fy(a, b);
    const L = 0.8;
    const P = (s: number, t: number): V3 =>
      v3(a + s, b + t, z0 + sx * s + sy * t);
    const c = [P(-L, -L), P(L, -L), P(L, L), P(-L, L)];
    stroke3([...c, c[0]], ink(0.5), 1.4, [6, 5]);
  }

  function floorFaces() {
    // one flat tile under everything, so the box has a floor to cast the point onto
    pushQuad(
      [v3(-D, -D, -ZH), v3(D, -D, -ZH), v3(D, D, -ZH), v3(-D, D, -ZH)],
      ink(0.035),
      'transparent'
    );
  }

  // --- scene ----------------------------------------------------------------
  function stroke3(pts: V3[], colour: string, lw: number, dash: number[] = []) {
    const q = pts.map(px);
    if (q.some((p) => p.d < 0.4)) return;
    ctx.setLineDash(dash);
    ctx.strokeStyle = colour;
    ctx.lineWidth = lw;
    ctx.lineJoin = 'round';
    ctx.lineCap = 'round';
    ctx.beginPath();
    q.forEach((p, i) => (i ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y)));
    ctx.stroke();
    ctx.setLineDash([]);
  }

  function floorGrid() {
    for (let i = 0; i <= 8; i++) {
      const t = -D + (2 * D * i) / 8;
      const edge = i === 0 || i === 8;
      stroke3([v3(t, -D, -ZH), v3(t, D, -ZH)], ink(edge ? 0.16 : 0.06), 1);
      stroke3([v3(-D, t, -ZH), v3(D, t, -ZH)], ink(edge ? 0.16 : 0.06), 1);
    }
    const ex = px(v3(D + 0.18, -D, -ZH)),
      ey = px(v3(-D, D + 0.18, -ZH));
    label('x', ex.x, ex.y + 4, 0.4, 'center', 12);
    label('y', ey.x, ey.y + 4, 0.4, 'center', 12);
  }

  function drawSlice(w: Which) {
    const on = state.which === w;
    const tr = trace(w);
    const [t0, t1] = tangent(w);

    // the plane's own outline, so its extent reads even where it is behind
    const c = planeCorners(w);
    stroke3([...c, c[0]], col(w, on ? 0.32 : 0.13), 1);

    // the surface, cut down to a single curve
    stroke3(tr, col(w, on ? 0.95 : 0.34), on ? 3 : 1.8);

    // the tangent line to that curve: the partial derivative itself
    if (on) stroke3([t0, t1], col(w, 0.2), 10);
    stroke3([t0, t1], col(w, on ? 1 : 0.32), on ? 2.8 : 1.4, on ? [] : [5, 5]);

    // a name for the frozen variable, floating at the top of the plane on a
    // chip of background colour so it stays readable over the surface
    const q = px(c[2]);
    if (q.d > 0.4) {
      const txt = w === 'x' ? `y = ${fmt(state.b)}` : w === 'y' ? `x = ${fmt(state.a)}` : `θ = ${Math.round(state.theta)}°`;
      const tw = textWidth(txt, 11);
      ctx.fillStyle = inv(0.72);
      roundRect(ctx, q.x - tw / 2 - 7, q.y - 21, tw + 14, 19, 5);
      ctx.fill();
      label(txt, q.x, q.y - 8, 1, 'center', 11, col(w, on ? 1 : 0.5));
    }
  }

  function drawPoint() {
    const { a, b } = state;
    const p = world(a, b);
    const q = px(p);
    if (q.d < 0.4) return;
    stroke3([v3(a, b, -ZH), p], ink(0.22), 1, [3, 4]);
    const foot = px(v3(a, b, -ZH));
    ctx.fillStyle = ink(0.25);
    ctx.beginPath();
    ctx.arc(foot.x, foot.y, 3, 0, Math.PI * 2);
    ctx.fill();

    ctx.fillStyle = ink(1);
    ctx.strokeStyle = inv(0.75);
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(q.x, q.y, 6, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();
  }

  /** Marching squares: the segments of the level set f = L over the square. */
  function contour(L: number, N = 40): [number, number, number, number][] {
    const { f } = cur();
    const at = (i: number) => -D + (2 * D * i) / N;
    const segs: [number, number, number, number][] = [];
    for (let i = 0; i < N; i++)
      for (let j = 0; j < N; j++) {
        const c = [
          [at(i), at(j)],
          [at(i + 1), at(j)],
          [at(i + 1), at(j + 1)],
          [at(i), at(j + 1)],
        ];
        const v = c.map(([x, y]) => f(x, y) - L);
        const hits: [number, number][] = [];
        for (let k = 0; k < 4; k++) {
          const m = (k + 1) % 4;
          if ((v[k] < 0) !== (v[m] < 0)) {
            const t = v[k] / (v[k] - v[m]);
            hits.push([c[k][0] + (c[m][0] - c[k][0]) * t, c[k][1] + (c[m][1] - c[k][1]) * t]);
          }
        }
        if (hits.length >= 2) segs.push([...hits[0], ...hits[1]]);
        if (hits.length === 4) segs.push([...hits[2], ...hits[3]]);
      }
    return segs;
  }

  function strokeSegs(segs: [number, number, number, number][], z: number, colour: string, lw: number) {
    ctx.strokeStyle = colour;
    ctx.lineWidth = lw;
    ctx.beginPath();
    for (const [x0, y0, x1, y1] of segs) {
      const p = px(v3(x0, y0, z)), q = px(v3(x1, y1, z));
      if (p.d < 0.4 || q.d < 0.4) continue;
      ctx.moveTo(p.x, p.y);
      ctx.lineTo(q.x, q.y);
    }
    ctx.stroke();
  }

  /** Level curves on the floor, the one through your point in bold. */
  function floorContours() {
    for (let k = 1; k < 8; k++) strokeSegs(contour(flo + ((fhi - flo) * k) / 8), -ZH, ink(0.1), 1);
    strokeSegs(contour(cur().f(state.a, state.b)), -ZH, ink(0.6), 1.8);
  }

  /** A flat arrow on the floor from (x, y), d already scaled to its length. */
  function floorArrow(x: number, y: number, dx: number, dy: number, colour: string, lw: number) {
    const p = px(v3(x, y, -ZH)), q = px(v3(x + dx, y + dy, -ZH));
    if (p.d < 0.4 || q.d < 0.4) return;
    const ang = Math.atan2(q.y - p.y, q.x - p.x);
    ctx.strokeStyle = colour;
    ctx.fillStyle = colour;
    ctx.lineWidth = lw;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(p.x, p.y);
    ctx.lineTo(q.x - 6 * Math.cos(ang), q.y - 6 * Math.sin(ang));
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(q.x, q.y);
    ctx.lineTo(q.x - 11 * Math.cos(ang - 0.4), q.y - 11 * Math.sin(ang - 0.4));
    ctx.lineTo(q.x - 11 * Math.cos(ang + 0.4), q.y - 11 * Math.sin(ang + 0.4));
    ctx.closePath();
    ctx.fill();
  }

  /** ∇f at the foot of the point, and u when a direction is being walked. */
  function floorArrows() {
    const { a, b } = state;
    const gx = cur().fx(a, b), gy = cur().fy(a, b);
    const g = Math.hypot(gx, gy);
    if (state.which === 'u') {
      const [dx, dy] = dirOf('u');
      floorArrow(a, b, dx * 0.75, dy * 0.75, col('u', 0.95), 2.4);
    }
    if (g > 1e-4) {
      const L = 0.2 + 0.85 * Math.min(1, g / gref);
      floorArrow(a, b, (gx / g) * L, (gy / g) * L, GRAD(1), 3);
      const tip = px(v3(a + (gx / g) * (L + 0.14), b + (gy / g) * (L + 0.14), -ZH));
      if (tip.d > 0.4) label('∇f', tip.x, tip.y + 4, 1, 'center', 12, GRAD(1));
    }
  }

  function drawScene() {
    faces.length = 0;
    floorFaces();
    surfaceFaces();
    for (const w of shown()) planeFaces(w);
    if (state.tplane) tangentPlaneFaces();
    faces.sort((a, b) => b.d - a.d);
    for (const f of faces) {
      ctx.beginPath();
      f.q.forEach((p, i) => (i ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y)));
      ctx.closePath();
      ctx.fillStyle = f.fill;
      ctx.fill();
      if (f.stroke !== 'transparent') {
        ctx.strokeStyle = f.stroke;
        ctx.lineWidth = 1;
        ctx.stroke();
      }
    }
    floorGrid();
    floorContours();
    if (state.tplane) tangentPlaneEdge();
    for (const w of shown()) drawSlice(w);
    floorArrows();
    drawPoint();
  }

  // --- the card: the same slice, flattened ----------------------------------
  function drawCard() {
    const w = state.which;
    const { a, b } = state;
    const [dx, dy] = dirOf(w);
    const s = slope(w);
    // the card's horizontal variable: x or y itself, or the distance t along u
    const off = w === 'x' ? a : w === 'y' ? b : 0;
    const [tlo, thi] = span(w);
    const glo = tlo + off, ghi = thi + off;
    const fAt = (T: number) => cur().f(a + (T - off) * dx, b + (T - off) * dy);
    const p0 = off;

    ctx.save();
    roundRect(ctx, CARD.x, CARD.y, CARD.w, CARD.h, 12);
    ctx.fillStyle = ink(0.04);
    ctx.fill();
    ctx.strokeStyle = ink(0.12);
    ctx.lineWidth = 1;
    ctx.stroke();
    ctx.clip();

    label(
      w === 'u' ? 'inside the plane along u' : `inside the ${w} plane`,
      CARD.x + 16,
      CARD.y + 24,
      1,
      'left',
      11,
      col(w, 0.9)
    );

    // the trace as an ordinary one-variable graph
    const vals: number[] = [];
    for (let i = 0; i <= 80; i++) vals.push(fAt(glo + ((ghi - glo) * i) / 80));
    // one window for every slice of this surface, not one per slice: freezing
    // the other variable somewhere else has to move the curve on screen
    const pad = (fhi - flo) * 0.12 || 0.5;
    const lo = flo - pad,
      hi = fhi + pad;
    const gx = (t: number) => GR.x + ((t - glo) / (ghi - glo)) * GR.w;
    const gy = (v: number) => GR.y + GR.h - ((v - lo) / (hi - lo)) * GR.h;

    ctx.strokeStyle = ink(0.1);
    ctx.lineWidth = 1;
    ctx.strokeRect(GR.x, GR.y, GR.w, GR.h);
    if (lo < 0 && hi > 0) {
      ctx.strokeStyle = ink(0.14);
      ctx.beginPath();
      ctx.moveTo(GR.x, gy(0));
      ctx.lineTo(GR.x + GR.w, gy(0));
      ctx.stroke();
    }

    ctx.strokeStyle = ink(0.55);
    ctx.lineWidth = 2.2;
    ctx.beginPath();
    vals.forEach((v, i) => {
      const t = glo + ((ghi - glo) * i) / 80;
      i ? ctx.lineTo(gx(t), gy(v)) : ctx.moveTo(gx(t), gy(v));
    });
    ctx.stroke();

    // its tangent, and the rise over run that measures it
    const v0 = cur().f(a, b);
    const line = (t: number) => v0 + s * (t - p0);
    ctx.save();
    ctx.beginPath();
    ctx.rect(GR.x, GR.y, GR.w, GR.h);
    ctx.clip();
    ctx.strokeStyle = col(w, 0.95);
    ctx.lineWidth = 2.4;
    ctx.beginPath();
    ctx.moveTo(gx(glo), gy(line(glo)));
    ctx.lineTo(gx(ghi), gy(line(ghi)));
    ctx.stroke();

    // the run goes towards the roomier side, so "rise" never falls off the box
    const run = ghi - p0 >= p0 - glo ? 0.62 : -0.62;
    const r1 = Math.max(glo, Math.min(ghi, p0 + run));
    ctx.setLineDash([3, 3]);
    ctx.strokeStyle = ink(0.45);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(gx(p0), gy(v0));
    ctx.lineTo(gx(r1), gy(v0));
    ctx.lineTo(gx(r1), gy(line(r1)));
    ctx.stroke();
    ctx.setLineDash([]);
    // keep "run" clear of the vertical rise, whichever way that one drops
    const down = line(r1) < v0;
    label(
      'run',
      (gx(p0) + gx(r1)) / 2,
      gy(v0) + (down ? -7 : 15),
      0.45,
      'center',
      11
    );
    label(
      'rise',
      gx(r1) + (run > 0 ? 6 : -6),
      (gy(v0) + gy(line(r1))) / 2 + 3,
      0.75,
      run > 0 ? 'left' : 'right',
      11,
      col(w, 0.9)
    );
    ctx.restore();

    ctx.fillStyle = ink(1);
    ctx.strokeStyle = inv(0.7);
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(gx(p0), gy(v0), 5, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();

    label(w === 'u' ? 't along u' : w, GR.x + GR.w, GR.y + GR.h + 15, 0.4, 'right', 11);
    label('f', GR.x - 4, GR.y + 10, 0.4, 'right', 11);

    label(
      w === 'u'
        ? 'x and y move together, so'
        : `${other(w)} is frozen at ${fmt(w === 'x' ? b : a)}, so`,
      CARD.x + 16,
      GR.y + GR.h + 38,
      0.5,
      'left',
      11.5
    );
    label(
      'one curve, one slope',
      CARD.x + 16,
      GR.y + GR.h + 56,
      0.5,
      'left',
      11.5
    );

    // the equations, the chosen one lit
    let y = CARD.y + 290;
    ctx.strokeStyle = ink(0.1);
    ctx.beginPath();
    ctx.moveTo(CARD.x + 16, y - 26);
    ctx.lineTo(CARD.x + CARD.w - 16, y - 26);
    ctx.stroke();

    label(cur().eq, CARD.x + 16, y, 0.75, 'left', 11.5);
    y += 34;
    const rowsOn: Which[] = w === 'u' ? ['x', 'y', 'u'] : ['x', 'y'];
    const gap = w === 'u' ? 22 : 26;
    for (const k of rowsOn) {
      const on = state.which === k;
      ctx.fillStyle = col(k, on ? 1 : 0.35);
      ctx.fillRect(CARD.x + 16, y - 8, 3, 11);
      label(
        k === 'x' ? cur().ex : k === 'y' ? cur().ey : 'Dᵤf = ∇f · u',
        CARD.x + 26,
        y,
        1,
        'left',
        k === 'u' ? 11 : 12,
        col(k, on ? 1 : 0.38)
      );
      y += gap;
    }

    y += w === 'u' ? 14 : 22;
    label('at your point', CARD.x + 16, y, 0.42, 'left', 11.5);
    y += 26;
    label(
      w === 'u'
        ? `Dᵤf at θ = ${Math.round(state.theta)}°`
        : `∂f/∂${w}(${fmt(a)}, ${fmt(b)})`,
      CARD.x + 16,
      y,
      0.6,
      'left',
      11.5
    );
    y += 32;
    label(`= ${signed(s)}`, CARD.x + 16, y, 1, 'left', 22, col(w, 1));
    label(
      Math.abs(s) < 5e-4 ? 'flat' : s > 0 ? 'uphill' : 'downhill',
      CARD.x + CARD.w - 16,
      y,
      0.45,
      'right',
      11.5
    );
    ctx.restore();
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    ctx.save();
    ctx.beginPath();
    ctx.rect(0, 8, 600, 512);
    ctx.clip();
    drawScene();
    ctx.restore();
    drawCard();
    sync();
  }

  function sync() {
    const { a, b } = state;
    const fx = cur().fx(a, b),
      fy = cur().fy(a, b);
    const g = Math.hypot(fx, fy);
    const CXC = col('x', 1),
      CYC = col('y', 1),
      CUC = col('u', 1),
      CG = GRAD(1);
    const w = state.which;
    const du = slope('u');
    const th = Math.round(state.theta);
    if (w === 'u')
      setEq({
        rule: [['D_{\\mathbf u}f', CUC], '=', ['\\nabla f', CG], '\\cdot\\mathbf u=', ['\\tfrac{\\partial f}{\\partial x}', CXC], '\\cos\\theta+', ['\\tfrac{\\partial f}{\\partial y}', CYC], '\\sin\\theta'],
        live: [[`D_{\\mathbf u}f = ${signed(du)}`, CUC], `=`, [signed(fx), CXC], `\\cos ${th}^\\circ`, [signed(fy), CYC], `\\sin ${th}^\\circ`, '\\quad', [`|\\nabla f| = ${fmt(g)}`, CG]],
      });
    else
      setEq({
        rule: [['\\nabla f', CG], '(x,y)=\\Big(', ['\\frac{\\partial f}{\\partial x}', CXC], ',', ['\\frac{\\partial f}{\\partial y}', CYC], '\\Big)'],
        live: [[`\\nabla f(${fmt(a)},${fmt(b)})`, CG], '=\\Big(', [signed(fx), CXC], ',', [signed(fy), CYC], '\\Big)', `\\quad f = ${fmt(cur().f(a, b))}`],
      });
    setRows({ rx: signed(fx), ry: signed(fy), ru: signed(du), rf: fmt(cur().f(a, b)), rg: fmt(g) });
    const s = slope(w);
    const way = Math.abs(s) < 5e-4 ? 'flat' : s > 0 ? 'uphill' : 'downhill';
    if (w === 'u') {
      el('result-label').textContent = 'Dᵤf at your point';
      const ang = g > 1e-4 ? Math.round((Math.acos(Math.max(-1, Math.min(1, du / g))) * 180) / Math.PI) : null;
      setResult({
        value: signed(du),
        colour: CUC,
        status: ang === null
          ? `${way} along u at θ = ${th}° · ∇f = 0 here, so every direction is flat`
          : `${way} along u at θ = ${th}° · ${ang}° from ∇f, whose length is ${fmt(g)}`,
        note: 'Dᵤf = |∇f| cos(angle): largest straight up the gradient, zero across it along the level curve, most negative straight down.',
      });
    } else {
      el('result-label').textContent = `∂f/∂${w} at your point`;
      setResult({
        value: signed(s),
        colour: col(w, 1),
        status: `${way} along ${w} at (${fmt(a)}, ${fmt(b)}), with ${other(w)} frozen at ${fmt(w === 'x' ? b : a)} · ${cur().eq}`,
        note: 'Each partial is the slope of the curve its own plane cuts, with the other variable frozen. Together they make ∇f, which gives the slope in every other direction too.',
      });
    }
  }

  // --- controls -------------------------------------------------------------
  const sliceSeg = segmented('slice', (w) => {
    state.which = w as Which;
    draw();
  });
  function select(w: Which) {
    state.which = w;
    sliceSeg.select(w);
    draw();
  }
  const surfSeg = segmented('surf', (s) => {
    state.surf = s;
    calibrate();
    draw();
  });
  const two = (v: number) => v.toFixed(2).replace('-', '−');
  const setA = slider('a', (v) => { state.a = v; draw(); }, two);
  const setB = slider('b', (v) => { state.b = v; draw(); }, two);
  // turning u is walking along u, so the slider switches to that slice
  const setTheta = slider('theta', (v) => { state.theta = v; select('u'); }, (v) => `${v}°`);
  check('tplane', (on) => { state.tplane = on; draw(); });

  // click a slice to select it: its curve first, then anywhere on its plane
  function tap(x: number, y: number) {
    let best: { w: Which; d: number } | null = null;
    for (const w of shown())
      for (const p of trace(w, 60).map(px)) {
        if (p.d < 0.4) continue;
        const d = Math.hypot(p.x - x, p.y - y);
        if (!best || d < best.d) best = { w, d };
      }
    if (best && best.d < 44) return select(best.w);

    let near: { w: Which; d: number } | null = null;
    for (const w of shown()) {
      const q = planeCorners(w).map(px);
      if (q.some((p) => p.d < 0.4)) continue;
      if (!inside(q, x, y)) continue;
      const d = q.reduce((s, p) => s + p.d, 0) / 4;
      if (!near || d < near.d) near = { w, d };
    }
    if (near) select(near.w);
  }

  function show(surf: string, a: number, b: number, w: Which, theta = state.theta) {
    state.surf = surf;
    surfSeg.select(surf);
    calibrate();
    state.a = a;
    setA(a);
    state.b = b;
    setB(b);
    state.theta = theta;
    setTheta(theta);
    select(w);
  }

  // on the Hill at (0.6, −0.6) the gradient points at 135°, the level curve at 45°
  tries({
    slice: () => show('bowl', 0.8, -0.6, 'x'),
    twist: () => show('twist', 0.6, -0.8, 'x'),
    peak: () => show('hill', 0.6, -0.6, 'u', 135),
    level: () => show('hill', 0.6, -0.6, 'u', 45),
  });

  orbit(canvas, cam, draw, { onTap: tap });

  calibrate();
  draw();
</script>

<style>
  .pd-canvas {
    cursor: grab;
    touch-action: none;
  }
  .pd-canvas:active {
    cursor: grabbing;
  }
</style>
