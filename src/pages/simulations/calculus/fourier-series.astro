---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Checks from '../../../components/sim/Checks.astro';
import Transport from '../../../components/sim/Transport.astro';
import Actions from '../../../components/sim/Actions.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
---

<SimLayout
  areaSlug="calculus"
  title="Fourier Series"
  description="Any periodic wave is a sum of pure sines. Stack them as turning wheels and the tip traces a square, sawtooth or triangle wave as you add harmonics."
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas id="fourier" width="900" height="460" role="img" aria-label="A chain of turning circles, one per harmonic, whose final tip draws the target wave on the right."></canvas>
      </div>
      <Caption
        legend={[{ label: 'the wheels, one per harmonic', color: '#7c8cff' }, { label: 'the wave their tip draws', color: '#5eead4' }]}
        hint="Each wheel's radius is that sine's amplitude, and it spins k times as fast as the first"
      />
      <Result label="Harmonics" />
    </div>
    <div class="sim-panel">
      <Seg id="wave" label="Target wave" attr="w" options={[{ value: 'square', label: 'Square' }, { value: 'saw', label: 'Sawtooth' }, { value: 'triangle', label: 'Triangle' }]} />
      <Transport running />
      <Slider id="n" label="Harmonics" min={1} max={40} value={4} />
      <Slider id="sp" label="Speed" min={0} max={30} value={10} display="1.0" />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      A single circle traces a <b>pure sine</b>. Each harmonic you add sharpens
      the corners, and the flat parts flatten, closing in on the target wave.
    </li>
    <li>
      Near every jump a small <b>overshoot</b> refuses to disappear however many
      harmonics you add: that is the <b>Gibbs phenomenon</b>.
    </li>
    <li>
      The <b>triangle</b> wave's amplitudes fall off like 1/k², far faster than
      the square's 1/k, so it converges to a clean shape with only a handful of
      circles.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { el, segmented, slider, check, transport, result, readout } from '../../../lib/panel';

  type Harm = { k: number; amp: number };
  function harmonics(wave: string, N: number): Harm[] {
    const out: Harm[] = [];
    if (wave === 'square') {
      for (let i = 0; i < N; i++) {
        const k = 2 * i + 1;
        out.push({ k, amp: (4 / Math.PI) / k });
      }
    } else if (wave === 'saw') {
      for (let k = 1; k <= N; k++) {
        out.push({ k, amp: ((2 / Math.PI) * (-1) ** (k + 1)) / k });
      }
    } else {
      for (let i = 0; i < N; i++) {
        const k = 2 * i + 1;
        out.push({ k, amp: ((8 / Math.PI ** 2) * (-1) ** i) / (k * k) });
      }
    }
    return out;
  }

  const state = { wave: 'square', n: 4, speed: 1, running: true };
  let t = 0;
  let history: number[] = [];

  const setEq = equation();
  const setResult = result();
  const canvas = el('fourier') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas);
  const css = (v: string) => getComputedStyle(canvas).getPropertyValue(v).trim();

  const CX = 210;
  const CY = H / 2;
  const TRACE_X = 360;
  const DX = 2;
  const MAXH = Math.floor((W - TRACE_X - 16) / DX);

  function firstAmp() {
    return Math.abs(harmonics(state.wave, 1)[0].amp);
  }

  function draw() {
    const accent = css('--accent') || '#7c8cff';
    const teal = css('--accent-2') || '#5eead4';
    const grid = css('--border') || '#262a32';
    const ink = css('--stage-ink') || '232,233,236';
    ctx.clearRect(0, 0, W, H);

    const SCALE = 108 / firstAmp();
    const hs = harmonics(state.wave, state.n);
    setEq({
      rule: [['f(t)', teal], '=', ['\\sum_k a_k\\sin(k\\,t)', accent], '\\quad\\text{one turning wheel per }k'],
      live: [[`k = ${hs.slice(0, 8).map((h) => h.k).join(',\\,')}${hs.length > 8 ? ',\\,\\dots' : ''}`, accent], `\\quad a_k \\propto ${state.wave === 'triangle' ? '1/k^2' : '1/k'}`],
    });
    setResult({
      value: String(state.n),
      colour: accent,
      status: `${state.wave} wave · ${state.n} wheel${state.n > 1 ? 's' : ''}, the largest turning once per cycle and the smallest ${hs[hs.length - 1].k} times`,
      note: state.n < 4
        ? 'With only a few sines the corners are soft and the flat parts wobble. Add harmonics and watch the wave sharpen.'
        : 'Every wheel is one pure sine. The overshoot next to a jump never fully goes away however many you add: that is the Gibbs phenomenon.',
    });

    // baseline
    ctx.strokeStyle = grid;
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(TRACE_X, CY);
    ctx.lineTo(W - 12, CY);
    ctx.stroke();

    // epicycles
    let x = CX;
    let y = CY;
    for (const h of hs) {
      const r = Math.abs(h.amp) * SCALE;
      const phi = h.k * t + (h.amp < 0 ? Math.PI : 0);
      ctx.strokeStyle = `rgba(${ink},0.22)`;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(x, y, r, 0, Math.PI * 2);
      ctx.stroke();
      const nx = x + r * Math.cos(phi);
      const ny = y + r * Math.sin(phi);
      ctx.strokeStyle = `rgba(${ink},0.8)`;
      ctx.lineWidth = 1.4;
      ctx.beginPath();
      ctx.moveTo(x, y);
      ctx.lineTo(nx, ny);
      ctx.stroke();
      x = nx;
      y = ny;
    }

    // connector from tip to the trace
    ctx.strokeStyle = 'rgba(124,140,255,0.5)';
    ctx.lineWidth = 1;
    ctx.setLineDash([3, 3]);
    ctx.beginPath();
    ctx.moveTo(x, y);
    ctx.lineTo(TRACE_X, y);
    ctx.stroke();
    ctx.setLineDash([]);

    // tip dot
    ctx.fillStyle = accent;
    ctx.beginPath();
    ctx.arc(x, y, 3.5, 0, Math.PI * 2);
    ctx.fill();

    // traced wave (newest at the left, scrolling right)
    ctx.strokeStyle = teal;
    ctx.lineWidth = 2.2;
    ctx.beginPath();
    for (let i = 0; i < history.length; i++) {
      const px = TRACE_X + i * DX;
      const py = history[i];
      i === 0 ? ctx.moveTo(px, py) : ctx.lineTo(px, py);
    }
    ctx.stroke();

    return y;
  }

  function frame() {
    const tipY = draw();
    if (state.running) {
      history.unshift(tipY);
      if (history.length > MAXH) history.pop();
      t += 0.012 * state.speed;
    }
    requestAnimationFrame(frame);
  }

  segmented('wave', (w) => {
    state.wave = w;
    history = [];
    t = 0;
  });
  slider('n', (v) => (state.n = v));
  slider('sp', (v) => (state.speed = v / 10), (v) => (v / 10).toFixed(1));
  transport({
    onRun: (running) => (state.running = running),
    onReset: () => {
      history = [];
      t = 0;
    },
  });

  requestAnimationFrame(frame);
</script>
