---
import SimLayout from '../../../layouts/SimLayout.astro';
---

<SimLayout
  areaSlug="calculus"
  title="The Chain Rule"
  description="Push one small step through two machines in a row. The first stretches it, the second stretches whatever comes out, and stretching twice means multiplying the two factors. That is the whole chain rule, and it also shows why the second factor has to be read at u = g(x)."
>
  <div class="sim">
    <div class="sim-stage">
      <canvas id="cr" class="cr-canvas" width="900" height="500"></canvas>
    </div>

    <div class="sim-panel">
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <button class="btn" id="run">Push a step through</button>
        <button class="btn ghost" id="reset">Reset</button>
      </div>

      <div class="control">
        <label>The chain f(g(x))</label>
        <div class="seg" id="pair">
          <button data-p="0" class="active">sin(x²)</button>
          <button data-p="1">(1.4+sin x)²</button>
          <button data-p="2">√(1+x²)</button>
        </div>
      </div>

      <div class="control">
        <label>Point x <b id="xval">1.00</b></label>
        <input type="range" id="x" min="0" max="100" value="40" />
      </div>

      <div class="control">
        <label>Step h <b id="hval">0.100</b></label>
        <input type="range" id="h" min="0" max="100" value="50" />
        <div class="scale-hint"><span>0.30</span><span>0.003</span></div>
      </div>

      <div class="readout">
        <div class="row"><span>u = g(x)</span><b id="rU">—</b></div>
        <div class="row"><span>g stretches by g′(x)</span><b id="rG">—</b></div>
        <div class="row"><span>f stretches by f′(u)</span><b id="rF">—</b></div>
        <div class="row"><span>the two multiplied</span><b id="rT">—</b></div>
      </div>

      <p class="note">
        All three bars are drawn to one scale, so a bar that comes out longer
        really did get stretched.
      </p>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Press <b>Push a step through</b>. One step goes in at the top and comes out
      at the bottom having been stretched <b>twice</b>. The funnels are the two
      stretches; a chain rule is just those two numbers multiplied.
    </li>
    <li>
      Look at the second machine in the panel on the right. Its dot sits at
      <b>u = g(x)</b>, never at x. The second machine has no idea what x was, it
      only ever sees what the first one handed it, which is exactly why the rule
      says f′(g(x)) and not f′(x).
    </li>
    <li>
      Shrink <b>h</b>. All three bars shrink together but the two funnels keep
      the same shape, and the multiplied number stops moving. A derivative is a
      magnification factor, and magnification does not care how small the thing
      being magnified is.
    </li>
    <li>
      On <b>sin(x²)</b> slide x to about 1.25, where f stretches by zero. The
      bottom bar collapses even though the middle one is still growing hard: a
      chain is as dead as its deadest link.
    </li>
    <li>
      Push past that point and one factor goes <b>negative</b>. Its funnel
      crosses over and the bar below flips to the other side. Two flips in a row
      cancel, exactly as multiplying two negatives promises.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equationBar } from '../../../lib/equation';
  import { roundRect } from '../../../lib/theorem';

  type Pair = {
    g: (x: number) => number;
    dg: (x: number) => number;
    gl: string;
    f: (u: number) => number;
    df: (u: number) => number;
    fl: string;
    x0: number;
    x1: number;
  };

  const HMAX = 0.3;
  const PAIRS: Pair[] = [
    {
      g: (x) => x * x,
      dg: (x) => 2 * x,
      gl: 'g(x) = x²',
      f: (u) => Math.sin(u),
      df: (u) => Math.cos(u),
      fl: 'f(u) = sin u',
      x0: 0.3,
      x1: 2.2,
    },
    {
      g: (x) => 1.4 + Math.sin(x),
      dg: (x) => Math.cos(x),
      gl: 'g(x) = 1.4 + sin x',
      f: (u) => u * u,
      df: (u) => 2 * u,
      fl: 'f(u) = u²',
      x0: 0.2,
      x1: 4,
    },
    {
      g: (x) => 1 + x * x,
      dg: (x) => 2 * x,
      gl: 'g(x) = 1 + x²',
      f: (u) => Math.sqrt(u),
      df: (u) => 0.5 / Math.sqrt(u),
      fl: 'f(u) = √u',
      x0: 0.2,
      x1: 2,
    },
  ];

  const state = { pi: 0, xs: 40, hs: 50, tau: 1, playing: false };
  const P = () => PAIRS[state.pi];
  const hFull = () => HMAX * Math.pow(10, -state.hs / 50);
  const hOf = () => hFull() * state.tau;
  const xOf = () => P().x0 + ((P().x1 - P().x0) * state.xs) / 100;

  const setEq = equationBar();
  const canvas = document.getElementById('cr') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const css = (n: string, f = '') =>
    getComputedStyle(canvas).getPropertyValue(n).trim() || f;
  const ink = (a: number) => `rgba(${css('--stage-ink', '232,233,236')},${a})`;
  const inv = (a: number) => `rgba(${css('--stage-ink-inv', '13,14,18')},${a})`;
  const { label } = makeText(ctx, ink);
  const fmt = (v: number, n = 3) =>
    (Math.abs(v) < 5e-4 ? 0 : v).toFixed(n).replace('-', '−');
  /** Short form for the bar lengths, which run from 0.3 down to 0.000003. */
  const tiny = (v: number) => {
    const a = Math.abs(v);
    const s = a < 0.001 ? a.toExponential(1) : a.toPrecision(3);
    return (v < 0 ? '−' : '') + s;
  };

  // g's stretch is indigo, f's is amber, the two together are teal
  const GC = '124,140,255',
    FC = '245,158,11',
    TC = '52,211,153';
  const rgba = (c: string, a: number) => `rgba(${c},${a})`;

  const ROW = [136, 266, 396];
  const CX = 330; // every bar starts here, so their lengths compare directly
  const CARD = { x: 616, y: 20, w: 260, h: 456 };

  // --- the three bars and the two funnels -----------------------------------
  function measure() {
    const p = P(),
      x = xOf(),
      h = hOf();
    const u = p.g(x);
    const du = p.g(x + h) - u;
    const y = p.f(u);
    const dy = p.f(u + du) - y;
    return { p, x, h, u, du, y, dy };
  }

  /** One scale for all three bars, fixed by the full step so nothing jumps. */
  function scale() {
    const p = P(),
      x = xOf(),
      hF = hFull();
    const u = p.g(x);
    const duF = p.g(x + hF) - u;
    const dyF = p.f(u + duF) - p.f(u);
    const mx = Math.max(Math.abs(hF), Math.abs(duF), Math.abs(dyF), 1e-15);
    return 205 / mx;
  }

  function bar(y: number, len: number, colour: string, name: string, value: string) {
    const x1 = CX + len;
    ctx.strokeStyle = rgba(colour, 0.95);
    ctx.lineWidth = 16;
    ctx.lineCap = 'butt';
    ctx.beginPath();
    ctx.moveTo(CX, y);
    ctx.lineTo(x1, y);
    ctx.stroke();
    label(name, 152, y + 5, 0.85, 'right', 13);
    label(value, (CX + x1) / 2, y - 16, 1, 'center', 11.5, rgba(colour, 0.95));
    return x1;
  }

  /** The trapezoid carrying one bar's ends down onto the next. */
  function funnel(
    yTop: number,
    yBot: number,
    xTop: number,
    xBot: number,
    colour: string,
    factor: number,
    caption: string
  ) {
    ctx.beginPath();
    ctx.moveTo(CX, yTop + 8);
    ctx.lineTo(xTop, yTop + 8);
    ctx.lineTo(xBot, yBot - 8);
    ctx.lineTo(CX, yBot - 8);
    ctx.closePath();
    ctx.fillStyle = rgba(colour, 0.05);
    ctx.fill();
    ctx.strokeStyle = rgba(colour, 0.5);
    ctx.lineWidth = 1.4;
    ctx.setLineDash([5, 4]);
    ctx.beginPath();
    ctx.moveTo(xTop, yTop + 8);
    ctx.lineTo(xBot, yBot - 8);
    ctx.moveTo(CX, yTop + 8);
    ctx.lineTo(CX, yBot - 8);
    ctx.stroke();
    ctx.setLineDash([]);

    const my = (yTop + yBot) / 2;
    label(caption, 152, my - 8, 0.45, 'right', 11);
    label(`× ${fmt(factor)}`, 152, my + 16, 1, 'right', 18, rgba(colour, 1));
  }

  function drawFlow() {
    const { p, h, du, dy } = measure();
    const S = scale();

    label('ONE STEP, PUSHED THROUGH BOTH MACHINES', 24, 44, 0.5, 'left', 12);
    label(
      'one scale for all three, so a longer bar really was stretched',
      24,
      64,
      0.32,
      'left',
      11
    );

    const xh = CX + h * S,
      xu = CX + du * S,
      xy = CX + dy * S;
    funnel(ROW[0], ROW[1], xh, xu, GC, du / (h || 1e-15), 'g stretches it');
    funnel(ROW[1], ROW[2], xu, xy, FC, dy / (du || 1e-15), 'f stretches that');

    bar(ROW[0], h * S, css('--stage-ink', '232,233,236'), 'the step h', tiny(h));
    bar(ROW[1], du * S, GC, 'Δu into f', tiny(du));
    bar(ROW[2], dy * S, TC, 'Δy out', tiny(dy));

    // the common starting point, and what the whole chain did to the step
    ctx.fillStyle = ink(0.5);
    for (const y of ROW) {
      ctx.beginPath();
      ctx.arc(CX, y, 3.5, 0, Math.PI * 2);
      ctx.fill();
    }
    label('start', CX, ROW[0] - 40, 0.3, 'center', 10.5);
    label(
      `the whole chain: × ${fmt(dy / (h || 1e-15))}`,
      24,
      ROW[2] + 56,
      0.75,
      'left',
      12,
      rgba(TC, 0.95)
    );
    label(
      `heading for × ${fmt(p.df(p.g(xOf())) * p.dg(xOf()))} as h → 0`,
      24,
      ROW[2] + 76,
      0.4,
      'left',
      11
    );
  }

  // --- the card: the two machines, each read at its own point ---------------
  function machine(
    box: { x: number; y: number; w: number; h: number },
    fn: (t: number) => number,
    df: (t: number) => number,
    t0: number,
    t1: number,
    at: number,
    colour: string,
    title: string,
    formula: string,
    axis: string
  ) {
    let lo = Infinity,
      hi = -Infinity;
    for (let i = 0; i <= 160; i++) {
      const v = fn(t0 + ((t1 - t0) * i) / 160);
      lo = Math.min(lo, v);
      hi = Math.max(hi, v);
    }
    const pad = (hi - lo) * 0.16 || 1;
    lo -= pad;
    hi += pad;
    const X = (t: number) => box.x + ((t - t0) / (t1 - t0)) * box.w;
    const Y = (v: number) => box.y + box.h - ((v - lo) / (hi - lo)) * box.h;

    label(title, box.x, box.y - 26, 0.42, 'left', 10.5);
    label(formula, box.x, box.y - 8, 1, 'left', 12, rgba(colour, 0.95));

    ctx.strokeStyle = ink(0.1);
    ctx.lineWidth = 1;
    ctx.strokeRect(box.x, box.y, box.w, box.h);

    ctx.save();
    ctx.beginPath();
    ctx.rect(box.x, box.y, box.w, box.h);
    ctx.clip();

    ctx.strokeStyle = ink(0.55);
    ctx.lineWidth = 2;
    ctx.beginPath();
    for (let i = 0; i <= 200; i++) {
      const t = t0 + ((t1 - t0) * i) / 200;
      i ? ctx.lineTo(X(t), Y(fn(t))) : ctx.moveTo(X(t), Y(fn(t)));
    }
    ctx.stroke();

    // the tangent there: the stretch factor, drawn
    const m = df(at),
      v0 = fn(at);
    const sxu = (t1 - t0) / box.w,
      syu = (hi - lo) / box.h;
    ctx.strokeStyle = rgba(colour, 0.95);
    ctx.lineWidth = 2.2;
    ctx.beginPath();
    ctx.moveTo(X(at) - 46, Y(v0) + 46 * (m * sxu) / syu);
    ctx.lineTo(X(at) + 46, Y(v0) - 46 * (m * sxu) / syu);
    ctx.stroke();
    ctx.restore();

    // where on its own axis this machine is being read
    ctx.strokeStyle = rgba(colour, 0.5);
    ctx.lineWidth = 1;
    ctx.setLineDash([3, 3]);
    ctx.beginPath();
    ctx.moveTo(X(at), Y(v0));
    ctx.lineTo(X(at), box.y + box.h + 6);
    ctx.stroke();
    ctx.setLineDash([]);

    ctx.fillStyle = rgba(colour, 1);
    ctx.strokeStyle = inv(0.7);
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(X(at), Y(v0), 5, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();

    label(axis, box.x + box.w, box.y + box.h + 22, 0.45, 'right', 10.5);
    return m;
  }

  function drawCard() {
    const { p, x, u } = measure();
    ctx.save();
    roundRect(ctx, CARD.x, CARD.y, CARD.w, CARD.h, 12);
    ctx.fillStyle = ink(0.04);
    ctx.fill();
    ctx.strokeStyle = ink(0.12);
    ctx.lineWidth = 1;
    ctx.stroke();
    ctx.clip();

    const bx = CARD.x + 18,
      bw = CARD.w - 36;
    let ul = Infinity,
      uh = -Infinity;
    for (let i = 0; i <= 120; i++) {
      const g = p.g(p.x0 + ((p.x1 + HMAX - p.x0) * i) / 120);
      ul = Math.min(ul, g);
      uh = Math.max(uh, g);
    }
    // breathing room, so the operating point never lands on the frame
    const upad = (uh - ul) * 0.07;
    ul -= upad;
    uh += upad;

    machine(
      { x: bx, y: CARD.y + 62, w: bw, h: 104 },
      p.g,
      p.dg,
      p.x0,
      p.x1 + HMAX,
      x,
      GC,
      'MACHINE 1, READ AT x',
      p.gl,
      'x'
    );
    label(
      `slope here = ${fmt(p.dg(x))}`,
      bx,
      CARD.y + 194,
      1,
      'left',
      11.5,
      rgba(GC, 0.95)
    );

    machine(
      { x: bx, y: CARD.y + 274, w: bw, h: 104 },
      p.f,
      p.df,
      ul,
      uh,
      u,
      FC,
      'MACHINE 2, READ AT u',
      p.fl,
      'u'
    );
    label(
      `slope here = ${fmt(p.df(u))}`,
      bx,
      CARD.y + 406,
      1,
      'left',
      11.5,
      rgba(FC, 0.95)
    );
    label(
      `u = ${fmt(u, 2)} here, not x = ${fmt(x, 2)}`,
      bx,
      CARD.y + 430,
      0.45,
      'left',
      10.5
    );
    ctx.restore();
  }


  function draw() {
    ctx.clearRect(0, 0, W, H);
    drawFlow();
    drawCard();
    sync();
  }

  function sync() {
    const { p, x, u } = measure();
    const g1 = p.dg(x),
      f1 = p.df(u);
    setEq([
      [
        ["(f\\circ g)'(x)", `rgb(${TC})`],
        '=',
        ["f'(g(x))", `rgb(${FC})`],
        '\\cdot',
        ["g'(x)", `rgb(${GC})`],
      ],
      [
        [fmt(g1 * f1), `rgb(${TC})`],
        '=',
        [fmt(f1), `rgb(${FC})`],
        '\\times',
        [fmt(g1), `rgb(${GC})`],
      ],
      [
        'one step, stretched once by g and then again by f, so the two factors multiply',
      ],
    ]);
    const set = (id: string, v: string) =>
      ((document.getElementById(id) as HTMLElement).textContent = v);
    set('rU', fmt(u, 4));
    set('rG', fmt(p.dg(x), 4));
    set('rF', fmt(p.df(u), 4));
    set('rT', fmt(p.dg(x) * p.df(u), 4));
    set('xval', x.toFixed(2));
    const h = hFull();
    set('hval', h < 0.01 ? h.toExponential(1) : h.toFixed(3));
  }

  // --- controls -------------------------------------------------------------
  const el = (id: string) => document.getElementById(id) as HTMLElement;
  const runBtn = el('run');
  let raf = 0,
    t0 = 0;

  function stop() {
    state.playing = false;
    runBtn.textContent = 'Push a step through';
    cancelAnimationFrame(raf);
    state.tau = 1;
  }
  function loop(now: number) {
    if (!state.playing) return;
    const cycle = ((now - t0) / 1000) % 2.2;
    state.tau = cycle < 1.4 ? 0.02 + 0.98 * (cycle / 1.4) : 1;
    draw();
    raf = requestAnimationFrame(loop);
  }
  runBtn.addEventListener('click', () => {
    if (state.playing) {
      stop();
      draw();
      return;
    }
    state.playing = true;
    runBtn.textContent = 'Stop';
    t0 = performance.now();
    raf = requestAnimationFrame(loop);
  });
  el('reset').addEventListener('click', () => {
    stop();
    state.xs = 40;
    (el('x') as HTMLInputElement).value = '40';
    setH(50);
  });

  el('pair').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (!b) return;
    document
      .querySelectorAll('#pair button')
      .forEach((n) => n.classList.remove('active'));
    b.classList.add('active');
    state.pi = +b.dataset.p!;
    draw();
  });

  const xEl = el('x') as HTMLInputElement,
    hEl = el('h') as HTMLInputElement;
  xEl.addEventListener('input', () => {
    state.xs = +xEl.value;
    draw();
  });
  function setH(v: number) {
    state.hs = v;
    hEl.value = String(v);
    draw();
  }
  hEl.addEventListener('input', () => {
    state.tau = 1;
    setH(+hEl.value);
  });

  setH(50);
</script>

<style>
  .cr-canvas {
    touch-action: none;
  }
  .scale-hint {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: var(--text-faint);
    margin-top: 3px;
  }
  #pair button {
    font-size: 0.78rem;
    padding: 5px 9px;
  }
  .note {
    font-size: 0.82rem;
    color: var(--text-faint);
    margin: 0;
    line-height: 1.55;
  }
</style>
