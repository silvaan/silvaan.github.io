---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Checks from '../../../components/sim/Checks.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="calculus"
  title="Differential Equations"
  description="An equation that gives you the slope instead of the value. Draw that slope everywhere and the plane fills with little segments; drop a point anywhere and the solution threads itself through them. Then take steps too big and watch Euler's method drift off the truth."
  shortcuts={['run', 'reset', 'fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas id="ode" width="880" height="620" role="img" aria-label="A slope field with the solution curve through a draggable start point, and optionally the whole family of solutions, isoclines, Euler's steps and particles riding the field."></canvas>
      </div>
      <Caption
        legend={[{ label: 'the solution through your point', color: '#7c8cff' }, { label: 'particles riding the field', color: '#2dd4bf' }, { label: "Euler's steps", color: '#f9736a' }]}
        hint="Drag the start point anywhere on the plane"
      />
      <Result label="Slope at the start point" />
    </div>
    <div class="sim-panel">
      <Transport />
      <Seg id="eq" label="The equation y′ =" attr="k" options={[{ value: 'linear', label: 'x − y' }, { value: 'growth', label: 'y' }, { value: 'logistic', label: 'y(1 − y)' }, { value: 'circle', label: '−x / y' }, { value: 'sep', label: 'x · y' }, { value: 'wave', label: 'sin x − y/2' }]} />
      <Slider id="x0" label="Start x₀" min={-4.3} max={4.3} step={0.05} value={-4} display="−4.00" />
      <Slider id="y0" label="Start y₀" min={-3.1} max={3.1} step={0.05} value={2.2} display="2.20" />
      <Slider id="h" label="Euler step h" min={5} max={120} value={60} display="0.60" hint={['tiny, faithful', 'huge, wrong']} />
      <Checks label="Show" items={[{ id: 'field', label: 'Slope field', checked: true }, { id: 'family', label: 'The whole family of solutions' }, { id: 'iso', label: 'Isoclines, where the slope is constant' }, { id: 'euler', label: "Euler's method, step by step" }, { id: 'flow', label: 'Particles flowing along the field' }]} />
      <Readout rows={[{ id: 'stepOut', label: 'Euler steps' }, { id: 'errOut', label: 'Euler error at the end' }, { id: 'liveOut', label: 'solution exists until' }]} />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Drag the dot: the bright curve stays <b>tangent to every segment</b> it
      passes. Turn on the family and each curve is the same rule from a
      different start, which is the <b>+ C</b>. <Try id="family" />
    </li>
    <li>
      Let the <b>particles</b> loose on <b>x − y</b>: dots from every height pile
      onto the line y = x − 1. The solutions <b>forget where they started</b>. <Try id="forget" />
    </li>
    <li>
      On <b>y(1 − y)</b> the particles empty out of y = 0 and crowd into y = 1.
      Both lines are solutions that never move: an <b>unstable and a stable
      equilibrium</b>. <Try id="equilibria" />
    </li>
    <li>
      Turn on <b>Euler's method</b> with a big h: each hop commits to the slope
      where it starts, so the red path drifts off the true curve. Shrink h and
      the gap closes. <Try id="euler" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { el, segmented, slider, check, transport, result, readout, tries } from '../../../lib/panel';

  // ---------------------------------------------------------------------------
  // A first-order ODE y' = f(x,y) does not hand over a curve, it hands over a
  // slope at every point of the plane. Draw that slope everywhere and the
  // equation becomes a field of segments; a solution is any curve that stays
  // tangent to it. Everything here is that one idea: the field, the curves that
  // thread it, and what goes wrong when you follow it in steps that are too big
  // to still be tangent.
  // ---------------------------------------------------------------------------

  type F = (x: number, y: number) => number;

  interface Preset {
    key: string;
    tex: string;
    f: F;
    start: { x: number; y: number };
    note: string;
  }

  const PRESETS: Preset[] = [
    {
      key: 'linear',
      tex: "y' = x - y",
      f: (x, y) => x - y,
      start: { x: -4, y: 2.2 },
      note: 'every solution is dragged onto the line y = x - 1 and forgets where it started',
    },
    {
      key: 'growth',
      tex: "y' = y",
      f: (_x, y) => y,
      start: { x: -3, y: 0.25 },
      note: 'growth proportional to what is already there, which is what makes an exponential',
    },
    {
      key: 'logistic',
      tex: "y' = y\\,(1 - y)",
      f: (_x, y) => y * (1 - y),
      start: { x: -4, y: 0.08 },
      note: 'two equilibria: one that everything runs away from, one that everything runs into',
    },
    {
      key: 'circle',
      tex: "y' = -x/y",
      f: (x, y) => -x / y,
      start: { x: 0, y: 2.4 },
      note: 'the solutions are circles, and no single function of x can cover a whole one',
    },
    {
      key: 'sep',
      tex: "y' = x\\,y",
      f: (x, y) => x * y,
      start: { x: -2.6, y: 0.5 },
      note: 'separable: dy/y = x dx, so the solutions are bell curves in disguise',
    },
    {
      key: 'wave',
      tex: "y' = \\sin x - y/2",
      f: (x, y) => Math.sin(x) - y / 2,
      start: { x: -4, y: 2.6 },
      note: 'a forced decay: the memory of the start fades away, the driving never does',
    },
  ];

  const state = {
    preset: PRESETS[0],
    x0: -4,
    y0: 2.2,
    h: 0.6,
    field: true,
    family: false,
    iso: false,
    euler: false,
    flow: false,
    running: false,
  };

  /** Slopes go to infinity in perfectly ordinary equations, so cap them. */
  const CAP = 60;
  function slope(x: number, y: number) {
    const m = state.preset.f(x, y);
    if (!Number.isFinite(m)) return m > 0 || Object.is(m, Infinity) ? CAP : -CAP;
    return Math.max(-CAP, Math.min(CAP, m));
  }

  // --- canvas ----------------------------------------------------------------

  const canvas = el('ode') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const cssv = (n: string) => getComputedStyle(canvas).getPropertyValue(n).trim();
  const inkRGB = () => cssv('--stage-ink') || '232,233,236';
  const inkA = (a: number) => `rgba(${inkRGB()},${a})`;
  const { label } = makeText(ctx, inkA);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  const ACC = '#7c8cff'; // the chosen solution
  /** The zero isocline and the particles: bright on the dark stage, deeper on paper. */
  const teal = (a: number) => `rgba(${cssv('--stage-light') === '1' ? '13,148,136' : '94,234,212'},${a})`;
  const HOT = '#f9736a'; // Euler, going wrong

  const XMIN = -4.4, XMAX = 4.4, YMIN = -3.2, YMAX = 3.2;
  const P = { x: 52, y: 20, w: W - 76, h: H - 54 };
  const sx = (x: number) => P.x + ((x - XMIN) / (XMAX - XMIN)) * P.w;
  const sy = (y: number) => P.y + P.h - ((y - YMIN) / (YMAX - YMIN)) * P.h;
  const wxOf = (px: number) => XMIN + ((px - P.x) / P.w) * (XMAX - XMIN);
  const wyOf = (py: number) => YMIN + ((P.y + P.h - py) / P.h) * (YMAX - YMIN);

  // --- integration -----------------------------------------------------------

  function rk4(x: number, y: number, h: number) {
    const k1 = slope(x, y);
    const k2 = slope(x + h / 2, y + (h * k1) / 2);
    const k3 = slope(x + h / 2, y + (h * k2) / 2);
    const k4 = slope(x + h, y + h * k3);
    return y + (h / 6) * (k1 + 2 * k2 + 2 * k3 + k4);
  }

  const OUT = 6; // how far past the window a curve may wander before we drop it

  /** March from a point until the curve leaves the window or blows up. */
  function integrate(x: number, y: number, dir: 1 | -1) {
    const h = 0.02 * dir;
    const pts: { x: number; y: number }[] = [{ x, y }];
    let cx = x, cy = y;
    for (let k = 0; k < 900; k++) {
      const ny = rk4(cx, cy, h);
      if (!Number.isFinite(ny) || Math.abs(ny) > OUT) break;
      // A near-vertical field means y is racing while x crawls: stop rather
      // than draw a lie. This is where "y as a function of x" gives out.
      if (Math.abs(ny - cy) > 0.6) break;
      cx += h;
      cy = ny;
      pts.push({ x: cx, y: cy });
      if (cx < XMIN - 0.1 || cx > XMAX + 0.1) break;
    }
    return pts;
  }

  function solutionThrough(x: number, y: number) {
    const back = integrate(x, y, -1).reverse();
    const fwd = integrate(x, y, 1);
    return back.concat(fwd.slice(1));
  }

  function eulerFrom(x: number, y: number, h: number) {
    const pts: { x: number; y: number }[] = [{ x, y }];
    let cx = x, cy = y;
    while (cx < XMAX && pts.length < 400) {
      cy = cy + h * slope(cx, cy);
      cx = cx + h;
      if (!Number.isFinite(cy)) break;
      pts.push({ x: cx, y: Math.max(-OUT, Math.min(OUT, cy)) });
      if (Math.abs(cy) > OUT) break;
    }
    return pts;
  }

  // --- contours (isoclines) --------------------------------------------------
  // Marching squares over the sign of f - level. Two crossings give a segment,
  // four give two, which is close enough for a drawing.

  function contour(level: number, N = 72) {
    const segs: number[][] = [];
    const dx = (XMAX - XMIN) / N;
    const dy = (YMAX - YMIN) / N;
    for (let i = 0; i < N; i++) {
      for (let j = 0; j < N; j++) {
        const ax = XMIN + i * dx, ay = YMIN + j * dy;
        const bx = ax + dx, by = ay + dy;
        const c = [
          slope(ax, ay) - level,
          slope(bx, ay) - level,
          slope(bx, by) - level,
          slope(ax, by) - level,
        ];
        if (c.some((v) => !Number.isFinite(v))) continue;
        const corners = [
          [ax, ay], [bx, ay], [bx, by], [ax, by],
        ];
        const hit: number[][] = [];
        for (let e = 0; e < 4; e++) {
          const v0 = c[e], v1 = c[(e + 1) % 4];
          if (v0 === 0 || (v0 < 0) === (v1 < 0)) continue;
          const t = v0 / (v0 - v1);
          const p0 = corners[e], p1 = corners[(e + 1) % 4];
          hit.push([p0[0] + t * (p1[0] - p0[0]), p0[1] + t * (p1[1] - p0[1])]);
        }
        if (hit.length === 2) segs.push([hit[0][0], hit[0][1], hit[1][0], hit[1][1]]);
        else if (hit.length === 4) {
          segs.push([hit[0][0], hit[0][1], hit[1][0], hit[1][1]]);
          segs.push([hit[2][0], hit[2][1], hit[3][0], hit[3][1]]);
        }
      }
    }
    return segs;
  }

  // --- particles riding the field --------------------------------------------
  // Each dot obeys dx/dt = 1, dy/dt = f(x, y), rescaled so that every dot moves
  // at the same speed on screen: it travels along the segments, never faster
  // where the field is steep. A short ring of past positions is its trail.

  const rndSeed = (() => {
    let s = 987654321;
    return () => ((s = (s * 1664525 + 1013904223) >>> 0) / 4294967296);
  })();

  const NP = 420; // dots
  const TRAIL = 16; // remembered positions per dot
  const SPEED = 92; // canvas pixels per second
  type Dot = { x: number; y: number; age: number; life: number; tx: Float32Array; ty: Float32Array; n: number; head: number };
  let dots: Dot[] = [];

  function place(d: Dot, anywhere: boolean) {
    // half come in from the left edge, the rest anywhere, so the whole plane
    // stays populated even where the flow runs out through the top or bottom
    d.x = anywhere ? XMIN + rndSeed() * (XMAX - XMIN) : XMIN + rndSeed() * 0.25;
    d.y = YMIN + rndSeed() * (YMAX - YMIN);
    d.age = 0;
    d.life = 3.5 + rndSeed() * 4;
    d.head = 0;
    d.tx[0] = sx(d.x);
    d.ty[0] = sy(d.y);
    d.n = 1;
  }
  function seedDots() {
    dots = [];
    for (let k = 0; k < NP; k++) {
      const d: Dot = { x: 0, y: 0, age: 0, life: 1, tx: new Float32Array(TRAIL), ty: new Float32Array(TRAIL), n: 0, head: 0 };
      place(d, true);
      d.age = rndSeed() * d.life * 0.6; // stagger, so they do not all fade at once
      dots.push(d);
    }
  }

  /** World velocity of a dot: along (1, f), at a fixed speed in screen pixels. */
  const KX = () => P.w / (XMAX - XMIN), KY = () => P.h / (YMAX - YMIN);
  function vel(x: number, y: number): [number, number] {
    const m = slope(x, y);
    const kx = KX(), ky = KY();
    const len = Math.hypot(kx, m * ky) || 1;
    return [SPEED / len, (m * SPEED) / len];
  }

  function stepDots(dt: number) {
    for (const d of dots) {
      // midpoint rule on the normalised field
      const [ax, ay] = vel(d.x, d.y);
      const [bx, by] = vel(d.x + (ax * dt) / 2, d.y + (ay * dt) / 2);
      d.x += bx * dt;
      d.y += by * dt;
      d.age += dt;
      if (!Number.isFinite(d.y) || d.y > YMAX || d.y < YMIN || d.x > XMAX || d.age > d.life) {
        place(d, d.x <= XMAX && rndSeed() < 0.5);
        continue;
      }
      d.head = (d.head + 1) % TRAIL;
      d.tx[d.head] = sx(d.x);
      d.ty[d.head] = sy(d.y);
      d.n = Math.min(TRAIL, d.n + 1);
    }
  }

  // --- drawing ---------------------------------------------------------------

  function drawAxes() {
    ctx.strokeStyle = inkA(0.07);
    ctx.lineWidth = 1;
    ctx.beginPath();
    for (let i = Math.ceil(XMIN); i <= XMAX; i++) {
      ctx.moveTo(sx(i), P.y);
      ctx.lineTo(sx(i), P.y + P.h);
    }
    for (let j = Math.ceil(YMIN); j <= YMAX; j++) {
      ctx.moveTo(P.x, sy(j));
      ctx.lineTo(P.x + P.w, sy(j));
    }
    ctx.stroke();

    ctx.strokeStyle = inkA(0.28);
    ctx.lineWidth = 1.2;
    ctx.beginPath();
    ctx.moveTo(P.x, sy(0));
    ctx.lineTo(P.x + P.w, sy(0));
    ctx.moveTo(sx(0), P.y);
    ctx.lineTo(sx(0), P.y + P.h);
    ctx.stroke();

    for (let i = Math.ceil(XMIN); i <= XMAX; i++)
      if (i !== 0) label(String(i), sx(i), sy(0) + 15, 0.35, 'center', 11);
    for (let j = Math.ceil(YMIN); j <= YMAX; j++)
      if (j !== 0) label(String(j), sx(0) - 7, sy(j) + 4, 0.35, 'right', 11);
    label('x', P.x + P.w - 2, sy(0) - 8, 0.4, 'right', 11);
    label('y', sx(0) + 9, P.y + 12, 0.4, 'left', 11);
  }

  function drawField() {
    const NX = 30, NY = 21;
    const L = 15;
    // one neutral colour, a touch stronger where it is steeper; the meaning of
    // the field is its geometry, not a palette. Under the particles it steps
    // back a little so the flow reads first.
    const dim = state.flow ? 0.7 : 1;
    const BANDS = 4;
    const paths = Array.from({ length: BANDS }, () => new Path2D());
    ctx.lineWidth = 1.5;
    for (let i = 0; i <= NX; i++) {
      for (let j = 0; j <= NY; j++) {
        const x = XMIN + ((XMAX - XMIN) * i) / NX;
        const y = YMIN + ((YMAX - YMIN) * j) / NY;
        const m = slope(x, y);
        if (!Number.isFinite(m)) continue;
        // The direction is (1, m) in world units; the picture is stretched, so
        // convert before normalising or the drawn angle is not the real one.
        let ux = P.w / (XMAX - XMIN);
        let uy = -m * (P.h / (YMAX - YMIN));
        const n = Math.hypot(ux, uy) || 1;
        ux = (ux / n) * (L / 2);
        uy = (uy / n) * (L / 2);
        const cx = sx(x), cy = sy(y);
        const band = Math.min(BANDS - 1, Math.floor((Math.min(1, Math.abs(m) / 3)) * BANDS));
        paths[band].moveTo(cx - ux, cy - uy);
        paths[band].lineTo(cx + ux, cy + uy);
      }
    }
    paths.forEach((path, b) => {
      ctx.strokeStyle = inkA((0.22 + (0.16 * (b + 0.5)) / BANDS) * dim);
      ctx.stroke(path);
    });
  }

  // The field itself only changes when the equation does, so the two expensive
  // things (the isoclines and the family of curves) are worked out once and
  // kept until something they depend on moves.
  let isoCache: { key: string; segs: number[][][] } | null = null;
  let famCache: { key: string; curves: { x: number; y: number }[][] } | null = null;

  function drawIsoclines() {
    const levels: [number, string, number][] = [
      [0, teal(0.6), 1.8],
      [1, inkA(0.28), 1.1],
      [-1, inkA(0.28), 1.1],
      [2, inkA(0.16), 1],
      [-2, inkA(0.16), 1],
    ];
    if (isoCache?.key !== state.preset.key)
      isoCache = { key: state.preset.key, segs: levels.map(([lv]) => contour(lv)) };
    ctx.setLineDash([5, 4]);
    levels.forEach(([, col, lw], k) => {
      ctx.strokeStyle = col;
      ctx.lineWidth = lw;
      ctx.beginPath();
      for (const s of isoCache!.segs[k]) {
        ctx.moveTo(sx(s[0]), sy(s[1]));
        ctx.lineTo(sx(s[2]), sy(s[3]));
      }
      ctx.stroke();
    });
    ctx.setLineDash([]);
    label("y′ = 0", P.x + 8, P.y + P.h - 10, 0.7, 'left', 11, teal(1));
  }

  function stroke(pts: { x: number; y: number }[], col: string, lw: number) {
    if (pts.length < 2) return;
    ctx.strokeStyle = col;
    ctx.lineWidth = lw;
    ctx.beginPath();
    pts.forEach((p, k) => (k ? ctx.lineTo(sx(p.x), sy(p.y)) : ctx.moveTo(sx(p.x), sy(p.y))));
    ctx.stroke();
  }

  function drawFamily() {
    const key = `${state.preset.key}|${state.x0.toFixed(2)}`;
    if (famCache?.key !== key) {
      const curves: { x: number; y: number }[][] = [];
      for (let k = 0; k < 13; k++) {
        const y = YMIN + 0.15 + ((YMAX - YMIN - 0.3) * k) / 12;
        curves.push(solutionThrough(state.x0, y));
      }
      famCache = { key, curves };
    }
    for (const c of famCache.curves) stroke(c, 'rgba(124,140,255,0.22)', 1.3);
  }

  /** Fade in after a respawn, fade out before the end of a life. */
  const dotAlpha = (d: Dot) => Math.min(1, d.age / 0.5, (d.life - d.age) / 0.8);

  function drawDots() {
    const strength = cssv('--stage-light') === '1' ? 0.95 : 0.85;
    // Batch by fade level and by position along the trail, so a few hundred
    // trails cost a few dozen strokes rather than thousands.
    const LEVELS = 3;
    ctx.lineCap = 'round';
    for (let lv = 1; lv <= LEVELS; lv++) {
      const lo = (lv - 1) / LEVELS, hi = lv / LEVELS;
      const group = dots.filter((d) => {
        const a = dotAlpha(d);
        return a > lo && a <= hi && d.n > 0;
      });
      if (!group.length) continue;
      for (let k = 1; k < TRAIL; k++) {
        ctx.beginPath();
        for (const d of group) {
          if (k >= d.n) continue;
          const i0 = (d.head - k + TRAIL) % TRAIL, i1 = (i0 + 1) % TRAIL;
          ctx.moveTo(d.tx[i0], d.ty[i0]);
          ctx.lineTo(d.tx[i1], d.ty[i1]);
        }
        const t = 1 - k / TRAIL;
        ctx.strokeStyle = teal(+(strength * hi * t * 0.75).toFixed(3));
        ctx.lineWidth = 0.8 + 1.4 * t;
        ctx.stroke();
      }
      ctx.fillStyle = teal(+(strength * hi).toFixed(3));
      ctx.beginPath();
      for (const d of group) {
        const X = d.tx[d.head], Y = d.ty[d.head];
        ctx.moveTo(X + 2, Y);
        ctx.arc(X, Y, 2, 0, Math.PI * 2);
      }
      ctx.fill();
    }
    ctx.lineCap = 'butt';
  }

  function drawEuler(truth: { x: number; y: number }[]) {
    const pts = eulerFrom(state.x0, state.y0, state.h);
    stroke(pts, HOT, 2);
    ctx.fillStyle = HOT;
    for (const p of pts) {
      ctx.beginPath();
      ctx.arc(sx(p.x), sy(p.y), 3.2, 0, Math.PI * 2);
      ctx.fill();
    }
    // The gap at the far end, drawn as the thing it is: a distance.
    const last = pts[pts.length - 1];
    let best: { x: number; y: number } | null = null;
    for (const t of truth)
      if (!best || Math.abs(t.x - last.x) < Math.abs(best.x - last.x)) best = t;
    let err = NaN;
    if (best && Math.abs(best.x - last.x) < 0.2 && pts.length > 1) {
      err = Math.abs(best.y - last.y);
      ctx.strokeStyle = HOT;
      ctx.setLineDash([3, 3]);
      ctx.lineWidth = 1.4;
      ctx.beginPath();
      ctx.moveTo(sx(last.x), sy(last.y));
      ctx.lineTo(sx(best.x), sy(best.y));
      ctx.stroke();
      ctx.setLineDash([]);
      if (err > 0.06)
        label(
          `off by ${err.toFixed(2)}`,
          sx(last.x) - 8,
          (sy(last.y) + sy(best.y)) / 2,
          0.9,
          'right',
          11,
          HOT
        );
    }
    return { steps: pts.length - 1, err };
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    drawAxes();
    if (state.field) drawField();
    if (state.iso) drawIsoclines();
    if (state.flow) drawDots();
    if (state.family) drawFamily();

    const truth = solutionThrough(state.x0, state.y0);
    stroke(truth, ACC, 2.8);

    let euler = { steps: 0, err: NaN };
    if (state.euler) euler = drawEuler(truth);

    // the initial condition itself
    const m = slope(state.x0, state.y0);
    const cx = sx(state.x0), cy = sy(state.y0);
    // the tangent the equation demands right here
    let tx = P.w / (XMAX - XMIN);
    let ty = -m * (P.h / (YMAX - YMIN));
    const n = Math.hypot(tx, ty) || 1;
    tx = (tx / n) * 46;
    ty = (ty / n) * 46;
    ctx.strokeStyle = inkA(0.85);
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(cx - tx, cy - ty);
    ctx.lineTo(cx + tx, cy + ty);
    ctx.stroke();
    ctx.fillStyle = inkA(1);
    ctx.strokeStyle = `rgba(${cssv('--stage-ink-inv') || '13,14,18'},0.8)`;
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(cx, cy, 6.5, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();
    label(
      `(${state.x0.toFixed(2)}, ${state.y0.toFixed(2)})`,
      cx + 11,
      cy - 11,
      0.75,
      'left',
      11
    );

    const last = truth[truth.length - 1];
    setRows({
      stepOut: state.euler ? String(euler.steps) : '—',
      errOut: state.euler ? (Number.isFinite(euler.err) ? euler.err.toFixed(3) : 'it left the picture') : '—',
      liveOut: truth.length < 2 ? 'nowhere, it is vertical here' : last.x >= XMAX - 0.2 ? 'past the right edge' : `x = ${last.x.toFixed(2)}`,
    });
    setEq({
      rule: [[state.preset.tex, ACC], '\\quad\\text{with}\\;', `y(${state.x0.toFixed(2)}) = ${state.y0.toFixed(2)}`],
      live: [[`y' = ${Number.isFinite(m) ? m.toFixed(3) : '\\infty'}\\text{ here}`, ACC], state.euler ? [`\\quad y_{n+1} = y_n + ${state.h.toFixed(2)}\\,f(x_n,y_n)`, HOT] : ''],
    });
    setResult({
      value: Number.isFinite(m) ? m.toFixed(3) : 'vertical',
      colour: ACC,
      status: `at (${state.x0.toFixed(2)}, ${state.y0.toFixed(2)})${Number.isFinite(m) ? `, the curve climbs at ${((Math.atan(m) * 180) / Math.PI).toFixed(0)}°` : ''}${state.euler ? ` · Euler with h = ${state.h.toFixed(2)} ends ${Number.isFinite(euler.err) ? `${euler.err.toFixed(3)} off` : 'off the picture'}` : ''}`,
      note: state.preset.note,
    });
  }

  // --- loop ------------------------------------------------------------------

  let last = performance.now();
  function frame(now: number) {
    const dt = Math.min(0.05, Math.max(0, (now - last) / 1000));
    last = now;
    if (state.running && state.flow) stepDots(dt);
    draw();
    requestAnimationFrame(frame);
  }

  // --- controls --------------------------------------------------------------

  const two = (v: number) => v.toFixed(2).replace('-', '−');
  const setX0 = slider('x0', (v) => (state.x0 = v), two);
  const setY0 = slider('y0', (v) => (state.y0 = v), two);
  const setH = slider('h', (v) => (state.h = v / 100), (v) => (v / 100).toFixed(2));

  function setStart(x: number, y: number) {
    state.x0 = Math.max(XMIN + 0.1, Math.min(XMAX - 0.1, x));
    state.y0 = Math.max(YMIN + 0.1, Math.min(YMAX - 0.1, y));
    setX0(state.x0);
    setY0(state.y0);
  }

  const setters: Record<string, (on: boolean) => void> = {};
  for (const key of ['field', 'family', 'iso', 'euler'] as const)
    setters[key] = check(key, (on) => ((state as Record<string, unknown>)[key] = on));
  // particles that stand still say nothing, so turning them on sets them going
  setters.flow = check('flow', (on) => {
    state.flow = on;
    if (on) run(true);
  });

  function pick(k: string) {
    state.preset = PRESETS.find((p) => p.key === k) ?? PRESETS[0];
    setStart(state.preset.start.x, state.preset.start.y);
    seedDots();
  }
  const eqSeg = segmented('eq', pick);
  function run(on: boolean) {
    state.running = on;
    tp.setRunning(on);
  }
  // Run is what sends the particles down the field, so pressing it turns them
  // on rather than leaving the button doing nothing at all.
  const tp = transport({
    onRun: (running) => {
      state.running = running;
      if (running && !state.flow) {
        state.flow = true;
        setters.flow(true);
      }
    },
    onReset: () => {
      setStart(state.preset.start.x, state.preset.start.y);
      seedDots();
    },
  });

  // --- dragging the initial condition ----------------------------------------

  let dragging = false;
  const localPt = (e: PointerEvent) => {
    const r = canvas.getBoundingClientRect();
    return {
      x: ((e.clientX - r.left) / r.width) * W,
      y: ((e.clientY - r.top) / r.height) * H,
    };
  };
  canvas.addEventListener('pointerdown', (e) => {
    const l = localPt(e);
    if (l.x < P.x || l.x > P.x + P.w || l.y < P.y || l.y > P.y + P.h) return;
    dragging = true;
    canvas.setPointerCapture(e.pointerId);
    setStart(wxOf(l.x), wyOf(l.y));
  });
  canvas.addEventListener('pointermove', (e) => {
    const l = localPt(e);
    if (!dragging) {
      const d = Math.hypot(l.x - sx(state.x0), l.y - sy(state.y0));
      canvas.style.cursor = d < 18 ? 'grab' : 'crosshair';
      return;
    }
    setStart(wxOf(l.x), wyOf(l.y));
  });
  const stopDrag = () => (dragging = false);
  canvas.addEventListener('pointerup', stopDrag);
  canvas.addEventListener('pointercancel', stopDrag);

  /** Put the sim in a preset with only the listed layers on top of the field. */
  function show(k: string, layers: string[]) {
    eqSeg.select(k);
    pick(k);
    for (const key of ['family', 'iso', 'euler', 'flow']) {
      const on = layers.includes(key);
      (state as Record<string, unknown>)[key] = on;
      setters[key](on);
    }
    state.field = true;
    setters.field(true);
  }
  tries({
    family: () => show('wave', ['family']),
    forget: () => {
      show('linear', ['flow']);
      run(true);
    },
    equilibria: () => {
      show('logistic', ['flow']);
      run(true);
    },
    euler: () => {
      show('wave', ['euler']);
      state.h = 1;
      setH(100);
    },
  });

  seedDots();
  setStart(state.x0, state.y0);
  requestAnimationFrame(frame);
</script>

<style>
  #ode {
    touch-action: none;
  }
</style>
