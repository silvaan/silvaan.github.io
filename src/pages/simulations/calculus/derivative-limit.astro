---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';

const SEC = '#f59e0b', TAN = '#38bdf8';
---

<SimLayout
  areaSlug="calculus"
  title="Derivative as a Limit"
  description="Two points on a curve give one honest slope. Slide the second point in and watch the secant become the tangent."
  shortcuts={['animate', 'fullscreen']}
  standard
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="dl"
          width="1000"
          height="600"
          role="img"
          aria-label="A curve, the secant through two points on it, and the tangent at the first point."
        ></canvas>
      </div>
      <Caption
        legend={[{ label: 'secant', color: SEC }, { label: 'tangent', color: TAN }]}
        hint="Click a line to select it"
      />
      <Result label="Slope of the secant" />
    </div>

    <div class="sim-panel">
      <Seg
        id="fn"
        label="Function"
        attr="f"
        options={[
          { value: 'quad', label: '½x²' },
          { value: 'sine', label: 'sin x' },
          { value: 'expo', label: '½eˣ' },
          { value: 'cubic', label: '¼x³' },
        ]}
      />
      <Seg
        id="line"
        label="Which line"
        attr="l"
        options={[{ value: 'sec', label: 'Secant' }, { value: 'tan', label: 'Tangent' }]}
      />
      <Slider id="x0" label="Point x<sub>0</sub>" min={-2.6} max={2.6} step={0.05} value={0.8} display="0.80" />
      <Slider id="h" label="Step h" min={0.02} max={2.4} step={0.02} value={1.2} display="1.20" />
      <Transport animate="Animate h → 0" reset={false} />
      <Readout
        title="Values"
        rows={[
          { id: 'r-f', label: 'f(x)' },
          { id: 'r-df', label: 'f′(x)' },
          { id: 'r-sec', label: 'secant slope' },
          { id: 'r-tan', label: 'tangent slope f′(x<sub>0</sub>)' },
          { id: 'r-gap', label: 'gap between them' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      The amber <b>secant</b> is the only slope you can measure honestly: two
      points, a rise and a run. The blue <b>tangent</b> touches at one point, so
      there is no run to divide by and no slope to measure directly.
    </li>
    <li>
      That is what the limit is for. Halve <b>h</b> and watch the <b>gap</b>
      under the number roughly halve too. The secant slope is not reaching the
      tangent by accident; it is closing in at a steady rate.
    </li>
    <li>
      Press <b>Animate h → 0</b>. The triangle collapses, the two lines become one
      and the number stops moving. Whatever it settles on is called f′(x₀), and
      nothing else about the curve was needed to find it.
    </li>
    <li>
      Pick <b>½eˣ</b>. The tangent slope always equals the curve's own height
      f(x₀), which is the property that singles e out from every other base.
    </li>
    <li>
      Pick <b>sin x</b> and drag x₀ to a crest. The tangent goes flat, the secant
      does not, and the gap is at its largest: the secant is answering a question
      about an interval, not about a point.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk, roundRect, fixed, signed } from '../../../lib/draw';
  import { el, segmented, slider, result, readout } from '../../../lib/panel';

  type Which = 'sec' | 'tan';
  type Fn = { f: (x: number) => number; df: (x: number) => number; eq: string; dq: string };

  const FNS: Record<string, Fn> = {
    quad: { f: (x) => 0.5 * x * x, df: (x) => x, eq: '½x²', dq: 'x' },
    sine: { f: (x) => 1.6 * Math.sin(x), df: (x) => 1.6 * Math.cos(x), eq: '1.6 sin x', dq: '1.6 cos x' },
    expo: { f: (x) => 0.5 * Math.exp(x), df: (x) => 0.5 * Math.exp(x), eq: '½eˣ', dq: '½eˣ' },
    cubic: { f: (x) => 0.25 * x * x * x, df: (x) => 0.75 * x * x, eq: '¼x³', dq: '¾x²' },
  };

  const state = { fn: 'quad', x0: 0.8, h: 1.2, which: 'sec' as Which };
  let raf = 0;

  // the measured line is amber, the limit it is heading for is blue
  const RGB = { sec: '245,158,11', tan: '56,189,248' };
  const col = (w: Which, a: number) => `rgba(${RGB[w]},${a})`;
  const cur = () => FNS[state.fn];

  const canvas = el('dl') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink, inv } = stageInk(canvas);
  const { label, textWidth } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  const BOX = { x: 40, y: 24, w: W - 80, h: H - 82 };
  const XR = { min: -3.2, max: 3.2 };

  /** Vertical window, wide enough for the curve and both lines to stay inside. */
  function yRange() {
    const { f } = cur();
    let lo = Infinity, hi = -Infinity;
    for (let i = 0; i <= 240; i++) {
      const v = f(XR.min + ((XR.max - XR.min) * i) / 240);
      if (isFinite(v)) { lo = Math.min(lo, v); hi = Math.max(hi, v); }
    }
    const pad = (hi - lo) * 0.14 || 1;
    return { lo: lo - pad, hi: hi + pad };
  }

  let R = { lo: -1, hi: 1 };
  const sx = (x: number) => BOX.x + ((x - XR.min) / (XR.max - XR.min)) * BOX.w;
  const sy = (y: number) => BOX.y + BOX.h - ((y - R.lo) / (R.hi - R.lo)) * BOX.h;

  const slopes = () => {
    const { f, df } = cur();
    const y0 = f(state.x0), y1 = f(state.x0 + state.h);
    return { y0, y1, sec: (y1 - y0) / state.h, tan: df(state.x0) };
  };

  // --- the graph --------------------------------------------------------------

  function clipBox() {
    ctx.beginPath();
    ctx.rect(BOX.x, BOX.y, BOX.w, BOX.h);
    ctx.clip();
  }

  function drawAxes() {
    ctx.strokeStyle = ink(0.07);
    ctx.lineWidth = 1;
    for (let i = 0; i <= 8; i++) {
      const xv = XR.min + ((XR.max - XR.min) * i) / 8;
      ctx.beginPath();
      ctx.moveTo(sx(xv), BOX.y);
      ctx.lineTo(sx(xv), BOX.y + BOX.h);
      ctx.stroke();
      label(xv.toFixed(1), sx(xv), BOX.y + BOX.h + 17, 0.3, 'center', 11.5);
    }
    if (R.lo < 0 && R.hi > 0) {
      ctx.strokeStyle = ink(0.16);
      ctx.beginPath();
      ctx.moveTo(BOX.x, sy(0));
      ctx.lineTo(BOX.x + BOX.w, sy(0));
      ctx.stroke();
    }
  }

  /** A straight line of the given slope through (x₀, y₀), across the whole box. */
  function lineEnds(m: number, x0: number, y0: number) {
    return [
      { x: sx(XR.min), y: sy(y0 + m * (XR.min - x0)) },
      { x: sx(XR.max), y: sy(y0 + m * (XR.max - x0)) },
    ];
  }

  function drawLine(w: Which) {
    const { y0, sec, tan } = slopes();
    const m = w === 'sec' ? sec : tan;
    const [p, q] = lineEnds(m, state.x0, y0);
    const on = state.which === w;
    ctx.save();
    clipBox();
    if (on) {
      ctx.strokeStyle = col(w, 0.18);
      ctx.lineWidth = 9;
      ctx.beginPath();
      ctx.moveTo(p.x, p.y);
      ctx.lineTo(q.x, q.y);
      ctx.stroke();
    }
    ctx.strokeStyle = col(w, on ? 1 : 0.34);
    ctx.lineWidth = on ? 2.6 : 1.5;
    ctx.setLineDash(on ? [] : [6, 5]);
    ctx.beginPath();
    ctx.moveTo(p.x, p.y);
    ctx.lineTo(q.x, q.y);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.restore();

    // a name for the line, riding on it near the right edge. Once the two lines
    // have all but merged only the chosen one keeps its label.
    const lx = XR.max - 0.55;
    const ly = sy(y0 + m * (lx - state.x0));
    const lyOther = sy(y0 + (w === 'sec' ? tan : sec) * (lx - state.x0));
    const merged = !on && Math.abs(ly - lyOther) < 20;
    if (!merged && ly > BOX.y + 16 && ly < BOX.y + BOX.h - 10) {
      const txt = w === 'sec' ? 'secant' : 'tangent';
      const tw = textWidth(txt, 11);
      ctx.fillStyle = inv(0.72);
      roundRect(ctx, sx(lx) - tw / 2 - 7, ly - 24, tw + 14, 19, 5);
      ctx.fill();
      label(txt, sx(lx), ly - 11, 1, 'center', 11, col(w, on ? 1 : 0.5));
    }
  }

  function drawTriangle() {
    const { y0, y1 } = slopes();
    const x0 = state.x0, x1 = state.x0 + state.h;
    const on = state.which === 'sec';
    ctx.save();
    clipBox();
    ctx.beginPath();
    ctx.moveTo(sx(x0), sy(y0));
    ctx.lineTo(sx(x1), sy(y0));
    ctx.lineTo(sx(x1), sy(y1));
    ctx.closePath();
    ctx.fillStyle = col('sec', on ? 0.14 : 0.06);
    ctx.fill();
    ctx.strokeStyle = col('sec', on ? 0.6 : 0.25);
    ctx.lineWidth = 1.2;
    ctx.setLineDash([4, 4]);
    ctx.stroke();
    ctx.setLineDash([]);

    // captions on the run and the rise, dropped once the step is too small
    const up = y1 >= y0;
    if (sx(x1) - sx(x0) > 46)
      label(`run h = ${fixed(state.h, 2)}`, sx(x1) - 4, sy(y0) + (up ? 17 : -9), 1, 'right', 11.5, col('sec', on ? 0.95 : 0.4));
    if (Math.abs(sy(y1) - sy(y0)) > 22)
      label(`rise ${fixed(y1 - y0, 2)}`, sx(x1) + 8, (sy(y0) + sy(y1)) / 2 + 4, 1, 'left', 11.5, col('sec', on ? 0.95 : 0.4));
    ctx.restore();
  }

  function drawCurve() {
    const { f } = cur();
    ctx.save();
    clipBox();
    ctx.strokeStyle = ink(0.6);
    ctx.lineWidth = 2.6;
    ctx.lineJoin = 'round';
    ctx.beginPath();
    for (let i = 0; i <= 600; i++) {
      const x = XR.min + ((XR.max - XR.min) * i) / 600;
      i ? ctx.lineTo(sx(x), sy(f(x))) : ctx.moveTo(sx(x), sy(f(x)));
    }
    ctx.stroke();
    ctx.restore();
  }

  function dot(x: number, y: number, colour: string, r = 5.5) {
    ctx.fillStyle = colour;
    ctx.strokeStyle = inv(0.75);
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(sx(x), sy(y), r, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();
  }

  function drawPoints() {
    const { y0, y1 } = slopes();
    const x1 = state.x0 + state.h;
    ctx.strokeStyle = ink(0.18);
    ctx.setLineDash([3, 4]);
    ctx.lineWidth = 1;
    for (const [x, y] of [[state.x0, y0], [x1, y1]] as [number, number][]) {
      ctx.beginPath();
      ctx.moveTo(sx(x), sy(y));
      ctx.lineTo(sx(x), BOX.y + BOX.h);
      ctx.stroke();
    }
    ctx.setLineDash([]);
    ctx.save();
    clipBox();
    dot(x1, y1, col('sec', 1));
    dot(state.x0, y0, ink(0.95), 6);
    ctx.restore();
    label('x₀', sx(state.x0), BOX.y + BOX.h + 38, 0.75, 'center', 11);
    if (sx(x1) - sx(state.x0) > 34)
      label('x₀+h', sx(x1), BOX.y + BOX.h + 38, 1, 'center', 11, col('sec', 0.9));
  }

  function draw() {
    R = yRange();
    ctx.clearRect(0, 0, W, H);
    drawAxes();
    drawTriangle();
    drawCurve();
    drawLine(state.which === 'sec' ? 'tan' : 'sec');
    drawLine(state.which);
    drawPoints();
    sync();
  }

  // --- the words and numbers -----------------------------------------------------

  function sync() {
    const { y0, y1, sec, tan } = slopes();
    const w = state.which;
    const m = w === 'sec' ? sec : tan;
    const gap = Math.abs(sec - tan);
    const SEC = `rgb(${RGB.sec})`, TAN = `rgb(${RGB.tan})`;

    setEq({
      rule: [["f'(x_0)", TAN], '=', ['\\lim\\limits_{h\\to 0}\\frac{f(x_0+h)-f(x_0)}{h}', SEC]],
      live: [
        [`f'(x_0) = ${fixed(tan, 3)}`, TAN],
        `\\quad h = ${state.h.toFixed(2)}:`,
        [`\\frac{\\Delta f}{h} = ${fixed(sec, 3)}`, SEC],
      ],
    });

    el('result-label').textContent = w === 'sec' ? 'Slope of the secant' : 'Slope of the tangent';
    const line = `y = ${fixed(y0, 2)} ${signed(m, 2)}(x ${signed(-state.x0, 2)})`;
    setResult({
      value: fixed(m, 3),
      colour: w === 'sec' ? SEC : TAN,
      status:
        w === 'sec'
          ? `(f(x₀+h) − f(x₀)) / h = (${fixed(y1, 3)} ${signed(-y0, 3)}) / ${fixed(state.h, 3)}`
          : `The number the secant is heading for as h → 0`,
      note:
        w === 'sec'
          ? `Two points, one honest slope. Gap to the tangent: ${fixed(gap, 3)}. Line: ${line}`
          : `At h = ${fixed(state.h, 2)} the secant still misses it by ${fixed(gap, 3)}. Line: ${line}`,
    });

    setRows({
      'r-f': cur().eq,
      'r-df': cur().dq,
      'r-sec': fixed(sec, 3),
      'r-tan': fixed(tan, 3),
      'r-gap': fixed(gap, 3),
    });
  }

  // --- controls -------------------------------------------------------------------

  const lines = segmented('line', (l) => { state.which = l as Which; draw(); });
  segmented('fn', (f) => { state.fn = f; draw(); });

  const stopAnimation = () => { cancelAnimationFrame(raf); raf = 0; };
  slider('x0', (v) => { stopAnimation(); state.x0 = v; clampH(); draw(); }, (v) => v.toFixed(2));
  const setHSlider = slider('h', (v) => { stopAnimation(); state.h = v; draw(); }, (v) => v.toFixed(2));
  const hEl = el('h') as HTMLInputElement;

  function setH(h: number) {
    state.h = h;
    setHSlider(h);
  }
  /** Keep x₀ + h inside the window, so both points are always on screen. */
  function clampH() {
    const max = Math.max(0.06, Math.min(2.4, XR.max - 0.25 - state.x0));
    hEl.max = max.toFixed(2);
    if (state.h > max) setH(+max.toFixed(2));
    return max;
  }

  el('run').addEventListener('click', () => {
    stopAnimation();
    setH(clampH());
    const shrink = () => {
      const next = state.h * 0.94;
      if (next <= 0.02) { setH(0.02); draw(); raf = 0; return; }
      setH(+next.toFixed(3));
      draw();
      raf = requestAnimationFrame(() => setTimeout(shrink, 40));
    };
    shrink();
  });

  // click either line to select it
  canvas.addEventListener('pointerdown', (e) => {
    const b = canvas.getBoundingClientRect();
    const x = ((e.clientX - b.left) / b.width) * W;
    const y = ((e.clientY - b.top) / b.height) * H;
    if (x > BOX.x + BOX.w || y > BOX.y + BOX.h) return;
    const { y0, sec, tan } = slopes();
    let best: { w: Which; d: number } | null = null;
    for (const w of ['sec', 'tan'] as Which[]) {
      const [p, q] = lineEnds(w === 'sec' ? sec : tan, state.x0, y0);
      const vx = q.x - p.x, vy = q.y - p.y;
      const t = Math.max(0, Math.min(1, ((x - p.x) * vx + (y - p.y) * vy) / (vx * vx + vy * vy)));
      const d = Math.hypot(p.x + vx * t - x, p.y + vy * t - y);
      if (!best || d < best.d) best = { w, d };
    }
    if (best && best.d < 26) {
      state.which = best.w;
      lines.select(best.w);
      draw();
    }
  });

  clampH();
  draw();
</script>

<style>
  #dl {
    cursor: pointer;
  }
</style>
