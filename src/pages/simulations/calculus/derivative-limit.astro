---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';

const SEC = '#f59e0b', TAN = '#38bdf8';
---

<SimLayout
  areaSlug="calculus"
  title="Derivative as a Limit"
  description="Two points on a curve give one honest slope. Slide the second point in and watch the secant become the tangent, then zoom in until the curve itself is a straight line."
  shortcuts={['animate', 'fullscreen']}
  standard
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="dl"
          width="1000"
          height="600"
          role="img"
          aria-label="A curve, the secant through two points on it, and the tangent at the first point. The view can be zoomed in around the first point."
        ></canvas>
      </div>
      <Caption
        legend={[{ label: 'secant', color: SEC }, { label: 'tangent', color: TAN }]}
        hint="Click a line to select it, scroll or pinch to zoom"
      />
      <Result label="Slope of the secant" />
    </div>

    <div class="sim-panel">
      <Seg
        id="fn"
        label="Function"
        attr="f"
        options={[
          { value: 'quad', label: '½x²' },
          { value: 'sine', label: 'sin x' },
          { value: 'expo', label: '½eˣ' },
          { value: 'cubic', label: '¼x³' },
          { value: 'kink', label: '|sin x|' },
        ]}
      />
      <Seg
        id="line"
        label="Which line"
        attr="l"
        options={[{ value: 'sec', label: 'Secant' }, { value: 'tan', label: 'Tangent' }]}
      />
      <Slider id="x0" label="Point x<sub>0</sub>" min={-2.6} max={2.6} step={0.05} value={0.8} display="0.80" />
      <Slider id="h" label="Step h" min={0.02} max={2.4} step={0.02} value={1.2} display="1.20" />
      <Slider id="zoom" label="Zoom around x<sub>0</sub>" min={0} max={3} step={0.01} value={0} display="×1" hint={['as drawn', '×1000']} />
      <Transport animate="Animate h → 0" reset={false}>
        <button type="button" class="btn ghost" id="zoombtn">Zoom in</button>
      </Transport>
      <Readout
        title="Values"
        rows={[
          { id: 'r-f', label: 'f(x)' },
          { id: 'r-df', label: 'f′(x)' },
          { id: 'r-sec', label: 'secant slope' },
          { id: 'r-tan', label: 'tangent slope f′(x<sub>0</sub>)' },
          { id: 'r-gap', label: 'gap between them' },
          { id: 'r-dev', label: 'curve off the tangent, on screen' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Shrink <b>h</b> and the gap between the two slopes shrinks with it. The
      number the secant settles on is f′(x₀). <Try id="limit" label="Animate" />
    </li>
    <li>
      <b>Zoom in</b> on a smooth curve and it straightens: by ×1000 it sits on
      the tangent to within a pixel, and its slope is f′(x₀). Locally, every
      smooth curve is a line. <Try id="zoom" label="Zoom in" />
    </li>
    <li>
      Zoom in on the <b>corner</b> of |sin x| at x₀ = 0 and nothing straightens: the
      V looks the same at every magnification. The slopes from the left and the right
      (−1.6 and +1.6) disagree, so f′(0) does not exist. <Try id="kink" label="Zoom in" />
    </li>
    <li>
      On <b>½eˣ</b> the tangent slope always equals the height f(x₀): the curve
      is its own derivative. <Try id="exp" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk, roundRect, fixed, signed } from '../../../lib/draw';
  import { el, segmented, slider, result, readout, tries } from '../../../lib/panel';

  type Which = 'sec' | 'tan';
  type Fn = {
    f: (x: number) => number;
    df: (x: number) => number;
    eq: string;
    dq: string;
    /** Where the graph has a corner: no derivative there, only one-sided slopes. */
    kinks?: number[];
  };

  const FNS: Record<string, Fn> = {
    quad: { f: (x) => 0.5 * x * x, df: (x) => x, eq: '½x²', dq: 'x' },
    sine: { f: (x) => 1.6 * Math.sin(x), df: (x) => 1.6 * Math.cos(x), eq: '1.6 sin x', dq: '1.6 cos x' },
    expo: { f: (x) => 0.5 * Math.exp(x), df: (x) => 0.5 * Math.exp(x), eq: '½eˣ', dq: '½eˣ' },
    cubic: { f: (x) => 0.25 * x * x * x, df: (x) => 0.75 * x * x, eq: '¼x³', dq: '¾x²' },
    kink: {
      f: (x) => 1.6 * Math.abs(Math.sin(x)),
      df: (x) => 1.6 * Math.cos(x) * Math.sign(Math.sin(x)),
      eq: '1.6 |sin x|',
      dq: '±1.6 cos x, none at 0',
      kinks: [-Math.PI, 0, Math.PI],
    },
  };

  const state = { fn: 'quad', x0: 0.8, h: 1.2, which: 'sec' as Which, zoom: 1 };
  let raf = 0;

  // the measured line is amber, the limit it is heading for is blue
  const RGB = { sec: '245,158,11', tan: '56,189,248' };
  const col = (w: Which, a: number) => `rgba(${RGB[w]},${a})`;
  const cur = () => FNS[state.fn];

  const canvas = el('dl') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink, inv } = stageInk(canvas);
  const { label, textWidth } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  const BOX = { x: 40, y: 24, w: W - 80, h: H - 82 };
  const XR = { min: -3.2, max: 3.2 };

  /** Vertical window, wide enough for the curve and both lines to stay inside. */
  function yRange() {
    const { f } = cur();
    let lo = Infinity, hi = -Infinity;
    for (let i = 0; i <= 240; i++) {
      const v = f(XR.min + ((XR.max - XR.min) * i) / 240);
      if (isFinite(v)) { lo = Math.min(lo, v); hi = Math.max(hi, v); }
    }
    const pad = (hi - lo) * 0.14 || 1;
    return { lo: lo - pad, hi: hi + pad };
  }

  /** x₀ sits on a corner of the graph (the slider never lands exactly on 0.00). */
  const kinkAt = (x: number) => (cur().kinks ?? []).some((k) => Math.abs(k - x) < 1e-6);

  // The view: the whole window at ×1, closing in on (x₀, f(x₀)) as the zoom
  // grows. Both axes shrink by the same factor, so angles and slopes on screen
  // never change; the point glides to the middle of the box on the way in.
  let V = { x0: XR.min, x1: XR.max, lo: -1, hi: 1 };
  function view() {
    const R = yRange();
    const Z = state.zoom;
    const px = state.x0, py = cur().f(state.x0);
    const g = 1 / (Z * Z);
    const cx = px + ((XR.min + XR.max) / 2 - px) * g;
    const cy = py + ((R.lo + R.hi) / 2 - py) * g;
    const hw = (XR.max - XR.min) / 2 / Z, hh = (R.hi - R.lo) / 2 / Z;
    V = { x0: cx - hw, x1: cx + hw, lo: cy - hh, hi: cy + hh };
  }
  const sx = (x: number) => BOX.x + ((x - V.x0) / (V.x1 - V.x0)) * BOX.w;
  const sy = (y: number) => BOX.y + BOX.h - ((y - V.lo) / (V.hi - V.lo)) * BOX.h;
  const inBoxX = (px: number) => px >= BOX.x - 0.5 && px <= BOX.x + BOX.w + 0.5;

  const slopes = () => {
    const { f, df } = cur();
    const y0 = f(state.x0), y1 = f(state.x0 + state.h);
    const corner = kinkAt(state.x0);
    // one-sided slopes at a corner, worked out from a tiny step either way
    const e = 1e-7;
    const left = corner ? (y0 - f(state.x0 - e)) / e : df(state.x0);
    const right = corner ? (f(state.x0 + e) - y0) / e : df(state.x0);
    return { y0, y1, sec: (y1 - y0) / state.h, tan: corner ? NaN : df(state.x0), corner, left, right };
  };

  /** A tick spacing of 1, 2 or 5 times a power of ten, about n per span. */
  function niceStep(span: number, n: number) {
    const raw = span / n;
    const p = 10 ** Math.floor(Math.log10(raw));
    const m = raw / p;
    return (m < 1.5 ? 1 : m < 3.5 ? 2 : m < 7.5 ? 5 : 10) * p;
  }

  // --- the graph --------------------------------------------------------------

  function clipBox() {
    ctx.beginPath();
    ctx.rect(BOX.x, BOX.y, BOX.w, BOX.h);
    ctx.clip();
  }

  function drawAxes() {
    const step = niceStep(V.x1 - V.x0, 8);
    const dec = Math.max(1, -Math.floor(Math.log10(step) + 1e-9));
    ctx.strokeStyle = ink(0.07);
    ctx.lineWidth = 1;
    for (let k = Math.ceil(V.x0 / step); k * step <= V.x1; k++) {
      const xv = k * step;
      const X = sx(xv);
      ctx.beginPath();
      ctx.moveTo(X, BOX.y);
      ctx.lineTo(X, BOX.y + BOX.h);
      ctx.stroke();
      // leave room at the ends for the x₀ labels and the box edge
      if (X > BOX.x + 18 && X < BOX.x + BOX.w - 18)
        label(fixed(xv, dec), X, BOX.y + BOX.h + 17, 0.3, 'center', 11.5);
    }
    if (V.lo < 0 && V.hi > 0) {
      ctx.strokeStyle = ink(0.16);
      ctx.beginPath();
      ctx.moveTo(BOX.x, sy(0));
      ctx.lineTo(BOX.x + BOX.w, sy(0));
      ctx.stroke();
    }
  }

  /** A straight line of the given slope through (x₀, y₀), across the whole box. */
  function lineEnds(m: number, x0: number, y0: number, from = V.x0, to = V.x1) {
    return [
      { x: sx(from), y: sy(y0 + m * (from - x0)) },
      { x: sx(to), y: sy(y0 + m * (to - x0)) },
    ];
  }

  function strokeLine(w: Which, p: { x: number; y: number }, q: { x: number; y: number }, on: boolean) {
    if (on) {
      ctx.strokeStyle = col(w, 0.18);
      ctx.lineWidth = 9;
      ctx.beginPath();
      ctx.moveTo(p.x, p.y);
      ctx.lineTo(q.x, q.y);
      ctx.stroke();
    }
    ctx.strokeStyle = col(w, on ? 1 : 0.34);
    ctx.lineWidth = on ? 2.6 : 1.5;
    ctx.setLineDash(on ? [] : [6, 5]);
    ctx.beginPath();
    ctx.moveTo(p.x, p.y);
    ctx.lineTo(q.x, q.y);
    ctx.stroke();
    ctx.setLineDash([]);
  }

  function lineTag(txt: string, x: number, y: number, colour: string) {
    if (y < BOX.y + 16 || y > BOX.y + BOX.h - 10) return;
    const tw = textWidth(txt, 11);
    ctx.fillStyle = inv(0.72);
    roundRect(ctx, x - tw / 2 - 7, y - 24, tw + 14, 19, 5);
    ctx.fill();
    label(txt, x, y - 11, 1, 'center', 11, colour);
  }

  /** At a corner there is no tangent, only a half-line on each side. */
  function drawHalfTangents() {
    const { y0, left, right } = slopes();
    const on = state.which === 'tan';
    ctx.save();
    clipBox();
    const [a] = lineEnds(left, state.x0, y0, V.x0, state.x0);
    const [, b] = lineEnds(right, state.x0, y0, state.x0, V.x1);
    const c = { x: sx(state.x0), y: sy(y0) };
    strokeLine('tan', a, c, on);
    strokeLine('tan', c, b, on);
    ctx.restore();
    const span = V.x1 - V.x0;
    const lx = V.x0 + span * 0.12, rx = V.x1 - span * 0.12;
    lineTag(`left ${signed(left, 2)}`, sx(lx), sy(y0 + left * (lx - state.x0)), col('tan', on ? 1 : 0.6));
    lineTag(`right ${signed(right, 2)}`, sx(rx), sy(y0 + right * (rx - state.x0)), col('tan', on ? 1 : 0.6));
  }

  function drawLine(w: Which) {
    const { y0, sec, tan, corner } = slopes();
    if (w === 'tan' && corner) return drawHalfTangents();
    const m = w === 'sec' ? sec : tan;
    const [p, q] = lineEnds(m, state.x0, y0);
    const on = state.which === w;
    ctx.save();
    clipBox();
    strokeLine(w, p, q, on);
    ctx.restore();

    // a name for the line, riding on it near the right edge. Once the two lines
    // have all but merged only the chosen one keeps its label.
    const lx = V.x1 - (V.x1 - V.x0) * 0.086;
    const ly = sy(y0 + m * (lx - state.x0));
    const other = w === 'sec' ? tan : sec;
    const lyOther = Number.isFinite(other) ? sy(y0 + other * (lx - state.x0)) : Infinity;
    const merged = !on && Math.abs(ly - lyOther) < 20;
    if (!merged) lineTag(w === 'sec' ? 'secant' : 'tangent', sx(lx), ly, col(w, on ? 1 : 0.5));
  }

  function drawTriangle() {
    const { y0, y1 } = slopes();
    const x0 = state.x0, x1 = state.x0 + state.h;
    const on = state.which === 'sec';
    // zoomed in past x₀ + h, the triangle would only be a wedge of colour
    if (!inBoxX(sx(x1))) return;
    ctx.save();
    clipBox();
    ctx.beginPath();
    ctx.moveTo(sx(x0), sy(y0));
    ctx.lineTo(sx(x1), sy(y0));
    ctx.lineTo(sx(x1), sy(y1));
    ctx.closePath();
    ctx.fillStyle = col('sec', on ? 0.14 : 0.06);
    ctx.fill();
    ctx.strokeStyle = col('sec', on ? 0.6 : 0.25);
    ctx.lineWidth = 1.2;
    ctx.setLineDash([4, 4]);
    ctx.stroke();
    ctx.setLineDash([]);

    // captions on the run and the rise, dropped once the step is too small
    // or has left the view
    const up = y1 >= y0;
    if (inBoxX(sx(x1)) && sx(x1) - sx(x0) > 46)
      label(`run h = ${fixed(state.h, 2)}`, sx(x1) - 4, sy(y0) + (up ? 17 : -9), 1, 'right', 11.5, col('sec', on ? 0.95 : 0.4));
    if (inBoxX(sx(x1) + 60) && Math.abs(sy(y1) - sy(y0)) > 22)
      label(`rise ${fixed(y1 - y0, 2)}`, sx(x1) + 8, (sy(y0) + sy(y1)) / 2 + 4, 1, 'left', 11.5, col('sec', on ? 0.95 : 0.4));
    ctx.restore();
  }

  function drawCurve() {
    const { f, kinks = [] } = cur();
    // even samples across the view, plus every corner inside it, so a corner
    // is drawn sharp at any magnification
    const xs: number[] = [];
    for (let i = 0; i <= 600; i++) xs.push(V.x0 + ((V.x1 - V.x0) * i) / 600);
    for (const k of kinks) if (k > V.x0 && k < V.x1) xs.push(k);
    xs.sort((a, b) => a - b);
    ctx.save();
    clipBox();
    ctx.strokeStyle = ink(0.6);
    ctx.lineWidth = 2.6;
    ctx.lineJoin = 'round';
    ctx.beginPath();
    xs.forEach((x, i) => (i ? ctx.lineTo(sx(x), sy(f(x))) : ctx.moveTo(sx(x), sy(f(x)))));
    ctx.stroke();
    ctx.restore();
  }

  function dot(x: number, y: number, colour: string, r = 5.5) {
    ctx.fillStyle = colour;
    ctx.strokeStyle = inv(0.75);
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(sx(x), sy(y), r, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();
  }

  function drawPoints() {
    const { y0, y1 } = slopes();
    const x1 = state.x0 + state.h;
    ctx.save();
    clipBox();
    ctx.strokeStyle = ink(0.18);
    ctx.setLineDash([3, 4]);
    ctx.lineWidth = 1;
    for (const [x, y] of [[state.x0, y0], [x1, y1]] as [number, number][]) {
      ctx.beginPath();
      ctx.moveTo(sx(x), sy(y));
      ctx.lineTo(sx(x), BOX.y + BOX.h);
      ctx.stroke();
    }
    ctx.setLineDash([]);
    dot(x1, y1, col('sec', 1));
    dot(state.x0, y0, ink(0.95), 6);
    ctx.restore();
    label('x₀', sx(state.x0), BOX.y + BOX.h + 38, 0.75, 'center', 11);
    if (inBoxX(sx(x1)) && sx(x1) - sx(state.x0) > 34)
      label('x₀+h', sx(x1), BOX.y + BOX.h + 38, 1, 'center', 11, col('sec', 0.9));
  }

  /**
   * How far the drawn curve strays from the tangent inside the view, in screen
   * pixels. This is what "the curve looks straight" means: under a pixel.
   */
  function deviation() {
    const { f } = cur();
    const { y0, tan } = slopes();
    if (!Number.isFinite(tan)) return NaN;
    let worst = 0;
    for (let i = 0; i <= 160; i++) {
      const x = V.x0 + ((V.x1 - V.x0) * i) / 160;
      worst = Math.max(worst, Math.abs(f(x) - y0 - tan * (x - state.x0)));
    }
    return (worst / (V.hi - V.lo)) * BOX.h;
  }

  const zoomText = (z: number) => `×${z < 9.95 ? z.toFixed(1).replace(/\.0$/, '') : Math.round(z)}`;

  /** The magnification, and what it has done to the curve, in the top-left corner. */
  function drawBadge(dev: number) {
    const { corner, left, right } = slopes();
    const big = zoomText(state.zoom);
    const small = corner
      ? `corner: ${fixed(left, 2)} | ${signed(right, 2).replace(' ', '')}`
      : dev < 1
        ? 'curve = tangent line, to the pixel'
        : `curve off the tangent by ${dev < 100 ? dev.toFixed(0) : '100+'} px`;
    const sw = textWidth(small, 10.5);
    ctx.font = `600 ${Math.round(20 * 1.42)}px ui-monospace, SFMono-Regular, Menlo, monospace`;
    const bw = ctx.measureText(big).width;
    const x = BOX.x + 10, y = BOX.y + 10;
    ctx.fillStyle = inv(0.78);
    roundRect(ctx, x, y, Math.max(bw, sw) + 24, 66, 9);
    ctx.fill();
    ctx.strokeStyle = ink(0.12);
    ctx.lineWidth = 1;
    ctx.stroke();
    ctx.font = `600 ${Math.round(20 * 1.42)}px ui-monospace, SFMono-Regular, Menlo, monospace`;
    ctx.fillStyle = ink(0.92);
    ctx.textAlign = 'left';
    ctx.fillText(big, x + 12, y + 35);
    const tint = corner ? 'rgba(249,115,106,0.95)' : dev < 1 ? col('tan', 1) : ink(0.6);
    label(small, x + 12, y + 55, 1, 'left', 10.5, tint);
  }

  function draw() {
    view();
    ctx.clearRect(0, 0, W, H);
    drawAxes();
    drawTriangle();
    drawCurve();
    drawLine(state.which === 'sec' ? 'tan' : 'sec');
    drawLine(state.which);
    drawPoints();
    const dev = deviation();
    // the badge only appears once there is a magnification to report
    if (state.zoom > 1.02) drawBadge(dev);
    sync(dev);
  }

  // --- the words and numbers -----------------------------------------------------

  function sync(dev: number) {
    const { y0, y1, sec, tan, corner, left, right } = slopes();
    const w = state.which;
    const m = w === 'sec' ? sec : tan;
    const gap = Math.abs(sec - tan);
    const SEC = `rgb(${RGB.sec})`, TAN = `rgb(${RGB.tan})`;
    const z = zoomText(state.zoom);

    setEq({
      rule: [["f'(x_0)", TAN], '=', ['\\lim\\limits_{h\\to 0}\\frac{f(x_0+h)-f(x_0)}{h}', SEC]],
      live: corner
        ? [
            [`h\\to 0^-:\\ ${fixed(left, 3)}`, TAN],
            '\\ne',
            [`h\\to 0^+:\\ ${fixed(right, 3)}`, TAN],
            `\\quad\\Rightarrow\\ f'(${fixed(state.x0, 2)})\\ \\text{does not exist}`,
          ]
        : [
            [`f'(x_0) = ${fixed(tan, 3)}`, TAN],
            `\\quad h = ${state.h.toFixed(2)}:`,
            [`\\frac{\\Delta f}{h} = ${fixed(sec, 3)}`, SEC],
          ],
    });

    el('result-label').textContent = w === 'sec' ? 'Slope of the secant' : 'Slope of the tangent';
    const line = `y = ${fixed(y0, 2)} ${signed(m, 2)}(x ${signed(-state.x0, 2)})`;
    const zoomNote = corner
      ? `Zoomed ${z}, the corner is still a corner: from the left the slope is ${fixed(left, 2)}, from the right ${fixed(right, 2)}.`
      : state.zoom > 1.05
        ? `Zoomed ${z}, the curve strays ${dev < 0.1 ? 'less than 0.1' : dev.toFixed(1)} px from the tangent.`
        : '';
    if (w === 'tan' && corner) {
      setResult({
        value: 'none',
        colour: TAN,
        status: `No single number: the one-sided slopes are ${fixed(left, 3)} and ${fixed(right, 3)}`,
        note: `${zoomNote} The secant with h > 0 heads for ${fixed(right, 3)}, with h < 0 it would head for ${fixed(left, 3)}.`,
      });
    } else {
      setResult({
        value: fixed(m, 3),
        colour: w === 'sec' ? SEC : TAN,
        status:
          w === 'sec'
            ? `(f(x₀+h) − f(x₀)) / h = (${fixed(y1, 3)} ${signed(-y0, 3)}) / ${fixed(state.h, 3)}`
            : `The number the secant is heading for as h → 0`,
        note:
          (zoomNote ? zoomNote + ' ' : '') +
          (w === 'sec'
            ? corner
              ? `Line: ${line}`
              : `Gap to the tangent: ${fixed(gap, 3)}. Line: ${line}`
            : `At h = ${fixed(state.h, 2)} the secant still misses it by ${fixed(gap, 3)}. Line: ${line}`),
      });
    }

    setRows({
      'r-f': cur().eq,
      'r-df': cur().dq,
      'r-sec': fixed(sec, 3),
      'r-tan': corner ? `none (${fixed(left, 2)} | ${fixed(right, 2)})` : fixed(tan, 3),
      'r-gap': corner ? '—' : fixed(gap, 3),
      'r-dev': corner ? 'a corner, at any zoom' : `${dev < 0.1 ? '< 0.1' : dev.toFixed(1)} px at ${z}`,
    });
  }

  // --- controls -------------------------------------------------------------------

  const lines = segmented('line', (l) => { state.which = l as Which; draw(); });
  const fns = segmented('fn', (f) => { state.fn = f; draw(); });

  const stopAnimation = () => { cancelAnimationFrame(raf); raf = 0; };
  const setX0Slider = slider(
    'x0',
    (v) => {
      stopAnimation();
      // land exactly on a corner when the slider is on it
      state.x0 = Math.abs(v) < 1e-6 ? 0 : v;
      clampH();
      draw();
    },
    (v) => fixed(v, 2)
  );
  const setHSlider = slider('h', (v) => { stopAnimation(); state.h = v; draw(); }, (v) => v.toFixed(2));
  const hEl = el('h') as HTMLInputElement;

  function setH(h: number) {
    state.h = h;
    setHSlider(h);
  }
  /** Keep x₀ + h inside the window, so both points are always on screen. */
  function clampH() {
    const max = Math.max(0.06, Math.min(2.4, XR.max - 0.25 - state.x0));
    hEl.max = max.toFixed(2);
    if (state.h > max) setH(+max.toFixed(2));
    return max;
  }

  el('run').addEventListener('click', () => {
    stopAnimation();
    setH(clampH());
    const shrink = () => {
      const next = state.h * 0.94;
      if (next <= 0.02) { setH(0.02); draw(); raf = 0; return; }
      setH(+next.toFixed(3));
      draw();
      raf = requestAnimationFrame(() => setTimeout(shrink, 40));
    };
    shrink();
  });

  // --- zoom ----------------------------------------------------------------------
  // The zoom eases towards a target on a log scale, so ×1 → ×1000 takes the same
  // time per factor of ten and never jumps.

  const ZMAX = 1000;
  let zTarget = 1, zraf = 0;
  const zoomBtn = el('zoombtn') as HTMLButtonElement;
  const setZoomSlider = slider(
    'zoom',
    (v) => {
      cancelAnimationFrame(zraf);
      zraf = 0;
      state.zoom = zTarget = 10 ** v;
      paintZoomBtn();
      draw();
    },
    (v) => zoomText(10 ** v)
  );
  function paintZoomBtn() {
    zoomBtn.textContent = zTarget > 1.5 ? 'Zoom out' : 'Zoom in';
  }
  function zoomTo(target: number) {
    zTarget = Math.max(1, Math.min(ZMAX, target));
    paintZoomBtn();
    if (zraf) return;
    const tick = () => {
      const a = Math.log(state.zoom), b = Math.log(zTarget);
      const next = a + (b - a) * 0.075 + Math.sign(b - a) * 0.004;
      const done = Math.abs(b - next) < 0.006 || Math.sign(b - next) !== Math.sign(b - a);
      state.zoom = done ? zTarget : Math.exp(next);
      setZoomSlider(Math.log10(state.zoom));
      draw();
      zraf = done ? 0 : requestAnimationFrame(tick);
    };
    zraf = requestAnimationFrame(tick);
  }
  zoomBtn.addEventListener('click', () => zoomTo(zTarget > 1.5 ? 1 : ZMAX));

  canvas.addEventListener(
    'wheel',
    (e) => {
      const next = Math.max(1, Math.min(ZMAX, zTarget * Math.exp(-e.deltaY * (e.deltaMode ? 0.05 : 0.0025))));
      // at either end of the range the page scrolls as usual
      if (next === zTarget) return;
      e.preventDefault();
      zoomTo(next);
    },
    { passive: false }
  );

  // two fingers pinch the zoom; one finger selects a line
  const touches = new Map<number, { x: number; y: number }>();
  let pinch0 = 0, pinchZ = 1;
  const spread = () => {
    const [a, b] = [...touches.values()];
    return Math.hypot(a.x - b.x, a.y - b.y);
  };
  canvas.addEventListener('pointermove', (e) => {
    if (!touches.has(e.pointerId)) return;
    touches.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (touches.size === 2 && pinch0 > 0) zoomTo(pinchZ * (spread() / pinch0));
  });
  const lift = (e: PointerEvent) => {
    touches.delete(e.pointerId);
    if (touches.size < 2) pinch0 = 0;
  };
  canvas.addEventListener('pointerup', lift);
  canvas.addEventListener('pointercancel', lift);

  // click either line to select it
  canvas.addEventListener('pointerdown', (e) => {
    if (e.pointerType === 'touch') {
      touches.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (touches.size === 2) {
        pinch0 = spread();
        pinchZ = zTarget;
        return;
      }
    }
    const b = canvas.getBoundingClientRect();
    const x = ((e.clientX - b.left) / b.width) * W;
    const y = ((e.clientY - b.top) / b.height) * H;
    if (x > BOX.x + BOX.w || y > BOX.y + BOX.h) return;
    const { y0, sec, tan, left, right, corner } = slopes();
    let best: { w: Which; d: number } | null = null;
    const cands: [Which, number, number, number][] = corner
      ? [['sec', sec, V.x0, V.x1], ['tan', left, V.x0, state.x0], ['tan', right, state.x0, V.x1]]
      : [['sec', sec, V.x0, V.x1], ['tan', tan, V.x0, V.x1]];
    for (const [w, m, from, to] of cands) {
      const [p, q] = lineEnds(m, state.x0, y0, from, to);
      const vx = q.x - p.x, vy = q.y - p.y;
      const t = Math.max(0, Math.min(1, ((x - p.x) * vx + (y - p.y) * vy) / (vx * vx + vy * vy || 1)));
      const d = Math.hypot(p.x + vx * t - x, p.y + vy * t - y);
      if (!best || d < best.d) best = { w, d };
    }
    if (best && best.d < 26) {
      state.which = best.w;
      lines.select(best.w);
      draw();
    }
  });

  function show(fn: string, x0: number, h: number, which: Which = state.which) {
    stopAnimation();
    state.fn = fn;
    fns.select(fn);
    state.x0 = x0;
    setX0Slider(x0);
    state.which = which;
    lines.select(which);
    clampH();
    setH(h);
    draw();
  }
  /** Start a Try from the full view, so the zoom is seen happening. */
  function freshZoom() {
    cancelAnimationFrame(zraf);
    zraf = 0;
    state.zoom = zTarget = 1;
    setZoomSlider(0);
  }
  tries({
    limit: () => {
      freshZoom();
      draw();
      el('run').click();
    },
    zoom: () => {
      freshZoom();
      show('sine', 0.8, 0.6, 'tan');
      zoomTo(ZMAX);
    },
    kink: () => {
      freshZoom();
      show('kink', 0, 0.6, 'tan');
      zoomTo(ZMAX);
    },
    exp: () => {
      freshZoom();
      show('expo', 0.4, 1.2);
    },
  });

  clampH();
  draw();
</script>

<style>
  #dl {
    cursor: pointer;
    touch-action: pan-y;
  }
</style>
