---
import SimLayout from '../../../layouts/SimLayout.astro';
---

<SimLayout
  areaSlug="calculus"
  title="The Sum Rule"
  description="Add two functions and their graphs stack. Stack the heights and you stack the growths too, so the slopes simply add. It is the easiest rule in calculus, and seeing exactly why it is easy is what makes the product rule's extra term make sense."
>
  <div class="sim">
    <div class="sim-stage">
      <canvas id="sr" width="900" height="510"></canvas>
    </div>

    <div class="sim-panel">
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <button class="btn" id="run">▶ Watch the step</button>
        <button class="btn ghost" id="shrink">Shrink h → 0</button>
        <button class="btn ghost" id="reset">Reset</button>
      </div>

      <div class="control">
        <label>The two functions</label>
        <div class="seg" id="pair">
          <button data-p="0" class="active">x² and x</button>
          <button data-p="1">sin and x/2</button>
          <button data-p="2">x² and 2.4−x</button>
        </div>
      </div>

      <div class="control"><label>Point x <b id="xval">1.00</b></label><input type="range" id="x" min="0" max="100" value="40" /></div>

      <div class="control">
        <label>Step h <b id="hval">0.253</b></label>
        <input type="range" id="h" min="0" max="100" value="20" />
        <div class="scale-hint"><span>0.8</span><span>0.0025</span></div>
      </div>

      <div class="readout" id="rows"></div>

      <p style="font-size:.82rem;color:var(--text-faint);margin:0;line-height:1.5">
        Press <b>Watch the step</b> and the blocks grow in front of you. The
        lower block is u, the upper block is v, and the top of the tower is
        u + v.
      </p>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Press <b>Watch the step</b> and keep your eyes on the tower. The bottom
      block pushes up by Δu, carrying the whole upper block with it. Then the
      upper block grows by Δv on its own. The top moves by both amounts, one
      after the other, and <b>nothing else happens</b>.
    </li>
    <li>
      That is the entire rule. Divide those two rises by h and they become
      slopes: <b>(u+v)′ = u′ + v′</b>. The sentence under the equation says the
      same thing in words, with the live numbers filled in.
    </li>
    <li>
      Look at the three triangles at the bottom right. They share the same base
      h, and the tall one's height is <b>literally the other two stacked</b>.
      Two slopes, stacked, make the third slope.
    </li>
    <li>
      Shrink h. Everything shrinks together and the ratios never budge. Unlike
      the product rule, <b>nothing here has to be thrown away</b> in the limit:
      Δ(u+v) = Δu + Δv is exactly true at every h, not just as h approaches
      zero.
    </li>
    <li>
      Try <b>x² and 2.4−x</b>, where v falls while u climbs. The upper block
      shrinks, its rise is negative, and the tower still ends up exactly as tall
      as the two rises say. Addition never cared about signs.
    </li>
    <li>
      Ask why this feels obvious, because the answer matters. Stacking never
      lets the two <b>interact</b>: how tall u is does not change how fast v
      grows. Multiplying does let them interact, and that interaction is exactly
      the extra term in the product rule.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas } from '../../../lib/sim';
  import { equationBar } from '../../../lib/equation';

  type Pair = {
    u: (x: number) => number; du: (x: number) => number; ul: string;
    v: (x: number) => number; dv: (x: number) => number; vl: string;
    x0: number; x1: number;
  };
  const HMAX = 0.8;
  const PAIRS: Pair[] = [
    { u: (x) => x * x, du: (x) => 2 * x, ul: 'x²', v: (x) => x, dv: () => 1, vl: 'x', x0: 0.2, x1: 2 },
    { u: (x) => 1.4 + Math.sin(x), du: (x) => Math.cos(x), ul: '1.4+sin x', v: (x) => x / 2, dv: () => 0.5, vl: 'x/2', x0: 0.2, x1: 4 },
    { u: (x) => x * x, du: (x) => 2 * x, ul: 'x²', v: (x) => 2.4 - x, dv: () => -1, vl: '2.4−x', x0: 0.2, x1: 2 },
  ];

  const state = { pi: 0, xs: 40, hs: 20, tau: 1, playing: false, shrinking: false };
  const P = () => PAIRS[state.pi];
  const hFull = () => HMAX * Math.pow(10, -state.hs / 40);
  const hOf = () => hFull() * state.tau;   // the step as currently animated
  const xOf = () => P().x0 + ((P().x1 - P().x0) * state.xs) / 100;

  const setEq = equationBar();
  const canvas = document.getElementById('sr') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const css = (n: string) => getComputedStyle(canvas).getPropertyValue(n).trim();
  const ink = () => css('--stage-ink') || '232,233,236';
  const ACC = '#7c8cff', WARM = '#f59e0b';

  const G = { x: 56, y: 64, w: 448, h: 402 };
  const ST = { x: 556, y: 64, w: 300, h: 206 };
  const TRI = { x: 556, y: 338, w: 300, h: 128 };

  function tint(hex: string, a: number) {
    const n = parseInt(hex.slice(1), 16);
    return `rgba(${(n >> 16) & 255},${(n >> 8) & 255},${n & 255},${a})`;
  }
  function text(t: string, x: number, y: number, a = 0.55, al: CanvasTextAlign = 'left', size = 12, weight = '') {
    ctx.fillStyle = `rgba(${ink()},${a})`;
    ctx.font = `${weight} ${size}px ui-monospace, monospace`.trim();
    ctx.textAlign = al;
    ctx.fillText(t, x, y);
    ctx.textAlign = 'left';
  }
  /** A line of text whose numbers can be coloured, centred on cx. */
  function runText(parts: [string, string, number][], cx: number, y: number, size: number, weight = '600') {
    ctx.font = `${weight} ${size}px ui-monospace, monospace`;
    let total = 0;
    for (const [s] of parts) total += ctx.measureText(s).width;
    let x = cx - total / 2;
    ctx.textAlign = 'left';
    for (const [s, c, a] of parts) {
      ctx.fillStyle = c === 'ink' ? `rgba(${ink()},${a})` : tint(c, a);
      ctx.fillText(s, x, y);
      x += ctx.measureText(s).width;
    }
  }

  /** The rule itself, above the stage, each term in its colour. */
  function drawHeader() {
    const p = P(), x = xOf(), h = hOf();
    const du = p.u(x + h) - p.u(x), dv = p.v(x + h) - p.v(x);
    setEq([
      ["(u+v)'", '=', ["u'", ACC], '+', ["v'", WARM]],
      [
        (p.du(x) + p.dv(x)).toFixed(3),
        '=',
        [p.du(x).toFixed(3), ACC],
        '+',
        [p.dv(x).toFixed(3), WARM],
      ],
      [
        `step x by ${h.toFixed(3)} and u rises `,
        [du.toFixed(3), ACC],
        ', v rises ',
        [dv.toFixed(3), WARM],
        `, so the top rises ${(du + dv).toFixed(3)}`,
      ],
    ]);
  }


  function drawGraph() {
    const p = P(), x = xOf(), h = hOf();
    const f = (t: number) => p.u(t) + p.v(t);
    const xEnd = p.x1 + HMAX;
    let lo = 0, hi = -Infinity;
    for (let i = 0; i <= 160; i++) {
      const t = p.x0 + ((xEnd - p.x0) * i) / 160;
      hi = Math.max(hi, f(t));
      lo = Math.min(lo, p.v(t), p.u(t), 0);
    }
    hi *= 1.08;
    const X = (t: number) => G.x + ((t - p.x0) / (xEnd - p.x0)) * G.w;
    const Y = (y: number) => G.y + G.h - ((y - lo) / (hi - lo)) * G.h;

    text('THE TALL CURVE IS THE OTHER TWO STACKED', G.x, G.y - 26, 0.5, 'left', 12, '600');
    text(`u = ${p.ul}    v = ${p.vl}`, G.x, G.y - 10, 0.35);
    ctx.strokeStyle = `rgba(${ink()},0.2)`;
    ctx.lineWidth = 1;
    ctx.strokeRect(G.x, G.y, G.w, G.h);
    if (lo < 0) {
      ctx.strokeStyle = `rgba(${ink()},0.25)`;
      ctx.beginPath();
      ctx.moveTo(G.x, Y(0));
      ctx.lineTo(G.x + G.w, Y(0));
      ctx.stroke();
    }

    // at every tick, v's height is carried up and set on top of u
    ctx.strokeStyle = tint(WARM, 0.3);
    ctx.lineWidth = 1;
    for (let i = 1; i < 26; i++) {
      const t = p.x0 + ((xEnd - p.x0) * i) / 26;
      ctx.beginPath();
      ctx.moveTo(X(t), Y(p.u(t)));
      ctx.lineTo(X(t), Y(p.u(t) + p.v(t)));
      ctx.stroke();
    }

    const curve = (g: (t: number) => number, color: string, wd: number, dash: number[] = []) => {
      ctx.setLineDash(dash);
      ctx.strokeStyle = color;
      ctx.lineWidth = wd;
      ctx.beginPath();
      for (let i = 0; i <= 240; i++) {
        const t = p.x0 + ((xEnd - p.x0) * i) / 240;
        i ? ctx.lineTo(X(t), Y(g(t))) : ctx.moveTo(X(t), Y(g(t)));
      }
      ctx.stroke();
      ctx.setLineDash([]);
    };
    curve((t) => p.v(t), WARM, 1.8, [5, 4]);
    curve((t) => p.u(t), ACC, 2);
    curve(f, `rgba(${ink()},0.92)`, 2.8);

    text('u + v', X(xEnd) - 8, Y(f(xEnd)) - 9, 0.85, 'right', 12, '600');
    ctx.fillStyle = tint(ACC, 1);
    ctx.font = '600 12px ui-monospace, monospace';
    ctx.textAlign = 'right';
    ctx.fillText('u', X(xEnd) - 8, Y(p.u(xEnd)) - 9);
    ctx.fillStyle = tint(WARM, 1);
    ctx.fillText('v', X(xEnd) - 8, Y(p.v(xEnd)) - 9);
    ctx.textAlign = 'left';

    for (const t of [x, x + h]) {
      ctx.strokeStyle = `rgba(${ink()},0.3)`;
      ctx.setLineDash([3, 3]);
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(X(t), G.y);
      ctx.lineTo(X(t), G.y + G.h);
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = `rgba(${ink()},0.95)`;
      ctx.beginPath();
      ctx.arc(X(t), Y(f(t)), 4, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = tint(ACC, 1);
      ctx.beginPath();
      ctx.arc(X(t), Y(p.u(t)), 3.5, 0, Math.PI * 2);
      ctx.fill();
    }
    text('x', X(x), G.y + G.h + 17, 0.55, 'center', 11);
    if (X(x + h) - X(x) > 24) text('x+h', X(x + h), G.y + G.h + 17, 0.55, 'center', 11);
  }

  /** The tower, before and after the step. */
  function drawTower() {
    const p = P(), x = xOf(), h = hOf();
    const u0 = p.u(x), v0 = p.v(x);
    const u1 = p.u(x + h), v1 = p.v(x + h);
    const uF = p.u(x + hFull()), vF = p.v(x + hFull());

    text('THE TOWER GROWS TWICE', ST.x, ST.y - 26, 0.5, 'left', 12, '600');
    text('once for u, once for v', ST.x, ST.y - 10, 0.35);

    const top = Math.max(u0 + v0, uF + vF, 0.001) * 1.12;
    const base = ST.y + ST.h - 22;
    const sc = (ST.h - 34) / top;
    const bw = 84, gap = 122;
    const bar = (bx: number, uu: number, vv: number, faded: boolean) => {
      ctx.fillStyle = tint(ACC, faded ? 0.18 : 0.45);
      ctx.fillRect(bx, base - uu * sc, bw, uu * sc);
      ctx.strokeStyle = tint(ACC, faded ? 0.4 : 0.95);
      ctx.lineWidth = 1.4;
      ctx.strokeRect(bx + 0.5, base - uu * sc + 0.5, bw - 1, uu * sc - 1);
      ctx.fillStyle = tint(WARM, faded ? 0.18 : 0.45);
      ctx.fillRect(bx, base - (uu + vv) * sc, bw, vv * sc);
      ctx.strokeStyle = tint(WARM, faded ? 0.4 : 0.95);
      ctx.strokeRect(bx + 0.5, base - (uu + vv) * sc + 0.5, bw - 1, vv * sc - 1);
    };
    bar(ST.x, u0, v0, true);
    bar(ST.x + gap, u1, v1, false);

    const band = (y0: number, y1: number, color: string, lbl: string) => {
      const a = base - y0 * sc, b = base - y1 * sc;
      const hh = Math.abs(b - a);
      ctx.fillStyle = tint(color, 0.95);
      ctx.fillRect(ST.x + gap, Math.min(a, b), bw, Math.max(1.5, hh));
      if (hh > 15) {
        ctx.fillStyle = 'rgba(10,11,14,0.9)';
        ctx.font = '600 12px ui-monospace, monospace';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(lbl, ST.x + gap + bw / 2, (a + b) / 2);
        ctx.textBaseline = 'alphabetic';
        ctx.textAlign = 'left';
      }
    };
    band(u0, u1, ACC, 'Δu');
    band(u1 + v0, u1 + v1, WARM, 'Δv');

    text('at x', ST.x + bw / 2, base + 16, 0.45, 'center', 11);
    text('at x + h', ST.x + gap + bw / 2, base + 16, 0.45, 'center', 11);

    const yTop = base - (u1 + v1) * sc, yOld = base - (u0 + v0) * sc;
    const bx = ST.x + gap + bw + 12;
    ctx.strokeStyle = `rgba(${ink()},0.65)`;
    ctx.lineWidth = 1.4;
    ctx.beginPath();
    ctx.moveTo(bx - 5, yOld);
    ctx.lineTo(bx, yOld);
    ctx.lineTo(bx, yTop);
    ctx.lineTo(bx - 5, yTop);
    ctx.stroke();
    text('Δu+Δv', bx + 5, (yTop + yOld) / 2 + 4, 0.85, 'left', 11, '600');
  }

  /** Three slope triangles on a common base: the third is the other two stacked. */
  function drawTriangles() {
    const p = P(), x = xOf(), h = hOf();
    const du = p.u(x + h) - p.u(x), dv = p.v(x + h) - p.v(x);
    text('SAME BASE h, HEIGHTS STACK', TRI.x, TRI.y - 26, 0.5, 'left', 12, '600');
    text('which is why the slopes add', TRI.x, TRI.y - 10, 0.35);

    const mx = Math.max(Math.abs(du), Math.abs(dv), Math.abs(du + dv), 1e-9);
    const baseW = 58, gap = 100, hMax = TRI.h - 40;
    const yB = TRI.y + TRI.h - 22;
    const tri = (bx: number, rises: [number, string][], label: string) => {
      let acc = 0;
      for (const [r, c] of rises) {
        const y0 = yB - (acc / mx) * hMax;
        const y1 = yB - ((acc + r) / mx) * hMax;
        ctx.fillStyle = tint(c, 0.45);
        ctx.beginPath();
        ctx.moveTo(bx, y0);
        ctx.lineTo(bx + baseW, y0);
        ctx.lineTo(bx + baseW, y1);
        ctx.closePath();
        ctx.fill();
        ctx.strokeStyle = tint(c, 1);
        ctx.lineWidth = 1.8;
        ctx.beginPath();
        ctx.moveTo(bx, y0);
        ctx.lineTo(bx + baseW, y1);
        ctx.stroke();
        acc += r;
      }
      ctx.strokeStyle = `rgba(${ink()},0.4)`;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(bx, yB);
      ctx.lineTo(bx + baseW, yB);
      ctx.stroke();
      text(label, bx + baseW / 2, yB + 16, 0.6, 'center', 11, '600');
    };
    tri(TRI.x, [[du, ACC]], 'u');
    tri(TRI.x + gap, [[dv, WARM]], 'v');
    tri(TRI.x + 2 * gap, [[du, ACC], [dv, WARM]], 'u+v');
    text('+', TRI.x + gap - 21, yB - hMax / 2, 0.45, 'center', 17, '600');
    text('=', TRI.x + 2 * gap - 21, yB - hMax / 2, 0.45, 'center', 17, '600');
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    drawHeader();
    drawGraph();
    drawTower();
    drawTriangles();
    updateRows();
  }

  const rows = document.getElementById('rows') as HTMLElement;
  const row = (a: string, b: string) => `<div class="row"><span>${a}</span><b>${b}</b></div>`;
  function updateRows() {
    const p = P(), x = xOf(), h = hOf();
    const du = p.u(x + h) - p.u(x), dv = p.v(x + h) - p.v(x);
    rows.innerHTML =
      row('Δu', du.toFixed(4)) +
      row('Δv', dv.toFixed(4)) +
      row('Δ(u+v)', (du + dv).toFixed(4)) +
      row('Δ(u+v)/h', h > 1e-9 ? ((du + dv) / h).toFixed(4) : '—') +
      row('u′ + v′', (p.du(x) + p.dv(x)).toFixed(4)) +
      row('leftover terms', 'none, ever');
  }

  // --- controls ------------------------------------------------------------
  const el = (id: string) => document.getElementById(id) as HTMLElement;
  const runBtn = el('run');
  let raf = 0, t0 = 0;

  function stopAll() {
    state.playing = false;
    state.shrinking = false;
    runBtn.textContent = '▶ Watch the step';
    cancelAnimationFrame(raf);
  }
  function loop(now: number) {
    if (state.playing) {
      // grow the step over 1.3 s, hold it a moment, then start over
      const cycle = ((now - t0) / 1000) % 2.1;
      state.tau = cycle < 1.3 ? 0.03 + 0.97 * (cycle / 1.3) : 1;
      draw();
      raf = requestAnimationFrame(loop);
    } else if (state.shrinking) {
      if (state.hs >= 100) { stopAll(); return; }
      setH(Math.min(100, state.hs + 0.6));
      raf = requestAnimationFrame(loop);
    }
  }
  runBtn.addEventListener('click', () => {
    if (state.playing) { stopAll(); state.tau = 1; draw(); return; }
    stopAll();
    state.playing = true;
    runBtn.textContent = '❚❚ Stop';
    t0 = performance.now();
    raf = requestAnimationFrame(loop);
  });
  el('shrink').addEventListener('click', () => {
    const was = state.shrinking;
    stopAll();
    state.tau = 1;
    if (was) { draw(); return; }
    if (state.hs >= 100) setH(0);
    state.shrinking = true;
    raf = requestAnimationFrame(loop);
  });
  el('reset').addEventListener('click', () => {
    stopAll();
    state.tau = 1;
    state.xs = 40;
    (el('x') as HTMLInputElement).value = '40';
    el('xval').textContent = xOf().toFixed(2);
    setH(20);
  });

  el('pair').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (!b) return;
    document.querySelectorAll('#pair button').forEach((n) => n.classList.remove('active'));
    b.classList.add('active');
    state.pi = +b.dataset.p!;
    el('xval').textContent = xOf().toFixed(2);
    draw();
  });
  const xEl = el('x') as HTMLInputElement, hEl = el('h') as HTMLInputElement;
  xEl.addEventListener('input', () => {
    state.xs = +xEl.value;
    el('xval').textContent = xOf().toFixed(2);
    draw();
  });
  function setH(v: number) {
    state.hs = v;
    hEl.value = String(v);
    const h = hFull();
    el('hval').textContent = h < 0.01 ? h.toFixed(5) : h.toFixed(3);
    draw();
  }
  hEl.addEventListener('input', () => { state.tau = 1; setH(+hEl.value); });

  el('xval').textContent = xOf().toFixed(2);
  setH(20);
</script>

<style>
  .scale-hint {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: var(--text-faint);
    margin-top: 3px;
  }
  #pair button {
    font-size: 0.78rem;
    padding: 5px 9px;
  }
</style>
