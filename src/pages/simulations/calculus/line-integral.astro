---
import SimLayout from '../../../layouts/SimLayout.astro';
---

<SimLayout
  areaSlug="calculus"
  title="Line Integrals"
  description="Ride a bead along a curve through a field and keep one running account: at every step, how much of the field points the way you are going. That is the whole of a line integral, and the shaded area under the little graph is the number itself."
>
  <div class="sim">
    <div class="sim-stage">
      <canvas id="li" class="li-canvas" width="900" height="560"></canvas>
    </div>

    <div class="sim-panel">
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <button class="btn" id="run">Pause</button>
        <button class="btn ghost" id="reset">Restart</button>
      </div>

      <div class="control">
        <label>Field</label>
        <div class="seg" id="field">
          <button data-f="uniform" class="active">Uniform</button>
          <button data-f="central">Central</button>
          <button data-f="swirl">Swirl</button>
        </div>
      </div>

      <div class="control">
        <label>Path from A to B</label>
        <div class="seg" id="path">
          <button data-p="straight" class="active">Straight</button>
          <button data-p="detour">Detour</button>
          <button data-p="loop">Closed loop</button>
        </div>
      </div>

      <div class="control" id="bulgewrap">
        <label>How far it detours <b id="bulgeval">0.80</b></label>
        <input type="range" id="bulge" min="-120" max="120" step="5" value="80" />
      </div>

      <label class="check"
        ><input type="checkbox" id="showfield" checked /> Show the field</label
      >

      <div class="readout">
        <div class="row"><span>Collected so far</span><b id="sofar">—</b></div>
        <div class="row"><span>Whole path</span><b id="total">—</b></div>
        <div class="row"><span>Straight path, for comparison</span><b id="ref">—</b></div>
        <div class="row"><span>Adding right now</span><b id="rate">—</b></div>
      </div>

      <p class="note">
        The bead adds up F·T̂ step by step along the curve you see, and you can
        drag along the graph to move it by hand.
      </p>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Look at the panel on the right. The field arrow points wherever the field
      points, the grey arrow points the way you are travelling, and the only
      thing that gets added is <b>the shadow of one on the other</b>. Side on, the
      bead travels a long way and collects nothing at all.
    </li>
    <li>
      The graph under the scene is that shadow, plotted as you go. <b>The shaded
      area is the integral</b>: teal above the line adds, orange below it takes
      away, and the running total is just the area so far.
    </li>
    <li>
      With <b>uniform</b> or <b>central</b>, note the total on the straight path,
      then switch to <b>detour</b> and swing the slider anywhere you like. The bead
      travels much further and spends time fighting the field, yet arrives with
      <b>exactly the same total</b>. Only the endpoints mattered, which is what
      conservative means.
    </li>
    <li>
      Now switch to <b>swirl</b> and try it again. The detour no longer matches the
      straight line, so the path itself matters, no potential can exist for this
      field, and there is nothing to call height.
    </li>
    <li>
      Take the <b>closed loop</b>. In the conservative fields you come back to zero
      however you go round, because you finish where you started. In the swirl you
      do not, and what is left over is the circulation: the spin trapped inside
      the loop.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equationBar } from '../../../lib/equation';
  import { HUE, V2, v2, arrow, tick, roundRect } from '../../../lib/theorem';

  type Field = 'uniform' | 'central' | 'swirl';
  type Path = 'straight' | 'detour' | 'loop';

  const state = {
    field: 'uniform' as Field,
    path: 'straight' as Path,
    bulge: 0.8,
    showField: true,
    playing: true,
    t: 0, // where the bead is, 0..1
  };

  function F(p: V2): V2 {
    switch (state.field) {
      case 'uniform':
        return v2(0.85, 0.4);
      case 'central':
        return v2(-p.x * 0.85, -p.y * 0.85);
      case 'swirl':
        return v2(-p.y * 0.9, p.x * 0.9);
    }
  }

  // --- the paths ------------------------------------------------------------
  const A = v2(-1.15, -0.6);
  const B = v2(1.15, 0.55);

  function at(path: Path, s: number): V2 {
    if (path === 'loop') {
      const a = 2 * Math.PI * s;
      const r = 0.8 + 0.12 * Math.cos(3 * a + 0.7);
      return v2(r * Math.cos(a) * 1.3, r * Math.sin(a));
    }
    const base = v2(A.x + (B.x - A.x) * s, A.y + (B.y - A.y) * s);
    if (path === 'straight') return base;
    const dx = B.x - A.x,
      dy = B.y - A.y;
    const l = Math.hypot(dx, dy);
    const bump = Math.sin(Math.PI * s) * state.bulge;
    return v2(base.x + (-dy / l) * bump, base.y + (dx / l) * bump);
  }

  const N = 480;
  type Sample = { p: V2; push: number; acc: number };
  let samples: Sample[] = [];
  let total = 0;
  let refTotal = 0;
  let maxPush = 1;

  /** Walk a path, adding F·dr one small step at a time. */
  function walk(path: Path) {
    const out: Sample[] = [];
    let acc = 0;
    for (let i = 0; i <= N; i++) {
      const s = i / N;
      const p = at(path, s);
      const back = at(path, Math.max(0, s - 1 / N));
      const fwd = at(path, Math.min(1, s + 1 / N));
      const tx = fwd.x - back.x,
        ty = fwd.y - back.y;
      const tl = Math.hypot(tx, ty) || 1;
      const f = F(p);
      const push = (f.x * tx + f.y * ty) / tl; // F·T̂, the part that counts
      if (i > 0) {
        const prev = out[i - 1];
        const ds = Math.hypot(p.x - prev.p.x, p.y - prev.p.y);
        acc += ((push + prev.push) / 2) * ds;
      }
      out.push({ p, push, acc });
    }
    return { samples: out, total: acc };
  }

  function build() {
    const w = walk(state.path);
    samples = w.samples;
    total = w.total;
    refTotal = state.path === 'straight' ? total : walk('straight').total;
    maxPush = 1e-9;
    for (const s of samples) maxPush = Math.max(maxPush, Math.abs(s.push));
  }

  // --- canvas ---------------------------------------------------------------
  const setEq = equationBar();
  const canvas = document.getElementById('li') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const css = (n: string, f = '') =>
    getComputedStyle(canvas).getPropertyValue(n).trim() || f;
  const ink = (a: number) => `rgba(${css('--stage-ink', '232,233,236')},${a})`;
  const { label } = makeText(ctx, ink);
  const accent = () => css('--accent', '#7c8cff');
  const fmt = (v: number) => (Math.abs(v) < 5e-4 ? '0.000' : v.toFixed(3));

  const SC = { cx: 302, cy: 222, s: 150 };
  const PLOT = { x: 34, y: 442, w: 548, h: 80 };
  const CARD = { x: 612, y: 64, w: 268, h: 300 };
  const px = (p: V2) => ({ x: SC.cx + p.x * SC.s, y: SC.cy - p.y * SC.s });
  const bead = () => samples[Math.round(state.t * N)];
  /** The unit direction of travel at the bead. */
  function heading(): V2 {
    const i = Math.max(1, Math.round(state.t * N));
    const a = samples[i - 1].p,
      b = samples[i].p;
    const l = Math.hypot(b.x - a.x, b.y - a.y) || 1;
    return v2((b.x - a.x) / l, (b.y - a.y) / l);
  }

  function drawField() {
    if (!state.showField) return;
    const G = 12;
    for (let i = 0; i <= G; i++)
      for (let j = 0; j <= 8; j++) {
        const p = v2(-1.7 + (3.4 * i) / G, -1.2 + (2.4 * j) / 8);
        const f = F(p);
        const m = Math.hypot(f.x, f.y);
        if (m < 1e-4) continue;
        const a = px(p);
        tick(ctx, a.x, a.y, f.x, -f.y, Math.min(30, 12 + m * 13), ink(0.3), 1.6);
      }
  }

  function drawScene() {
    drawField();

    // the path, painted by what it is collecting at each step
    ctx.lineWidth = 5;
    ctx.lineCap = 'round';
    for (let i = 1; i < samples.length; i++) {
      const a = px(samples[i - 1].p),
        b = px(samples[i].p);
      const k = Math.min(1, Math.abs(samples[i].push) / maxPush);
      ctx.strokeStyle =
        samples[i].push >= 0
          ? `rgba(52,211,153,${0.22 + 0.6 * k})`
          : `rgba(255,122,92,${0.22 + 0.6 * k})`;
      ctx.beginPath();
      ctx.moveTo(a.x, a.y);
      ctx.lineTo(b.x, b.y);
      ctx.stroke();
    }

    const ends: [V2, string][] =
      state.path === 'loop'
        ? [[at('loop', 0), 'start']]
        : [
            [A, 'A'],
            [B, 'B'],
          ];
    for (const [p, name] of ends) {
      const q = px(p);
      ctx.fillStyle = ink(0.75);
      ctx.beginPath();
      ctx.arc(q.x, q.y, 4.5, 0, Math.PI * 2);
      ctx.fill();
      label(name, q.x, q.y - 14, 0.6, 'center', 11);
    }

    // the bead, and the two arrows that decide everything
    const s = bead();
    const q = px(s.p);
    const u = heading();
    const f = F(s.p);
    const K = 60;
    const T = { x: u.x * K, y: -u.y * K };
    const Fv = { x: f.x * K, y: -f.y * K };
    const proj = (Fv.x * T.x + Fv.y * T.y) / (T.x * T.x + T.y * T.y);
    const S = { x: T.x * proj, y: T.y * proj };

    ctx.setLineDash([3, 4]);
    ctx.strokeStyle = ink(0.35);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(q.x + Fv.x, q.y + Fv.y);
    ctx.lineTo(q.x + S.x, q.y + S.y);
    ctx.stroke();
    ctx.setLineDash([]);

    ctx.strokeStyle = s.push >= 0 ? HUE.with : HUE.against;
    ctx.lineWidth = 7;
    ctx.lineCap = 'butt';
    ctx.beginPath();
    ctx.moveTo(q.x, q.y);
    ctx.lineTo(q.x + S.x, q.y + S.y);
    ctx.stroke();

    arrow(ctx, q.x, q.y, q.x + T.x, q.y + T.y, ink(0.5), 2, 8);
    arrow(ctx, q.x, q.y, q.x + Fv.x, q.y + Fv.y, accent(), 2.6, 9);
    ctx.fillStyle = ink(0.95);
    ctx.beginPath();
    ctx.arc(q.x, q.y, 5.5, 0, Math.PI * 2);
    ctx.fill();
  }

  // --- the running graph: the integrand, and its area ------------------------
  function drawPlot() {
    const y0 = PLOT.y + PLOT.h / 2;
    const sx = (i: number) => PLOT.x + (PLOT.w * i) / N;
    const sy = (v: number) => y0 - (v / maxPush) * (PLOT.h / 2 - 5);

    label('HOW MUCH OF THE FIELD POINTS YOUR WAY', PLOT.x, PLOT.y - 12, 0.42, 'left', 11);
    label(
      'the shaded area is the total',
      PLOT.x + PLOT.w,
      PLOT.y - 12,
      0.3,
      'right',
      10.5
    );

    const upto = Math.round(state.t * N);
    for (const sign of [1, -1]) {
      ctx.beginPath();
      ctx.moveTo(sx(0), y0);
      for (let i = 0; i <= upto; i++)
        ctx.lineTo(
          sx(i),
          sy(sign > 0 ? Math.max(0, samples[i].push) : Math.min(0, samples[i].push))
        );
      ctx.lineTo(sx(upto), y0);
      ctx.closePath();
      ctx.fillStyle = sign > 0 ? 'rgba(52,211,153,0.32)' : 'rgba(255,122,92,0.32)';
      ctx.fill();
    }

    ctx.strokeStyle = ink(0.14);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(PLOT.x, y0);
    ctx.lineTo(PLOT.x + PLOT.w, y0);
    ctx.stroke();

    ctx.strokeStyle = ink(0.45);
    ctx.lineWidth = 1.8;
    ctx.beginPath();
    for (let i = 0; i <= N; i++) {
      const x = sx(i),
        y = sy(samples[i].push);
      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    }
    ctx.stroke();

    const bx = sx(upto);
    ctx.strokeStyle = accent();
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(bx, PLOT.y - 4);
    ctx.lineTo(bx, PLOT.y + PLOT.h + 4);
    ctx.stroke();
    label('0', PLOT.x - 8, y0 + 4, 0.35, 'right', 10.5);
    label('start', PLOT.x, PLOT.y + PLOT.h + 18, 0.3, 'left', 10.5);
    label('end', PLOT.x + PLOT.w, PLOT.y + PLOT.h + 18, 0.3, 'right', 10.5);
  }

  // --- this moment, opened up -----------------------------------------------
  function drawCard() {
    ctx.save();
    roundRect(ctx, CARD.x, CARD.y, CARD.w, CARD.h, 12);
    ctx.fillStyle = ink(0.04);
    ctx.fill();
    ctx.strokeStyle = ink(0.12);
    ctx.lineWidth = 1;
    ctx.stroke();
    ctx.clip();

    label('AT THE BEAD, RIGHT NOW', CARD.x + 16, CARD.y + 24, 0.45, 'left', 11);

    const s = bead();
    const u = heading();
    const f = F(s.p);
    // turned so the way you are going always points right
    const along = f.x * u.x + f.y * u.y;
    const side = -f.x * u.y + f.y * u.x;

    const cx = CARD.x + 74,
      cy = CARD.y + 130;
    const K = 62;
    arrow(ctx, cx, cy, cx + K, cy, ink(0.5), 2, 8);
    label('your way', cx + K + 8, cy + 4, 0.42, 'left', 10.5);

    const fx = cx + along * K,
      fy = cy - side * K;
    ctx.setLineDash([3, 4]);
    ctx.strokeStyle = ink(0.3);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(fx, fy);
    ctx.lineTo(cx + along * K, cy);
    ctx.stroke();
    ctx.setLineDash([]);

    ctx.strokeStyle = s.push >= 0 ? HUE.with : HUE.against;
    ctx.lineWidth = 8;
    ctx.lineCap = 'butt';
    ctx.beginPath();
    ctx.moveTo(cx, cy);
    ctx.lineTo(cx + along * K, cy);
    ctx.stroke();
    arrow(ctx, cx, cy, fx, fy, accent(), 2.6, 9);
    label(
      'the field',
      fx + (along >= 0 ? 10 : -10),
      fy + (side >= 0 ? -10 : 18),
      0.8,
      along >= 0 ? 'left' : 'right',
      10.5,
      accent()
    );
    // keep the caption on the opposite side of the axis from the field arrow
    label(
      'what it adds',
      cx + (along * K) / 2,
      cy + (side >= 0 ? 22 : -16),
      0.85,
      'center',
      10.5,
      s.push >= 0 ? HUE.with : HUE.against
    );

    const y = CARD.y + 214;
    const angle = (Math.atan2(side, along) * 180) / Math.PI;
    label('size of the field', CARD.x + 16, y, 0.4, 'left', 10.5);
    label(Math.hypot(f.x, f.y).toFixed(3), CARD.x + CARD.w - 16, y, 0.7, 'right', 12);
    label('angle to the path', CARD.x + 16, y + 26, 0.4, 'left', 10.5);
    label(
      `${Math.abs(angle).toFixed(0)}°`,
      CARD.x + CARD.w - 16,
      y + 26,
      0.7,
      'right',
      12
    );
    label('so it adds', CARD.x + 16, y + 52, 0.4, 'left', 10.5);
    label(
      `${s.push >= 0 ? '+' : ''}${fmt(s.push)}`,
      CARD.x + CARD.w - 16,
      y + 52,
      0.95,
      'right',
      13,
      s.push >= 0 ? HUE.with : HUE.against
    );
    ctx.restore();

    const q = px(s.p);
    ctx.strokeStyle = ink(0.18);
    ctx.setLineDash([3, 4]);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(q.x, q.y);
    ctx.lineTo(CARD.x, CARD.y + CARD.h / 2);
    ctx.stroke();
    ctx.setLineDash([]);
  }


  function draw() {
    ctx.clearRect(0, 0, W, H);
    ctx.save();
    ctx.beginPath();
    ctx.rect(0, 14, 598, 412);
    ctx.clip();
    drawScene();
    ctx.restore();
    drawPlot();
    drawCard();
    sync();
  }

  function sync() {
    const s = bead();
    setEq([
      [
        ['\\int_C \\mathbf{F}\\cdot d\\mathbf{r}', accent()],
        '=\\int_C\\big(',
        ['\\mathbf{F}\\cdot\\hat{\\mathbf{T}}', s.push >= 0 ? HUE.with : HUE.against],
        '\\big)\\,ds',
      ],
      [
        [`\\text{so far }${fmt(s.acc)}`, accent()],
        [
          `\\quad\\text{${state.path === 'loop' ? 'once round' : 'whole path'} }${fmt(total)}`,
          HUE.with,
        ],
        `\\quad\\text{adding now }${s.push >= 0 ? '+' : ''}${fmt(s.push)}`,
        state.path === 'detour'
          ? `\\quad\\text{straight from A to B }${fmt(refTotal)}`
          : '',
      ],
      [
        state.path === 'detour'
          ? Math.abs(total - refTotal) < 5e-3
            ? 'the same as the straight line: only the two ends matter here'
            : 'not the same as the straight line: here the road you take changes the answer'
          : state.path === 'loop'
            ? Math.abs(total) < 5e-3
              ? 'back to zero: you finished where you started'
              : 'not zero: the loop keeps the spin it went round'
            : 'teal where the field pushes you along, orange where it holds you back',
      ],
    ]);
    const set = (id: string, v: string) =>
      ((document.getElementById(id) as HTMLElement).textContent = v);
    set('sofar', fmt(s.acc));
    set('total', fmt(total));
    set('ref', fmt(refTotal));
    set('rate', `${s.push >= 0 ? '+' : ''}${fmt(s.push)}`);
    set('bulgeval', state.bulge.toFixed(2));
    (document.getElementById('bulgewrap') as HTMLElement).style.display =
      state.path === 'detour' ? '' : 'none';
  }

  // --- animation ------------------------------------------------------------
  let last = 0;
  function frame(now: number) {
    const dt = last ? Math.min(0.05, (now - last) / 1000) : 0;
    last = now;
    if (state.playing) {
      state.t += dt * 0.2;
      if (state.t > 1) state.t = 0;
      draw();
    }
    requestAnimationFrame(frame);
  }

  // --- controls -------------------------------------------------------------
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const segment = (id: string, fn: (v: string) => void) =>
    $(id).addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      $(id)
        .querySelectorAll('button')
        .forEach((x) => x.classList.remove('active'));
      b.classList.add('active');
      fn(Object.values(b.dataset)[0] as string);
    });

  segment('field', (f) => {
    state.field = f as Field;
    build();
    draw();
  });
  segment('path', (p) => {
    state.path = p as Path;
    state.t = 0;
    build();
    draw();
  });
  $('bulge').addEventListener('input', (e) => {
    state.bulge = +(e.target as HTMLInputElement).value / 100;
    build();
    draw();
  });
  ($('showfield') as HTMLInputElement).addEventListener('change', (e) => {
    state.showField = (e.target as HTMLInputElement).checked;
    draw();
  });
  $('run').addEventListener('click', () => {
    state.playing = !state.playing;
    $('run').textContent = state.playing ? 'Pause' : 'Play';
  });
  $('reset').addEventListener('click', () => {
    state.t = 0;
    draw();
  });

  // drag anywhere along the graph to move the bead by hand
  let scrubbing = false;
  const scrub = (clientX: number) => {
    const b = canvas.getBoundingClientRect();
    const x = ((clientX - b.left) / b.width) * W;
    state.t = Math.max(0, Math.min(1, (x - PLOT.x) / PLOT.w));
    draw();
  };
  canvas.addEventListener('pointerdown', (e) => {
    const b = canvas.getBoundingClientRect();
    const y = ((e.clientY - b.top) / b.height) * H;
    if (y < PLOT.y - 24 || y > PLOT.y + PLOT.h + 16) return;
    scrubbing = true;
    state.playing = false;
    $('run').textContent = 'Play';
    try {
      canvas.setPointerCapture(e.pointerId);
    } catch {
      /* synthetic pointers are fine to ignore */
    }
    scrub(e.clientX);
  });
  canvas.addEventListener('pointermove', (e) => {
    if (scrubbing) scrub(e.clientX);
  });
  canvas.addEventListener('pointerup', () => (scrubbing = false));
  canvas.addEventListener('pointercancel', () => (scrubbing = false));

  build();
  draw();
  requestAnimationFrame(frame);
</script>

<style>
  .li-canvas {
    cursor: pointer;
    touch-action: none;
  }
  .check {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .note {
    font-size: 0.82rem;
    color: var(--text-faint);
    margin: 0;
    line-height: 1.55;
  }
</style>
