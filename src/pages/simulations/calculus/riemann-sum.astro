---
import SimLayout from '../../../layouts/SimLayout.astro';
---

<SimLayout
  areaSlug="calculus"
  title="Riemann Sums"
  description="Approximate the area under a curve with n rectangles (or trapezoids) and watch the estimate converge to the true integral."
>
  <div class="sim">
    <div class="sim-stage">
      <canvas id="riemann" width="900" height="520"></canvas>
    </div>

    <div class="sim-panel">
      <div class="control">
        <label>Function</label>
        <div class="seg" id="fn">
          <button data-fn="quad" class="active">x²</button>
          <button data-fn="sine">sin x + 1.5</button>
          <button data-fn="gauss">e^(−x²)</button>
          <button data-fn="cubic">x³ − x</button>
        </div>
      </div>

      <div class="control">
        <label>Method</label>
        <div class="seg" id="method">
          <button data-method="left">Left</button>
          <button data-method="mid" class="active">Midpoint</button>
          <button data-method="right">Right</button>
          <button data-method="trap">Trapezoid</button>
        </div>
      </div>

      <div class="control">
        <label>Rectangles <b id="nval">12</b></label>
        <input type="range" id="n" min="1" max="120" value="12" />
      </div>

      <div class="readout">
        <div class="row"><span>Approximation</span><b id="approx">—</b></div>
        <div class="row"><span>Exact integral</span><b id="exact">—</b></div>
        <div class="row"><span>Error</span><b id="err">—</b></div>
      </div>

      <div class="control">
        <label>Error vs. rectangles (log–log)</label>
        <canvas id="sweep" class="mini-canvas" width="300" height="190"></canvas>
        <div class="sweep-legend">
          <span style="--c:#f87171">left</span>
          <span style="--c:#fbbf24">right</span>
          <span style="--c:#60a5fa">mid</span>
          <span style="--c:#34d399">trap</span>
        </div>
      </div>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Drag the slider up. Every method converges, but watch the <b>Error</b>
      readout: doubling the rectangles roughly <b>halves</b> the error for Left,
      yet <b>quarters</b> it for Midpoint and Trapezoid.
    </li>
    <li>
      That is exactly the log–log plot: Left and Right fall with slope
      <b>−1</b> (error ∝ 1/n), Midpoint and Trapezoid with slope <b>−2</b>
      (error ∝ 1/n²). Order of accuracy, made visible.
    </li>
    <li>
      Switch to <b>x³ − x</b>. Rectangles below the axis count as negative area,
      and over the symmetric interval the positive and negative parts cancel to
      a <b>signed integral of 0</b>.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas } from '../../../lib/sim';
  import { equationBar } from '../../../lib/equation';
  type Fn = { f: (x: number) => number; a: number; b: number };
  const FNS: Record<string, Fn> = {
    quad: { f: (x) => x * x, a: 0, b: 3 },
    sine: { f: (x) => Math.sin(x) + 1.5, a: 0, b: 2 * Math.PI },
    gauss: { f: (x) => Math.exp(-x * x), a: -2.2, b: 2.2 },
    cubic: { f: (x) => x * x * x - x, a: -1.5, b: 1.5 },
  };

  const state = { fn: 'quad', method: 'mid', n: 12 };

  const setEq = equationBar();
  const canvas = document.getElementById('riemann') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const PAD = { l: 48, r: 24, t: 24, b: 40 };

  const sweepCanvas = document.getElementById('sweep') as HTMLCanvasElement;
  const sw = setupCanvas(sweepCanvas, () => drawSweep());

  const css = (v: string) =>
    getComputedStyle(canvas).getPropertyValue(v).trim();

  function exactIntegral(fn: Fn) {
    const N = 40000;
    const h = (fn.b - fn.a) / N;
    let s = 0;
    for (let i = 0; i < N; i++) s += fn.f(fn.a + (i + 0.5) * h);
    return s * h;
  }

  function approxIntegral(fn: Fn, n: number, method: string) {
    const h = (fn.b - fn.a) / n;
    let s = 0;
    for (let i = 0; i < n; i++) {
      const xl = fn.a + i * h;
      if (method === 'left') s += fn.f(xl);
      else if (method === 'right') s += fn.f(xl + h);
      else if (method === 'mid') s += fn.f(xl + h / 2);
      else s += (fn.f(xl) + fn.f(xl + h)) / 2; // trapezoid
    }
    return s * h;
  }

  function draw() {
    const fn = FNS[state.fn];
    const accent = css('--accent') || '#7c8cff';
    const teal = css('--accent-2') || '#5eead4';
    const grid = css('--border') || '#262a32';
    const faint = css('--text-faint') || '#6b7280';

    // y-range from samples
    let yMin = 0;
    let yMax = -Infinity;
    for (let i = 0; i <= 200; i++) {
      const y = fn.f(fn.a + ((fn.b - fn.a) * i) / 200);
      yMin = Math.min(yMin, y);
      yMax = Math.max(yMax, y);
    }
    yMax *= 1.1;
    yMin = yMin < 0 ? yMin * 1.1 : 0;

    const sx = (x: number) =>
      PAD.l + ((x - fn.a) / (fn.b - fn.a)) * (W - PAD.l - PAD.r);
    const sy = (y: number) =>
      H - PAD.b - ((y - yMin) / (yMax - yMin)) * (H - PAD.t - PAD.b);

    ctx.clearRect(0, 0, W, H);

    // axes / grid
    ctx.strokeStyle = grid;
    ctx.lineWidth = 1;
    ctx.fillStyle = faint;
    ctx.font = "12px 'JetBrains Mono', monospace";
    const xticks = 6;
    for (let i = 0; i <= xticks; i++) {
      const xv = fn.a + ((fn.b - fn.a) * i) / xticks;
      const px = sx(xv);
      ctx.beginPath();
      ctx.moveTo(px, PAD.t);
      ctx.lineTo(px, H - PAD.b);
      ctx.globalAlpha = 0.5;
      ctx.stroke();
      ctx.globalAlpha = 1;
      ctx.fillText(xv.toFixed(1), px - 10, H - PAD.b + 18);
    }
    // x-axis (y=0)
    ctx.strokeStyle = css('--border-strong') || '#343a45';
    ctx.beginPath();
    ctx.moveTo(PAD.l, sy(0));
    ctx.lineTo(W - PAD.r, sy(0));
    ctx.stroke();

    // rectangles / trapezoids
    const h = (fn.b - fn.a) / state.n;
    ctx.fillStyle = 'rgba(124,140,255,0.18)';
    ctx.strokeStyle = 'rgba(124,140,255,0.55)';
    ctx.lineWidth = 1;
    for (let i = 0; i < state.n; i++) {
      const xl = fn.a + i * h;
      const xr = xl + h;
      if (state.method === 'trap') {
        ctx.beginPath();
        ctx.moveTo(sx(xl), sy(0));
        ctx.lineTo(sx(xl), sy(fn.f(xl)));
        ctx.lineTo(sx(xr), sy(fn.f(xr)));
        ctx.lineTo(sx(xr), sy(0));
        ctx.closePath();
        ctx.fill();
        ctx.stroke();
      } else {
        const xs = state.method === 'left' ? xl : state.method === 'right' ? xr : xl + h / 2;
        const hgt = fn.f(xs);
        const top = sy(hgt);
        const base = sy(0);
        ctx.fillRect(sx(xl), Math.min(top, base), sx(xr) - sx(xl), Math.abs(base - top));
        ctx.strokeRect(sx(xl), Math.min(top, base), sx(xr) - sx(xl), Math.abs(base - top));
      }
    }

    // curve
    ctx.strokeStyle = teal;
    ctx.lineWidth = 2.4;
    ctx.beginPath();
    for (let i = 0; i <= 400; i++) {
      const xv = fn.a + ((fn.b - fn.a) * i) / 400;
      const px = sx(xv);
      const py = sy(fn.f(xv));
      i === 0 ? ctx.moveTo(px, py) : ctx.lineTo(px, py);
    }
    ctx.stroke();

    // readout
    const approx = approxIntegral(fn, state.n, state.method);
    const exact = exactIntegral(fn);
    (document.getElementById('approx') as HTMLElement).textContent = approx.toFixed(5);
    (document.getElementById('exact') as HTMLElement).textContent = exact.toFixed(5);
    (document.getElementById('err') as HTMLElement).textContent = Math.abs(approx - exact).toFixed(5);
    const NAME: Record<string, string> = {
      left: 'left', right: 'right', mid: 'midpoint', trap: 'trapezoid',
    };
    setEq([
      [
        ['\\int_a^b f(x)\\,dx', teal],
        '\\approx',
        ['\\sum_i f(x_i^{*})\\,\\Delta x', accent],
      ],
      [
        [`\\int_a^b f = ${exact.toFixed(5)}`, teal],
        '\\approx',
        [`\\sum = ${approx.toFixed(5)}`, accent],
      ],
      [
        `${state.n} ${NAME[state.method]} pieces of width ${((fn.b - fn.a) / state.n).toFixed(3)}, off by ${Math.abs(approx - exact).toFixed(5)}`,
      ],
    ]);
  }

  // Convergence plot: |error| vs number of rectangles, log–log, for every
  // method at once. Left/Right fall with slope −1, Midpoint/Trapezoid with −2.
  const METHOD_COLORS: Record<string, string> = {
    left: '#f87171', right: '#fbbf24', mid: '#60a5fa', trap: '#34d399',
  };
  function drawSweep() {
    const fn = FNS[state.fn];
    const exact = exactIntegral(fn);
    const c = sw.ctx, Ws = sw.W, Hs = sw.H;
    const pad = { l: 40, r: 8, t: 10, b: 20 };
    const nMax = 128;
    const xMin = 0, xMax = Math.log10(nMax);
    const yMin = -9, yMax = 1;
    const sx = (lx: number) => pad.l + ((lx - xMin) / (xMax - xMin)) * (Ws - pad.l - pad.r);
    const sy = (ly: number) => pad.t + (1 - (ly - yMin) / (yMax - yMin)) * (Hs - pad.t - pad.b);

    const ink = css('--stage-ink') || '232,233,236';
    c.clearRect(0, 0, Ws, Hs);
    c.strokeStyle = `rgba(${ink},0.14)`;
    c.fillStyle = css('--text-faint') || '#8b93a5';
    c.lineWidth = 1;
    c.font = "10px 'JetBrains Mono', monospace";
    for (let e = -8; e <= 0; e += 2) {
      const y = sy(e);
      c.beginPath();
      c.moveTo(pad.l, y);
      c.lineTo(Ws - pad.r, y);
      c.stroke();
      c.fillText('1e' + e, 2, y + 3);
    }
    for (const n of [1, 10, 100]) c.fillText(String(n), sx(Math.log10(n)) - 4, Hs - 6);

    for (const m of ['left', 'right', 'mid', 'trap'] as const) {
      c.strokeStyle = METHOD_COLORS[m];
      c.lineWidth = 1.6;
      c.beginPath();
      let started = false;
      for (let n = 1; n <= nMax; n++) {
        const err = Math.abs(approxIntegral(fn, n, m) - exact);
        const ly = Math.max(yMin, Math.min(yMax, Math.log10(Math.max(err, 1e-12))));
        const X = sx(Math.log10(n));
        const Y = sy(ly);
        started ? c.lineTo(X, Y) : (c.moveTo(X, Y), (started = true));
      }
      c.stroke();
    }
  }

  function bindSeg(id: string, key: 'fn' | 'method') {
    const group = document.getElementById(id)!;
    group.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      if (!btn) return;
      group.querySelectorAll('button').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      state[key] = btn.dataset[key === 'fn' ? 'fn' : 'method']!;
      draw();
      if (key === 'fn') drawSweep();
    });
  }
  bindSeg('fn', 'fn');
  bindSeg('method', 'method');

  const nInput = document.getElementById('n') as HTMLInputElement;
  nInput.addEventListener('input', () => {
    state.n = +nInput.value;
    (document.getElementById('nval') as HTMLElement).textContent = String(state.n);
    draw();
  });

  draw();
  drawSweep();
</script>

<style>
  .sweep-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
    font-size: 0.74rem;
    color: var(--text-muted);
  }
  .sweep-legend span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .sweep-legend span::before {
    content: '';
    width: 12px;
    height: 2px;
    border-radius: 2px;
    background: var(--c);
  }
</style>
