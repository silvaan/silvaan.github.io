---
import SimLayout from '../../../layouts/SimLayout.astro';
---

<SimLayout
  areaSlug="calculus"
  title="Tangent Plane & Directional Derivative"
  description="Zoom close enough to any smooth surface and it looks flat: that flat approximation is the tangent plane. Its tilt in a chosen direction is the directional derivative, and the steepest tilt of all points along the gradient."
>
  <div class="sim">
    <div class="sim-stage">
      <canvas id="tp" class="tp-canvas" width="640" height="600"></canvas>
    </div>

    <div class="sim-panel">
      <div class="control">
        <label>Surface z = f(x, y)</label>
        <div class="seg" id="surf">
          <button data-s="bowl" class="active">Bowl</button>
          <button data-s="saddle">Saddle</button>
          <button data-s="hill">Hill</button>
          <button data-s="ripple">Ripple</button>
        </div>
      </div>

      <div class="control"><label>Point x <b id="pxval">0.80</b></label><input type="range" id="px" min="-2" max="2" step="0.05" value="0.8" /></div>
      <div class="control"><label>Point y <b id="pyval">-0.60</b></label><input type="range" id="py" min="-2" max="2" step="0.05" value="-0.6" /></div>
      <div class="control"><label>Direction θ <b id="thval">40°</b></label><input type="range" id="th" min="0" max="360" value="40" /></div>

      <div class="readout">
        <div class="row"><span>Directional deriv D<sub>û</sub>f</span><b id="dd">—</b></div>
        <div class="row"><span>Gradient |∇f|</span><b id="gm">—</b></div>
        <div class="row"><span>max slope at</span><b id="best">—</b></div>
      </div>

      <p style="font-size:.82rem;color:var(--text-faint);margin:0;line-height:1.5">
        Drag the background to orbit. The amber arrow is your chosen direction;
        the indigo arrow is the gradient (steepest ascent). The translucent patch
        is the tangent plane.
      </p>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Spin the <b>direction θ</b> all the way around. The directional derivative
      swings from most positive (walking straight uphill) through zero (walking
      along a level contour) to most negative (straight downhill).
    </li>
    <li>
      Its maximum comes exactly when your amber arrow lines up with the indigo
      <b>gradient</b>, and that maximum value equals <b>|∇f|</b>. The gradient
      points the steepest way up, and its length is how steep.
    </li>
    <li>
      Move the point onto a flat spot (the bottom of the Bowl, the peak of the
      Hill). There the tangent plane goes <b>horizontal</b> and every directional
      derivative is zero: a critical point.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas } from '../../../lib/sim';

  type Surf = { f: (x: number, y: number) => number; gx: (x: number, y: number) => number; gy: (x: number, y: number) => number };
  const SURF: Record<string, Surf> = {
    bowl: { f: (x, y) => 0.4 * (x * x + y * y), gx: (x) => 0.8 * x, gy: (_x, y) => 0.8 * y },
    saddle: { f: (x, y) => 0.45 * (x * x - y * y), gx: (x) => 0.9 * x, gy: (_x, y) => -0.9 * y },
    hill: {
      f: (x, y) => 1.7 * Math.exp(-(x * x + y * y) / 2),
      gx: (x, y) => 1.7 * Math.exp(-(x * x + y * y) / 2) * -x,
      gy: (x, y) => 1.7 * Math.exp(-(x * x + y * y) / 2) * -y,
    },
    ripple: {
      f: (x, y) => 0.6 * Math.sin(1.6 * x) * Math.cos(1.6 * y),
      gx: (x, y) => 0.96 * Math.cos(1.6 * x) * Math.cos(1.6 * y),
      gy: (x, y) => -0.96 * Math.sin(1.6 * x) * Math.sin(1.6 * y),
    },
  };

  const D = 2;
  const state = { surf: 'bowl', px: 0.8, py: -0.6, theta: (40 * Math.PI) / 180, yaw: 0.7, pitch: -0.6 };
  let fmin = 0, fspan = 1;

  const canvas = document.getElementById('tp') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const css = (v: string) => getComputedStyle(canvas).getPropertyValue(v).trim();
  const isLight = () => css('--stage-light') === '1';
  const CX = W / 2, CY = H / 2, CAM = 3.2, FOCAL = 2.7, SCALE = 250;
  const cur = () => SURF[state.surf];

  function computeRange() {
    fmin = Infinity;
    let fmax = -Infinity;
    for (let i = 0; i <= 40; i++)
      for (let j = 0; j <= 40; j++) {
        const f = cur().f(-D + (2 * D * i) / 40, -D + (2 * D * j) / 40);
        fmin = Math.min(fmin, f);
        fmax = Math.max(fmax, f);
      }
    fspan = fmax - fmin || 1;
  }
  function project(x: number, y: number, z: number) {
    const cy = Math.cos(state.yaw), sy = Math.sin(state.yaw);
    const cp = Math.cos(state.pitch), sp = Math.sin(state.pitch);
    const x1 = x * cy + z * sy;
    const z1 = -x * sy + z * cy;
    const y2 = y * cp - z1 * sp;
    const z2 = y * sp + z1 * cp;
    const zc = z2 + CAM;
    const s = FOCAL / Math.max(0.05, zc);
    return { sx: CX + x1 * s * SCALE, sy: CY - y2 * s * SCALE, zc };
  }
  const worldOf = (x: number, y: number, zval?: number) => {
    const f = zval === undefined ? cur().f(x, y) : zval;
    const wy = ((f - fmin) / fspan) * 1.3 - 0.65;
    return project(x / D, wy, y / D);
  };
  function turbo(t: number) {
    t = Math.max(0, Math.min(1, t));
    const stops = [[40, 60, 150], [30, 150, 200], [50, 200, 120], [240, 200, 70], [235, 80, 70]];
    const seg = t * 4;
    const i = Math.min(3, Math.floor(seg));
    const f = seg - i;
    const a = stops[i], b = stops[i + 1];
    let r = (a[0] + (b[0] - a[0]) * f) | 0, g = (a[1] + (b[1] - a[1]) * f) | 0, bl = (a[2] + (b[2] - a[2]) * f) | 0;
    if (isLight()) { r = (r * 0.6) | 0; g = (g * 0.6) | 0; bl = (bl * 0.6) | 0; }
    return `rgb(${r},${g},${bl})`;
  }

  function arrow(x0: number, y0: number, x1: number, y1: number, color: string, w: number) {
    const a = worldOf(x0, y0), b = worldOf(x1, y1);
    if (a.zc <= 0.1 || b.zc <= 0.1) return;
    ctx.strokeStyle = color; ctx.fillStyle = color; ctx.lineWidth = w;
    ctx.beginPath(); ctx.moveTo(a.sx, a.sy); ctx.lineTo(b.sx, b.sy); ctx.stroke();
    const ang = Math.atan2(b.sy - a.sy, b.sx - a.sx);
    ctx.beginPath();
    ctx.moveTo(b.sx, b.sy);
    ctx.lineTo(b.sx - 10 * Math.cos(ang - 0.4), b.sy - 10 * Math.sin(ang - 0.4));
    ctx.lineTo(b.sx - 10 * Math.cos(ang + 0.4), b.sy - 10 * Math.sin(ang + 0.4));
    ctx.closePath(); ctx.fill();
  }

  function draw() {
    const ink = css('--stage-ink') || '232,233,236';
    ctx.clearRect(0, 0, W, H);
    const M = 30;

    // surface wireframe
    for (let i = 0; i <= M; i++)
      for (const axis of [0, 1]) {
        ctx.beginPath();
        let started = false;
        for (let j = 0; j <= M; j++) {
          const a = -D + (2 * D * i) / M, b = -D + (2 * D * j) / M;
          const x = axis === 0 ? b : a, y = axis === 0 ? a : b;
          const p = worldOf(x, y);
          if (p.zc <= 0.1) { started = false; continue; }
          started ? ctx.lineTo(p.sx, p.sy) : ((ctx.moveTo(p.sx, p.sy)), (started = true));
        }
        const a = -D + (2 * D * i) / M;
        const tH = (cur().f(axis === 0 ? 0 : a, axis === 0 ? a : 0) - fmin) / fspan;
        ctx.strokeStyle = turbo(tH);
        ctx.globalAlpha = isLight() ? 0.6 : 0.4;
        ctx.lineWidth = 1;
        ctx.stroke();
        ctx.globalAlpha = 1;
      }

    const { f, gx, gy } = cur();
    const px = state.px, py = state.py;
    const fp = f(px, py), gX = gx(px, py), gY = gy(px, py);
    const gmag = Math.hypot(gX, gY);

    // tangent plane patch
    const hh = 0.7;
    const corners = [[-hh, -hh], [hh, -hh], [hh, hh], [-hh, hh]].map(([dxp, dyp]) => {
      const X = px + dxp, Y = py + dyp;
      const zPlane = fp + gX * dxp + gY * dyp;
      return worldOf(X, Y, zPlane);
    });
    if (corners.every((c) => c.zc > 0.1)) {
      ctx.beginPath();
      ctx.moveTo(corners[0].sx, corners[0].sy);
      for (let i = 1; i < 4; i++) ctx.lineTo(corners[i].sx, corners[i].sy);
      ctx.closePath();
      ctx.fillStyle = `rgba(${ink},0.14)`;
      ctx.fill();
      ctx.strokeStyle = `rgba(${ink},0.5)`;
      ctx.lineWidth = 1.5;
      ctx.stroke();
    }

    // arrows: direction (amber) and gradient (indigo), drawn in the tangent plane
    const L = 0.9;
    const ux = Math.cos(state.theta), uy = Math.sin(state.theta);
    const dd = gX * ux + gY * uy;
    // direction arrow tip lifted onto the tangent plane
    {
      const a = worldOf(px, py, fp);
      const bz = fp + gX * (ux * L) + gY * (uy * L);
      const b = worldOf(px + ux * L, py + uy * L, bz);
      if (a.zc > 0.1 && b.zc > 0.1) {
        ctx.strokeStyle = '#f59e0b'; ctx.fillStyle = '#f59e0b'; ctx.lineWidth = 3;
        ctx.beginPath(); ctx.moveTo(a.sx, a.sy); ctx.lineTo(b.sx, b.sy); ctx.stroke();
        const ang = Math.atan2(b.sy - a.sy, b.sx - a.sx);
        ctx.beginPath();
        ctx.moveTo(b.sx, b.sy);
        ctx.lineTo(b.sx - 11 * Math.cos(ang - 0.4), b.sy - 11 * Math.sin(ang - 0.4));
        ctx.lineTo(b.sx - 11 * Math.cos(ang + 0.4), b.sy - 11 * Math.sin(ang + 0.4));
        ctx.closePath(); ctx.fill();
      }
    }
    // gradient direction (horizontal steepest ascent) lifted onto plane
    if (gmag > 1e-4) {
      const gxn = gX / gmag, gyn = gY / gmag;
      const a = worldOf(px, py, fp);
      const bz = fp + gX * (gxn * L) + gY * (gyn * L);
      const b = worldOf(px + gxn * L, py + gyn * L, bz);
      if (a.zc > 0.1 && b.zc > 0.1) {
        ctx.strokeStyle = css('--accent') || '#7c8cff'; ctx.fillStyle = css('--accent') || '#7c8cff'; ctx.lineWidth = 3;
        ctx.beginPath(); ctx.moveTo(a.sx, a.sy); ctx.lineTo(b.sx, b.sy); ctx.stroke();
        const ang = Math.atan2(b.sy - a.sy, b.sx - a.sx);
        ctx.beginPath();
        ctx.moveTo(b.sx, b.sy);
        ctx.lineTo(b.sx - 11 * Math.cos(ang - 0.4), b.sy - 11 * Math.sin(ang - 0.4));
        ctx.lineTo(b.sx - 11 * Math.cos(ang + 0.4), b.sy - 11 * Math.sin(ang + 0.4));
        ctx.closePath(); ctx.fill();
      }
    }

    // point
    const pp = worldOf(px, py, fp);
    if (pp.zc > 0.1) {
      ctx.fillStyle = `rgba(${ink},1)`;
      ctx.strokeStyle = `rgba(${css('--stage-ink-inv') || '13,14,18'},0.7)`;
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(pp.sx, pp.sy, 6, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
    }

    (document.getElementById('dd') as HTMLElement).textContent = dd.toFixed(3);
    (document.getElementById('gm') as HTMLElement).textContent = gmag.toFixed(3);
    (document.getElementById('best') as HTMLElement).textContent = gmag < 1e-3 ? 'flat (any)' : Math.round((Math.atan2(gY, gX) * 180) / Math.PI + 360) % 360 + '°';
  }

  // orbit
  let dragging = false, lx = 0, ly = 0;
  canvas.addEventListener('pointerdown', (e) => { dragging = true; lx = e.clientX; ly = e.clientY; canvas.setPointerCapture(e.pointerId); });
  canvas.addEventListener('pointermove', (e) => {
    if (!dragging) return;
    state.yaw += (e.clientX - lx) * 0.01;
    state.pitch = Math.max(-1.45, Math.min(-0.05, state.pitch + (e.clientY - ly) * 0.01));
    lx = e.clientX; ly = e.clientY;
    draw();
  });
  const stop = () => (dragging = false);
  canvas.addEventListener('pointerup', stop);
  canvas.addEventListener('pointercancel', stop);

  document.getElementById('surf')!.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn) return;
    document.querySelectorAll('#surf button').forEach((b) => b.classList.remove('active'));
    btn.classList.add('active');
    state.surf = btn.dataset.s!;
    computeRange();
    draw();
  });
  const bind = (id: string, key: 'px' | 'py', deg = false) => {
    const el = document.getElementById(id) as HTMLInputElement;
    el.addEventListener('input', () => {
      state[key] = +el.value;
      (document.getElementById(id + 'val') as HTMLElement).textContent = (+el.value).toFixed(2);
      draw();
    });
    void deg;
  };
  bind('px', 'px');
  bind('py', 'py');
  const thEl = document.getElementById('th') as HTMLInputElement;
  thEl.addEventListener('input', () => {
    state.theta = (+thEl.value * Math.PI) / 180;
    (document.getElementById('thval') as HTMLElement).textContent = thEl.value + '°';
    draw();
  });

  computeRange();
  draw();
</script>

<style>
  .tp-canvas {
    cursor: grab;
    touch-action: none;
  }
  .tp-canvas:active {
    cursor: grabbing;
  }
</style>
