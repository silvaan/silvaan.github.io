---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Checks from '../../../components/sim/Checks.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="calculus"
  title="Laplace Transform"
  description="The Laplace transform sends a signal f(t) to a function F(s) of a complex variable. Plot |F(s)| as a landscape over the complex plane and the algebra turns geometric: poles are spikes, the region of convergence is a half-plane, and the Fourier transform is the slice above the imaginary axis."
  shortcuts={['fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas id="lp" class="lp-canvas" width="760" height="580" role="img" aria-label="The magnitude of F(s) drawn as a lit solid landscape over the complex plane, with the poles marked on the flat-topped peaks they raise, the region of convergence tinted, and the slice above the imaginary axis drawn as an amber curve on the surface."></canvas>
      </div>
      <Caption
        legend={[{ label: 'the poles', color: '#ef4444' }, { label: 'the slice at σ = 0, the Fourier transform', color: '#f59e0b' }, { label: 'region of convergence', color: '#38bdf8' }]}
        hint="Drag to orbit · scroll to zoom · height is |F(s)|, rounded off smoothly near the poles so they do not run off to infinity"
      />
      <Result label="Poles" />
    </div>
    <div class="sim-panel">
      <Seg id="sig" label="Signal f(t), t ≥ 0" attr="s" options={[{ value: 'exp', label: 'e<sup>−at</sup>' }, { value: 'sin', label: 'e<sup>−at</sup>sin ωt' }, { value: 'cos', label: 'e<sup>−at</sup>cos ωt' }, { value: 'ramp', label: 't·e<sup>−at</sup>' }]} />
      <div class="control">
        <span class="section-label">The signal in time</span>
        <canvas id="ft" class="mini-canvas" width="300" height="110" role="img" aria-label="The signal f(t) against time"></canvas>
      </div>
      <Slider id="a" label="Decay a" min={-0.8} max={2.5} step={0.05} value={0.6} display="0.60" />
      <div id="wctl">
        <Slider id="w" label="Frequency ω" min={0.2} max={5} step={0.1} value={2.5} display="2.50" />
      </div>
      <Checks items={[{ id: 'roc', label: 'Shade the region of convergence', checked: true }, { id: 'slice', label: 'Slice above the imaginary axis', checked: true }]} />
      <Readout rows={[{ id: 'fs', label: 'F(s)' }, { id: 'rocv', label: 'region of convergence' }, { id: 'fourier', label: 'Fourier transform' }]} />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Lower the <b>decay a</b> to zero: the pole slides onto the imaginary axis
      and the amber slice spikes right there. A signal that never dies out has no
      finite Fourier transform. <Try id="edge" />
    </li>
    <li>
      Push <b>a</b> negative: the signal grows, the <b>region of convergence</b>
      retreats to the right of the axis, and the Fourier transform no longer
      exists. The Laplace transform still does. <Try id="grow" />
    </li>
    <li>
      On <b>e<sup>−at</sup>sin ωt</b> the poles are a pair at −a ± jω, and the
      slice has humps at ±ω. With a small a they become a sharp
      <b>resonance</b>. <Try id="resonance" />
    </li>
    <li>
      Compare <b>e<sup>−at</sup></b> with <b>t·e<sup>−at</sup></b>: same pole,
      but the double pole is wider near it and falls off faster away from it.
      A repeated pole is a factor of t in time. <Try id="double" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { el, segmented, slider, check, result, readout, tries } from '../../../lib/panel';
  import { Camera3D, orbitControls, V } from '../../../lib/scene3d';
  import type { Vec } from '../../../lib/scene3d';

  // --- complex helpers -----------------------------------------------------
  type C = { re: number; im: number };
  const cmul = (p: C, q: C): C => ({ re: p.re * q.re - p.im * q.im, im: p.re * q.im + p.im * q.re });
  const cdiv = (p: C, q: C): C => {
    const d = q.re * q.re + q.im * q.im || 1e-12;
    return { re: (p.re * q.re + p.im * q.im) / d, im: (p.im * q.re - p.re * q.im) / d };
  };
  const cabs = (p: C) => Math.hypot(p.re, p.im);
  const ONE: C = { re: 1, im: 0 };

  const setEq = equation();
  const setResult = result();
  const setRows = readout();
  const state = { sig: 'exp', a: 0.6, w: 2.5, roc: true, slice: true };

  // F(s) for each signal, plus the time-domain formula and a pretty label.
  function transform(s: C): C {
    const { a, w } = state;
    const sa: C = { re: s.re + a, im: s.im };
    if (state.sig === 'exp') return cdiv(ONE, sa);
    if (state.sig === 'ramp') return cdiv(ONE, cmul(sa, sa));
    const den: C = { re: cmul(sa, sa).re + w * w, im: cmul(sa, sa).im };
    return state.sig === 'sin' ? cdiv({ re: w, im: 0 }, den) : cdiv(sa, den);
  }
  function signal(t: number) {
    const { a, w } = state;
    const e = Math.exp(-a * t);
    if (state.sig === 'exp') return e;
    if (state.sig === 'ramp') return t * e;
    return state.sig === 'sin' ? e * Math.sin(w * t) : e * Math.cos(w * t);
  }
  /** "s + 0.60" or "s − 0.50", never "s + −0.50". */
  const sPlus = (sp = ' ', minus = '−') => `s${sp}${state.a < 0 ? minus : '+'}${sp}${Math.abs(state.a).toFixed(2)}`;
  const formula = () => {
    const sa = sPlus(), w = state.w.toFixed(1);
    if (state.sig === 'exp') return `1 / (${sa})`;
    if (state.sig === 'ramp') return `1 / (${sa})²`;
    const d = `(${sa})² + ${w}²`;
    return state.sig === 'sin' ? `${w} / [${d}]` : `(${sa}) / [${d}]`;
  };
  // Pole locations, and whether they are repeated.
  const poles = (): { re: number; im: number }[] => {
    const p = -state.a;
    if (state.sig === 'exp' || state.sig === 'ramp') return [{ re: p, im: 0 }];
    return [{ re: p, im: state.w }, { re: p, im: -state.w }];
  };

  // --- the landscape -------------------------------------------------------
  const SIG = 3, OM = 5.5, CAP = 3; // s-plane extent, and where the height starts to round off
  const XS = 1.1, ZS = 1.35, HS = 1.15, BASE = -0.3; // world size of the plane and the height
  /** |F| rounded off smoothly: linear for small values, levelling out at 1 near a pole. */
  const height = (sigma: number, omega: number) => {
    const t = cabs(transform({ re: sigma, im: omega })) / CAP;
    if (!(t < 1e3)) return 1; // at or next to a pole
    return t / Math.pow(1 + t * t * t * t, 0.25);
  };
  /** (σ, ω, rounded height) to world: σ right, ω away from the viewer, height up. */
  const P = (sigma: number, omega: number, h: number): Vec => ({ x: (sigma / SIG) * XS, y: BASE + h * HS, z: (omega / OM) * ZS });
  const onSurf = (sigma: number, omega: number, lift = 0.012) => P(sigma, omega, height(sigma, omega) + lift / HS);

  // --- canvas, camera, theme -----------------------------------------------
  const canvas = el('lp') as HTMLCanvasElement;
  const W = canvas.width, H = canvas.height;
  const ctx = canvas.getContext('2d')!;
  const applyDpr = () => {
    const dpr = Math.min(3, window.devicePixelRatio || 1);
    canvas.width = Math.round(W * dpr);
    canvas.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  };
  applyDpr();
  const cam = new Camera3D(W, H, { dist: 5.6, yaw: 0.62, pitch: -0.58, zoom: 1.22 });
  const css = (v: string) => getComputedStyle(canvas).getPropertyValue(v).trim();
  let ink = '232,233,236', light = false;
  const readTheme = () => {
    ink = css('--stage-ink') || '232,233,236';
    light = css('--stage-light') === '1';
  };
  readTheme();
  const inkA = (a: number) => `rgba(${ink},${a})`;
  const fontK = () => Math.max(1, Math.min(1.7, (W / (canvas.clientWidth || W)) * 0.72));
  const ROC = '#38bdf8', SLICE = '#f59e0b', POLE = '#ef4444';

  // --- WebGL2: the lit landscape and its skirt ------------------------------
  const VS = `#version 300 es
  precision highp float;
  in vec3 aP;
  in vec3 aN;
  in vec4 aC;
  in float aS;
  uniform vec4 uCam;   // yaw, pitch, dist, k
  uniform vec2 uHalf;  // half the view in logical pixels
  out vec3 vW;
  out vec3 vN;
  out vec4 vC;
  out float vS;
  vec4 project(vec3 p) {
    float cy = cos(uCam.x), sy = sin(uCam.x), cp = cos(uCam.y), sp = sin(uCam.y);
    float x1 = p.x * cy + p.z * sy, z1 = -p.x * sy + p.z * cy;
    float y2 = p.y * cp - z1 * sp, z2 = p.y * sp + z1 * cp;
    float zc = z2 + uCam.z;
    return vec4(x1 * uCam.w / uHalf.x, y2 * uCam.w / uHalf.y, ((zc - 0.3) / 30.0 * 2.0 - 1.0) * zc, zc);
  }
  void main() { vW = aP; vN = aN; vC = aC; vS = aS; gl_Position = project(aP); }`;

  const FS = `#version 300 es
  precision highp float;
  in vec3 vW;
  in vec3 vN;
  in vec4 vC;
  in float vS;
  uniform vec3 uL, uEye, uInk;
  uniform float uLight, uStep, uCont;
  out vec4 o;
  void main() {
    vec3 col = vC.rgb;
    if (uCont > 0.0) {
      float s = vS / uStep;
      float d = abs(fract(s - 0.5) - 0.5) / max(fwidth(s), 1e-5);
      col = mix(col, uInk, (1.0 - smoothstep(0.35, 1.35, d)) * uCont);
    }
    vec3 n = normalize(vN);
    vec3 v = normalize(uEye - vW);
    if (dot(n, v) < 0.0) n = -n;
    float diff = max(dot(n, uL), 0.0);
    float spec = pow(max(dot(n, normalize(uL + v)), 0.0), 60.0);
    float fres = pow(1.0 - max(dot(n, v), 0.0), 3.0);
    if (uLight > 0.5) col = col * (0.6 + 0.45 * diff) + vec3(spec * 0.2);
    else col = col * (0.36 + 0.66 * diff) + vec3(0.9, 0.95, 1.0) * spec * 0.22 + vec3(0.45, 0.5, 0.95) * fres * 0.14;
    o = vec4(col * vC.a, vC.a);
  }`;

  type Mesh = { vao: WebGLVertexArrayObject; vbo: WebGLBuffer; ibo: WebGLBuffer; n: number };
  type Gl = {
    gl: WebGL2RenderingContext;
    glc: HTMLCanvasElement;
    prog: WebGLProgram;
    U: Record<string, WebGLUniformLocation | null>;
    surf: Mesh;
    skirt: Mesh;
  };

  function compile(gl: WebGL2RenderingContext, vs: string, fs: string) {
    const sh = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s) ?? 'shader');
      return s;
    };
    const p = gl.createProgram()!;
    gl.attachShader(p, sh(gl.VERTEX_SHADER, vs));
    gl.attachShader(p, sh(gl.FRAGMENT_SHADER, fs));
    gl.linkProgram(p);
    if (!gl.getProgramParameter(p, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(p) ?? 'link');
    return p;
  }

  const STRIDE = 11; // position 3, normal 3, colour 4, contour scalar 1
  function makeMesh(gl: WebGL2RenderingContext, prog: WebGLProgram): Mesh {
    const vao = gl.createVertexArray()!;
    gl.bindVertexArray(vao);
    const vbo = gl.createBuffer()!;
    gl.bindBuffer(gl.ARRAY_BUFFER, vbo);
    const at = (name: string, size: number, off: number) => {
      const l = gl.getAttribLocation(prog, name);
      if (l < 0) return;
      gl.enableVertexAttribArray(l);
      gl.vertexAttribPointer(l, size, gl.FLOAT, false, STRIDE * 4, off * 4);
    };
    at('aP', 3, 0);
    at('aN', 3, 3);
    at('aC', 4, 6);
    at('aS', 1, 10);
    const ibo = gl.createBuffer()!;
    gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, ibo);
    gl.bindVertexArray(null);
    return { vao, vbo, ibo, n: 0 };
  }
  function upload(g: Gl, m: Mesh, v: Float32Array, idx: Uint32Array) {
    const gl = g.gl;
    gl.bindVertexArray(m.vao);
    gl.bindBuffer(gl.ARRAY_BUFFER, m.vbo);
    gl.bufferData(gl.ARRAY_BUFFER, v, gl.DYNAMIC_DRAW);
    gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, m.ibo);
    gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, idx, gl.DYNAMIC_DRAW);
    gl.bindVertexArray(null);
    m.n = idx.length;
  }

  function makeGl(): Gl | null {
    const glc = document.createElement('canvas');
    const gl = glc.getContext('webgl2', { premultipliedAlpha: true, alpha: true, antialias: true });
    if (!gl) return null;
    try {
      const prog = compile(gl, VS, FS);
      const U: Record<string, WebGLUniformLocation | null> = {};
      for (const n of ['uCam', 'uHalf', 'uL', 'uEye', 'uInk', 'uLight', 'uStep', 'uCont']) U[n] = gl.getUniformLocation(prog, n);
      return { gl, glc, prog, U, surf: makeMesh(gl, prog), skirt: makeMesh(gl, prog) };
    } catch (err) {
      console.warn('laplace-transform: WebGL2 setup failed', err);
      return null;
    }
  }
  const G = makeGl();

  /** Low ground slate, rising through violet to rose where |F| is large. */
  function heightColour(t: number): number[] {
    const stops = light
      ? [[0.8, 0.83, 0.92], [0.6, 0.52, 0.9], [0.9, 0.3, 0.45]]
      : [[0.09, 0.11, 0.21], [0.36, 0.25, 0.68], [0.95, 0.34, 0.46]];
    t = Math.max(0, Math.min(1, t)) * 2;
    const i = Math.min(1, Math.floor(t)), u = t - i;
    const a = stops[i], b = stops[i + 1];
    return [a[0] + (b[0] - a[0]) * u, a[1] + (b[1] - a[1]) * u, a[2] + (b[2] - a[2]) * u];
  }
  const SKY = [0.22, 0.74, 0.97];
  /** The colour of the ground at σ: tinted sky blue inside the region of convergence. */
  function groundColour(sigma: number, h: number) {
    const c = heightColour(Math.pow(h, 0.8));
    if (state.roc && sigma > -state.a) {
      const k = (light ? 0.34 : 0.3) * (1 - h * 0.7);
      return c.map((v, i) => v + (SKY[i] - v) * k);
    }
    return c;
  }

  const NX = 150, NZ = 220;
  const hgrid = new Float32Array((NX + 1) * (NZ + 1));
  function buildMeshes(g: Gl) {
    const sx = (i: number) => -SIG + (2 * SIG * i) / NX;
    const sz = (j: number) => -OM + (2 * OM * j) / NZ;
    for (let j = 0; j <= NZ; j++) for (let i = 0; i <= NX; i++) hgrid[j * (NX + 1) + i] = height(sx(i), sz(j));
    const hy = (i: number, j: number) => BASE + hgrid[Math.max(0, Math.min(NZ, j)) * (NX + 1) + Math.max(0, Math.min(NX, i))] * HS;
    const dx = (2 * XS) / NX, dz = (2 * ZS) / NZ;
    const v = new Float32Array((NX + 1) * (NZ + 1) * STRIDE);
    let q = 0;
    for (let j = 0; j <= NZ; j++)
      for (let i = 0; i <= NX; i++) {
        const h = hgrid[j * (NX + 1) + i];
        const gx = (hy(i + 1, j) - hy(i - 1, j)) / ((Math.min(NX, i + 1) - Math.max(0, i - 1)) * dx);
        const gz = (hy(i, j + 1) - hy(i, j - 1)) / ((Math.min(NZ, j + 1) - Math.max(0, j - 1)) * dz);
        const n = V.unit({ x: -gx, y: 1, z: -gz });
        const c = groundColour(sx(i), h);
        const p = P(sx(i), sz(j), h);
        v.set([p.x, p.y, p.z, n.x, n.y, n.z, c[0], c[1], c[2], 1, h], q);
        q += STRIDE;
      }
    const idx = new Uint32Array(NX * NZ * 6);
    let k = 0;
    for (let j = 0; j < NZ; j++)
      for (let i = 0; i < NX; i++) {
        const a = j * (NX + 1) + i, b = a + 1, c = a + NX + 1, d = c + 1;
        idx.set([a, b, c, b, d, c], k);
        k += 6;
      }
    upload(g, g.surf, v, idx);

    // the skirt: the four sides of the block, down to the base
    const sv: number[] = [], si: number[] = [];
    const side = (pts: { s: number; o: number; h: number }[], n: Vec) => {
      const base = sv.length / STRIDE;
      const col = light ? [0.72, 0.75, 0.84] : [0.14, 0.16, 0.24];
      for (const p of pts) {
        const top = P(p.s, p.o, p.h), bot = P(p.s, p.o, 0);
        sv.push(top.x, top.y, top.z, n.x, n.y, n.z, ...col, 1, 0);
        sv.push(bot.x, BASE - 0.06, bot.z, n.x, n.y, n.z, ...col, 1, 0);
      }
      for (let m = 0; m < pts.length - 1; m++) {
        const a = base + 2 * m;
        si.push(a, a + 2, a + 1, a + 1, a + 2, a + 3);
      }
    };
    const row = (j: number) => Array.from({ length: NX + 1 }, (_, i) => ({ s: sx(i), o: sz(j), h: hgrid[j * (NX + 1) + i] }));
    const col = (i: number) => Array.from({ length: NZ + 1 }, (_, j) => ({ s: sx(i), o: sz(j), h: hgrid[j * (NX + 1) + i] }));
    side(row(0), { x: 0, y: 0, z: -1 });
    side(row(NZ), { x: 0, y: 0, z: 1 });
    side(col(0), { x: -1, y: 0, z: 0 });
    side(col(NX), { x: 1, y: 0, z: 0 });
    upload(g, g.skirt, new Float32Array(sv), new Uint32Array(si));
  }

  let meshDirty = true;
  function renderGl(g: Gl) {
    const gl = g.gl, U = g.U;
    if (meshDirty) { buildMeshes(g); meshDirty = false; }
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    const w = Math.round(W * dpr), hh = Math.round(H * dpr);
    if (g.glc.width !== w || g.glc.height !== hh) { g.glc.width = w; g.glc.height = hh; }
    gl.viewport(0, 0, w, hh);
    gl.clearColor(0, 0, 0, 0);
    gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
    gl.enable(gl.DEPTH_TEST);
    gl.enable(gl.BLEND);
    gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);
    gl.useProgram(g.prog);
    // light from over the viewer's left shoulder, so the ground is always lit
    const L = V.unit(V.add(V.add(V.mul(cam.right(), -0.45), V.mul(cam.up(), 0.75)), V.mul(cam.forward(), -0.55)));
    const Lw = V.unit({ x: L.x, y: Math.abs(L.y) + 0.6, z: L.z });
    const eye = cam.eye();
    gl.uniform4f(U.uCam, cam.yaw, cam.pitch, cam.dist, cam.k);
    gl.uniform2f(U.uHalf, W / 2, H / 2);
    gl.uniform3f(U.uL, Lw.x, Lw.y, Lw.z);
    gl.uniform3f(U.uEye, eye.x, eye.y, eye.z);
    gl.uniform1f(U.uLight, light ? 1 : 0);
    const inkC = light ? [0.1, 0.12, 0.2] : [0.92, 0.94, 1.0];
    gl.uniform3f(U.uInk, inkC[0], inkC[1], inkC[2]);
    gl.uniform1f(U.uStep, 0.1);
    gl.uniform1f(U.uCont, light ? 0.22 : 0.18);
    gl.bindVertexArray(g.surf.vao);
    gl.drawElements(gl.TRIANGLES, g.surf.n, gl.UNSIGNED_INT, 0);
    gl.uniform1f(U.uCont, 0);
    gl.bindVertexArray(g.skirt.vao);
    gl.drawElements(gl.TRIANGLES, g.skirt.n, gl.UNSIGNED_INT, 0);
    gl.bindVertexArray(null);
    ctx.drawImage(g.glc, 0, 0, W, H);
  }

  // --- overlay: curves on the landscape, depth-tested by marching the view ray --
  /** Is world point p hidden behind the landscape, seen from the camera? */
  function hidden(p: Vec) {
    const e = cam.eye();
    const d = V.sub(e, p);
    const len = V.norm(d);
    const lo = BASE - 0.07, hi = BASE + HS + 0.01;
    let t0 = 0.03 / len, t1 = 1;
    if (Math.abs(d.y) > 1e-6) {
      const ta = (lo - p.y) / d.y, tb = (hi - p.y) / d.y;
      t1 = Math.min(1, Math.max(ta, tb));
      t0 = Math.max(t0, Math.min(ta, tb));
    }
    if (t1 <= t0) return false;
    const N = 56;
    for (let i = 0; i <= N; i++) {
      const t = t0 + ((t1 - t0) * i) / N;
      const x = p.x + d.x * t, y = p.y + d.y * t, z = p.z + d.z * t;
      if (Math.abs(x) > XS || Math.abs(z) > ZS) continue;
      if (BASE + height((x / XS) * SIG, (z / ZS) * OM) * HS > y + 0.012) return true;
    }
    return false;
  }

  /** A polyline in world space: solid where seen, faint and dashed where the landscape hides it. */
  function curve(pts: Vec[], col: string, width: number, o: { halo?: boolean; dash?: number[]; hiddenAlpha?: number } = {}) {
    if (pts.length < 2) return;
    const pr = pts.map((p) => ({ ...cam.project(p), h: hidden(p) }));
    const runs: { h: boolean; pts: { sx: number; sy: number }[] }[] = [];
    for (const p of pr) {
      const last = runs[runs.length - 1];
      if (!last || last.h !== p.h) runs.push({ h: p.h, pts: last ? [last.pts[last.pts.length - 1], p] : [p] });
      else last.pts.push(p);
    }
    ctx.lineJoin = 'round';
    ctx.lineCap = 'round';
    for (const run of runs) {
      if (run.pts.length < 2) continue;
      const path = () => {
        ctx.beginPath();
        run.pts.forEach((p, i) => (i ? ctx.lineTo(p.sx, p.sy) : ctx.moveTo(p.sx, p.sy)));
      };
      if (run.h) {
        const ha = o.hiddenAlpha ?? 0.3;
        if (ha <= 0) continue;
        ctx.globalAlpha = ha;
        ctx.setLineDash([4, 5]);
        ctx.strokeStyle = col;
        ctx.lineWidth = Math.max(1, width * 0.6);
        path();
        ctx.stroke();
        ctx.globalAlpha = 1;
        ctx.setLineDash([]);
        continue;
      }
      if (o.halo) {
        ctx.strokeStyle = light ? 'rgba(255,255,255,0.85)' : 'rgba(8,9,14,0.7)';
        ctx.lineWidth = width + 3.5;
        path();
        ctx.stroke();
      }
      ctx.setLineDash(o.dash ?? []);
      ctx.strokeStyle = col;
      ctx.lineWidth = width;
      path();
      ctx.stroke();
      ctx.setLineDash([]);
    }
  }

  function label(text: string, p: Vec, col: string, align: CanvasTextAlign = 'center', size = 14, dy = 0, dx = 0) {
    const s = cam.project(p);
    if (s.zc <= 0.1) return;
    ctx.font = `600 ${Math.round(size * fontK())}px 'JetBrains Mono', ui-monospace, monospace`;
    ctx.textAlign = align;
    ctx.textBaseline = 'middle';
    ctx.lineWidth = 4;
    ctx.lineJoin = 'round';
    ctx.strokeStyle = light ? 'rgba(255,255,255,0.9)' : 'rgba(8,9,14,0.75)';
    // keep the whole label inside the canvas
    const tw = ctx.measureText(text).width;
    const left = align === 'left' ? 0 : align === 'right' ? tw : tw / 2;
    const x = Math.max(6 + left, Math.min(W - 6 - (tw - left), s.sx + dx));
    ctx.strokeText(text, x, s.sy + dy);
    ctx.fillStyle = col;
    ctx.fillText(text, x, s.sy + dy);
  }

  const lineSigma = (o: number, n = 160) => Array.from({ length: n + 1 }, (_, i) => onSurf(-SIG + (2 * SIG * i) / n, o));
  const lineOmega = (s: number, n = 320) => Array.from({ length: n + 1 }, (_, i) => onSurf(s, -OM + (2 * OM * i) / n));

  function overlay() {
    // the axes, lying on the ground
    curve(lineSigma(0), inkA(light ? 0.55 : 0.5), 1.3, { hiddenAlpha: 0.25 });
    if (!state.slice) curve(lineOmega(0), inkA(light ? 0.55 : 0.5), 1.3, { hiddenAlpha: 0.25 });
    label('σ', P(SIG * 1.1, 0, height(SIG, 0)), inkA(0.75), 'center', 16);
    label('jω', P(0, OM * 1.1, 0), inkA(0.75), 'center', 16);

    // the edge of the region of convergence
    const edge = -state.a;
    if (state.roc && Math.abs(edge) < SIG) {
      curve(lineOmega(edge, 240), light ? '#0ea5e9' : ROC, 2, { dash: [7, 5], hiddenAlpha: 0.25 });
    }

    // the Fourier transform: the slice above the imaginary axis
    if (state.slice) {
      curve(lineOmega(0, 420), SLICE, 3.6, { halo: true, hiddenAlpha: 0.4 });
      label('|F(jω)|', P(0, -OM * 1.1, 0), light ? '#d97706' : SLICE, 'left', 13, 0, 6);
    }

    // the poles, on the flat tops they raise
    const rep = state.sig === 'ramp';
    for (const p of poles()) {
      if (Math.abs(p.re) > SIG || Math.abs(p.im) > OM) continue;
      const top = P(p.re, p.im, 1 + 0.01);
      const s = cam.project(top);
      ctx.globalAlpha = hidden(top) ? 0.45 : 1;
      ctx.strokeStyle = light ? '#fff' : 'rgba(8,9,14,0.8)';
      ctx.lineWidth = 5;
      ctx.beginPath();
      ctx.arc(s.sx, s.sy, 7, 0, Math.PI * 2);
      ctx.stroke();
      ctx.strokeStyle = POLE;
      ctx.lineWidth = 2.5;
      ctx.beginPath();
      ctx.arc(s.sx, s.sy, 7, 0, Math.PI * 2);
      ctx.moveTo(s.sx - 4, s.sy - 4);
      ctx.lineTo(s.sx + 4, s.sy + 4);
      ctx.moveTo(s.sx + 4, s.sy - 4);
      ctx.lineTo(s.sx - 4, s.sy + 4);
      ctx.stroke();
      ctx.globalAlpha = 1;
      label(rep ? 'double pole' : 'pole', top, POLE, 'center', 13, -20);
    }

    // a quiet key in the corner
    const fk = fontK();
    ctx.font = `500 ${Math.round(13 * fk)}px 'JetBrains Mono', ui-monospace, monospace`;
    ctx.textAlign = 'left';
    ctx.textBaseline = 'alphabetic';
    ctx.fillStyle = inkA(0.6);
    ctx.fillText(`height |F(s)| over σ ∈ [−${SIG}, ${SIG}], ω ∈ [−${OM}, ${OM}]`, 16, 18 + 10 * fk);
    if (state.roc) {
      ctx.fillStyle = light ? '#0284c7' : ROC;
      ctx.fillText(`region of convergence: Re s > ${(-state.a).toFixed(2)} (dashed edge)`, 16, 18 + 30 * fk);
    }
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    if (G) renderGl(G);
    else {
      ctx.font = "12px 'JetBrains Mono', ui-monospace, monospace";
      ctx.textAlign = 'center';
      ctx.fillStyle = inkA(0.6);
      ctx.fillText('WebGL2 is not available here, so only the curves on the landscape are drawn.', W / 2, H - 16);
    }
    overlay();
    drawTime();
    updateReadout();
  }
  let pending = false;
  const redraw = () => {
    if (pending) return;
    pending = true;
    requestAnimationFrame(() => {
      pending = false;
      draw();
    });
  };
  const rebuild = () => {
    meshDirty = true;
    redraw();
  };

  // --- time-domain inset ---------------------------------------------------
  const ftCanvas = el('ft') as HTMLCanvasElement;
  const ftSetup = setupCanvas(ftCanvas, () => drawTime());
  function drawTime() {
    const c = ftSetup.ctx, w = ftSetup.W, h = ftSetup.H;
    const ink = getComputedStyle(ftCanvas).getPropertyValue('--stage-ink').trim() || '232,233,236';
    c.clearRect(0, 0, w, h);
    const T = 8, pad = 8;
    const x = (t: number) => pad + ((w - 2 * pad) * t) / T;
    const y = (v: number) => h / 2 - v * (h / 2 - pad) * 0.85;
    c.strokeStyle = `rgba(${ink},0.28)`;
    c.lineWidth = 1;
    c.beginPath();
    c.moveTo(pad, y(0));
    c.lineTo(w - pad, y(0));
    c.stroke();

    c.strokeStyle = '#f59e0b';
    c.lineWidth = 2;
    c.beginPath();
    for (let i = 0; i <= 400; i++) {
      const t = (T * i) / 400;
      const v = Math.max(-1.6, Math.min(1.6, signal(t)));
      i ? c.lineTo(x(t), y(v)) : c.moveTo(x(t), y(v));
    }
    c.stroke();

    c.fillStyle = `rgba(${ink},0.5)`;
    c.font = '11px ui-monospace, monospace';
    c.fillText('f(t)', pad + 2, pad + 8);
  }

  function updateReadout() {
    const p = poles();
    const rep = state.sig === 'ramp';
    setRows({
      fs: formula(),
      rocv: `Re(s) > ${(-state.a).toFixed(2)}`,
      fourier: -state.a < 0 ? 'exists (axis inside ROC)' : 'does not converge',
    });
    const TIME: Record<string, string> = {
      exp: 'e^{-at}',
      ramp: 't\\,e^{-at}',
      sin: 'e^{-at}\\sin\\omega t',
      cos: 'e^{-at}\\cos\\omega t',
    };
    /** F(s) again, typeset. */
    const texF = () => {
      const a = sPlus('', '-'), w = state.w.toFixed(1);
      if (state.sig === 'exp') return `\\frac{1}{${a}}`;
      if (state.sig === 'ramp') return `\\frac{1}{(${a})^2}`;
      const d = `(${a})^2+${w}^2`;
      return state.sig === 'sin' ? `\\frac{${w}}{${d}}` : `\\frac{${a}}{${d}}`;
    };
    const polesText = p.length === 1 ? `s = ${p[0].re.toFixed(2)}${rep ? ' (double)' : ''}` : `s = ${p[0].re.toFixed(2)} ± ${state.w.toFixed(1)}j`;
    const fourierOk = -state.a < 0;
    setEq({
      rule: [['F(s)', '#f59e0b'], '=\\int_0^{\\infty} f(t)\\,e^{-st}\\,dt', ',\\quad s=\\sigma+j\\omega'],
      live: [`f(t)=${TIME[state.sig]}`, [`\\quad F(s)=${texF()}`, '#f59e0b'], [p.length === 1 ? `\\quad\\text{pole at }s=${p[0].re.toFixed(2)}` : `\\quad\\text{poles at }s=${p[0].re.toFixed(2)}\\pm ${state.w.toFixed(1)}j`, '#ef4444']],
    });
    setResult({
      value: polesText,
      colour: '#ef4444',
      status: `converges for Re(s) > ${(-state.a).toFixed(2)} · the Fourier transform ${fourierOk ? 'exists: the imaginary axis is inside that half-plane' : 'does not converge: the axis lies outside it'}`,
      note: fourierOk
        ? 'The red marks are the poles, where |F(s)| blows up. The amber slice down σ = 0 is the Fourier transform, and it only exists because the poles sit to the left of the axis.'
        : Math.abs(state.a) < 1e-9
          ? 'With a = 0 the signal never dies out: the poles sit right on the axis and the Fourier integral does not converge. The Laplace transform still does, for Re(s) > 0.'
          : 'With a < 0 the signal grows, the poles sit to the right of the axis, and the Fourier transform does not exist. The Laplace transform still does, further right.',
    });
  }

  // --- interaction ---------------------------------------------------------
  orbitControls(canvas, cam, W, H, { changed: redraw });
  window.addEventListener('themechange', () => { readTheme(); rebuild(); });
  document.addEventListener('fullscreenchange', () => { applyDpr(); redraw(); });
  new ResizeObserver(redraw).observe(canvas);

  const wctl = el('wctl');
  function syncFreqControl() {
    const usable = state.sig === 'sin' || state.sig === 'cos';
    wctl.style.opacity = usable ? '1' : '0.4';
    (el('w') as HTMLInputElement).disabled = !usable;
  }
  const sigSeg = segmented('sig', (s) => {
    state.sig = s;
    syncFreqControl();
    rebuild();
  });
  const setA = slider('a', (v) => { state.a = v; rebuild(); }, (v) => v.toFixed(2));
  const setW = slider('w', (v) => { state.w = v; rebuild(); }, (v) => v.toFixed(2));
  check('roc', (on) => { state.roc = on; rebuild(); });
  check('slice', (on) => { state.slice = on; redraw(); });

  function show(sig: string, a: number, w = state.w) {
    state.sig = sig;
    sigSeg.select(sig);
    state.a = a;
    setA(a);
    state.w = w;
    setW(w);
    syncFreqControl();
    rebuild();
  }
  tries({
    edge: () => show('exp', 0),
    grow: () => show('exp', -0.5),
    resonance: () => show('sin', 0.15, 3),
    double: () => show('ramp', 0.6),
  });

  syncFreqControl();
  draw();
</script>

<style>
  .lp-canvas {
    cursor: grab;
    touch-action: none;
  }
  .lp-canvas:active {
    cursor: grabbing;
  }
  .seg button sup {
    font-size: 0.72em;
  }
</style>
