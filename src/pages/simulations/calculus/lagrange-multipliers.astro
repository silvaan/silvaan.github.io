---
import SimLayout from '../../../layouts/SimLayout.astro';
---

<SimLayout
  areaSlug="calculus"
  title="Lagrange Multipliers"
  description="Stand the objective up as a hill and the constraint becomes a fence winding across it. Walk the fence to its highest point. There the ground below is tangent to a contour line, which is exactly the statement that the two gradients line up."
>
  <div class="sim">
    <div class="sim-stage">
      <canvas id="lag" class="lag-canvas" width="1000" height="720"></canvas>
    </div>

    <div class="sim-panel">
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <button class="btn" id="run">Pause</button>
        <button class="btn ghost" id="snap">Walk to the top</button>
      </div>

      <div class="control">
        <label>Objective f(x, y)</label>
        <div class="seg" id="obj">
          <button data-o="sum" class="active">x + y</button>
          <button data-o="prod">x · y</button>
          <button data-o="tilt">2x + y</button>
        </div>
      </div>

      <div class="control">
        <label>Where on the fence <b id="thval">40°</b></label>
        <input type="range" id="theta" min="0" max="360" step="1" value="40" />
      </div>

      <label class="check"><input type="checkbox" id="wall" checked /> Show the constraint wall</label>
      <label class="check"><input type="checkbox" id="spin" /> Spin the scene</label>

      <div class="readout">
        <div class="row"><span id="l1">Height f here</span><b id="r1">—</b></div>
        <div class="row"><span id="l2">Slope along the fence</span><b id="r2">—</b></div>
        <div class="row"><span id="l3">∠(∇f, ∇g)</span><b id="r3">—</b></div>
        <div class="row"><span id="l4">Multiplier λ</span><b id="r4">—</b></div>
        <div class="row"><span id="l5">Verdict</span><b id="r5">—</b></div>
      </div>

      <p style="font-size:.82rem;color:var(--text-faint);margin:0;line-height:1.5">
        Drag to orbit, scroll to zoom. The hill is f, the amber loop is f along
        the constraint circle, and the ball rolls to wherever the slope along the
        fence is zero.
      </p>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      The fence is the constraint circle lifted onto the hill, so its height is
      the objective. Optimizing under a constraint is just <b>finding the highest
      point of that fence</b>, and the flat spots are where walking along it
      stops changing your height.
    </li>
    <li>
      Watch the slope-along-the-fence readout as you drag. Where the contour on
      the ground <b>crosses</b> the circle the slope is nonzero, so you can still
      climb. At the top it passes through <b>zero</b>: the contour there is
      tangent to the circle.
    </li>
    <li>
      Tangent contours mean the two ground gradients point the same way, so
      <b>∇f = λ∇g</b>. The angle between them hits 0° exactly when the slope
      along the fence hits 0. That is the whole method in one picture.
    </li>
    <li>
      The multiplier λ is how steeply the peak height would rise if you let the
      circle grow. Switch objectives: x · y gives four flat spots, two peaks and
      two dips, and the fence has a top and a bottom to match.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equationBar } from '../../../lib/equation';

  type Obj = {
    f: (x: number, y: number) => number;
    grad: (x: number, y: number) => [number, number];
  };
  const OBJ: Record<string, Obj> = {
    sum: { f: (x, y) => x + y, grad: () => [1, 1] },
    prod: { f: (x, y) => x * y, grad: (x, y) => [y, x] },
    tilt: { f: (x, y) => 2 * x + y, grad: () => [2, 1] },
  };

  const state = {
    obj: 'sum',
    theta: (40 * Math.PI) / 180,
    wall: true,
    spin: false,
    running: true,
    yaw: 0.7,
    pitch: -0.62,
    zoom: 1,
  };

  const canvas = document.getElementById('lag') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const cssVar = (n: string) => getComputedStyle(canvas).getPropertyValue(n).trim();
  const inkRGB = () => cssVar('--stage-ink') || '232,233,236';
  const inkA = (a: number) => `rgba(${inkRGB()},${a})`;
  const bg = () => cssVar('--stage-bg') || '#0d0e12';
  const { label } = makeText(ctx, inkA);

  const GRADF = '#a78bfa'; // ∇f
  const GRADG = '#22d3ee'; // ∇g
  const FENCE = '#f59e0b';
  const BALL = '#34d399';

  const f = (x: number, y: number) => OBJ[state.obj].f(x, y);
  const ZS = 0.62; // how tall the hill stands
  const DOM = 1.55;

  const SCENE = { x: 20, y: 76, w: 660, h: 636 };
  const SIDE = { x: 700, y: 76, w: 280, h: 636 };

  // --- 3D --------------------------------------------------------------------

  const CAM = 6.4, FOCAL = 5.2, SCALE = 150;
  function project(x: number, y: number, z: number) {
    const cy = Math.cos(state.yaw), sy = Math.sin(state.yaw);
    const xr = x * cy + y * sy;
    const yr = -x * sy + y * cy;
    const cp = Math.cos(state.pitch), sp = Math.sin(state.pitch);
    const depth = z * sp + yr * cp + CAM;
    const k = (FOCAL * state.zoom) / Math.max(0.4, depth);
    return {
      x: SCENE.x + SCENE.w / 2 + xr * k * SCALE,
      y: SCENE.y + SCENE.h / 2 + 40 + (-z * cp + yr * sp) * k * SCALE,
      d: depth,
    };
  }

  /** A blue-to-amber ramp by height, so the hill reads without a legend. */
  function heightColour(z: number, a: number) {
    const t = Math.max(0, Math.min(1, (z + 1.2) / 2.4));
    const r = Math.round(60 + t * 200);
    const g = Math.round(120 + t * 60);
    const b = Math.round(210 - t * 180);
    return `rgba(${r},${g},${b},${a})`;
  }

  function drawSurface() {
    const N = 24;
    const at = (i: number, j: number) => {
      const x = -DOM + (2 * DOM * i) / N, y = -DOM + (2 * DOM * j) / N;
      return { x, y, z: f(x, y) * ZS };
    };
    // faint mesh, lines fading with depth so the far side recedes
    const seg = (a: { x: number; y: number; z: number }, b: { x: number; y: number; z: number }) => {
      const p = project(a.x, a.y, a.z), q = project(b.x, b.y, b.z);
      const zmid = (a.z + b.z) / 2;
      const fade = Math.max(0.08, Math.min(0.5, 1.4 / ((p.d + q.d) / 2)));
      ctx.strokeStyle = heightColour(zmid, fade);
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(p.x, p.y);
      ctx.lineTo(q.x, q.y);
      ctx.stroke();
    };
    for (let i = 0; i <= N; i++)
      for (let j = 0; j < N; j++) {
        seg(at(i, j), at(i, j + 1));
        seg(at(j, i), at(j + 1, i));
      }
  }

  const gpt = (th: number) => {
    const x = Math.cos(th), y = Math.sin(th);
    return { x, y, z: f(x, y) * ZS };
  };

  function drawGround() {
    // the constraint circle on the floor
    ctx.strokeStyle = inkA(0.3);
    ctx.lineWidth = 1.6;
    ctx.beginPath();
    for (let i = 0; i <= 90; i++) {
      const a = (i / 90) * Math.PI * 2;
      const p = project(Math.cos(a), Math.sin(a), 0);
      i ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y);
    }
    ctx.stroke();

    // a few objective contours on the floor, dashed
    ctx.setLineDash([3, 4]);
    ctx.lineWidth = 1;
    const levels = state.obj === 'prod' ? [-1, -0.5, 0.5, 1] : [-2, -1, 0, 1, 2];
    for (const lv of levels) marchContour(lv);
    ctx.setLineDash([]);
  }

  /** Marching squares for a floor contour of f at level lv, projected in 3D. */
  function marchContour(lv: number) {
    const Ng = 60, step = (2 * DOM) / Ng;
    ctx.strokeStyle = inkA(0.16);
    ctx.beginPath();
    for (let i = 0; i < Ng; i++)
      for (let j = 0; j < Ng; j++) {
        const x0 = -DOM + i * step, y0 = -DOM + j * step, x1 = x0 + step, y1 = y0 + step;
        const v = [f(x0, y0) - lv, f(x1, y0) - lv, f(x1, y1) - lv, f(x0, y1) - lv];
        const c = [[x0, y0], [x1, y0], [x1, y1], [x0, y1]];
        const pts: { x: number; y: number }[] = [];
        for (let e = 0; e < 4; e++) {
          const a = v[e], b = v[(e + 1) % 4];
          if ((a < 0) !== (b < 0)) {
            const t = a / (a - b);
            const [ax, ay] = c[e], [bx, by] = c[(e + 1) % 4];
            pts.push(project(ax + (bx - ax) * t, ay + (by - ay) * t, 0));
          }
        }
        if (pts.length === 2) {
          ctx.moveTo(pts[0].x, pts[0].y);
          ctx.lineTo(pts[1].x, pts[1].y);
        }
      }
    ctx.stroke();
  }

  function drawFence() {
    // the wall from floor circle up to the lifted curve
    if (state.wall) {
      for (let i = 0; i < 96; i++) {
        const a = (i / 96) * Math.PI * 2;
        const g = gpt(a);
        const lo = project(g.x, g.y, 0), hi = project(g.x, g.y, g.z);
        ctx.strokeStyle = `rgba(245,158,11,0.09)`;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(lo.x, lo.y);
        ctx.lineTo(hi.x, hi.y);
        ctx.stroke();
      }
    }
    // the fence top: f along the constraint, the loop we are optimizing
    ctx.strokeStyle = FENCE;
    ctx.lineWidth = 3;
    ctx.beginPath();
    for (let i = 0; i <= 160; i++) {
      const g = gpt((i / 160) * Math.PI * 2);
      const p = project(g.x, g.y, g.z);
      i ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y);
    }
    ctx.stroke();
  }

  function arrowGround(x: number, y: number, dx: number, dy: number, col: string, name: string, labelDy = 4) {
    const m = Math.hypot(dx, dy) || 1;
    const L = 0.62;
    const a = project(x, y, 0);
    const b = project(x + (dx / m) * L, y + (dy / m) * L, 0);
    ctx.strokeStyle = col;
    ctx.fillStyle = col;
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(a.x, a.y);
    ctx.lineTo(b.x, b.y);
    ctx.stroke();
    const an = Math.atan2(b.y - a.y, b.x - a.x);
    ctx.beginPath();
    ctx.moveTo(b.x, b.y);
    ctx.lineTo(b.x - 12 * Math.cos(an - 0.4), b.y - 12 * Math.sin(an - 0.4));
    ctx.lineTo(b.x - 12 * Math.cos(an + 0.4), b.y - 12 * Math.sin(an + 0.4));
    ctx.closePath();
    ctx.fill();
    label(name, b.x + 6, b.y + labelDy, 0.95, 'left', 13, col);
  }

  // --- the current point ------------------------------------------------------

  function slopeAlong(th: number) {
    // d/dθ f(cosθ, sinθ) = ∇f · (−sinθ, cosθ)
    const g = OBJ[state.obj].grad(Math.cos(th), Math.sin(th));
    return g[0] * -Math.sin(th) + g[1] * Math.cos(th);
  }

  function drawPoint() {
    const th = state.theta;
    const x = Math.cos(th), y = Math.sin(th);
    const g = gpt(th);

    // ground gradients: ∇f and ∇g (radial), the tangency test
    const gf = OBJ[state.obj].grad(x, y);
    arrowGround(x, y, gf[0], gf[1], GRADF, '∇f', -8);
    arrowGround(x, y, x, y, GRADG, '∇g', 16);

    // drop line from the fence down to the floor
    const lo = project(x, y, 0), hi = project(x, y, g.z);
    ctx.strokeStyle = inkA(0.4);
    ctx.setLineDash([3, 3]);
    ctx.lineWidth = 1.3;
    ctx.beginPath();
    ctx.moveTo(lo.x, lo.y);
    ctx.lineTo(hi.x, hi.y);
    ctx.stroke();
    ctx.setLineDash([]);

    // the ball on the fence
    ctx.fillStyle = BALL;
    ctx.strokeStyle = bg();
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(hi.x, hi.y, 8, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();
    // its shadow
    ctx.fillStyle = inkA(0.4);
    ctx.beginPath();
    ctx.arc(lo.x, lo.y, 3.5, 0, Math.PI * 2);
    ctx.fill();
  }

  // --- the height-along-the-fence curve --------------------------------------

  function drawSide() {
    ctx.strokeStyle = inkA(0.1);
    ctx.lineWidth = 1;
    ctx.strokeRect(SIDE.x, SIDE.y, SIDE.w, SIDE.h);
    label('HEIGHT ALONG THE FENCE', SIDE.x + 2, SIDE.y - 9, 0.5, 'left', 11);

    const px = SIDE.x + 40, py = SIDE.y + 40, pw = SIDE.w - 62, ph = SIDE.h - 160;
    let lo = Infinity, hi = -Infinity;
    for (let i = 0; i <= 200; i++) {
      const v = f(Math.cos((i / 200) * Math.PI * 2), Math.sin((i / 200) * Math.PI * 2));
      lo = Math.min(lo, v);
      hi = Math.max(hi, v);
    }
    const pad = 0.2 * (hi - lo || 1);
    lo -= pad;
    hi += pad;
    const X = (th: number) => px + (th / (Math.PI * 2)) * pw;
    const Y = (v: number) => py + ph - ((v - lo) / (hi - lo)) * ph;

    ctx.strokeStyle = inkA(0.18);
    ctx.beginPath();
    ctx.moveTo(px, py);
    ctx.lineTo(px, py + ph);
    ctx.lineTo(px + pw, py + ph);
    ctx.stroke();

    // zero-height line
    if (lo < 0 && hi > 0) {
      ctx.strokeStyle = inkA(0.12);
      ctx.setLineDash([3, 3]);
      ctx.beginPath();
      ctx.moveTo(px, Y(0));
      ctx.lineTo(px + pw, Y(0));
      ctx.stroke();
      ctx.setLineDash([]);
    }

    ctx.strokeStyle = FENCE;
    ctx.lineWidth = 2.4;
    ctx.beginPath();
    for (let i = 0; i <= 200; i++) {
      const th = (i / 200) * Math.PI * 2;
      const v = f(Math.cos(th), Math.sin(th));
      i ? ctx.lineTo(X(th), Y(v)) : ctx.moveTo(X(th), Y(v));
    }
    ctx.stroke();

    // mark the peaks and dips: where the slope changes sign
    for (let i = 0; i < 360; i++) {
      const a = (i / 360) * Math.PI * 2, b = ((i + 1) / 360) * Math.PI * 2;
      if (slopeAlong(a) >= 0 !== slopeAlong(b) >= 0) {
        const th = (a + b) / 2, v = f(Math.cos(th), Math.sin(th));
        const up = slopeAlong(a) > 0;
        ctx.fillStyle = up ? BALL : GRADF;
        ctx.beginPath();
        ctx.arc(X(th), Y(v), 4, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    // the current point
    const th = state.theta, v = f(Math.cos(th), Math.sin(th));
    ctx.strokeStyle = inkA(0.35);
    ctx.beginPath();
    ctx.moveTo(X(th), py);
    ctx.lineTo(X(th), py + ph);
    ctx.stroke();
    ctx.fillStyle = BALL;
    ctx.strokeStyle = bg();
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(X(th), Y(v), 6, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();

    label('0°', px, py + ph + 15, 0.4, 'left', 10);
    label('θ, once around', px + pw / 2, py + ph + 15, 0.4, 'center', 10);
    label('360°', px + pw, py + ph + 15, 0.4, 'right', 10);

    label('flat spots are the answer:', SIDE.x + 16, SIDE.y + SIDE.h - 52, 0.5, 'left', 11);
    label('green = a peak, purple = a dip', SIDE.x + 16, SIDE.y + SIDE.h - 34, 0.45, 'left', 11);
    label('the slope there is exactly zero', SIDE.x + 16, SIDE.y + SIDE.h - 16, 0.4, 'left', 10);
  }

  // --- readouts ---------------------------------------------------------------

  const el = (id: string) => document.getElementById(id) as HTMLElement;
  const setRow = (n: number, val: string, col?: string) => {
    const b = el('r' + n);
    b.textContent = val;
    if (col) b.style.color = col;
    else b.style.removeProperty('color');
  };
  const setEq = equationBar();

  function updateReadout() {
    const th = state.theta, x = Math.cos(th), y = Math.sin(th);
    const gf = OBJ[state.obj].grad(x, y);
    const slope = slopeAlong(th);
    const dotv = gf[0] * x + gf[1] * y;
    const crossv = gf[0] * y - gf[1] * x;
    const ang = (Math.atan2(Math.abs(crossv), dotv) * 180) / Math.PI;
    const aligned = Math.min(ang, 180 - ang);
    const lam = (gf[0] * x + gf[1] * y) / 2; // ∇f·∇g / |∇g|², with ∇g=(2x,2y), |∇g|²=4
    setRow(1, f(x, y).toFixed(3));
    setRow(2, slope.toFixed(3), Math.abs(slope) < 0.02 ? BALL : undefined);
    setRow(3, aligned.toFixed(1) + '°');
    setRow(4, lam.toFixed(3));
    const optimal = Math.abs(slope) < 0.02;
    setRow(5, optimal ? (slope, dotv > 0 ? 'at a peak ✓' : 'at a dip') : 'can still climb', optimal ? BALL : inkA(0.6));
    setEq([
      [
        ['\\nabla f', GRADF],
        '=\\lambda',
        ['\\nabla g', GRADG],
        '\\quad\\text{at the best point on the fence}',
      ],
      [
        [`\\angle(\\nabla f,\\nabla g)=${aligned.toFixed(1)}^{\\circ}`, aligned < 3 ? BALL : FENCE],
        `\\quad\\lambda = ${lam.toFixed(3)}`,
        [
          `\\quad\\text{slope along the fence}=${slope.toFixed(3)}`,
          optimal ? BALL : FENCE,
        ],
      ],
      [
        'while the two arrows disagree there is uphill left along the fence; when they line up there is none',
      ],
    ]);
  }

  // --- loop -------------------------------------------------------------------

  function draw() {
    ctx.clearRect(0, 0, W, H);
    label('Lagrange Multipliers', 20, 30, 0.85, 'left', 14);
    label('walk the fence to its highest point', 20, 52, 0.5, 'left', 11, FENCE);
    const legend: [string, string][] = [
      [FENCE, 'the fence f|g'],
      [GRADF, '∇f'],
      [GRADG, '∇g'],
    ];
    let lx = W - 20;
    for (let k = legend.length - 1; k >= 0; k--) {
      const [c, t] = legend[k];
      ctx.font = '13px ui-monospace, monospace';
      const tw = ctx.measureText(t).width;
      label(t, lx, 30, 0.6, 'right', 11);
      ctx.fillStyle = c;
      ctx.beginPath();
      ctx.arc(lx - tw - 11, 26, 5, 0, Math.PI * 2);
      ctx.fill();
      lx -= tw + 30;
    }
    ctx.save();
    ctx.beginPath();
    ctx.rect(SCENE.x, SCENE.y, SCENE.w, SCENE.h);
    ctx.clip();
    drawSurface();
    drawGround();
    drawFence();
    drawPoint();
    ctx.restore();
    drawSide();
    updateReadout();
  }

  let last = performance.now();
  function frame(now: number) {
    const dt = Math.min(0.05, Math.max(0, (now - last) / 1000));
    last = now;
    if (state.running && state.spin) state.yaw += dt * 0.3;
    draw();
    requestAnimationFrame(frame);
  }

  // --- controls ---------------------------------------------------------------

  const runBtn = el('run');
  runBtn.addEventListener('click', () => {
    state.running = !state.running;
    runBtn.textContent = state.running ? 'Pause' : 'Run';
  });
  el('snap').addEventListener('click', () => {
    let bestT = 0, bestV = -Infinity;
    for (let i = 0; i < 3600; i++) {
      const t = (i / 3600) * Math.PI * 2, v = f(Math.cos(t), Math.sin(t));
      if (v > bestV) { bestV = v; bestT = t; }
    }
    state.theta = bestT;
    (el('theta') as HTMLInputElement).value = String(Math.round((bestT * 180) / Math.PI));
    el('thval').textContent = `${Math.round((bestT * 180) / Math.PI)}°`;
  });
  const thEl = el('theta') as HTMLInputElement;
  thEl.addEventListener('input', () => {
    state.theta = (+thEl.value * Math.PI) / 180;
    el('thval').textContent = `${thEl.value}°`;
  });
  el('obj').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (!b) return;
    document.querySelectorAll('#obj button').forEach((x) => x.classList.remove('active'));
    b.classList.add('active');
    state.obj = b.dataset.o!;
  });
  (el('wall') as HTMLInputElement).addEventListener('change', (e) => {
    state.wall = (e.target as HTMLInputElement).checked;
  });
  (el('spin') as HTMLInputElement).addEventListener('change', (e) => {
    state.spin = (e.target as HTMLInputElement).checked;
  });

  let dragging = false, lx = 0, ly = 0;
  canvas.addEventListener('pointerdown', (e) => {
    dragging = true;
    lx = e.clientX;
    ly = e.clientY;
    canvas.setPointerCapture(e.pointerId);
  });
  canvas.addEventListener('pointermove', (e) => {
    if (!dragging) return;
    // Fully free orbit: yaw and pitch both unbounded, so top-down and
    // bottom-up views are reachable.
    state.yaw += (e.clientX - lx) * 0.01;
    state.pitch += (e.clientY - ly) * 0.01;
    lx = e.clientX;
    ly = e.clientY;
  });
  const stop = () => (dragging = false);
  canvas.addEventListener('pointerup', stop);
  canvas.addEventListener('pointercancel', stop);
  canvas.addEventListener(
    'wheel',
    (e) => {
      e.preventDefault();
      state.zoom = Math.max(0.5, Math.min(3, state.zoom * Math.exp(-e.deltaY * 0.0016)));
    },
    { passive: false }
  );

  requestAnimationFrame(frame);
</script>

<style>
  .lag-canvas {
    cursor: grab;
    touch-action: none;
  }
  .lag-canvas:active {
    cursor: grabbing;
  }
  .check {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .check input {
    accent-color: var(--accent);
  }
</style>
