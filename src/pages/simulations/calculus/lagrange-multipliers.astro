---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Checks from '../../../components/sim/Checks.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="calculus"
  title="Lagrange Multipliers"
  description="Stand the objective up as a hill and the constraint becomes a fence winding across it. Walk the fence to its highest point: there the ground is tangent to a contour line, which is exactly the statement that the two gradients line up."
  shortcuts={['animate', 'fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas id="lag" class="lag-canvas" width="1000" height="720" role="img" aria-label="The objective as a hill with the constraint circle drawn on it as a fence, a ball on the fence, the two gradient arrows at the ball, and the height along the fence plotted at the side."></canvas>
      </div>
      <Caption
        legend={[{ label: 'the fence, f along the constraint', color: '#f59e0b' }, { label: '∇f', color: '#a78bfa' }, { label: '∇g', color: '#22d3ee' }, { label: 'the top of the fence', color: '#34d399' }]}
        hint="Drag to orbit · scroll to zoom · Walk uphill climbs the fence until the slope along it is zero"
      />
      <Result label="Slope along the fence" />
    </div>
    <div class="sim-panel">
      <Seg id="obj" label="Objective f(x, y)" attr="o" options={[{ value: 'sum', label: 'x + y' }, { value: 'prod', label: 'x · y' }, { value: 'tilt', label: '2x + y' }]} />
      <Slider id="theta" label="Where on the fence" min={0} max={360} value={40} display="40°" />
      <Slider id="rad" label="Circle radius r (g = x² + y² = r²)" min={0.4} max={1.4} step={0.01} value={1} display="1.00" />
      <Transport animate="Walk uphill" reset={false} />
      <Checks items={[{ id: 'wall', label: 'Show the constraint wall', checked: true }, { id: 'spin', label: 'Spin the scene' }]} />
      <Readout
        title="Values"
        rows={[
          { id: 'r1', label: 'height f here' },
          { id: 'r3', label: '∠(∇f, ∇g)' },
          { id: 'r4', label: 'multiplier λ here' },
          { id: 'r5', label: 'best height f* on this circle' },
          { id: 'r6', label: 'df* / d(r²)' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Press <b>Walk uphill</b>: the ball climbs the fence and stops where the
      slope along it is zero. There the floor contour is tangent to the circle.
      <Try id="walk" label="Walk" />
    </li>
    <li>
      At the top ∇f and ∇g are 0° apart, so <b>∇f = λ∇g</b>. Away from the peaks
      and dips they disagree and there is still uphill left. <Try id="align" />
    </li>
    <li>
      Change the radius <b>r</b> and the best height changes with it. At the
      top, λ equals df*/d(r²): the multiplier is the price of loosening the
      constraint. <Try id="price" />
    </li>
    <li>
      On <b>x · y</b> the fence has two peaks and two dips. Walking uphill finds
      the peak on your side, not always the same one. <Try id="twin" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { el, segmented, slider, check, result, readout, tries } from '../../../lib/panel';

  type Obj = {
    f: (x: number, y: number) => number;
    grad: (x: number, y: number) => [number, number];
  };
  const OBJ: Record<string, Obj & { deg: number }> = {
    sum: { f: (x, y) => x + y, grad: () => [1, 1], deg: 1 },
    prod: { f: (x, y) => x * y, grad: (x, y) => [y, x], deg: 2 },
    tilt: { f: (x, y) => 2 * x + y, grad: () => [2, 1], deg: 1 },
  };

  const state = {
    obj: 'sum',
    theta: (40 * Math.PI) / 180,
    r: 1,
    wall: true,
    spin: false,
    walking: false,
    yaw: 0.7,
    pitch: -0.62,
    zoom: 1,
  };

  const canvas = el('lag') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const cssVar = (n: string) => getComputedStyle(canvas).getPropertyValue(n).trim();
  const inkRGB = () => cssVar('--stage-ink') || '232,233,236';
  const inkA = (a: number) => `rgba(${inkRGB()},${a})`;
  const bg = () => cssVar('--stage-bg') || '#0d0e12';
  const { label } = makeText(ctx, inkA);

  const GRADF = '#a78bfa'; // ∇f
  const GRADG = '#22d3ee'; // ∇g
  const FENCE = '#f59e0b';
  const BALL = '#34d399';

  const f = (x: number, y: number) => OBJ[state.obj].f(x, y);
  const ZS = 0.62; // how tall the hill stands
  const DOM = 1.55;

  const SCENE = { x: 20, y: 76, w: 660, h: 636 };
  const SIDE = { x: 700, y: 76, w: 280, h: 636 };

  // --- 3D --------------------------------------------------------------------

  const CAM = 6.4, FOCAL = 5.2, SCALE = 150;
  function project(x: number, y: number, z: number) {
    const cy = Math.cos(state.yaw), sy = Math.sin(state.yaw);
    const xr = x * cy + y * sy;
    const yr = -x * sy + y * cy;
    const cp = Math.cos(state.pitch), sp = Math.sin(state.pitch);
    const depth = z * sp + yr * cp + CAM;
    const k = (FOCAL * state.zoom) / Math.max(0.4, depth);
    return {
      x: SCENE.x + SCENE.w / 2 + xr * k * SCALE,
      y: SCENE.y + SCENE.h / 2 + 40 + (-z * cp + yr * sp) * k * SCALE,
      d: depth,
    };
  }

  /** A blue-to-amber ramp by height, so the hill reads without a legend. */
  function heightColour(z: number, a: number) {
    const t = Math.max(0, Math.min(1, (z + 1.2) / 2.4));
    const r = Math.round(60 + t * 200);
    const g = Math.round(120 + t * 60);
    const b = Math.round(210 - t * 180);
    return `rgba(${r},${g},${b},${a})`;
  }

  function drawSurface() {
    const N = 24;
    const at = (i: number, j: number) => {
      const x = -DOM + (2 * DOM * i) / N, y = -DOM + (2 * DOM * j) / N;
      return { x, y, z: f(x, y) * ZS };
    };
    // faint mesh, lines fading with depth so the far side recedes
    const seg = (a: { x: number; y: number; z: number }, b: { x: number; y: number; z: number }) => {
      const p = project(a.x, a.y, a.z), q = project(b.x, b.y, b.z);
      const zmid = (a.z + b.z) / 2;
      const fade = Math.max(0.08, Math.min(0.5, 1.4 / ((p.d + q.d) / 2)));
      ctx.strokeStyle = heightColour(zmid, fade);
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(p.x, p.y);
      ctx.lineTo(q.x, q.y);
      ctx.stroke();
    };
    for (let i = 0; i <= N; i++)
      for (let j = 0; j < N; j++) {
        seg(at(i, j), at(i, j + 1));
        seg(at(j, i), at(j + 1, i));
      }
  }

  const gpt = (th: number) => {
    const x = state.r * Math.cos(th), y = state.r * Math.sin(th);
    return { x, y, z: f(x, y) * ZS };
  };

  function drawGround() {
    // the constraint circle on the floor
    ctx.strokeStyle = inkA(0.3);
    ctx.lineWidth = 1.6;
    ctx.beginPath();
    for (let i = 0; i <= 90; i++) {
      const a = (i / 90) * Math.PI * 2;
      const p = project(state.r * Math.cos(a), state.r * Math.sin(a), 0);
      i ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y);
    }
    ctx.stroke();

    // a few objective contours on the floor, dashed
    ctx.setLineDash([3, 4]);
    ctx.lineWidth = 1;
    const levels = state.obj === 'prod' ? [-1, -0.5, 0.5, 1] : [-2, -1, 0, 1, 2];
    for (const lv of levels) marchContour(lv);
    ctx.setLineDash([]);
  }

  /** Marching squares for a floor contour of f at level lv, projected in 3D. */
  function marchContour(lv: number) {
    const Ng = 60, step = (2 * DOM) / Ng;
    ctx.strokeStyle = inkA(0.16);
    ctx.beginPath();
    for (let i = 0; i < Ng; i++)
      for (let j = 0; j < Ng; j++) {
        const x0 = -DOM + i * step, y0 = -DOM + j * step, x1 = x0 + step, y1 = y0 + step;
        const v = [f(x0, y0) - lv, f(x1, y0) - lv, f(x1, y1) - lv, f(x0, y1) - lv];
        const c = [[x0, y0], [x1, y0], [x1, y1], [x0, y1]];
        const pts: { x: number; y: number }[] = [];
        for (let e = 0; e < 4; e++) {
          const a = v[e], b = v[(e + 1) % 4];
          if ((a < 0) !== (b < 0)) {
            const t = a / (a - b);
            const [ax, ay] = c[e], [bx, by] = c[(e + 1) % 4];
            pts.push(project(ax + (bx - ax) * t, ay + (by - ay) * t, 0));
          }
        }
        if (pts.length === 2) {
          ctx.moveTo(pts[0].x, pts[0].y);
          ctx.lineTo(pts[1].x, pts[1].y);
        }
      }
    ctx.stroke();
  }

  function drawFence() {
    // the wall from floor circle up to the lifted curve
    if (state.wall) {
      for (let i = 0; i < 96; i++) {
        const a = (i / 96) * Math.PI * 2;
        const g = gpt(a);
        const lo = project(g.x, g.y, 0), hi = project(g.x, g.y, g.z);
        ctx.strokeStyle = `rgba(245,158,11,0.09)`;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(lo.x, lo.y);
        ctx.lineTo(hi.x, hi.y);
        ctx.stroke();
      }
    }
    // the fence top: f along the constraint, the loop we are optimizing
    ctx.strokeStyle = FENCE;
    ctx.lineWidth = 3;
    ctx.beginPath();
    for (let i = 0; i <= 160; i++) {
      const g = gpt((i / 160) * Math.PI * 2);
      const p = project(g.x, g.y, g.z);
      i ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y);
    }
    ctx.stroke();
  }

  function arrowGround(x: number, y: number, dx: number, dy: number, col: string, name: string, labelDy = 4) {
    const m = Math.hypot(dx, dy) || 1;
    const L = 0.62;
    const a = project(x, y, 0);
    const b = project(x + (dx / m) * L, y + (dy / m) * L, 0);
    ctx.strokeStyle = col;
    ctx.fillStyle = col;
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(a.x, a.y);
    ctx.lineTo(b.x, b.y);
    ctx.stroke();
    const an = Math.atan2(b.y - a.y, b.x - a.x);
    ctx.beginPath();
    ctx.moveTo(b.x, b.y);
    ctx.lineTo(b.x - 12 * Math.cos(an - 0.4), b.y - 12 * Math.sin(an - 0.4));
    ctx.lineTo(b.x - 12 * Math.cos(an + 0.4), b.y - 12 * Math.sin(an + 0.4));
    ctx.closePath();
    ctx.fill();
    label(name, b.x + 6, b.y + labelDy, 0.95, 'left', 13, col);
  }

  // --- the current point ------------------------------------------------------

  function slopeAlong(th: number) {
    // d/dθ f(r cosθ, r sinθ) = ∇f · r(−sinθ, cosθ)
    const g = OBJ[state.obj].grad(state.r * Math.cos(th), state.r * Math.sin(th));
    return state.r * (g[0] * -Math.sin(th) + g[1] * Math.cos(th));
  }
  /** The fence height at angle θ. */
  const fAt = (th: number) => f(state.r * Math.cos(th), state.r * Math.sin(th));
  /** The highest point of the fence, sampled finely. */
  function best() {
    let v = -Infinity;
    for (let i = 0; i < 3600; i++) v = Math.max(v, fAt((i / 3600) * Math.PI * 2));
    return v;
  }
  /** The largest |slope| on the fence, to scale the walk to the objective. */
  function slopeScale() {
    let m = 1e-6;
    for (let i = 0; i < 360; i++) m = Math.max(m, Math.abs(slopeAlong((i / 360) * Math.PI * 2)));
    return m;
  }

  function drawPoint() {
    const th = state.theta;
    const x = state.r * Math.cos(th), y = state.r * Math.sin(th);
    const g = gpt(th);

    // ground gradients: ∇f and ∇g (radial), the tangency test
    const gf = OBJ[state.obj].grad(x, y);
    arrowGround(x, y, gf[0], gf[1], GRADF, '∇f', -8);
    arrowGround(x, y, x, y, GRADG, '∇g', 16);

    // drop line from the fence down to the floor
    const lo = project(x, y, 0), hi = project(x, y, g.z);
    ctx.strokeStyle = inkA(0.4);
    ctx.setLineDash([3, 3]);
    ctx.lineWidth = 1.3;
    ctx.beginPath();
    ctx.moveTo(lo.x, lo.y);
    ctx.lineTo(hi.x, hi.y);
    ctx.stroke();
    ctx.setLineDash([]);

    // the ball on the fence
    ctx.fillStyle = BALL;
    ctx.strokeStyle = bg();
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(hi.x, hi.y, 8, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();
    // its shadow
    ctx.fillStyle = inkA(0.4);
    ctx.beginPath();
    ctx.arc(lo.x, lo.y, 3.5, 0, Math.PI * 2);
    ctx.fill();
  }

  // --- the height-along-the-fence curve --------------------------------------

  function drawSide() {
    ctx.strokeStyle = inkA(0.1);
    ctx.lineWidth = 1;
    ctx.strokeRect(SIDE.x, SIDE.y, SIDE.w, SIDE.h);
    label('height along the fence', SIDE.x + 2, SIDE.y - 9, 0.5, 'left', 11);

    const px = SIDE.x + 40, py = SIDE.y + 40, pw = SIDE.w - 62, ph = SIDE.h - 160;
    let lo = Infinity, hi = -Infinity;
    for (let i = 0; i <= 200; i++) {
      const v = fAt((i / 200) * Math.PI * 2);
      lo = Math.min(lo, v);
      hi = Math.max(hi, v);
    }
    const pad = 0.2 * (hi - lo || 1);
    lo -= pad;
    hi += pad;
    const X = (th: number) => px + (th / (Math.PI * 2)) * pw;
    const Y = (v: number) => py + ph - ((v - lo) / (hi - lo)) * ph;

    ctx.strokeStyle = inkA(0.18);
    ctx.beginPath();
    ctx.moveTo(px, py);
    ctx.lineTo(px, py + ph);
    ctx.lineTo(px + pw, py + ph);
    ctx.stroke();

    // zero-height line
    if (lo < 0 && hi > 0) {
      ctx.strokeStyle = inkA(0.12);
      ctx.setLineDash([3, 3]);
      ctx.beginPath();
      ctx.moveTo(px, Y(0));
      ctx.lineTo(px + pw, Y(0));
      ctx.stroke();
      ctx.setLineDash([]);
    }

    ctx.strokeStyle = FENCE;
    ctx.lineWidth = 2.4;
    ctx.beginPath();
    for (let i = 0; i <= 200; i++) {
      const th = (i / 200) * Math.PI * 2;
      const v = fAt(th);
      i ? ctx.lineTo(X(th), Y(v)) : ctx.moveTo(X(th), Y(v));
    }
    ctx.stroke();

    // mark the peaks and dips: where the slope changes sign
    for (let i = 0; i < 360; i++) {
      const a = (i / 360) * Math.PI * 2, b = ((i + 1) / 360) * Math.PI * 2;
      if (slopeAlong(a) >= 0 !== slopeAlong(b) >= 0) {
        const th = (a + b) / 2, v = fAt(th);
        const up = slopeAlong(a) > 0;
        ctx.fillStyle = up ? BALL : GRADF;
        ctx.beginPath();
        ctx.arc(X(th), Y(v), 4, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    // the current point
    const th = state.theta, v = fAt(th);
    ctx.strokeStyle = inkA(0.35);
    ctx.beginPath();
    ctx.moveTo(X(th), py);
    ctx.lineTo(X(th), py + ph);
    ctx.stroke();
    ctx.fillStyle = BALL;
    ctx.strokeStyle = bg();
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(X(th), Y(v), 6, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();

    label('0°', px, py + ph + 15, 0.4, 'left', 11);
    label('θ, once around', px + pw / 2, py + ph + 15, 0.4, 'center', 11);
    label('360°', px + pw, py + ph + 15, 0.4, 'right', 11);

    label('flat spots are the answer:', SIDE.x + 16, SIDE.y + SIDE.h - 52, 0.5, 'left', 11);
    label('green = a peak, purple = a dip', SIDE.x + 16, SIDE.y + SIDE.h - 34, 0.45, 'left', 11);
    label('the slope there is exactly zero', SIDE.x + 16, SIDE.y + SIDE.h - 16, 0.4, 'left', 11);
  }

  // --- readouts ---------------------------------------------------------------

  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  function updateReadout() {
    const th = state.theta, r = state.r, x = r * Math.cos(th), y = r * Math.sin(th);
    const gf = OBJ[state.obj].grad(x, y);
    const slope = slopeAlong(th);
    const dotv = gf[0] * x + gf[1] * y;
    const crossv = gf[0] * y - gf[1] * x;
    const ang = (Math.atan2(Math.abs(crossv), dotv) * 180) / Math.PI;
    const aligned = Math.min(ang, 180 - ang);
    const lam = dotv / (2 * r * r); // ∇f·∇g / |∇g|², with ∇g = (2x, 2y), |∇g|² = 4r²
    const optimal = Math.abs(slope) < 0.01 * slopeScale();
    // f is homogeneous of degree k, so f* = c^(k/2)·f*(1) with c = r², and df*/dc = k f* / (2c)
    const fStar = best();
    const dfdc = (OBJ[state.obj].deg * fStar) / (2 * r * r);
    setRows({
      r1: f(x, y).toFixed(3),
      r3: `${aligned.toFixed(1)}°`,
      r4: lam.toFixed(3),
      r5: fStar.toFixed(3),
      r6: dfdc.toFixed(3),
    });
    setEq({
      rule: [['\\nabla f', GRADF], '=\\lambda', ['\\nabla g', GRADG], `,\\quad g = x^2+y^2 = r^2`],
      live: [[`\\angle(\\nabla f,\\nabla g)=${aligned.toFixed(1)}^{\\circ}`, aligned < 3 ? BALL : FENCE], `\\quad\\lambda = ${lam.toFixed(3)}`, `\\quad \\tfrac{df^*}{d(r^2)} = ${dfdc.toFixed(3)}`],
    });
    setResult({
      value: slope.toFixed(3),
      colour: optimal ? BALL : FENCE,
      status: optimal
        ? `${dotv > 0 ? 'at a peak' : 'at a dip'} · the two gradients line up, ${aligned.toFixed(1)}° apart · λ = ${lam.toFixed(3)}`
        : `can still climb · ∇f and ∇g are ${aligned.toFixed(1)}° apart · height ${f(x, y).toFixed(3)}`,
      note: optimal && dotv > 0
        ? `λ = ${lam.toFixed(3)} matches df*/d(r²) = ${dfdc.toFixed(3)}: how fast the best height rises as the constraint loosens.`
        : 'While the two arrows disagree there is uphill left along the fence; when they line up there is none. λ is how much of ∇g it takes to make ∇f.',
    });
  }

  // --- loop -------------------------------------------------------------------

  function draw() {
    ctx.clearRect(0, 0, W, H);
    ctx.save();
    ctx.beginPath();
    ctx.rect(SCENE.x, SCENE.y, SCENE.w, SCENE.h);
    ctx.clip();
    drawSurface();
    drawGround();
    drawFence();
    drawPoint();
    ctx.restore();
    drawSide();
    updateReadout();
  }

  let last = performance.now();
  function frame(now: number) {
    const dt = Math.min(0.05, Math.max(0, (now - last) / 1000));
    last = now;
    if (state.spin) state.yaw += dt * 0.3;
    if (state.walking) walk(dt);
    draw();
    requestAnimationFrame(frame);
  }

  // --- controls ---------------------------------------------------------------

  const TAU = Math.PI * 2;
  const setTheta = slider('theta', (v) => { state.walking = false; state.theta = (v * Math.PI) / 180; }, (v) => `${v}°`);
  const setRad = slider('rad', (v) => (state.r = v), (v) => v.toFixed(2));
  const showTheta = () => setTheta(Math.round((state.theta * 180) / Math.PI) % 360);

  // Walk uphill: gradient ascent along the fence, θ moving with the slope
  // along it, so the ball stops at the first flat spot uphill of where it is.
  let walkScale = 1;
  function walk(dt: number) {
    const s = slopeAlong(state.theta) / walkScale;
    state.theta = (((state.theta + 2.5 * s * dt) % TAU) + TAU) % TAU;
    showTheta();
    if (Math.abs(s) < 0.002) state.walking = false;
  }
  function startWalk() {
    walkScale = slopeScale();
    // sitting exactly on a dip, nudge off it so there is a way up
    if (Math.abs(slopeAlong(state.theta)) < 1e-3 * walkScale) state.theta += 0.05;
    state.walking = true;
  }
  el('run').addEventListener('click', startWalk);
  const objs = segmented('obj', (o) => { state.walking = false; state.obj = o; });
  check('wall', (on) => (state.wall = on));
  check('spin', (on) => (state.spin = on));

  function show(obj: string, deg: number, r: number, go = false) {
    state.obj = obj;
    objs.select(obj);
    state.r = r;
    setRad(r);
    state.walking = false;
    state.theta = (deg * Math.PI) / 180;
    showTheta();
    if (go) startWalk();
  }
  tries({
    walk: () => show('sum', 200, 1, true),
    align: () => show('tilt', (Math.atan2(1, 2) * 180) / Math.PI, 1),
    price: () => show('tilt', (Math.atan2(1, 2) * 180) / Math.PI, 1.3),
    twin: () => show('prod', 160, 1, true),
  });

  let dragging = false, lx = 0, ly = 0;
  canvas.addEventListener('pointerdown', (e) => {
    dragging = true;
    lx = e.clientX;
    ly = e.clientY;
    canvas.setPointerCapture(e.pointerId);
  });
  canvas.addEventListener('pointermove', (e) => {
    if (!dragging) return;
    // Fully free orbit: yaw and pitch both unbounded, so top-down and
    // bottom-up views are reachable.
    state.yaw += (e.clientX - lx) * 0.01;
    state.pitch += (e.clientY - ly) * 0.01;
    lx = e.clientX;
    ly = e.clientY;
  });
  const stop = () => (dragging = false);
  canvas.addEventListener('pointerup', stop);
  canvas.addEventListener('pointercancel', stop);
  canvas.addEventListener(
    'wheel',
    (e) => {
      e.preventDefault();
      state.zoom = Math.max(0.5, Math.min(3, state.zoom * Math.exp(-e.deltaY * 0.0016)));
    },
    { passive: false }
  );

  requestAnimationFrame(frame);
</script>

<style>
  .lag-canvas {
    cursor: grab;
    touch-action: none;
  }
  .lag-canvas:active {
    cursor: grabbing;
  }
</style>
