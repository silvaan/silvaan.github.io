---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
---

<SimLayout
  areaSlug="statistics"
  title="Central Limit Theorem"
  description="Average n draws from any distribution and record the mean, over and over. The means pile into a bell curve whatever the source looked like."
  shortcuts={['run', 'reset', 'fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="clt"
          width="1000"
          height="600"
          role="img"
          aria-label="A faint histogram of the source distribution above a growing histogram of sample means, with the predicted Gaussian drawn over it."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'source distribution', color: 'rgba(154,160,172,0.6)' },
          { label: 'sample means', color: '#7c8cff' },
          { label: 'predicted bell', color: '#5eead4' },
        ]}
      />
      <Result label="Spread of the mean σ/√n" />
    </div>

    <div class="sim-panel">
      <Transport running />
      <Seg
        id="src"
        label="Source distribution"
        attr="src"
        options={[
          { value: 'uniform', label: 'Uniform' },
          { value: 'exponential', label: 'Exponential' },
          { value: 'bimodal', label: 'Bimodal' },
          { value: 'dice', label: 'Dice' },
        ]}
      />
      <Slider id="n" label="Sample size n" min={1} max={50} value={5} />
      <Readout
        rows={[
          { id: 'r-count', label: 'means collected' },
          { id: 'r-sigma', label: 'σ of the source' },
          { id: 'r-sd', label: 'σ/√n' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Set <b>n = 1</b>: the big histogram is just the raw source, so Exponential
      and Bimodal look nothing like a bell.
    </li>
    <li>
      Raise n to 5, then 30. However skewed the source, the means pile into the
      <b>same Gaussian shape</b>. That universality is the theorem.
    </li>
    <li>
      Watch the spread of the mean as n grows: it shrinks like <b>1/√n</b>, so the
      bell gets narrower but four times the samples only halves the width.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk } from '../../../lib/draw';
  import { el, segmented, slider, transport, result, readout } from '../../../lib/panel';

  const MEANS = '#7c8cff', BELL = '#5eead4';
  type Src = { sample: () => number; mean: number; var: number; range: [number, number] };
  const SOURCES: Record<string, Src> = {
    uniform: { sample: () => Math.random(), mean: 0.5, var: 1 / 12, range: [0, 1] },
    exponential: { sample: () => -Math.log(1 - Math.random()), mean: 1, var: 1, range: [0, 4] },
    bimodal: {
      sample: () => (Math.random() < 0.5 ? Math.random() * 0.2 : 0.8 + Math.random() * 0.2),
      mean: 0.5,
      var: 0.16 + (1 / 12) * 0.04,
      range: [0, 1],
    },
    dice: { sample: () => 1 + Math.floor(Math.random() * 6), mean: 3.5, var: 35 / 12, range: [0.5, 6.5] },
  };

  const BINS = 64;
  const state = { src: 'uniform', n: 5, running: true };
  let bins = new Float64Array(BINS);
  let count = 0;
  let srcBins = new Float64Array(BINS);

  const canvas = el('clt') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();
  const PAD = { l: 50, r: 30, t: 110, b: 40 };

  function reset() {
    bins = new Float64Array(BINS);
    count = 0;
    // a preview of the source, drawn once per reset instead of every frame
    const s = SOURCES[state.src], [a, b] = s.range;
    srcBins = new Float64Array(BINS);
    for (let i = 0; i < 6000; i++) {
      const bi = Math.max(0, Math.min(BINS - 1, Math.floor(((s.sample() - a) / (b - a)) * BINS)));
      srcBins[bi]++;
    }
  }

  function trial() {
    const s = SOURCES[state.src];
    let sum = 0;
    for (let i = 0; i < state.n; i++) sum += s.sample();
    const [a, b] = s.range;
    const bi = Math.max(0, Math.min(BINS - 1, Math.floor(((sum / state.n - a) / (b - a)) * BINS)));
    bins[bi]++;
    count++;
  }

  function draw() {
    const s = SOURCES[state.src];
    const [a, b] = s.range;
    ctx.clearRect(0, 0, W, H);

    const plotW = W - PAD.l - PAD.r, plotH = H - PAD.t - PAD.b;
    const x0 = PAD.l, yBase = H - PAD.b;
    const xOf = (val: number) => x0 + ((val - a) / (b - a)) * plotW;
    const bw = plotW / BINS;

    ctx.strokeStyle = ink(0.14);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(x0, yBase);
    ctx.lineTo(x0 + plotW, yBase);
    ctx.stroke();
    for (let t = 0; t <= 5; t++) {
      const val = a + ((b - a) * t) / 5;
      label(val.toFixed(1), xOf(val), yBase + 18, 0.3, 'center', 10.5);
    }

    // the source, faint, across the top
    let srcMax = 1;
    for (const v of srcBins) if (v > srcMax) srcMax = v;
    ctx.fillStyle = 'rgba(154,160,172,0.28)';
    for (let i = 0; i < BINS; i++) {
      const h = (srcBins[i] / srcMax) * 64;
      ctx.fillRect(x0 + i * bw, PAD.t - 76 + (64 - h), bw - 0.5, h);
    }
    label('one draw from the source', x0, PAD.t - 84, 0.45, 'left', 10.5);
    label(`the mean of ${state.n} draws`, x0, PAD.t - 4, 0.45, 'left', 10.5);

    // the means, as a density, and the bell the theorem predicts
    const sdMean = Math.sqrt(s.var / state.n);
    const gPeak = 1 / (sdMean * Math.sqrt(2 * Math.PI));
    const binWidth = (b - a) / BINS;
    let histMax = 1e-9;
    for (let i = 0; i < BINS; i++) histMax = Math.max(histMax, count > 0 ? bins[i] / (count * binWidth) : 0);
    const yMax = Math.max(histMax, gPeak) * 1.1;
    const yOf = (d: number) => yBase - (d / yMax) * plotH;

    ctx.fillStyle = 'rgba(124,140,255,0.55)';
    for (let i = 0; i < BINS; i++) {
      if (!bins[i]) continue;
      const y = yOf(bins[i] / (count * binWidth));
      ctx.fillRect(x0 + i * bw, y, bw - 0.6, yBase - y);
    }
    ctx.strokeStyle = BELL;
    ctx.lineWidth = 2.4;
    ctx.beginPath();
    for (let px = 0; px <= plotW; px += 2) {
      const val = a + (px / plotW) * (b - a);
      const d = gPeak * Math.exp(-((val - s.mean) ** 2) / (2 * sdMean * sdMean));
      px === 0 ? ctx.moveTo(x0 + px, yOf(d)) : ctx.lineTo(x0 + px, yOf(d));
    }
    ctx.stroke();

    ctx.strokeStyle = ink(0.4);
    ctx.setLineDash([4, 4]);
    ctx.beginPath();
    ctx.moveTo(xOf(s.mean), PAD.t);
    ctx.lineTo(xOf(s.mean), yBase);
    ctx.stroke();
    ctx.setLineDash([]);
    label(`μ = ${s.mean}`, xOf(s.mean) + 6, PAD.t + 12, 0.5, 'left', 10.5);

    setEq({
      rule: [['\\bar X = \\frac{1}{n}\\sum_i X_i', MEANS], '\\longrightarrow', ['\\mathcal N\\!\\Big(\\mu,\\;\\frac{\\sigma^2}{n}\\Big)', BELL]],
      live: [`n = ${state.n}`, `\\quad\\sigma = ${Math.sqrt(s.var).toFixed(3)}`, [`\\quad\\sigma/\\sqrt n = ${sdMean.toFixed(4)}`, BELL]],
    });
    setResult({
      value: sdMean.toFixed(4),
      colour: BELL,
      status: `${count} means of n = ${state.n} draws so far`,
      note: 'Whatever the source looks like, the means pile into the bell the theorem predicts, and it narrows like 1/√n.',
    });
    setRows({ 'r-count': String(count), 'r-sigma': Math.sqrt(s.var).toFixed(3), 'r-sd': sdMean.toFixed(4) });
  }

  function loop() {
    if (state.running) for (let k = 0; k < 24; k++) trial();
    draw();
    requestAnimationFrame(loop);
  }

  segmented('src', (src) => { state.src = src; reset(); });
  slider('n', (v) => { state.n = v; reset(); });
  transport({ onRun: (running) => (state.running = running), onReset: reset });

  reset();
  loop();
</script>
