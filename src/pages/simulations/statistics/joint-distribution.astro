---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
---

<SimLayout
  areaSlug="statistics"
  title="Joint, Marginals & Conditionals"
  description="Every pair of values gets its own square of probability. Drag a box over the pairs you care about: the squares inside are the joint, each edge stacks up a marginal, and a marginal divided by its total is a conditional."
  shortcuts={['fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="jp"
          width="1000"
          height="600"
          role="img"
          aria-label="A five by five table of probabilities with marginal bars along two edges, a dragged box selecting an event, and the conditional distribution it produces."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'the x range, A', color: '#7c8cff' },
          { label: 'the y range, B', color: '#5eead4' },
          { label: 'the squares you enclosed', color: '#f59e0b' },
        ]}
        hint="Drag a box across the table to choose an event"
      />
      <Result label="P(A and B)" />
    </div>

    <div class="sim-panel">
      <Seg
        id="preset"
        label="How the two are linked"
        attr="p"
        active="1"
        options={[{ value: '0', label: 'opposed' }, { value: '1', label: 'independent' }, { value: '2', label: 'together' }]}
      />
      <Slider id="rho" label="Strength of the link" min={-140} max={140} value={0} display="0.00" hint={['opposed', 'together']} />
      <Seg
        id="given"
        label="Condition on"
        attr="g"
        options={[{ value: 'x', label: 'the x range' }, { value: 'y', label: 'the y range' }]}
      />
      <Readout
        title="All the numbers"
        rows={[
          { id: 'r-pa', label: 'P(A), the columns' },
          { id: 'r-pb', label: 'P(B), the rows' },
          { id: 'r-pab', label: 'P(A and B)' },
          { id: 'r-pp', label: 'P(A) × P(B)' },
          { id: 'r-cond', label: 'P(B | A)' },
          { id: 'r-tot', label: 'everything adds to' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Leave the link at <b>independent</b> and drag a box around. Whatever you
      pick, <b>P(A and B) and P(A)×P(B) come out equal</b>. That equality is the
      definition of independence, not a fact about the world.
    </li>
    <li>
      Look at the bar under a selected column. It is <b>literally that column
      stacked up</b>, one segment per cell, and its full height is P(x): summing a
      variable out is that, and nothing more. The amber part of the stack is the
      slice your box actually kept, so <b>P(A and B) is visible on the margin
      itself</b> as a piece of P(A).
    </li>
    <li>
      Every marginal bar is <b>shorter than one</b>, and all of them together add
      to one. A marginal is a share of the whole table, not a distribution over
      the column. Divide it by its own total and it adds to one again: that is
      the conditional on the right, and the shape never changed, only the scale.
    </li>
    <li>
      The highlighted bars of that conditional add to <b>P(B | A)</b>, which is
      the same P(A and B) you started with, now measured against P(A) instead of
      against the whole table. One box, three readings.
    </li>
    <li>
      Now slide the link towards <b>together</b>. The mass piles onto the
      diagonal, a box on the diagonal holds <b>more</b> than the product predicts,
      and the conditional visibly leans as you slide the box across the columns.
      Under <b>independent</b> it never moves at all: that is what independence
      looks like from here.
    </li>
    <li>
      Push the link to <b>opposed</b>. Now a diagonal box is unusually empty, and
      the product overestimates instead. Dependence has a direction, and the
      product test does not care which.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk, roundRect } from '../../../lib/draw';
  import { el, segmented, slider, result, readout } from '../../../lib/panel';

  const N = 5;
  const XL = ['1', '2', '3', '4', '5'];
  const state = { rho: 0, i0: 2, i1: 3, j0: 1, j1: 2, given: 'x' as 'x' | 'y' };

  const canvas = el('jp') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();
  const XC = '#7c8cff'; // anything about x
  const YC = '#5eead4'; // anything about y
  const EV = '#f59e0b'; // the event you dragged out
  const fmt = (v: number, n = 3) => v.toFixed(n);

  // A joint that starts independent and can be tilted onto either diagonal.
  // p(i,j) ∝ a_i b_j e^{ρ z_i z_j}, so ρ = 0 is exactly independent.
  const A = [0.14, 0.2, 0.3, 0.22, 0.14];
  const B = [0.18, 0.24, 0.26, 0.2, 0.12];
  const z = (i: number) => (i - (N - 1) / 2) / ((N - 1) / 2);
  let P: number[][] = [];
  function build() {
    P = [];
    let s = 0;
    for (let i = 0; i < N; i++) {
      P.push([]);
      for (let j = 0; j < N; j++) {
        const v = A[i] * B[j] * Math.exp(state.rho * z(i) * z(j) * 2.2);
        P[i].push(v);
        s += v;
      }
    }
    for (let i = 0; i < N; i++) for (let j = 0; j < N; j++) P[i][j] /= s;
  }
  const px = (i: number) => P[i].reduce((a, b) => a + b, 0);
  const py = (j: number) => P.reduce((a, r) => a + r[j], 0);
  const total = () => P.reduce((a, r) => a + r.reduce((c, v) => c + v, 0), 0);
  const inA = (i: number) => i >= state.i0 && i <= state.i1;
  const inB = (j: number) => j >= state.j0 && j <= state.j1;
  function sums() {
    let pa = 0, pb = 0, pab = 0;
    for (let i = 0; i < N; i++) if (inA(i)) pa += px(i);
    for (let j = 0; j < N; j++) if (inB(j)) pb += py(j);
    for (let i = 0; i < N; i++) for (let j = 0; j < N; j++) if (inA(i) && inB(j)) pab += P[i][j];
    return { pa, pb, pab };
  }

  /**
   * The conditional: conditioning on the x range leaves a distribution over y
   * (and the other way round). The bars belonging to the event add up to
   * P(B|A), the joint measured against P(A) instead of the whole table.
   */
  function conditional() {
    const { pa, pb } = sums();
    if (state.given === 'x') {
      const d = pa || 1;
      const bars = Array.from({ length: N }, (_, j) => {
        let s = 0;
        for (let i = 0; i < N; i++) if (inA(i)) s += P[i][j];
        return s / d;
      });
      return { bars, keep: inB, given: 'x', over: 'y', denom: pa, name: 'P(B | A)' };
    }
    const d = pb || 1;
    const bars = Array.from({ length: N }, (_, i) => {
      let s = 0;
      for (let j = 0; j < N; j++) if (inB(j)) s += P[i][j];
      return s / d;
    });
    return { bars, keep: inA, given: 'y', over: 'x', denom: pb, name: 'P(A | B)' };
  }

  // --- layout: the table with its marginals on the left, the conditional on the right
  const G = { x: 80, y: 40, cell: 82 };
  const MX = { y: G.y + N * G.cell + 12, h: 60 }; // the x marginal, underneath
  const MY = { x: G.x + N * G.cell + 12, w: 60 }; // the y marginal, on the right
  const COND = { x: 660, y: 120, w: 300, h: 300 };
  const cx = (i: number) => G.x + i * G.cell;
  const cy = (j: number) => G.y + (N - 1 - j) * G.cell; // y grows upward

  function drawTable() {
    let pmax = 0;
    for (let i = 0; i < N; i++) for (let j = 0; j < N; j++) pmax = Math.max(pmax, P[i][j]);

    // the event, as bands across the table
    ctx.fillStyle = 'rgba(124,140,255,0.07)';
    ctx.fillRect(cx(state.i0), G.y, (state.i1 - state.i0 + 1) * G.cell, N * G.cell);
    ctx.fillStyle = 'rgba(94,234,212,0.07)';
    ctx.fillRect(G.x, cy(state.j1), N * G.cell, (state.j1 - state.j0 + 1) * G.cell);

    for (let i = 0; i < N; i++)
      for (let j = 0; j < N; j++) {
        const on = inA(i) && inB(j);
        const s = G.cell * 0.92 * Math.sqrt(P[i][j] / pmax);
        const mx = cx(i) + G.cell / 2, my = cy(j) + G.cell / 2;
        ctx.fillStyle = ink(0.05);
        roundRect(ctx, cx(i) + 2, cy(j) + 2, G.cell - 4, G.cell - 4, 4);
        ctx.fill();
        if (s > 1) {
          ctx.fillStyle = on ? 'rgba(245,158,11,0.85)' : ink(0.3);
          roundRect(ctx, mx - s / 2, my - s / 2, s, s, 3);
          ctx.fill();
        }
        label(P[i][j].toFixed(3).slice(1), mx, my + 4, on ? 1 : 0.55, 'center', 10.5, on ? 'rgba(14,16,20,0.9)' : undefined);
      }

    ctx.strokeStyle = EV;
    ctx.lineWidth = 2;
    roundRect(ctx, cx(state.i0) + 1, cy(state.j1) + 1, (state.i1 - state.i0 + 1) * G.cell - 2, (state.j1 - state.j0 + 1) * G.cell - 2, 5);
    ctx.stroke();

    for (let i = 0; i < N; i++)
      label(XL[i], cx(i) + G.cell / 2, MX.y + MX.h + 20, inA(i) ? 1 : 0.4, 'center', 11, inA(i) ? XC : undefined);
    for (let j = 0; j < N; j++)
      label(XL[j], G.x - 14, cy(j) + G.cell / 2 + 4, inB(j) ? 1 : 0.4, 'right', 11, inB(j) ? YC : undefined);
    label('x', cx(N - 1) + G.cell / 2 + 40, MX.y + MX.h + 20, 0.3, 'left', 11);
    label('y', G.x - 14, G.y - 14, 0.3, 'right', 11);
  }

  /** The two marginals along their edges: a selected column is the column itself stacked up. */
  function drawMarginals() {
    let mx = 0;
    for (let i = 0; i < N; i++) mx = Math.max(mx, px(i), py(i));

    for (let i = 0; i < N; i++) {
      const h = (px(i) / mx) * MX.h;
      if (inA(i)) {
        let acc = 0;
        for (let j = 0; j < N; j++) {
          const seg = (P[i][j] / mx) * MX.h;
          ctx.fillStyle = inB(j) ? 'rgba(245,158,11,0.9)' : 'rgba(124,140,255,0.5)';
          ctx.fillRect(cx(i) + 8, MX.y + MX.h - acc - seg, G.cell - 16, seg);
          acc += seg;
        }
        ctx.strokeStyle = XC;
        ctx.lineWidth = 1.4;
        ctx.strokeRect(cx(i) + 8, MX.y + MX.h - h, G.cell - 16, h);
      } else {
        ctx.fillStyle = ink(0.18);
        roundRect(ctx, cx(i) + 8, MX.y + MX.h - h, G.cell - 16, h, 3);
        ctx.fill();
      }
      label(px(i).toFixed(2).slice(1), cx(i) + G.cell / 2, MX.y + MX.h - h - 5, inA(i) ? 0.9 : 0.35, 'center', 9.5, inA(i) ? XC : undefined);
    }
    label('P(x)', G.x - 14, MX.y + MX.h, 1, 'right', 10.5, XC);

    for (let j = 0; j < N; j++) {
      const w = (py(j) / mx) * MY.w;
      if (inB(j)) {
        let acc = 0;
        for (let i = 0; i < N; i++) {
          const seg = (P[i][j] / mx) * MY.w;
          ctx.fillStyle = inA(i) ? 'rgba(245,158,11,0.9)' : 'rgba(94,234,212,0.5)';
          ctx.fillRect(MY.x + acc, cy(j) + 8, seg, G.cell - 16);
          acc += seg;
        }
        ctx.strokeStyle = YC;
        ctx.lineWidth = 1.4;
        ctx.strokeRect(MY.x, cy(j) + 8, w, G.cell - 16);
      } else {
        ctx.fillStyle = ink(0.18);
        roundRect(ctx, MY.x, cy(j) + 8, w, G.cell - 16, 3);
        ctx.fill();
      }
      label(py(j).toFixed(2).slice(1), MY.x + w + 5, cy(j) + G.cell / 2 + 4, inB(j) ? 0.9 : 0.35, 'left', 9.5, inB(j) ? YC : undefined);
    }
    label('P(y)', MY.x, G.y - 14, 1, 'left', 10.5, YC);
  }

  /** The kept column, rescaled so it is a distribution again. */
  function drawConditional() {
    const C = conditional();
    const gc = C.given === 'x' ? XC : YC;
    label(`the kept ${C.given === 'x' ? 'columns' : 'rows'} ÷ P(${C.given} in ${C.given === 'x' ? 'A' : 'B'}) = ${fmt(C.denom)}`, COND.x, COND.y - 30, 1, 'left', 10.5, gc);
    label(`P(${C.over} | ${C.given}): a distribution again`, COND.x, COND.y - 12, 0.5, 'left', 10.5);

    const cmx = Math.max(...C.bars, 1e-6) * 1.2;
    const cw = COND.w / N;
    let kept = 0;
    C.bars.forEach((v, k) => {
      const on = C.keep(k);
      if (on) kept += v;
      const h = (v / cmx) * COND.h;
      ctx.fillStyle = on ? 'rgba(245,158,11,0.9)' : ink(0.2);
      roundRect(ctx, COND.x + k * cw + 8, COND.y + COND.h - h, cw - 16, h, 3);
      ctx.fill();
      label(v.toFixed(2).slice(1), COND.x + k * cw + cw / 2, COND.y + COND.h - h - 6, on ? 0.95 : 0.4, 'center', 10, on ? EV : undefined);
      label(XL[k], COND.x + k * cw + cw / 2, COND.y + COND.h + 18, on ? 0.8 : 0.3, 'center', 10.5);
    });
    ctx.strokeStyle = ink(0.16);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(COND.x, COND.y + COND.h + 1);
    ctx.lineTo(COND.x + COND.w, COND.y + COND.h + 1);
    ctx.stroke();
    label(C.over, COND.x + COND.w + 12, COND.y + COND.h + 18, 0.3, 'left', 10.5);
    label('all five add to 1', COND.x, COND.y + COND.h + 44, 0.4, 'left', 10.5);
    label(`the amber ones add to ${C.name} = ${fmt(kept)}`, COND.x, COND.y + COND.h + 62, 1, 'left', 10.5, EV);
  }

  function draw() {
    build();
    ctx.clearRect(0, 0, W, H);
    drawTable();
    drawMarginals();
    drawConditional();
    words();
  }

  function words() {
    const { pa, pb, pab } = sums();
    const prod = pa * pb;
    const C = conditional();
    const cond = C.denom > 1e-9 ? pab / C.denom : 0;
    const rel = prod > 1e-9 ? pab / prod : 1;
    const indep = Math.abs(rel - 1) < 0.02;

    setEq({
      rule: [
        ['P(A\\cap B)', EV],
        '= \\displaystyle\\sum_{x\\in A}\\sum_{y\\in B} P(x,y)',
        '\\qquad',
        ['P(x)=\\textstyle\\sum_y P(x,y)', XC],
        '\\qquad',
        ['P(y\\mid x)=\\dfrac{P(x,y)}{P(x)}', EV],
      ],
      live: [
        [`P(A) = ${fmt(pa)}`, XC],
        [`\\quad P(B) = ${fmt(pb)}`, YC],
        [`\\quad P(A\\cap B) = ${fmt(pab)}`, EV],
        [`\\quad ${C.name.replace(' | ', '\\mid ')} = ${fmt(cond)}`, EV],
      ],
    });
    setResult({
      value: fmt(pab),
      colour: EV,
      status: indep
        ? `P(A) × P(B) = ${fmt(prod)}, the same: A and B are independent here`
        : `P(A) × P(B) = ${fmt(prod)}: ${rel.toFixed(2)}× ${rel > 1 ? 'more' : 'less'} than the product`,
      note: indep
        ? 'The product agrees with the joint, which is exactly what independence means. The conditional does not move as you slide the box across.'
        : 'The product disagrees with the joint, so knowing one of the two numbers tells you something about the other.',
    });
    el('r-cond').previousElementSibling!.textContent = C.name;
    setRows({
      'r-pa': fmt(pa),
      'r-pb': fmt(pb),
      'r-pab': fmt(pab),
      'r-pp': fmt(prod),
      'r-cond': fmt(cond),
      'r-tot': fmt(total()),
    });
  }

  // --- interaction ---------------------------------------------------------
  const local = (e: PointerEvent) => {
    const r = canvas.getBoundingClientRect();
    return { x: ((e.clientX - r.left) / r.width) * W, y: ((e.clientY - r.top) / r.height) * H };
  };
  const clampi = (v: number) => Math.max(0, Math.min(N - 1, v));
  const cellAt = (p: { x: number; y: number }) => ({
    i: clampi(Math.floor((p.x - G.x) / G.cell)),
    j: clampi(N - 1 - Math.floor((p.y - G.y) / G.cell)),
  });
  let anchor: { i: number; j: number } | null = null;
  canvas.addEventListener('pointerdown', (e) => {
    const p = local(e);
    if (p.x < G.x - 6 || p.x > G.x + N * G.cell + 6) return;
    if (p.y < G.y - 6 || p.y > G.y + N * G.cell + 6) return;
    try { canvas.setPointerCapture(e.pointerId); } catch { /* synthetic pointers are fine to ignore */ }
    anchor = cellAt(p);
    state.i0 = state.i1 = anchor.i;
    state.j0 = state.j1 = anchor.j;
    draw();
  });
  canvas.addEventListener('pointermove', (e) => {
    if (!anchor) return;
    const c = cellAt(local(e));
    state.i0 = Math.min(anchor.i, c.i);
    state.i1 = Math.max(anchor.i, c.i);
    state.j0 = Math.min(anchor.j, c.j);
    state.j1 = Math.max(anchor.j, c.j);
    draw();
  });
  const drop = () => (anchor = null);
  canvas.addEventListener('pointerup', drop);
  canvas.addEventListener('pointercancel', drop);

  const presets = segmented('preset', (p) => setRho([-1, 0, 1][+p]));
  const setRhoSlider = slider('rho', (v) => { state.rho = v / 100; presets.clear(); draw(); }, (v) => (v / 100).toFixed(2));
  function setRho(v: number) {
    state.rho = v;
    setRhoSlider(Math.round(v * 100));
    draw();
  }
  segmented('given', (g) => { state.given = g as 'x' | 'y'; draw(); });

  draw();
</script>

<style>
  #jp {
    cursor: crosshair;
    touch-action: none;
  }
</style>
