---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';

const TP = '#2dd4bf', FP = '#f87171';
---

<SimLayout
  areaSlug="statistics"
  title="Bayes' Theorem"
  description="A 90% accurate test can still be wrong most of the time it says positive. A thousand people as dots show why."
  shortcuts={['fullscreen']}
  standard
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="bayes"
          width="1000"
          height="440"
          role="img"
          aria-label="One thousand dots, one per person, coloured by whether they are sick and whether the test caught them."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'truly sick, caught', color: TP },
          { label: 'healthy, false alarm', color: FP },
          { label: 'sick, missed', color: 'rgba(45,212,191,0.4)' },
          { label: 'healthy, cleared', color: 'rgba(130,140,155,0.4)' },
        ]}
      />
      <Result label="P(disease | positive)" />
    </div>

    <div class="sim-panel">
      <Seg
        id="view"
        label="Show"
        options={[{ value: 'all', label: 'Everyone' }, { value: 'pos', label: 'Positive tests only' }]}
      />
      <Slider id="pr" label="Prevalence (base rate)" min={1} max={500} value={10} display="1.0%" />
      <Slider id="se" label="Sensitivity (true positive)" min={50} max={100} value={90} display="90%" />
      <Slider id="sp" label="Specificity (true negative)" min={50} max={100} value={90} display="90%" />
      <Readout
        rows={[
          { id: 'r-post', label: 'P(disease | positive)' },
          { id: 'r-postneg', label: 'P(disease | negative)' },
        ]}
      />
      <div class="control">
        <span class="section-label">Per 1,000 people</span>
        <div class="tally" id="tally"></div>
      </div>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Start at <b>1% prevalence</b> with a 90% / 90% test, then switch to
      <b>Positive tests only</b>. Barely a tenth of the dots are teal: a positive
      result means only about an <b>8% chance</b> of actually being sick.
    </li>
    <li>
      Why? There are so many more healthy people that even a small false-positive
      rate produces a <b>flood of red</b>. The answer depends on the
      <b>base rate</b>, not just the test's accuracy.
    </li>
    <li>
      Slide prevalence up and watch the positive dots flip from mostly-red to
      mostly-teal. Then push <b>specificity</b> toward 100%: shrinking that tiny
      false-positive rate is what really moves the posterior.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { segmented, slider, result, readout, el } from '../../../lib/panel';

  const state = { prev: 0.01, sens: 0.9, spec: 0.9, view: 'all' };

  const COL = {
    tp: '#2dd4bf',
    fp: '#f87171',
    fnDark: 'rgba(45,212,191,0.30)',
    tnDark: 'rgba(130,140,155,0.28)',
  };
  const COLS = 50, ROWS = 20, N = COLS * ROWS; // 1000 people

  const canvas = el('bayes') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  function counts() {
    const diseased = state.prev * N;
    const tp = Math.round(diseased * state.sens);
    const fn = Math.round(diseased * (1 - state.sens));
    const healthy = N - Math.round(diseased);
    const fp = Math.round(healthy * (1 - state.spec));
    return { tp, fn, fp, tn: Math.max(0, N - tp - fn - fp) };
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    const { tp, fn, fp, tn } = counts();

    // Positives (tp, fp) come first so they form one contiguous block that
    // reads like a bar chart; the negatives fade behind them.
    const seq: string[] = [];
    const push = (n: number, c: string) => { for (let i = 0; i < n; i++) seq.push(c); };
    push(tp, COL.tp);
    push(fp, COL.fp);
    if (state.view === 'all') {
      push(fn, COL.fnDark);
      push(tn, COL.tnDark);
    }

    const cell = 18, r = 5.5;
    const gx0 = (W - COLS * cell) / 2, gy0 = (H - ROWS * cell) / 2;
    for (let i = 0; i < seq.length; i++) {
      const cx = gx0 + Math.floor(i / ROWS) * cell + cell / 2;
      const cy = gy0 + (i % ROWS) * cell + cell / 2;
      ctx.fillStyle = seq[i];
      ctx.beginPath();
      ctx.arc(cx, cy, r, 0, Math.PI * 2);
      ctx.fill();
    }

    const tpA = state.prev * state.sens;
    const fpA = (1 - state.prev) * (1 - state.spec);
    const post = tpA + fpA > 0 ? tpA / (tpA + fpA) : 0;
    const fnA = state.prev * (1 - state.sens);
    const tnA = (1 - state.prev) * state.spec;
    const postNeg = fnA + tnA > 0 ? fnA / (fnA + tnA) : 0;

    const T = (x: string) => `\\textcolor{${COL.tp}}{${x}}`;
    const F = (x: string) => `\\textcolor{${COL.fp}}{${x}}`;
    setEq({
      rule: [
        'P(D\\mid +) =',
        `\\dfrac{${T('P(+\\mid D)\\,P(D)')}}{${T('P(+\\mid D)P(D)')}+${F('P(+\\mid\\lnot D)P(\\lnot D)')}}`,
      ],
      live: [
        `P(D\\mid +) = ${(post * 100).toFixed(1)}\\%`,
        `\\quad = \\dfrac{${T(tpA.toFixed(4))}}{${T(tpA.toFixed(4))}+${F(fpA.toFixed(4))}}`,
      ],
    });
    setResult({
      value: `${(post * 100).toFixed(1)}%`,
      colour: post >= 0.5 ? COL.tp : COL.fp,
      status: `${tp} of the ${tp + fp} positive tests are truly sick`,
      note: 'The false alarms are drawn from the huge healthy group, which is how they can outnumber the true catches.',
    });
    setRows({
      'r-post': `${(post * 100).toFixed(1)}%`,
      'r-postneg': `${(postNeg * 100).toFixed(2)}%`,
    });
    el('tally').innerHTML =
      `<span class="t tp">${tp} true +</span>` +
      `<span class="t fp">${fp} false +</span>` +
      `<span class="t fn">${fn} false −</span>` +
      `<span class="t tn">${tn} true −</span>`;
  }

  segmented('view', (v) => { state.view = v; draw(); });
  slider('pr', (v) => { state.prev = v / 1000; draw(); }, (v) => `${(v / 10).toFixed(1)}%`);
  slider('se', (v) => { state.sens = v / 100; draw(); }, (v) => `${v}%`);
  slider('sp', (v) => { state.spec = v / 100; draw(); }, (v) => `${v}%`);

  draw();
</script>

<style>
  .tally {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }
  .tally .t {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 5px 8px;
    border-radius: 6px;
    border-left: 3px solid;
    color: var(--text);
  }
  .tally .tp {
    border-color: #2dd4bf;
    background: rgba(45, 212, 191, 0.1);
  }
  .tally .fp {
    border-color: #f87171;
    background: rgba(248, 113, 113, 0.1);
  }
  .tally .fn {
    border-color: rgba(45, 212, 191, 0.5);
    color: var(--text-muted);
    background: var(--surface-2);
  }
  .tally .tn {
    border-color: rgba(130, 140, 155, 0.5);
    color: var(--text-muted);
    background: var(--surface-2);
  }
</style>
