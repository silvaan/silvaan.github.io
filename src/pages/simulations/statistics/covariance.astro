---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Checks from '../../../components/sim/Checks.astro';
import Transport from '../../../components/sim/Transport.astro';
import Actions from '../../../components/sim/Actions.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="statistics"
  title="Covariance Matrix"
  description="Every point and the mean are two corners of a rectangle. Up-right and down-left of the mean it counts as positive, the other two corners as negative, and the covariance is the average of all those signed areas. Put it beside the two variances and you have the matrix."
  shortcuts={['reset', 'fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="cov"
          width="1000"
          height="600"
          role="img"
          aria-label="Left: a scatter of points, each joined to the mean by a rectangle shaded by the sign of its area. Right: the covariance matrix, the positive and negative areas that make up its off-diagonal entry, and the correlation on a scale from −1 to 1."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'positive rectangle: both above or both below the mean', color: '#5eead4' },
          { label: 'negative rectangle: one above, one below', color: '#f9736a' },
        ]}
        hint="Hover a point to see its rectangle · drag a point to move it"
      />
      <Result label="cov(x, y)" />
    </div>

    <div class="sim-panel">
      <Seg
        id="data"
        label="Data"
        attr="d"
        options={[
          { value: 'rise', label: 'Rising' },
          { value: 'fall', label: 'Falling' },
          { value: 'none', label: 'No relation' },
          { value: 'curve', label: 'Curved' },
        ]}
      />
      <Slider id="rho" label="Correlation in the source" min={-100} max={100} value={70} display="0.70" hint={['falling', 'rising']} />
      <Slider id="sx" label="Stretch x (change its units)" min={50} max={300} value={100} display="×1.00" />
      <Slider id="n" label="Points" min={10} max={200} value={70} />
      <Actions>
        <button type="button" class="btn ghost" id="resample">New sample</button>
      </Actions>
      <Transport run={false} />
      <Checks
        label="Show"
        items={[
          { id: 'rects', label: 'The rectangles to the mean', checked: true },
          { id: 'ellipse', label: 'The spread ellipse', checked: true },
        ]}
      />
      <Readout
        title="Values"
        rows={[
          { id: 'r-mean', label: 'mean (x̄, ȳ)' },
          { id: 'r-sd', label: 'σx, σy' },
          { id: 'r-pos', label: 'positive area / n' },
          { id: 'r-neg', label: 'negative area / n' },
          { id: 'r-rho', label: 'correlation ρ' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Hover a point. Its rectangle runs from the point to the mean, and its area
      (x − x̄)(y − ȳ) is <b>positive</b> up-right or down-left of the mean and
      <b>negative</b> otherwise. cov(x, y) is the average of all of them.
      <Try id="rise" />
    </li>
    <li>
      On <b>Falling</b> the red rectangles outweigh the teal ones and cov turns
      negative. With <b>No relation</b> they cancel, and cov sits near zero.
      <Try id="fall" label="Falling" /> <Try id="none" label="No relation" />
    </li>
    <li>
      The diagonal is the same idea with x against itself: the average square
      (x − x̄)², which is the variance. Stretch x and var x grows by the square,
      cov grows by the stretch, but <b>ρ does not move</b>: correlation has no
      units. <Try id="stretch" />
    </li>
    <li>
      On <b>Curved</b>, y is decided by x completely, yet cov ≈ 0. The
      rectangles on the left cancel the ones on the right: covariance only
      sees straight-line trends. <Try id="curve" />
    </li>
    <li>
      The ellipse's long and short axes are the eigenvectors of this matrix,
      which is exactly where <a href="/simulations/machine-learning/pca">PCA</a>
      starts.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk, fixed } from '../../../lib/draw';
  import { el, segmented, slider, check, result, readout, tries } from '../../../lib/panel';

  // cov(x, y) is the average signed area of the rectangles between each point
  // and the mean. The page draws those rectangles and adds them up.
  type P = [number, number];
  const DATA = '#7c8cff', POS = '#5eead4', NEG = '#f9736a', VX = '#fbbf24', VY = '#c4b5fd';
  const MAXN = 200;
  const view = { mode: 'rise', rho: 0.7, sx: 1, n: 70, rects: true, ellipse: true };
  let seed = 11;
  let z1: number[] = [], z2: number[] = [];
  let pts: P[] = [];
  let hover = -1, drag = -1;

  const canvas = el('cov') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink } = stageInk(canvas);
  const { label, textWidth } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  const PLOT = { x: 16, y: 16, w: 612, h: H - 32 };
  const COL = { x: 668, w: 302 };
  let O = { x: PLOT.x + PLOT.w / 2, y: PLOT.y + PLOT.h / 2 };
  let UNIT = 80;
  const toPx = (x: number, y: number) => ({ px: O.x + x * UNIT, py: O.y - y * UNIT });

  // --- data ---------------------------------------------------------------------
  /** Fresh standard-normal draws; every setting is built from these same ones, so sliders move points smoothly. */
  function draws() {
    let s = seed;
    const rnd = () => { s = (s * 1664525 + 1013904223) >>> 0; return s / 4294967296; };
    const gauss = () => Math.sqrt(-2 * Math.log(Math.max(1e-9, rnd()))) * Math.cos(2 * Math.PI * rnd());
    z1 = Array.from({ length: MAXN }, gauss);
    z2 = Array.from({ length: MAXN }, gauss);
  }
  function build() {
    const r = view.rho, k = Math.sqrt(Math.max(0, 1 - r * r));
    pts = [];
    for (let i = 0; i < view.n; i++) {
      const x = z1[i];
      // a parabola, symmetric about the mean of x, so the two halves cancel
      const y = view.mode === 'curve' ? 0.55 * (x * x - 1) + 0.15 * z2[i] : r * x + k * z2[i];
      pts.push([1.5 + view.sx * x, 1 + y]);
    }
  }

  function stats(ps: P[]) {
    const n = ps.length;
    let mx = 0, my = 0;
    for (const [x, y] of ps) { mx += x; my += y; }
    mx /= n; my /= n;
    let sxx = 0, syy = 0, pos = 0, neg = 0;
    for (const [x, y] of ps) {
      sxx += (x - mx) ** 2; syy += (y - my) ** 2;
      const a = (x - mx) * (y - my);
      if (a > 0) pos += a; else neg -= a;
    }
    const vx = sxx / n, vy = syy / n, cov = (pos - neg) / n;
    return { n, mx, my, vx, vy, cov, pos: pos / n, neg: neg / n, rho: vx > 0 && vy > 0 ? cov / Math.sqrt(vx * vy) : 0 };
  }

  /**
   * Equal scale on both axes. A new sample or preset refits; stretching x only
   * ever zooms out, so the stretch is seen as the cloud widening.
   */
  function fit(grow = true) {
    let x0 = Infinity, x1 = -Infinity, y0 = Infinity, y1 = -Infinity;
    for (const [x, y] of pts) { x0 = Math.min(x0, x); x1 = Math.max(x1, x); y0 = Math.min(y0, y); y1 = Math.max(y1, y); }
    x0 = Math.min(x0, 0); y0 = Math.min(y0, 0);
    const u = Math.max(12, Math.min(150, (PLOT.w - 60) / Math.max(1e-6, x1 - x0), (PLOT.h - 60) / Math.max(1e-6, y1 - y0)));
    if (!grow && u >= UNIT) return;
    UNIT = u;
    O = { x: PLOT.x + PLOT.w / 2 - ((x0 + x1) / 2) * UNIT, y: PLOT.y + PLOT.h / 2 + ((y0 + y1) / 2) * UNIT };
  }

  // --- drawing ------------------------------------------------------------------
  const rgba = (hex: string, a: number) => `rgba(${parseInt(hex.slice(1, 3), 16)},${parseInt(hex.slice(3, 5), 16)},${parseInt(hex.slice(5, 7), 16)},${a})`;

  function drawScatter(s: ReturnType<typeof stats>) {
    ctx.save();
    ctx.beginPath(); ctx.rect(PLOT.x, PLOT.y, PLOT.w, PLOT.h); ctx.clip();
    // grid with its numbers, so a change of units shows up as numbers too
    const step = UNIT < 30 ? 5 : UNIT < 60 ? 2 : 1;
    const ix0 = Math.ceil((PLOT.x - O.x) / UNIT / step) * step, ix1 = Math.floor((PLOT.x + PLOT.w - O.x) / UNIT);
    const iy0 = Math.ceil((O.y - PLOT.y - PLOT.h) / UNIT / step) * step, iy1 = Math.floor((O.y - PLOT.y) / UNIT);
    ctx.strokeStyle = ink(0.06);
    ctx.lineWidth = 1;
    ctx.beginPath();
    for (let i = ix0; i <= ix1; i += step) { const p = toPx(i, 0); ctx.moveTo(p.px, PLOT.y); ctx.lineTo(p.px, PLOT.y + PLOT.h); }
    for (let i = iy0; i <= iy1; i += step) { const p = toPx(0, i); ctx.moveTo(PLOT.x, p.py); ctx.lineTo(PLOT.x + PLOT.w, p.py); }
    ctx.stroke();
    ctx.strokeStyle = ink(0.18);
    ctx.beginPath(); ctx.moveTo(PLOT.x, O.y); ctx.lineTo(PLOT.x + PLOT.w, O.y); ctx.moveTo(O.x, PLOT.y); ctx.lineTo(O.x, PLOT.y + PLOT.h); ctx.stroke();
    for (let i = ix0; i <= ix1; i += step) if (i) { const p = toPx(i, 0); label(String(i).replace('-', '−'), p.px, Math.min(PLOT.y + PLOT.h - 4, Math.max(PLOT.y + 12, O.y + 14)), 0.3, 'center', 10); }
    for (let i = iy0; i <= iy1; i += step) if (i) { const p = toPx(0, i); label(String(i).replace('-', '−'), Math.min(PLOT.x + PLOT.w - 4, Math.max(PLOT.x + 22, O.x - 6)), p.py + 4, 0.3, 'right', 10); }

    // the mean splits the plane into four corners: two that count as plus, two as minus
    const m = toPx(s.mx, s.my);
    ctx.fillStyle = rgba(POS, 0.035);
    ctx.fillRect(m.px, PLOT.y, PLOT.x + PLOT.w - m.px, m.py - PLOT.y);
    ctx.fillRect(PLOT.x, m.py, m.px - PLOT.x, PLOT.y + PLOT.h - m.py);
    ctx.fillStyle = rgba(NEG, 0.035);
    ctx.fillRect(PLOT.x, PLOT.y, m.px - PLOT.x, m.py - PLOT.y);
    ctx.fillRect(m.px, m.py, PLOT.x + PLOT.w - m.px, PLOT.y + PLOT.h - m.py);
    ctx.strokeStyle = ink(0.4);
    ctx.setLineDash([5, 5]);
    ctx.beginPath(); ctx.moveTo(m.px, PLOT.y); ctx.lineTo(m.px, PLOT.y + PLOT.h); ctx.moveTo(PLOT.x, m.py); ctx.lineTo(PLOT.x + PLOT.w, m.py); ctx.stroke();
    ctx.setLineDash([]);
    label('+', PLOT.x + PLOT.w - 14, PLOT.y + 22, 0.8, 'center', 18, POS);
    label('+', PLOT.x + 14, PLOT.y + PLOT.h - 10, 0.8, 'center', 18, POS);
    label('−', PLOT.x + 14, PLOT.y + 22, 0.8, 'center', 18, NEG);
    label('−', PLOT.x + PLOT.w - 14, PLOT.y + PLOT.h - 10, 0.8, 'center', 18, NEG);

    if (view.rects)
      for (const [x, y] of pts) {
        const p = toPx(x, y);
        const col = (x - s.mx) * (y - s.my) >= 0 ? POS : NEG;
        ctx.fillStyle = rgba(col, 0.05);
        ctx.strokeStyle = rgba(col, 0.22);
        ctx.lineWidth = 1;
        ctx.beginPath(); ctx.rect(Math.min(p.px, m.px), Math.min(p.py, m.py), Math.abs(p.px - m.px), Math.abs(p.py - m.py)); ctx.fill(); ctx.stroke();
      }

    if (view.ellipse) {
      // two standard deviations along the eigenvectors of C
      const h = (s.vx + s.vy) / 2, r = Math.hypot((s.vx - s.vy) / 2, s.cov);
      const th = 0.5 * Math.atan2(2 * s.cov, s.vx - s.vy);
      ctx.strokeStyle = ink(0.45);
      ctx.lineWidth = 1.4;
      ctx.beginPath();
      ctx.ellipse(m.px, m.py, 2 * Math.sqrt(h + r) * UNIT, 2 * Math.sqrt(Math.max(0, h - r)) * UNIT, -th, 0, Math.PI * 2);
      ctx.stroke();
    }

    const focus = drag >= 0 ? drag : hover;
    pts.forEach(([x, y], i) => {
      const p = toPx(x, y);
      ctx.fillStyle = DATA;
      ctx.strokeStyle = 'rgba(13,14,18,0.6)';
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.arc(p.px, p.py, i === focus ? 5.5 : 4, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
    });
    ctx.fillStyle = ink(0.95);
    ctx.beginPath(); ctx.arc(m.px, m.py, 4.5, 0, Math.PI * 2); ctx.fill();

    if (focus >= 0 && focus < pts.length) {
      const [x, y] = pts[focus];
      const p = toPx(x, y);
      const a = (x - s.mx) * (y - s.my), col = a >= 0 ? POS : NEG;
      ctx.fillStyle = rgba(col, 0.25);
      ctx.strokeStyle = col;
      ctx.lineWidth = 2;
      ctx.beginPath(); ctx.rect(Math.min(p.px, m.px), Math.min(p.py, m.py), Math.abs(p.px - m.px), Math.abs(p.py - m.py)); ctx.fill(); ctx.stroke();
      const text = `${fixed(x - s.mx)} × ${fixed(y - s.my)} = ${a >= 0 ? '+' : '−'}${Math.abs(a).toFixed(2)}`;
      const w = textWidth(text, 12) + 14;
      // beside the point, on the side away from the mean
      let tx = p.px + (p.px >= m.px ? 12 : -12 - w), ty = p.py + (p.py <= m.py ? -14 : 22);
      tx = Math.max(PLOT.x + 4, Math.min(PLOT.x + PLOT.w - w - 4, tx));
      ty = Math.max(PLOT.y + 16, Math.min(PLOT.y + PLOT.h - 6, ty));
      ctx.fillStyle = 'rgba(13,14,18,0.85)';
      ctx.fillRect(tx, ty - 14, w, 20);
      label(text, tx + 7, ty + 0.5, 1, 'left', 12, col);
    }
    ctx.restore();
    label('x̄, ȳ', m.px + 8, m.py - 8, 0.75, 'left', 11);
  }

  /** The matrix itself, entry by entry in the colours of what they measure. */
  function drawMatrix(s: ReturnType<typeof stats>) {
    const top = 34;
    label('the covariance matrix C', COL.x, top, 0.6, 'left', 12);
    const bx = COL.x + 20, by = top + 18, bw = 262, bh = 104;
    ctx.strokeStyle = ink(0.6);
    ctx.lineWidth = 1.6;
    for (const [x, d] of [[bx, 1], [bx + bw, -1]] as const) {
      ctx.beginPath(); ctx.moveTo(x + d * 9, by); ctx.lineTo(x, by); ctx.lineTo(x, by + bh); ctx.lineTo(x + d * 9, by + bh); ctx.stroke();
    }
    const cc = s.cov >= 0 ? POS : NEG;
    const cells: [string, string, string, number, number][] = [
      ['var x', s.vx.toFixed(2), VX, 0, 0],
      ['cov', s.cov.toFixed(2).replace('-', '−'), cc, 1, 0],
      ['cov', s.cov.toFixed(2).replace('-', '−'), cc, 0, 1],
      ['var y', s.vy.toFixed(2), VY, 1, 1],
    ];
    for (const [name, v, col, c, r] of cells) {
      const cx = bx + bw * (c ? 0.73 : 0.27), cy = by + bh * (r ? 0.74 : 0.3);
      label(v, cx, cy + 6, 1, 'center', 19, col);
      label(name, cx, cy + 22, 0.4, 'center', 10.5);
    }
  }

  /** cov as the teal areas minus the red ones, each divided by n. */
  function drawBalance(s: ReturnType<typeof stats>) {
    const top = 196;
    label('cov = average signed area', COL.x, top, 0.6, 'left', 12);
    label('teal minus red, over n', COL.x, top + 16, 0.34, 'left', 11);
    const mid = COL.x + COL.w / 2, half = COL.w / 2 - 6;
    const big = Math.max(s.pos, s.neg, 1e-6);
    const k = half / big;
    const y = top + 34, h = 18;
    ctx.fillStyle = rgba(POS, 0.65);
    ctx.fillRect(mid, y, s.pos * k, h);
    ctx.fillStyle = rgba(NEG, 0.65);
    ctx.fillRect(mid - s.neg * k, y, s.neg * k, h);
    ctx.strokeStyle = ink(0.5);
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(mid, y - 4); ctx.lineTo(mid, y + h + 4); ctx.stroke();
    label(`−${s.neg.toFixed(2)}`, mid - 6, y + h + 16, 0.9, 'right', 11, NEG);
    label(`+${s.pos.toFixed(2)}`, mid + 6, y + h + 16, 0.9, 'left', 11, POS);
    // the net: what is left when the two sides cancel
    const ny = y + h + 32;
    const net = s.cov * k;
    const col = s.cov >= 0 ? POS : NEG;
    ctx.fillStyle = col;
    ctx.fillRect(Math.min(mid, mid + net), ny, Math.abs(net), 8);
    ctx.beginPath(); ctx.arc(mid + net, ny + 4, 5, 0, Math.PI * 2); ctx.fill();
    label(`net ${s.cov >= 0 ? '+' : '−'}${Math.abs(s.cov).toFixed(2)} = cov`, mid, ny + 28, 1, 'center', 11.5, col);
  }

  /** ρ = cov / (σx σy): the same sign, with the units divided out. */
  function drawRho(s: ReturnType<typeof stats>) {
    const top = 352;
    label('correlation ρ = cov/(σx σy)', COL.x, top, 0.6, 'left', 12);
    label('cov with the units taken out', COL.x, top + 16, 0.34, 'left', 11);
    const x0 = COL.x + 8, x1 = COL.x + COL.w - 8, y = top + 44;
    const at = (r: number) => x0 + ((r + 1) / 2) * (x1 - x0);
    const grad = ctx.createLinearGradient(x0, 0, x1, 0);
    grad.addColorStop(0, rgba(NEG, 0.6)); grad.addColorStop(0.5, ink(0.15)); grad.addColorStop(1, rgba(POS, 0.6));
    ctx.fillStyle = grad;
    ctx.fillRect(x0, y - 3, x1 - x0, 6);
    for (const r of [-1, 0, 1]) {
      ctx.strokeStyle = ink(0.4);
      ctx.beginPath(); ctx.moveTo(at(r), y - 8); ctx.lineTo(at(r), y + 8); ctx.stroke();
      label(r === -1 ? '−1' : String(r), at(r), y + 22, 0.4, 'center', 10.5);
    }
    const col = s.rho >= 0 ? POS : NEG;
    ctx.fillStyle = col;
    ctx.strokeStyle = ink(0.9);
    ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.arc(at(s.rho), y, 7, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
    label(s.rho.toFixed(2).replace('-', '−'), at(s.rho), y - 14, 1, 'center', 12, col);

    // the two spreads it divides by
    const sy = y + 54;
    label(`σx = ${Math.sqrt(s.vx).toFixed(2)}`, COL.x, sy, 0.95, 'left', 11.5, VX);
    label(`σy = ${Math.sqrt(s.vy).toFixed(2)}`, COL.x + COL.w / 2, sy, 0.95, 'left', 11.5, VY);
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    const s = stats(pts);
    drawScatter(s);
    drawMatrix(s);
    drawBalance(s);
    drawRho(s);

    const cc = s.cov >= 0 ? POS : NEG;
    setEq({
      rule: [
        // the matrix spans several coloured parts; the open brace makes the line set as one formula
        '{C = \\begin{pmatrix}',
        ['\\operatorname{var} x', VX], '&', ['\\operatorname{cov}', POS], '\\\\',
        ['\\operatorname{cov}', POS], '&', ['\\operatorname{var} y', VY],
        '\\end{pmatrix}},\\quad',
        ['\\operatorname{cov}(x,y) = \\tfrac1n \\sum_i (x_i-\\bar x)(y_i-\\bar y)', POS],
      ],
      live: [
        [`\\operatorname{cov} = ${s.pos.toFixed(2)} - ${s.neg.toFixed(2)} = ${s.cov.toFixed(3)}`, cc],
        [`\\quad \\rho = \\frac{${s.cov.toFixed(2)}}{${Math.sqrt(s.vx).toFixed(2)}\\cdot ${Math.sqrt(s.vy).toFixed(2)}} = ${s.rho.toFixed(2)}`, cc],
      ],
    });
    const strength = Math.abs(s.rho) > 0.7 ? 'strongly' : Math.abs(s.rho) > 0.3 ? 'loosely' : '';
    setResult({
      value: s.cov.toFixed(3),
      colour: Math.abs(s.rho) < 0.1 ? undefined : cc,
      status:
        Math.abs(s.rho) < 0.1
          ? `ρ = ${s.rho.toFixed(2)}: the teal and red rectangles nearly cancel`
          : `ρ = ${s.rho.toFixed(2)}: x and y ${s.cov > 0 ? 'rise' : 'move opposite'} ${strength} together`,
      note:
        view.mode === 'curve'
          ? 'y is fixed by x almost exactly, yet cov is near zero: the left half of the curve cancels the right. Covariance only sees straight-line trends.'
          : view.sx !== 1
            ? `x is stretched ×${view.sx.toFixed(2)}: var x grows by the square, cov by the stretch, and ρ stays where it was.`
            : 'Each point adds the area of its rectangle to the mean; cov is the average, signs included.',
    });
    setRows({
      'r-mean': `${s.mx.toFixed(2)}, ${s.my.toFixed(2)}`,
      'r-sd': `${Math.sqrt(s.vx).toFixed(2)}, ${Math.sqrt(s.vy).toFixed(2)}`,
      'r-pos': s.pos.toFixed(3),
      'r-neg': s.neg.toFixed(3),
      'r-rho': s.rho.toFixed(3),
    });
  }

  // --- controls -----------------------------------------------------------------
  const PRESET: Record<string, number> = { rise: 0.7, fall: -0.7, none: 0, curve: 0 };
  const setRho = slider('rho', (v) => {
    view.rho = v / 100;
    if (view.mode === 'curve') { view.mode = 'custom'; datas.clear(); }
    build(); draw();
  }, (v) => (v / 100).toFixed(2).replace('-', '−'));
  const setSx = slider('sx', (v) => { view.sx = v / 100; build(); fit(false); draw(); }, (v) => `×${(v / 100).toFixed(2)}`);
  const setN = slider('n', (v) => { view.n = v; hover = -1; build(); draw(); });
  check('rects', (on) => { view.rects = on; draw(); });
  check('ellipse', (on) => { view.ellipse = on; draw(); });

  function load(kind: string) {
    view.mode = kind;
    view.rho = PRESET[kind];
    setRho(Math.round(view.rho * 100));
    build();
    fit();
    draw();
  }
  const datas = segmented('data', load);
  el('resample').addEventListener('click', () => { seed = (seed * 48271 + 13) % 2147483647; draws(); build(); fit(); draw(); });
  el('reset').addEventListener('click', () => {
    seed = 11; draws();
    view.sx = 1; setSx(100);
    view.n = 70; setN(70);
    datas.select('rise');
    load('rise');
  });

  function show(kind: string, sx = 1) {
    datas.select(kind);
    view.sx = sx; setSx(Math.round(sx * 100));
    load(kind);
  }
  tries({
    rise: () => {
      show('rise');
      // point at the one with the biggest rectangle
      const s = stats(pts);
      let best = 0;
      pts.forEach(([x, y], i) => { if ((x - s.mx) * (y - s.my) > (pts[best][0] - s.mx) * (pts[best][1] - s.my)) best = i; });
      hover = best;
      draw();
    },
    fall: () => show('fall'),
    none: () => show('none'),
    stretch: () => {
      show('rise');
      const start = performance.now();
      const tick = (now: number) => {
        const p = Math.min(1, (now - start) / 1400);
        view.sx = 1 + 1.5 * p * p * (3 - 2 * p);
        setSx(Math.round(view.sx * 100));
        build(); fit(false); draw();
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    },
    curve: () => show('curve'),
  });

  // --- hover and drag -----------------------------------------------------------
  const local = (e: PointerEvent) => {
    const r = canvas.getBoundingClientRect();
    return { x: ((e.clientX - r.left) / r.width) * W, y: ((e.clientY - r.top) / r.height) * H };
  };
  function nearest(p: { x: number; y: number }) {
    let best = -1, bd = 12;
    pts.forEach(([x, y], i) => { const q = toPx(x, y), d = Math.hypot(q.px - p.x, q.py - p.y); if (d < bd) { bd = d; best = i; } });
    return best;
  }
  canvas.addEventListener('pointerdown', (e) => {
    const i = nearest(local(e));
    if (i < 0) return;
    drag = i;
    view.mode = 'custom';
    datas.clear();
    canvas.setPointerCapture(e.pointerId);
    draw();
  });
  canvas.addEventListener('pointermove', (e) => {
    const p = local(e);
    if (drag >= 0) {
      pts[drag] = [(p.x - O.x) / UNIT, (O.y - p.y) / UNIT];
      draw();
      return;
    }
    const i = nearest(p);
    canvas.style.cursor = i >= 0 ? 'grab' : 'default';
    if (i !== hover) { hover = i; draw(); }
  });
  const stop = () => { if (drag >= 0) { hover = drag; drag = -1; draw(); } };
  canvas.addEventListener('pointerup', stop);
  canvas.addEventListener('pointercancel', stop);
  canvas.addEventListener('pointerleave', () => { if (drag < 0 && hover >= 0) { hover = -1; draw(); } });

  draws();
  build();
  fit();
  draw();
</script>

<style>
  #cov {
    touch-action: none;
  }
</style>
