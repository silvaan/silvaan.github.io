---
import SimLayout from '../../../layouts/SimLayout.astro';
import Slider from '../../../components/sim/Slider.astro';
import Actions from '../../../components/sim/Actions.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="statistics"
  title="Maximum Likelihood"
  description="Which bell curve most likely produced this data? Slide its mean and spread and watch the likelihood rise and fall. The best fit lands on the sample mean and the spread that divides by n."
  shortcuts={['fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="mle"
          width="1000"
          height="600"
          role="img"
          aria-label="Data points on an axis under a Gaussian curve, each with a stick showing its likelihood, and a plot of the log-likelihood against the mean."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'data', color: '#f59e0b' },
          { label: 'candidate Gaussian', color: '#5eead4' },
          { label: 'log-likelihood against μ', color: '#7c8cff' },
        ]}
      />
      <Result label="Log-likelihood" />
    </div>

    <div class="sim-panel">
      <Slider id="mu" label="Mean μ" min={-3} max={3} step={0.02} value={0} display="0.00" />
      <Slider id="sg" label="Std dev σ" min={0.4} max={2.5} step={0.02} value={1} display="1.00" />
      <Actions>
        <button type="button" class="btn" id="snap">Snap to best fit</button>
        <button type="button" class="btn ghost" id="regen">New sample</button>
      </Actions>
      <Readout
        rows={[
          { id: 'r-mean', label: 'sample mean x̄' },
          { id: 'r-std', label: 'MLE σ̂, divides by n' },
          { id: 'r-s', label: 'sample std s, divides by n − 1' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Each stick is one point's <b>likelihood</b>, the height of the bell above
      it, and log L adds up their logs. Slide μ off to one side and the far
      points' sticks collapse. <Try id="off" />
    </li>
    <li>
      <b>Snap to best fit</b> lands on μ̂ = x̄ and σ̂ = √(Σ(xᵢ − x̄)²/n). That σ̂
      divides by n, not n − 1, so it comes out a little smaller than the sample
      standard deviation s. <Try id="snap" />
    </li>
    <li>
      The strip is log L as μ slides: for a Gaussian it is an exact
      <b>parabola</b> with one peak, so gradient ascent finds it from anywhere.
      Shrink σ and it gets steeper. <Try id="steep" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk, fixed } from '../../../lib/draw';
  import { el, slider, result, readout, tries } from '../../../lib/panel';

  const state = { mu: 0, sg: 1 };
  let data: number[] = [];
  const TEAL = '#5eead4', ACCENT = '#7c8cff', AMBER = '#f59e0b';

  const canvas = el('mle') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink, bg } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  const TOP = { l: 30, r: 30, t: 24, b: 34, bottom: 380 };
  const STRIP = { x: 60, y: 440, w: W - 90, h: 120 };
  const XR = [-5, 5] as const;
  const YMAX = 1.05;

  function gauss() {
    const u = 1 - Math.random(), v = Math.random();
    return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
  }
  function regen() {
    data = Array.from({ length: 34 }, () => 0.6 + 1.1 * gauss());
  }
  const pdf = (x: number, mu: number, sg: number) =>
    Math.exp(-((x - mu) ** 2) / (2 * sg * sg)) / (sg * Math.sqrt(2 * Math.PI));
  const logLik = (mu: number, sg: number) => data.reduce((s, x) => s + Math.log(pdf(x, mu, sg) + 1e-12), 0);
  /** The sample mean, the MLE spread σ̂ (divides by n) and the sample std s (divides by n − 1). */
  const stats = () => {
    const n = data.length;
    const m = data.reduce((a, b) => a + b, 0) / n;
    const ss = data.reduce((a, b) => a + (b - m) ** 2, 0);
    return { m, sd: Math.sqrt(ss / n), s: Math.sqrt(ss / (n - 1)) };
  };

  const sx = (x: number) => TOP.l + ((x - XR[0]) / (XR[1] - XR[0])) * (W - TOP.l - TOP.r);
  const sy = (y: number) => TOP.bottom - TOP.b - (y / YMAX) * (TOP.bottom - TOP.t - TOP.b);

  function drawFit() {
    ctx.strokeStyle = ink(0.07);
    ctx.lineWidth = 1;
    for (let xv = XR[0]; xv <= XR[1]; xv++) {
      ctx.beginPath();
      ctx.moveTo(sx(xv), TOP.t);
      ctx.lineTo(sx(xv), TOP.bottom - TOP.b);
      ctx.stroke();
      label(String(xv), sx(xv), TOP.bottom - TOP.b + 18, 0.3, 'center', 11.5);
    }
    ctx.strokeStyle = ink(0.25);
    ctx.beginPath();
    ctx.moveTo(TOP.l, sy(0));
    ctx.lineTo(W - TOP.r, sy(0));
    ctx.stroke();

    // each point's likelihood, as its height under the curve
    ctx.strokeStyle = ink(0.22);
    ctx.lineWidth = 1;
    for (const x of data) {
      ctx.beginPath();
      ctx.moveTo(sx(x), sy(0));
      ctx.lineTo(sx(x), sy(pdf(x, state.mu, state.sg)));
      ctx.stroke();
    }
    ctx.strokeStyle = TEAL;
    ctx.lineWidth = 2.6;
    ctx.beginPath();
    for (let i = 0; i <= 500; i++) {
      const x = XR[0] + ((XR[1] - XR[0]) * i) / 500;
      i === 0 ? ctx.moveTo(sx(x), sy(pdf(x, state.mu, state.sg))) : ctx.lineTo(sx(x), sy(pdf(x, state.mu, state.sg)));
    }
    ctx.stroke();
    // the sample, ringed in the background colour so overlapping points stay separate
    for (const x of data) {
      ctx.fillStyle = AMBER;
      ctx.strokeStyle = bg();
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(sx(x), sy(0), 5.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
    }
    ctx.strokeStyle = ACCENT;
    ctx.setLineDash([5, 5]);
    ctx.beginPath();
    ctx.moveTo(sx(state.mu), TOP.t);
    ctx.lineTo(sx(state.mu), sy(0));
    ctx.stroke();
    ctx.setLineDash([]);
    label(`μ = ${fixed(state.mu, 2)}`, sx(state.mu) + 6, TOP.t + 12, 1, 'left', 11.5, ACCENT);
  }

  function drawStrip() {
    label('log-likelihood as μ slides, at this σ', STRIP.x, STRIP.y - 10, 0.45, 'left', 11.5);
    const muMin = -3, muMax = 3;
    const vals: number[] = [];
    let lo = Infinity, hi = -Infinity;
    for (let i = 0; i <= 120; i++) {
      const v = logLik(muMin + ((muMax - muMin) * i) / 120, state.sg);
      vals.push(v);
      lo = Math.min(lo, v);
      hi = Math.max(hi, v);
    }
    if (hi - lo < 1e-6) hi = lo + 1;
    const gx = (mu: number) => STRIP.x + ((mu - muMin) / (muMax - muMin)) * STRIP.w;
    const gy = (v: number) => STRIP.y + (1 - (v - lo) / (hi - lo)) * STRIP.h;
    ctx.strokeStyle = ink(0.12);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(STRIP.x, STRIP.y + STRIP.h);
    ctx.lineTo(STRIP.x + STRIP.w, STRIP.y + STRIP.h);
    ctx.stroke();
    for (const mu of [-3, -2, -1, 0, 1, 2, 3]) label(String(mu), gx(mu), STRIP.y + STRIP.h + 16, 0.3, 'center', 11);
    ctx.strokeStyle = ACCENT;
    ctx.lineWidth = 2;
    ctx.beginPath();
    vals.forEach((v, i) => {
      const mu = muMin + ((muMax - muMin) * i) / 120;
      i === 0 ? ctx.moveTo(gx(mu), gy(v)) : ctx.lineTo(gx(mu), gy(v));
    });
    ctx.stroke();
    const here = logLik(state.mu, state.sg);
    ctx.strokeStyle = ink(0.4);
    ctx.setLineDash([4, 4]);
    ctx.beginPath();
    ctx.moveTo(gx(state.mu), STRIP.y);
    ctx.lineTo(gx(state.mu), STRIP.y + STRIP.h);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = ACCENT;
    ctx.beginPath();
    ctx.arc(gx(state.mu), gy(here), 4, 0, Math.PI * 2);
    ctx.fill();
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    drawFit();
    drawStrip();
    const { m, sd, s } = stats();
    const ll = logLik(state.mu, state.sg);
    const atBest = Math.abs(state.mu - m) < 0.03 && Math.abs(state.sg - sd) < 0.03;
    setEq({
      rule: [['\\log L(\\mu,\\sigma)', TEAL], `= \\sum_i \\log f(\\textcolor{${AMBER}}{x_i}\\mid\\mu,\\sigma)`],
      live: [`\\mu = ${fixed(state.mu, 2)}`, `\\quad\\sigma = ${state.sg.toFixed(2)}`, [`\\quad\\log L = ${fixed(ll, 3)}`, TEAL]],
    });
    setResult({
      value: fixed(ll, 3),
      colour: TEAL,
      status: atBest ? 'At the maximum: μ = x̄ and σ = σ̂' : `μ = ${fixed(state.mu, 2)} · σ = ${state.sg.toFixed(2)} · best would be μ = ${fixed(m, 2)}, σ̂ = ${sd.toFixed(2)}`,
      note: 'Each amber dot votes with its own height under the curve; the log turns their product into a sum.',
    });
    setRows({ 'r-mean': fixed(m, 3), 'r-std': sd.toFixed(3), 'r-s': s.toFixed(3) });
  }

  const setMu = slider('mu', (v) => { state.mu = v; draw(); }, (v) => v.toFixed(2));
  const setSg = slider('sg', (v) => { state.sg = v; draw(); }, (v) => v.toFixed(2));
  function set(mu: number, sg: number) {
    // onto the sliders' 0.02 grid, so the knobs show exactly the values in use
    const grid = (v: number, lo: number, hi: number) => +(Math.round(Math.max(lo, Math.min(hi, v)) / 0.02) * 0.02).toFixed(2);
    state.mu = grid(mu, -3, 3);
    state.sg = grid(sg, 0.4, 2.5);
    setMu(state.mu);
    setSg(state.sg);
    draw();
  }
  const snap = () => { const { m, sd } = stats(); set(m, sd); };
  el('snap').addEventListener('click', snap);
  tries({
    off: () => set(-2.4, 1),
    snap,
    steep: () => set(stats().m, 0.5),
  });
  el('regen').addEventListener('click', () => { regen(); draw(); });

  regen();
  draw();
</script>
