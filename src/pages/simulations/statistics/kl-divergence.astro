---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="statistics"
  title="KL Divergence"
  description="Every outcome surprises you by −log p(x): little when it was likely, a lot when it was rare. Believe the wrong distribution Q while the world draws from P and you are surprised a bit more on average. That average extra surprise is KL(P‖Q): never negative, zero only when Q is right, and not the same the other way round."
  shortcuts={['run', 'reset', 'fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="kl"
          width="1000"
          height="620"
          role="img"
          aria-label="Samples falling from a distribution P, each with its surprise under P and under a stand-in Q plotted below, the running average of the extra surprise, and two stand-in bells being fitted to two humps in the two directions of the divergence."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'P: how the world really draws', color: '#5eead4' },
          { label: 'Q: what you believe', color: '#fbbf24' },
          { label: 'extra surprise (Q too low)', color: '#f9736a' },
          { label: 'less surprise (Q too high)', color: '#7c8cff' },
        ]}
        hint="In chapter 3, drag Q sideways to move it and up or down to change its width"
      />
      <Result label="Now" />
    </div>

    <div class="sim-panel">
      <Seg
        id="ch"
        label="Chapter"
        attr="c"
        options={[
          { value: '0', label: '1 · Surprise' },
          { value: '1', label: '2 · Wrong belief' },
          { value: '2', label: '3 · Where it adds up' },
          { value: '3', label: '4 · Both ways' },
          { value: '4', label: '5 · Fitting' },
        ]}
      />
      <Transport>
        <button type="button" class="btn ghost" id="next">Next chapter →</button>
      </Transport>
      <Slider id="mu" label="Q: centre" min={-300} max={300} value={60} display="0.60" />
      <Slider id="sg" label="Q: width" min={20} max={250} value={70} display="0.70" />
      <Readout
        title="Exact values"
        rows={[
          { id: 'r-h', label: 'entropy H(P)' },
          { id: 'r-x', label: 'cross-entropy H(P, Q)' },
          { id: 'r-f', label: 'KL(P ‖ Q)' },
          { id: 'r-r', label: 'KL(Q ‖ P)' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Outcomes near the peak of P barely surprise; the rare ones out in the tails surprise a lot. The average settles
      on the entropy. <Try id="surprise" />
    </li>
    <li>
      With the wrong belief Q, some outcomes are less surprising than they should be (blue) and more are more
      surprising (red). The average extra never ends up below zero. <Try id="extra" />
    </li>
    <li>
      Drag Q onto P and all the red and blue vanish: KL is <b>zero only when Q = P</b>. Make Q narrow and watch the red
      in the tails explode. <Try id="drag" />
    </li>
    <li>
      Q sits on one hump of P. Draws from P on the other hump shock it, so KL(P‖Q) is huge; draws from Q are never
      a shock to P, so KL(Q‖P) is just one bit. <Try id="both" />
    </li>
    <li>
      Minimising KL(P‖Q) forces Q to cover everywhere P goes, so it spreads over both humps. Minimising KL(Q‖P) only
      punishes Q for going where P does not, so it settles on one hump. <Try id="fit" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk } from '../../../lib/draw';
  import { slider, result, readout, tries } from '../../../lib/panel';
  import { story, headline, say, withAlpha, isLight, beat, easeOut, lerp, clamp01 } from '../../../lib/story';

  // KL as surprise. Samples fall from P; each one's surprise −log₂ p(x) is
  // plotted below, and their average is the entropy. Believe Q instead and
  // the same samples surprise you by −log₂ q(x); the average of the gap is
  // KL(P‖Q). Then the gap as an area, the two directions on two humps, and
  // a bell fitted both ways.
  const PC = '#5eead4', QC = '#fbbf24', RED = '#f9736a', BLUE = '#7c8cff', RC = '#f472b6';
  const LN2 = Math.LN2;

  const canvas = document.getElementById('kl') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas);
  const { ink, inv } = stageInk(canvas);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  // ---------- distributions ----------
  type Comp = [w: number, m: number, s: number];
  const lnN = (x: number, m: number, s: number) => -0.5 * ((x - m) / s) ** 2 - Math.log(s * Math.sqrt(2 * Math.PI));
  function lnMix(c: Comp[], x: number) {
    let mx = -Infinity;
    const v = c.map(([w, m, s]) => { const l = Math.log(w) + lnN(x, m, s); mx = Math.max(mx, l); return l; });
    return mx + Math.log(v.reduce((a, l) => a + Math.exp(l - mx), 0));
  }
  const ONE: Comp[] = [[0.68, -0.7, 0.75], [0.32, 1.4, 0.55]];
  const TWO: Comp[] = [[0.5, -2.1, 0.55], [0.5, 2.1, 0.55]];

  const rng = (seed: number) => {
    let s = seed >>> 0 || 1;
    return () => (s = (s * 1664525 + 1013904223) >>> 0) / 4294967296;
  };
  const gauss = (r: () => number) => Math.sqrt(-2 * Math.log(r() + 1e-12)) * Math.cos(2 * Math.PI * r());
  const drawMix = (c: Comp[], r: () => number) => {
    let u = r(), k = 0;
    while (k < c.length - 1 && u > c[k][0]) u -= c[k++][0];
    return c[k][1] + c[k][2] * gauss(r);
  };

  // ---------- geometry ----------
  const X0 = -5.5, X1 = 5.5, PX0 = 70, PX1 = 930;
  const px = (x: number) => PX0 + ((x - X0) / (X1 - X0)) * (PX1 - PX0);
  const xOf = (p: number) => X0 + ((p - PX0) / (PX1 - PX0)) * (X1 - X0);
  const TOP = { base: 345, scale: 230 }; // density plot: px per unit of density
  const LOW = { base: 578, scale: 21, max: 9 }; // surprise plot: px per bit
  const NG = 700;
  const grid = Array.from({ length: NG }, (_, i) => X0 + ((i + 0.5) / NG) * (X1 - X0));
  const DX = (X1 - X0) / NG;

  const S = { mu: 0.6, sg: 0.7, P: ONE as Comp[] };
  const lp = (x: number) => lnMix(S.P, x);
  const lq = (x: number, mu = S.mu, sg = S.sg) => lnN(x, mu, sg);
  /** Bits of surprise. */
  const bits = (ln: number) => -ln / LN2;

  function kls(mu = S.mu, sg = S.sg) {
    let f = 0, r = 0, h = 0, x = 0;
    for (const g of grid) {
      const a = lp(g), b = lq(g, mu, sg), p = Math.exp(a), q = Math.exp(b);
      f += p * (a - b);
      r += q * (b - a);
      h -= p * a;
      x -= p * b;
    }
    return { f: (f * DX) / LN2, r: (r * DX) / LN2, h: (h * DX) / LN2, x: (x * DX) / LN2 };
  }

  // ---------- samples ----------
  type Drop = { x: number; t0: number; from: 'P' | 'Q' };
  let drops: Drop[] = [];
  const FALL = 0.4, RISE = 0.3;
  /** Release times: one at a time at first, then a shower. */
  function schedule(n: number, start: number, from: (k: number) => 'P' | 'Q', seed: number) {
    const r = rng(seed);
    drops = [];
    for (let k = 0; k < n; k++) {
      const t0 = k < 4 ? start + 1.1 * k : start + 4.4 + 7 * ((k - 4) / n) ** 0.75;
      const f = from(k);
      drops.push({ x: f === 'P' ? drawMix(S.P, r) : S.mu + S.sg * gauss(r), t0, from: f });
    }
  }

  // ---------- chapters ----------
  const chapters = [
    {
      dur: 14,
      title: 'Surprise',
      body: 'The world draws outcomes from P. How surprised should you be by one? −log p(x): an outcome you expected barely surprises, a rare one a lot. Averaged over many draws, that is the entropy.',
    },
    {
      dur: 15,
      title: 'Believing the wrong thing',
      body: 'Now you believe Q, but the world still draws from P. Each outcome surprises you by −log q(x) instead. The gap to −log p(x), averaged over what P really draws, is KL(P‖Q).',
    },
    {
      dur: Infinity,
      title: 'Where the extra comes from',
      body: 'The gap weighted by how often P goes there. Red: Q gave too little credit. Blue: Q gave too much, but the red always wins. Zero only when Q is exactly P.',
    },
    {
      dur: Infinity,
      title: 'Not the same both ways',
      body: 'Q sits on one hump. When P draws from the other hump, Q thought that nearly impossible: KL(P‖Q) explodes. Draws from Q never shock P much: KL(Q‖P) stays small.',
    },
    {
      dur: Infinity,
      title: 'Two ways to fit a bell',
      body: 'Slide a bell to make each direction small. Minimising KL(P‖Q) punishes missing any of P, so Q stretches over both humps. Minimising KL(Q‖P) punishes going where P is not, so Q hides in one hump.',
    },
  ];

  // the two bells of the last chapter, each descending its own divergence
  const fit = {
    fwd: { mu: -0.8, ls: Math.log(0.6), lr: 0.08, trail: [] as [number, number][] },
    rev: { mu: -0.8, ls: Math.log(0.6), lr: 0.08, trail: [] as [number, number][] },
    acc: 0,
  };

  const st = story({
    chapters,
    enter(i) {
      if (i <= 2) {
        S.P = ONE;
        if (i < 2 || !qMoved) { S.mu = 0.6; S.sg = 0.7; syncQ(); }
      }
      if (i === 0) schedule(260, 1.2, () => 'P', 3);
      if (i === 1) schedule(260, 1.5, () => 'P', 4);
      if (i === 3) { S.P = TWO; S.mu = -2.1; S.sg = 0.55; syncQ(); schedule(220, 1.2, (k) => (k % 2 ? 'Q' : 'P'), 9); }
      if (i === 4) {
        S.P = TWO;
        for (const k of ['fwd', 'rev'] as const) Object.assign(fit[k], { mu: -0.8, ls: Math.log(0.6), lr: 0.08, trail: [] });
      }
      if (i !== 2) qMoved = false;
      exact = kls();
    },
    frame,
  });
  let exact = kls();
  let qMoved = false;

  function frame(ch: number, t: number, dt: number) {
    const light = isLight(canvas);
    ctx.clearRect(0, 0, W, H);

    if (ch === 4 && dt > 0) runFit(t, dt);

    densities(ch, t, light);
    if (ch <= 1 || ch === 3) surprisePanel(ch, t, light);
    if (ch === 2) integrand(light);
    if (ch === 4) fitPanel(t, light);

    headline(ctx, ink, { index: ch, count: chapters.length, title: chapters[ch].title, body: chapters[ch].body, t, width: 500, accent: PC });
    panel(ch, t);
    eqTick(ch);
  }

  // ---------- drawing ----------
  function curve(ln: (x: number) => number, col: string, light: boolean, fill = 0.12, width = 2.5) {
    ctx.save();
    ctx.beginPath();
    for (let p = PX0; p <= PX1; p += 2) {
      const y = TOP.base - Math.exp(ln(xOf(p))) * TOP.scale;
      p === PX0 ? ctx.moveTo(p, y) : ctx.lineTo(p, y);
    }
    ctx.strokeStyle = col;
    ctx.lineWidth = width;
    ctx.lineJoin = 'round';
    if (!light) { ctx.shadowColor = withAlpha(col, 0.5); ctx.shadowBlur = 10; }
    ctx.stroke();
    ctx.shadowBlur = 0;
    if (fill > 0) {
      ctx.lineTo(PX1, TOP.base);
      ctx.lineTo(PX0, TOP.base);
      ctx.closePath();
      ctx.fillStyle = withAlpha(col, fill);
      ctx.fill();
    }
    ctx.restore();
  }

  function densities(ch: number, t: number, light: boolean) {
    ctx.strokeStyle = ink(0.22);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(PX0 - 10, TOP.base + 0.5);
    ctx.lineTo(PX1 + 10, TOP.base + 0.5);
    ctx.stroke();
    if (ch === 4) {
      curve(lp, PC, light, 0.16);
      return;
    }
    curve(lp, PC, light, 0.16);
    const qa = ch === 0 ? 0 : ch === 1 ? beat(t, 0.2, 1.2) : 1;
    if (qa > 0) {
      ctx.globalAlpha = qa;
      curve((x) => lq(x), QC, light, 0.06);
      ctx.globalAlpha = 1;
    }
    // names on the curves
    const pk = (ln: (x: number) => number) => {
      let best = X0;
      for (let p = PX0; p <= PX1; p += 4) if (ln(xOf(p)) > ln(best)) best = xOf(p);
      return best;
    };
    const xp = pk(lp);
    const xq = pk((x) => lq(x));
    const yp = TOP.base - Math.exp(lp(xp)) * TOP.scale, yq = TOP.base - Math.exp(lq(xq)) * TOP.scale;
    const pLeft = ch !== 3 && xp > xq - 0.3;
    say(ctx, 'P', px(xp) + (pLeft ? -14 : 14), yp - 6, { colour: PC, size: 20, weight: 700, align: pLeft ? 'right' : 'left' });
    if (qa > 0) say(ctx, 'Q', px(xq) + (ch === 3 ? -14 : 14), yq - 6, { colour: QC, size: 20, weight: 700, alpha: qa, align: ch === 3 ? 'right' : 'left' });
  }

  /** The lower plot: surprise in bits against x, with every sample's dot. */
  function surprisePanel(ch: number, t: number, light: boolean) {
    const yb = (b: number) => LOW.base - Math.min(b, LOW.max) * LOW.scale;
    // axis and gridlines
    ctx.save();
    ctx.strokeStyle = ink(0.22);
    ctx.beginPath();
    ctx.moveTo(PX0 - 10, LOW.base + 0.5);
    ctx.lineTo(PX1 + 10, LOW.base + 0.5);
    ctx.stroke();
    ctx.font = '11px ui-monospace, monospace';
    ctx.textAlign = 'right';
    for (let b = 2; b <= LOW.max; b += 2) {
      ctx.fillStyle = ink(0.05);
      ctx.fillRect(PX0, yb(b), PX1 - PX0, 1);
      ctx.fillStyle = ink(0.38);
      ctx.fillText(`${b} bits`, PX0 - 6, yb(b) + 4);
    }
    ctx.restore();
    say(ctx, 'surprise', PX0 - 6, yb(LOW.max) - 14, { colour: ink(0.5), size: 12, align: 'right' });

    // the surprise curves −log p and −log q
    const sCurve = (ln: (x: number) => number, col: string, a: number) => {
      ctx.save();
      ctx.globalAlpha = a;
      ctx.strokeStyle = col;
      ctx.lineWidth = 1.5;
      ctx.setLineDash([5, 5]);
      ctx.beginPath();
      let on = false;
      for (let p = PX0; p <= PX1; p += 2) {
        const b = bits(ln(xOf(p)));
        if (b > LOW.max) { on = false; continue; }
        on ? ctx.lineTo(p, yb(b)) : ctx.moveTo(p, yb(b));
        on = true;
      }
      ctx.stroke();
      ctx.restore();
    };
    sCurve(lp, PC, 0.7);
    if (ch >= 1) sCurve((x) => lq(x), QC, ch === 1 ? beat(t, 0.2, 1.2) * 0.8 : 0.8);

    // samples: fall onto the axis of P, then show their surprise
    let lastShock: { x: number; extra: number; fresh: number } | null = null;
    let n = 0, sumP = 0, sumQ = 0, nP = 0, nQ = 0, sumFwd = 0, sumRev = 0;
    for (const d of drops) {
      const tt = t - d.t0;
      if (tt < 0) break;
      const col = d.from === 'P' ? PC : QC;
      const fall = clamp01(tt / FALL);
      const x = px(d.x);
      if (fall < 1) {
        const y = lerp(205, TOP.base, fall * fall);
        ctx.fillStyle = col;
        ctx.beginPath();
        ctx.arc(x, y, 4, 0, Math.PI * 2);
        ctx.fill();
        continue;
      }
      const rise = easeOut((tt - FALL) / RISE);
      const age = tt - FALL - RISE;
      const fresh = 1 - clamp01(age / 1.5);
      // a tick on the axis where it landed
      ctx.fillStyle = withAlpha(col, 0.25 + 0.6 * fresh);
      ctx.fillRect(x - 1, TOP.base - 6, 2, 8);

      const bp = bits(lp(d.x)), bq = bits(lq(d.x));
      if (ch === 0) {
        const y = lerp(LOW.base, yb(bp), rise);
        if (fresh > 0) {
          ctx.strokeStyle = withAlpha(PC, 0.5 * fresh);
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(x, LOW.base);
          ctx.lineTo(x, y);
          ctx.stroke();
        }
        dot(x, y, PC, 0.5 + 0.5 * fresh, 3 + 2 * fresh);
        if (rise >= 1) { n++; sumP += bp; }
        if (fresh > 0.3 && n <= 4) say(ctx, `${bp.toFixed(1)} bits`, x + 8, y - 10, { colour: PC, size: 13, weight: 600, alpha: fresh, halo: inv(0.8) });
      } else if (ch === 1) {
        // from −log p up (or down) to −log q: the extra
        const yP = yb(bp), yQ = lerp(yP, yb(bq), rise);
        const extra = bq - bp;
        ctx.strokeStyle = withAlpha(extra > 0 ? RED : BLUE, 0.25 + 0.65 * fresh);
        ctx.lineWidth = 2 + 2 * fresh;
        ctx.beginPath();
        ctx.moveTo(x, yP);
        ctx.lineTo(x, yQ);
        ctx.stroke();
        dot(x, yP, PC, 0.4 + 0.5 * fresh, 2.5 + 1.5 * fresh);
        dot(x, yQ, QC, 0.4 + 0.5 * fresh, 2.5 + 1.5 * fresh);
        if (bq > LOW.max && fresh > 0.6) say(ctx, 'off the chart', x, yb(LOW.max) - 10, { colour: RED, size: 12, weight: 600, align: 'center', alpha: fresh, halo: inv(0.8) });
        if (rise >= 1) { n++; sumP += bp; sumQ += bq; }
        if (fresh > 0.3 && n <= 4) say(ctx, `${extra >= 0 ? '+' : '−'}${Math.abs(extra).toFixed(1)} bits`, x + 8, (yP + yQ) / 2, { colour: extra > 0 ? RED : BLUE, size: 13, weight: 600, alpha: fresh, halo: inv(0.8) });
      } else {
        // both ways: a draw from P judged by Q, or a draw from Q judged by P
        const extra = d.from === 'P' ? bq - bp : bp - bq;
        const own = d.from === 'P' ? bp : bq, other = d.from === 'P' ? bq : bp;
        const y0 = yb(own), y1 = lerp(y0, yb(other), rise);
        const shock = other > LOW.max;
        ctx.strokeStyle = withAlpha(extra > 0 ? RED : BLUE, 0.2 + 0.7 * fresh);
        ctx.lineWidth = shock ? 3 + 3 * fresh : 2;
        ctx.beginPath();
        ctx.moveTo(x, y0);
        ctx.lineTo(x, shock ? lerp(y0, yb(LOW.max) - 6, rise) : y1);
        ctx.stroke();
        dot(x, y0, col, 0.4 + 0.5 * fresh, 2.5 + 1.5 * fresh);
        if (shock && fresh > 0) lastShock = { x, extra, fresh };
        if (rise >= 1) {
          if (d.from === 'P') { nP++; sumFwd += extra; } else { nQ++; sumRev += extra; }
        }
      }
    }
    if (lastShock)
      say(ctx, `+${lastShock.extra.toFixed(0)} bits: Q thought this nearly impossible`, Math.min(PX1 - 160, lastShock.x), yb(LOW.max) - 18, {
        colour: RED, size: 14, weight: 700, align: 'center', alpha: lastShock.fresh, halo: inv(0.85),
      });
    running = { n, sumP, sumQ, nP, nQ, sumFwd, sumRev };

    // the running averages, as lines across the plot and as big numbers
    if (ch === 0 && n > 0) {
      const avg = sumP / n;
      hline(yb(avg), PC, `average surprise ${avg.toFixed(2)} bits  →  entropy H(P) = ${exact.h.toFixed(2)}`);
    }
    if (ch === 1 && n > 0) {
      const ex = (sumQ - sumP) / n;
      hline(yb(sumP / n), PC, `average under P: ${(sumP / n).toFixed(2)}`, true);
      hline(yb(sumQ / n), QC, `average under Q: ${(sumQ / n).toFixed(2)}`, true);
      meter(`extra per draw: ${ex >= 0 ? '+' : '−'}${Math.abs(ex).toFixed(2)} bits`, `→ KL(P‖Q) = ${exact.f.toFixed(2)} bits`, RED);
    }
    if (ch === 3) {
      const f = nP ? sumFwd / nP : 0, r = nQ ? sumRev / nQ : 0;
      meter2(f, r, nP, nQ);
    }
    void light;
  }
  let running = { n: 0, sumP: 0, sumQ: 0, nP: 0, nQ: 0, sumFwd: 0, sumRev: 0 };

  function dot(x: number, y: number, col: string, a: number, r: number) {
    ctx.fillStyle = withAlpha(col, a);
    ctx.beginPath();
    ctx.arc(x, y, r, 0, Math.PI * 2);
    ctx.fill();
  }

  function hline(y: number, col: string, label: string, small = false) {
    ctx.save();
    ctx.strokeStyle = withAlpha(col, 0.8);
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(PX0, y);
    ctx.lineTo(PX1, y);
    ctx.stroke();
    ctx.restore();
    say(ctx, label, PX1, y - 10, { colour: col, size: small ? 13 : 14, weight: 600, align: 'right', halo: inv(0.85) });
  }

  function meter(big: string, small: string, col: string) {
    const x = PX1, y = 214;
    say(ctx, big, x, y, { colour: col, size: 22, weight: 700, align: 'right', halo: inv(0.85) });
    say(ctx, small, x, y + 24, { colour: ink(0.7), size: 14, align: 'right', halo: inv(0.85) });
  }

  function meter2(f: number, r: number, nP: number, nQ: number) {
    // top right, clear of both humps and the headline
    const x = PX1, y = 40;
    say(ctx, `KL(P‖Q) ≈ ${f.toFixed(1)} bits`, x, y, { colour: RED, size: 22, weight: 700, align: 'right', halo: inv(0.85) });
    say(ctx, `${nP} draws from P, judged by Q  (exact ${exact.f.toFixed(1)})`, x, y + 22, { colour: ink(0.7), size: 13, align: 'right', halo: inv(0.85) });
    say(ctx, `KL(Q‖P) ≈ ${r.toFixed(2)} bits`, x, y + 52, { colour: QC, size: 18, weight: 700, align: 'right', halo: inv(0.85) });
    say(ctx, `${nQ} draws from Q, judged by P  (exact ${exact.r.toFixed(2)})`, x, y + 72, { colour: ink(0.7), size: 13, align: 'right', halo: inv(0.85) });
  }

  let isc = 0;
  /** Chapter 3: p·log(p/q) as an area, red above zero and blue below. */
  function integrand(light: boolean) {
    const base = 480, sc = 260;
    ctx.save();
    ctx.strokeStyle = ink(0.22);
    ctx.beginPath();
    ctx.moveTo(PX0 - 10, base + 0.5);
    ctx.lineTo(PX1 + 10, base + 0.5);
    ctx.stroke();
    let pos = 0, neg = 0;
    const vals: number[] = [];
    for (let p = PX0; p <= PX1; p += 1) {
      const x = xOf(p), a = lp(x), b = lq(x);
      const v = (Math.exp(a) * (a - b)) / LN2;
      vals.push(v);
    }
    for (const g of grid) {
      const a = lp(g), v = (Math.exp(a) * (a - lq(g))) / LN2;
      if (v > 0) pos += v * DX; else neg -= v * DX;
    }
    const big = Math.max(1e-6, ...vals.map(Math.abs));
    isc = lerp(isc, Math.min(sc, 105 / big), isc ? 0.15 : 1);
    for (const [sign, col] of [[1, RED], [-1, BLUE]] as const) {
      ctx.beginPath();
      ctx.moveTo(PX0, base);
      vals.forEach((v, k) => {
        const c = sign > 0 ? Math.max(0, v) : Math.min(0, v);
        ctx.lineTo(PX0 + k, base - c * isc);
      });
      ctx.lineTo(PX1, base);
      ctx.closePath();
      ctx.fillStyle = withAlpha(col, light ? 0.45 : 0.55);
      ctx.fill();
    }
    ctx.restore();
    say(ctx, 'p(x) · log₂ p(x)/q(x)', PX0, 372, { colour: ink(0.55), size: 13 });
    // the tally
    const x = PX1;
    say(ctx, `red ${pos.toFixed(3)}  −  blue ${neg.toFixed(3)}`, x, 380, { colour: ink(0.8), size: 15, weight: 500, align: 'right' });
    say(ctx, `= KL(P‖Q) = ${exact.f.toFixed(3)} bits`, x, 404, { colour: exact.f < 0.005 ? PC : RED, size: 20, weight: 700, align: 'right' });
    if (exact.f < 0.005) say(ctx, 'Q is P: nothing extra', x, 428, { colour: PC, size: 14, align: 'right' });
  }

  // ---------- chapter 5: fitting ----------
  const KLD = (dir: 'fwd' | 'rev', mu: number, ls: number) => {
    const k = kls(mu, Math.exp(ls));
    return dir === 'fwd' ? k.f : k.r;
  };
  function descend(dir: 'fwd' | 'rev') {
    const s = fit[dir], e = 1e-4;
    const c = KLD(dir, s.mu, s.ls);
    const gm = (KLD(dir, s.mu + e, s.ls) - c) / e, gs = (KLD(dir, s.mu, s.ls + e) - c) / e;
    const g = Math.hypot(gm, gs);
    if (g < 1e-6 || s.lr < 1e-3) return;
    // a step of fixed length downhill, halved whenever it would climb
    for (let tries = 0; tries < 8; tries++) {
      const mu = s.mu - (s.lr * gm) / g, ls = s.ls - (s.lr * gs) / g;
      if (KLD(dir, mu, ls) < c) { s.mu = mu; s.ls = ls; break; }
      s.lr /= 2;
    }
    s.trail.push([s.mu, s.ls]);
  }
  function runFit(t: number, dt: number) {
    if (t < 1.5) return;
    fit.acc += dt * 7;
    while (fit.acc >= 1) {
      fit.acc -= 1;
      descend('fwd');
      descend('rev');
    }
  }

  function fitPanel(t: number, light: boolean) {
    const a = beat(t, 0.3, 1.2);
    for (const [dir, col] of [['fwd', QC], ['rev', RC]] as const) {
      const s = fit[dir];
      // a few ghosts of where it was
      const tr = s.trail;
      for (let k = Math.max(0, tr.length - 40); k < tr.length; k += 8) {
        ctx.globalAlpha = 0.12 * a;
        curve((x) => lnN(x, tr[k][0], Math.exp(tr[k][1])), col, light, 0, 1.2);
      }
      ctx.globalAlpha = a;
      curve((x) => lnN(x, s.mu, Math.exp(s.ls)), col, light, 0.08, 3);
      ctx.globalAlpha = 1;
    }
    // labels and the two scores
    const done = fit.fwd.lr < 1e-3 && fit.rev.lr < 1e-3;
    const f = kls(fit.fwd.mu, Math.exp(fit.fwd.ls)), r = kls(fit.rev.mu, Math.exp(fit.rev.ls));
    const yF = TOP.base - Math.exp(lnN(fit.fwd.mu, fit.fwd.mu, Math.exp(fit.fwd.ls))) * TOP.scale;
    const yR = TOP.base - Math.exp(lnN(fit.rev.mu, fit.rev.mu, Math.exp(fit.rev.ls))) * TOP.scale;
    if (t > 1.5 && Math.abs(fit.fwd.ls - fit.rev.ls) + Math.abs(fit.fwd.mu - fit.rev.mu) < 0.4)
      say(ctx, 'both start here', px(fit.fwd.mu), Math.min(yF, yR) - 20, { colour: ink(0.8), size: 15, weight: 600, align: 'center', halo: inv(0.85) });
    else if (t > 1.5) {
      say(ctx, 'min KL(P‖Q)', px(fit.fwd.mu), yF - 30, { colour: QC, size: 16, weight: 700, align: 'center', halo: inv(0.85) });
      say(ctx, done ? 'covers everything P does' : '', px(fit.fwd.mu), yF - 12, { colour: ink(0.75), size: 13, align: 'center', halo: inv(0.85) });
      say(ctx, 'min KL(Q‖P)', px(fit.rev.mu), yR - 30, { colour: RC, size: 16, weight: 700, align: 'center', halo: inv(0.85) });
      say(ctx, done ? 'picks one hump' : '', px(fit.rev.mu), yR - 12, { colour: ink(0.75), size: 13, align: 'center', halo: inv(0.85) });
    }
    // under the plot: why, in one picture each
    const y = 420;
    say(ctx, 'KL(P‖Q) = average over P of log p/q', PX0, y, { colour: QC, size: 15, weight: 650 });
    say(ctx, 'Wherever P lands, Q must not be near zero, or the cost is huge.', PX0, y + 22, { colour: ink(0.7), size: 14 });
    say(ctx, `now ${f.f.toFixed(2)} bits`, PX0, y + 44, { colour: ink(0.55), size: 13 });
    say(ctx, 'KL(Q‖P) = average over Q of log q/p', 520, y, { colour: RC, size: 15, weight: 650 });
    say(ctx, 'Q may ignore part of P, but must not go where P is not.', 520, y + 22, { colour: ink(0.7), size: 14 });
    say(ctx, `now ${r.r.toFixed(2)} bits`, 520, y + 44, { colour: ink(0.55), size: 13 });
  }

  // ---------- panel ----------
  let tick = 0;
  function panel(ch: number, t: number) {
    if (tick++ % 8) return;
    setRows({
      'r-h': `${exact.h.toFixed(3)} bits`,
      'r-x': `${exact.x.toFixed(3)} bits`,
      'r-f': `${exact.f.toFixed(3)} bits`,
      'r-r': `${exact.r.toFixed(3)} bits`,
    });
    const R = running;
    if (ch === 0)
      setResult({ value: R.n ? `${(R.sumP / R.n).toFixed(2)} bits` : '—', status: `average of ${R.n} draws`, note: `Settles on the entropy H(P) = ${exact.h.toFixed(2)} bits: how surprised you are on average when you know P.`, colour: PC });
    else if (ch === 1)
      setResult({ value: R.n ? `+${((R.sumQ - R.sumP) / R.n).toFixed(2)} bits` : '—', status: `extra per draw, ${R.n} draws`, note: `Settles on KL(P‖Q) = ${exact.f.toFixed(2)} bits: the price of believing Q while the world is P.`, colour: RED });
    else if (ch === 2)
      setResult({ value: `${exact.f.toFixed(3)} bits`, status: exact.f < 0.005 ? 'Q matches P' : 'KL(P‖Q)', note: 'Red area minus blue area. It can only be zero when Q is P everywhere.', colour: exact.f < 0.005 ? PC : RED });
    else if (ch === 3)
      setResult({ value: `${exact.f.toFixed(1)} vs ${exact.r.toFixed(2)} bits`, status: 'KL(P‖Q) vs KL(Q‖P)', note: 'Same two distributions, very different numbers: which one does the sampling matters.', colour: RED });
    else {
      const f = kls(fit.fwd.mu, Math.exp(fit.fwd.ls)).f, r = kls(fit.rev.mu, Math.exp(fit.rev.ls)).r;
      setResult({ value: `σ ${Math.exp(fit.fwd.ls).toFixed(2)} vs ${Math.exp(fit.rev.ls).toFixed(2)}`, status: 'wide cover vs one hump', note: `The bell fitted with KL(P‖Q) ends at ${f.toFixed(2)} bits, the one fitted with KL(Q‖P) at ${r.toFixed(2)} bits.` });
    }
    void t;
  }

  type Part = string | [string, string];
  const EQ: Part[][] = [
    ['\\text{surprise}(x) = -\\log_2', ['p(x)', PC], ',\\qquad H(P) = \\mathbb{E}_{x\\sim P}\\big[-\\log_2', ['p(x)', PC], '\\big]'],
    ['\\mathrm{KL}(P\\,\\|\\,Q) = \\mathbb{E}_{x\\sim P}\\big[', ['-\\log_2 q(x)', QC], '-', ['(-\\log_2 p(x))', PC], '\\big]'],
    ['\\mathrm{KL}(P\\,\\|\\,Q) = \\displaystyle\\int', ['p(x)', PC], '\\log_2\\frac{', ['p(x)', PC], '}{', ['q(x)', QC], '}\\,dx \\;\\ge\\; 0'],
    ['\\mathrm{KL}(P\\,\\|\\,Q) = \\mathbb{E}_{', ['P', PC], '}\\Big[\\log\\frac{p}{q}\\Big] \\;\\neq\\; \\mathbb{E}_{', ['Q', QC], '}\\Big[\\log\\frac{q}{p}\\Big] = \\mathrm{KL}(Q\\,\\|\\,P)'],
    [['\\min_Q \\mathrm{KL}(P\\,\\|\\,Q)', QC], '\\text{ covers}', '\\qquad', ['\\min_Q \\mathrm{KL}(Q\\,\\|\\,P)', RC], '\\text{ picks}'],
  ];
  let eqFor = -1;
  function eqTick(ch: number) {
    if (ch === eqFor) return;
    eqFor = ch;
    setEq({ rule: EQ[ch] });
  }

  // ---------- Q by hand ----------
  const setMu = slider('mu', (v) => setQ(v / 100, S.sg), (v) => (v / 100).toFixed(2).replace('-', '−'));
  const setSg = slider('sg', (v) => setQ(S.mu, v / 100), (v) => (v / 100).toFixed(2));
  function syncQ() {
    setMu(Math.round(S.mu * 100));
    setSg(Math.round(S.sg * 100));
  }
  function setQ(mu: number, sg: number) {
    S.mu = Math.max(-3, Math.min(3, mu));
    S.sg = Math.max(0.2, Math.min(2.5, sg));
    qMoved = true;
    if (st.chapter() !== 2) st.go(2);
    exact = kls();
    syncQ();
  }

  const toLocal = (e: PointerEvent) => {
    const b = canvas.getBoundingClientRect();
    return { x: ((e.clientX - b.left) / b.width) * W, y: ((e.clientY - b.top) / b.height) * H };
  };
  let drag: { x: number; y: number; mu: number; sg: number } | null = null;
  canvas.addEventListener('pointerdown', (e) => {
    if (st.chapter() !== 2) return;
    const p = toLocal(e);
    drag = { ...p, mu: S.mu, sg: S.sg };
    canvas.setPointerCapture(e.pointerId);
  });
  canvas.addEventListener('pointermove', (e) => {
    if (!drag) return;
    const p = toLocal(e);
    setQ(drag.mu + xOf(p.x) - xOf(drag.x), drag.sg * Math.exp((p.y - drag.y) * 0.006));
  });
  canvas.addEventListener('pointerup', () => (drag = null));

  tries({
    surprise: () => { st.go(0); st.play(true); },
    extra: () => { st.go(1); st.play(true); },
    drag: () => { qMoved = false; st.go(2); setQ(-0.1, 0.95); },
    both: () => { st.go(3); st.play(true); },
    fit: () => { st.go(4); st.play(true); },
  });

  st.start();
</script>
