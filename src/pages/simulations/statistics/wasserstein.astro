---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
---

<SimLayout
  areaSlug="statistics"
  title="Wasserstein Distance"
  description="The least work needed to reshape one pile of probability into another: mass times distance moved. Unlike overlap, it still knows two distant bumps are far apart."
  shortcuts={['fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="ws"
          width="1000"
          height="600"
          role="img"
          aria-label="Two distributions as histograms, and below them their cumulative curves with the area between them shaded."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'P', color: '#5eead4' },
          { label: 'Q', color: '#f59e0b' },
          { label: 'area between the CDFs = W₁', color: 'rgba(245,158,11,0.45)' },
        ]}
        hint="Drag the top plot to move Q"
      />
      <Result label="Wasserstein distance W<sub>1</sub>" />
    </div>

    <div class="sim-panel">
      <Seg
        id="pshape"
        label="Distribution P"
        attr="s"
        options={[
          { value: 'bimodal', label: 'Bimodal' },
          { value: 'gauss', label: 'Gaussian' },
          { value: 'uniform', label: 'Uniform' },
        ]}
      />
      <Slider id="m" label="Q mean" min={5} max={95} value={30} display="3.0" />
      <Slider id="s" label="Q spread" min={3} max={30} value={10} display="1.0" />
      <Readout rows={[{ id: 'r-w1', label: 'W<sub>1</sub>' }, { id: 'r-ovl', label: 'overlap' }]} />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Slide <b>Q's mean</b> away from P. The <b>Wasserstein distance grows
      steadily</b> with the gap, because it counts how far the mass has to
      travel, the shaded area between the CDFs stretches with it.
    </li>
    <li>
      Watch <b>Overlap</b> instead: once the two bumps stop touching it hits
      <b>zero and stays there</b>, blind to whether they are near or a mile
      apart. That is why overlap-based losses fail to train generative models.
    </li>
    <li>
      In 1D the distance is simply the <b>area between the two CDFs</b>. Reshape P
      or widen Q and see how spreading mass out, not just moving it, also costs.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk } from '../../../lib/draw';
  import { el, segmented, slider, result, readout } from '../../../lib/panel';

  const NB = 70, XMAX = 10, dx = XMAX / NB;
  const TEAL = '#5eead4', AMBER = '#f59e0b';
  const state = { shape: 'bimodal', mean: 3, spread: 1 };

  const canvas = el('ws') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  const PAD = { l: 40, r: 30 };
  const TOP = { y: 30, h: 220 };
  const BOT = { y: 320, h: 220 };
  const sx = (x: number) => PAD.l + (x / XMAX) * (W - PAD.l - PAD.r);
  const bw = (W - PAD.l - PAD.r) / NB;

  function normalize(a: number[]) {
    const s = a.reduce((p, v) => p + v, 0);
    return s > 0 ? a.map((v) => v / s) : a;
  }
  function pDist() {
    const a = new Array(NB).fill(0);
    for (let i = 0; i < NB; i++) {
      const x = (i + 0.5) * dx;
      if (state.shape === 'bimodal') a[i] = Math.exp(-((x - 2.5) ** 2) / 0.8) + 0.9 * Math.exp(-((x - 7) ** 2) / 1.1);
      else if (state.shape === 'uniform') a[i] = x >= 2 && x <= 8 ? 1 : 0;
      else a[i] = Math.exp(-((x - 5) ** 2) / 2.2);
    }
    return normalize(a);
  }
  function qDist() {
    const a = new Array(NB).fill(0);
    for (let i = 0; i < NB; i++) {
      const x = (i + 0.5) * dx;
      a[i] = Math.exp(-((x - state.mean) ** 2) / (2 * state.spread * state.spread));
    }
    return normalize(a);
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    const p = pDist(), q = qDist();
    const cumP: number[] = [], cumQ: number[] = [];
    let cp = 0, cq = 0;
    for (let i = 0; i < NB; i++) { cp += p[i]; cq += q[i]; cumP.push(cp); cumQ.push(cq); }

    // the two piles
    label('the two distributions', PAD.l, TOP.y - 10, 0.45, 'left', 11.5);
    const pmax = Math.max(...p, ...q) * 1.1;
    ctx.strokeStyle = ink(0.14);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(PAD.l, TOP.y + TOP.h);
    ctx.lineTo(W - PAD.r, TOP.y + TOP.h);
    ctx.stroke();
    for (let i = 0; i < NB; i++) {
      const x = PAD.l + i * bw;
      ctx.fillStyle = TEAL + '99';
      ctx.fillRect(x, TOP.y + TOP.h - (p[i] / pmax) * TOP.h, bw - 0.5, (p[i] / pmax) * TOP.h);
      ctx.fillStyle = AMBER + '99';
      ctx.fillRect(x, TOP.y + TOP.h - (q[i] / pmax) * TOP.h, bw - 0.5, (q[i] / pmax) * TOP.h);
    }

    // their running totals, with the work between them shaded
    label('running totals, the CDFs', PAD.l, BOT.y - 10, 0.45, 'left', 11.5);
    const cy = (c: number) => BOT.y + BOT.h - c * BOT.h;
    for (let i = 0; i < NB; i++) {
      const y1 = cy(cumP[i]), y2 = cy(cumQ[i]);
      ctx.fillStyle = 'rgba(245,158,11,0.16)';
      ctx.fillRect(PAD.l + i * bw, Math.min(y1, y2), bw + 0.5, Math.abs(y1 - y2));
    }
    ctx.strokeStyle = ink(0.14);
    ctx.beginPath();
    ctx.moveTo(PAD.l, BOT.y + BOT.h);
    ctx.lineTo(W - PAD.r, BOT.y + BOT.h);
    ctx.stroke();
    const drawCDF = (cum: number[], color: string) => {
      ctx.strokeStyle = color;
      ctx.lineWidth = 2.2;
      ctx.beginPath();
      for (let i = 0; i < NB; i++) {
        const x = PAD.l + (i + 0.5) * bw;
        i === 0 ? ctx.moveTo(x, cy(cum[i])) : ctx.lineTo(x, cy(cum[i]));
      }
      ctx.stroke();
    };
    drawCDF(cumP, TEAL);
    drawCDF(cumQ, AMBER);
    for (let t = 0; t <= 10; t += 2) label(String(t), sx(t), BOT.y + BOT.h + 16, 0.3, 'center', 11);
    label('1', PAD.l - 8, cy(1) + 4, 0.3, 'right', 11);

    let w1 = 0, ovl = 0;
    for (let i = 0; i < NB; i++) {
      w1 += Math.abs(cumP[i] - cumQ[i]) * dx;
      ovl += Math.min(p[i], q[i]);
    }
    setEq({
      rule: ['W_1(p,q) = \\int \\big|', ['F_p(x)', TEAL], '-', ['F_q(x)', AMBER], '\\big|\\,dx'],
      live: [[`W_1 = ${w1.toFixed(3)}`, AMBER], `\\quad\\text{overlap} = ${ovl.toFixed(3)}`],
    });
    setResult({
      value: w1.toFixed(3),
      colour: AMBER,
      status: `Overlap ${(ovl * 100).toFixed(1)}%`,
      note: 'Move the piles apart and W₁ keeps growing, long after the overlap has hit zero.',
    });
    setRows({ 'r-w1': w1.toFixed(3), 'r-ovl': `${(ovl * 100).toFixed(1)}%` });
  }

  // drag the top plot to move Q's mean
  const setMean = slider('m', (v) => { state.mean = v / 10; draw(); }, (v) => (v / 10).toFixed(1));
  slider('s', (v) => { state.spread = v / 10; draw(); }, (v) => (v / 10).toFixed(1));
  segmented('pshape', (s) => { state.shape = s; draw(); });

  let dragging = false;
  function dragTo(e: PointerEvent) {
    const rect = canvas.getBoundingClientRect();
    const x = ((((e.clientX - rect.left) / rect.width) * W - PAD.l) / (W - PAD.l - PAD.r)) * XMAX;
    state.mean = Math.max(0.5, Math.min(9.5, x));
    setMean(Math.round(state.mean * 10));
    draw();
  }
  canvas.addEventListener('pointerdown', (e) => { dragging = true; canvas.setPointerCapture(e.pointerId); dragTo(e); });
  canvas.addEventListener('pointermove', (e) => dragging && dragTo(e));
  const stop = () => (dragging = false);
  canvas.addEventListener('pointerup', stop);
  canvas.addEventListener('pointercancel', stop);

  draw();
</script>

<style>
  #ws {
    cursor: ew-resize;
    touch-action: none;
  }
</style>
