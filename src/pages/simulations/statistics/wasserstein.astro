---
import SimLayout from '../../../layouts/SimLayout.astro';
---

<SimLayout
  areaSlug="statistics"
  title="Wasserstein Distance"
  description="How far apart are two distributions? The Wasserstein (earth mover's) distance measures the least work needed to reshape one pile of probability into the other: mass times distance moved. Unlike overlap, it still knows two distant bumps are far apart."
>
  <div class="sim">
    <div class="sim-stage">
      <canvas id="ws" class="ws-canvas" width="900" height="480"></canvas>
    </div>

    <div class="sim-panel">
      <div class="control">
        <label>Distribution P</label>
        <div class="seg" id="pshape">
          <button data-s="bimodal" class="active">Bimodal</button>
          <button data-s="gauss">Gaussian</button>
          <button data-s="uniform">Uniform</button>
        </div>
      </div>

      <div class="control"><label>Q mean <b id="mval">3.0</b></label><input type="range" id="m" min="5" max="95" value="30" /></div>
      <div class="control"><label>Q spread <b id="sval">1.0</b></label><input type="range" id="s" min="3" max="30" value="10" /></div>

      <div class="readout">
        <div class="row"><span>Wasserstein W₁</span><b id="w1">—</b></div>
        <div class="row"><span>Overlap</span><b id="ovl">—</b></div>
      </div>

      <p style="font-size:.82rem;color:var(--text-faint);margin:0;line-height:1.5">
        Top: the two distributions. Bottom: their running totals (CDFs). The
        shaded area between the CDFs is exactly W₁. Drag the top panel to move Q.
      </p>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Slide <b>Q's mean</b> away from P. The <b>Wasserstein distance grows
      steadily</b> with the gap, because it counts how far the mass has to
      travel, the shaded area between the CDFs stretches with it.
    </li>
    <li>
      Watch <b>Overlap</b> instead: once the two bumps stop touching it hits
      <b>zero and stays there</b>, blind to whether they are near or a mile
      apart. That is why overlap-based losses fail to train generative models.
    </li>
    <li>
      In 1D the distance is simply the <b>area between the two CDFs</b>. Reshape P
      or widen Q and see how spreading mass out, not just moving it, also costs.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas } from '../../../lib/sim';
  import { equationBar } from '../../../lib/equation';

  const NB = 70;
  const XMAX = 10;
  const dx = XMAX / NB;
  const state = { shape: 'bimodal', mean: 3, spread: 1 };

  const setEq = equationBar();
  const canvas = document.getElementById('ws') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const css = (v: string) => getComputedStyle(canvas).getPropertyValue(v).trim();
  const PAD = { l: 40, r: 20 };
  const sx = (x: number) => PAD.l + (x / XMAX) * (W - PAD.l - PAD.r);

  function normalize(a: number[]) {
    let s = 0;
    for (const v of a) s += v;
    if (s > 0) for (let i = 0; i < a.length; i++) a[i] /= s;
    return a;
  }
  function pDist() {
    const a = new Array(NB).fill(0);
    for (let i = 0; i < NB; i++) {
      const x = (i + 0.5) * dx;
      if (state.shape === 'bimodal') a[i] = Math.exp(-((x - 2.5) ** 2) / 0.8) + 0.9 * Math.exp(-((x - 7) ** 2) / 1.1);
      else if (state.shape === 'uniform') a[i] = x >= 2 && x <= 8 ? 1 : 0;
      else a[i] = Math.exp(-((x - 5) ** 2) / 2.2);
    }
    return normalize(a);
  }
  function qDist() {
    const a = new Array(NB).fill(0);
    for (let i = 0; i < NB; i++) {
      const x = (i + 0.5) * dx;
      a[i] = Math.exp(-((x - state.mean) ** 2) / (2 * state.spread * state.spread));
    }
    return normalize(a);
  }

  function draw() {
    const teal = css('--accent-2') || '#5eead4';
    const amber = '#f59e0b';
    const grid = css('--border') || '#262a32';
    const faint = css('--text-faint') || '#6b7280';
    const ink = css('--stage-ink') || '232,233,236';
    ctx.clearRect(0, 0, W, H);

    const p = pDist();
    const q = qDist();
    const cumP: number[] = [];
    const cumQ: number[] = [];
    let cp = 0, cq = 0;
    for (let i = 0; i < NB; i++) { cp += p[i]; cq += q[i]; cumP.push(cp); cumQ.push(cq); }

    // ---- histograms (top) ----
    const topY = 40, topH = 190;
    const pmax = Math.max(...p, ...q) * 1.1;
    const bw = (W - PAD.l - PAD.r) / NB;
    ctx.strokeStyle = grid;
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(PAD.l, topY + topH);
    ctx.lineTo(W - PAD.r, topY + topH);
    ctx.stroke();
    for (let i = 0; i < NB; i++) {
      const x = PAD.l + i * bw;
      const hp = (p[i] / pmax) * topH;
      const hq = (q[i] / pmax) * topH;
      ctx.fillStyle = teal + '99';
      ctx.fillRect(x, topY + topH - hp, bw - 0.5, hp);
      ctx.fillStyle = amber + '99';
      ctx.fillRect(x, topY + topH - hq, bw - 0.5, hq);
    }
    ctx.fillStyle = teal;
    ctx.font = "600 13px 'JetBrains Mono', monospace";
    ctx.fillText('P', PAD.l + 4, topY + 2);
    ctx.fillStyle = amber;
    ctx.fillText('Q', PAD.l + 22, topY + 2);

    // ---- CDFs (bottom) with shaded W1 area ----
    const botY = 268, botH = 180;
    const cy = (c: number) => botY + botH - c * botH;
    // shade area between CDFs
    for (let i = 0; i < NB; i++) {
      const x = PAD.l + i * bw;
      const y1 = cy(cumP[i]), y2 = cy(cumQ[i]);
      ctx.fillStyle = `rgba(245,158,11,0.16)`;
      ctx.fillRect(x, Math.min(y1, y2), bw + 0.5, Math.abs(y1 - y2));
    }
    ctx.strokeStyle = grid;
    ctx.beginPath();
    ctx.moveTo(PAD.l, botY + botH);
    ctx.lineTo(W - PAD.r, botY + botH);
    ctx.stroke();
    const drawCDF = (cum: number[], color: string) => {
      ctx.strokeStyle = color;
      ctx.lineWidth = 2.2;
      ctx.beginPath();
      for (let i = 0; i < NB; i++) {
        const x = PAD.l + (i + 0.5) * bw;
        i === 0 ? ctx.moveTo(x, cy(cum[i])) : ctx.lineTo(x, cy(cum[i]));
      }
      ctx.stroke();
    };
    drawCDF(cumP, teal);
    drawCDF(cumQ, amber);
    ctx.fillStyle = faint;
    ctx.font = "12px 'JetBrains Mono', monospace";
    ctx.fillText('CDFs · shaded area = W₁', PAD.l + 4, botY - 18);

    // x-axis labels
    ctx.fillStyle = faint;
    for (let t = 0; t <= 10; t += 2) ctx.fillText(String(t), sx(t) - 4, botY + botH + 8);

    // metrics
    let w1 = 0, ovl = 0;
    for (let i = 0; i < NB; i++) {
      w1 += Math.abs(cumP[i] - cumQ[i]) * dx;
      ovl += Math.min(p[i], q[i]);
    }
    (document.getElementById('w1') as HTMLElement).textContent = w1.toFixed(3);
    setEq([
      [
        'W_1(p,q) = \\int \\big|',
        [`F_p(x)`, teal],
        '-',
        [`F_q(x)`, amber],
        '\\big|\\,dx',
        '\\quad\\text{the area between them}',
      ],
      [
        `W_1 = ${w1.toFixed(3)}`,
        `\\quad\\text{overlap} = ${ovl.toFixed(3)}`,
      ],
      [
        'move the piles apart and W₁ keeps growing, long after the overlap has hit zero',
      ],
    ]);
    (document.getElementById('ovl') as HTMLElement).textContent = (ovl * 100).toFixed(1) + '%';
    void ink;
  }

  // drag to move Q's mean
  let dragging = false;
  function setMean(e: PointerEvent) {
    const rect = canvas.getBoundingClientRect();
    const x = (((e.clientX - rect.left) / rect.width) * W - PAD.l) / (W - PAD.l - PAD.r) * XMAX;
    state.mean = Math.max(0.5, Math.min(9.5, x));
    (document.getElementById('m') as HTMLInputElement).value = String(Math.round(state.mean * 10));
    (document.getElementById('mval') as HTMLElement).textContent = state.mean.toFixed(1);
    draw();
  }
  canvas.addEventListener('pointerdown', (e) => { dragging = true; canvas.setPointerCapture(e.pointerId); setMean(e); });
  canvas.addEventListener('pointermove', (e) => dragging && setMean(e));
  const stop = () => (dragging = false);
  canvas.addEventListener('pointerup', stop);
  canvas.addEventListener('pointercancel', stop);

  document.getElementById('pshape')!.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn) return;
    document.querySelectorAll('#pshape button').forEach((b) => b.classList.remove('active'));
    btn.classList.add('active');
    state.shape = btn.dataset.s!;
    draw();
  });
  const mEl = document.getElementById('m') as HTMLInputElement;
  mEl.addEventListener('input', () => {
    state.mean = +mEl.value / 10;
    (document.getElementById('mval') as HTMLElement).textContent = state.mean.toFixed(1);
    draw();
  });
  const sEl = document.getElementById('s') as HTMLInputElement;
  sEl.addEventListener('input', () => {
    state.spread = +sEl.value / 10;
    (document.getElementById('sval') as HTMLElement).textContent = state.spread.toFixed(1);
    draw();
  });

  draw();
</script>

<style>
  .ws-canvas {
    cursor: ew-resize;
    touch-action: none;
  }
</style>
