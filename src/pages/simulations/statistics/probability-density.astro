---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Checks from '../../../components/sim/Checks.astro';
import Transport from '../../../components/sim/Transport.astro';
import Actions from '../../../components/sim/Actions.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="statistics"
  title="Probability Density"
  description="A continuous quantity gives no single value any probability, only stretches. A density is the height whose area is that probability. Pick a real distribution, move its parameters, drag a stretch and read the area, and draw samples to watch their histogram settle onto the curve."
  shortcuts={['run', 'reset', 'fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="pd"
          width="1000"
          height="620"
          role="img"
          aria-label="A probability density with a shaded stretch under it, a histogram of samples drawn from it, its mean, median and mode, and its running total below; or a two-dimensional density with a circular region and the two marginal densities."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'the density f', color: '#5eead4' },
          { label: 'the stretch from a to b', color: '#f59e0b' },
          { label: 'running total F', color: '#7c8cff' },
          { label: 'histogram of samples', color: '#c4b5fd' },
        ]}
        hint="Drag either end of the stretch · in two dimensions drag the circle"
      />
      <Result label="P(a ≤ X ≤ b)" />
    </div>

    <div class="sim-panel">
      <Seg id="dim" label="Dimensions" attr="d" options={[{ value: '1', label: 'one' }, { value: '2', label: 'two' }]} />
      <div id="d1wrap">
        <Seg
          id="dist"
          label="Distribution"
          attr="f"
          options={[
            { value: 'normal', label: 'Normal' },
            { value: 'uniform', label: 'Uniform' },
            { value: 'expo', label: 'Exponential' },
            { value: 'gamma', label: 'Gamma' },
            { value: 'beta', label: 'Beta' },
            { value: 'lognormal', label: 'Log-normal' },
            { value: 't', label: 'Student t' },
            { value: 'mix', label: 'Two humps' },
          ]}
        />
        <Slider id="p1" label="μ" min={0} max={1000} value={500} />
        <div id="p2wrap"><Slider id="p2" label="σ" min={0} max={1000} value={500} /></div>
        <Slider id="a" label="From a" min={0} max={1000} value={400} />
        <Slider id="b" label="To b" min={0} max={1000} value={600} />
        <Actions>
          <button type="button" class="btn ghost" id="i-sd">μ ± σ</button>
          <button type="button" class="btn ghost" id="i-2sd">μ ± 2σ</button>
          <button type="button" class="btn ghost" id="i-50">middle 50%</button>
          <button type="button" class="btn ghost" id="i-95">middle 95%</button>
          <button type="button" class="btn ghost" id="shrink">Shrink to a point</button>
        </Actions>
        <Transport />
        <Slider id="bins" label="Histogram bins" min={8} max={160} value={48} />
        <Checks
          label="Show"
          items={[
            { id: 'c-hist', label: 'Histogram of the samples', checked: true },
            { id: 'c-marks', label: 'Mean, median and mode', checked: true },
          ]}
        />
      </div>
      <div id="d2wrap" hidden>
        <Seg
          id="dist2"
          label="Density"
          attr="g"
          options={[
            { value: 'blob', label: 'one blob' },
            { value: 'tilt', label: 'correlated' },
            { value: 'two', label: 'two blobs' },
            { value: 'ring', label: 'ring' },
          ]}
        />
        <Slider id="rr" label="Radius r" min={10} max={300} value={120} display="1.20" />
      </div>
      <Readout
        rows={[
          { id: 'r-tot', label: 'total area in view' },
          { id: 'r-peak', label: 'tallest the density gets' },
          { id: 'r-w', label: 'width b − a' },
          { id: 'r-mean', label: 'mean · standard deviation' },
          { id: 'r-med', label: 'median · mode' },
          { id: 'r-n', label: 'samples drawn' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Shrink the stretch to a point: the area goes to <b>zero</b> while the density there stays healthy. For a
      continuous quantity P(X = c) = 0. <Try id="shrink" label="Animate" />
    </li>
    <li>
      Make the normal narrow and the curve climbs to almost 4, far above 1. A density is probability <b>per unit of
      x</b>, and only its area has to add to 1. <Try id="narrow" />
    </li>
    <li>
      Draw samples. The histogram is scaled so its bars have area too, and it <b>settles onto the curve</b>. More
      bins show more detail but need many more samples to stop jittering. <Try id="samples" label="Run" />
    </li>
    <li>
      The shaded area is exactly the step <b>F(b) − F(a)</b> of the running total below. On the exponential a
      stretch further right holds less. <Try id="decay" />
    </li>
    <li>
      On a skewed density the three centres split: the <b>mean</b> is pulled out along the long tail, the
      <b>median</b> cuts the area in half, the <b>mode</b> sits under the peak. <Try id="skew" />
    </li>
    <li>
      Student t with few degrees of freedom looks like a bell but its tails are <b>much heavier</b>: beyond ±3 it
      holds many times what the normal (dashed) does. <Try id="tails" />
    </li>
    <li>
      In <b>two</b> dimensions the probability is the volume over the circle, and the share of sampled dots inside
      it tracks that volume: Monte Carlo. The curves on the edges are the marginals, the density of x alone and of y
      alone. <Try id="two" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk } from '../../../lib/draw';
  import { el, segmented, slider, check, transport, result, readout, tries } from '../../../lib/panel';

  // --- the families -----------------------------------------------------------
  // Each is a density with up to two parameters over a fixed window, so moving
  // a parameter moves the curve instead of rescaling the axis. Everything else
  // (running total, mean, median, mode, sampling) is read off a fine grid.
  function lgamma(z: number): number {
    if (z < 0.5) return Math.log(Math.PI / Math.abs(Math.sin(Math.PI * z))) - lgamma(1 - z);
    z -= 1;
    const c = [0.99999999999980993, 676.5203681218851, -1259.1392167224028, 771.32342877765313, -176.61502916214059, 12.507343278686905, -0.13857109526572012, 9.9843695780195716e-6, 1.5056327351493116e-7];
    let x = c[0];
    for (let i = 1; i < 9; i++) x += c[i] / (z + i);
    const t = z + 7.5;
    return 0.5 * Math.log(2 * Math.PI) + (z + 0.5) * Math.log(t) - t + Math.log(x);
  }
  const normal = (x: number, m: number, s: number) => Math.exp(-((x - m) ** 2) / (2 * s * s)) / (s * Math.sqrt(2 * Math.PI));

  type Param = { name: string; tex: string; lo: number; hi: number; value: number; log?: boolean };
  type Family = {
    name: string;
    lo: number;
    hi: number;
    params: Param[];
    pdf: (x: number, p: number[]) => number;
    tex: (p: number[]) => string;
    /** A curve drawn dashed for comparison. */
    ghost?: (x: number) => number;
  };
  const f2 = (v: number) => (+v.toFixed(2)).toString();
  const FAM: Record<string, Family> = {
    normal: {
      name: 'normal', lo: -6, hi: 6,
      params: [{ name: 'mean μ', tex: '\\mu', lo: -2, hi: 2, value: 0 }, { name: 'spread σ', tex: '\\sigma', lo: 0.1, hi: 2.5, value: 1, log: true }],
      pdf: (x, [m, s]) => normal(x, m, s),
      tex: ([m, s]) => `X\\sim\\mathcal{N}(${f2(m)},\\ ${f2(s)}^2)`,
    },
    uniform: {
      name: 'uniform', lo: -4, hi: 6,
      params: [{ name: 'starts at', tex: 'a_0', lo: -3, hi: 1, value: -1.5 }, { name: 'width', tex: 'w', lo: 0.3, hi: 5, value: 3 }],
      pdf: (x, [l, w]) => (x >= l && x <= l + w ? 1 / w : 0),
      tex: ([l, w]) => `X\\sim\\mathcal{U}(${f2(l)},\\ ${f2(l + w)})`,
    },
    expo: {
      name: 'exponential', lo: -0.5, hi: 8,
      params: [{ name: 'rate λ', tex: '\\lambda', lo: 0.2, hi: 3, value: 0.8, log: true }],
      pdf: (x, [l]) => (x >= 0 ? l * Math.exp(-l * x) : 0),
      tex: ([l]) => `X\\sim\\mathrm{Exp}(${f2(l)})`,
    },
    gamma: {
      name: 'gamma', lo: -0.5, hi: 20,
      params: [{ name: 'shape k', tex: 'k', lo: 0.5, hi: 8, value: 2, log: true }, { name: 'scale θ', tex: '\\theta', lo: 0.3, hi: 1.5, value: 1, log: true }],
      pdf: (x, [k, t]) => (x > 0 ? Math.exp((k - 1) * Math.log(x) - x / t - lgamma(k) - k * Math.log(t)) : 0),
      tex: ([k, t]) => `X\\sim\\Gamma(${f2(k)},\\ ${f2(t)})`,
    },
    beta: {
      name: 'beta', lo: -0.1, hi: 1.1,
      params: [{ name: 'α', tex: '\\alpha', lo: 0.3, hi: 8, value: 2, log: true }, { name: 'β', tex: '\\beta', lo: 0.3, hi: 8, value: 5, log: true }],
      pdf: (x, [a, b]) => (x > 0 && x < 1 ? Math.exp((a - 1) * Math.log(x) + (b - 1) * Math.log(1 - x) + lgamma(a + b) - lgamma(a) - lgamma(b)) : 0),
      tex: ([a, b]) => `X\\sim\\mathrm{Beta}(${f2(a)},\\ ${f2(b)})`,
    },
    lognormal: {
      name: 'log-normal', lo: -0.5, hi: 12,
      params: [{ name: 'μ of ln X', tex: '\\mu', lo: -1, hi: 1.5, value: 0.3 }, { name: 'σ of ln X', tex: '\\sigma', lo: 0.15, hi: 1.4, value: 0.7, log: true }],
      pdf: (x, [m, s]) => (x > 0 ? normal(Math.log(x), m, s) / x : 0),
      tex: ([m, s]) => `\\ln X\\sim\\mathcal{N}(${f2(m)},\\ ${f2(s)}^2)`,
    },
    t: {
      name: 'Student t', lo: -7, hi: 7,
      params: [{ name: 'degrees of freedom ν', tex: '\\nu', lo: 0.6, hi: 40, value: 2, log: true }],
      pdf: (x, [n]) => Math.exp(lgamma((n + 1) / 2) - lgamma(n / 2) - 0.5 * Math.log(n * Math.PI) - ((n + 1) / 2) * Math.log(1 + (x * x) / n)),
      tex: ([n]) => `X\\sim t_{${f2(n)}}`,
      ghost: (x) => normal(x, 0, 1),
    },
    mix: {
      name: 'mixture of two bells', lo: -6, hi: 6,
      params: [{ name: 'gap between the humps', tex: 'd', lo: 0, hi: 5, value: 2.9 }, { name: 'weight of the left hump', tex: 'w', lo: 0.05, hi: 0.95, value: 0.55 }],
      pdf: (x, [d, w]) => w * normal(x, -d / 2, 0.7) + (1 - w) * normal(x, d / 2, 1),
      tex: ([d, w]) => `X\\sim ${f2(w)}\\,\\mathcal{N}(${f2(-d / 2)},0.7^2)+${f2(1 - w)}\\,\\mathcal{N}(${f2(d / 2)},1)`,
    },
  };

  const state = {
    dim: 1 as 1 | 2, fam: 'normal', p: [0, 1] as number[], a: -1, b: 1,
    d2: 'blob', cx: 0.2, cy: 0.1, r: 1.2,
    bins: 48, hist: true, marks: true, running: false,
  };

  const canvas = el('pd') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink, inv } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();
  const DEN = '#5eead4', AREA = '#f59e0b', CDF = '#7c8cff', HIST = '#c4b5fd', MEAN = '#f472b6', MED = '#7c8cff', MODE = '#5eead4';
  const fmt = (v: number, n = 4) => (Math.abs(v) < 0.5 * 10 ** -n ? 0 : v).toFixed(n).replace('-', '−');

  // --- the grid ---------------------------------------------------------------
  const G = 1600;
  let xs = new Float64Array(G + 1), fx = new Float64Array(G + 1), Fx = new Float64Array(G + 1);
  let stats = { mean: 0, sd: 1, median: 0, mode: 0, peak: 1, total: 1 };
  const fam = () => FAM[state.fam];
  function tabulate() {
    const d = fam(), h = (d.hi - d.lo) / G;
    xs = new Float64Array(G + 1); fx = new Float64Array(G + 1); Fx = new Float64Array(G + 1);
    for (let i = 0; i <= G; i++) { xs[i] = d.lo + i * h; fx[i] = d.pdf(xs[i], state.p); if (!isFinite(fx[i])) fx[i] = 0; }
    // the running total, by cells: the area of each cell from its midpoint (no trouble with infinite ends)
    let acc = 0, m1 = 0, m2 = 0, peak = 0, mode = xs[0];
    for (let i = 1; i <= G; i++) {
      const xm = xs[i] - h / 2;
      const a = Math.max(0, d.pdf(xm, state.p)) * h;
      acc += isFinite(a) ? a : 0;
      Fx[i] = acc;
      m1 += xm * a;
      m2 += xm * xm * a;
    }
    for (let i = 0; i <= G; i++) if (fx[i] > peak) { peak = fx[i]; mode = xs[i]; }
    const total = acc;
    const mean = m1 / total;
    stats = { mean, sd: Math.sqrt(Math.max(0, m2 / total - mean * mean)), median: quantile(0.5 * total), mode, peak, total };
  }
  /** x where the running total reaches `F`. */
  function quantile(F: number) {
    let lo = 0, hi = G;
    while (hi - lo > 1) { const m = (lo + hi) >> 1; if (Fx[m] < F) lo = m; else hi = m; }
    const t = (F - Fx[lo]) / Math.max(1e-300, Fx[hi] - Fx[lo]);
    return xs[lo] + t * (xs[hi] - xs[lo]);
  }
  function Fat(x: number) {
    const d = fam();
    const u = ((x - d.lo) / (d.hi - d.lo)) * G;
    if (u <= 0) return 0;
    if (u >= G) return Fx[G];
    const i = Math.floor(u), t = u - i;
    return Fx[i] + t * (Fx[i + 1] - Fx[i]);
  }

  // --- samples --------------------------------------------------------------------
  let samples: number[] = [];
  let fresh: { x: number; age: number }[] = [];
  function drawSamples(n: number) {
    for (let k = 0; k < n; k++) {
      const x = quantile(Math.random() * stats.total);
      samples.push(x);
      if (fresh.length < 80) fresh.push({ x, age: 0 });
    }
  }

  // --- one dimension --------------------------------------------------------
  const P1 = { x: 56, y: 34, w: W - 96, h: 320 };
  const P2 = { x: 56, y: 470, w: W - 96, h: 120 };
  let yTop = 0.5;

  function drawOne() {
    const d = fam();
    const sx = (x: number) => P1.x + ((x - d.lo) / (d.hi - d.lo)) * P1.w;
    // the vertical scale eases, so a parameter change is seen as a change
    const want = Math.max(0.12, Math.min(stats.peak, 12) * 1.18);
    yTop += (want - yTop) * 0.25;
    if (Math.abs(want - yTop) > 1e-3) needsFrame = true;
    const sy = (v: number) => P1.y + P1.h - (Math.min(v, yTop * 1.05) / yTop) * P1.h;

    label(`f(x): ${d.name}`, P1.x, P1.y - 12, 0.5, 'left', 11.5);
    ctx.strokeStyle = ink(0.14);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(P1.x, P1.y + P1.h);
    ctx.lineTo(P1.x + P1.w, P1.y + P1.h);
    ctx.stroke();
    // y ticks
    const step = yTop > 4 ? 1 : yTop > 1.6 ? 0.5 : yTop > 0.6 ? 0.2 : 0.1;
    for (let v = step; v < yTop; v += step) {
      ctx.strokeStyle = ink(Math.abs(v - 1) < 1e-9 ? 0.18 : 0.06);
      ctx.setLineDash(Math.abs(v - 1) < 1e-9 ? [4, 4] : []);
      ctx.beginPath();
      ctx.moveTo(P1.x, sy(v));
      ctx.lineTo(P1.x + P1.w, sy(v));
      ctx.stroke();
      ctx.setLineDash([]);
      label(fmt(v, step < 0.2 ? 1 : step < 1 ? 1 : 0), P1.x - 8, sy(v) + 4, 0.35, 'right', 10);
    }
    // x ticks, at round numbers
    const span = d.hi - d.lo;
    const xstep = span > 15 ? 2 : span > 6 ? 1 : span > 2 ? 0.5 : 0.1;
    for (let x = Math.ceil(d.lo / xstep) * xstep; x <= d.hi + 1e-9; x += xstep) label(fmt(x, xstep < 1 ? 1 : 0), sx(x), P1.y + P1.h + 16, 0.35, 'center', 10);

    // histogram, scaled to density
    if (state.hist && samples.length) {
      const nb = state.bins, bw = span / nb, counts = new Array(nb).fill(0);
      for (const x of samples) { const k = Math.floor((x - d.lo) / bw); if (k >= 0 && k < nb) counts[k]++; }
      ctx.fillStyle = 'rgba(196,181,253,0.26)';
      ctx.strokeStyle = 'rgba(196,181,253,0.55)';
      ctx.lineWidth = 1;
      counts.forEach((c, k) => {
        if (!c) return;
        const h = c / (samples.length * bw);
        const x0 = sx(d.lo + k * bw), x1 = sx(d.lo + (k + 1) * bw);
        ctx.fillRect(x0, sy(h), x1 - x0 - 0.5, P1.y + P1.h - sy(h));
        ctx.strokeRect(x0 + 0.5, sy(h) + 0.5, x1 - x0 - 1.5, P1.y + P1.h - sy(h) - 0.5);
      });
    }
    // the stretch
    const a = Math.min(state.a, state.b), b = Math.max(state.a, state.b);
    ctx.beginPath();
    ctx.moveTo(sx(a), P1.y + P1.h);
    for (let i = 0; i <= 400; i++) {
      const x = a + ((b - a) * i) / 400;
      ctx.lineTo(sx(x), sy(d.pdf(x, state.p)));
    }
    ctx.lineTo(sx(b), P1.y + P1.h);
    ctx.closePath();
    ctx.fillStyle = 'rgba(245,158,11,0.32)';
    ctx.fill();
    // comparison curve
    if (d.ghost) {
      ctx.strokeStyle = ink(0.45);
      ctx.lineWidth = 1.4;
      ctx.setLineDash([5, 5]);
      ctx.beginPath();
      for (let i = 0; i <= 600; i++) { const x = d.lo + (span * i) / 600; i ? ctx.lineTo(sx(x), sy(d.ghost(x))) : ctx.moveTo(sx(x), sy(d.ghost(x))); }
      ctx.stroke();
      ctx.setLineDash([]);
      label('normal, for comparison', sx(1.3), sy(d.ghost(1.3)) - 8, 0.5, 'left', 10);
    }
    // the density
    ctx.strokeStyle = DEN;
    ctx.lineWidth = 2.6;
    ctx.lineJoin = 'round';
    ctx.beginPath();
    for (let i = 0; i <= G; i += 2) (i ? ctx.lineTo(sx(xs[i]), sy(fx[i])) : ctx.moveTo(sx(xs[i]), sy(fx[i])));
    ctx.stroke();
    // samples as they land
    for (const s of fresh) {
      ctx.fillStyle = `rgba(196,181,253,${0.9 * (1 - s.age)})`;
      ctx.fillRect(sx(s.x) - 0.75, P1.y + P1.h - 14 + s.age * 10, 1.5, 9);
    }
    // the handles
    for (const [x, name] of [[a, 'a'], [b, 'b']] as [number, string][]) {
      ctx.strokeStyle = AREA;
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(sx(x), P1.y + 6);
      ctx.lineTo(sx(x), P1.y + P1.h);
      ctx.stroke();
      ctx.fillStyle = AREA;
      ctx.beginPath();
      ctx.arc(sx(x), P1.y + P1.h, 5.5, 0, Math.PI * 2);
      ctx.fill();
      if (name === 'b' || sx(b) - sx(a) > 16) label(name, sx(x), P1.y, 1, 'center', 11, AREA);
    }
    const p = Fat(b) - Fat(a);
    // the area, on a dark tag so it reads over the fill
    const tag = `area ${fmt(p, 3)}`;
    const tx = Math.max(P1.x + 50, Math.min(P1.x + P1.w - 50, (sx(a) + sx(b)) / 2)), ty = P1.y + P1.h - 30;
    ctx.fillStyle = inv(0.78);
    ctx.fillRect(tx - 48, ty - 14, 96, 20);
    label(tag, tx, ty, 1, 'center', 11, AREA);
    // mean, median, mode
    if (state.marks) {
      const marks: [number, string, string][] = [[stats.mean, 'mean', MEAN], [stats.median, 'median', MED], [stats.mode, 'mode', MODE]];
      marks.sort((u, v) => u[0] - v[0]);
      let lastX = -1e9, row = 0;
      for (const [x, name, col] of marks) {
        const X = sx(x);
        row = X - lastX < 46 ? row + 1 : 0;
        lastX = X;
        ctx.fillStyle = col;
        ctx.beginPath();
        ctx.moveTo(X, P1.y + P1.h + 22);
        ctx.lineTo(X - 5, P1.y + P1.h + 30);
        ctx.lineTo(X + 5, P1.y + P1.h + 30);
        ctx.closePath();
        ctx.fill();
        label(name, X, P1.y + P1.h + 42 + row * 12, 1, 'center', 9, col);
      }
    }

    // the running total underneath
    label('F(x): the running total of the area, so the shaded area is a step F(b) − F(a)', P2.x, P2.y - 10, 0.5, 'left', 11.5);
    const fy = (v: number) => P2.y + P2.h - v * P2.h;
    ctx.strokeStyle = ink(0.14);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(P2.x, P2.y + P2.h);
    ctx.lineTo(P2.x + P2.w, P2.y + P2.h);
    ctx.moveTo(P2.x, fy(1));
    ctx.lineTo(P2.x + P2.w, fy(1));
    ctx.stroke();
    label('1', P2.x - 8, fy(1) + 4, 0.35, 'right', 10);
    label('0', P2.x - 8, fy(0) + 4, 0.35, 'right', 10);
    const xp = (x: number) => P2.x + ((x - d.lo) / span) * P2.w;
    ctx.strokeStyle = CDF;
    ctx.lineWidth = 2.4;
    ctx.beginPath();
    for (let i = 0; i <= G; i += 2) (i ? ctx.lineTo(xp(xs[i]), fy(Fx[i])) : ctx.moveTo(xp(xs[i]), fy(Fx[i])));
    ctx.stroke();
    // the share of samples to the left, as a staircase, when there are samples
    if (state.hist && samples.length > 1) {
      const s = [...samples].sort((u, v) => u - v);
      ctx.strokeStyle = 'rgba(196,181,253,0.7)';
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      const stepN = Math.max(1, Math.floor(s.length / 400));
      ctx.moveTo(P2.x, fy(0));
      for (let k = 0; k < s.length; k += stepN) ctx.lineTo(xp(s[k]), fy(k / s.length));
      ctx.lineTo(P2.x + P2.w, fy(1));
      ctx.stroke();
    }
    const fa = Fat(a), fb = Fat(b);
    ctx.strokeStyle = AREA;
    ctx.lineWidth = 2;
    ctx.setLineDash([3, 3]);
    for (const x of [a, b]) {
      ctx.beginPath();
      ctx.moveTo(xp(x), P2.y + P2.h);
      ctx.lineTo(xp(x), fy(Fat(x)));
      ctx.stroke();
    }
    ctx.setLineDash([]);
    ctx.lineWidth = 6;
    ctx.beginPath();
    ctx.moveTo(xp(b), fy(fa));
    ctx.lineTo(xp(b), fy(fb));
    ctx.stroke();
    const right = xp(b) < P2.x + P2.w - 200;
    label(`F(b) − F(a) = ${fmt(fb - fa, 3)}`, xp(b) + (right ? 10 : -10), (fy(fa) + fy(fb)) / 2 + 4, 1, right ? 'left' : 'right', 11, AREA);
    return { p, a, b };
  }

  // --- two dimensions -------------------------------------------------------
  type D2 = { f: (x: number, y: number) => number; name: string };
  const G2: Record<string, D2> = {
    blob: { f: (x, y) => Math.exp(-(x * x + y * y) / 1.6), name: 'one round blob' },
    tilt: { f: (x, y) => Math.exp(-(x * x - 1.5 * x * y + y * y) / (2 * (1 - 0.5625)) / 1.1), name: 'a correlated bell, ρ = 0.75' },
    two: { f: (x, y) => Math.exp(-((x + 1.1) ** 2 + (y + 0.6) ** 2) / 0.9) + 0.8 * Math.exp(-((x - 1.2) ** 2 + (y - 0.9) ** 2) / 1.4), name: 'two blobs' },
    ring: { f: (x, y) => Math.exp(-((Math.hypot(x, y) - 1.5) ** 2) / 0.25), name: 'a ring' },
  };
  const cur2 = () => G2[state.d2];
  const DOM = 3, N2 = 240;
  const S2 = { x: 300, y: 112, s: 440 };
  const px2 = (x: number) => S2.x + ((x + DOM) / (2 * DOM)) * S2.s;
  const py2 = (y: number) => S2.y + ((DOM - y) / (2 * DOM)) * S2.s;
  const ix2 = (p: number) => ((p - S2.x) / S2.s) * 2 * DOM - DOM;
  const iy2 = (p: number) => DOM - ((p - S2.y) / S2.s) * 2 * DOM;

  // the density on a grid, normalised, with its two marginals
  let grid2 = new Float64Array(N2 * N2), margX = new Float64Array(N2), margY = new Float64Array(N2), peak2 = 1;
  let image2: HTMLCanvasElement | null = null;
  const h2 = (2 * DOM) / N2;
  function calibrate2() {
    let s = 0;
    for (let j = 0; j < N2; j++)
      for (let i = 0; i < N2; i++) {
        const v = cur2().f(-DOM + h2 * (i + 0.5), DOM - h2 * (j + 0.5));
        grid2[j * N2 + i] = v;
        s += v;
      }
    const norm = 1 / (s * h2 * h2);
    peak2 = 0;
    margX = new Float64Array(N2); margY = new Float64Array(N2);
    for (let j = 0; j < N2; j++)
      for (let i = 0; i < N2; i++) {
        const v = (grid2[j * N2 + i] *= norm);
        peak2 = Math.max(peak2, v);
        margX[i] += v * h2;
        margY[j] += v * h2;
      }
    // the density as a smooth image
    image2 = document.createElement('canvas');
    image2.width = image2.height = N2;
    const c = image2.getContext('2d')!, img = c.createImageData(N2, N2);
    for (let k = 0; k < N2 * N2; k++) {
      const t = Math.pow(grid2[k] / peak2, 0.8);
      img.data[k * 4] = 94; img.data[k * 4 + 1] = 234; img.data[k * 4 + 2] = 212;
      img.data[k * 4 + 3] = Math.round(255 * (0.04 + 0.66 * t) * (t > 0.01 ? 1 : t * 100));
    }
    c.putImageData(img, 0, 0);
  }
  function area2() {
    let s = 0;
    for (let j = 0; j < N2; j++) {
      const y = DOM - h2 * (j + 0.5);
      for (let i = 0; i < N2; i++) {
        const x = -DOM + h2 * (i + 0.5);
        if (Math.hypot(x - state.cx, y - state.cy) <= state.r) s += grid2[j * N2 + i];
      }
    }
    return s * h2 * h2;
  }
  let dots: { x: number; y: number }[] = [];
  function sample2() {
    dots = [];
    let guard = 0;
    while (dots.length < 2200 && guard++ < 400000) {
      const x = -DOM + 2 * DOM * Math.random(), y = -DOM + 2 * DOM * Math.random();
      const i = Math.floor((x + DOM) / h2), j = Math.floor((DOM - y) / h2);
      if (Math.random() * peak2 < grid2[j * N2 + i]) dots.push({ x, y });
    }
  }

  function drawTwo() {
    label(`f(x, y): ${cur2().name}`, S2.x, S2.y - 92, 0.5, 'left', 11.5);
    if (image2) {
      ctx.imageSmoothingEnabled = true;
      ctx.drawImage(image2, S2.x, S2.y, S2.s, S2.s);
    }
    let inside = 0;
    for (const p of dots) {
      const hit = Math.hypot(p.x - state.cx, p.y - state.cy) <= state.r;
      if (hit) inside++;
      ctx.fillStyle = hit ? 'rgba(245,158,11,0.9)' : ink(0.3);
      ctx.beginPath();
      ctx.arc(px2(p.x), py2(p.y), 1.5, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.strokeStyle = ink(0.16);
    ctx.lineWidth = 1;
    ctx.strokeRect(S2.x, S2.y, S2.s, S2.s);
    ctx.strokeStyle = AREA;
    ctx.lineWidth = 2.4;
    ctx.beginPath();
    ctx.arc(px2(state.cx), py2(state.cy), (state.r / (2 * DOM)) * S2.s, 0, Math.PI * 2);
    ctx.stroke();
    ctx.fillStyle = 'rgba(245,158,11,0.08)';
    ctx.fill();
    ctx.fillStyle = AREA;
    ctx.beginPath();
    ctx.arc(px2(state.cx), py2(state.cy), 3.5, 0, Math.PI * 2);
    ctx.fill();
    for (const v of [-DOM, 0, DOM]) {
      label(String(v), px2(v), S2.y + S2.s + 16, 0.35, 'center', 10);
      label(String(v), S2.x - 8, py2(v) + 4, 0.35, 'right', 10);
    }
    // the marginals: the density of x alone on top, of y alone on the right
    const mtop = Math.max(...margX, ...margY), mh = 70;
    ctx.strokeStyle = DEN;
    ctx.fillStyle = 'rgba(94,234,212,0.14)';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(S2.x, S2.y - 8);
    for (let i = 0; i < N2; i++) ctx.lineTo(S2.x + ((i + 0.5) / N2) * S2.s, S2.y - 8 - (margX[i] / mtop) * mh);
    ctx.lineTo(S2.x + S2.s, S2.y - 8);
    ctx.fill();
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(S2.x + S2.s + 8, S2.y);
    for (let j = 0; j < N2; j++) ctx.lineTo(S2.x + S2.s + 8 + (margY[j] / mtop) * mh, S2.y + ((j + 0.5) / N2) * S2.s);
    ctx.lineTo(S2.x + S2.s + 8, S2.y + S2.s);
    ctx.fill();
    ctx.stroke();
    label('f(x) = ∫ f(x, y) dy', S2.x + S2.s + 14, S2.y - 30, 0.55, 'left', 10.5);
    label('f(y) = ∫ f(x, y) dx', S2.x + S2.s + 14, S2.y + S2.s + 16, 0.55, 'left', 10.5);
    return { p: area2(), inside };
  }

  // --- the words --------------------------------------------------------------
  let needsFrame = false;
  function draw() {
    ctx.clearRect(0, 0, W, H);
    if (state.dim === 1) {
      const { p, a, b } = drawOne();
      const d = fam();
      let inAB = 0;
      for (const x of samples) if (x >= a && x <= b) inAB++;
      setEq({
        rule: [['P(a \\le X \\le b)', AREA], '= \\displaystyle\\int_a^b', ['f(x)', DEN], '\\,dx = ', ['F(b) - F(a)', CDF]],
        live: [[d.tex(state.p), DEN], [`\\quad P(${fmt(a, 2)} \\le X \\le ${fmt(b, 2)}) = ${fmt(p)}`, AREA]],
      });
      el('result-label').textContent = 'P(a ≤ X ≤ b)';
      setResult({
        value: fmt(p),
        colour: AREA,
        status: samples.length
          ? `${inAB} of ${samples.length} samples fell between a and b: ${fmt(inAB / samples.length, 4)}`
          : `from ${fmt(a, 2)} to ${fmt(b, 2)} · width ${fmt(b - a, 3)} · press Run to draw samples`,
        note: 'A single value has no width, so it has no probability at all: P(X = c) = 0. The height may be anything; only the total area is 1.',
      });
      el('r-w').previousElementSibling!.textContent = 'width b − a';
      setRows({
        'r-tot': fmt(stats.total),
        'r-peak': isFinite(stats.peak) ? fmt(stats.peak, 3) : '∞',
        'r-w': fmt(b - a, 3),
        'r-mean': `${fmt(stats.mean, 3)} · ${fmt(stats.sd, 3)}${state.fam === 't' && state.p[0] <= 2 ? ' (the true σ is infinite)' : ''}`,
        'r-med': `${fmt(stats.median, 3)} · ${fmt(stats.mode, 3)}`,
        'r-n': String(samples.length),
      });
    } else {
      const { p, inside } = drawTwo();
      setEq({
        rule: [['P\\big((X,Y)\\in R\\big)', AREA], '= \\displaystyle\\iint_R', ['f(x,y)', DEN], '\\,dx\\,dy'],
        live: [[`P = ${fmt(p)}`, AREA], `\\quad r = ${state.r.toFixed(2)}`],
      });
      el('result-label').textContent = 'P((X, Y) in R)';
      setResult({
        value: fmt(p),
        colour: AREA,
        status: `centre (${state.cx.toFixed(2)}, ${state.cy.toFixed(2)}), r = ${state.r.toFixed(2)} · ${inside} of ${dots.length} draws inside (${fmt(dots.length ? inside / dots.length : 0, 3)})`,
        note: 'The dots are draws from f. The share caught inside the circle chases the integral, which is all Monte Carlo ever does.',
      });
      el('r-w').previousElementSibling!.textContent = 'radius r';
      setRows({ 'r-tot': '1.0000', 'r-peak': fmt(peak2, 3), 'r-w': fmt(state.r, 3), 'r-mean': '—', 'r-med': '—', 'r-n': String(dots.length) });
    }
  }

  // --- controls -------------------------------------------------------------
  // parameter sliders run 0..1000 over each parameter's range, on a log scale where that reads better
  const toVal = (q: Param, v: number) => (q.log ? q.lo * (q.hi / q.lo) ** (v / 1000) : q.lo + ((q.hi - q.lo) * v) / 1000);
  const toPos = (q: Param, x: number) => Math.round(q.log ? (1000 * Math.log(x / q.lo)) / Math.log(q.hi / q.lo) : (1000 * (x - q.lo)) / (q.hi - q.lo));
  const paramFmt = (k: number) => (v: number) => { const q = fam().params[k]; return q ? f2(toVal(q, v)) : ''; };
  const setP1 = slider('p1', (v) => { state.p[0] = toVal(fam().params[0], v); changed(); }, paramFmt(0));
  const setP2 = slider('p2', (v) => { const q = fam().params[1]; if (q) { state.p[1] = toVal(q, v); changed(); } }, paramFmt(1));
  const xOf = (v: number) => fam().lo + ((fam().hi - fam().lo) * v) / 1000;
  const posOf = (x: number) => Math.round((1000 * (x - fam().lo)) / (fam().hi - fam().lo));
  const setA = slider('a', (v) => { state.a = xOf(v); draw(); }, (v) => fmt(xOf(v), 2));
  const setB = slider('b', (v) => { state.b = xOf(v); draw(); }, (v) => fmt(xOf(v), 2));
  const setR = slider('rr', (v) => { state.r = v / 100; draw(); }, (v) => (v / 100).toFixed(2));
  const setBins = slider('bins', (v) => { state.bins = v; draw(); });
  const pushAB = () => { setA(posOf(state.a)); setB(posOf(state.b)); };
  check('c-hist', (on) => { state.hist = on; draw(); });
  check('c-marks', (on) => { state.marks = on; draw(); });

  function changed() {
    tabulate();
    samples = [];
    fresh = [];
    draw();
  }
  function setFamily(name: string, p?: number[]) {
    state.fam = name;
    const d = fam();
    state.p = p ?? d.params.map((q) => q.value);
    d.params.forEach((q, k) => {
      const lab = el(k ? 'p2' : 'p1').closest('.control')!.querySelector('label span')!;
      lab.textContent = q.name;
    });
    el('p2wrap').hidden = d.params.length < 2;
    setP1(toPos(d.params[0], state.p[0]));
    if (d.params[1]) setP2(toPos(d.params[1], state.p[1]));
    tabulate();
    samples = [];
    fresh = [];
    interval(0.5);
  }
  /** The middle `share` of the area. */
  function interval(share: number) {
    state.a = quantile(((1 - share) / 2) * stats.total);
    state.b = quantile(((1 + share) / 2) * stats.total);
    pushAB();
    draw();
  }
  function around(k: number) {
    const d = fam();
    state.a = Math.max(d.lo, stats.mean - k * stats.sd);
    state.b = Math.min(d.hi, stats.mean + k * stats.sd);
    pushAB();
    draw();
  }
  el('i-sd').addEventListener('click', () => around(1));
  el('i-2sd').addEventListener('click', () => around(2));
  el('i-50').addEventListener('click', () => interval(0.5));
  el('i-95').addEventListener('click', () => interval(0.95));

  function setDim(dim: 1 | 2) {
    state.dim = dim;
    if (dim === 2) { calibrate2(); sample2(); }
    el('d1wrap').hidden = dim !== 1;
    el('d2wrap').hidden = dim !== 2;
  }
  const dims = segmented('dim', (v) => { setDim(+v as 1 | 2); draw(); });
  const dists = segmented('dist', (v) => setFamily(v));
  const dists2 = segmented('dist2', (v) => { state.d2 = v; calibrate2(); sample2(); draw(); });
  const run = transport({
    onRun: (on) => { state.running = on; },
    onReset: () => { samples = []; fresh = []; state.running = false; run.setRunning(false); draw(); },
  });

  let shrinking = false;
  function shrink() {
    shrinking = true;
  }
  el('shrink').addEventListener('click', shrink);

  function show1(name: string, p?: number[], ab?: [number, number]) {
    shrinking = false;
    setDim(1);
    dims.select('1');
    dists.select(name);
    setFamily(name, p);
    if (ab) { state.a = ab[0]; state.b = ab[1]; pushAB(); }
    draw();
  }
  tries({
    shrink: () => { show1('normal', [0, 1], [-1, 1]); shrink(); },
    narrow: () => show1('normal', [0, 0.1], [-0.1, 0.1]),
    samples: () => { show1(state.dim === 1 ? state.fam : 'normal', state.dim === 1 ? state.p : undefined); state.bins = 48; setBins(48); state.running = true; run.setRunning(true); },
    decay: () => show1('expo', [0.8], [2.5, 3.5]),
    skew: () => show1('lognormal', [0.3, 0.8]),
    tails: () => show1('t', [1.5], [3, 7]),
    two: () => {
      state.d2 = 'tilt';
      dists2.select('tilt');
      Object.assign(state, { cx: 0.6, cy: 0.5, r: 1 });
      setR(100);
      setDim(2);
      dims.select('2');
      draw();
    },
  });

  // drag: the handles in 1D, the region in 2D
  let drag: 'a' | 'b' | 'c' | null = null;
  const mouse = (e: PointerEvent) => {
    const r = canvas.getBoundingClientRect();
    return { x: ((e.clientX - r.left) / r.width) * W, y: ((e.clientY - r.top) / r.height) * H };
  };
  canvas.addEventListener('pointerdown', (e) => {
    const { x, y } = mouse(e);
    try { canvas.setPointerCapture(e.pointerId); } catch { /* synthetic pointers are fine to ignore */ }
    shrinking = false;
    if (state.dim === 1) {
      if (x < P1.x - 10 || x > P1.x + P1.w + 10 || y > P1.y + P1.h + 20) return;
      const d = fam();
      const xv = d.lo + ((x - P1.x) / P1.w) * (d.hi - d.lo);
      drag = Math.abs(xv - state.a) < Math.abs(xv - state.b) ? 'a' : 'b';
      state[drag] = xv;
      pushAB();
    } else {
      if (x < S2.x || x > S2.x + S2.s || y < S2.y || y > S2.y + S2.s) return;
      drag = 'c';
      state.cx = ix2(x);
      state.cy = iy2(y);
    }
    draw();
  });
  canvas.addEventListener('pointermove', (e) => {
    if (!drag) return;
    const { x, y } = mouse(e);
    if (drag === 'c') {
      state.cx = ix2(x);
      state.cy = iy2(y);
    } else {
      const d = fam();
      state[drag] = Math.max(d.lo, Math.min(d.hi, d.lo + ((x - P1.x) / P1.w) * (d.hi - d.lo)));
      pushAB();
    }
    draw();
  });
  const drop = () => (drag = null);
  canvas.addEventListener('pointerup', drop);
  canvas.addEventListener('pointercancel', drop);

  let last = 0;
  function loop(ts: number) {
    const dt = last ? Math.min(0.05, (ts - last) / 1000) : 0;
    last = ts;
    let redraw = needsFrame;
    needsFrame = false;
    if (state.running && state.dim === 1) {
      // slow at first so single samples can be seen landing, then faster
      const n = samples.length;
      drawSamples(n < 40 ? (Math.random() < 0.3 ? 1 : 0) : n < 400 ? 3 : n < 5000 ? 25 : n < 50000 ? 120 : 0);
      if (samples.length >= 50000) { state.running = false; run.setRunning(false); }
      redraw = true;
    }
    if (fresh.length) {
      for (const s of fresh) s.age += dt * 1.5;
      fresh = fresh.filter((s) => s.age < 1);
      redraw = true;
    }
    if (shrinking) {
      if (state.dim === 1) {
        const mid = (state.a + state.b) / 2;
        state.a += (mid - state.a) * 0.08;
        state.b += (mid - state.b) * 0.08;
        pushAB();
        if (Math.abs(state.b - state.a) < 0.004) shrinking = false;
      } else {
        state.r *= 0.93;
        setR(Math.round(state.r * 100));
        if (state.r < 0.1) shrinking = false;
      }
      redraw = true;
    }
    if (redraw) draw();
    requestAnimationFrame(loop);
  }

  setFamily('normal', [0, 1]);
  state.a = -1;
  state.b = 1;
  pushAB();
  draw();
  requestAnimationFrame(loop);
</script>

<style>
  #pd {
    cursor: crosshair;
    touch-action: none;
  }
  :global(#dist button),
  :global(#dist2 button) {
    font-size: 0.76rem;
    padding: 5px 8px;
  }
</style>
