---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
---

<SimLayout
  areaSlug="statistics"
  title="Probability Density"
  description="A continuous quantity gives no single value any probability, only stretches. A density is the height whose area is that probability. Drag the stretch and read the area."
  shortcuts={['animate', 'fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="pd"
          width="1000"
          height="600"
          role="img"
          aria-label="A probability density with a shaded stretch under it and its running total below, or a two-dimensional density with a circular region over it."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'the density f', color: '#5eead4' },
          { label: 'the piece you chose', color: '#f59e0b' },
          { label: 'running total F', color: '#7c8cff' },
        ]}
        hint="Drag either end of the stretch · in two dimensions drag the circle"
      />
      <Result label="P(a ≤ X ≤ b)" />
    </div>

    <div class="sim-panel">
      <Seg id="dim" label="Dimensions" attr="d" options={[{ value: '1', label: 'one' }, { value: '2', label: 'two' }]} />
      <div id="d1wrap">
        <Seg
          id="dist"
          label="Density"
          attr="f"
          options={[
            { value: 'normal', label: 'bell' },
            { value: 'uniform', label: 'flat' },
            { value: 'expo', label: 'decay' },
            { value: 'two', label: 'two humps' },
            { value: 'spike', label: 'narrow' },
            { value: 'tri', label: 'triangle' },
          ]}
        />
        <Slider id="a" label="From a" min={-400} max={400} value={-100} display="−1.00" />
        <Slider id="b" label="To b" min={-400} max={400} value={100} display="1.00" />
      </div>
      <div id="d2wrap" hidden>
        <Seg
          id="dist2"
          label="Density"
          attr="g"
          options={[{ value: 'blob', label: 'one blob' }, { value: 'two', label: 'two blobs' }, { value: 'ring', label: 'ring' }]}
        />
        <Slider id="rr" label="Radius r" min={10} max={300} value={120} display="1.20" />
      </div>
      <Transport animate="Shrink it to a point" reset={false} />
      <Readout
        rows={[
          { id: 'r-tot', label: 'total area' },
          { id: 'r-peak', label: 'tallest the density gets' },
          { id: 'r-w', label: 'width b − a' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Press <b>Shrink it to a point</b>. The shaded area collapses and the
      probability goes to <b>zero</b>, even though the density there is perfectly
      healthy. For a continuous quantity, <b>P(X = c) = 0</b> always, and that is
      not a paradox: it takes a stretch to hold any probability.
    </li>
    <li>
      Pick <b>narrow</b>. The curve shoots past <b>height 4</b>, which no
      probability may do. A density is not a probability; it is probability
      <b>per unit of x</b>, and only its area has to behave.
    </li>
    <li>
      The curve underneath is the running total, the <b>CDF</b>. The shaded area
      upstairs is exactly the vertical step F(b) − F(a) downstairs. Two pictures
      of one number.
    </li>
    <li>
      Try <b>decay</b> and slide the stretch to the right. Equal widths keep
      giving smaller probabilities, because the density is what changes, never the
      width.
    </li>
    <li>
      Switch to <b>two</b> dimensions. Now the density is a height over the
      plane, the region is a patch of ground, and the probability is the volume
      standing on it. Every one-dimensional idea survives with an extra integral.
    </li>
    <li>
      In two dimensions, watch the dots as you move the circle. The share of dots
      caught inside tracks the integral, which is exactly what makes Monte Carlo
      work.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk } from '../../../lib/draw';
  import { el, segmented, slider, result, readout } from '../../../lib/panel';

  type D1 = { f: (x: number) => number; lo: number; hi: number; name: string };
  const G1: Record<string, D1> = {
    normal: { f: (x) => Math.exp(-(x * x) / 2) / Math.sqrt(2 * Math.PI), lo: -4, hi: 4, name: 'a bell' },
    uniform: { f: (x) => (x >= -1.5 && x <= 1.5 ? 1 / 3 : 0), lo: -4, hi: 4, name: 'flat between −1.5 and 1.5' },
    expo: { f: (x) => (x >= 0 ? 0.8 * Math.exp(-0.8 * x) : 0), lo: -1, hi: 7, name: 'a decay, rate 0.8' },
    two: {
      f: (x) => (0.55 * Math.exp(-((x + 1.4) ** 2) / 0.5)) / Math.sqrt(0.5 * Math.PI) + (0.45 * Math.exp(-((x - 1.5) ** 2) / 1.2)) / Math.sqrt(1.2 * Math.PI),
      lo: -4, hi: 5, name: 'two humps',
    },
    spike: { f: (x) => Math.exp(-(x * x) / (2 * 0.01)) / Math.sqrt(2 * Math.PI * 0.01), lo: -1, hi: 1, name: 'a narrow bell, σ = 0.1' },
    tri: { f: (x) => Math.max(0, (2 - Math.abs(x)) / 4), lo: -3, hi: 3, name: 'a triangle' },
  };
  type D2 = { f: (x: number, y: number) => number; name: string };
  const G2: Record<string, D2> = {
    blob: { f: (x, y) => Math.exp(-(x * x + y * y) / 1.6), name: 'one round blob' },
    two: { f: (x, y) => Math.exp(-((x + 1.1) ** 2 + (y + 0.6) ** 2) / 0.9) + 0.8 * Math.exp(-((x - 1.2) ** 2 + (y - 0.9) ** 2) / 1.4), name: 'two blobs' },
    ring: { f: (x, y) => Math.exp(-((Math.hypot(x, y) - 1.5) ** 2) / 0.25), name: 'a ring' },
  };

  const state = { dim: 1 as 1 | 2, d1: 'normal', d2: 'blob', a: -1, b: 1, cx: 0.2, cy: 0.1, r: 1.2 };

  const canvas = el('pd') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink, inv } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();
  const DEN = '#5eead4', AREA = '#f59e0b', CDF = '#7c8cff';
  const fmt = (v: number, n = 4) => (Math.abs(v) < 5e-5 ? 0 : v).toFixed(n).replace('-', '−');

  // --- one dimension --------------------------------------------------------
  const cur1 = () => G1[state.d1];
  function area1(p: number, q: number) {
    if (q <= p) return 0;
    const n = 2000, h = (q - p) / n;
    let s = 0;
    for (let i = 0; i < n; i++) s += cur1().f(p + h * (i + 0.5));
    return s * h;
  }
  const P1 = { x: 50, y: 30, w: W - 90, h: 300 };
  const P2 = { x: 50, y: 400, w: W - 90, h: 150 };

  function drawOne() {
    const d = cur1();
    const sx = (x: number) => P1.x + ((x - d.lo) / (d.hi - d.lo)) * P1.w;
    let peak = 0;
    for (let i = 0; i <= 600; i++) peak = Math.max(peak, d.f(d.lo + ((d.hi - d.lo) * i) / 600));
    const top = peak * 1.18;
    const sy = (v: number) => P1.y + P1.h - (v / top) * P1.h;

    label(`the density f(x): ${d.name}`, P1.x, P1.y - 10, 0.45, 'left', 10.5);
    ctx.strokeStyle = ink(0.14);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(P1.x, P1.y + P1.h);
    ctx.lineTo(P1.x + P1.w, P1.y + P1.h);
    ctx.stroke();
    for (let k = 0; k <= 8; k++) {
      const xv = d.lo + ((d.hi - d.lo) * k) / 8;
      label(xv.toFixed(1), sx(xv), P1.y + P1.h + 16, 0.3, 'center', 10);
    }
    if (top > 1) {
      ctx.strokeStyle = ink(0.12);
      ctx.setLineDash([4, 4]);
      ctx.beginPath();
      ctx.moveTo(P1.x, sy(1));
      ctx.lineTo(P1.x + P1.w, sy(1));
      ctx.stroke();
      ctx.setLineDash([]);
      label('height 1', P1.x - 8, sy(1) + 4, 0.3, 'right', 10);
    }

    const a = Math.min(state.a, state.b), b = Math.max(state.a, state.b);
    ctx.beginPath();
    ctx.moveTo(sx(a), P1.y + P1.h);
    for (let i = 0; i <= 300; i++) {
      const x = a + ((b - a) * i) / 300;
      ctx.lineTo(sx(x), sy(d.f(x)));
    }
    ctx.lineTo(sx(b), P1.y + P1.h);
    ctx.closePath();
    ctx.fillStyle = 'rgba(245,158,11,0.34)';
    ctx.fill();

    ctx.strokeStyle = DEN;
    ctx.lineWidth = 2.6;
    ctx.lineJoin = 'round';
    ctx.beginPath();
    for (let i = 0; i <= 600; i++) {
      const x = d.lo + ((d.hi - d.lo) * i) / 600;
      i ? ctx.lineTo(sx(x), sy(d.f(x))) : ctx.moveTo(sx(x), sy(d.f(x)));
    }
    ctx.stroke();

    for (const [x, name] of [[a, 'a'], [b, 'b']] as [number, string][]) {
      ctx.strokeStyle = AREA;
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(sx(x), P1.y + 6);
      ctx.lineTo(sx(x), P1.y + P1.h);
      ctx.stroke();
      ctx.fillStyle = AREA;
      ctx.beginPath();
      ctx.arc(sx(x), P1.y + P1.h, 5.5, 0, Math.PI * 2);
      ctx.fill();
      if (name === 'b' || sx(b) - sx(a) > 16) label(name, sx(x), P1.y, 1, 'center', 11, AREA);
    }
    const p = area1(a, b);
    if (sx(b) - sx(a) > 60) label(`area ${fmt(p, 3)}`, (sx(a) + sx(b)) / 2, P1.y + P1.h - 12, 1, 'center', 12, 'rgba(16,18,22,0.9)');

    // the running total underneath
    label('the running total F(x): the same number, read as a step', P2.x, P2.y - 10, 0.45, 'left', 10.5);
    const fy = (v: number) => P2.y + P2.h - v * P2.h;
    ctx.strokeStyle = ink(0.14);
    ctx.beginPath();
    ctx.moveTo(P2.x, P2.y + P2.h);
    ctx.lineTo(P2.x + P2.w, P2.y + P2.h);
    ctx.stroke();
    label('1', P2.x - 8, fy(1) + 4, 0.3, 'right', 10);
    label('0', P2.x - 8, fy(0) + 4, 0.3, 'right', 10);
    const n = 400, h = (d.hi - d.lo) / n;
    const F: number[] = [];
    let acc = 0;
    for (let i = 0; i <= n; i++) {
      if (i) acc += d.f(d.lo + h * (i - 0.5)) * h;
      F.push(acc);
    }
    ctx.strokeStyle = CDF;
    ctx.lineWidth = 2.4;
    ctx.beginPath();
    for (let i = 0; i <= n; i++) {
      const xp = P2.x + (i / n) * P2.w;
      i ? ctx.lineTo(xp, fy(F[i])) : ctx.moveTo(xp, fy(F[i]));
    }
    ctx.stroke();
    const Fat = (x: number) => F[Math.round(Math.max(0, Math.min(1, (x - d.lo) / (d.hi - d.lo))) * n)];
    const fa = Fat(a), fb = Fat(b);
    const xp = (x: number) => P2.x + ((x - d.lo) / (d.hi - d.lo)) * P2.w;
    ctx.strokeStyle = AREA;
    ctx.lineWidth = 2;
    ctx.setLineDash([3, 3]);
    for (const x of [a, b]) {
      ctx.beginPath();
      ctx.moveTo(xp(x), P2.y + P2.h);
      ctx.lineTo(xp(x), fy(Fat(x)));
      ctx.stroke();
    }
    ctx.setLineDash([]);
    ctx.lineWidth = 6;
    ctx.beginPath();
    ctx.moveTo(xp(b), fy(fa));
    ctx.lineTo(xp(b), fy(fb));
    ctx.stroke();
    label(`F(b) − F(a) = ${fmt(fb - fa, 3)}`, xp(b) + 10, (fy(fa) + fy(fb)) / 2 + 4, 1, 'left', 11, AREA);
    return { p, peak, total: area1(d.lo, d.hi), a, b };
  }

  // --- two dimensions -------------------------------------------------------
  const cur2 = () => G2[state.d2];
  const DOM = 3;
  const S2 = { x: (W - 480) / 2, y: 50, s: 480 };
  const px2 = (x: number) => S2.x + ((x + DOM) / (2 * DOM)) * S2.s;
  const py2 = (y: number) => S2.y + ((DOM - y) / (2 * DOM)) * S2.s;
  const ix2 = (p: number) => ((p - S2.x) / S2.s) * 2 * DOM - DOM;
  const iy2 = (p: number) => DOM - ((p - S2.y) / S2.s) * 2 * DOM;

  let norm2 = 1;
  function calibrate2() {
    const n = 260, h = (2 * DOM) / n;
    let s = 0;
    for (let i = 0; i < n; i++) for (let j = 0; j < n; j++) s += cur2().f(-DOM + h * (i + 0.5), -DOM + h * (j + 0.5));
    norm2 = 1 / (s * h * h);
  }
  const f2 = (x: number, y: number) => cur2().f(x, y) * norm2;
  function area2() {
    const n = 260, h = (2 * DOM) / n;
    let s = 0;
    for (let i = 0; i < n; i++) {
      const x = -DOM + h * (i + 0.5);
      for (let j = 0; j < n; j++) {
        const y = -DOM + h * (j + 0.5);
        if (Math.hypot(x - state.cx, y - state.cy) <= state.r) s += cur2().f(x, y);
      }
    }
    return s * h * h * norm2;
  }
  let dots: { x: number; y: number }[] = [];
  function sample() {
    dots = [];
    let peak = 0;
    for (let i = 0; i <= 120; i++)
      for (let j = 0; j <= 120; j++) peak = Math.max(peak, cur2().f(-DOM + (2 * DOM * i) / 120, -DOM + (2 * DOM * j) / 120));
    let guard = 0;
    while (dots.length < 2200 && guard++ < 400000) {
      const x = -DOM + 2 * DOM * Math.random(), y = -DOM + 2 * DOM * Math.random();
      if (Math.random() * peak < cur2().f(x, y)) dots.push({ x, y });
    }
  }

  function drawTwo() {
    label(`a density over the plane: ${cur2().name}`, S2.x, S2.y - 10, 0.45, 'left', 10.5);
    const n = 100;
    let peak = 0;
    for (let i = 0; i < n; i++)
      for (let j = 0; j < n; j++) peak = Math.max(peak, f2(-DOM + (2 * DOM * (i + 0.5)) / n, -DOM + (2 * DOM * (j + 0.5)) / n));
    for (let i = 0; i < n; i++)
      for (let j = 0; j < n; j++) {
        const x0 = -DOM + (2 * DOM * i) / n, x1 = -DOM + (2 * DOM * (i + 1)) / n;
        const y0 = -DOM + (2 * DOM * j) / n, y1 = -DOM + (2 * DOM * (j + 1)) / n;
        const t = f2((x0 + x1) / 2, (y0 + y1) / 2) / peak;
        if (t < 0.015) continue;
        ctx.fillStyle = `rgba(94,234,212,${0.06 + 0.62 * Math.pow(t, 0.8)})`;
        ctx.fillRect(px2(x0), py2(y1), px2(x1) - px2(x0) + 0.4, py2(y0) - py2(y1) + 0.4);
      }
    let inside = 0;
    for (const p of dots) {
      const hit = Math.hypot(p.x - state.cx, p.y - state.cy) <= state.r;
      if (hit) inside++;
      ctx.fillStyle = hit ? 'rgba(245,158,11,0.9)' : ink(0.28);
      ctx.beginPath();
      ctx.arc(px2(p.x), py2(p.y), 1.6, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.strokeStyle = ink(0.16);
    ctx.lineWidth = 1;
    ctx.strokeRect(S2.x, S2.y, S2.s, S2.s);
    ctx.strokeStyle = AREA;
    ctx.lineWidth = 2.4;
    ctx.beginPath();
    ctx.arc(px2(state.cx), py2(state.cy), (state.r / (2 * DOM)) * S2.s, 0, Math.PI * 2);
    ctx.stroke();
    ctx.fillStyle = 'rgba(245,158,11,0.08)';
    ctx.fill();
    ctx.fillStyle = AREA;
    ctx.beginPath();
    ctx.arc(px2(state.cx), py2(state.cy), 3.5, 0, Math.PI * 2);
    ctx.fill();
    for (const v of [-DOM, 0, DOM]) {
      label(String(v), px2(v), S2.y + S2.s + 16, 0.3, 'center', 10);
      label(String(v), S2.x - 8, py2(v) + 4, 0.3, 'right', 10);
    }
    void inv;
    return { p: area2(), peak, total: area2Total(), inside };
  }
  function area2Total() {
    const n = 200, h = (2 * DOM) / n;
    let s = 0;
    for (let i = 0; i < n; i++) for (let j = 0; j < n; j++) s += cur2().f(-DOM + h * (i + 0.5), -DOM + h * (j + 0.5));
    return s * h * h * norm2;
  }

  // --- the words --------------------------------------------------------------
  function draw() {
    ctx.clearRect(0, 0, W, H);
    if (state.dim === 1) {
      const { p, peak, total, a, b } = drawOne();
      setEq({
        rule: [['P(a \\le X \\le b)', AREA], '= \\displaystyle\\int_a^b', ['f(x)', DEN], '\\,dx = F(b) - F(a)'],
        live: [[`P(${fmt(a, 2)} \\le X \\le ${fmt(b, 2)}) = ${fmt(p)}`, AREA], `\\quad\\int f = ${fmt(total)}`, `\\quad b - a = ${fmt(b - a, 3)}`],
      });
      el('result-label').textContent = 'P(a ≤ X ≤ b)';
      setResult({
        value: fmt(p),
        colour: AREA,
        status: `from ${fmt(a, 2)} to ${fmt(b, 2)} · width ${fmt(b - a, 3)} · whole area ${fmt(total)}`,
        note: 'A single value has no width, so it has no probability at all: P(X = c) = 0. The height may be anything; only the total area is 1.',
      });
      el('r-w').previousElementSibling!.textContent = 'width b − a';
      setRows({ 'r-tot': fmt(total), 'r-peak': fmt(peak, 3), 'r-w': fmt(b - a, 3) });
    } else {
      const { p, peak, total, inside } = drawTwo();
      setEq({
        rule: [['P\\big((X,Y)\\in R\\big)', AREA], '= \\displaystyle\\iint_R', ['f(x,y)', DEN], '\\,dx\\,dy'],
        live: [[`P = ${fmt(p)}`, AREA], `\\quad\\iint f = ${fmt(total)}`, `\\quad r = ${state.r.toFixed(2)}`],
      });
      el('result-label').textContent = 'P((X, Y) in R)';
      setResult({
        value: fmt(p),
        colour: AREA,
        status: `centre (${state.cx.toFixed(2)}, ${state.cy.toFixed(2)}), r = ${state.r.toFixed(2)} · ${inside} of ${dots.length} draws inside (${fmt(dots.length ? inside / dots.length : 0, 3)})`,
        note: 'The dots are draws from f. The share caught inside the circle chases the integral, which is all Monte Carlo ever does.',
      });
      el('r-w').previousElementSibling!.textContent = 'radius r';
      setRows({ 'r-tot': fmt(total), 'r-peak': fmt(peak, 3), 'r-w': fmt(state.r, 3) });
    }
  }

  // --- controls -------------------------------------------------------------
  const setA = slider('a', (v) => { state.a = v / 100; draw(); }, (v) => fmt(v / 100, 2));
  const setB = slider('b', (v) => { state.b = v / 100; draw(); }, (v) => fmt(v / 100, 2));
  const setR = slider('rr', (v) => { state.r = v / 100; draw(); }, (v) => (v / 100).toFixed(2));
  const pushAB = () => { setA(Math.round(state.a * 100)); setB(Math.round(state.b * 100)); };

  segmented('dim', (v) => {
    state.dim = +v as 1 | 2;
    if (state.dim === 2) { calibrate2(); sample(); }
    el('d1wrap').hidden = state.dim !== 1;
    el('d2wrap').hidden = state.dim !== 2;
    draw();
  });
  segmented('dist', (v) => {
    state.d1 = v;
    const d = cur1();
    state.a = Math.max(d.lo, Math.min(d.hi, state.a));
    state.b = Math.max(d.lo, Math.min(d.hi, state.b));
    pushAB();
    draw();
  });
  segmented('dist2', (v) => { state.d2 = v; calibrate2(); sample(); draw(); });

  let raf = 0;
  el('run').addEventListener('click', () => {
    cancelAnimationFrame(raf);
    const step = () => {
      if (state.dim === 1) {
        const mid = (state.a + state.b) / 2;
        state.a += (mid - state.a) * 0.12;
        state.b += (mid - state.b) * 0.12;
        pushAB();
        if (Math.abs(state.b - state.a) < 0.004) { draw(); return; }
      } else {
        state.r *= 0.9;
        setR(Math.round(state.r * 100));
        if (state.r < 0.1) { draw(); return; }
      }
      draw();
      raf = requestAnimationFrame(() => setTimeout(step, 30));
    };
    step();
  });

  // drag: the handles in 1D, the region in 2D
  let drag: 'a' | 'b' | 'c' | null = null;
  const mouse = (e: PointerEvent) => {
    const r = canvas.getBoundingClientRect();
    return { x: ((e.clientX - r.left) / r.width) * W, y: ((e.clientY - r.top) / r.height) * H };
  };
  canvas.addEventListener('pointerdown', (e) => {
    const { x, y } = mouse(e);
    try { canvas.setPointerCapture(e.pointerId); } catch { /* synthetic pointers are fine to ignore */ }
    if (state.dim === 1) {
      if (x < P1.x - 10 || x > P1.x + P1.w + 10 || y > P1.y + P1.h + 20) return;
      const d = cur1();
      const xv = d.lo + ((x - P1.x) / P1.w) * (d.hi - d.lo);
      drag = Math.abs(xv - state.a) < Math.abs(xv - state.b) ? 'a' : 'b';
      state[drag] = xv;
    } else {
      if (x < S2.x || x > S2.x + S2.s || y < S2.y || y > S2.y + S2.s) return;
      drag = 'c';
      state.cx = ix2(x);
      state.cy = iy2(y);
    }
    pushAB();
    draw();
  });
  canvas.addEventListener('pointermove', (e) => {
    if (!drag) return;
    const { x, y } = mouse(e);
    if (drag === 'c') {
      state.cx = ix2(x);
      state.cy = iy2(y);
    } else {
      const d = cur1();
      state[drag] = Math.max(d.lo, Math.min(d.hi, d.lo + ((x - P1.x) / P1.w) * (d.hi - d.lo)));
      pushAB();
    }
    draw();
  });
  const drop = () => (drag = null);
  canvas.addEventListener('pointerup', drop);
  canvas.addEventListener('pointercancel', drop);

  calibrate2();
  sample();
  draw();
</script>

