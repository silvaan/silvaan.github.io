---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="statistics"
  title="Probability Density"
  description="Drop grains of sand where a random quantity lands. They pile up into a shape; divide each pile by its width and the shape becomes the density curve. Then the curve is a sandpile: the share of grains over a stretch is the area there, the total is always one, and a single exact point holds none."
  shortcuts={['run', 'reset', 'fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="pd"
          width="1000"
          height="620"
          role="img"
          aria-label="Grains falling and piling into columns, the columns turning into a histogram and then a smooth density curve, the grains filling the area under the curve, and a window over the curve counting the grains inside."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'grains: one outcome each', color: '#fbbf24' },
          { label: 'density curve f(x)', color: '#e8e9ec' },
          { label: 'the stretch from a to b', color: '#5eead4' },
        ]}
        hint="In chapter 3, drag the two edges of the stretch"
      />
      <Result label="Now" />
    </div>

    <div class="sim-panel">
      <Seg
        id="ch"
        label="Chapter"
        attr="c"
        options={[
          { value: '0', label: '1 · Rain' },
          { value: '1', label: '2 · Per width' },
          { value: '2', label: '3 · Area' },
          { value: '3', label: '4 · Squeeze' },
          { value: '4', label: '5 · One point' },
        ]}
      />
      <Transport>
        <button type="button" class="btn ghost" id="next">Next chapter →</button>
      </Transport>
      <Seg
        id="shape"
        label="Where the grains fall"
        attr="s"
        options={[
          { value: 'bell', label: 'Bell' },
          { value: 'two', label: 'Two humps' },
          { value: 'skew', label: 'Skewed' },
          { value: 'flat', label: 'Flat' },
        ]}
      />
      <Slider id="sq" label="Spread (chapter 4)" min={-160} max={70} value={0} display="× 1.00" hint={['squeezed', 'spread']} />
      <Readout
        title="Now"
        rows={[
          { id: 'r-n', label: 'grains' },
          { id: 'r-in', label: 'grains in the stretch' },
          { id: 'r-area', label: 'area over the stretch' },
          { id: 'r-peak', label: 'highest point of f' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      The first grains land almost anywhere. Only after hundreds does the pile take a <b>shape</b>, and that shape
      is the same every time. <Try id="rain" />
    </li>
    <li>
      Halving the bins halves how many grains each catches, so raw counts would shrink to nothing. Dividing by the
      width keeps the heights steady, and they settle onto one curve. <Try id="bins" />
    </li>
    <li>
      Drag the stretch: the share of grains inside it and the area under the curve there are <b>the same number</b>.
      That is all a density is for. <Try id="area" />
    </li>
    <li>
      Squeeze the spread: the curve climbs past 1, yet no grain is added, so the area stays exactly 1. A density
      is not a probability and can be any height. <Try id="squeeze" />
    </li>
    <li>
      Shrink the stretch around one point: the grains inside run out and the probability goes to 0, while
      probability ÷ width settles on the height f(x). <Try id="point" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk } from '../../../lib/draw';
  import { segmented, slider, result, readout, tries } from '../../../lib/panel';
  import { story, headline, say, withAlpha, isLight, ease, easeOut, beat, lerp, clamp01 } from '../../../lib/story';

  // Density as sand. Grains fall where the random quantity lands and stack
  // into columns; dividing each column by its width and narrowing the bins
  // turns the stacks into the curve; the same grains then fill the area under
  // it, so a share of grains is an area, the whole is always one, and an
  // ever-narrower stretch around one point catches nothing at all.
  const SAND = '#fbbf24', WIN = '#5eead4', CURVE_DARK = '#e8e9ec';

  const canvas = document.getElementById('pd') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas);
  const { ink, inv } = stageInk(canvas);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  // ---------- the distributions ----------
  const rng = (seed: number) => {
    let s = seed >>> 0 || 1;
    return () => (s = (s * 1664525 + 1013904223) >>> 0) / 4294967296;
  };
  const normal = (r: () => number) => Math.sqrt(-2 * Math.log(r() + 1e-12)) * Math.cos(2 * Math.PI * r());
  const npdf = (x: number, m: number, s: number) => Math.exp(-0.5 * ((x - m) / s) ** 2) / (s * Math.sqrt(2 * Math.PI));

  type Shape = { pdf: (x: number) => number; draw: (r: () => number) => number; centre: number };
  const SHAPES: Record<string, Shape> = {
    bell: { pdf: (x) => npdf(x, 0, 1), draw: (r) => normal(r), centre: 0 },
    two: {
      pdf: (x) => 0.55 * npdf(x, -1.4, 0.55) + 0.45 * npdf(x, 1.5, 0.7),
      draw: (r) => (r() < 0.55 ? -1.4 + 0.55 * normal(r) : 1.5 + 0.7 * normal(r)),
      centre: 0,
    },
    skew: {
      // gamma with shape 2 and scale 0.7, moved left
      pdf: (x) => { const u = x + 2.4; return u > 0 ? (u / 0.49) * Math.exp(-u / 0.7) : 0; },
      draw: (r) => -2.4 - 0.7 * (Math.log(r() + 1e-12) + Math.log(r() + 1e-12)),
      centre: -1,
    },
    flat: { pdf: (x) => (x >= -1.5 && x <= 1.5 ? 1 / 3 : 0), draw: (r) => -1.5 + 3 * r(), centre: 0 },
  };

  // ---------- picture geometry ----------
  const X0 = -4, X1 = 4, PX0 = 70, PX1 = 930, BASE = 530;
  const px = (x: number) => PX0 + ((x - X0) / (X1 - X0)) * (PX1 - PX0);
  const xOf = (p: number) => X0 + ((p - PX0) / (PX1 - PX0)) * (X1 - X0);
  /** Pixels per unit of density; changes when the pile is squeezed. */
  let Ys = 420;

  const BINS0 = 24, RAIN = 900, SANDN = 3000, BIG = 40000;
  const DOT = 7, PER_ROW = 5; // a column of the rain is 5 grains wide

  const S = { shape: 'bell', squeeze: 1, manualSqueeze: false, a: -1, b: 1, manualWin: false };
  let shape = SHAPES.bell;
  let rain: number[] = [], rainSlot: number[] = [];
  let sand: { x: number; u: number }[] = [];
  let big: number[] = [];

  function build() {
    shape = SHAPES[S.shape];
    const r = rng(11);
    rain = [];
    for (let i = 0; i < RAIN; i++) {
      let x = shape.draw(r);
      while (x < X0 || x >= X1) x = shape.draw(r);
      rain.push(x);
    }
    // where each grain ends up in its column: the order it arrived in
    const fill = new Array(BINS0).fill(0);
    rainSlot = rain.map((x) => fill[binOf(x, BINS0)]++);
    const r2 = rng(5);
    sand = [];
    for (let i = 0; i < SANDN; i++) sand.push({ x: shape.draw(r2), u: r2() });
    big = [];
    for (let i = 0; i < BIG; i++) big.push(shape.draw(r2));
    hist.clear();
  }

  const binOf = (x: number, n: number) => Math.min(n - 1, Math.max(0, Math.floor(((x - X0) / (X1 - X0)) * n)));

  /** Density histograms: share of grains in each bin ÷ bin width. */
  const hist = new Map<string, Float64Array>();
  function histogram(xs: number[], n: number, key: string) {
    let h = hist.get(key + n);
    if (h) return h;
    h = new Float64Array(n);
    for (const x of xs) if (x >= X0 && x < X1) h[binOf(x, n)]++;
    const w = (X1 - X0) / n;
    for (let k = 0; k < n; k++) h[k] /= xs.length * w;
    hist.set(key + n, h);
    return h;
  }

  /** The curve after squeezing by k around the shape's centre. */
  const f = (x: number, k = S.squeeze) => shape.pdf(shape.centre + (x - shape.centre) / k) / k;
  const sq = (x: number, k = S.squeeze) => shape.centre + (x - shape.centre) * k;
  function areaOf(a: number, b: number, k = S.squeeze) {
    const n = 400, h = (b - a) / n;
    let s = 0;
    for (let i = 0; i <= n; i++) s += (i === 0 || i === n ? 0.5 : 1) * f(a + i * h, k);
    return s * h;
  }
  function peak(k = S.squeeze) {
    let m = 0, at = 0;
    for (let p = PX0; p <= PX1; p++) {
      const v = f(xOf(p), k);
      if (v > m) { m = v; at = xOf(p); }
    }
    return { m, at };
  }

  // ---------- chapters ----------
  const chapters = [
    {
      dur: 10.5,
      title: 'A rain of outcomes',
      body: 'Each grain is one outcome of the same random experiment, dropped where it landed. One grain tells you nothing. Hundreds pile up into a shape.',
    },
    {
      dur: 13,
      title: 'Count per width, not per bin',
      body: 'Make each column height the share of grains it caught divided by its width. Then narrower and narrower bins do not shrink: they settle onto one smooth curve, the density f(x).',
    },
    {
      dur: Infinity,
      title: 'Probability is area',
      body: 'Fill the area under the curve with the grains. The chance of landing between a and b is the share of grains over that stretch, which is the area there.',
    },
    {
      dur: Infinity,
      title: 'Squeeze the pile',
      body: 'Squeeze the spread and the same grains stack higher. The curve can climb above 1, because height is grains per unit of width. The area stays 1: no grain is lost.',
    },
    {
      dur: Infinity,
      title: 'A single point holds nothing',
      body: 'Narrow the stretch around one point. It catches fewer and fewer grains, so P(X = x) is 0. What stays is probability ÷ width: the height f(x).',
    },
  ];

  const st = story({
    chapters,
    enter(i) {
      if (i === 2) { S.manualWin = false; }
      if (i === 3 && !S.manualSqueeze) S.squeeze = 1;
      if (i !== 3) { S.squeeze = 1; S.manualSqueeze = false; setSq(0); }
    },
    frame,
  });

  /** When grain i starts falling: slowly at first, then a downpour. */
  const release = (i: number) => 0.3 + 7.8 * Math.sqrt(i / RAIN);
  const FALL = 0.55;

  function frame(ch: number, t: number, dt: number) {
    const light = isLight(canvas);
    ctx.clearRect(0, 0, W, H);
    void dt;

    // vertical scale: room for a tall pile while squeezing
    const targetYs = ch === 3 ? 150 : 420;
    Ys = lerp(Ys, targetYs, 0.08);

    if (ch === 3 && !S.manualSqueeze) {
      S.squeeze = lerp(1, 0.2, beat(t, 1.2, 4.5));
      setSq(Math.round(100 * Math.log2(S.squeeze)));
    }

    axis(ch, t, light);
    if (ch === 0) rainScene(t, light);
    if (ch === 1) binsScene(t, light);
    if (ch >= 2) sandScene(ch, t, light);

    headline(ctx, ink, { index: ch, count: chapters.length, title: chapters[ch].title, body: chapters[ch].body, t, width: 520, accent: SAND });
    panel(ch, t);
    eqTick(ch);
  }

  function axis(ch: number, t: number, light: boolean) {
    ctx.save();
    ctx.strokeStyle = ink(0.25);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(PX0 - 10, BASE + 0.5);
    ctx.lineTo(PX1 + 10, BASE + 0.5);
    ctx.stroke();
    ctx.fillStyle = ink(0.4);
    ctx.font = '12px ui-monospace, monospace';
    ctx.textAlign = 'center';
    for (let x = X0; x <= X1; x++) {
      ctx.fillRect(px(x) - 0.5, BASE, 1, 5);
      ctx.fillText(String(x).replace('-', '−'), px(x), BASE + 18);
    }
    // the density scale, once heights mean something
    const ya = ch === 0 ? 0 : ch === 1 ? beat(t, 1.6, 2.6) : 1;
    if (ya > 0) {
      ctx.globalAlpha = ya;
      ctx.textAlign = 'right';
      const step = Ys > 300 ? 0.1 : Ys > 120 ? 0.25 : 0.5;
      for (let v = step; v * Ys < BASE - 190; v += step) {
        const y = BASE - v * Ys;
        ctx.fillStyle = ink(0.06);
        ctx.fillRect(PX0, y, PX1 - PX0, 1);
        ctx.fillStyle = ink(0.4);
        ctx.fillText(v.toFixed(2), PX0 - 8, y + 4);
      }
      if (ch === 3) {
        const y = BASE - Ys;
        ctx.setLineDash([6, 6]);
        ctx.strokeStyle = ink(0.5);
        ctx.beginPath();
        ctx.moveTo(PX0, y);
        ctx.lineTo(PX1, y);
        ctx.stroke();
        ctx.setLineDash([]);
        say(ctx, 'height 1', PX1, y - 12, { colour: ink(0.6), size: 13, align: 'right' });
      }
    }
    ctx.restore();
    void light;
  }

  // chapter 1: grains fall and stack, five to a row in each column
  const colW = (PX1 - PX0) / BINS0;
  function slotXY(i: number) {
    const b = binOf(rain[i], BINS0), s = rainSlot[i];
    const row = Math.floor(s / PER_ROW), col = s % PER_ROW;
    return { x: PX0 + b * colW + (colW - PER_ROW * DOT) / 2 + (col + 0.5) * DOT, y: BASE - (row + 0.5) * DOT - 1 };
  }

  function rainScene(t: number, light: boolean) {
    // the faint columns
    ctx.fillStyle = ink(0.025);
    for (let b = 0; b < BINS0; b += 2) ctx.fillRect(PX0 + b * colW, 200, colW, BASE - 200);
    let landed = 0;
    for (let i = 0; i < RAIN; i++) {
      const tt = t - release(i);
      if (tt < 0) break;
      const end = slotXY(i);
      const x = px(rain[i]);
      const u = clamp01(tt / FALL);
      if (u < 1) {
        const y = lerp(190, end.y, u * u);
        const gx = lerp(x, end.x, u * u);
        ctx.strokeStyle = withAlpha(SAND, 0.35);
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(gx, y - 18 * u);
        ctx.lineTo(gx, y);
        ctx.stroke();
        ctx.fillStyle = SAND;
        ctx.beginPath();
        ctx.arc(gx, y, 3, 0, Math.PI * 2);
        ctx.fill();
      } else {
        landed++;
        const flash = 1 - clamp01((tt - FALL) / 0.4);
        ctx.fillStyle = flash > 0 && !light ? withAlpha('#fff7d6', 0.6 + 0.4 * flash) : SAND;
        ctx.beginPath();
        ctx.arc(end.x, end.y, DOT / 2 - 0.6, 0, Math.PI * 2);
        ctx.fill();
      }
    }
    // a counter that ticks with the rain
    say(ctx, `${landed} grains`, PX1, 200, { colour: SAND, size: 22, weight: 650, align: 'right' });
    if (landed < 12 && t > 0.9)
      say(ctx, 'so far: no pattern', PX1, 226, { colour: ink(0.55), size: 14, align: 'right' });
    else if (landed > 500)
      say(ctx, 'a shape appears', PX1, 226, { colour: ink(0.7), size: 14, align: 'right', alpha: beat(landed, 500, 650) });
  }

  // chapter 2: the stacks become bars, then the bins halve until the bars are the curve
  function binsScene(t: number, light: boolean) {
    const melt = beat(t, 0, 1.2);
    // the grains, melting into bars
    if (melt < 1) {
      ctx.globalAlpha = 1 - melt;
      ctx.fillStyle = SAND;
      for (let i = 0; i < RAIN; i++) {
        const p = slotXY(i);
        ctx.beginPath();
        ctx.arc(p.x, p.y, DOT / 2 - 0.6, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    }
    // the level of refinement: 24, 48, 96, 192 bins
    const times = [4.2, 6.2, 8.2];
    let L = 0;
    while (L < times.length && t >= times[L]) L++;
    const n = BINS0 << L;
    const from = L === 0 ? null : histogram(big, n >> 1, 'big');
    const pour = beat(t, 2.8, 3.8); // the rain sample gives way to a big one
    const hRain = histogram(rain, BINS0, 'rain'), hBig = histogram(big, n, 'big');
    const split = L === 0 ? 1 : beat(t, times[L - 1], times[L - 1] + 1.1);
    const curveA = beat(t, 9.6, 11.2);
    const w = (PX1 - PX0) / n;
    ctx.fillStyle = withAlpha(SAND, (1 - 0.65 * curveA) * (0.35 + 0.65 * melt));
    for (let k = 0; k < n; k++) {
      const target = L === 0 ? lerp(hRain[k], hBig[k], pour) : hBig[k];
      const start = from ? from[k >> 1] : target;
      const h = lerp(start, target, split) * Ys * (L === 0 ? 1 : 1);
      const gap = n > 100 ? 0 : 1.5;
      ctx.fillRect(PX0 + k * w + gap / 2, BASE - h, w - gap, h);
    }
    if (melt < 1) return;
    // how one bar's height is made, on the tallest one
    const a = beat(t, 1.6, 2.4) * (1 - beat(t, 3.8, 4.2));
    if (a > 0) {
      let kk = 0;
      for (let k = 0; k < BINS0; k++) if (hRain[k] > hRain[kk]) kk = k;
      const share = hRain[kk] * ((X1 - X0) / BINS0);
      const x = PX0 + (kk + 0.5) * colW, y = BASE - hRain[kk] * Ys;
      say(ctx, `${Math.round(share * RAIN)} of ${RAIN} grains = ${(share * 100).toFixed(1)}%`, x + colW, y - 30, { colour: SAND, size: 14, weight: 600, alpha: a, halo: inv(0.85) });
      say(ctx, `÷ width ${((X1 - X0) / BINS0).toFixed(2)} = height ${hRain[kk].toFixed(2)}`, x + colW, y - 10, { colour: ink(0.8), size: 14, alpha: a, halo: inv(0.85) });
    }
    if (t > 4) {
      const b = beat(t, 4, 4.6) * (1 - curveA);
      say(ctx, `${n} bins, each ${((X1 - X0) / n).toFixed(3)} wide`, PX1, 200, { colour: SAND, size: 20, weight: 650, align: 'right', alpha: b });
      say(ctx, `${BIG.toLocaleString('en')} grains`, PX1, 224, { colour: ink(0.55), size: 14, align: 'right', alpha: b });
    }
    if (curveA > 0) drawCurve(curveA, light, beat(t, 9.6, 11.6));
  }

  /** The density, drawn left to right up to `reveal`. */
  function drawCurve(a: number, light: boolean, reveal = 1) {
    const col = light ? '#1c1e24' : CURVE_DARK;
    ctx.save();
    ctx.globalAlpha = a;
    ctx.strokeStyle = col;
    ctx.lineWidth = 2.5;
    ctx.lineJoin = 'round';
    if (!light) { ctx.shadowColor = 'rgba(255,255,255,0.35)'; ctx.shadowBlur = 8; }
    ctx.beginPath();
    const end = PX0 + (PX1 - PX0) * reveal;
    for (let p = PX0; p <= end; p += 1) {
      const y = BASE - f(xOf(p)) * Ys;
      p === PX0 ? ctx.moveTo(p, y) : ctx.lineTo(p, y);
    }
    ctx.stroke();
    ctx.restore();
  }

  // chapters 3 to 5: the grains fill the area under the curve
  let winState = { a: -1, b: 1 };
  function sandScene(ch: number, t: number, light: boolean) {
    const k = S.squeeze;
    // the stretch for this chapter
    let a: number, b: number;
    if (ch === 2) {
      if (!S.manualWin) {
        // slide a one-wide window across, then open it to a ± 1 around the centre
        const c = shape.centre;
        const slide = beat(t, 1.5, 6.5), open = beat(t, 7, 8.5);
        const m = lerp(-3.2, 2.4, slide);
        a = lerp(m - 0.5, c - 1, open);
        b = lerp(m + 0.5, c + 1, open);
        S.a = a; S.b = b;
      }
      a = S.a; b = S.b;
    } else if (ch === 3) {
      a = -Infinity; b = Infinity;
    } else {
      const x0 = peak(1).at;
      const w = t < 0.8 ? 2 : Math.max(0.0005, 2 * 10 ** (-(t - 0.8) / 2.4));
      a = x0 - w / 2; b = x0 + w / 2;
    }
    winState = { a, b };

    const pour = ch === 2 ? easeOut(t / 1.4) : 1;
    // shading over the stretch
    if (isFinite(a)) {
      const pa = Math.max(PX0, px(a)), pb = Math.min(PX1, px(b));
      ctx.save();
      ctx.fillStyle = withAlpha(WIN, light ? 0.18 : 0.14);
      ctx.beginPath();
      ctx.moveTo(pa, BASE);
      for (let p = pa; p <= pb; p += 0.5) ctx.lineTo(p, BASE - f(xOf(p)) * Ys);
      ctx.lineTo(pb, BASE - f(xOf(pb)) * Ys);
      ctx.lineTo(pb, BASE);
      ctx.closePath();
      ctx.fill();
      ctx.restore();
    }

    // the grains: x from the shape, height uniform under the curve there
    let inside = 0;
    ctx.save();
    for (const g of sand) {
      const x = sq(g.x, k);
      if (x < X0 || x > X1) continue;
      const on = isFinite(a) && x >= a && x <= b;
      if (on) inside++;
      const y = BASE - lerp(0, g.u * f(x), pour) * Ys;
      ctx.fillStyle = on ? (light ? '#0d9488' : WIN) : withAlpha(SAND, isFinite(a) ? (light ? 0.75 : 0.55) : 0.85);
      ctx.fillRect(px(x) - 1.1, y - 1.1, 2.2, 2.2);
    }
    ctx.restore();
    drawCurve(1, light);

    const area = isFinite(a) ? areaOf(a, b) : areaOf(X0, X1);
    sandStats = { inside, area };

    if (ch === 2) windowLabels(a, b, inside, area, light);
    if (ch === 3) squeezeLabels(light);
    if (ch === 4) pointLabels(a, b, inside, area, light);
  }
  let sandStats = { inside: 0, area: 0 };

  function handle(x: number, light: boolean) {
    const p = px(x);
    ctx.strokeStyle = light ? '#0d9488' : WIN;
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(p, BASE + 6);
    ctx.lineTo(p, Math.min(BASE - f(x) * Ys, BASE - 20) - 14);
    ctx.stroke();
    ctx.fillStyle = light ? '#0d9488' : WIN;
    ctx.beginPath();
    ctx.arc(p, BASE + 10, 5, 0, Math.PI * 2);
    ctx.fill();
  }

  function windowLabels(a: number, b: number, inside: number, area: number, light: boolean) {
    handle(a, light);
    handle(b, light);
    say(ctx, 'a', px(a), BASE + 26, { colour: WIN, size: 14, weight: 600, align: 'center' });
    say(ctx, 'b', px(b), BASE + 26, { colour: WIN, size: 14, weight: 600, align: 'center' });
    const mid = Math.min(PX1 - 140, Math.max(PX0 + 140, (px(a) + px(b)) / 2));
    let top = BASE;
    for (let p = px(a); p <= px(b); p += 2) top = Math.min(top, BASE - f(xOf(p)) * Ys);
    const y = Math.max(200, top - 46);
    say(ctx, `${inside} of ${SANDN} grains = ${((100 * inside) / SANDN).toFixed(1)}%`, mid, y, { colour: light ? '#0d9488' : WIN, size: 17, weight: 650, align: 'center', halo: inv(0.85) });
    say(ctx, `area under the curve = ${area.toFixed(3)}`, mid, y + 22, { colour: ink(0.85), size: 15, align: 'center', halo: inv(0.85) });
  }

  function squeezeLabels(light: boolean) {
    const pk = peak();
    const x = px(pk.at), y = BASE - pk.m * Ys;
    const col = light ? '#b45309' : SAND;
    say(ctx, `peak ${pk.m.toFixed(2)}${pk.m > 1 ? '  (more than 1)' : ''}`, x + 18, y - 4, { colour: col, size: 16, weight: 650, halo: inv(0.85) });
    say(ctx, `area still ${areaOf(X0, X1).toFixed(2)}: all ${SANDN} grains`, x + 18, y + 18, { colour: ink(0.8), size: 14, halo: inv(0.85) });
  }

  /** Chapter 5: a lens on the shrinking stretch, where the curve is flat and the slab a rectangle. */
  function pointLabels(a: number, b: number, inside: number, area: number, light: boolean) {
    const w = b - a, x0 = (a + b) / 2, h = f(x0);
    const col = light ? '#0d9488' : WIN;
    handle(a, light);
    handle(b, light);
    // the lens
    const L = { x: 640, y: 196, w: 300, h: 210 };
    ctx.save();
    ctx.fillStyle = light ? 'rgba(255,255,255,0.95)' : 'rgba(13,14,18,0.92)';
    ctx.strokeStyle = ink(0.15);
    ctx.beginPath();
    ctx.roundRect(L.x, L.y, L.w, L.h, 12);
    ctx.fill();
    ctx.stroke();
    // a line from the stretch to the lens
    ctx.strokeStyle = withAlpha(WIN, 0.3);
    ctx.setLineDash([3, 4]);
    ctx.beginPath();
    ctx.moveTo(px(x0), BASE - h * Ys - 16);
    ctx.lineTo(L.x, L.y + L.h / 2);
    ctx.stroke();
    ctx.setLineDash([]);
    // inside: the stretch magnified to a fixed 150 px, so the slab is a rectangle of height f(x₀)
    const span = w * 2; // the lens shows twice the stretch
    const lx = (x: number) => L.x + 20 + ((x - (x0 - span / 2)) / span) * (L.w - 40);
    const lb = L.y + L.h - 30, ls = (L.h - 70) / (h * 1.25);
    ctx.beginPath();
    ctx.rect(L.x + 1, L.y + 1, L.w - 2, L.h - 2);
    ctx.clip();
    ctx.fillStyle = withAlpha(WIN, 0.25);
    ctx.beginPath();
    ctx.moveTo(lx(a), lb);
    for (let p = 0; p <= 60; p++) { const x = a + (p / 60) * w; ctx.lineTo(lx(x), lb - f(x) * ls); }
    ctx.lineTo(lx(b), lb);
    ctx.closePath();
    ctx.fill();
    ctx.strokeStyle = light ? '#1c1e24' : CURVE_DARK;
    ctx.lineWidth = 2;
    ctx.beginPath();
    for (let p = 0; p <= 80; p++) {
      const x = x0 - span / 2 + (p / 80) * span;
      p ? ctx.lineTo(lx(x), lb - f(x) * ls) : ctx.moveTo(lx(x), lb - f(x) * ls);
    }
    ctx.stroke();
    ctx.strokeStyle = ink(0.3);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(L.x + 10, lb + 0.5);
    ctx.lineTo(L.x + L.w - 10, lb + 0.5);
    ctx.stroke();
    ctx.restore();
    say(ctx, 'zoomed in on the stretch', L.x + 14, L.y + 16, { colour: ink(0.5), size: 12 });
    say(ctx, `height f(x) = ${h.toFixed(3)}`, L.x + 14, L.y + 38, { colour: ink(0.85), size: 13 });
    say(ctx, `width ${w < 0.01 ? w.toExponential(1) : w.toFixed(3)}`, (lx(a) + lx(b)) / 2, lb + 16, { colour: col, size: 13, weight: 600, align: 'center' });

    const y = 470;
    say(ctx, `grains inside: ${inside}`, 640, 432, { colour: col, size: 16, weight: 650 });
    say(ctx, `probability = area = ${area < 0.001 ? area.toExponential(1) : area.toFixed(3)}  →  0`, 640, y - 14, { colour: ink(0.85), size: 14 });
    say(ctx, `probability ÷ width = ${(area / w).toFixed(3)}  →  f(x)`, 640, y + 8, { colour: ink(0.85), size: 14 });
  }

  // ---------- panel ----------
  let tick = 0;
  function panel(ch: number, t: number) {
    if (tick++ % 8) return;
    const pk = peak();
    if (ch === 0) {
      let landed = 0;
      for (let i = 0; i < RAIN; i++) if (t - release(i) >= FALL) landed++;
      setRows({ 'r-n': `${landed}`, 'r-in': '—', 'r-area': '—', 'r-peak': '—' });
      setResult({ value: `${landed} grains`, status: landed < 50 ? 'no shape yet' : landed < 500 ? 'a shape forming' : 'a clear shape', note: 'Every grain is one outcome. Their pile is the shape of the randomness.' });
      return;
    }
    if (ch === 1) {
      setRows({ 'r-n': t < 3 ? `${RAIN}` : BIG.toLocaleString('en'), 'r-in': '—', 'r-area': '—', 'r-peak': pk.m.toFixed(3) });
      setResult({ value: 'share ÷ width', status: 'the height of a bar', note: 'Grains per unit of x. Narrower bins catch fewer grains but are narrower too, so the height stays put.' });
      return;
    }
    const { inside, area } = sandStats;
    setRows({
      'r-n': `${SANDN}`,
      'r-in': ch === 3 ? '—' : `${inside} (${((100 * inside) / SANDN).toFixed(1)}%)`,
      'r-area': ch === 3 ? `${area.toFixed(3)} (all of it)` : area.toFixed(4),
      'r-peak': pk.m.toFixed(3),
    });
    if (ch === 2)
      setResult({ value: `P(a ≤ X ≤ b) = ${area.toFixed(3)}`, status: `${((100 * inside) / SANDN).toFixed(1)}% of grains`, note: 'The share of grains over the stretch and the area under the curve there agree.', colour: WIN });
    else if (ch === 3)
      setResult({ value: `peak ${pk.m.toFixed(2)}`, status: pk.m > 1 ? 'taller than 1, and fine' : 'area 1', note: 'Total area under a density is always 1. Its height is grains per unit width, and that has no ceiling.', colour: SAND });
    else {
      const w = winState.b - winState.a;
      setResult({ value: `P = ${area < 0.001 ? area.toExponential(1) : area.toFixed(3)}`, status: `width ${w < 0.01 ? w.toExponential(1) : w.toFixed(3)}`, note: 'As the stretch closes on one point its probability goes to 0; probability ÷ width goes to f(x).', colour: WIN });
    }
  }

  type Part = string | [string, string];
  const EQ: Part[][] = [
    [['X', SAND], '\\;\\text{lands somewhere new each time}'],
    [['f(x)', CURVE_DARK], '\\approx \\dfrac{\\text{share of grains in the bin}}{\\text{bin width}}'],
    ['P(a \\le X \\le b) =', '\\displaystyle\\int_a^b', ['f(x)', CURVE_DARK], '\\,dx'],
    ['\\displaystyle\\int_{-\\infty}^{\\infty}', ['f(x)', CURVE_DARK], '\\,dx = 1', '\\qquad', ['f(x)', CURVE_DARK], '\\text{ may be } > 1'],
    ['P(X = x) = \\lim_{w\\to 0}\\,', ['f(x)', CURVE_DARK], '\\cdot', ['w', WIN], '= 0'],
  ];
  let eqFor = -1;
  function eqTick(ch: number) {
    if (ch === eqFor) return;
    eqFor = ch;
    setEq({ rule: EQ[ch] });
  }

  // ---------- input: drag the edges of the stretch ----------
  const toX = (e: PointerEvent) => {
    const r = canvas.getBoundingClientRect();
    return ((e.clientX - r.left) / r.width) * W;
  };
  let dragging: 'a' | 'b' | null = null;
  canvas.addEventListener('pointerdown', (e) => {
    if (st.chapter() !== 2) return;
    const p = toX(e);
    const da = Math.abs(p - px(S.a)), db = Math.abs(p - px(S.b));
    dragging = da < db ? 'a' : 'b';
    S.manualWin = true;
    canvas.setPointerCapture(e.pointerId);
    move(p);
  });
  canvas.addEventListener('pointermove', (e) => { if (dragging) move(toX(e)); });
  canvas.addEventListener('pointerup', () => (dragging = null));
  function move(p: number) {
    const x = Math.max(X0, Math.min(X1, xOf(p)));
    if (dragging === 'a') S.a = Math.min(x, S.b - 0.02);
    else S.b = Math.max(x, S.a + 0.02);
  }

  segmented('shape', (v) => { S.shape = v; build(); });
  const setSq = slider('sq', (v) => {
    S.squeeze = 2 ** (v / 100);
    S.manualSqueeze = true;
    if (st.chapter() !== 3) st.go(3);
  }, (v) => `× ${(2 ** (v / 100)).toFixed(2)}`);

  tries({
    rain: () => { st.go(0); st.play(true); },
    bins: () => { st.go(1); st.play(true); },
    area: () => { st.go(2); st.play(true); },
    squeeze: () => { S.manualSqueeze = false; st.go(3); st.play(true); },
    point: () => { st.go(4); st.play(true); },
  });

  build();
  st.start();
</script>
