---
import SimLayout from '../../../layouts/SimLayout.astro';
import Actions from '../../../components/sim/Actions.astro';
import Checks from '../../../components/sim/Checks.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
---

<SimLayout
  areaSlug="statistics"
  title="Least Squares"
  description="The best-fit line minimises the total squared error. Each error is drawn as a literal square, so the line is the one that shrinks their total area."
  shortcuts={['reset', 'fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="ls"
          width="1000"
          height="600"
          role="img"
          aria-label="Data points with the least-squares line through them and each residual drawn as a square."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'data point', color: '#7c8cff' },
          { label: 'fit line', color: '#fbbf24' },
          { label: 'residual, squared', color: 'rgba(251,191,36,0.45)' },
          { label: 'mean point (x̄, ȳ)', color: '#5eead4' },
        ]}
        hint="Drag a point to move it · click empty space to add one"
      />
      <Result label="Fit" />
    </div>

    <div class="sim-panel">
      <Actions>
        <button type="button" class="btn ghost" id="reset">Reset points</button>
        <button type="button" class="btn ghost" id="clear">Clear</button>
      </Actions>
      <Checks items={[{ id: 'squares', label: 'Show the residual squares', checked: true }]} />
      <Readout
        rows={[
          { id: 'r-sse', label: 'sum of squares' },
          { id: 'r-r2', label: 'R²' },
          { id: 'r-n', label: 'points' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      The fit line is exactly the one that makes the <b>total area</b> of the
      shaded squares as small as possible. Drag a point and watch the squares
      fight back.
    </li>
    <li>
      Drag one point far off the trend. Because errors are <b>squared</b>, that
      single <b>outlier</b> drags the whole line toward it: least squares is not
      robust.
    </li>
    <li>
      The line always pivots through the <b>mean point</b> (x̄, ȳ). Add points
      symmetrically and the slope changes while that balance point stays put.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk, fixed } from '../../../lib/draw';
  import { el, check, result, readout } from '../../../lib/panel';

  type P = { x: number; y: number };
  const DEFAULT: P[] = [
    { x: 1, y: 2.2 }, { x: 2, y: 2.8 }, { x: 3, y: 3.2 }, { x: 4, y: 4.6 },
    { x: 5, y: 4.9 }, { x: 6, y: 6.3 }, { x: 7, y: 6.1 }, { x: 8, y: 7.8 },
  ];
  let pts: P[] = DEFAULT.map((p) => ({ ...p }));
  const state = { squares: true };
  const POINT = '#7c8cff', FIT = '#fbbf24', MEAN = '#5eead4';

  const canvas = el('ls') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink, inv } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  const PAD = { l: 48, r: 24, t: 24, b: 40 };
  const XR = [0, 10] as const, YR = [0, 10] as const;
  const sx = (x: number) => PAD.l + ((x - XR[0]) / (XR[1] - XR[0])) * (W - PAD.l - PAD.r);
  const sy = (y: number) => H - PAD.b - ((y - YR[0]) / (YR[1] - YR[0])) * (H - PAD.t - PAD.b);
  const dataX = (px: number) => XR[0] + ((px - PAD.l) / (W - PAD.l - PAD.r)) * (XR[1] - XR[0]);
  const dataY = (py: number) => YR[0] + ((H - PAD.b - py) / (H - PAD.t - PAD.b)) * (YR[1] - YR[0]);

  function fit() {
    const n = pts.length;
    if (n < 2) return null;
    let sxx = 0, syy = 0, sxy = 0, mx = 0, my = 0;
    for (const p of pts) { mx += p.x; my += p.y; }
    mx /= n; my /= n;
    for (const p of pts) {
      sxx += (p.x - mx) ** 2;
      syy += (p.y - my) ** 2;
      sxy += (p.x - mx) * (p.y - my);
    }
    if (sxx < 1e-9) return null;
    const slope = sxy / sxx, intercept = my - slope * mx;
    let sse = 0;
    for (const p of pts) sse += (p.y - (slope * p.x + intercept)) ** 2;
    return { slope, intercept, sse, r2: syy < 1e-9 ? 1 : 1 - sse / syy, mx, my };
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    ctx.strokeStyle = ink(0.07);
    ctx.lineWidth = 1;
    for (let i = 0; i <= 10; i++) {
      ctx.beginPath();
      ctx.moveTo(sx(i), PAD.t);
      ctx.lineTo(sx(i), H - PAD.b);
      ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(PAD.l, sy(i));
      ctx.lineTo(W - PAD.r, sy(i));
      ctx.stroke();
      label(String(i), sx(i), H - PAD.b + 18, 0.3, 'center', 11.5);
      if (i) label(String(i), PAD.l - 10, sy(i) + 4, 0.3, 'right', 11.5);
    }

    const f = fit();
    if (f) {
      if (state.squares) {
        for (const p of pts) {
          const yhat = f.slope * p.x + f.intercept;
          const side = Math.abs(sy(p.y) - sy(yhat));
          const dir = p.y >= yhat ? 1 : -1;
          ctx.fillStyle = 'rgba(251,191,36,0.16)';
          ctx.strokeStyle = 'rgba(251,191,36,0.4)';
          ctx.lineWidth = 1;
          ctx.fillRect(sx(p.x), Math.min(sy(p.y), sy(yhat)), dir * side, side);
          ctx.strokeRect(sx(p.x), Math.min(sy(p.y), sy(yhat)), dir * side, side);
        }
      }
      ctx.strokeStyle = FIT;
      ctx.lineWidth = 2.6;
      ctx.beginPath();
      ctx.moveTo(sx(XR[0]), sy(f.slope * XR[0] + f.intercept));
      ctx.lineTo(sx(XR[1]), sy(f.slope * XR[1] + f.intercept));
      ctx.stroke();
      ctx.fillStyle = MEAN;
      ctx.beginPath();
      ctx.arc(sx(f.mx), sy(f.my), 4.5, 0, Math.PI * 2);
      ctx.fill();
    }
    for (const p of pts) {
      ctx.fillStyle = POINT;
      ctx.strokeStyle = inv(0.9);
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(sx(p.x), sy(p.y), 6.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
    }

    if (f) {
      const sign = f.intercept >= 0 ? '+' : '−';
      const line = `y = ${fixed(f.slope, 2)}x ${sign} ${Math.abs(f.intercept).toFixed(2)}`;
      setEq({
        rule: [['\\hat y = mx + b', FIT], '\\quad\\text{minimising}\\quad', ['\\sum_i (y_i - \\hat y_i)^2', FIT]],
        live: [
          [`\\hat y = ${fixed(f.slope, 2)}x ${f.intercept >= 0 ? '+' : '-'} ${Math.abs(f.intercept).toFixed(2)}`, FIT],
          `\\quad\\sum r_i^2 = ${f.sse.toFixed(3)}`,
          `\\quad R^2 = ${f.r2.toFixed(3)}`,
        ],
      });
      setResult({
        value: line,
        colour: FIT,
        status: `Sum of squares ${f.sse.toFixed(3)} · R² = ${f.r2.toFixed(3)} · ${pts.length} points`,
        note: 'Every amber square is one residual squared; the line that minimises their total area is the fit, and it always passes through the mean point.',
      });
      setRows({ 'r-sse': f.sse.toFixed(3), 'r-r2': f.r2.toFixed(3), 'r-n': String(pts.length) });
    } else {
      setEq({ rule: [['\\hat y = mx + b', FIT], '\\quad\\text{minimising}\\quad', ['\\sum_i (y_i - \\hat y_i)^2', FIT]] });
      setResult({ value: '—', status: 'Two points at least are needed for a line', note: 'Click the canvas to add points.' });
      setRows({ 'r-sse': '—', 'r-r2': '—', 'r-n': String(pts.length) });
    }
  }

  // drag the nearest point, or add a new one on empty space
  let drag = -1;
  const mouse = (e: PointerEvent) => {
    const rect = canvas.getBoundingClientRect();
    return { mx: ((e.clientX - rect.left) / rect.width) * W, my: ((e.clientY - rect.top) / rect.height) * H };
  };
  const clampPoint = (mx: number, my: number): P => ({
    x: Math.max(XR[0], Math.min(XR[1], dataX(mx))),
    y: Math.max(YR[0], Math.min(YR[1], dataY(my))),
  });
  canvas.addEventListener('pointerdown', (e) => {
    const { mx, my } = mouse(e);
    canvas.setPointerCapture(e.pointerId);
    let best = -1, bestD = 16 * 16;
    pts.forEach((p, i) => {
      const d = (sx(p.x) - mx) ** 2 + (sy(p.y) - my) ** 2;
      if (d < bestD) { bestD = d; best = i; }
    });
    if (best >= 0) drag = best;
    else {
      pts.push(clampPoint(mx, my));
      drag = pts.length - 1;
      draw();
    }
  });
  canvas.addEventListener('pointermove', (e) => {
    if (drag < 0) return;
    const { mx, my } = mouse(e);
    pts[drag] = clampPoint(mx, my);
    draw();
  });
  const stop = () => (drag = -1);
  canvas.addEventListener('pointerup', stop);
  canvas.addEventListener('pointercancel', stop);

  el('reset').addEventListener('click', () => { pts = DEFAULT.map((p) => ({ ...p })); draw(); });
  el('clear').addEventListener('click', () => { pts = []; draw(); });
  check('squares', (on) => { state.squares = on; draw(); });

  draw();
</script>

<style>
  #ls {
    cursor: crosshair;
    touch-action: none;
  }
</style>
