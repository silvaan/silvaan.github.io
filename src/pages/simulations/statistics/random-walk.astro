---
import SimLayout from '../../../layouts/SimLayout.astro';
import Slider from '../../../components/sim/Slider.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
---

<SimLayout
  areaSlug="statistics"
  title="Random Walk"
  description="Thousands of particles with no goal, just a coin flip each step. The crowd spreads into a bell whose width grows like the square root of time."
  shortcuts={['run', 'reset', 'fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="walk"
          width="1000"
          height="600"
          role="img"
          aria-label="Traced random walks fanning out from a shared start inside a square-root envelope, with the histogram of current positions and its predicted bell below."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'positions now', color: '#5eead4' },
          { label: 'predicted bell, width √t', color: '#7c8cff' },
          { label: '±√t and ±2√t', color: 'rgba(160,165,175,0.7)' },
        ]}
      />
      <Result label="Measured spread σ" />
    </div>

    <div class="sim-panel">
      <Transport />
      <Slider id="n" label="Walkers" min={200} max={6000} step={200} value={2000} />
      <Slider id="sp" label="Steps per frame" min={1} max={20} value={4} />
      <Readout
        rows={[
          { id: 'r-steps', label: 'steps t' },
          { id: 'r-sd', label: 'measured σ' },
          { id: 'r-pred', label: 'predicted √t' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      No walker has any preferred direction, yet the crowd reliably fans out into
      a <b>bell curve</b>. Same mechanism as the Central Limit Theorem: a sum of
      independent steps.
    </li>
    <li>
      Watch the numbers: the spread <b>σ tracks √t</b>, not t. To reach twice as
      far, the cloud needs <b>four times</b> the steps. That square-root law is
      the fingerprint of diffusion.
    </li>
    <li>
      This is the <b>heat equation</b> seen from the particles. The bell widening
      here is the very same profile that heat follows as it spreads.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk } from '../../../lib/draw';
  import { el, slider, transport, result, readout } from '../../../lib/panel';

  const NMAX = 6000;
  const pos = new Float32Array(NMAX);
  const state = { n: 2000, speed: 4, steps: 0, playing: false };
  const TEAL = '#5eead4', ACCENT = '#7c8cff';

  // A handful of walkers whose whole path is remembered and drawn, so the crowd
  // statistics have visible individuals behind them.
  const TRACE = 5;
  const TRACE_COL = ['#f59e0b', '#7c8cff', '#5eead4', '#f472b6', '#e879f9'];
  let trails: number[][] = [];
  const MAXROWS = 3000;

  const canvas = el('walk') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  const TOP = { y0: 30, y1: 300 };
  const BOT = { y0: 350, y1: 560 };
  const PADX = 40;
  const BINS = 81;

  function reset() {
    pos.fill(0);
    state.steps = 0;
    trails = Array.from({ length: TRACE }, () => [0]);
  }
  function step() {
    for (let i = 0; i < state.n; i++) pos[i] += Math.random() < 0.5 ? -1 : 1;
    for (let k = 0; k < TRACE; k++) if (trails[k].length < MAXROWS) trails[k].push(pos[k]);
    state.steps++;
  }
  function stdOf() {
    let m = 0;
    for (let i = 0; i < state.n; i++) m += pos[i];
    m /= state.n;
    let v = 0;
    for (let i = 0; i < state.n; i++) v += (pos[i] - m) ** 2;
    return Math.sqrt(v / state.n);
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    const sd = stdOf();
    const R = Math.max(12, 4 * Math.max(sd, Math.sqrt(state.steps)));
    const mapX = (x: number) => PADX + ((x + R) / (2 * R)) * (W - 2 * PADX);
    const steps = Math.max(1, state.steps);
    const yOfT = (t: number) => TOP.y0 + (t / steps) * (TOP.y1 - TOP.y0);

    label('time runs downward from the shared start', PADX, TOP.y0 - 12, 0.45, 'left', 11.5);
    ctx.strokeStyle = ink(0.14);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(mapX(0), TOP.y0);
    ctx.lineTo(mapX(0), BOT.y1);
    ctx.stroke();

    // the ±√t and ±2√t envelope: it curves, so twice as far takes four times as long
    for (const [k, alpha] of [[1, 0.5], [2, 0.22]] as [number, number][]) {
      for (const sgn of [-1, 1]) {
        ctx.strokeStyle = ink(alpha);
        ctx.setLineDash([4, 4]);
        ctx.beginPath();
        for (let t = 0; t <= steps; t += Math.max(1, steps / 120)) {
          const X = mapX(sgn * k * Math.sqrt(t));
          t === 0 ? ctx.moveTo(X, yOfT(0)) : ctx.lineTo(X, yOfT(t));
        }
        ctx.stroke();
      }
    }
    ctx.setLineDash([]);
    label('+√t', mapX(Math.sqrt(steps)) + 4, TOP.y1 - 4, 0.5, 'left', 11.5);
    label('+2√t', mapX(2 * Math.sqrt(steps)) + 4, TOP.y1 - 20, 0.5, 'left', 11.5);

    // every walker at the current time, along the bottom edge
    ctx.fillStyle = ink(0.4);
    for (let i = TRACE; i < state.n; i++) ctx.fillRect(mapX(pos[i]), TOP.y1 - 1, 1.5, 2.5);

    // the traced walkers' full jagged paths
    for (let k = 0; k < TRACE; k++) {
      const tr = trails[k];
      ctx.strokeStyle = TRACE_COL[k];
      ctx.globalAlpha = 0.85;
      ctx.lineWidth = 1.4;
      ctx.beginPath();
      const stride = Math.max(1, Math.floor(tr.length / (TOP.y1 - TOP.y0)));
      for (let t = 0; t < tr.length; t += stride) {
        t === 0 ? ctx.moveTo(mapX(tr[t]), yOfT(t)) : ctx.lineTo(mapX(tr[t]), yOfT(t));
      }
      ctx.lineTo(mapX(tr[tr.length - 1]), yOfT(tr.length - 1));
      ctx.stroke();
      ctx.fillStyle = TRACE_COL[k];
      ctx.beginPath();
      ctx.arc(mapX(tr[tr.length - 1]), TOP.y1 - 1, 3, 0, Math.PI * 2);
      ctx.fill();
      ctx.globalAlpha = 1;
    }
    label('start', mapX(0) + 6, TOP.y0 + 12, 0.5, 'left', 11.5);
    label('now', mapX(0) + 6, TOP.y1 + 14, 0.5, 'left', 11.5);

    // where everyone is right now
    label('where the walkers are now', PADX, BOT.y0 - 12, 0.45, 'left', 11.5);
    const bins = new Float64Array(BINS);
    const lo = -R, hi = R;
    for (let i = 0; i < state.n; i++) {
      bins[Math.max(0, Math.min(BINS - 1, Math.floor(((pos[i] - lo) / (hi - lo)) * BINS)))]++;
    }
    const binW = (W - 2 * PADX) / BINS, binWidthX = (hi - lo) / BINS;
    let maxDens = 1e-9;
    for (let b = 0; b < BINS; b++) maxDens = Math.max(maxDens, bins[b] / (state.n * binWidthX));
    const gPeak = 1 / (Math.max(sd, 1e-6) * Math.sqrt(2 * Math.PI));
    const yMax = Math.max(maxDens, gPeak) * 1.1;
    const yOf = (d: number) => BOT.y1 - (d / yMax) * (BOT.y1 - BOT.y0);
    ctx.fillStyle = 'rgba(94,234,212,0.5)';
    for (let b = 0; b < BINS; b++) {
      if (!bins[b]) continue;
      const d = bins[b] / (state.n * binWidthX);
      ctx.fillRect(PADX + b * binW, yOf(d), binW - 0.5, BOT.y1 - yOf(d));
    }
    if (sd > 1e-6) {
      ctx.strokeStyle = ACCENT;
      ctx.lineWidth = 2.2;
      ctx.beginPath();
      for (let px = 0; px <= W - 2 * PADX; px += 2) {
        const xv = lo + (px / (W - 2 * PADX)) * (hi - lo);
        const d = gPeak * Math.exp(-(xv * xv) / (2 * sd * sd));
        px === 0 ? ctx.moveTo(PADX + px, yOf(d)) : ctx.lineTo(PADX + px, yOf(d));
      }
      ctx.stroke();
    }
    label('position', W - PADX, BOT.y1 + 18, 0.3, 'right', 11.5);
    label(`−${R.toFixed(0)}`, PADX, BOT.y1 + 18, 0.3, 'left', 11.5);

    const pred = Math.sqrt(state.steps);
    setEq({
      rule: [['\\langle x\\rangle = 0', ACCENT], '\\qquad', ['\\sigma(t) = \\sqrt{\\langle x^2\\rangle} = \\sqrt{t}', TEAL]],
      live: [`t = ${state.steps}`, [`\\quad\\sigma = ${sd.toFixed(1)}`, TEAL], [`\\quad\\sqrt{t} = ${pred.toFixed(1)}`, ACCENT]],
    });
    setResult({
      value: sd.toFixed(1),
      colour: TEAL,
      status: `t = ${state.steps} steps · predicted √t = ${pred.toFixed(1)}`,
      note: 'No drift, but it does spread: distance grows like the square root of time, so it takes four times as long to go twice as far.',
    });
    setRows({ 'r-steps': String(state.steps), 'r-sd': sd.toFixed(1), 'r-pred': pred.toFixed(1) });
  }

  function loop() {
    if (state.playing) for (let k = 0; k < state.speed; k++) step();
    draw();
    requestAnimationFrame(loop);
  }

  slider('n', (v) => { state.n = v; reset(); });
  slider('sp', (v) => (state.speed = v));
  transport({ onRun: (running) => (state.playing = running), onReset: reset });

  reset();
  requestAnimationFrame(loop);
</script>
