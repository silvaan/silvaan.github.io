---
import SimLayout from '../../../layouts/SimLayout.astro';
---

<SimLayout
  areaSlug="statistics"
  title="Marginals & Conditionals"
  description="A marginal is what is left of a joint distribution when you stop caring about one of the variables: add a whole column up and the other variable disappears. A conditional is the opposite move, where you keep the column and rescale it so it adds to one again. Watch the same column do both."
>
  <div class="sim">
    <div class="sim-stage">
      <canvas id="md" class="md-canvas" width="900" height="620"></canvas>
    </div>

    <div class="sim-panel">
      <div class="control">
        <label>Add up</label>
        <div class="seg" id="dir">
          <button data-d="x" class="active">a column, over y</button>
          <button data-d="y">a row, over x</button>
        </div>
      </div>

      <div class="control">
        <label>How the two are linked <b id="rval">0.60</b></label>
        <input type="range" id="rho" min="-140" max="140" value="60" />
        <div class="scale-hint"><span>opposed</span><span>independent</span><span>together</span></div>
      </div>

      <div class="control">
        <label>Which one <b id="kval">3</b></label>
        <input type="range" id="k" min="0" max="4" value="2" />
      </div>

      <label class="check"
        ><input type="checkbox" id="cond" checked /> Show the conditional as
        well</label
      >

      <div class="readout">
        <div class="row"><span>P(x = 3)</span><b id="pm">—</b></div>
        <div class="row"><span>Its cells add to</span><b id="ps">—</b></div>
        <div class="row"><span>Conditional adds to</span><b id="pc">—</b></div>
        <div class="row"><span>All marginals add to</span><b id="pt">—</b></div>
      </div>

      <p class="note">
        Click a column of the table to pick it. The bar at the edge is that
        column added up; the card on the right is the same column rescaled so it
        adds to one.
      </p>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Pick a column. The bar underneath it is <b>literally that column stacked
      up</b>, one segment per cell, and its total is P(x). Summing a variable out
      is that, and nothing more.
    </li>
    <li>
      Every marginal bar is <b>shorter than one</b>, and all of them together add
      to one. A marginal is a share of the whole table, not a distribution over
      the column.
    </li>
    <li>
      The card shows the same column <b>divided by its own total</b>. Now it adds
      to one and it is a distribution again: P(y | x), the conditional. The
      shape is identical, only the scale changed.
    </li>
    <li>
      Set the link to <b>independent</b> and step through the columns. Every
      conditional comes out the <b>same shape</b>, because knowing x tells you
      nothing about y. That is what independence looks like from here.
    </li>
    <li>
      Slide the link to <b>together</b>. Now each column leans a different way,
      so the conditional moves as you change columns while the marginal of y
      stays put. The marginal is the average of all those conditionals, weighted
      by P(x).
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equationBar } from '../../../lib/equation';
  import { roundRect } from '../../../lib/theorem';

  const N = 5;
  const LB = ['1', '2', '3', '4', '5'];
  const state = { rho: 0.6, k: 2, dir: 'x' as 'x' | 'y', cond: true };

  const setEq = equationBar();
  const canvas = document.getElementById('md') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const css = (n: string, f = '') =>
    getComputedStyle(canvas).getPropertyValue(n).trim() || f;
  const ink = (a: number) => `rgba(${css('--stage-ink', '232,233,236')},${a})`;
  const { label } = makeText(ctx, ink);
  const XC = () => css('--accent', '#7c8cff');
  const YC = () => css('--accent-2', '#5eead4');
  const PICK = '#f59e0b';
  const fmt = (v: number, n = 3) => v.toFixed(n);
  /** one hue per row, so a stacked bar says which cell each slice came from */
  const rowCol = (j: number, a = 1) => {
    const t = j / (N - 1);
    const c = [
      Math.round(96 + 150 * t),
      Math.round(200 - 40 * t),
      Math.round(220 - 120 * t),
    ];
    return `rgba(${c[0]},${c[1]},${c[2]},${a})`;
  };
  const colCol = (i: number, a = 1) => {
    const t = i / (N - 1);
    const c = [
      Math.round(120 + 110 * t),
      Math.round(140 - 20 * t),
      Math.round(255 - 90 * t),
    ];
    return `rgba(${c[0]},${c[1]},${c[2]},${a})`;
  };

  const A = [0.14, 0.2, 0.3, 0.22, 0.14];
  const B = [0.18, 0.24, 0.26, 0.2, 0.12];
  const z = (i: number) => (i - (N - 1) / 2) / ((N - 1) / 2);
  let P: number[][] = [];
  function build() {
    P = [];
    let s = 0;
    for (let i = 0; i < N; i++) {
      P.push([]);
      for (let j = 0; j < N; j++) {
        const v = A[i] * B[j] * Math.exp(state.rho * z(i) * z(j) * 2.2);
        P[i].push(v);
        s += v;
      }
    }
    for (let i = 0; i < N; i++) for (let j = 0; j < N; j++) P[i][j] /= s;
  }
  const px = (i: number) => P[i].reduce((a, b) => a + b, 0);
  const py = (j: number) => P.reduce((a, r) => a + r[j], 0);
  /** the chosen line of the table, and the marginal it adds up to */
  const line = () =>
    state.dir === 'x'
      ? P[state.k].map((v) => v)
      : P.map((r) => r[state.k]);
  const marg = (i: number) => (state.dir === 'x' ? px(i) : py(i));
  const HUE = (j: number, a = 1) =>
    state.dir === 'x' ? rowCol(j, a) : colCol(j, a);

  // --- layout ---------------------------------------------------------------
  const G = { x: 96, y: 150, cell: 72 };
  const MX = { y: 150 + N * 72 + 12, h: 62 };
  const MY = { x: 96 + N * 72 + 12, w: 62 };
  const CARD = { x: 596, y: 132, w: 280, h: 400 };
  const cx = (i: number) => G.x + i * G.cell;
  const cy = (j: number) => G.y + (N - 1 - j) * G.cell;

  function drawTable() {
    label('THE JOINT TABLE', 24, 44, 0.45, 'left', 12);
    label(
      state.dir === 'x'
        ? 'one column highlighted · its cells are about to be added up'
        : 'one row highlighted · its cells are about to be added up',
      24,
      62,
      0.3,
      'left',
      11
    );

    let pmax = 0;
    for (let i = 0; i < N; i++)
      for (let j = 0; j < N; j++) pmax = Math.max(pmax, P[i][j]);

    for (let i = 0; i < N; i++)
      for (let j = 0; j < N; j++) {
        const on = state.dir === 'x' ? i === state.k : j === state.k;
        const t = P[i][j] / pmax;
        ctx.fillStyle = on
          ? HUE(state.dir === 'x' ? j : i, 0.25 + 0.7 * t)
          : ink(0.05 + 0.3 * t);
        roundRect(ctx, cx(i) + 2, cy(j) + 2, G.cell - 4, G.cell - 4, 4);
        ctx.fill();
        if (on) {
          ctx.strokeStyle = PICK;
          ctx.lineWidth = 1;
          ctx.stroke();
        }
        label(
          P[i][j].toFixed(3).slice(1),
          cx(i) + G.cell / 2,
          cy(j) + G.cell / 2 + 4,
          on ? 1 : 0.5,
          'center',
          10,
          on ? 'rgba(14,16,20,0.9)' : undefined
        );
      }

    for (let i = 0; i < N; i++)
      label(LB[i], cx(i) + G.cell / 2, MX.y + MX.h + 20, 0.45, 'center', 11);
    for (let j = 0; j < N; j++)
      label(LB[j], G.x - 12, cy(j) + G.cell / 2 + 4, 0.45, 'right', 11);
    label('x', cx(N - 1) + G.cell / 2 + 30, MX.y + MX.h + 20, 0.3, 'left', 11);
    label('y', G.x - 12, G.y - 12, 0.3, 'right', 11);
  }

  /** The marginals along both edges. The chosen one is drawn as a stack. */
  function drawMarginals() {
    let mx = 0;
    for (let i = 0; i < N; i++) mx = Math.max(mx, px(i), py(i));

    // x marginal, underneath
    for (let i = 0; i < N; i++) {
      const h = (px(i) / mx) * MX.h;
      const chosen = state.dir === 'x' && i === state.k;
      if (chosen) {
        let acc = 0;
        for (let j = 0; j < N; j++) {
          const seg = (P[i][j] / mx) * MX.h;
          ctx.fillStyle = rowCol(j, 0.92);
          ctx.fillRect(cx(i) + 8, MX.y + MX.h - acc - seg, G.cell - 16, seg);
          acc += seg;
        }
        ctx.strokeStyle = PICK;
        ctx.lineWidth = 1.5;
        ctx.strokeRect(cx(i) + 8, MX.y + MX.h - h, G.cell - 16, h);
      } else {
        ctx.fillStyle = ink(0.24);
        roundRect(ctx, cx(i) + 8, MX.y + MX.h - h, G.cell - 16, h, 3);
        ctx.fill();
      }
      label(
        px(i).toFixed(2).slice(1),
        cx(i) + G.cell / 2,
        MX.y + MX.h - h - 5,
        chosen ? 1 : 0.45,
        'center',
        9.5,
        chosen ? PICK : undefined
      );
    }
    label('P(x)', G.x - 12, MX.y + MX.h, 0.55, 'right', 10.5, XC());

    // y marginal, on the right
    for (let j = 0; j < N; j++) {
      const w = (py(j) / mx) * MY.w;
      const chosen = state.dir === 'y' && j === state.k;
      if (chosen) {
        let acc = 0;
        for (let i = 0; i < N; i++) {
          const seg = (P[i][j] / mx) * MY.w;
          ctx.fillStyle = colCol(i, 0.92);
          ctx.fillRect(MY.x + acc, cy(j) + 8, seg, G.cell - 16);
          acc += seg;
        }
        ctx.strokeStyle = PICK;
        ctx.lineWidth = 1.5;
        ctx.strokeRect(MY.x, cy(j) + 8, w, G.cell - 16);
      } else {
        ctx.fillStyle = ink(0.24);
        roundRect(ctx, MY.x, cy(j) + 8, w, G.cell - 16, 3);
        ctx.fill();
      }
      label(
        py(j).toFixed(2).slice(1),
        MY.x + w + 5,
        cy(j) + G.cell / 2 + 4,
        chosen ? 1 : 0.45,
        'left',
        9.5,
        chosen ? PICK : undefined
      );
    }
    label('P(y)', MY.x, G.y - 12, 0.55, 'left', 10.5, YC());
  }

  function drawCard() {
    const L = line();
    const m = L.reduce((a, b) => a + b, 0);
    const other = state.dir === 'x' ? 'y' : 'x';
    ctx.save();
    roundRect(ctx, CARD.x, CARD.y, CARD.w, CARD.h, 12);
    ctx.fillStyle = ink(0.04);
    ctx.fill();
    ctx.strokeStyle = ink(0.12);
    ctx.lineWidth = 1;
    ctx.stroke();
    ctx.clip();

    label(
      `THE ${state.dir === 'x' ? 'COLUMN' : 'ROW'} ${LB[state.k]}, ADDED UP`,
      CARD.x + 18,
      CARD.y + 26,
      1,
      'left',
      11,
      PICK
    );

    // the sum, written out
    let y = CARD.y + 56;
    const bx = CARD.x + 18,
      bw = CARD.w - 36;
    const mxv = Math.max(...L);
    L.forEach((v, j) => {
      const yy = y + j * 24;
      const rw = bw - 26 - 46;
      ctx.fillStyle = ink(0.06);
      roundRect(ctx, bx + 26, yy - 10, rw, 13, 3);
      ctx.fill();
      ctx.fillStyle = HUE(j, 0.9);
      roundRect(ctx, bx + 26, yy - 10, Math.max(2, (rw * v) / mxv), 13, 3);
      ctx.fill();
      label(`${other}=${LB[j]}`, bx, yy, 0.4, 'left', 9.5);
      label(fmt(v), bx + bw - 4, yy, 0.9, 'right', 9.5);
    });
    y += N * 24 + 6;
    ctx.strokeStyle = ink(0.16);
    ctx.beginPath();
    ctx.moveTo(bx + 26, y - 12);
    ctx.lineTo(bx + bw, y - 12);
    ctx.stroke();
    label(
      `P(${state.dir}=${LB[state.k]})`,
      bx,
      y + 6,
      0.55,
      'left',
      10.5,
      state.dir === 'x' ? XC() : YC()
    );
    label(fmt(m), bx + bw - 4, y + 8, 1, 'right', 17, PICK);

    if (!state.cond) {
      ctx.restore();
      return;
    }

    // the same line, rescaled so it adds to one again
    y += 40;
    ctx.strokeStyle = ink(0.1);
    ctx.beginPath();
    ctx.moveTo(bx, y - 6);
    ctx.lineTo(bx + bw, y - 6);
    ctx.stroke();
    label(
      `÷ ${fmt(m)}  GIVES  P(${other} | ${state.dir}=${LB[state.k]})`,
      bx,
      y + 16,
      0.55,
      'left',
      10.5
    );
    const cy0 = y + 30,
      ch = 84;
    const cond = L.map((v) => v / (m || 1));
    const cmx = Math.max(...cond) * 1.15;
    const cw = (bw - 20) / N;
    cond.forEach((v, j) => {
      const h = (v / cmx) * ch;
      ctx.fillStyle = HUE(j, 0.9);
      roundRect(ctx, bx + 10 + j * cw + 4, cy0 + ch - h, cw - 8, h, 3);
      ctx.fill();
      label(
        v.toFixed(2).slice(1),
        bx + 10 + j * cw + cw / 2,
        cy0 + ch - h - 5,
        0.75,
        'center',
        9
      );
      label(LB[j], bx + 10 + j * cw + cw / 2, cy0 + ch + 14, 0.35, 'center', 9.5);
    });
    label('adds to 1.000: a distribution again', bx, cy0 + ch + 32, 0.4, 'left', 10);
    ctx.restore();
  }

  function draw() {
    build();
    ctx.clearRect(0, 0, W, H);
    drawTable();
    drawMarginals();
    drawCard();
    sync();
  }

  function sync() {
    const L = line();
    const m = L.reduce((a, b) => a + b, 0);
    const other = state.dir === 'x' ? 'y' : 'x';
    const set = (id: string, v: string) =>
      ((document.getElementById(id) as HTMLElement).textContent = v);
    (document.querySelector('#pm')!.previousElementSibling as HTMLElement).innerHTML =
      `P(${state.dir} = ${LB[state.k]})`;
    set('pm', fmt(m));
    set('ps', fmt(L.reduce((a, b) => a + b, 0)));
    set('pc', fmt(L.reduce((a, b) => a + b, 0) / (m || 1)));
    set(
      'pt',
      fmt(
        state.dir === 'x'
          ? [0, 1, 2, 3, 4].reduce((a, i) => a + px(i), 0)
          : [0, 1, 2, 3, 4].reduce((a, j) => a + py(j), 0)
      )
    );
    set('rval', state.rho.toFixed(2));
    set('kval', LB[state.k]);

    const terms = L.map((v) => v.toFixed(3)).join(' + ');
    setEq([
      [
        [`P(${state.dir})`, state.dir === 'x' ? XC() : YC()],
        `= \\displaystyle\\sum_{${other}} P(x,y)`,
        '\\quad',
        [`P(${other}\\mid ${state.dir}) = \\dfrac{P(x,y)}{P(${state.dir})}`, PICK],
      ],
      [
        [`P(${state.dir}=${LB[state.k]}) = ${terms} = ${fmt(m)}`, PICK],
      ],
      [
        'adding a variable out leaves a share of the table; dividing by that share turns it back into a distribution',
      ],
    ]);
  }

  // --- interaction ---------------------------------------------------------
  const kEl = () => document.getElementById('k') as HTMLInputElement;
  const setK = (k: number) => {
    state.k = Math.max(0, Math.min(N - 1, k));
    kEl().value = String(state.k);
    draw();
  };
  canvas.addEventListener('pointerdown', (e) => {
    const r = canvas.getBoundingClientRect();
    const x = ((e.clientX - r.left) / r.width) * W;
    const y = ((e.clientY - r.top) / r.height) * H;
    if (x < G.x || x > G.x + N * G.cell || y < G.y || y > G.y + N * G.cell) return;
    setK(
      state.dir === 'x'
        ? Math.floor((x - G.x) / G.cell)
        : N - 1 - Math.floor((y - G.y) / G.cell)
    );
  });

  const rhoEl = document.getElementById('rho') as HTMLInputElement;
  rhoEl.addEventListener('input', () => {
    state.rho = +rhoEl.value / 100;
    draw();
  });
  kEl().addEventListener('input', () => setK(+kEl().value));
  document.getElementById('dir')!.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (!b) return;
    document
      .querySelectorAll('#dir button')
      .forEach((x) => x.classList.remove('active'));
    b.classList.add('active');
    state.dir = b.dataset.d as 'x' | 'y';
    draw();
  });
  const cEl = document.getElementById('cond') as HTMLInputElement;
  cEl.addEventListener('change', () => {
    state.cond = cEl.checked;
    draw();
  });

  draw();
</script>

<style>
  .md-canvas {
    cursor: pointer;
    touch-action: none;
  }
  .scale-hint {
    display: flex;
    justify-content: space-between;
    font-size: 0.68rem;
    color: var(--text-faint);
    margin-top: 3px;
  }
  .check {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.4;
  }
  .note {
    font-size: 0.82rem;
    color: var(--text-faint);
    margin: 0;
    line-height: 1.55;
  }
</style>
