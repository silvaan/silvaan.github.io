---
import SimLayout from '../../../layouts/SimLayout.astro';
import Slider from '../../../components/sim/Slider.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
---

<SimLayout
  areaSlug="statistics"
  title="Monte Carlo"
  description="Throw darts at random into a square with a circle inside it. The fraction that land in the circle estimates π, with no calculus at all."
  shortcuts={['run', 'reset', 'fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="mc"
          width="1000"
          height="600"
          role="img"
          aria-label="Random darts on a square with an inscribed circle, and a plot of the running estimate of pi."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'inside the circle', color: '#2dd4bf' },
          { label: 'outside', color: '#f87171' },
          { label: 'estimate over time', color: '#5eead4' },
        ]}
      />
      <Result label="Estimate of π" />
    </div>

    <div class="sim-panel">
      <Transport running />
      <Slider id="rate" label="Darts per frame" min={1} max={500} value={50} />
      <Readout
        rows={[
          { id: 'r-total', label: 'darts thrown' },
          { id: 'r-inside', label: 'inside the circle' },
          { id: 'r-err', label: 'error' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      The square has area 4 and the circle area π, so a random dart lands inside
      with probability <b>π/4</b>. Multiply the hit fraction by 4 and you have an
      estimate of <b>π</b>, no formula for the circle needed.
    </li>
    <li>
      Watch the convergence plot settle toward the dashed π line. It wobbles a
      lot early on, then tightens. The error shrinks like <b>1/√n</b>: a hundred
      times more darts buys only <b>one</b> more digit.
    </li>
    <li>
      That slow square-root rate is the price of pure randomness, and exactly why
      Monte Carlo shines only when the problem is too high-dimensional for
      anything else.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk } from '../../../lib/draw';
  import { el, slider, transport, result, readout } from '../../../lib/panel';

  const IN = '#2dd4bf', OUT = '#f87171', EST = '#5eead4';
  const state = { rate: 50, playing: true };
  let total = 0, inside = 0;
  const dots: { x: number; y: number; hit: boolean }[] = [];
  const DOT_CAP = 5000;
  const history: number[] = [];

  const canvas = el('mc') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  // the board on the left, the running estimate on the right
  const BOARD = { x: 20, y: 20, s: 560 };
  const PLOT = { x: 660, y: 60, w: 300, h: 480 };
  const mapX = (x: number) => BOARD.x + ((x + 1) / 2) * BOARD.s;
  const mapY = (y: number) => BOARD.y + ((1 - y) / 2) * BOARD.s;

  function reset() {
    total = 0;
    inside = 0;
    dots.length = 0;
    history.length = 0;
  }

  function throwDarts(n: number) {
    for (let i = 0; i < n; i++) {
      const x = Math.random() * 2 - 1, y = Math.random() * 2 - 1;
      const hit = x * x + y * y <= 1;
      if (hit) inside++;
      total++;
      dots.push({ x, y, hit });
      if (dots.length > DOT_CAP) dots.shift();
    }
    if (total > 0) {
      const est = (4 * inside) / total;
      const last = history[history.length - 1];
      if (last === undefined || Math.abs(est - last) > 1e-4 || history.length < 300) history.push(est);
      if (history.length > 400) history.shift();
    }
  }

  function drawBoard() {
    ctx.strokeStyle = ink(0.25);
    ctx.lineWidth = 1.5;
    ctx.strokeRect(mapX(-1), mapY(1), BOARD.s, BOARD.s);
    ctx.strokeStyle = ink(0.55);
    ctx.beginPath();
    ctx.arc(mapX(0), mapY(0), BOARD.s / 2, 0, Math.PI * 2);
    ctx.stroke();
    for (const d of dots) {
      ctx.fillStyle = d.hit ? 'rgba(45,212,191,0.8)' : 'rgba(248,113,113,0.8)';
      ctx.beginPath();
      ctx.arc(mapX(d.x), mapY(d.y), 1.7, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  function drawPlot() {
    const lo = Math.PI - 0.9, hi = Math.PI + 0.9;
    const sy = (v: number) => PLOT.y + (1 - (Math.max(lo, Math.min(hi, v)) - lo) / (hi - lo)) * PLOT.h;
    label('estimate, dart by dart', PLOT.x, PLOT.y - 14, 0.45, 'left', 11.5);
    ctx.strokeStyle = ink(0.35);
    ctx.setLineDash([4, 4]);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(PLOT.x, sy(Math.PI));
    ctx.lineTo(PLOT.x + PLOT.w, sy(Math.PI));
    ctx.stroke();
    ctx.setLineDash([]);
    label('π', PLOT.x - 10, sy(Math.PI) + 4, 0.6, 'right', 11);
    label((Math.PI + 0.9).toFixed(1), PLOT.x - 10, PLOT.y + 4, 0.3, 'right', 11);
    label((Math.PI - 0.9).toFixed(1), PLOT.x - 10, PLOT.y + PLOT.h + 4, 0.3, 'right', 11);
    if (history.length > 1) {
      ctx.strokeStyle = EST;
      ctx.lineWidth = 2;
      ctx.beginPath();
      const n = history.length;
      for (let i = 0; i < n; i++) {
        const x = PLOT.x + (i / (n - 1)) * PLOT.w;
        i === 0 ? ctx.moveTo(x, sy(history[i])) : ctx.lineTo(x, sy(history[i]));
      }
      ctx.stroke();
    }
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    drawBoard();
    drawPlot();

    const est = total > 0 ? (4 * inside) / total : 0;
    const err = Math.abs(est - Math.PI);
    setEq({
      rule: ['\\pi \\approx 4\\times', ['\\dfrac{\\text{darts inside}}{\\text{darts thrown}}', IN]],
      live: [[`\\pi \\approx 4\\times\\dfrac{${inside}}{${total}} = ${total ? est.toFixed(5) : '\\text{--}'}`, IN]],
    });
    setResult({
      value: total ? est.toFixed(5) : '—',
      colour: EST,
      status: total ? `off by ${err.toFixed(5)} after ${total} darts` : 'no darts yet',
      note: 'The quarter disc fills π/4 of the square. The error falls like 1/√n, so every extra digit costs a hundred times more darts.',
    });
    setRows({ 'r-total': String(total), 'r-inside': String(inside), 'r-err': total ? err.toFixed(5) : '—' });
  }

  function loop() {
    if (state.playing) throwDarts(state.rate);
    draw();
    requestAnimationFrame(loop);
  }

  slider('rate', (v) => (state.rate = v));
  transport({ onRun: (running) => (state.playing = running), onReset: reset });
  void OUT;

  reset();
  requestAnimationFrame(loop);
</script>
