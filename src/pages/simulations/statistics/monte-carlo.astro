---
import SimLayout from '../../../layouts/SimLayout.astro';
---

<SimLayout
  areaSlug="statistics"
  title="Monte Carlo Estimation of π"
  description="Throw darts at random into a square with a circle inside it. The fraction that land in the circle is π/4, so counting darts estimates π. It converges slowly, but it needs no calculus at all."
>
  <div class="sim">
    <div class="sim-stage">
      <canvas id="mc" width="560" height="560"></canvas>
    </div>

    <div class="sim-panel">
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <button class="btn" id="run">Pause</button>
        <button class="btn ghost" id="reset">Reset</button>
      </div>

      <div class="control">
        <label>Darts / frame <b id="rateval">50</b></label>
        <input type="range" id="rate" min="1" max="500" value="50" />
      </div>

      <div class="readout">
        <div class="row"><span>Darts thrown</span><b id="total">0</b></div>
        <div class="row"><span>Inside circle</span><b id="inside">0</b></div>
        <div class="row"><span>Estimate of π</span><b id="est">—</b></div>
        <div class="row"><span>Error</span><b id="err">—</b></div>
      </div>

      <div class="control">
        <label>Estimate vs. darts</label>
        <canvas id="conv" class="mini-canvas" width="300" height="150"></canvas>
      </div>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      The square has area 4 and the circle area π, so a random dart lands inside
      with probability <b>π/4</b>. Multiply the hit fraction by 4 and you have an
      estimate of <b>π</b>, no formula for the circle needed.
    </li>
    <li>
      Watch the convergence plot settle toward the dashed π line. It wobbles a
      lot early on, then tightens. The error shrinks like <b>1/√n</b>: a hundred
      times more darts buys only <b>one</b> more digit.
    </li>
    <li>
      That slow square-root rate is the price of pure randomness, and exactly why
      Monte Carlo shines only when the problem is too high-dimensional for
      anything else.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas } from '../../../lib/sim';

  const state = { rate: 50, playing: true };
  let total = 0;
  let inside = 0;
  const dots: { x: number; y: number; hit: boolean }[] = [];
  const DOT_CAP = 5000;
  const history: number[] = [];

  const canvas = document.getElementById('mc') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const convCanvas = document.getElementById('conv') as HTMLCanvasElement;
  const cv = setupCanvas(convCanvas, () => drawConv());
  const css = (v: string) => getComputedStyle(canvas).getPropertyValue(v).trim();

  const PAD = 16;
  const S = Math.min(W, H) - 2 * PAD;
  const mapX = (x: number) => PAD + ((x + 1) / 2) * S;
  const mapY = (y: number) => PAD + ((1 - y) / 2) * S;

  function reset() {
    total = 0;
    inside = 0;
    dots.length = 0;
    history.length = 0;
  }

  function throwDarts(n: number) {
    for (let i = 0; i < n; i++) {
      const x = Math.random() * 2 - 1;
      const y = Math.random() * 2 - 1;
      const hit = x * x + y * y <= 1;
      if (hit) inside++;
      total++;
      dots.push({ x, y, hit });
      if (dots.length > DOT_CAP) dots.shift();
    }
    if (total > 0) {
      const est = (4 * inside) / total;
      const last = history[history.length - 1];
      if (last === undefined || Math.abs(est - last) > 1e-4 || history.length < 300)
        history.push(est);
      if (history.length > 400) history.shift();
    }
  }

  function draw() {
    const grid = css('--border-strong') || '#343a45';
    const ink = css('--stage-ink') || '232,233,236';
    ctx.clearRect(0, 0, W, H);

    // square + circle
    ctx.strokeStyle = grid;
    ctx.lineWidth = 1.5;
    ctx.strokeRect(mapX(-1), mapY(1), S, S);
    ctx.strokeStyle = `rgba(${ink},0.55)`;
    ctx.beginPath();
    ctx.arc(mapX(0), mapY(0), S / 2, 0, Math.PI * 2);
    ctx.stroke();

    for (const d of dots) {
      ctx.fillStyle = d.hit ? 'rgba(45,212,191,0.8)' : 'rgba(248,113,113,0.8)';
      ctx.beginPath();
      ctx.arc(mapX(d.x), mapY(d.y), 1.7, 0, Math.PI * 2);
      ctx.fill();
    }

    const est = total > 0 ? (4 * inside) / total : 0;
    (document.getElementById('total') as HTMLElement).textContent = String(total);
    (document.getElementById('inside') as HTMLElement).textContent = String(inside);
    (document.getElementById('est') as HTMLElement).textContent = total ? est.toFixed(5) : '—';
    (document.getElementById('err') as HTMLElement).textContent = total
      ? Math.abs(est - Math.PI).toFixed(5)
      : '—';
  }

  function drawConv() {
    const c = cv.ctx, Ws = cv.W, Hs = cv.H;
    const ink = css('--stage-ink') || '232,233,236';
    const pad = { l: 30, r: 8, t: 10, b: 8 };
    const lo = Math.PI - 0.9;
    const hi = Math.PI + 0.9;
    const sy = (v: number) => pad.t + (1 - (Math.max(lo, Math.min(hi, v)) - lo) / (hi - lo)) * (Hs - pad.t - pad.b);
    c.clearRect(0, 0, Ws, Hs);

    // pi line
    c.strokeStyle = `rgba(${ink},0.35)`;
    c.setLineDash([4, 4]);
    c.lineWidth = 1;
    c.beginPath();
    c.moveTo(pad.l, sy(Math.PI));
    c.lineTo(Ws - pad.r, sy(Math.PI));
    c.stroke();
    c.setLineDash([]);
    c.fillStyle = css('--text-faint') || '#8b93a5';
    c.font = "10px 'JetBrains Mono', monospace";
    c.fillText('π', 6, sy(Math.PI) + 3);

    if (history.length > 1) {
      c.strokeStyle = css('--accent-2') || '#5eead4';
      c.lineWidth = 2;
      c.beginPath();
      const n = history.length;
      for (let i = 0; i < n; i++) {
        const x = pad.l + (i / (n - 1)) * (Ws - pad.l - pad.r);
        const y = sy(history[i]);
        i === 0 ? c.moveTo(x, y) : c.lineTo(x, y);
      }
      c.stroke();
    }
  }

  function loop() {
    if (state.playing) throwDarts(state.rate);
    draw();
    drawConv();
    requestAnimationFrame(loop);
  }

  const rateEl = document.getElementById('rate') as HTMLInputElement;
  rateEl.addEventListener('input', () => {
    state.rate = +rateEl.value;
    (document.getElementById('rateval') as HTMLElement).textContent = rateEl.value;
  });
  const runBtn = document.getElementById('run') as HTMLButtonElement;
  runBtn.addEventListener('click', () => {
    state.playing = !state.playing;
    runBtn.textContent = state.playing ? 'Pause' : 'Run';
  });
  document.getElementById('reset')!.addEventListener('click', reset);

  reset();
  requestAnimationFrame(loop);
</script>
