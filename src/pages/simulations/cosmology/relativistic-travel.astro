    padding: 0;
    overflow: hidden;
  }
  .rt-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 960 / 660;
    overflow: hidden;
    background: #010204;
  }
  .rt-wrap canvas {
    position: absolute;
    inset: 0;
