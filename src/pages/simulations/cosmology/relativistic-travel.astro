---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Checks from '../../../components/sim/Checks.astro';
import Transport from '../../../components/sim/Transport.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="cosmology"
  title="Travelling Near the Speed of Light"
  description="Set a speed and a heading and redraw the real sky three ways: as Earth maps it, as the ship measures it, and where the light the ship sees set out from. Underneath, a ladder of scales from the Moon to the Coma Cluster shows how near everything gets for you, and how long it takes on your own clock."
  shortcuts={['run', 'reset', 'fullscreen']}
  standard={false}
>
  <div class="sim rt-sim">
    <div class="sim-view">
      <div class="sim-stage rt-stage">
        <div class="rt-wrap" id="rt-wrap">
          <canvas id="rtgl" aria-hidden="true"></canvas>
          <canvas
            id="rt"
            role="img"
            aria-label="A 3D map of real stars and galaxies around a ship moving near the speed of light, redrawn as Earth measures it, as the ship measures it, or as the ship sees it, above a logarithmic ladder of distances and trip times."
          ></canvas>
          <button type="button" class="rt-toggle" id="rt-toggle" aria-pressed="true">Controls</button>
        </div>
      </div>
    </div>

    <div class="sim-panel">
      <Seg
        id="map"
        label="Map"
        attr="m"
        options={[
          { value: 'earth', label: 'Earth’s map' },
          { value: 'ship', label: 'Measured by the ship' },
          { value: 'seen', label: 'Seen from the ship' },
        ]}
      />
      <Slider id="speed" label="Speed" min={0} max={7} step={0.01} value={2} display="0.99 c" hint={['at rest', '0.9999999 c']} />
      <Transport />
      <Seg
        id="dest"
        label="Heading for"
        attr="d"
        active="gc"
        options={[
          { value: 'proxima', label: 'Proxima Centauri' },
          { value: 'vega', label: 'Vega' },
          { value: 'betelgeuse', label: 'Betelgeuse' },
          { value: 'gc', label: 'Galactic Centre' },
          { value: 'andromeda', label: 'Andromeda' },
          { value: 'virgo', label: 'Virgo Cluster' },
        ]}
      />
      <Checks
        label="Show"
        items={[
          { id: 'l-stars', label: 'Stars', checked: true },
          { id: 'l-mw', label: 'Milky Way', checked: true },
          { id: 'l-gal', label: 'Galaxies', checked: true },
          { id: 'l-ring', label: 'Everything as far as the destination', checked: true },
          { id: 'l-labels', label: 'Labels', checked: true },
        ]}
      />
      <Readout
        title="Numbers"
        open
        rows={[
          { id: 'r-beta', label: 'Speed β = v/c' },
          { id: 'r-gamma', label: 'Lorentz factor γ' },
          { id: 'r-earth', label: 'Destination, Earth’s map' },
          { id: 'r-ship', label: 'Measured by the ship' },
          { id: 'r-seen', label: 'Its light set out from' },
          { id: 'r-tship', label: 'Trip, ship clock' },
          { id: 'r-tearth', label: 'Trip, Earth clock' },
        ]}
      />
      <details class="numeric-details">
        <summary>The three maps</summary>
        <ul class="rt-notes">
          <li><b>Earth’s map</b>: where everything is now, by the ruler of anyone at rest with the stars.</li>
          <li>
            <b>Measured by the ship</b>: where everything is now, by the ship’s ruler. Distances along the motion
            are divided by γ, across it they stay the same.
          </li>
          <li>
            <b>Seen from the ship</b>: where each object was when it sent the light reaching the ship now, in the
            ship’s frame. Ahead the distance is multiplied by γ(1 + β), behind by γ(1 − β); the directions are the
            aberrated ones a camera on board would record.
          </li>
          <li>Speeds are held constant: the trip times leave out speeding up and slowing down.</li>
        </ul>
      </details>
      <details class="numeric-details">
        <summary>Data sources</summary>
        <ul class="rt-notes">
          <li>Stars: HYG database (Hipparcos, Yale, Gliese).</li>
          <li>Milky Way: arms from Reid et al. (2019), bar and disk from the standard models.</li>
          <li>Local Group: McConnachie (2012). Galaxies: 2MASS Redshift Survey.</li>
        </ul>
      </details>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      At 0.99 c, γ ≈ 7. On the ship’s ruler the galaxy is <b>squashed seven times flatter</b> along the way you are
      going, and nothing changes across it. <Try id="squash" />
    </li>
    <li>
      Watch the ladder: the ship’s row is Earth’s row slid left by the same amount everywhere. A year on board
      never takes you more than a light-year by your own ruler, yet at 0.9999999 c the Galactic Centre is only
      12 light-years away, well inside <b>a lifetime’s reach</b>. <Try id="ladder" />
    </li>
    <li>
      The view out of the window is different again. The light you see from ahead set out long ago, from far away:
      the sky in front is <b>stretched out</b> by γ(1 + β), while everything behind piles up close to the ship. <Try id="seen" />
    </li>
    <li>
      Andromeda is 2.5 million light-years away. At 0.9999999 c it is <b>1,100 light-years</b> away for the crew,
      who arrive after 1,100 years of their own time while 2.5 million pass on Earth. <Try id="andromeda" />
    </li>
    <li>
      At walking-pace fractions of c nothing happens: set 0.1 c and the three maps barely differ, because γ is only
      1.005. The effects only pile up in the last few nines. <Try id="slow" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { el, segmented, slider, check, transport, readout, tries } from '../../../lib/panel';
  import { View, v3, compile, vertexArray, setView, fitCanvas, GLSL_PROJECT, type V3, type Program } from '../../../lib/gl3d';
  import { LY_PER_PC, PC_PER_MPC, radec, starRGB, loadStars, loadStarNames, loadLocalGroup, loadGalaxies, fmtDist } from '../../../lib/cosmos';
  import { GC, DISKS, diskGalaxy, milkyWay } from '../../../lib/galaxies';

  const MPC = PC_PER_MPC;
  const GOLD = '#f5c26b', BLUE = '#9cc4ff', TEAL = '#5eead4', ROSE = '#ff9fb2';
  const MAPS = ['earth', 'ship', 'seen'] as const;
  type MapKey = (typeof MAPS)[number];
  const MAP_INFO: Record<MapKey, { name: string; line: string; colour: string }> = {
    earth: { name: 'Earth’s map', line: 'Where everything is now, by the ruler of the stars’ own frame', colour: BLUE },
    ship: { name: 'Measured by the ship', line: 'Where everything is now, by the ship’s ruler: squeezed by γ along the motion', colour: TEAL },
    seen: { name: 'Seen from the ship', line: 'Where the light reaching the ship now set out from: stretched ahead, crowded behind', colour: ROSE },
  };

  type Dest = { name: string; pos: V3 };
  const M31: V3 = radec(10.6847, 41.269, 765000);
  const DESTS: Record<string, Dest> = {
    proxima: { name: 'Proxima Centauri', pos: radec(217.429, -62.68, 1.301) },
    vega: { name: 'Vega', pos: radec(279.2347, 38.7837, 7.68) },
    betelgeuse: { name: 'Betelgeuse', pos: radec(88.7929, 7.4071, 168) },
    gc: { name: 'Galactic Centre', pos: GC },
    andromeda: { name: 'Andromeda', pos: M31 },
    virgo: { name: 'Virgo Cluster', pos: radec(187.7, 12.39, 16.5 * MPC) },
  };

  const state = {
    map: 'earth' as MapKey,
    // weights of the three maps actually drawn, eased towards the chosen one
    w: [1, 0, 0] as [number, number, number],
    s: 2, // β = 1 − 10^(−s)
    dest: 'gc',
    running: false,
    show: { stars: true, mw: true, gal: true, ring: true, labels: true },
    // the camera orbits `centre` in the frame of the motion (yaw 0 = looking back along it)
    centre: [0, 0, 0] as V3,
    r: 60000,
    yaw: -Math.PI / 2 + 0.25,
    pitch: 0.42,
    // while on, the camera keeps the ship and the destination framed as the maps change
    frame: true,
  };

  // =====================================================================
  //  Kinematics
  // =====================================================================
  const beta = () => (state.s <= 0 ? 0 : 1 - Math.pow(10, -state.s));
  const oneMinusBeta = () => (state.s <= 0 ? 1 : Math.pow(10, -state.s));
  const gamma = () => {
    const omb = oneMinusBeta();
    return 1 / Math.sqrt(omb * (2 - omb));
  };
  const heading = () => v3.unit(DESTS[state.dest].pos);

  /**
   * A point at rest in Earth's frame (pc from the ship, which is passing the
   * Sun) drawn in each map. Measured: x∥/γ at the same moment for the ship.
   * Seen: the event that sent the light arriving now, x∥' = γ(x∥ + β r). Behind
   * the ship x∥ + β r is a small difference of large numbers, so it is
   * rewritten as x⊥²/(r − x∥) − (1 − β) r.
   */
  function mapPoint(x: V3, w = state.w): V3 {
    const u = heading(), b = beta(), g = gamma(), omb = oneMinusBeta();
    const par = v3.dot(x, u), perp = v3.sub(x, v3.mul(u, par));
    const r = v3.len(x);
    const ahead = par >= 0 ? par + b * r : v3.dot(perp, perp) / Math.max(r - par, 1e-300) - omb * r;
    const along = w[0] * par + w[1] * (par / g) + w[2] * (g * ahead);
    return v3.add(perp, v3.mul(u, along));
  }

  // =====================================================================
  //  Canvas: one GL layer for the sky, a 2D layer on top for the rest
  // =====================================================================
  const wrap = el('rt-wrap');
  const simRoot = wrap.closest('.rt-sim') as HTMLElement;
  const toggle = el('rt-toggle');
  toggle.addEventListener('click', () => {
    const off = simRoot.classList.toggle('rt-panel-off');
    toggle.setAttribute('aria-pressed', String(!off));
  });
  const canvas = el('rt') as HTMLCanvasElement;
  const glc = el('rtgl') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  let W = 960, H = 640, LH = 190, MH = 450; // whole, ladder, map heights
  const view = new View();
  view.tanY = 0.5;
  let dirty = true;
  function resize() {
    const b = wrap.getBoundingClientRect();
    W = Math.max(200, b.width);
    H = Math.max(240, b.height);
    LH = Math.round(Math.max(175, Math.min(230, H * 0.3)));
    MH = H - LH;
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    canvas.width = Math.round(W * dpr);
    canvas.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    view.aspect = W / MH;
    view.px = MH;
    dirty = true;
  }
  resize();
  new ResizeObserver(resize).observe(wrap);

  const setRows = readout();
  const gl = glc.getContext('webgl2', { antialias: false, alpha: false, preserveDrawingBuffer: true });

  // Points are lit by their light as seen from the camera, as in the atlas,
  // at the position the chosen map gives them.
  const POINT_VS = `#version 300 es
in vec3 aPos;
in float aSize;
in float aLum;
in vec3 aCol;
${GLSL_PROJECT}
uniform vec3 uU, uW;
uniform float uBeta, uGamma, uOmb;
uniform float uUnit, uExpo, uMin, uMax, uDpr, uFloor, uGain;
out vec3 vCol;
out float vA;
out float vSoft;
void main() {
  float par = dot(aPos, uU);
  vec3 perp = aPos - uU * par;
  float r = length(aPos);
  float ahead = par >= 0.0 ? par + uBeta * r : dot(perp, perp) / max(r - par, 1e-30) - uOmb * r;
  vec3 x = perp + uU * (uW.x * par + uW.y * par / uGamma + uW.z * uGamma * ahead);
  vec3 rel;
  vec4 p = project(x, rel);
  float dpc = max(length(rel) * uUnit, 1e-30);
  float R = aSize * uUnit;
  float pxR = R / (2.0 * uTanY * dpc) * uPx * uDpr;
  // a map that stretches a region by k spreads its light k times thinner;
  // squeezed regions are left as they are rather than burnt out
  float k = r > 0.0 ? clamp(length(x) / r, 1.0, 1e4) : 1.0;
  float I = aLum * 100.0 / (dpc * dpc) * uExpo * uGain / k;
  float m = uMin * uDpr;
  float size = max(2.0 * pxR, m);
  float Ie = I * (m / size) * (m / size);
  if (2.0 * pxR <= m && Ie > 1.0) size *= min(pow(Ie, 0.22), 7.0);
  float a = max(min(Ie, 1.0), uFloor);
  if (aSize > 0.0) a *= smoothstep(0.6, 3.0, dpc / R);
  size = min(size, uMax * uDpr);
  vSoft = aSize > 0.0 ? 1.0 : 0.0;
  vCol = aCol;
  vA = a;
  gl_Position = p;
  gl_PointSize = (a < 0.003 || p.w <= 0.0) ? 0.0 : size;
}`;
  const POINT_FS = `#version 300 es
precision highp float;
in vec3 vCol;
in float vA;
in float vSoft;
out vec4 o;
void main() {
  vec2 q = gl_PointCoord * 2.0 - 1.0;
  float r2 = dot(q, q);
  if (r2 > 1.0) discard;
  float f = vSoft > 0.5 ? exp(-r2 * 3.5) * (1.0 - r2) : exp(-r2 * 16.0) + 0.1 * exp(-r2 * 3.0) * (1.0 - r2);
  o = vec4(vCol * vA * f, 1.0);
}`;

  const prog: Program | null = gl ? compile(gl, POINT_VS, POINT_FS, 'relativistic-travel') : null;
  type Layer = { vao: WebGLVertexArrayObject; count: number; unit: number; floor: number; fade: () => number; gain: number; min: number; on: () => boolean };
  const layers: Record<string, Layer> = {};
  const ATTRS: [string, number][] = [['aPos', 3], ['aSize', 1], ['aLum', 1], ['aCol', 3]];
  function addLayer(key: string, data: Float32Array, unit: number, o: { floor?: number; fade?: () => number; gain?: number; min?: number; on: () => boolean }) {
    if (!gl || !prog) return;
    const va = vertexArray(gl, prog, data, ATTRS);
    layers[key] = { vao: va.vao, count: va.count, unit, floor: o.floor ?? 0, fade: o.fade ?? (() => 1), gain: o.gain ?? 1, min: o.min ?? 1.6, on: o.on };
    dirty = true;
  }
  const lum = (M: number) => Math.pow(10, -0.4 * M);
  /** 0 below `a` Mpc of view distance, 1 above `b`, smooth in log between. */
  const scaleFade = (a: number, b: number) => {
    const t = Math.log(state.r / (a * MPC)) / Math.log(b / a);
    const c = Math.max(0, Math.min(1, t));
    return c * c * (3 - 2 * c);
  };

  // --- the sky --------------------------------------------------------------
  type Mark = { name: string; pos: V3; kind: 'star' | 'mw' | 'galaxy' };
  const marks: Mark[] = [
    { name: 'Galactic Centre', pos: GC, kind: 'mw' },
    { name: 'Andromeda', pos: M31, kind: 'galaxy' },
    { name: 'Triangulum', pos: radec(23.4621, 30.66, 840000), kind: 'galaxy' },
    { name: 'Large Magellanic Cloud', pos: radec(80.894, -69.756, 49970), kind: 'galaxy' },
    { name: 'Small Magellanic Cloud', pos: radec(13.187, -72.829, 62440), kind: 'galaxy' },
    { name: 'Virgo Cluster', pos: DESTS.virgo.pos, kind: 'galaxy' },
    { name: 'Coma Cluster', pos: radec(194.95, 27.98, 100 * MPC), kind: 'galaxy' },
    { name: 'Perseus Cluster', pos: radec(49.95, 41.51, 75 * MPC), kind: 'galaxy' },
    { name: 'Centaurus Cluster', pos: radec(192.2, -41.31, 52 * MPC), kind: 'galaxy' },
    { name: 'Pleiades', pos: radec(56.75, 24.12, 136), kind: 'star' },
  ];
  {
    const mw: number[] = [], dust: number[] = [], others: number[] = [];
    milkyWay(mw, dust);
    for (const d of DISKS) diskGalaxy(d.spec, others);
    addLayer('mw', new Float32Array(mw), 1, { on: () => state.show.mw, min: 1.2, gain: 1.4 });
    addLayer('disks', new Float32Array(others), 1, { on: () => state.show.gal, min: 1.2, gain: 3 });
  }
  const STAR_LABELS = new Set(['Proxima Centauri', 'Sirius', 'Vega', 'Betelgeuse', 'Rigel', 'Deneb', 'Polaris', 'Arcturus', 'Canopus', 'Antares']);
  loadStars().then((c) => {
    const d = new Float32Array((c.n + 1) * 8);
    d.set([0, 0, 0, 0, lum(4.83), ...starRGB(0.65)], 0);
    for (let i = 0; i < c.n; i++) {
      const o = i * c.stride;
      d.set([c.rows[o], c.rows[o + 1], c.rows[o + 2], 0, lum(c.rows[o + 3]), ...starRGB(c.rows[o + 4])], (i + 1) * 8);
    }
    addLayer('stars', d, 1, { on: () => state.show.stars });
    loadStarNames().then((list) => {
      for (const s of list) {
        if (!STAR_LABELS.has(s.n)) continue;
        const o = s.i * c.stride;
        const p: V3 = [c.rows[o], c.rows[o + 1], c.rows[o + 2]];
        marks.push({ name: s.n, pos: p, kind: 'star' });
        // the catalogue's own position, so the label sits on the dot
        const key = s.n === 'Proxima Centauri' ? 'proxima' : s.n === 'Vega' ? 'vega' : s.n === 'Betelgeuse' ? 'betelgeuse' : '';
        if (key) DESTS[key].pos = p;
      }
      dirty = true;
    });
  });
  loadLocalGroup().then((list) => {
    const d: number[] = [];
    for (const g of list) {
      if (DISKS.some((k) => k.name === g.n)) continue;
      const p = v3.mul(g.p, MPC);
      const M = g.M ?? -8;
      const R = g.r ? g.r * 2.5 : 400;
      d.push(...p, R, lum(M), ...(/Irr/.test(g.t) ? [0.7, 0.8, 1.0] : [1.0, 0.88, 0.7]));
    }
    addLayer('lg', new Float32Array(d), 1, { on: () => state.show.gal, floor: 0.04 });
  });
  loadGalaxies().then((c) => {
    const d = new Float32Array(c.n * 8);
    for (let i = 0; i < c.n; i++) {
      const o = i * c.stride, MK = c.rows[o + 3], early = c.rows[o + 4] > 0.5;
      const R = 0.011 * Math.pow(10, -0.2 * (MK + 24)) * (early ? 0.7 : 1);
      d.set([c.rows[o], c.rows[o + 1], c.rows[o + 2], R, lum(MK + 3), ...(early ? [1.0, 0.82, 0.62] : [0.62, 0.76, 1.0])], i * 8);
    }
    addLayer('gal', d, MPC, { on: () => state.show.gal, floor: 0.45, fade: () => scaleFade(0.5, 5) });
  });

  // =====================================================================
  //  Camera, in the frame of the motion: e1 ahead, e3 as near galactic north as can be
  // =====================================================================
  function basis() {
    const e1 = heading();
    let e3 = v3.sub([0, 0, 1], v3.mul(e1, e1[2]));
    if (v3.len(e3) < 1e-6) e3 = [1, 0, 0];
    e3 = v3.unit(e3);
    return { e1, e2: v3.cross(e3, e1), e3 };
  }
  function placeCamera() {
    const { e1, e2, e3 } = basis();
    const cp = Math.cos(state.pitch);
    const dir = v3.add(v3.add(v3.mul(e1, cp * Math.cos(state.yaw)), v3.mul(e2, cp * Math.sin(state.yaw))), v3.mul(e3, Math.sin(state.pitch)));
    view.eye = v3.add(state.centre, v3.mul(dir, state.r));
    view.look(v3.mul(dir, -1), e3);
  }

  /** Where the camera wants to be: the ship and the destination both in view, in the map drawn. */
  function framing() {
    const D = v3.len(DESTS[state.dest].pos);
    const p = mapPoint(DESTS[state.dest].pos);
    const ext = Math.max(v3.len(p), D * (1 - state.w[2]) + D * state.w[2] * 0.5);
    return { centre: v3.mul(p, 0.45), r: ext * 1.55 };
  }

  // =====================================================================
  //  Drawing
  // =====================================================================
  function drawGL() {
    if (!gl || !prog) return;
    const dpr = fitCanvas(glc, W, H);
    gl.viewport(0, 0, glc.width, glc.height);
    gl.clearColor(0.004, 0.006, 0.014, 1);
    gl.clear(gl.COLOR_BUFFER_BIT);
    // the map takes the top of the stage, the ladder the rest
    gl.viewport(0, Math.round(LH * dpr), glc.width, glc.height - Math.round(LH * dpr));
    gl.enable(gl.BLEND);
    gl.blendFunc(gl.ONE, gl.ONE);
    gl.useProgram(prog.prog);
    const u = heading(), b = beta(), g = gamma();
    // Stretched maps spread the same light over a bigger view: the exposure
    // follows the zoom relative to the Earth map's own framing, as a camera's would.
    const natural = 1.55 * v3.len(DESTS[state.dest].pos);
    const expo = Math.pow(10, 0.4 * 7.5) * Math.min(400, Math.max(1, (state.r / natural) ** 2));
    const maxPoint = (gl.getParameter(gl.ALIASED_POINT_SIZE_RANGE) as Float32Array)[1];
    for (const key of ['mw', 'disks', 'gal', 'lg', 'stars']) {
      const L = layers[key];
      if (!L || !L.on()) continue;
      setView(gl, prog, view, v3.mul(view.eye, 1 / L.unit));
      gl.uniform3f(prog.u('uU'), ...u);
      gl.uniform3f(prog.u('uW'), ...state.w);
      gl.uniform1f(prog.u('uBeta'), b);
      gl.uniform1f(prog.u('uGamma'), g);
      gl.uniform1f(prog.u('uOmb'), oneMinusBeta());
      gl.uniform1f(prog.u('uUnit'), L.unit);
      gl.uniform1f(prog.u('uExpo'), expo);
      gl.uniform1f(prog.u('uMin'), L.min);
      gl.uniform1f(prog.u('uMax'), Math.min(maxPoint / dpr, 200));
      gl.uniform1f(prog.u('uDpr'), dpr);
      gl.uniform1f(prog.u('uFloor'), L.floor * L.fade());
      gl.uniform1f(prog.u('uGain'), L.gain);
      gl.bindVertexArray(L.vao);
      gl.drawArrays(gl.POINTS, 0, L.count);
    }
    gl.bindVertexArray(null);
  }

  const proj = (p: V3) => view.project(p, W, MH);

  function drawRing() {
    // the sphere of everything as far as the destination, cut through the
    // plane of the motion that faces the camera
    const u = heading();
    let n = v3.sub(view.fwd, v3.mul(u, v3.dot(view.fwd, u)));
    if (v3.len(n) < 1e-6) n = basis().e2;
    const w = v3.unit(v3.cross(v3.unit(n), u));
    const R = v3.len(DESTS[state.dest].pos);
    ctx.beginPath();
    let pen = false, top: { x: number; y: number } | null = null;
    for (let i = 0; i <= 240; i++) {
      const t = (i / 240) * 2 * Math.PI;
      const q = proj(mapPoint(v3.add(v3.mul(u, R * Math.cos(t)), v3.mul(w, R * Math.sin(t)))));
      if (!q) { pen = false; continue; }
      if (pen) ctx.lineTo(q.x, q.y);
      else ctx.moveTo(q.x, q.y);
      pen = true;
      if (!top || q.y < top.y) top = q;
    }
    ctx.strokeStyle = 'rgba(245,194,107,0.55)';
    ctx.setLineDash([5, 5]);
    ctx.lineWidth = 1.2;
    ctx.stroke();
    ctx.setLineDash([]);
    if (top && top.y > 60) {
      ctx.fillStyle = 'rgba(245,194,107,0.8)';
      ctx.font = '11.5px ui-sans-serif, system-ui, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(`everything ${fmtDist(R)} from the ship, on Earth’s map`, top.x, top.y - 7);
      ctx.textAlign = 'left';
    }
  }

  function drawShip() {
    const o = proj([0, 0, 0]);
    if (!o) return;
    // the arrow of motion, a fixed length on screen
    const u = heading();
    const z = v3.dot(v3.sub([0, 0, 0], view.eye), view.fwd);
    const step = (40 / view.pxPer(Math.max(z, 1e-30)));
    const a = proj(v3.mul(u, step));
    ctx.strokeStyle = ROSE;
    ctx.fillStyle = ROSE;
    ctx.lineWidth = 2;
    if (a) {
      const dx = a.x - o.x, dy = a.y - o.y, L = Math.hypot(dx, dy) || 1;
      const ux = dx / L, uy = dy / L;
      const tip = { x: o.x + ux * 40, y: o.y + uy * 40 };
      ctx.beginPath();
      ctx.moveTo(o.x, o.y);
      ctx.lineTo(tip.x, tip.y);
      ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(tip.x + ux * 4, tip.y + uy * 4);
      ctx.lineTo(tip.x - ux * 7 - uy * 5, tip.y - uy * 7 + ux * 5);
      ctx.lineTo(tip.x - ux * 7 + uy * 5, tip.y - uy * 7 - ux * 5);
      ctx.closePath();
      ctx.fill();
    }
    ctx.beginPath();
    ctx.arc(o.x, o.y, 3.5, 0, 2 * Math.PI);
    ctx.fill();
    ctx.font = '600 12px ui-sans-serif, system-ui, sans-serif';
    ctx.fillText('ship, passing the Sun', o.x + 8, o.y + 16);
  }

  function drawLabels() {
    const placed: { x: number; y: number; w: number }[] = [];
    const dest = DESTS[state.dest];
    const list: { m: Mark | null; name: string; pos: V3 }[] = [{ m: null, name: dest.name, pos: dest.pos }];
    for (const m of marks) if (m.name !== dest.name) list.push({ m, name: m.name, pos: m.pos });
    ctx.font = '11.5px ui-sans-serif, system-ui, sans-serif';
    for (const it of list) {
      const d = v3.len(it.pos);
      // label what belongs to the scale on screen
      if (it.m && (d < state.r * 0.012 || d > state.r * 25)) continue;
      if (it.m?.kind === 'star' && !state.show.stars) continue;
      if (it.m?.kind === 'galaxy' && !state.show.gal) continue;
      const q = proj(mapPoint(it.pos));
      if (!q || q.x < 0 || q.x > W || q.y < 0 || q.y > MH) continue;
      const w = ctx.measureText(it.name).width + 10;
      if (it.m && placed.some((p) => Math.abs(p.x - q.x) < (p.w + w) / 2 && Math.abs(p.y - q.y) < 15)) continue;
      placed.push({ x: q.x + w / 2, y: q.y, w });
      const isDest = !it.m;
      ctx.fillStyle = isDest ? GOLD : 'rgba(220,226,240,0.85)';
      ctx.beginPath();
      ctx.arc(q.x, q.y, isDest ? 3.5 : 2, 0, 2 * Math.PI);
      if (isDest) {
        ctx.strokeStyle = GOLD;
        ctx.lineWidth = 1.3;
        ctx.stroke();
      } else ctx.fill();
      ctx.font = isDest ? '600 12.5px ui-sans-serif, system-ui, sans-serif' : '11.5px ui-sans-serif, system-ui, sans-serif';
      ctx.fillText(it.name, q.x + 7, q.y - 6);
    }
  }

  const fmtBeta = () => {
    const s = state.s;
    if (s <= 0) return '0';
    const b = beta();
    if (b < 0.9) return b.toFixed(3);
    return b.toFixed(Math.min(12, Math.ceil(s + 0.0001) + 1)).replace(/0+$/, '').replace(/\.$/, '');
  };
  const sig = (v: number) => (v >= 100 ? Math.round(v).toLocaleString('en-US') : (+v.toPrecision(3)).toString());
  /** A span of years, in the unit that reads best. */
  function fmtT(yr: number, short = false) {
    if (!isFinite(yr)) return short ? '∞' : 'never';
    const s = yr * 3.15576e7;
    if (s < 60) return `${sig(s)} s`;
    if (s < 3600) return `${sig(s / 60)} min`;
    if (s < 86400 * 2) return `${sig(s / 3600)} h`;
    if (yr < 1) return `${sig(s / 86400)} ${short ? 'd' : 'days'}`;
    if (yr < 1e4) return `${sig(yr)} ${short ? 'yr' : 'years'}`;
    if (yr < 1e6) return `${sig(yr / 1e3)} ${short ? 'kyr' : 'thousand years'}`;
    if (yr < 1e9) return `${sig(yr / 1e6)} ${short ? 'Myr' : 'million years'}`;
    return `${sig(yr / 1e9)} ${short ? 'Gyr' : 'billion years'}`;
  }

  function drawHud() {
    const info = MAP_INFO[state.map];
    ctx.shadowColor = 'rgba(0,0,0,0.85)';
    ctx.shadowBlur = 4;
    ctx.font = '600 17px ui-sans-serif, system-ui, sans-serif';
    ctx.fillStyle = info.colour;
    ctx.fillText(info.name, 16, 28);
    ctx.font = '12.5px ui-sans-serif, system-ui, sans-serif';
    ctx.fillStyle = 'rgba(232,233,236,0.85)';
    ctx.fillText(info.line, 16, 47);
    ctx.fillText(`v = ${fmtBeta()} c   ·   γ = ${sig(gamma())}`, 16, 65);
    ctx.font = '11.5px ui-sans-serif, system-ui, sans-serif';
    ctx.fillStyle = 'rgba(232,233,236,0.5)';
    ctx.textAlign = 'right';
    ctx.fillText('drag: turn · scroll: zoom', W - 14, MH - 12);
    ctx.textAlign = 'left';
    ctx.fillText(`view ${fmtDist(state.r * 2 * view.tanY * view.aspect)} across`, 16, MH - 12);
    ctx.shadowBlur = 0;
  }

  // --- the ladder -------------------------------------------------------------
  const LY_PER_LS = 1 / 3.15576e7;
  const RUNGS: [string, number][] = [
    ['Moon', 1.282 * LY_PER_LS],
    ['Sun', 499 * LY_PER_LS],
    ['Neptune', 4.17 * 3600 * LY_PER_LS],
    ['Proxima', 4.246],
    ['Vega', 25.0],
    ['Pleiades', 444],
    ['Galactic Centre', 26700],
    ['LMC', 163000],
    ['Andromeda', 2.5e6],
    ['Virgo Cluster', 5.4e7],
    ['Coma Cluster', 3.2e8],
  ];
  const TICKS: [string, number][] = [
    ['light-second', LY_PER_LS],
    ['light-minute', 60 * LY_PER_LS],
    ['light-hour', 3600 * LY_PER_LS],
    ['light-day', 86400 * LY_PER_LS],
    ['light-year', 1],
    ['1,000 ly', 1e3],
    ['1 million ly', 1e6],
    ['1 billion ly', 1e9],
  ];
  const LOG0 = -8.3, LOG1 = 9.2;

  function drawLadder() {
    const top = MH;
    ctx.fillStyle = 'rgba(10,12,20,0.96)';
    ctx.fillRect(0, top, W, LH);
    ctx.strokeStyle = 'rgba(255,255,255,0.08)';
    ctx.beginPath();
    ctx.moveTo(0, top + 0.5);
    ctx.lineTo(W, top + 0.5);
    ctx.stroke();
    const narrow = W < 640;
    const x0 = narrow ? 12 : 132, x1 = W - 18;
    const X = (ly: number) => x0 + ((Math.log10(ly) - LOG0) / (LOG1 - LOG0)) * (x1 - x0);
    const yE = top + LH * 0.45, yS = top + LH * 0.72, yT = top + LH - 9;
    const b = beta(), g = gamma();
    // a centred label kept from running off either end
    const inside = (text: string, x: number) => {
      const half = ctx.measureText(text).width / 2;
      return Math.max(4 + half, Math.min(W - 4 - half, x));
    };

    ctx.font = '11.5px ui-sans-serif, system-ui, sans-serif';
    ctx.fillStyle = 'rgba(232,233,236,0.6)';
    const yr = g * b; // light-years covered on Earth's map per year aboard
    ctx.fillText(
      b > 0
        ? `Heading straight for each at ${fmtBeta()} c: one year on the ship’s clock covers ${sig(yr)} ly of Earth’s map`
        : 'At rest the two rulers agree, and nothing is ever reached',
      x0, top + 17
    );

    // how far a year, and a lifetime, aboard carries you, on each ruler
    const band = (y: number, reach: number, colour: string) => {
      if (reach <= 0) return;
      for (const [tau, a] of [[80, 0.1], [1, 0.16]] as [number, number][]) {
        const xr = Math.min(x1, Math.max(x0, X(reach * tau)));
        ctx.fillStyle = colour.replace('A', String(a));
        ctx.fillRect(x0, y - 7, xr - x0, 14);
        if (xr > x0 + 4 && xr < x1 - 4) {
          ctx.fillStyle = colour.replace('A', '0.75');
          ctx.font = '10px ui-sans-serif, system-ui, sans-serif';
          ctx.fillText(tau === 1 ? '1 yr' : '80 yr', xr + 3, y + (tau === 1 ? -9 : 17));
        }
      }
    };
    band(yE, g * b, 'rgba(156,196,255,A)');
    band(yS, b, 'rgba(94,234,212,A)');

    // the rows
    for (const [y, c, name] of [[yE, BLUE, 'Earth’s map'], [yS, TEAL, 'Ship’s ruler']] as [number, string, string][]) {
      ctx.strokeStyle = c;
      ctx.globalAlpha = 0.45;
      ctx.beginPath();
      ctx.moveTo(x0, y);
      ctx.lineTo(x1, y);
      ctx.stroke();
      ctx.globalAlpha = 1;
      ctx.fillStyle = c;
      ctx.font = '600 11.5px ui-sans-serif, system-ui, sans-serif';
      if (narrow) ctx.fillText(name, x0, y - 22);
      else {
        ctx.textAlign = 'right';
        ctx.fillText(name, x0 - 12, y + 4);
        ctx.textAlign = 'left';
      }
    }
    // each rung on both rulers, joined
    ctx.save();
    ctx.beginPath();
    ctx.rect(x0 - 4, top, x1 - x0 + 8, LH);
    ctx.clip();
    RUNGS.forEach(([name, D], i) => {
      const xe = X(D), xs = X(D / g);
      const dest = DESTS[state.dest].name.startsWith(name);
      ctx.strokeStyle = dest ? 'rgba(245,194,107,0.6)' : 'rgba(255,255,255,0.14)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(xe, yE);
      ctx.lineTo(xs, yS);
      ctx.stroke();
      ctx.fillStyle = dest ? GOLD : BLUE;
      ctx.beginPath();
      ctx.arc(xe, yE, dest ? 4 : 3, 0, 2 * Math.PI);
      ctx.fill();
      ctx.fillStyle = dest ? GOLD : TEAL;
      ctx.beginPath();
      ctx.arc(xs, yS, dest ? 4 : 3, 0, 2 * Math.PI);
      ctx.fill();
      ctx.textAlign = 'center';
      ctx.font = (dest ? '600 ' : '') + '11px ui-sans-serif, system-ui, sans-serif';
      ctx.fillStyle = dest ? GOLD : 'rgba(232,233,236,0.85)';
      ctx.fillText(name, inside(name, xe), yE - [10, 22, 34][i % 3]);
      // the trip there on the ship's clock
      ctx.font = '10.5px ui-sans-serif, system-ui, sans-serif';
      ctx.fillStyle = dest ? GOLD : 'rgba(94,234,212,0.85)';
      const t = b > 0 ? fmtT(D / (g * b), true) : '∞';
      ctx.fillText(t, inside(t, xs), yS + (i % 2 ? 26 : 16));
      ctx.textAlign = 'left';
    });
    ctx.restore();

    // the scale
    ctx.font = '10px ui-sans-serif, system-ui, sans-serif';
    ctx.fillStyle = 'rgba(232,233,236,0.42)';
    ctx.textAlign = 'center';
    for (const [name, ly] of TICKS) {
      const x = X(ly);
      if (narrow && /second|minute|day/.test(name)) continue;
      ctx.fillRect(x - 0.5, yT - 13, 1, 4);
      ctx.fillText(name, inside(name, x), yT);
    }
    ctx.textAlign = 'left';
    if (!narrow) {
      ctx.fillStyle = 'rgba(232,233,236,0.42)';
      ctx.textAlign = 'right';
      ctx.fillText('trip time, ship clock', x0 - 12, yS + 21);
      ctx.textAlign = 'left';
    }
  }

  function updateNumbers() {
    const b = beta(), g = gamma();
    const D = v3.len(DESTS[state.dest].pos);
    const Dly = D * LY_PER_PC;
    setRows({
      'r-beta': `${fmtBeta()} c`,
      'r-gamma': sig(g),
      'r-earth': fmtDist(D),
      'r-ship': fmtDist(D / g),
      'r-seen': fmtDist(D * g * (1 + b)),
      'r-tship': b > 0 ? fmtT(Dly / (g * b)) : 'never',
      'r-tearth': b > 0 ? fmtT(Dly / b) : 'never',
    });
  }

  function draw() {
    placeCamera();
    drawGL();
    ctx.clearRect(0, 0, W, H);
    if (state.show.ring) drawRing();
    if (state.show.labels) drawLabels();
    drawShip();
    drawHud();
    drawLadder();
    updateNumbers();
  }

  // =====================================================================
  //  Controls
  // =====================================================================
  const mapSeg = segmented('map', (v) => { setMap(v as MapKey); });
  function setMap(m: MapKey) {
    state.map = m;
    state.frame = true;
    mapSeg.select(m);
    dirty = true;
  }
  const destSeg = segmented('dest', (v) => { setDest(v); });
  function setDest(k: string) {
    state.dest = k;
    state.frame = true;
    destSeg.select(k);
    dirty = true;
  }
  const setSpeed = slider('speed', (v) => { state.s = v; dirty = true; }, (v) => `${fmtBetaFor(v)} c`);
  function fmtBetaFor(s: number) {
    const keep = state.s;
    state.s = s;
    const out = fmtBeta();
    state.s = keep;
    return out;
  }
  function speed(s: number) {
    state.s = s;
    setSpeed(s);
    dirty = true;
  }
  const run = transport({
    onRun: (on) => {
      state.running = on;
      if (on && state.s >= 6.99) speed(0);
    },
    onReset: () => {
      run.setRunning(false);
      state.running = false;
      speed(2);
      setDest('gc');
      setMap('earth');
      state.yaw = -Math.PI / 2 + 0.25;
      state.pitch = 0.42;
    },
  });
  check('l-stars', (on) => { state.show.stars = on; dirty = true; });
  check('l-mw', (on) => { state.show.mw = on; dirty = true; });
  check('l-gal', (on) => { state.show.gal = on; dirty = true; });
  check('l-ring', (on) => { state.show.ring = on; dirty = true; });
  check('l-labels', (on) => { state.show.labels = on; dirty = true; });

  tries({
    squash: () => { setDest('gc'); speed(2); setMap('ship'); state.yaw = -Math.PI / 2; state.pitch = 0.9; },
    ladder: () => { setDest('gc'); speed(7); setMap('ship'); },
    seen: () => { setDest('gc'); speed(2); setMap('seen'); state.yaw = -Math.PI / 2 + 0.3; state.pitch = 0.5; },
    andromeda: () => { setDest('andromeda'); speed(7); setMap('ship'); state.yaw = -Math.PI / 2 + 1.0; state.pitch = 0.45; },
    slow: () => { setDest('gc'); speed(0.046); setMap('ship'); },
  });

  // --- pointer: drag turns round, wheel and pinch zoom -------------------------
  const pointers = new Map<number, { x: number; y: number }>();
  let pinch0 = 0, r0 = 1;
  const R_MIN = 0.01, R_MAX = 5e10;
  function zoomTo(r: number) {
    state.r = Math.max(R_MIN, Math.min(R_MAX, r));
    state.frame = false;
    dirty = true;
  }
  canvas.addEventListener('pointerdown', (e) => {
    canvas.setPointerCapture(e.pointerId);
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (pointers.size === 2) {
      const [a, b] = [...pointers.values()];
      pinch0 = Math.hypot(a.x - b.x, a.y - b.y);
      r0 = state.r;
    }
  });
  canvas.addEventListener('pointermove', (e) => {
    const prev = pointers.get(e.pointerId);
    if (!prev) return;
    const p = { x: e.clientX, y: e.clientY };
    pointers.set(e.pointerId, p);
    if (pointers.size === 2) {
      const [a, b] = [...pointers.values()];
      const d = Math.hypot(a.x - b.x, a.y - b.y);
      if (pinch0 > 0) zoomTo(r0 * (pinch0 / Math.max(d, 1)));
      return;
    }
    state.yaw -= (p.x - prev.x) * 0.006;
    state.pitch = Math.max(-1.55, Math.min(1.55, state.pitch + (p.y - prev.y) * 0.006));
    dirty = true;
  });
  const up = (e: PointerEvent) => {
    pointers.delete(e.pointerId);
    pinch0 = 0;
  };
  canvas.addEventListener('pointerup', up);
  canvas.addEventListener('pointercancel', up);
  canvas.addEventListener(
    'wheel',
    (e) => {
      e.preventDefault();
      zoomTo(state.r * Math.exp(e.deltaY * (e.deltaMode === 1 ? 0.05 : 0.0016)));
    },
    { passive: false }
  );

  // =====================================================================
  //  Loop
  // =====================================================================
  let last = performance.now();
  function frame(now: number) {
    const dt = Math.min(0.1, (now - last) / 1000);
    last = now;
    if (state.running) {
      // open the throttle: a nine every two seconds
      speed(Math.min(7, state.s + dt * 0.5));
      if (state.s >= 7) {
        state.running = false;
        run.setRunning(false);
      }
    }
    // ease between maps
    const target = MAPS.map((m) => (m === state.map ? 1 : 0));
    const k = 1 - Math.exp(-dt * 4);
    let moved = false;
    for (let i = 0; i < 3; i++) {
      const d = target[i] - state.w[i];
      if (Math.abs(d) > 1e-4) { state.w[i] += d * k; moved = true; }
      else state.w[i] = target[i];
    }
    if (state.frame) {
      const f = framing();
      const kk = 1 - Math.exp(-dt * 3);
      const dr = Math.log(f.r / state.r);
      const dc = v3.sub(f.centre, state.centre);
      if (Math.abs(dr) > 1e-3 || v3.len(dc) > state.r * 1e-3) {
        state.r *= Math.exp(dr * kk);
        state.centre = v3.add(state.centre, v3.mul(dc, kk));
        moved = true;
      }
    }
    if (moved) dirty = true;
    if (dirty) {
      dirty = false;
      draw();
    }
    requestAnimationFrame(frame);
  }
  {
    const f = framing();
    state.r = f.r;
    state.centre = f.centre;
  }
  requestAnimationFrame(frame);
</script>

