    position: relative;
    width: 100%;
    aspect-ratio: 960 / 600;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: #010204;
  }
  .rt-wrap canvas {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    max-height: none !important;
    margin: 0 !important;
    border-radius: 0;
  }
  #rtgl {
    pointer-events: none;
  }
  #rt {
    background: transparent !important;
    cursor: grab;
    touch-action: none;
  }
  #rt:active {
    cursor: grabbing;
  }
  :global(.sim:fullscreen) .rt-wrap {
    width: min(100%, calc((100vh - 150px) * 1.6));
    margin: 0 auto;
  }
</style>
