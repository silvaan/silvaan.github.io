    border-radius: 0;
  }
  #rtgl {
    pointer-events: none;
  }
  #rt {
    background: transparent !important;
    cursor: grab;
    touch-action: none;
  }
  #rt:active {
    cursor: grabbing;
  }
  .rt-toggle {
    display: none;
  }
  .rt-notes {
    margin: 8px 0 0;
    padding-left: 1.1em;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--text-muted);
    display: grid;
    gap: 6px;
  }

  /* Fullscreen: the stage fills the screen and the controls float over it. */
  :global(.sim.rt-sim:fullscreen) {
    display: block;
    position: relative;
    padding: 0;
    overflow: hidden;
    background: #010204;
  }
  :global(.sim.rt-sim:fullscreen > *) {
    overflow: visible;
  }
  :global(.rt-sim:fullscreen) .rt-stage {
    width: 100vw;
    height: 100vh;
    border: 0;
    border-radius: 0;
  }
  :global(.rt-sim:fullscreen) .rt-wrap {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }
  :global(.rt-sim:fullscreen) .rt-toggle {
    display: block;
    position: absolute;
    top: 20px;
    right: 124px;
    z-index: 3;
    height: 30px;
    padding: 0 11px;
    font: inherit;
    font-size: 0.78rem;
    color: #cdd2e0;
    background: rgba(20, 22, 28, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    cursor: pointer;
    backdrop-filter: blur(6px);
  }
  :global(.rt-sim:fullscreen) .rt-toggle[aria-pressed='true'] {
    color: #fff;
    border-color: rgba(201, 184, 255, 0.5);
  }
  :global(.sim.rt-sim:fullscreen > .sim-panel) {
    position: absolute;
    top: 62px;
    right: 12px;
    z-index: 2;
    width: min(320px, calc(100vw - 24px));
    max-height: calc(100vh - 290px);
    overflow-y: auto;
    padding: 14px;
    box-sizing: border-box;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    backdrop-filter: blur(10px);
  }
  :global(.sim.rt-sim.rt-panel-off:fullscreen > .sim-panel) {
    display: none;
  }
</style>
