---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Checks from '../../../components/sim/Checks.astro';
import Transport from '../../../components/sim/Transport.astro';
import Readout from '../../../components/sim/Readout.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="cosmology"
  title="Travelling Near the Speed of Light"
  description="Take a ship towards a real star or galaxy and look out of the window. The sky crowds forward and turns blue, the stars behind redden and vanish, and the route ahead is shorter for you than on any map. How far the destination is depends on how you ask: by ruler, by its size in the sky, or by its brightness, and the three answers disagree."
  shortcuts={['run', 'reset', 'fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <div class="rt-wrap" id="rt-wrap">
          <canvas id="rtgl" aria-hidden="true"></canvas>
          <canvas
            id="rt"
            width="960"
            height="600"
            role="img"
            aria-label="The view from a ship moving close to the speed of light, a 3D map of its route, or a chart of how far a rocket can get in an expanding universe."
          ></canvas>
        </div>
      </div>
      <Caption
        legend={[
          { label: 'destination', color: '#f5c26b' },
          { label: 'where the stars beside you appear', color: '#5eead4' },
          { label: 'route', color: '#9cc4ff' },
          { label: 'ship', color: '#ff7a8a' },
        ]}
        hint="Drag to look around, scroll to change the field of view (map: to zoom)"
        hintId="rt-hint"
      />
      <Result label="Ship clock" />
    </div>

    <div class="sim-panel">
      <Seg
        id="view"
        label="View"
        options={[
          { value: 'cockpit', label: 'Out of the window' },
          { value: 'map', label: 'Route map' },
          { value: 'cosmos', label: 'Expanding universe' },
        ]}
      />
      <Seg
        id="dest"
        label="Destination"
        attr="d"
        options={[
          { value: 'proxima', label: 'Proxima Centauri' },
          { value: 'vega', label: 'Vega' },
          { value: 'betelgeuse', label: 'Betelgeuse' },
          { value: 'gc', label: 'Galactic Centre' },
          { value: 'andromeda', label: 'Andromeda' },
        ]}
      />
      <Seg
        id="mode"
        label="Engine"
        attr="m"
        options={[
          { value: 'coast', label: 'Constant speed' },
          { value: 'rocket', label: 'Constant thrust, flip halfway' },
        ]}
      />
      <Transport />
      <div id="coast-ctl">
        <Slider id="speed" label="Speed β = v/c" min={0.05} max={5} step={0.01} value={1} display="0.900" hint={['0.1 c', '0.99999 c']} />
      </div>
      <div id="rocket-ctl" hidden>
        <Slider id="acc" label="Thrust (felt as weight)" min={0.1} max={3} step={0.05} value={1} display="1.00 g" />
      </div>
      <Slider id="prog" label="Trip, by ship clock" min={0} max={1} step={0.001} value={0.3} display="30%" />
      <div id="cockpit-ctl">
        <Slider id="lim" label="Faintest magnitude shown" min={2} max={10} step={0.1} value={6.5} display="6.5" />
        <Checks
          label="Effects"
          items={[
            { id: 'e-aberr', label: 'Aberration (light arrives from ahead)', checked: true },
            { id: 'e-doppler', label: 'Doppler colour shift', checked: true },
            { id: 'e-beam', label: 'Brightening and dimming', checked: true },
            { id: 'e-cmb', label: 'Microwave background', checked: true },
            { id: 'e-labels', label: 'Labels', checked: true },
          ]}
        />
      </div>
      <div id="map-ctl" hidden>
        <Checks items={[{ id: 'm-ship', label: 'Measure in the ship’s frame (contracted)', checked: true }]} />
      </div>
      <Readout
        title="Numbers"
        open
        rows={[
          { id: 'r-beta', label: 'Speed β' },
          { id: 'r-gamma', label: 'Lorentz factor γ' },
          { id: 'r-earth', label: 'Earth clock' },
          { id: 'r-dist', label: 'Left to go, on Earth’s map' },
          { id: 'r-ship', label: 'Left to go, measured by the ship' },
          { id: 'r-size', label: 'Looks this far by its size' },
          { id: 'r-bright', label: 'Looks this far by its brightness' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      At high speed you meet light coming at you from ahead, so it all seems to come from ahead: the whole sky
      <b>crowds into a disk</b> in front. Stars that are really beside you show up on the teal ring. <Try id="crowd" />
    </li>
    <li>
      Ahead, the light is squeezed to shorter wavelengths: stars turn blue, then slide into the ultraviolet and
      fade. Then the 2.7 K <b>microwave background</b>, blueshifted a thousand times, starts to glow ahead of you
      as visible light. <Try id="cmb" />
    </li>
    <li>
      On the ship's own ruler the way ahead is <b>shorter by γ</b>. At 1 g the 2.5 million light-years to Andromeda
      shrink to a few light-years at top speed, which is how the trip fits in 28 years of your life while
      2.5 million pass on Earth. <Try id="andromeda" />
    </li>
    <li>
      Yet Andromeda does not look closer. Aberration shrinks it in the sky, so by its <b>size</b> it seems farther
      than on the map, while the Doppler brightening makes it look <b>nearer by brightness</b>. Three honest
      measurements, three distances. <Try id="three" />
    </li>
    <li>
      In an expanding universe even 1 g forever has a limit: no galaxy now farther than about <b>16.6 billion
      light-years</b> can ever be reached, because space between grows faster than you can close the gap. <Try id="limit" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { el, segmented, slider, check, transport, result, readout, tries } from '../../../lib/panel';
  import { View, v3, compile, vertexArray, fitCanvas, type V3, type Program } from '../../../lib/gl3d';
  import { LY_PER_PC, GLSL_STAR_RGB, loadStars, loadStarNames, loadLocalGroup, fmtYears, radec } from '../../../lib/cosmos';
  import { GC, DISKS, diskGalaxy } from '../../../lib/galaxies';
  import { PLANCK18, history, interp, eventHorizon, hubbleTime, GLY_PER_MPC } from '../../../lib/cosmology';

  const GOLD = '#f5c26b', TEAL = '#5eead4', BLUE = '#9cc4ff', ROSE = '#ff7a8a';
  /** 1 g in light-years per year². */
  const G_LY = 9.80665 * (3.15576e7 ** 2) / 9.4607e15;

  type Dest = { key: string; name: string; pos: V3; T: number; M: number; stop: number; note: string };
  const M31: V3 = radec(10.6847, 41.269, 785000);
  const DESTS: Record<string, Dest> = {
    proxima: { key: 'proxima', name: 'Proxima Centauri', pos: [0, 0, 0], T: 3040, M: 15.5, stop: 0.01, note: 'the nearest star' },
    vega: { key: 'vega', name: 'Vega', pos: [0, 0, 0], T: 9600, M: 0.58, stop: 0.05, note: 'bright blue-white star' },
    betelgeuse: { key: 'betelgeuse', name: 'Betelgeuse', pos: [0, 0, 0], T: 3600, M: -5.85, stop: 0.3, note: 'red supergiant in Orion' },
    gc: { key: 'gc', name: 'Galactic Centre', pos: GC, T: 4500, M: -14, stop: 300, note: 'Sgr A*, the black hole at the heart of the Milky Way' },
    andromeda: { key: 'andromeda', name: 'Andromeda Galaxy', pos: M31, T: 5000, M: -21.5, stop: 40000, note: 'the nearest large galaxy' },
  };

  const state = {
    view: 'cockpit' as 'cockpit' | 'map' | 'cosmos',
    dest: DESTS.proxima,
    mode: 'coast' as 'coast' | 'rocket',
    s: 1, // β = 1 − 10^(−s)
    acc: 1, // in g
    prog: 0.3,
    running: false,
    lim: 6.5,
    fx: { aberr: true, doppler: true, beam: true, cmb: true, labels: true },
    shipFrame: true,
    // where you look, relative to straight ahead
    lookYaw: 0,
    lookPitch: 0,
    fovDeg: 90,
    // the map camera
    mapYaw: -0.8,
    mapPitch: 0.5,
    mapZoom: 1,
  };

  // =====================================================================
  //  The trip
  // =====================================================================
  const beta = () => 1 - Math.pow(10, -state.s);
  const routeLen = () => Math.max(0, v3.len(state.dest.pos) - state.dest.stop) * LY_PER_PC; // ly
  const routeDir = () => v3.unit(state.dest.pos);

  /** Total ship time for the trip, years. */
  function tripTau() {
    const D = routeLen();
    if (state.mode === 'coast') {
      const b = beta(), g = 1 / Math.sqrt(1 - b * b);
      return D / (b * g);
    }
    const a = state.acc * G_LY;
    return (2 * Math.acosh(1 + (a * D) / 2)) / a;
  }

  /** Where the ship is at ship time τ: distance along the route (ly), Earth time (yr), β. */
  function shipAt(tau: number) {
    const D = routeLen();
    if (state.mode === 'coast') {
      const b = beta(), g = 1 / Math.sqrt(1 - b * b);
      return { x: b * g * tau, t: g * tau, b, g };
    }
    const a = state.acc * G_LY;
    const th = Math.acosh(1 + (a * D) / 2) / a;
    if (tau <= th) {
      const b = Math.tanh(a * tau);
      return { x: (Math.cosh(a * tau) - 1) / a, t: Math.sinh(a * tau) / a, b, g: Math.cosh(a * tau) };
    }
    const tr = Math.max(0, 2 * th - tau);
    return { x: D - (Math.cosh(a * tr) - 1) / a, t: (2 * Math.sinh(a * th)) / a - Math.sinh(a * tr) / a, b: Math.tanh(a * tr), g: Math.cosh(a * tr) };
  }

  const now = () => {
    const tau = state.prog * tripTau();
    const s = shipAt(tau);
    const pos = v3.mul(routeDir(), s.x / LY_PER_PC); // pc
    return { ...s, tau, pos };
  };

  /** Fraction of a blackbody's light that falls between 400 and 700 nm. */
  function fvis(T: number) {
    const x1 = 14388 / (0.7 * T), x2 = 14388 / (0.4 * T);
    const n = 16, h = (x2 - x1) / n;
    let s = 0;
    for (let i = 0; i <= n; i++) {
      const x = x1 + i * h;
      const f = (x * x * x) / Math.expm1(x);
      s += f * (i === 0 || i === n ? 1 : i % 2 ? 4 : 2);
    }
    return ((15 / Math.PI ** 4) * s * h) / 3;
  }

  // =====================================================================
  //  GL: one program, two optics
  // =====================================================================
  const wrap = el('rt-wrap');
  const canvas = el('rt') as HTMLCanvasElement;
  const glc = el('rtgl') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => { dirty = true; });
  let dirty = true;
  const setEq = equation();
  const setResult = result();
  const setRows = readout();
  const gl = glc.getContext('webgl2', { antialias: false, alpha: false });

  // uMode 0: the window. The direction to each star, as Earth's frame has it,
  // is aberrated into the ship's frame; the Doppler factor D scales its
  // temperature and its flux goes up as D² times the change in the visible
  // share of a blackbody at the new temperature.
  // uMode 1: the map, seen by an outside camera, optionally contracted by 1/γ
  // along the route about the ship.
  const VS = `#version 300 es
in vec3 aPos;
in float aLum;
in float aTemp;
uniform int uMode;
uniform vec3 uShip, uVel;
uniform float uBeta, uGamma;
uniform vec3 uEye, uRight, uUp, uFwd;
uniform float uTanY, uAspect, uDpr, uExpo, uMin;
uniform bool uAberr, uDoppler, uBeam, uContract;
out vec3 vCol;
out float vA;
${GLSL_STAR_RGB}
float fvis(float T) {
  float x1 = 14388.0 / (0.7 * T), x2 = 14388.0 / (0.4 * T);
  float h = (x2 - x1) / 8.0, s = 0.0;
  for (int i = 0; i <= 8; i++) {
    float x = x1 + float(i) * h;
    float f = x * x * x / max(exp(x) - 1.0, 1e-30);
    s += f * ((i == 0 || i == 8) ? 1.0 : (i % 2 == 1 ? 4.0 : 2.0));
  }
  return 0.15399 * s * h / 3.0; // 15 / π⁴
}
void main() {
  vec3 rel = aPos - uShip;
  float d = length(rel);
  vec3 col;
  float I;
  vec3 dir;
  if (uMode == 0) {
    vec3 n = rel / d;
    float c = dot(n, uVel);
    float b = uAberr ? uBeta : 0.0;
    float cp = (c + b) / (1.0 + b * c);
    vec3 perp = n - uVel * c;
    float pl = length(perp);
    dir = pl > 1e-7 ? uVel * cp + perp / pl * sqrt(max(0.0, 1.0 - cp * cp)) : n;
    // Doppler factor, from the ship's-frame angle so it stays accurate dead ahead
    float D = uGamma * (1.0 + uBeta * cp);
    if (!uAberr) D = uGamma * (1.0 + uBeta * (c + uBeta) / (1.0 + uBeta * c));
    float T = uDoppler ? aTemp * D : aTemp;
    col = tempRGB(T);
    I = aLum * 100.0 / (d * d) * uExpo;
    if (uBeam) I *= D * D * fvis(aTemp * D) / fvis(aTemp);
  } else {
    // the outside view: optionally squeeze everything along the route about the ship
    vec3 r = rel;
    if (uContract) r -= uVel * dot(r, uVel) * (1.0 - 1.0 / uGamma);
    dir = uShip + r - uEye;
    col = tempRGB(aTemp);
    I = pow(aLum, 0.32) * uExpo;
  }
  float z = dot(dir, uFwd);
  gl_Position = vec4(dot(dir, uRight) / (uTanY * uAspect), dot(dir, uUp) / uTanY, 0.0, z);
  float m = uMin * uDpr;
  float size = m;
  if (I > 1.0) size *= min(pow(I, 0.22), 9.0);
  float a = min(I, 1.0);
  vCol = col;
  vA = a;
  gl_PointSize = (a < 0.004 || z <= 0.0) ? 0.0 : size;
}`;
  const FS = `#version 300 es
precision highp float;
in vec3 vCol;
in float vA;
out vec4 o;
void main() {
  vec2 q = gl_PointCoord * 2.0 - 1.0;
  float r2 = dot(q, q);
  if (r2 > 1.0) discard;
  float f = exp(-r2 * 14.0) + 0.1 * exp(-r2 * 3.0) * (1.0 - r2);
  o = vec4(vCol * vA * f, 1.0);
}`;
  // the microwave background seen from the ship: a blackbody at 2.725 K × D
  const BG_VS = `#version 300 es
in vec2 p;
out vec2 vUv;
void main() { vUv = p; gl_Position = vec4(p, 0.0, 1.0); }`;
  const BG_FS = `#version 300 es
precision highp float;
in vec2 vUv;
uniform vec3 uRight, uUp, uFwd, uVel;
uniform float uTanY, uAspect, uBeta, uGamma, uLim, uPixArc;
uniform bool uDoppler;
out vec4 o;
${GLSL_STAR_RGB}
float fvis(float T) {
  float x1 = 14388.0 / (0.7 * T), x2 = 14388.0 / (0.4 * T);
  float h = (x2 - x1) / 8.0, s = 0.0;
  for (int i = 0; i <= 8; i++) {
    float x = x1 + float(i) * h;
    float f = x * x * x / max(exp(x) - 1.0, 1e-30);
    s += f * ((i == 0 || i == 8) ? 1.0 : (i % 2 == 1 ? 4.0 : 2.0));
  }
  return 0.15399 * s * h / 3.0;
}
void main() {
  vec3 d = normalize(uFwd + vUv.x * uTanY * uAspect * uRight + vUv.y * uTanY * uUp);
  float D = uGamma * (1.0 + uBeta * dot(d, uVel));
  float T = 2.725 * D;
  // V-band surface brightness against the Sun's disk (−10.7 mag/arcsec² at 5772 K)
  float sb = -10.7 - 2.5 * log(pow(T / 5772.0, 4.0) * fvis(T) / 0.3664) / log(10.0);
  float mpix = sb - 2.5 * log(uPixArc) / log(10.0);
  float I = pow(10.0, -0.4 * (mpix - uLim)) * 0.6;
  if (T < 500.0) discard;
  o = vec4(tempRGB(T) * min(I, 1.0), 1.0);
}`;

  let prog: Program | null = null, bg: Program | null = null;
  let bgVao: WebGLVertexArrayObject | null = null;
  let sky: { vao: WebGLVertexArrayObject; count: number } | null = null;
  if (gl) {
    prog = compile(gl, VS, FS, 'relativistic-travel');
    bg = compile(gl, BG_VS, BG_FS, 'relativistic-travel background');
    if (bg) {
      bgVao = gl.createVertexArray();
      gl.bindVertexArray(bgVao);
      const b = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, b);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
      const loc = gl.getAttribLocation(bg.prog, 'p');
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
      gl.bindVertexArray(null);
    }
  }

  // --- the sky: real stars, the galaxy's disk and our neighbours ----------
  type Named = { name: string; pos: V3; M: number; T: number };
  const named: Named[] = [];
  const bvT = (bv: number) => {
    const b = Math.max(-0.4, Math.min(2, bv));
    return 4600 * (1 / (0.92 * b + 1.7) + 1 / (0.92 * b + 0.62));
  };
  /** Temperatures for the cloud colours the disk generator uses. */
  const cloudT = (r: number, g: number, b: number) => (b >= 1 && r < 1 ? 9500 : g < 0.5 ? 6500 : g < 0.85 ? 4300 : 5300);
  let loaded = 0;
  Promise.all([loadStars(), loadStarNames(), loadLocalGroup()]).then(([stars, names, lg]) => {
    const rows: number[] = [];
    rows.push(0, 0, 0, Math.pow(10, -0.4 * 4.83), 5772); // the Sun
    for (let i = 0; i < stars.n; i++) {
      const o = i * stars.stride;
      rows.push(stars.rows[o], stars.rows[o + 1], stars.rows[o + 2], Math.pow(10, -0.4 * stars.rows[o + 3]), bvT(stars.rows[o + 4]));
    }
    // the disks: each cloud becomes a point source at its colour's temperature
    const disk: number[] = [];
    for (const d of DISKS) diskGalaxy(d.spec, disk);
    // each cloud stands for thousands of stars too faint to see one by one: as points they get a share of the light
    for (let i = 0; i < disk.length; i += 8) rows.push(disk[i], disk[i + 1], disk[i + 2], disk[i + 4] * 0.01, cloudT(disk[i + 5], disk[i + 6], disk[i + 7]));
    for (const g of lg) {
      if (DISKS.some((d) => d.name === g.n)) continue;
      rows.push(g.p[0] * 1e6, g.p[1] * 1e6, g.p[2] * 1e6, Math.pow(10, -0.4 * (g.M ?? -8)), 5000);
    }
    if (gl && prog) sky = vertexArray(gl, prog, new Float32Array(rows), [['aPos', 3], ['aLum', 1], ['aTemp', 1]]);
    // the destinations and the brightest named stars, for labels
    for (const s of names) {
      const o = s.i * stars.stride;
      const p: V3 = [stars.rows[o], stars.rows[o + 1], stars.rows[o + 2]];
      const M = stars.rows[o + 3];
      if (s.m < 1.6) named.push({ name: s.n, pos: p, M, T: bvT(stars.rows[o + 4]) });
      const key = s.n === 'Proxima Centauri' ? 'proxima' : s.n === 'Vega' ? 'vega' : s.n === 'Betelgeuse' ? 'betelgeuse' : '';
      if (key) DESTS[key].pos = p;
    }
    named.push({ name: 'Sun', pos: [0, 0, 0], M: 4.83, T: 5772 });
    loaded = 1;
    dirty = true;
  });

  // =====================================================================
  //  The cockpit
  // =====================================================================
  const view = new View();
  view.aspect = W / H;
  view.px = H;

  /** Camera basis in the ship: straight ahead turned by the look angles. */
  function cockpitBasis() {
    const fwd0 = routeDir();
    const base = new View();
    base.look(fwd0, [0, 0, 1]);
    const cy = Math.cos(state.lookYaw), sy = Math.sin(state.lookYaw);
    const cp = Math.cos(state.lookPitch), sp = Math.sin(state.lookPitch);
    const f = v3.add(v3.mul(v3.add(v3.mul(base.fwd, cy), v3.mul(base.right, sy)), cp), v3.mul(base.up, sp));
    view.look(f, base.up);
    view.tanY = Math.tan((state.fovDeg * Math.PI) / 360);
  }

  /** Aberrated direction (ship frame) of a world point seen from the ship. */
  function seen(p: V3, ship: V3, b: number, g: number) {
    const rel = v3.sub(p, ship), d = v3.len(rel);
    const n = v3.mul(rel, 1 / d), u = routeDir();
    const c = v3.dot(n, u);
    const bb = state.fx.aberr ? b : 0;
    const cp = (c + bb) / (1 + bb * c);
    const perp = v3.sub(n, v3.mul(u, c)), pl = v3.len(perp);
    const dir = pl > 1e-9 ? v3.add(v3.mul(u, cp), v3.mul(perp, Math.sqrt(Math.max(0, 1 - cp * cp)) / pl)) : n;
    const D = g * (1 + b * (state.fx.aberr ? cp : (c + b) / (1 + b * c)));
    return { dir, D, d };
  }

  function screenOf(dir: V3) {
    const z = v3.dot(dir, view.fwd);
    if (z <= 0) return null;
    const x = v3.dot(dir, view.right) / (z * view.tanY * view.aspect);
    const y = v3.dot(dir, view.up) / (z * view.tanY);
    return { x: (x * 0.5 + 0.5) * W, y: (0.5 - y * 0.5) * H };
  }

  function drawCockpit(s: ReturnType<typeof now>) {
    cockpitBasis();
    if (!gl || !prog) return;
    const dpr = fitCanvas(glc, W, H);
    gl.viewport(0, 0, glc.width, glc.height);
    gl.clearColor(0.004, 0.005, 0.012, 1);
    gl.clear(gl.COLOR_BUFFER_BIT);
    gl.enable(gl.BLEND);
    gl.blendFunc(gl.ONE, gl.ONE);
    const u = routeDir();
    if (bg && state.fx.cmb) {
      gl.useProgram(bg.prog);
      gl.bindVertexArray(bgVao);
      gl.uniform3f(bg.u('uRight'), ...view.right);
      gl.uniform3f(bg.u('uUp'), ...view.up);
      gl.uniform3f(bg.u('uFwd'), ...view.fwd);
      gl.uniform3f(bg.u('uVel'), ...u);
      gl.uniform1f(bg.u('uTanY'), view.tanY);
      gl.uniform1f(bg.u('uAspect'), view.aspect);
      gl.uniform1f(bg.u('uBeta'), s.b);
      gl.uniform1f(bg.u('uGamma'), s.g);
      gl.uniform1f(bg.u('uLim'), state.lim);
      const pixRad = (2 * view.tanY) / (H * dpr);
      gl.uniform1f(bg.u('uPixArc'), (pixRad * 206265) ** 2);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    }
    if (!sky) return;
    gl.useProgram(prog.prog);
    gl.uniform1i(prog.u('uMode'), 0);
    gl.uniform3f(prog.u('uShip'), ...s.pos);
    gl.uniform3f(prog.u('uVel'), ...u);
    gl.uniform1f(prog.u('uBeta'), s.b);
    gl.uniform1f(prog.u('uGamma'), s.g);
    gl.uniform3f(prog.u('uRight'), ...view.right);
    gl.uniform3f(prog.u('uUp'), ...view.up);
    gl.uniform3f(prog.u('uFwd'), ...view.fwd);
    gl.uniform1f(prog.u('uTanY'), view.tanY);
    gl.uniform1f(prog.u('uAspect'), view.aspect);
    gl.uniform1f(prog.u('uDpr'), dpr);
    gl.uniform1f(prog.u('uExpo'), Math.pow(10, 0.4 * state.lim));
    gl.uniform1f(prog.u('uMin'), 1.6);
    gl.uniform1i(prog.u('uAberr'), state.fx.aberr ? 1 : 0);
    gl.uniform1i(prog.u('uDoppler'), state.fx.doppler ? 1 : 0);
    gl.uniform1i(prog.u('uBeam'), state.fx.beam ? 1 : 0);
    gl.bindVertexArray(sky.vao);
    gl.drawArrays(gl.POINTS, 0, sky.count);
    gl.bindVertexArray(null);
  }

  function hudCockpit(s: ReturnType<typeof now>) {
    ctx.clearRect(0, 0, W, H);
    ctx.font = '11px ui-sans-serif, system-ui, sans-serif';
    // the ring where stars that are really beside you appear: cos θ' = β
    if (state.fx.aberr) {
      const ang = Math.acos(s.b);
      ctx.beginPath();
      let pen = false;
      const u = routeDir();
      const base = new View();
      base.look(u, [0, 0, 1]);
      for (let i = 0; i <= 120; i++) {
        const a = (i / 120) * 2 * Math.PI;
        const dir = v3.add(v3.mul(u, Math.cos(ang)), v3.mul(v3.add(v3.mul(base.right, Math.cos(a)), v3.mul(base.up, Math.sin(a))), Math.sin(ang)));
        const q = screenOf(dir);
        if (!q) { pen = false; continue; }
        if (!pen) ctx.moveTo(q.x, q.y); else ctx.lineTo(q.x, q.y);
        pen = true;
      }
      ctx.strokeStyle = 'rgba(94,234,212,0.55)';
      ctx.setLineDash([4, 5]);
      ctx.lineWidth = 1.2;
      ctx.stroke();
      ctx.setLineDash([]);
    }
    // straight ahead
    const ahead = screenOf(routeDir());
    if (ahead) {
      ctx.strokeStyle = 'rgba(232,233,236,0.5)';
      ctx.beginPath();
      ctx.moveTo(ahead.x - 10, ahead.y); ctx.lineTo(ahead.x - 4, ahead.y);
      ctx.moveTo(ahead.x + 4, ahead.y); ctx.lineTo(ahead.x + 10, ahead.y);
      ctx.moveTo(ahead.x, ahead.y - 10); ctx.lineTo(ahead.x, ahead.y - 4);
      ctx.moveTo(ahead.x, ahead.y + 4); ctx.lineTo(ahead.x, ahead.y + 10);
      ctx.stroke();
    }
    if (state.fx.labels) {
      for (const n of named) {
        const k = seen(n.pos, s.pos, s.b, s.g);
        const q = screenOf(k.dir);
        if (!q || q.x < 0 || q.x > W || q.y < 0 || q.y > H) continue;
        ctx.fillStyle = 'rgba(255,226,176,0.75)';
        ctx.fillText(n.name, q.x + 6, q.y - 5);
      }
    }
    // the destination
    const k = seen(state.dest.pos, s.pos, s.b, s.g);
    const q = screenOf(k.dir);
    if (q) {
      ctx.strokeStyle = GOLD;
      ctx.lineWidth = 1.4;
      ctx.beginPath();
      ctx.arc(q.x, q.y, 11, 0, 2 * Math.PI);
      ctx.stroke();
      ctx.font = '600 12px ui-sans-serif, system-ui, sans-serif';
      ctx.fillStyle = GOLD;
      ctx.fillText(state.dest.name, q.x + 15, q.y + 4);
    }
    ctx.font = '12px ui-sans-serif, system-ui, sans-serif';
    ctx.fillStyle = 'rgba(232,233,236,0.75)';
    ctx.fillText(`looking ${lookWords()}, field of view ${state.fovDeg.toFixed(0)}°`, 14, H - 14);
    if (!loaded) ctx.fillText('Loading the star catalogue…', 14, 24);
  }

  const lookWords = () => {
    const a = Math.acos(Math.cos(state.lookYaw) * Math.cos(state.lookPitch)) * 180 / Math.PI;
    return a < 3 ? 'straight ahead' : a > 177 ? 'straight back' : `${a.toFixed(0)}° off the bow`;
  };

  // =====================================================================
  //  The map
  // =====================================================================
  const mapView = new View();
  mapView.aspect = W / H;
  mapView.px = H;
  mapView.tanY = 0.5;

  /** Where a world point lands on the map, after contraction about the ship. */
  function mapPoint(p: V3, s: ReturnType<typeof now>): V3 {
    if (!state.shipFrame) return p;
    const u = routeDir();
    const r = v3.sub(p, s.pos);
    return v3.add(s.pos, v3.sub(r, v3.mul(u, v3.dot(r, u) * (1 - 1 / s.g))));
  }

  function drawMap(s: ReturnType<typeof now>) {
    const L = v3.len(state.dest.pos);
    const mid = mapPoint(v3.mul(state.dest.pos, 0.5), s);
    // squeezed, the route is short but the sky across it is not: frame whichever is larger
    const span = state.shipFrame ? Math.max(L / s.g, 0.15 * L) : L;
    mapView.orbit(mid, span * 1.25 * state.mapZoom, state.mapYaw, state.mapPitch);
    if (!gl || !prog) return;
    const dpr = fitCanvas(glc, W, H);
    gl.viewport(0, 0, glc.width, glc.height);
    gl.clearColor(0.004, 0.005, 0.012, 1);
    gl.clear(gl.COLOR_BUFFER_BIT);
    if (!sky) return;
    gl.enable(gl.BLEND);
    gl.blendFunc(gl.ONE, gl.ONE);
    gl.useProgram(prog.prog);
    gl.uniform1i(prog.u('uMode'), 1);
    gl.uniform3f(prog.u('uShip'), ...s.pos);
    gl.uniform3f(prog.u('uVel'), ...routeDir());
    gl.uniform1f(prog.u('uGamma'), s.g);
    gl.uniform1i(prog.u('uContract'), state.shipFrame ? 1 : 0);
    gl.uniform3f(prog.u('uEye'), ...mapView.eye);
    gl.uniform3f(prog.u('uRight'), ...mapView.right);
    gl.uniform3f(prog.u('uUp'), ...mapView.up);
    gl.uniform3f(prog.u('uFwd'), ...mapView.fwd);
    gl.uniform1f(prog.u('uTanY'), mapView.tanY);
    gl.uniform1f(prog.u('uAspect'), mapView.aspect);
    gl.uniform1f(prog.u('uDpr'), dpr);
    gl.uniform1f(prog.u('uExpo'), L > 1e5 ? 0.25 : L > 1000 ? 0.4 : 0.9);
    gl.uniform1f(prog.u('uMin'), 1.5);
    gl.bindVertexArray(sky.vao);
    gl.drawArrays(gl.POINTS, 0, sky.count);
    gl.bindVertexArray(null);
  }

  function hudMap(s: ReturnType<typeof now>) {
    ctx.clearRect(0, 0, W, H);
    const P = (p: V3) => mapView.project(mapPoint(p, s), W, H);
    const a = P([0, 0, 0]), b = P(state.dest.pos), sh = P(s.pos);
    if (a && b) {
      ctx.strokeStyle = BLUE;
      ctx.lineWidth = 1.6;
      ctx.beginPath();
      ctx.moveTo(a.x, a.y);
      ctx.lineTo(b.x, b.y);
      ctx.stroke();
    }
    ctx.font = '600 12px ui-sans-serif, system-ui, sans-serif';
    if (a) { ctx.fillStyle = '#ffe7a8'; dot(a.x, a.y, 4); ctx.fillText('Sun', a.x + 8, a.y - 6); }
    if (b) { ctx.fillStyle = GOLD; dot(b.x, b.y, 4); ctx.fillText(state.dest.name, b.x + 8, b.y - 6); }
    if (sh) { ctx.fillStyle = ROSE; dot(sh.x, sh.y, 5); ctx.fillText('ship', sh.x + 8, sh.y + 14); }
    ctx.font = '12px ui-sans-serif, system-ui, sans-serif';
    ctx.fillStyle = 'rgba(232,233,236,0.8)';
    const D = routeLen();
    const left = D - s.x;
    ctx.fillText(
      state.shipFrame
        ? `ship's frame: everything squeezed ${fmtX(s.g)} along the route, ${fmtLy(left / s.g)} left to go`
        : `Earth's frame: ${fmtLy(left)} left to go`,
      14, H - 14
    );
  }
  const dot = (x: number, y: number, r: number) => { ctx.beginPath(); ctx.arc(x, y, r, 0, 2 * Math.PI); ctx.fill(); };

  // =====================================================================
  //  The expanding universe: how far can a rocket get?
  // =====================================================================
  // In cosmic time t a rocket with proper acceleration α obeys
  //   d(γβ)/dt = α/c − H(t) γβ,   dχ/dt = cβ / a(t),   dτ/dt = 1/γ,
  // with χ the comoving distance it has covered. Flat space drops the H term
  // and the 1/a.
  const hist = history(PLANCK18, 3000);
  const T0 = hist.tNow;
  const EH_LY = eventHorizon(PLANCK18) * GLY_PER_MPC * 1e9;
  const H0yr = 1 / (hubbleTime(PLANCK18) * 1e9);
  let curve: { tau: number[]; chi: number[] } | null = null;
  let curveAcc = -1;
  function rocketCurve() {
    if (curveAcc === state.acc && curve) return curve;
    const alpha = state.acc * G_LY;
    const tau: number[] = [0], chi: number[] = [0];
    let u = 0, x = 0, tt = 0;
    // log-spaced steps in Δt from a hundredth of a year to 1.5 trillion years
    const lo = Math.log(1e-3), hi = Math.log(1.5e12), N = 6000;
    let prevD = 0;
    const deriv = (D: number, uu: number) => {
      const tG = T0 + D / 1e9;
      const a = interp(hist.t, hist.a, tG);
      const Hh = interp(hist.t, hist.H, tG) * H0yr;
      const g = Math.sqrt(1 + uu * uu);
      return { du: alpha - Hh * uu, dx: uu / g / a, dt: 1 / g };
    };
    for (let i = 0; i <= N; i++) {
      const D = Math.exp(lo + ((hi - lo) * i) / N);
      const h = D - prevD;
      const k1 = deriv(prevD, u);
      const k2 = deriv(prevD + h / 2, u + (h / 2) * k1.du);
      const k3 = deriv(prevD + h / 2, u + (h / 2) * k2.du);
      const k4 = deriv(D, u + h * k3.du);
      u += (h / 6) * (k1.du + 2 * k2.du + 2 * k3.du + k4.du);
      x += (h / 6) * (k1.dx + 2 * k2.dx + 2 * k3.dx + k4.dx);
      tt += (h / 6) * (k1.dt + 2 * k2.dt + 2 * k3.dt + k4.dt);
      prevD = D;
      tau.push(tt);
      chi.push(x);
    }
    curve = { tau, chi };
    curveAcc = state.acc;
    return curve;
  }

  const MARKS: [string, number][] = [
    ['Proxima Centauri', 4.24],
    ['Galactic Centre', 26700],
    ['Andromeda', 2.56e6],
    ['Virgo Cluster', 5.4e7],
    ['Coma Cluster', 3.3e8],
    ['a galaxy at z = 1', 1.1e10],
    ['a galaxy at z = 2', 1.71e10],
  ];

  /** Ship years to cover `ly` comoving, or null if never. */
  function reachTau(c: { tau: number[]; chi: number[] }, ly: number) {
    const last = c.chi[c.chi.length - 1];
    if (ly > last) return null;
    let i = 1;
    while (c.chi[i] < ly) i++;
    const f = (ly - c.chi[i - 1]) / (c.chi[i] - c.chi[i - 1]);
    return c.tau[i - 1] + f * (c.tau[i] - c.tau[i - 1]);
  }

  function drawCosmos() {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = '#05070d';
    ctx.fillRect(0, 0, W, H);
    const c = rocketCurve();
    const alpha = state.acc * G_LY;
    const TMAX = Math.min(80, Math.max(30, 32 / state.acc));
    const L = 70, R = W - 250, T = 34, B = H - 46;
    const yLo = 0, yHi = 11; // log10 ly
    const X = (tau: number) => L + (tau / TMAX) * (R - L);
    const Y = (ly: number) => B - ((Math.log10(Math.max(ly, 1)) - yLo) / (yHi - yLo)) * (B - T);
    // axes and grid
    ctx.font = '11px ui-sans-serif, system-ui, sans-serif';
    ctx.strokeStyle = 'rgba(232,233,236,0.1)';
    ctx.fillStyle = 'rgba(232,233,236,0.6)';
    ctx.lineWidth = 1;
    const yl = ['1 ly', '10', '100', '1,000', '10⁴', '10⁵', '1 million', '10⁷', '10⁸', '1 billion', '10¹⁰', '10¹¹'];
    for (let k = yLo; k <= yHi; k++) {
      const y = Y(10 ** k);
      ctx.beginPath(); ctx.moveTo(L, y); ctx.lineTo(R, y); ctx.stroke();
      ctx.textAlign = 'right';
      ctx.fillText(yl[k], L - 6, y + 4);
    }
    ctx.textAlign = 'center';
    for (let t = 0; t <= TMAX; t += 10) {
      const x = X(t);
      ctx.beginPath(); ctx.moveTo(x, T); ctx.lineTo(x, B); ctx.stroke();
      ctx.fillText(String(t), x, B + 16);
    }
    ctx.fillText('years on the ship clock, accelerating the whole way', (L + R) / 2, B + 34);
    ctx.save();
    ctx.translate(18, (T + B) / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.fillText('distance covered (comoving, light-years)', 0, 0);
    ctx.restore();
    ctx.textAlign = 'left';

    // the event horizon
    ctx.strokeStyle = GOLD;
    ctx.setLineDash([6, 5]);
    ctx.beginPath(); ctx.moveTo(L, Y(EH_LY)); ctx.lineTo(R, Y(EH_LY)); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = GOLD;
    ctx.fillText(`event horizon, ${(EH_LY / 1e9).toFixed(1)} billion ly: beyond it, never`, L + 8, Y(EH_LY) - 7);

    // static space: no limit
    ctx.strokeStyle = 'rgba(232,233,236,0.45)';
    ctx.setLineDash([3, 4]);
    ctx.beginPath();
    for (let i = 0; i <= 300; i++) {
      const t = (i / 300) * TMAX;
      const d = (Math.cosh(alpha * t) - 1) / alpha;
      const y = Math.max(T - 4, Y(d));
      if (i === 0) ctx.moveTo(X(t), y); else ctx.lineTo(X(t), y);
    }
    ctx.stroke();
    ctx.setLineDash([]);
    // expanding space
    ctx.strokeStyle = BLUE;
    ctx.lineWidth = 2;
    ctx.beginPath();
    let started = false;
    for (let i = 0; i < c.tau.length; i++) {
      if (c.tau[i] > TMAX) break;
      const x = X(c.tau[i]), y = Y(c.chi[i]);
      if (!started) { ctx.moveTo(x, y); started = true; } else ctx.lineTo(x, y);
    }
    ctx.stroke();
    ctx.lineWidth = 1;
    ctx.fillStyle = 'rgba(232,233,236,0.6)';
    ctx.fillText('static space', X(TMAX * 0.36) + 6, Y((Math.cosh(alpha * TMAX * 0.36) - 1) / alpha) - 6);
    ctx.fillStyle = BLUE;
    ctx.fillText('our expanding universe', X(TMAX * 0.62), Y(c.chi[c.chi.length - 1]) + 16);

    // the cursor: where the trip slider has you
    const tc = state.prog * TMAX;
    let chiNow = 0;
    for (let i = 1; i < c.tau.length; i++) if (c.tau[i] >= tc) { chiNow = c.chi[i]; break; }
    ctx.fillStyle = ROSE;
    dot(X(tc), Y(chiNow), 4.5);

    // the table of destinations
    let ty = T + 4;
    ctx.font = '600 12px ui-sans-serif, system-ui, sans-serif';
    ctx.fillStyle = 'rgba(232,233,236,0.9)';
    ctx.fillText(`At ${state.acc.toFixed(2)} g, never stopping:`, R + 22, ty);
    ty += 22;
    ctx.font = '12px ui-sans-serif, system-ui, sans-serif';
    for (const [n, ly] of MARKS) {
      const tr = reachTau(c, ly);
      ctx.fillStyle = 'rgba(232,233,236,0.75)';
      ctx.fillText(n, R + 22, ty);
      ctx.fillStyle = tr == null ? ROSE : TEAL;
      ctx.fillText(tr == null ? 'never' : `${tr.toFixed(1)} years`, R + 22, ty + 15);
      ty += 38;
      // a tick on the chart
      ctx.strokeStyle = 'rgba(94,234,212,0.5)';
      ctx.beginPath(); ctx.moveTo(R - 6, Y(ly)); ctx.lineTo(R, Y(ly)); ctx.stroke();
    }
    ctx.fillStyle = 'rgba(232,233,236,0.55)';
    ctx.font = '11px ui-sans-serif, system-ui, sans-serif';
    ctx.fillText('Distances are comoving: where those', R + 22, ty + 4);
    ctx.fillText('galaxies are today. Planck 2018.', R + 22, ty + 18);

    return { chiNow, tc };
  }

  // =====================================================================
  //  Numbers
  // =====================================================================
  const fmtLy = (ly: number) => {
    if (ly < 0.1) return `${Math.round(ly * 63241)} AU`;
    if (ly < 1e4) return `${(+ly.toPrecision(3)).toLocaleString('en-US')} ly`;
    if (ly < 1e6) return `${(+(ly / 1e3).toPrecision(3))} thousand ly`;
    if (ly < 1e9) return `${(+(ly / 1e6).toPrecision(3))} million ly`;
    return `${(+(ly / 1e9).toPrecision(3))} billion ly`;
  };
  const fmtX = (g: number) => (g < 100 ? `${g.toFixed(2)}×` : `${(+g.toPrecision(3)).toLocaleString('en-US')}×`);
  const fmtB = (b: number) => (b < 0.999 ? b.toFixed(3) : `1 − ${(1 - b).toExponential(1).replace('e', '×10^').replace('^-', '⁻').replace(/\^(\d)/, (_, d) => '⁰¹²³⁴⁵⁶⁷⁸⁹'[+d])}`);

  function updateText(s: ReturnType<typeof now>) {
    const D = routeLen();
    const left = Math.max(0, D - s.x) + state.dest.stop * LY_PER_PC;
    const Dahead = s.g * (1 + s.b); // Doppler factor straight ahead
    const Tdest = state.dest.T;
    const bright = state.fx.beam ? Dahead * Dahead * fvis(Tdest * Dahead) / fvis(Tdest) : 1;
    setRows({
      'r-beta': fmtB(s.b),
      'r-gamma': s.g < 100 ? s.g.toFixed(3) : (+s.g.toPrecision(4)).toLocaleString('en-US'),
      'r-earth': fmtYears(s.t),
      'r-dist': fmtLy(left),
      'r-ship': fmtLy(left / s.g),
      'r-size': state.fx.aberr ? fmtLy(left * Dahead) : fmtLy(left),
      'r-bright': fmtLy(left / Math.sqrt(Math.max(bright, 1e-30))),
    });
    const total = tripTau();
    setResult({
      value: fmtYears(s.tau),
      colour: ROSE,
      status: `Earth: ${fmtYears(s.t)}`,
      note: `Whole trip to ${state.dest.name}: ${fmtYears(total)} for you, ${fmtYears(shipAt(total).t)} on Earth.`,
    });
    const bS = s.b.toFixed(s.b > 0.999 ? 6 : 3);
    if (state.view === 'cockpit') {
      setEq({
        rule: [['\\cos\\theta\'', TEAL], '= \\dfrac{\\cos\\theta + \\beta}{1 + \\beta\\cos\\theta}', '\\qquad', ['D', GOLD], '= \\gamma\\,(1 + \\beta\\cos\\theta\')'],
        live: [`\\beta = ${bS}`, `\\quad \\text{beside you } (\\theta = 90^\\circ) \\to \\theta' = ${(Math.acos(s.b) * 180 / Math.PI).toFixed(1)}^\\circ`, `\\quad D_{\\text{ahead}} = ${Dahead < 1e4 ? Dahead.toFixed(2) : Dahead.toExponential(2)}`],
      });
    } else if (state.view === 'map') {
      setEq({
        rule: [['L\'', ROSE], '= \\dfrac{', ['L', BLUE], '}{\\gamma}', '\\qquad \\gamma = \\dfrac{1}{\\sqrt{1-\\beta^2}}'],
        live: [`L = ${fmtLy(left).replace(/ /g, '\\ ')}`, `\\quad \\gamma = ${s.g < 1e4 ? s.g.toFixed(2) : s.g.toExponential(2)}`, `\\quad L' = ${fmtLy(left / s.g).replace(/ /g, '\\ ')}`],
      });
    } else {
      setEq({
        rule: ['\\dfrac{d(\\gamma\\beta)}{dt} = \\dfrac{\\alpha}{c} -', ['H(t)', GOLD], '\\,\\gamma\\beta', '\\qquad \\dfrac{d\\chi}{dt} = \\dfrac{c\\,\\beta}{', ['a(t)', BLUE], '}'],
        live: [`\\alpha = ${state.acc.toFixed(2)}\\,g`, `\\quad \\chi_{\\max} \\to ${(EH_LY / 1e9).toFixed(1)}\\ \\text{billion ly}`],
      });
    }
  }

  // =====================================================================
  //  Loop
  // =====================================================================
  let last = performance.now();
  function frame(t: number) {
    const dt = Math.min(0.1, (t - last) / 1000);
    last = t;
    if (state.running) {
      state.prog = Math.min(1, state.prog + dt / 30);
      setProg(state.prog);
      if (state.prog >= 1) runCtl.setRunning((state.running = false));
      dirty = true;
    }
    if (dirty) {
      const s = now();
      if (state.view === 'cockpit') { drawCockpit(s); hudCockpit(s); }
      else if (state.view === 'map') { drawMap(s); hudMap(s); }
      else drawCosmos();
      updateText(s);
      dirty = false;
    }
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);

  // =====================================================================
  //  Pointer
  // =====================================================================
  let drag: { x: number; y: number } | null = null;
  canvas.addEventListener('pointerdown', (e) => { drag = { x: e.clientX, y: e.clientY }; canvas.setPointerCapture(e.pointerId); });
  canvas.addEventListener('pointermove', (e) => {
    if (!drag) return;
    const b = canvas.getBoundingClientRect();
    const dx = ((e.clientX - drag.x) / b.width) * W, dy = ((e.clientY - drag.y) / b.height) * H;
    drag = { x: e.clientX, y: e.clientY };
    if (state.view === 'cockpit') {
      const k = (2 * view.tanY) / H;
      state.lookYaw -= dx * k;
      state.lookPitch = Math.max(-1.5, Math.min(1.5, state.lookPitch + dy * k));
    } else if (state.view === 'map') {
      state.mapYaw -= dx * 0.006;
      state.mapPitch = Math.max(-1.5, Math.min(1.5, state.mapPitch + dy * 0.006));
    }
    dirty = true;
  });
  canvas.addEventListener('pointerup', () => { drag = null; });
  canvas.addEventListener('pointercancel', () => { drag = null; });
  canvas.addEventListener(
    'wheel',
    (e) => {
      if (state.view === 'cosmos') return;
      e.preventDefault();
      const k = Math.exp(e.deltaY * 0.0012);
      if (state.view === 'cockpit') state.fovDeg = Math.max(20, Math.min(150, state.fovDeg * k));
      else state.mapZoom = Math.max(0.05, Math.min(20, state.mapZoom * k));
      dirty = true;
    },
    { passive: false }
  );

  // =====================================================================
  //  Panel
  // =====================================================================
  const showFor = () => {
    el('cockpit-ctl').hidden = state.view !== 'cockpit';
    el('map-ctl').hidden = state.view !== 'map';
    el('coast-ctl').hidden = state.mode !== 'coast' || state.view === 'cosmos';
    el('rocket-ctl').hidden = state.mode !== 'rocket' && state.view !== 'cosmos';
    el('dest').closest('.control')!.toggleAttribute('hidden', state.view === 'cosmos');
    el('mode').closest('.control')!.toggleAttribute('hidden', state.view === 'cosmos');
    glc.style.visibility = state.view === 'cosmos' ? 'hidden' : 'visible';
    el('rt-hint').textContent =
      state.view === 'cockpit' ? 'Drag to look around, scroll to change the field of view'
      : state.view === 'map' ? 'Drag to turn the map, scroll to zoom'
      : 'The trip slider moves the ship along the curve';
    el('progval').textContent = progText(state.prog);
    dirty = true;
  };
  const progText = (v: number) => state.view === 'cosmos' ? `${(v * Math.min(80, Math.max(30, 32 / state.acc))).toFixed(1)} yr` : `${Math.round(v * 100)}%`;

  const viewSeg = segmented('view', (v) => { state.view = v as typeof state.view; showFor(); });
  const destSeg = segmented('dest', (v) => { state.dest = DESTS[v]; state.mapZoom = 1; dirty = true; });
  const modeSeg = segmented('mode', (v) => { state.mode = v as typeof state.mode; showFor(); });
  const setSpeed = slider('speed', (v) => { state.s = v; dirty = true; }, (v) => fmtB(1 - Math.pow(10, -v)));
  const setAcc = slider('acc', (v) => { state.acc = v; dirty = true; }, (v) => `${v.toFixed(2)} g`);
  const setProg = slider('prog', (v) => { state.prog = v; dirty = true; }, progText);
  slider('lim', (v) => { state.lim = v; dirty = true; }, (v) => v.toFixed(1));
  check('e-aberr', (on) => { state.fx.aberr = on; dirty = true; });
  check('e-doppler', (on) => { state.fx.doppler = on; dirty = true; });
  check('e-beam', (on) => { state.fx.beam = on; dirty = true; });
  check('e-cmb', (on) => { state.fx.cmb = on; dirty = true; });
  check('e-labels', (on) => { state.fx.labels = on; dirty = true; });
  check('m-ship', (on) => { state.shipFrame = on; dirty = true; });
  const runCtl = transport({
    onRun: (on) => {
      if (on && state.prog >= 1) state.prog = 0;
      state.running = on;
    },
    onReset: () => {
      state.prog = 0;
      setProg(0);
      state.lookYaw = state.lookPitch = 0;
      state.fovDeg = 90;
      state.mapZoom = 1;
      runCtl.setRunning((state.running = false));
      dirty = true;
    },
  });

  const go = (o: { view?: typeof state.view; dest?: string; mode?: typeof state.mode; s?: number; acc?: number; prog?: number; fov?: number }) => {
    if (o.view) { state.view = o.view; viewSeg.select(o.view); }
    if (o.dest) { state.dest = DESTS[o.dest]; destSeg.select(o.dest); }
    if (o.mode) { state.mode = o.mode; modeSeg.select(o.mode); }
    if (o.s != null) { state.s = o.s; setSpeed(o.s); }
    if (o.acc != null) { state.acc = o.acc; setAcc(o.acc); }
    if (o.prog != null) { state.prog = o.prog; setProg(o.prog); }
    if (o.fov != null) state.fovDeg = o.fov;
    state.lookYaw = state.lookPitch = 0;
    showFor();
  };
  tries({
    crowd: () => go({ view: 'cockpit', dest: 'proxima', mode: 'coast', s: 1.3, prog: 0.4, fov: 120 }),
    cmb: () => go({ view: 'cockpit', dest: 'andromeda', mode: 'coast', s: 4.5, prog: 0.4, fov: 120 }),
    andromeda: () => go({ view: 'map', dest: 'andromeda', mode: 'rocket', acc: 1, prog: 0.5 }),
    three: () => go({ view: 'cockpit', dest: 'andromeda', mode: 'rocket', acc: 1, prog: 0.1, fov: 60 }),
    limit: () => go({ view: 'cosmos', acc: 1, prog: 0.6 }),
  });
  showFor();

  if (!gl) {
    ctx.fillStyle = '#e8e9ec';
    ctx.font = '14px ui-sans-serif, system-ui, sans-serif';
    ctx.fillText('This simulation needs WebGL2, which this browser does not offer.', 20, 30);
  }
  void wrap;
  void T0;
</script>

