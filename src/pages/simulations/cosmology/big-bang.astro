---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Checks from '../../../components/sim/Checks.astro';
import Transport from '../../../components/sim/Transport.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="cosmology"
  title="From the Big Bang to Galaxies"
  description="One box of the universe, followed from a split second after the Big Bang to today. Drag through 54 orders of magnitude in time and watch quarks become protons, protons and neutrons become helium, the glowing fog clear into the light we still see, and the seeds left by inflation grow into the cosmic web."
  shortcuts={['run', 'reset', 'fullscreen']}
  standard={false}
>
  <div class="sim bb-sim">
    <div class="sim-view">
      <div class="sim-stage bb-stage">
        <div class="bb-wrap" id="bb-wrap">
          <canvas id="bbgl" aria-hidden="true"></canvas>
          <canvas
            id="bb"
            role="img"
            aria-label="A 3D box of the universe from inflation to today, over a logarithmic timeline of the cosmic epochs."
          ></canvas>
          <button type="button" class="bb-toggle" id="bb-toggle" aria-pressed="true">Controls</button>
        </div>
      </div>
    </div>

    <div class="sim-panel">
      <Seg
        id="epoch"
        label="Jump to"
        attr="e"
        active=""
        options={[
          { value: 'inflation', label: 'Inflation' },
          { value: 'quarks', label: 'Quarks' },
          { value: 'hadrons', label: 'Protons & neutrons' },
          { value: 'bbn', label: 'First nuclei' },
          { value: 'plasma', label: 'Plasma' },
          { value: 'recomb', label: 'Light set free' },
          { value: 'dark', label: 'Dark ages' },
          { value: 'dawn', label: 'First stars' },
          { value: 'galaxies', label: 'Galaxies' },
          { value: 'today', label: 'Today' },
        ]}
      />
      <Transport />
      <Seg
        id="frame"
        label="Box"
        attr="f"
        options={[
          { value: 'comoving', label: 'Grows with space' },
          { value: 'physical', label: 'Real size' },
        ]}
      />
      <Checks
        label="Show"
        items={[
          { id: 'l-glow', label: 'Light of the hot universe', checked: true },
          { id: 'l-box', label: 'Box outline', checked: true },
          { id: 'l-legend', label: 'What the dots are', checked: true },
        ]}
      />
      <Readout
        title="Numbers"
        open
        rows={[
          { id: 'r-time', label: 'Time since the start' },
          { id: 'r-temp', label: 'Temperature' },
          { id: 'r-energy', label: 'Typical particle energy' },
          { id: 'r-size', label: 'Size compared with today' },
          { id: 'r-z', label: 'Redshift z' },
          { id: 'r-rho', label: 'Density' },
          { id: 'r-box', label: 'This box, then' },
          { id: 'r-comp', label: 'By mass: H / He' },
          { id: 'r-d', label: 'Deuterium per H' },
          { id: 'r-xe', label: 'Free electrons per H' },
          { id: 'r-mfp', label: 'Light travels between hits' },
        ]}
      />
      <details class="numeric-details">
        <summary>Data and models</summary>
        <ul class="bb-notes">
          <li>Expansion: Planck 2018 densities, with the number of particle species g*(T) of the Standard Model in the radiation era.</li>
          <li>Inflation is drawn as 60 e-folds ending at 10⁻³² s; when it really happened, and how, is still open.</li>
          <li>Nuclei: neutrons freeze out at 0.79 MeV and decay until deuterium survives at 0.07 MeV; the curves are tuned to standard nucleosynthesis codes (helium 24.7% by mass, D/H = 2.5×10⁻⁵).</li>
          <li>Recombination: a fit to RECFAST. Reionization: Planck’s tanh model centred on z = 7.7.</li>
          <li>Structure: a Gaussian field with the Planck power spectrum (σ8 = 0.81) in a box 150 Mpc across, 262,144 particles moved by the Zel’dovich approximation. Stars light up in the densest places first.</li>
        </ul>
      </details>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      There is no centre and no edge: the box is a piece of a universe that is the same everywhere. The Big Bang
      happened <b>everywhere at once</b>. In 10⁻³² s inflation stretches this piece by 10²⁶, and quantum ripples
      become the faint blue and red seeds. <Try id="inflation" />
    </li>
    <li>
      Above 2 trillion degrees, quarks cannot stay inside protons. At about <b>10 microseconds</b> the soup cools
      enough for them to lock into protons and neutrons, three at a time. <Try id="hadrons" />
    </li>
    <li>
      After three minutes, every surviving neutron is swept into helium. When the dust settles the universe is
      <b>a quarter helium by mass</b>, which is just what old stars and gas clouds show today. <Try id="bbn" />
    </li>
    <li>
      For 380,000 years light cannot get anywhere: it keeps bouncing off free electrons. Then the gas cools to
      3,000 K, electrons settle into atoms, and the <b>fog clears</b>. That light, stretched 1,100 times, is the
      microwave background. <Try id="cmb" />
    </li>
    <li>
      The seeds were only one part in 100,000. Gravity grows them through the dark ages, and the <b>first stars</b>
      light up in the densest knots after about 100 million years, then ionize the gas around them. <Try id="dawn" />
    </li>
    <li>
      Today the same seeds have become filaments of galaxies around empty voids: the <b>cosmic web</b>, grown in
      place from the pattern inflation left. <Try id="today" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { el, segmented, check, transport, readout, tries } from '../../../lib/panel';
  import { View, v3, compile, fitCanvas, type V3, type Program } from '../../../lib/gl3d';
  import { GLSL_STAR_RGB } from '../../../lib/cosmos';
  import {
    moment, growth, nuclei, freeElectrons, meanFreePath, reionized, starShare,
    T_INFLATION_START, T_HOT_START, T_NOW, T_NUCLEI, SEC_PER_YR,
  } from '../../../lib/early-universe';
  import { makeBox, type Box } from '../../../lib/zeldovich';

  const YR = SEC_PER_YR, MYR = 1e6 * YR, GYR = 1e9 * YR;
  const LOG0 = Math.log10(T_INFLATION_START), LOG1 = Math.log10(T_NOW);

  // =====================================================================
  //  The epochs
  // =====================================================================
  type Epoch = { key: string; name: string; short: string; t0: number; t1: number; go: number; colour: string; text: [string, string] };
  const EPOCHS: Epoch[] = [
    { key: 'inflation', name: 'Inflation', short: 'Inflation', t0: T_INFLATION_START, t1: T_HOT_START, go: 3e-33, colour: '#9cc4ff',
      text: ['Space grows by a factor of 10²⁶ in a split second, smoothing everything flat.', 'Quantum jitters of the field driving it are stretched into the seeds of all later structure.'] },
    { key: 'quarks', name: 'Quark–gluon plasma', short: 'Quarks', t0: T_HOT_START, t1: 2e-5, go: 1e-12, colour: '#ff7a8a',
      text: ['The energy of inflation turns into a white-hot soup of quarks, gluons, electrons and light.', 'Too hot for quarks to stay bound, they roam free. At 10⁻¹¹ s the Higgs field switches on.'] },
    { key: 'hadrons', name: 'Protons and neutrons', short: 'Hadrons', t0: 2e-5, t1: T_NUCLEI, go: 0.3, colour: '#f5a76b',
      text: ['Below 2 trillion K quarks lock into protons and neutrons, three at a time.', 'Weak reactions swap the two until 1 s; after that about one neutron in six is left, slowly decaying.'] },
    { key: 'bbn', name: 'The first nuclei', short: 'Nuclei', t0: T_NUCLEI, t1: 1200, go: 420, colour: '#f5c26b',
      text: ['Deuterium finally survives being made, and almost every neutron ends up inside helium-4.', 'In twenty minutes the universe is one quarter helium by mass, as we still measure it today.'] },
    { key: 'plasma', name: 'Glowing plasma', short: 'Plasma', t0: 1200, t1: 2.4e5 * YR, go: 5e4 * YR, colour: '#ffb38a',
      text: ['Nuclei and electrons in a sea of light. Each photon is scattered by free electrons again and again,', 'so the universe is an opaque glowing fog, like the inside of a star.'] },
    { key: 'recomb', name: 'Light set free', short: 'CMB', t0: 2.4e5 * YR, t1: 5.5e5 * YR, go: 3.8e5 * YR, colour: '#ffd27a',
      text: ['At 3,000 K electrons settle onto nuclei to make atoms, and the fog clears.', 'The light of this moment is still arriving, stretched 1,100 times: the cosmic microwave background.'] },
    { key: 'dark', name: 'The dark ages', short: 'Dark ages', t0: 5.5e5 * YR, t1: 100 * MYR, go: 20 * MYR, colour: '#8f9ab8',
      text: ['No stars yet. The leftover glow reddens into the infrared and the universe goes dark.', 'Gravity quietly pulls gas and dark matter into the slightly denser seeds.'] },
    { key: 'dawn', name: 'Cosmic dawn', short: 'First stars', t0: 100 * MYR, t1: 1 * GYR, go: 500 * MYR, colour: '#9cf0ff',
      text: ['Gas in the densest knots collapses into the first stars, huge and blue.', 'Their ultraviolet light splits the hydrogen again, bubble by bubble: reionization.'] },
    { key: 'galaxies', name: 'Galaxies', short: 'Galaxies', t0: 1 * GYR, t1: 9.8 * GYR, go: 3.5 * GYR, colour: '#c9b8ff',
      text: ['Galaxies grow and merge along a web of filaments around empty voids.', 'Stars form fastest about ten billion years ago, then slow down.'] },
    { key: 'today', name: 'Dark energy takes over', short: 'Today', t0: 9.8 * GYR, t1: T_NOW, go: T_NOW, colour: '#5eead4',
      text: ['Dark energy now outweighs matter and the expansion is speeding up.', 'The web we map is the pattern inflation left, grown about 100,000 times.'] },
  ];
  const epochAt = (t: number) => EPOCHS.find((e) => t < e.t1) ?? EPOCHS[EPOCHS.length - 1];

  const state = {
    logt: Math.log10(1e-35),
    running: false,
    frame: 'comoving' as 'comoving' | 'physical',
    show: { glow: true, box: true, legend: true },
    yaw: -0.7,
    pitch: 0.42,
    r: 2.3, // camera distance in box widths
    lnCam: 0, // ln a the 'real size' camera has caught up with
    phase: 0,
  };

  // =====================================================================
  //  Canvas
  // =====================================================================
  const wrap = el('bb-wrap');
  const simRoot = wrap.closest('.bb-sim') as HTMLElement;
  const toggle = el('bb-toggle');
  toggle.addEventListener('click', () => {
    const off = simRoot.classList.toggle('bb-panel-off');
    toggle.setAttribute('aria-pressed', String(!off));
  });
  const canvas = el('bb') as HTMLCanvasElement;
  const glc = el('bbgl') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  let W = 960, H = 640, TH = 104, MH = 536;
  const view = new View();
  view.tanY = 0.5;
  let dirty = true;
  function resize() {
    const b = wrap.getBoundingClientRect();
    W = Math.max(200, b.width);
    H = Math.max(240, b.height);
    TH = Math.round(Math.max(92, Math.min(124, H * 0.17)));
    MH = H - TH;
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    canvas.width = Math.round(W * dpr);
    canvas.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    view.aspect = W / MH;
    view.px = MH;
    dirty = true;
  }
  resize();
  new ResizeObserver(resize).observe(wrap);
  const setRows = readout();
  const gl = glc.getContext('webgl2', { antialias: false, alpha: false, preserveDrawingBuffer: true });

  // =====================================================================
  //  GL: the particles, and the glow of the hot universe
  // =====================================================================
  // Each particle is one parcel of matter. What it shows depends on the epoch:
  // weights blend the looks across each transition.
  const VS = `#version 300 es
in vec3 aQ;
in vec3 aPsi;
in float aDelta;
in float aRank;
in float aRnd;
uniform vec3 uEye, uRight, uUp, uFwd;
uniform float uTanY, uAspect, uPx, uDpr;
uniform float uD, uL, uScale, uPhase, uJit, uSize, uBright;
uniform float uWInf, uWQuark, uWHadron, uWNuclei, uWAtom;
uniform float uXn, uY, uStar, uIon, uIonTint, uFog, uZNear;
out vec3 vCol;
out float vA;
void main() {
  vec3 x = aQ + uD * aPsi;
  x = mod(x + 0.5 * uL, uL) - 0.5 * uL;
  // thermal motion, for the eye only: hot particles jitter
  float r1 = fract(aRnd * 13.37), r2 = fract(aRnd * 71.3), r3 = fract(aRnd * 5.77);
  x += uJit * vec3(sin(uPhase * (3.1 + 5.0 * r1) + 40.0 * r2), sin(uPhase * (2.7 + 4.0 * r2) + 71.0 * r3), sin(uPhase * (3.7 + 3.0 * r3) + 13.0 * r1));
  x *= uScale;
  vec3 rel = x - uEye;
  float z = dot(rel, uFwd);
  gl_Position = vec4(dot(rel, uRight) / (uTanY * uAspect), dot(rel, uUp) / uTanY, 0.0, z);

  // inflation: the seeds, blue where thinner, red where denser
  float s = clamp(aDelta / 2.0, -1.0, 1.0);
  vec3 cInf = s > 0.0 ? vec3(1.0, 0.42, 0.32) : vec3(0.35, 0.55, 1.0);
  float aInf = 0.12 + 0.55 * abs(s);
  // quarks in three colours, flickering
  float qc = floor(r3 * 3.0);
  vec3 cQuark = qc < 0.5 ? vec3(1.0, 0.32, 0.32) : qc < 1.5 ? vec3(0.35, 1.0, 0.45) : vec3(0.4, 0.55, 1.0);
  float aQuark = 0.55 + 0.45 * sin(uPhase * 9.0 + aRnd * 50.0);
  // protons and neutrons
  bool neutron = aRnd < uXn;
  vec3 cHadron = neutron ? vec3(0.62, 0.72, 0.9) : vec3(1.0, 0.55, 0.35);
  // nuclei: helium-4 (a quarter of the mass), then protons, leftover neutrons
  bool helium = aRnd < uY;
  vec3 cNuclei = helium ? vec3(1.0, 0.86, 0.3) : (aRnd < uY + uXn ? vec3(0.62, 0.72, 0.9) : vec3(1.0, 0.55, 0.35));
  // atoms: dim neutral gas, brighter where dense; ionized again later, inside out
  float dens = aRank * aRank;
  bool ionized = aRank > 1.0 - uIon;
  vec3 cGas = helium ? vec3(0.75, 0.72, 0.6) : vec3(0.5, 0.6, 0.9);
  vec3 cAtom = ionized ? mix(cGas, vec3(1.0, 0.45, 0.75), uIonTint) : cGas;
  float aAtom = 0.05 + 0.6 * dens * dens + (ionized ? 0.12 * uIonTint : 0.0);

  vec3 col = uWInf * cInf + uWQuark * cQuark + uWHadron * cHadron + uWNuclei * cNuclei + uWAtom * cAtom;
  float a = uWInf * aInf + uWQuark * aQuark + uWHadron * 0.75 + uWNuclei * (helium ? 1.0 : 0.7) + uWAtom * aAtom;
  float size = uSize * (uWNuclei * (helium ? 0.5 : 0.0) + 1.0);
  // stars, in the densest knots; the first ones big and blue
  if (aRank > 1.0 - uStar) {
    float early = clamp(uStar / 0.01, 0.0, 1.0);
    col = mix(vec3(0.65, 0.78, 1.0), vec3(1.0, 0.9, 0.75), early * fract(aRnd * 3.3));
    a = 0.22 + 0.3 * fract(aRnd * 5.3);
    size = uSize * (1.3 + 1.2 * fract(aRnd * 9.1));
  }
  // the fog of free electrons hides all but the nearest
  a *= mix(1.0, exp(-max(z - uZNear, 0.0) / (uL * uScale * 0.3)), uFog);
  vCol = col;
  vA = a * uBright;
  gl_PointSize = (z <= 0.0 || vA < 0.004) ? 0.0 : size * uDpr;
}`;
  const FS = `#version 300 es
precision highp float;
in vec3 vCol;
in float vA;
out vec4 o;
void main() {
  vec2 q = gl_PointCoord * 2.0 - 1.0;
  float r2 = dot(q, q);
  if (r2 > 1.0) discard;
  float f = exp(-r2 * 4.0) * (1.0 - r2 * 0.6);
  o = vec4(vCol * vA * f, 1.0);
}`;
  // the light filling space: a blackbody at the photon temperature, as bright as the eye would find it
  const GLOW_VS = `#version 300 es
in vec2 p;
void main() { gl_Position = vec4(p, 0.0, 1.0); }`;
  const GLOW_FS = `#version 300 es
precision highp float;
uniform vec3 uCol;
uniform float uA;
out vec4 o;
void main() { o = vec4(uCol * uA, uA); }`;

  let prog: Program | null = null, glow: Program | null = null;
  let vao: WebGLVertexArrayObject | null = null, glowVao: WebGLVertexArrayObject | null = null;
  let count = 0;
  let box: Box | null = null;
  if (gl) {
    prog = compile(gl, VS, FS, 'big-bang');
    glow = compile(gl, GLOW_VS, GLOW_FS, 'big-bang glow');
    if (glow) {
      glowVao = gl.createVertexArray();
      gl.bindVertexArray(glowVao);
      const b = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, b);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
      const loc = gl.getAttribLocation(glow.prog, 'p');
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
      gl.bindVertexArray(null);
    }
  }
  // build the box after the first frame, so the page shows something at once
  setTimeout(() => {
    box = makeBox();
    if (!gl || !prog) return;
    const N = box.n ** 3;
    const data = new Float32Array(N * 9);
    let s = 7;
    const rnd = () => ((s = (s * 1664525 + 1013904223) >>> 0) / 4294967296);
    for (let i = 0; i < N; i++) {
      const c = box.L / box.n;
      data.set([box.q[i * 3] + (rnd() - 0.5) * c, box.q[i * 3 + 1] + (rnd() - 0.5) * c, box.q[i * 3 + 2] + (rnd() - 0.5) * c, box.psi[i * 3], box.psi[i * 3 + 1], box.psi[i * 3 + 2], box.delta[i], box.rank[i], rnd()], i * 9);
    }
    vao = gl.createVertexArray();
    gl.bindVertexArray(vao);
    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, data, gl.STATIC_DRAW);
    let off = 0;
    for (const [name, n] of [['aQ', 3], ['aPsi', 3], ['aDelta', 1], ['aRank', 1], ['aRnd', 1]] as [string, number][]) {
      const loc = gl.getAttribLocation(prog.prog, name);
      if (loc >= 0) {
        gl.enableVertexAttribArray(loc);
        gl.vertexAttribPointer(loc, n, gl.FLOAT, false, 36, off * 4);
      }
      off += n;
    }
    gl.bindVertexArray(null);
    count = N;
    dirty = true;
  }, 30);

  // =====================================================================
  //  What the epoch looks like
  // =====================================================================
  const smooth = (a: number, b: number, x: number) => {
    const t = Math.max(0, Math.min(1, (x - a) / (b - a)));
    return t * t * (3 - 2 * t);
  };
  /** Colour of a blackbody, as in the star shaders. */
  function tempRGB(T: number): [number, number, number] {
    const t = T / 100;
    let r: number, g: number, b: number;
    if (t <= 66) {
      r = 255;
      g = 99.47 * Math.log(t) - 161.12;
      b = t <= 19 ? 0 : 138.52 * Math.log(t - 10) - 305.04;
    } else {
      r = 329.7 * Math.pow(t - 60, -0.1332);
      g = 288.12 * Math.pow(t - 60, -0.0755);
      b = 255;
    }
    const c = (v: number) => Math.max(0, Math.min(255, v)) / 255;
    return [c(r), c(g), c(b)];
  }
  /** Share of a blackbody's light between 400 and 700 nm. */
  function fvis(T: number) {
    const x1 = 14388 / (0.7 * T), x2 = 14388 / (0.4 * T);
    const n = 16, h = (x2 - x1) / n;
    let s = 0;
    for (let i = 0; i <= n; i++) {
      const x = x1 + i * h;
      s += ((x * x * x) / Math.expm1(x)) * (i === 0 || i === n ? 1 : i % 2 ? 4 : 2);
    }
    return ((15 / Math.PI ** 4) * s * h) / 3;
  }

  function look(t: number) {
    const m = moment(t);
    const lt = Math.log10(t);
    const nuc = nuclei(t);
    const z = m.z;
    // the blend of looks: each turns into the next across its transition
    const qh = smooth(Math.log10(1e-5), Math.log10(4e-5), lt); // quarks → hadrons
    const hn = smooth(Math.log10(T_NUCLEI), Math.log10(T_NUCLEI * 1.6), lt); // hadrons → nuclei
    const na = 1 - smooth(900, 1600, z); // nuclei → atoms, at recombination
    const inf = 1 - smooth(Math.log10(T_HOT_START) - 0.3, Math.log10(T_HOT_START) + 0.2, lt);
    const w = {
      inf,
      quark: (1 - inf) * (1 - qh),
      hadron: (1 - inf) * qh * (1 - hn),
      nuclei: (1 - inf) * hn * (1 - na),
      atom: (1 - inf) * na,
    };
    const T = m.T ?? 0;
    // light filling space
    let glowCol: [number, number, number] = [0, 0, 0], glowA = 0;
    if (!m.inflating) {
      const c = tempRGB(Math.min(T, 40000));
      // above 40,000 K the eye sees a blue-white blaze; below 3,000 K it dims fast as the light leaves the visible
      const vis = T > 4000 ? 1 : (T ** 4 * fvis(T)) / (4000 ** 4 * fvis(4000));
      glowA = Math.min(0.3, 0.3 * Math.pow(Math.max(vis, 0), 0.35));
      if (T < 700) glowA *= smooth(500, 700, T);
      glowCol = c;
      // reheating: a flash at the end of inflation
      glowA *= smooth(Math.log10(T_HOT_START) - 0.4, Math.log10(T_HOT_START), lt);
    }
    // opacity: how many mean free paths fit in the box
    const mfp = m.inflating ? Infinity : meanFreePath(z);
    const fog = m.inflating ? 0 : Math.max(0, Math.min(1, Math.log10(150 / mfp) / 2));
    return {
      m, nuc, w, glowCol, glowA, fog, mfp,
      D: m.inflating ? 0 : growth(m.a),
      star: z < 40 ? starShare(z) : 0,
      ion: z < 40 ? reionized(z) : 0,
      // jitter in box units: hot means fast
      jit: m.inflating ? 0 : Math.min(0.9, Math.max(0, (Math.log10(T) - 3.5) / 9)),
      bright: m.inflating ? 0.9 : 1,
    };
  }

  // =====================================================================
  //  Drawing
  // =====================================================================
  function placeCamera() {
    const L = box?.L ?? 150;
    const cp = Math.cos(state.pitch);
    const dir: V3 = [cp * Math.cos(state.yaw), cp * Math.sin(state.yaw), Math.sin(state.pitch)];
    view.eye = v3.mul(dir, state.r * L);
    view.look(v3.mul(dir, -1), [0, 0, 1]);
  }

  /** How big the box is drawn relative to its comoving size. */
  function boxScale(a: number) {
    if (state.frame === 'comoving') return 1;
    return Math.max(1e-3, Math.min(1e3, Math.exp(Math.log(a) - state.lnCam)));
  }

  function drawGL(L: ReturnType<typeof look>) {
    if (!gl) return;
    const dpr = fitCanvas(glc, W, H);
    gl.viewport(0, 0, glc.width, glc.height);
    gl.clearColor(0.005, 0.006, 0.012, 1);
    gl.clear(gl.COLOR_BUFFER_BIT);
    gl.viewport(0, Math.round(TH * dpr), glc.width, glc.height - Math.round(TH * dpr));
    gl.enable(gl.BLEND);
    // the glow fills space first; the particles add to it
    if (glow && state.show.glow && L.glowA > 0.002) {
      gl.useProgram(glow.prog);
      gl.bindVertexArray(glowVao);
      gl.blendFunc(gl.ONE, gl.ZERO);
      gl.uniform3f(glow.u('uCol'), ...L.glowCol);
      gl.uniform1f(glow.u('uA'), L.glowA);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    }
    if (prog && vao && box) {
      gl.useProgram(prog.prog);
      gl.bindVertexArray(vao);
      gl.blendFunc(gl.ONE, gl.ONE);
      gl.uniform3f(prog.u('uEye'), ...view.eye);
      gl.uniform3f(prog.u('uRight'), ...view.right);
      gl.uniform3f(prog.u('uUp'), ...view.up);
      gl.uniform3f(prog.u('uFwd'), ...view.fwd);
      gl.uniform1f(prog.u('uTanY'), view.tanY);
      gl.uniform1f(prog.u('uAspect'), view.aspect);
      gl.uniform1f(prog.u('uPx'), view.px);
      gl.uniform1f(prog.u('uDpr'), dpr);
      gl.uniform1f(prog.u('uD'), L.D);
      gl.uniform1f(prog.u('uL'), box.L);
      gl.uniform1f(prog.u('uScale'), boxScale(L.m.a));
      gl.uniform1f(prog.u('uPhase'), state.phase);
      gl.uniform1f(prog.u('uJit'), L.jit * (box.L / box.n));
      gl.uniform1f(prog.u('uSize'), Math.max(1.4, Math.min(3, MH / 330)) * (1 + 0.5 * (1 - L.w.inf - L.w.atom)));
      // the hot soup is drawn bolder, so it reads against its own glow
      const hot = 1 - L.w.inf - L.w.atom;
      gl.uniform1f(prog.u('uBright'), L.bright * (1 + 1.3 * hot));
      gl.uniform1f(prog.u('uWInf'), L.w.inf);
      gl.uniform1f(prog.u('uWQuark'), L.w.quark);
      gl.uniform1f(prog.u('uWHadron'), L.w.hadron);
      gl.uniform1f(prog.u('uWNuclei'), L.w.nuclei);
      gl.uniform1f(prog.u('uWAtom'), L.w.atom);
      gl.uniform1f(prog.u('uXn'), L.nuc.n);
      gl.uniform1f(prog.u('uY'), L.nuc.He);
      gl.uniform1f(prog.u('uStar'), L.star);
      gl.uniform1f(prog.u('uIon'), L.ion);
      gl.uniform1f(prog.u('uFog'), L.fog);
      // the box's nearest corner, so the fog thickens with depth into it
      gl.uniform1f(prog.u('uZNear'), (state.r - 0.87) * box.L * boxScale(L.m.a));
      // the bubbles of ionized gas stand out while they grow, then the gas is just gas again
      gl.uniform1f(prog.u('uIonTint'), Math.min(1, 4 * L.ion * (1 - L.ion) + 0.15 * L.ion));
      gl.drawArrays(gl.POINTS, 0, count);
    }
    // the fog veils what is behind it, in the colour of its own light
    if (glow && L.fog > 0.01) {
      gl.useProgram(glow.prog);
      gl.bindVertexArray(glowVao);
      gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);
      const c = state.show.glow ? L.glowCol : ([0.2, 0.2, 0.25] as [number, number, number]);
      gl.uniform3f(glow.u('uCol'), ...c);
      gl.uniform1f(glow.u('uA'), L.fog * 0.16);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    }
    gl.bindVertexArray(null);
  }

  const proj = (p: V3) => view.project(p, W, MH);

  function drawBox(L: ReturnType<typeof look>) {
    if (!state.show.box || !box) return;
    const h = (box.L / 2) * boxScale(L.m.a);
    const c: V3[] = [];
    for (const x of [-h, h]) for (const y of [-h, h]) for (const z of [-h, h]) c.push([x, y, z]);
    const edges = [[0, 1], [2, 3], [4, 5], [6, 7], [0, 2], [1, 3], [4, 6], [5, 7], [0, 4], [1, 5], [2, 6], [3, 7]];
    ctx.strokeStyle = 'rgba(200,210,240,0.22)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    for (const [a, b] of edges) {
      const p = proj(c[a]), q = proj(c[b]);
      if (!p || !q) continue;
      ctx.moveTo(p.x, p.y);
      ctx.lineTo(q.x, q.y);
    }
    ctx.stroke();
    // its size, then
    const p = proj([h, -h, -h]), q = proj([-h, -h, -h]);
    if (p && q) {
      ctx.font = '11.5px ui-sans-serif, system-ui, sans-serif';
      ctx.fillStyle = 'rgba(220,226,240,0.75)';
      ctx.textAlign = 'center';
      ctx.fillText(fmtLen(box.L * 3.0856776e22 * L.m.a), (p.x + q.x) / 2, Math.max(p.y, q.y) + 16);
      ctx.textAlign = 'left';
    }
  }

  // --- formatting ---------------------------------------------------------------
  const SUP: Record<string, string> = { '-': '⁻', '0': '⁰', '1': '¹', '2': '²', '3': '³', '4': '⁴', '5': '⁵', '6': '⁶', '7': '⁷', '8': '⁸', '9': '⁹' };
  const pow10 = (e: number) => '10' + String(e).split('').map((c) => SUP[c] ?? c).join('');
  const sig = (v: number, n = 3) => (v >= 1000 ? Math.round(v).toLocaleString('en-US') : (+v.toPrecision(n)).toString());
  /** A number like 3.2×10⁻¹² when it is far from 1. */
  function sci(v: number, n = 2) {
    if (v === 0) return '0';
    const e = Math.floor(Math.log10(Math.abs(v)));
    if (e >= -2 && e < 6) return sig(v, n + 1);
    const m = v / 10 ** e;
    return `${(+m.toFixed(n - 1)).toString()}×${pow10(e)}`;
  }
  function fmtTime(t: number) {
    if (t < 1e-3) return `${sci(t)} s`;
    if (t < 120) return `${sig(t)} s`;
    if (t < 7200) return `${sig(t / 60)} minutes`;
    if (t < 2 * 86400) return `${sig(t / 3600)} hours`;
    if (t < YR) return `${sig(t / 86400)} days`;
    if (t < 1e4 * YR) return `${sig(t / YR)} years`;
    if (t < 1e6 * YR) return `${sig(t / YR / 1e3)} thousand years`;
    if (t < 1e9 * YR) return `${sig(t / MYR)} million years`;
    return `${sig(t / GYR)} billion years`;
  }
  function fmtTemp(T: number) {
    if (T >= 1e12) return `${sci(T)} K`;
    if (T >= 1e9) return `${sig(T / 1e9)} billion K`;
    if (T >= 1e6) return `${sig(T / 1e6)} million K`;
    return `${sig(T)} K`;
  }
  function fmtEnergy(T: number) {
    const eV = T * 8.617333e-5;
    const units: [number, string][] = [[1e12, 'TeV'], [1e9, 'GeV'], [1e6, 'MeV'], [1e3, 'keV'], [1, 'eV'], [1e-3, 'meV']];
    if (eV >= 1e15) return `${sci(eV / 1e12)} TeV`;
    for (const [u, n] of units) if (eV >= u) return `${sig(eV / u)} ${n}`;
    return `${sig(eV * 1e3)} meV`;
  }
  /** A length in metres, in whatever unit reads best. */
  function fmtLen(m: number) {
    const LY = 9.4607e15;
    if (m < 1e-15) return `${sci(m)} m`;
    if (m < 1e-12) return `${sig(m / 1e-15)} fm (a proton is 1.7 fm)`;
    if (m < 1e-6) return `${sci(m)} m`;
    if (m < 1e-3) return `${sig(m / 1e-6)} µm`;
    if (m < 1) return `${sig(m * 100)} cm`;
    if (m < 1e4) return `${sig(m)} m`;
    if (m < 1.496e10) return `${sig(m / 1000)} km`;
    if (m < 0.05 * LY) return `${sig(m / 1.496e11)} AU`;
    if (m < 1e6 * LY) return `${sig(m / LY)} ly`;
    if (m < 1e9 * LY) return `${sig(m / LY / 1e6)} million ly`;
    return `${sig(m / LY / 1e9)} billion ly`;
  }

  function drawHud(L: ReturnType<typeof look>) {
    const t = 10 ** state.logt;
    const e = epochAt(t);
    ctx.shadowColor = 'rgba(0,0,0,0.85)';
    ctx.shadowBlur = 5;
    ctx.font = '600 18px ui-sans-serif, system-ui, sans-serif';
    ctx.fillStyle = e.colour;
    ctx.fillText(e.name, 16, 30);
    ctx.font = '600 13px ui-sans-serif, system-ui, sans-serif';
    ctx.fillStyle = 'rgba(240,242,248,0.95)';
    const T = L.m.T;
    ctx.fillText(`t = ${fmtTime(t)}   ·   ${T ? `T = ${fmtTemp(T)}` : 'no particles yet, only the field driving inflation'}`, 16, 51);
    ctx.font = '12.5px ui-sans-serif, system-ui, sans-serif';
    ctx.fillStyle = 'rgba(232,233,236,0.82)';
    const maxW = Math.min(W - 160, 640);
    let y = 72;
    for (const line of e.text) for (const l of wrapText(line, maxW)) { ctx.fillText(l, 16, y); y += 17; }
    if (!box) {
      ctx.fillStyle = 'rgba(232,233,236,0.85)';
      ctx.fillText('Laying down the seeds…', 16, y + 8);
    }
    // legend
    if (state.show.legend) {
      const items: [string, string][] = [];
      if (L.w.inf > 0.3) items.push(['#ff6b52', 'denser seed'], ['#5a8cff', 'thinner seed']);
      if (L.w.quark > 0.3) items.push(['#ff5252', 'quarks, in their three colour charges'], ['#5cff73', ''], ['#6688ff', '']);
      if (L.w.hadron > 0.3) items.push(['#ff8c59', 'proton'], ['#9eb8e6', 'neutron']);
      if (L.w.nuclei > 0.3) items.push(['#ffdb4d', 'helium-4 nucleus'], ['#ff8c59', 'proton (hydrogen nucleus)'], ['#9eb8e6', 'free neutron']);
      if (L.w.atom > 0.3) {
        items.push(['#8099e6', 'hydrogen atom'], ['#bfb899', 'helium atom']);
        if (L.ion > 0.02 && L.ion < 0.95) items.push(['#ff73bf', 'ionized again']);
        if (L.star > 0) items.push(['#fff0d0', 'stars']);
      }
      ctx.font = '11.5px ui-sans-serif, system-ui, sans-serif';
      let ly = MH - 14 - (items.filter((i) => i[1]).length - 1) * 16;
      for (let i = 0; i < items.length; i++) {
        const [c, label] = items[i];
        if (!label) continue;
        const swatches = label.startsWith('quarks') ? [items[i][0], items[i + 1][0], items[i + 2][0]] : [c];
        swatches.forEach((sc, k) => {
          ctx.fillStyle = sc;
          ctx.beginPath();
          ctx.arc(22 + k * 9, ly - 4, 3.5, 0, 2 * Math.PI);
          ctx.fill();
        });
        ctx.fillStyle = 'rgba(232,233,236,0.85)';
        ctx.fillText(label, 22 + swatches.length * 9 + 4, ly);
        ly += 16;
      }
    }
    ctx.font = '11.5px ui-sans-serif, system-ui, sans-serif';
    ctx.fillStyle = 'rgba(232,233,236,0.5)';
    ctx.textAlign = 'right';
    ctx.fillText('drag: turn · scroll: zoom · drag the timeline: travel in time', W - 14, MH - 12);
    ctx.textAlign = 'left';
    ctx.shadowBlur = 0;
  }

  function wrapText(s: string, w: number) {
    const words = s.split(' '), out: string[] = [];
    let line = '';
    for (const word of words) {
      const next = line ? line + ' ' + word : word;
      if (ctx.measureText(next).width > w && line) { out.push(line); line = word; }
      else line = next;
    }
    if (line) out.push(line);
    return out;
  }

  // --- the timeline -------------------------------------------------------------
  const TL_X0 = 16;
  const tlX = (lt: number) => TL_X0 + ((lt - LOG0) / (LOG1 - LOG0)) * (W - 2 * TL_X0);
  const tlT = (x: number) => LOG0 + ((x - TL_X0) / (W - 2 * TL_X0)) * (LOG1 - LOG0);
  const TICKS: [number, string][] = [
    [1e-36, pow10(-36) + ' s'], [1e-30, pow10(-30) + ' s'], [1e-24, pow10(-24) + ' s'], [1e-18, pow10(-18) + ' s'],
    [1e-12, pow10(-12) + ' s'], [1e-6, 'microsecond'], [1, '1 s'], [3600, '1 hour'], [YR, '1 year'],
    [1e3 * YR, '1,000 yr'], [MYR, '1 Myr'], [GYR, '1 Gyr'], [T_NOW, 'now'],
  ];

  function drawTimeline() {
    const top = MH;
    ctx.fillStyle = 'rgba(10,12,20,0.97)';
    ctx.fillRect(0, top, W, TH);
    ctx.fillStyle = 'rgba(255,255,255,0.08)';
    ctx.fillRect(0, top, W, 1);
    const yBand = top + 14, hBand = 30;
    // the epochs as coloured bands
    for (const e of EPOCHS) {
      const x0 = tlX(Math.log10(e.t0)), x1 = tlX(Math.log10(e.t1));
      ctx.fillStyle = e.colour;
      ctx.globalAlpha = 0.18;
      ctx.fillRect(x0, yBand, Math.max(1, x1 - x0), hBand);
      ctx.globalAlpha = 0.8;
      ctx.fillRect(x0, yBand + hBand - 2, Math.max(1, x1 - x0 - 1), 2);
      ctx.globalAlpha = 1;
      ctx.font = '10.5px ui-sans-serif, system-ui, sans-serif';
      const w = ctx.measureText(e.short).width;
      if (x1 - x0 > w + 6) {
        ctx.fillStyle = e.colour;
        ctx.fillText(e.short, x0 + 4, yBand + 18);
      }
    }
    // ticks
    ctx.font = '10px ui-sans-serif, system-ui, sans-serif';
    ctx.textAlign = 'center';
    let lastX = -1e9;
    for (const [t, label] of TICKS) {
      const x = tlX(Math.log10(t));
      ctx.fillStyle = 'rgba(232,233,236,0.35)';
      ctx.fillRect(x - 0.5, yBand + hBand, 1, 5);
      const w = ctx.measureText(label).width;
      if (x - lastX < w + 8) continue;
      ctx.fillStyle = 'rgba(232,233,236,0.55)';
      ctx.fillText(label, Math.max(TL_X0 + w / 2, Math.min(W - TL_X0 - w / 2, x)), yBand + hBand + 16);
      lastX = x;
    }
    ctx.textAlign = 'left';
    // the moment
    const x = tlX(state.logt);
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(x - 1, yBand - 6, 2, hBand + 12);
    ctx.beginPath();
    ctx.moveTo(x - 6, yBand - 9);
    ctx.lineTo(x + 6, yBand - 9);
    ctx.lineTo(x, yBand - 2);
    ctx.closePath();
    ctx.fill();
    ctx.font = '10.5px ui-sans-serif, system-ui, sans-serif';
    ctx.fillStyle = 'rgba(232,233,236,0.45)';
    ctx.textAlign = 'right';
    ctx.fillText('time since the start, on a log scale', W - TL_X0, top + TH - 8);
    ctx.textAlign = 'left';
  }

  function updateNumbers(L: ReturnType<typeof look>) {
    const t = 10 ** state.logt, m = L.m;
    const T = m.T;
    const rhoWater = m.rho / 1000;
    setRows({
      'r-time': fmtTime(t),
      'r-temp': T ? fmtTemp(T) : '(inflaton field)',
      'r-energy': T ? fmtEnergy(T) : '—',
      'r-size': `1 / ${sci(1 / m.a)}`,
      'r-z': sci(m.z),
      'r-rho': rhoWater > 1e-2 ? `${sci(rhoWater)} × water` : `${sci(m.rho)} kg/m³`,
      'r-box': fmtLen((box?.L ?? 150) * 3.0856776e22 * m.a),
      'r-comp': t < 2e-5 ? 'free quarks' : `${(L.nuc.H * 100).toFixed(1)}% / ${(L.nuc.He * 100).toFixed(1)}%`,
      'r-d': t < 1 ? '—' : sci(L.nuc.D),
      'r-xe': m.inflating ? '—' : t < 2e-5 ? 'all free' : sig(Math.min(1.163, freeElectrons(m.z)), 3),
      'r-mfp': m.inflating ? '—' : fmtLen(L.mfp * 3.0856776e22 * m.a),
    });
  }

  function draw() {
    const L = look(10 ** state.logt);
    placeCamera();
    drawGL(L);
    ctx.clearRect(0, 0, W, H);
    drawBox(L);
    drawHud(L);
    drawTimeline();
    updateNumbers(L);
    const e = epochAt(10 ** state.logt);
    if (epochSeg.value() !== e.key) epochSeg.select(e.key);
  }

  // =====================================================================
  //  Controls
  // =====================================================================
  const epochSeg = segmented('epoch', (v) => {
    const e = EPOCHS.find((x) => x.key === v);
    if (e) jump(Math.log10(e.go));
  });
  /** Glide to a moment rather than cut, so the change is seen happening. */
  let glide: { from: number; to: number; t0: number; dur: number } | null = null;
  function jump(lt: number) {
    glide = { from: state.logt, to: lt, t0: performance.now(), dur: Math.min(2600, 500 + Math.abs(lt - state.logt) * 70) };
    dirty = true;
  }
  const frameSeg = segmented('frame', (v) => {
    state.frame = v as typeof state.frame;
    state.lnCam = Math.log(moment(10 ** state.logt).a);
    dirty = true;
  });
  void frameSeg;
  const run = transport({
    onRun: (on) => {
      state.running = on;
      glide = null;
      if (on && state.logt >= LOG1 - 1e-3) state.logt = LOG0;
    },
    onReset: () => {
      run.setRunning(false);
      state.running = false;
      glide = null;
      state.logt = Math.log10(1e-35);
      state.yaw = -0.7;
      state.pitch = 0.42;
      state.r = 2.3;
      dirty = true;
    },
  });
  check('l-glow', (on) => { state.show.glow = on; dirty = true; });
  check('l-box', (on) => { state.show.box = on; dirty = true; });
  check('l-legend', (on) => { state.show.legend = on; dirty = true; });

  const goTo = (key: string) => () => {
    const e = EPOCHS.find((x) => x.key === key);
    if (e) jump(Math.log10(e.go));
  };
  tries({
    inflation: goTo('inflation'),
    hadrons: () => jump(Math.log10(4e-5)),
    bbn: goTo('bbn'),
    cmb: goTo('recomb'),
    dawn: goTo('dawn'),
    today: goTo('today'),
  });

  // --- pointer: the timeline scrubs, the rest turns the box -----------------------
  const pointers = new Map<number, { x: number; y: number }>();
  let scrubbing = false, pinch0 = 0, r0 = 1;
  const local = (e: PointerEvent) => {
    const b = canvas.getBoundingClientRect();
    return { x: e.clientX - b.left, y: e.clientY - b.top };
  };
  canvas.addEventListener('pointerdown', (e) => {
    canvas.setPointerCapture(e.pointerId);
    const p = local(e);
    pointers.set(e.pointerId, p);
    scrubbing = p.y > MH;
    if (scrubbing) {
      glide = null;
      state.logt = Math.max(LOG0, Math.min(LOG1, tlT(p.x)));
      dirty = true;
    }
    if (pointers.size === 2) {
      const [a, b] = [...pointers.values()];
      pinch0 = Math.hypot(a.x - b.x, a.y - b.y);
      r0 = state.r;
    }
  });
  canvas.addEventListener('pointermove', (e) => {
    const prev = pointers.get(e.pointerId);
    const p = local(e);
    canvas.style.cursor = p.y > MH ? 'ew-resize' : '';
    if (!prev) return;
    pointers.set(e.pointerId, p);
    if (scrubbing) {
      state.logt = Math.max(LOG0, Math.min(LOG1, tlT(p.x)));
      dirty = true;
      return;
    }
    if (pointers.size === 2) {
      const [a, b] = [...pointers.values()];
      if (pinch0 > 0) state.r = Math.max(0.6, Math.min(8, r0 * (pinch0 / Math.max(1, Math.hypot(a.x - b.x, a.y - b.y)))));
      dirty = true;
      return;
    }
    state.yaw -= (p.x - prev.x) * 0.006;
    state.pitch = Math.max(-1.5, Math.min(1.5, state.pitch + (p.y - prev.y) * 0.006));
    dirty = true;
  });
  const up = (e: PointerEvent) => {
    pointers.delete(e.pointerId);
    pinch0 = 0;
    if (!pointers.size) scrubbing = false;
  };
  canvas.addEventListener('pointerup', up);
  canvas.addEventListener('pointercancel', up);
  canvas.addEventListener(
    'wheel',
    (e) => {
      e.preventDefault();
      state.r = Math.max(0.6, Math.min(8, state.r * Math.exp(e.deltaY * (e.deltaMode === 1 ? 0.05 : 0.0012))));
      dirty = true;
    },
    { passive: false }
  );

  // =====================================================================
  //  Loop
  // =====================================================================
  /** Decades of time per second of playing: slower where a lot happens. */
  function rate(lt: number) {
    let slow = 0;
    for (const [c, w] of [[-4.7, 0.5], [2.5, 0.6], [13.07, 0.25], [15.5, 0.6], [16.6, 0.5], [17.3, 0.35]] as [number, number][])
      slow += Math.exp(-(((lt - c) / w) ** 2));
    return 1.6 / (1 + 4 * slow);
  }
  let last = performance.now();
  function frame(now: number) {
    const dt = Math.min(0.1, (now - last) / 1000);
    last = now;
    if (state.running) {
      state.logt = Math.min(LOG1, state.logt + rate(state.logt) * dt);
      state.yaw += dt * 0.05;
      if (state.logt >= LOG1) {
        state.running = false;
        run.setRunning(false);
      }
      dirty = true;
    }
    if (glide) {
      const f = Math.min(1, (now - glide.t0) / glide.dur);
      const e = f * f * (3 - 2 * f);
      state.logt = glide.from + (glide.to - glide.from) * e;
      if (f >= 1) glide = null;
      dirty = true;
    }
    // particles jitter while hot, so keep drawing then
    const T = moment(10 ** state.logt).T ?? 0;
    if (T > 3e3 || state.frame === 'physical') dirty = true;
    state.phase += dt;
    if (state.frame === 'physical') {
      // the camera catches up with the growing box over a second or so
      const la = Math.log(moment(10 ** state.logt).a);
      state.lnCam += (la - state.lnCam) * (1 - Math.exp(-dt * 1.4));
    }
    if (dirty) {
      dirty = false;
      draw();
    }
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);

  if (!gl) {
    ctx.fillStyle = '#e8e9ec';
    ctx.font = '14px ui-sans-serif, system-ui, sans-serif';
    ctx.fillText('This simulation needs WebGL2, which this browser does not offer.', 20, 30);
  }
  void GLSL_STAR_RGB;
</script>

<style>
  .bb-stage {
    padding: 0;
    overflow: hidden;
  }
  .bb-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 960 / 640;
    overflow: hidden;
