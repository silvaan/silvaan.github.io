---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Checks from '../../../components/sim/Checks.astro';
import Transport from '../../../components/sim/Transport.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="cosmology"
  title="A Journey Through the Universe"
  description="Every point here is a real measurement. Leave the planets for 45,000 stars catalogued by Hipparcos, see the Milky Way from outside, cross to Andromeda, fly through 900,000 galaxies strung into a cosmic web, and keep going past the quasars to the glow of the Big Bang, 46 billion light-years away."
  shortcuts={['run', 'reset', 'fullscreen']}
  standard={false}
>
  <div class="sim ua-sim">
    <div class="sim-view">
      <div class="sim-stage ua-stage">
        <div class="ua-wrap" id="ua-wrap">
          <canvas id="uagl" aria-hidden="true"></canvas>
          <canvas
            id="ua"
            role="img"
            aria-label="A 3D map of the universe built from star, galaxy and quasar catalogues, from the Solar System out to the cosmic microwave background."
          ></canvas>
          <button type="button" class="ua-toggle" id="ua-toggle" aria-pressed="true">Controls</button>
        </div>
      </div>
    </div>

    <div class="sim-panel">
      <Seg
        id="scale"
        label="Jump to a scale"
        attr="s"
        active=""
        options={[
          { value: 'solar', label: 'Planets' },
          { value: 'stars', label: 'Nearest stars' },
          { value: 'hood', label: 'Our neighbourhood' },
          { value: 'mw', label: 'Milky Way' },
          { value: 'lg', label: 'Local Group' },
          { value: 'web', label: 'Cosmic web' },
          { value: 'obs', label: 'Observable universe' },
        ]}
      />
      <div class="control">
        <label for="find">Fly to</label>
        <div class="ua-find">
          <input id="find" type="search" list="find-list" placeholder="Sirius, Andromeda, Coma Cluster…" autocomplete="off" />
          <button type="button" class="btn" id="go">Go</button>
        </div>
        <datalist id="find-list"></datalist>
      </div>
      <Seg
        id="cam"
        label="Dragging"
        attr="c"
        options={[
          { value: 'orbit', label: 'Turns round the target' },
          { value: 'look', label: 'Looks around (fly)' },
        ]}
      />
      <Transport />
      <Slider id="lim" label="Faintest magnitude shown" min={2} max={12} step={0.1} value={7.5} display="7.5" hint={['naked eye: 6', 'deep']} />
      <Checks
        label="Layers"
        items={[
          { id: 'l-planets', label: 'Planets and orbits', checked: true },
          { id: 'l-stars', label: 'Stars', checked: true },
          { id: 'l-mw', label: 'Milky Way', checked: true },
          { id: 'l-lg', label: 'Local Group galaxies', checked: true },
          { id: 'l-gal', label: '2MRS galaxies (whole sky)', checked: true },
          { id: 'l-web', label: 'SDSS and 6dF galaxies (cosmic web)', checked: true },
          { id: 'l-qso', label: 'SDSS quasars', checked: true },
          { id: 'l-cmb', label: 'Microwave background', checked: true },
          { id: 'l-labels', label: 'Labels', checked: true },
          { id: 'l-rings', label: 'Distance rings', checked: true },
        ]}
      />
      <Readout
        title="Numbers"
        rows={[
          { id: 'r-target', label: 'Target from Earth' },
          { id: 'r-light', label: 'Its light left it' },
          { id: 'r-eye', label: 'You are from the Sun' },
          { id: 'r-view', label: 'Width of the view' },
          { id: 'r-mag', label: 'Target looks like (mag)' },
          { id: 'r-date', label: 'Date' },
        ]}
      />
      <details class="numeric-details">
        <summary>Flying</summary>
        <ul class="ua-credits">
          <li>W A S D or the arrow keys move you, Q and E go down and up; hold Shift to go faster. Speed follows the scale you are looking at.</li>
          <li>Right-drag, or drag with two fingers, slides the view sideways.</li>
          <li>Scroll or pinch to zoom; click a label to pick it, double-click to fly there.</li>
        </ul>
      </details>
      <details class="numeric-details">
        <summary>Data sources</summary>
        <ul class="ua-credits">
          <li>Stars: HYG v4.0 database (Hipparcos, Yale Bright Star, Gliese), D. Nash / astronexus, CC BY-SA 4.0.</li>
          <li>Planets: JPL approximate Keplerian elements (Standish), valid 1800–2050.</li>
          <li>Milky Way: spiral arms from the maser parallaxes of Reid et al. (2019), ApJ 885, 131; long bar after Wegg et al. (2015). The galaxy is drawn as a model on that skeleton.</li>
          <li>Local Group: A. McConnachie (2012), AJ 144, 4, via VizieR.</li>
          <li>Galaxies: 2MASS Redshift Survey, Huchra et al. (2012); SDSS DR18 spectroscopic galaxies (z &lt; 0.2); 6dF Galaxy Survey DR3, Jones et al. (2009). Distances from redshift.</li>
          <li>Quasars: SDSS DR16Q, Lyke et al. (2020), via VizieR; a 6% sample plus every quasar above z = 5.</li>
          <li>Microwave background: WMAP 9-year ILC map, NASA / WMAP Science Team.</li>
          <li>Distances from redshift use Planck 2018: H<sub>0</sub> = 67.7 km/s/Mpc, Ω<sub>m</sub> = 0.311.</li>
        </ul>
      </details>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Neptune's orbit is 60 AU across. Pull back a little and the nearest star, <b>Proxima Centauri</b>, is
      still 4,500 times farther than that: the Sun becomes one point among many. <Try id="proxima" />
    </li>
    <li>
      Every star in the catalogue sits inside a bubble a few thousand light-years wide, on the <b>Orion Spur</b>
      between the Sagittarius and Perseus arms, 26,000 light-years from the centre. <Try id="mw" />
    </li>
    <li>
      <b>Andromeda</b> is 2.5 million light-years away: the light reaching you tonight left it before there
      were humans. <Try id="andromeda" />
    </li>
    <li>
      Fly into the survey: galaxies gather into walls and filaments around empty voids, the <b>cosmic web</b>.
      The two wedges are the SDSS and 6dF fields; the gap between them is the band of sky our own galaxy's dust hides. <Try id="web" />
    </li>
    <li>
      Past the quasars, whose light left them up to 13 billion years ago, the sky ends in the
      <b>microwave background</b>, light from 380,000 years after the Big Bang. Space grew while it travelled,
      so that wall is now 46 billion light-years away, not 13.8. <Try id="edge" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { el, segmented, slider, check, transport, readout, tries } from '../../../lib/panel';
  import { View, v3, compile, vertexArray, setView, fitCanvas, GLSL_PROJECT, mulM3, type V3, type Program } from '../../../lib/gl3d';
  import {
    AU_PER_PC, KM_PER_AU, LY_PER_PC, PC_PER_MPC, EQ_TO_GAL, ECL_TO_EQ, CMB_URL, radec, starRGB,
    loadStars, loadStarNames, loadGalaxies, loadGalaxyNames, loadQuasars, loadLocalGroup, loadWeb,
    fmtDist, fmtLightTime, type Catalogue,
  } from '../../../lib/cosmos';
  import { GC, DISKS, diskGalaxy, milkyWay, armPoint, ARM_NAMES } from '../../../lib/galaxies';
  import { PLANCK18, comoving, particleHorizon } from '../../../lib/cosmology';

  const MPC = PC_PER_MPC;
  const R_CMB = comoving(PLANCK18, 1089) * MPC; // pc
  const R_EDGE = particleHorizon(PLANCK18) * MPC;
  const GOLD = '#f5c26b';

  // =====================================================================
  //  The Solar System: JPL's approximate elements, J2000 + rate per century
  // =====================================================================
  //  a (AU), e, I, L, long. perihelion ϖ, long. node Ω (degrees)
  type Elem = [number, number, number, number, number, number];
  const PLANETS: { n: string; r: number; c: string; e0: Elem; e1: Elem }[] = [
    { n: 'Mercury', r: 2440, c: '#b8b2a8', e0: [0.38709927, 0.20563593, 7.00497902, 252.2503235, 77.45779628, 48.33076593], e1: [0.00000037, 0.00001906, -0.00594749, 149472.67411175, 0.16047689, -0.12534081] },
    { n: 'Venus', r: 6052, c: '#f3d9a4', e0: [0.72333566, 0.00677672, 3.39467605, 181.9790995, 131.60246718, 76.67984255], e1: [0.0000039, -0.00004107, -0.0007889, 58517.81538729, 0.00268329, -0.27769418] },
    { n: 'Earth', r: 6371, c: '#6fa8ff', e0: [1.00000261, 0.01671123, -0.00001531, 100.46457166, 102.93768193, 0], e1: [0.00000562, -0.00004392, -0.01294668, 35999.37244981, 0.32327364, 0] },
    { n: 'Mars', r: 3390, c: '#e0794f', e0: [1.52371034, 0.0933941, 1.84969142, -4.55343205, -23.94362959, 49.55953891], e1: [0.00001847, 0.00007882, -0.00813131, 19140.30268499, 0.44441088, -0.29257343] },
    { n: 'Jupiter', r: 69911, c: '#e8c9a0', e0: [5.202887, 0.04838624, 1.30439695, 34.39644051, 14.72847983, 100.47390909], e1: [-0.00011607, -0.00013253, -0.00183714, 3034.74612775, 0.21252668, 0.20469106] },
    { n: 'Saturn', r: 58232, c: '#ead9a6', e0: [9.53667594, 0.05386179, 2.48599187, 49.95424423, 92.59887831, 113.66242448], e1: [-0.0012506, -0.00050991, 0.00193609, 1222.49362201, -0.41897216, -0.28867794] },
    { n: 'Uranus', r: 25362, c: '#9fe3e8', e0: [19.18916464, 0.04725744, 0.77263783, 313.23810451, 170.9542763, 74.01692503], e1: [-0.00196176, -0.00004397, -0.00242939, 428.48202785, 0.40805281, 0.04240589] },
    { n: 'Neptune', r: 24622, c: '#6f8cff', e0: [30.06992276, 0.00859048, 1.77004347, -55.12002969, 44.96476227, 131.78422574], e1: [0.00026291, 0.00005105, 0.00035372, 218.45945325, -0.32241464, -0.00508664] },
  ];
  const DEG = Math.PI / 180;

  /** Heliocentric position in AU, ecliptic axes, at Julian date jd; `M` overrides the mean anomaly. */
  function kepler(p: (typeof PLANETS)[number], jd: number, M?: number): V3 {
    const T = (jd - 2451545) / 36525;
    const [a, e, I, L, w, O] = p.e0.map((v, i) => v + p.e1[i] * T);
    const om = (w - O) * DEG, Om = O * DEG, inc = I * DEG;
    const Mn = M ?? (((L - w) % 360) + 540) % 360 - 180;
    let E = Mn * DEG + e * Math.sin(Mn * DEG);
    for (let i = 0; i < 6; i++) E -= (E - e * Math.sin(E) - Mn * DEG) / (1 - e * Math.cos(E));
    const xp = a * (Math.cos(E) - e), yp = a * Math.sqrt(1 - e * e) * Math.sin(E);
    const co = Math.cos(om), so = Math.sin(om), cO = Math.cos(Om), sO = Math.sin(Om), ci = Math.cos(inc), si = Math.sin(inc);
    return [
      (co * cO - so * sO * ci) * xp + (-so * cO - co * sO * ci) * yp,
      (co * sO + so * cO * ci) * xp + (-so * sO + co * cO * ci) * yp,
      so * si * xp + co * si * yp,
    ];
  }
  /** Ecliptic AU to galactic pc. */
  const eclToGal = (p: V3): V3 => v3.mul(mulM3(EQ_TO_GAL, mulM3(ECL_TO_EQ, p)), 1 / AU_PER_PC);

  // =====================================================================
  //  Things with names: what labels, the search and the camera can aim at
  // =====================================================================
  type Kind = 'sun' | 'planet' | 'probe' | 'star' | 'mw' | 'arm' | 'lg' | 'galaxy' | 'structure' | 'quasar' | 'edge';
  type Obj = {
    name: string;
    kind: Kind;
    pos: () => V3; // galactic, pc
    /** Radius used to frame it when you fly there, pc. */
    size: number;
    /** Absolute magnitude (V), when it has one. */
    M?: number;
    z?: number;
    info: string;
    colour?: string;
  };

  const state = {
    jd: 2440587.5 + Date.now() / 86400000,
    running: false,
    lim: 7.5,
    layers: { planets: true, stars: true, mw: true, lg: true, gal: true, web: true, qso: true, cmb: true, labels: true, rings: true },
    camMode: 'orbit' as 'orbit' | 'look',
    keys: new Set<string>(),
    // camera: orbit `centre` at distance r
    centre: [0, 0, 0] as V3,
    r: 45 / AU_PER_PC,
    yaw: -2.1,
    pitch: 0.42,
    target: null as Obj | null,
    fly: null as null | { t0: number; dur: number; path: (s: number) => { u: number; w: number }; S: number; P0: V3; P1: V3; u1: number; to: Obj },
  };

  const objects: Obj[] = [];
  const byName = new Map<string, Obj>();
  const add = (o: Obj) => {
    objects.push(o);
    byName.set(o.name.toLowerCase(), o);
    return o;
  };

  const SUN = add({ name: 'Sun', kind: 'sun', pos: () => [0, 0, 0], size: 40 / AU_PER_PC, M: 4.83, info: 'G2V star, our own', colour: '#ffe7a8' });
  const planetPos = new Map<string, V3>();
  for (const p of PLANETS)
    add({
      name: p.n, kind: 'planet', colour: p.c,
      pos: () => planetPos.get(p.n) ?? [0, 0, 0],
      size: Math.max(p.r * 40 / KM_PER_AU, 0.02) / AU_PER_PC,
      info: `planet, ${p.e0[0].toFixed(2)} AU from the Sun on average`,
    });
  // Voyager 1, from its published heading and speed (about 3.6 AU a year)
  add({
    name: 'Voyager 1', kind: 'probe', colour: '#cbd5e1',
    pos: () => {
      const yr = 2000 + (state.jd - 2451545) / 365.25;
      return radec(257.6, 12.1, (163 + 3.57 * (yr - 2024)) / AU_PER_PC);
    },
    size: 2 / AU_PER_PC,
    info: 'the most distant human-made object, launched 1977',
  });
  const GCOBJ = add({ name: 'Galactic Centre (Sgr A*)', kind: 'mw', pos: () => GC, size: 1500, info: '4 million solar mass black hole at the centre of the Milky Way' });
  const MW = add({ name: 'Milky Way', kind: 'mw', pos: () => GC, size: 22000, info: 'our galaxy, a barred spiral about 100,000 light-years across' });
  // the arms, labelled where they are best traced
  ([[0, -60], [1, -40], [2, -50], [3, 120], [4, 10]] as const).forEach(([i, b]) => {
    const p = armPoint(i, b);
    add({ name: ARM_NAMES[i] + (i === 4 ? '' : ' Arm'), kind: 'arm', pos: () => p, size: 6000, info: 'spiral arm of the Milky Way, traced by masers in young star-forming regions' });
  });

  // nicknames for catalogue entries, and galaxies too close for a redshift distance
  const NICK: Record<string, string> = {
    'NGC 5128': 'Centaurus A (NGC 5128)', M104: 'Sombrero Galaxy (M104)', M51a: 'Whirlpool Galaxy (M51)', M64: 'Black Eye Galaxy (M64)',
    M87: 'M87 (Virgo A)', M83: "Southern Pinwheel (M83)", M63: 'Sunflower Galaxy (M63)', LMC: 'Large Magellanic Cloud', SMC: 'Small Magellanic Cloud',
    Andromeda: 'Andromeda Galaxy (M31)', Triangulum: 'Triangulum Galaxy (M33)',
  };
  const CLOSE: [string, number, number, number, number][] = [
    // name, RA, Dec (deg), distance (Mpc, from Cepheids or the tip of the red giant branch), M_V
    ['Bode\'s Galaxy (M81)', 148.888, 69.065, 3.63, -21.1],
    ['Cigar Galaxy (M82)', 148.968, 69.68, 3.53, -19.6],
    ['Pinwheel Galaxy (M101)', 210.802, 54.349, 6.95, -21.6],
    ['Sculptor Galaxy (NGC 253)', 11.888, -25.288, 3.5, -21.1],
  ];
  // clusters and superclusters at their redshift distances
  const STRUCTURES: [string, number, number, number, number, string][] = [
    // name, RA, Dec, cz (km/s), radius (Mpc), note
    ['Virgo Cluster', 187.7, 12.4, 1100, 2.5, 'about 1,500 galaxies, the heart of our supercluster'],
    ['Fornax Cluster', 54.6, -35.5, 1379, 1.5, 'a compact southern cluster'],
    ['Centaurus Cluster', 192.2, -41.3, 3418, 3, 'part of the Hydra–Centaurus supercluster'],
    ['Norma Cluster (Great Attractor)', 243.6, -60.9, 4871, 4, 'the mass the Local Group is falling towards, near the centre of Laniakea'],
    ['Perseus Cluster', 49.9, 41.5, 5366, 4, 'the brightest cluster in X-rays'],
    ['Coma Cluster', 194.95, 27.98, 6925, 5, 'where Zwicky first saw the need for dark matter in 1933'],
    ['Hercules Cluster', 241.3, 17.7, 11000, 5, 'a cluster rich in spirals'],
    ['Shapley Supercluster', 202, -31, 14500, 20, 'the largest concentration of galaxies within a billion light-years'],
    ['Sloan Great Wall', 195, 2, 23000, 60, 'a wall of galaxies 1.4 billion light-years long'],
  ];
  const zDist = (cz: number) => comoving(PLANCK18, cz / 299792.458) * MPC;
  for (const [n, ra, dec, cz, rad, note] of STRUCTURES)
    add({ name: n, kind: 'structure', pos: () => radec(ra, dec, zDist(cz)), size: rad * MPC, z: cz / 299792.458, info: note });
  for (const [n, ra, dec, d, Mv] of CLOSE)
    add({ name: n, kind: 'lg', pos: () => radec(ra, dec, d * MPC), size: 15000, M: Mv, info: 'nearby galaxy, distance from its stars' });
  const EDGE = add({ name: 'Cosmic microwave background', kind: 'edge', pos: () => [0, 0, 0], size: R_CMB * 0.35, z: 1089, info: 'light from 380,000 years after the Big Bang' });

  // =====================================================================
  //  GL
  // =====================================================================
  const wrap = el('ua-wrap');
  const simRoot = wrap.closest('.ua-sim') as HTMLElement;
  const toggle = el('ua-toggle');
  toggle.addEventListener('click', () => {
    const off = simRoot.classList.toggle('ua-panel-off');
    toggle.setAttribute('aria-pressed', String(!off));
  });
  const canvas = el('ua') as HTMLCanvasElement;
  const glc = el('uagl') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  // the canvas takes whatever room the stage gives it, fullscreen included
  let W = 960, H = 600;
  const view = new View();
  view.tanY = 0.5;
  let dirty = true;
  function resize() {
    const b = wrap.getBoundingClientRect();
    W = Math.max(200, b.width);
    H = Math.max(150, b.height);
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    canvas.width = Math.round(W * dpr);
    canvas.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    view.aspect = W / H;
    view.px = H;
    dirty = true;
  }
  resize();
  new ResizeObserver(resize).observe(wrap);

  const setRows = readout();

  const gl = glc.getContext('webgl2', { antialias: false, alpha: false, premultipliedAlpha: false });

  const POINT_VS = `#version 300 es
in vec3 aPos;
in float aSize;
in float aLum;
in vec3 aCol;
${GLSL_PROJECT}
uniform float uUnit, uExpo, uMin, uMax, uDpr, uFloor, uGain;
uniform bool uDust;
out vec3 vCol;
out float vA;
out float vSoft;
void main() {
  vec3 rel;
  vec4 p = project(aPos, rel);
  float dpc = max(length(rel) * uUnit, 1e-30);
  float R = aSize * uUnit;
  // sprite radius in device pixels, and the light it gathers (1 at the limiting magnitude)
  float pxR = R / (2.0 * uTanY * dpc) * uPx * uDpr;
  float I = aLum * 100.0 / (dpc * dpc) * uExpo * uGain;
  float m = uMin * uDpr;
  float size = max(2.0 * pxR, m);
  float Ie = I * (m / size) * (m / size);
  if (2.0 * pxR <= m && Ie > 1.0) size *= min(pow(Ie, 0.22), 7.0);
  float a = max(min(Ie, 1.0), uFloor);
  // dust takes light away: a fixed opacity over its own size
  if (uDust) { size = max(2.0 * pxR, m); a = 0.09; }
  // fly into a cloud and it thins away rather than filling the screen
  if (aSize > 0.0) a *= smoothstep(0.6, 3.0, dpc / R);
  float cap = uMax * uDpr;
  if (size > cap) size = cap;
  vSoft = aSize > 0.0 ? 1.0 : 0.0;
  vCol = aCol;
  vA = a;
  gl_Position = p;
  gl_PointSize = (a < 0.003 || p.w <= 0.0) ? 0.0 : size;
}`;
  const POINT_FS = `#version 300 es
precision highp float;
in vec3 vCol;
in float vA;
in float vSoft;
out vec4 o;
void main() {
  vec2 q = gl_PointCoord * 2.0 - 1.0;
  float r2 = dot(q, q);
  if (r2 > 1.0) discard;
  float f = vSoft > 0.5 ? exp(-r2 * 3.5) * (1.0 - r2) : exp(-r2 * 16.0) + 0.1 * exp(-r2 * 3.0) * (1.0 - r2);
  o = vec4(vCol * vA * f, 1.0);
}`;
  const SKY_VS = `#version 300 es
in vec2 p;
out vec2 vUv;
void main() { vUv = p; gl_Position = vec4(p, 0.0, 1.0); }`;
  const SKY_FS = `#version 300 es
precision highp float;
in vec2 vUv;
uniform vec3 uEye, uRight, uUp, uFwd;
uniform float uTanY, uAspect, uR, uAlpha;
uniform mat3 uToEq;
uniform sampler2D uTex;
out vec4 o;
const float PI = 3.14159265;
vec3 sky(vec3 v) {
  vec3 e = uToEq * normalize(v);
  float ra = atan(e.y, e.x);
  if (ra < 0.0) ra += 2.0 * PI;
  float dec = asin(clamp(e.z, -1.0, 1.0));
  return texture(uTex, vec2(ra / (2.0 * PI), 0.5 - dec / PI)).rgb;
}
void main() {
  vec3 d = normalize(uFwd + vUv.x * uTanY * uAspect * uRight + vUv.y * uTanY * uUp);
  float b = dot(uEye, d), c = dot(uEye, uEye) - uR * uR, h = b * b - c;
  if (h < 0.0) discard;
  float s = sqrt(h), t1 = -b - s, t2 = -b + s;
  vec3 col;
  if (c > 0.0) {
    if (t1 < 0.0) discard;
    // from outside: the far shell seen through the near one, like a glass globe
    col = sky(uEye + t2 * d) * 0.45 + sky(uEye + t1 * d) * 0.35;
    float rim = 1.0 - abs(dot(normalize(uEye + t1 * d), d));
    col += vec3(0.25, 0.3, 0.45) * pow(rim, 3.0);
  } else {
    col = sky(uEye + t2 * d) * 0.55;
  }
  o = vec4(col * uAlpha, 1.0);
}`;

  type Layer = { vao: WebGLVertexArrayObject; count: number; unit: number; floor: number; fade: () => number; gain: number; on: () => boolean; min: number; dust: boolean };
  let pointProg: Program | null = null, skyProg: Program | null = null;
  let skyVao: WebGLVertexArrayObject | null = null, skyTex: WebGLTexture | null = null, skyReady = false;
  const layers: Record<string, Layer> = {};
  let maxPoint = 256;

  if (gl) {
    pointProg = compile(gl, POINT_VS, POINT_FS, 'universe-atlas');
    skyProg = compile(gl, SKY_VS, SKY_FS, 'universe-atlas sky');
    maxPoint = (gl.getParameter(gl.ALIASED_POINT_SIZE_RANGE) as Float32Array)[1] || 256;
    if (skyProg) {
      skyVao = gl.createVertexArray();
      gl.bindVertexArray(skyVao);
      const b = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, b);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
      const loc = gl.getAttribLocation(skyProg.prog, 'p');
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
      gl.bindVertexArray(null);
      const img = new Image();
      img.onload = () => {
        skyTex = gl.createTexture();
        gl.bindTexture(gl.TEXTURE_2D, skyTex);
        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGB, gl.RGB, gl.UNSIGNED_BYTE, img);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.REPEAT);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
        skyReady = true;
        dirty = true;
      };
      img.src = CMB_URL;
    }
  }

  const ATTRS: [string, number][] = [['aPos', 3], ['aSize', 1], ['aLum', 1], ['aCol', 3]];
  function addLayer(key: string, data: Float32Array, unit: number, o: { floor?: number; fade?: () => number; gain?: number; min?: number; dust?: boolean; on: () => boolean }) {
    if (!gl || !pointProg) return;
    const va = vertexArray(gl, pointProg, data, ATTRS);
    layers[key] = { vao: va.vao, count: va.count, unit, floor: o.floor ?? 0, fade: o.fade ?? (() => 1), gain: o.gain ?? 1, on: o.on, min: o.min ?? 1.6, dust: !!o.dust };
    dirty = true;
  }
  /** 0 below `a` Mpc of view distance, 1 above `b`, smooth in log between. */
  const scaleFade = (a: number, b: number) => {
    const t = Math.log(state.r / (a * MPC)) / Math.log(b / a);
    const c = Math.max(0, Math.min(1, t));
    return c * c * (3 - 2 * c);
  };
  const lum = (M: number) => Math.pow(10, -0.4 * M);

  /** Values McConnachie's table leaves blank: M_V and half-light radius (pc). */
  const LG_FILL: Record<string, { M?: number; r?: number }> = {
    Andromeda: { M: -21.5, r: 5300 },
    Triangulum: { r: 1800 },
    LMC: { r: 2700 },
    SMC: { r: 1100 },
  };

  // --- catalogues -----------------------------------------------------------
  let stars: Catalogue | null = null, gals: Catalogue | null = null, qsos: Catalogue | null = null;
  let loaded = 0;
  const TOTAL = 6;
  const done = () => { loaded++; dirty = true; };

  {
    const mw: number[] = [], dust: number[] = [], others: number[] = [];
    milkyWay(mw, dust);
    for (const d of DISKS) diskGalaxy(d.spec, others);
    addLayer('mw', new Float32Array(mw), 1, { on: () => state.layers.mw, min: 1.2, gain: 1.4 });
    addLayer('dust', new Float32Array(dust), 1, { on: () => state.layers.mw, min: 1.2, dust: true });
    addLayer('disks', new Float32Array(others), 1, { on: () => state.layers.lg, min: 1.2, gain: 3 });
  }
  done();

  loadStars().then((c) => {
    stars = c;
    const d = new Float32Array((c.n + 1) * 8);
    // the Sun first, so it shines from outside like any other star
    d.set([0, 0, 0, 0, lum(4.83), ...starRGB(0.65)], 0);
    for (let i = 0; i < c.n; i++) {
      const o = i * c.stride;
      d.set([c.rows[o], c.rows[o + 1], c.rows[o + 2], 0, lum(c.rows[o + 3]), ...starRGB(c.rows[o + 4])], (i + 1) * 8);
    }
    addLayer('stars', d, 1, { on: () => state.layers.stars });
    done();
  });
  loadStarNames().then((list) => {
    // stars are named once their positions have arrived
    const wait = () => {
      if (!stars) return setTimeout(wait, 50);
      for (const s of list) {
        const o = s.i * stars.stride;
        const p: V3 = [stars.rows[o], stars.rows[o + 1], stars.rows[o + 2]];
        add({ name: s.n, kind: 'star', pos: () => p, size: 0.05, M: stars.rows[o + 3], info: `${s.s || 'star'}, ${fmtDist(s.d)} away, magnitude ${s.m} from Earth`, colour: '#ffe2b0' });
      }
      fillSearch();
      done();
    };
    wait();
  });
  loadLocalGroup().then((list) => {
    const d: number[] = [];
    for (const g of list) {
      const p = v3.mul(g.p, MPC);
      const fill = LG_FILL[g.n] ?? {};
      const M = g.M ?? fill.M ?? -8;
      const hl = g.r ?? fill.r;
      const R = hl ? hl * 2.5 : 400;
      const name = NICK[g.n] ?? g.n;
      const info = `${g.t || 'galaxy'} in the Local Group, ${fmtDist(g.d * 1000)} away`;
      if (DISKS.some((d) => d.name === g.n)) {
        add({ name, kind: 'lg', pos: () => p, size: Math.max(R * 4, 3000), M, info });
        continue;
      }
      const spiral = /^S/.test(g.t) || g.n === 'LMC';
      d.push(...p, R, lum(M), ...(spiral ? [0.85, 0.88, 1.0] : /Irr/.test(g.t) ? [0.7, 0.8, 1.0] : [1.0, 0.88, 0.7]));
      add({ name, kind: 'lg', pos: () => p, size: Math.max(R * 4, 3000), M, info });
    }
    for (const [, ra, dec, dm, Mv] of CLOSE) d.push(...radec(ra, dec, dm * MPC), 12000, lum(Mv), 0.85, 0.88, 1.0);
    addLayer('lg', new Float32Array(d), 1, { on: () => state.layers.lg, floor: 0.04 });
    fillSearch();
    done();
  });
  loadGalaxies().then((c) => {
    gals = c;
    const d = new Float32Array(c.n * 8);
    for (let i = 0; i < c.n; i++) {
      const o = i * c.stride, MK = c.rows[o + 3], early = c.rows[o + 4] > 0.5;
      const R = 0.011 * Math.pow(10, -0.2 * (MK + 24)) * (early ? 0.7 : 1);
      d.set([c.rows[o], c.rows[o + 1], c.rows[o + 2], R, lum(MK + 3), ...(early ? [1.0, 0.82, 0.62] : [0.62, 0.76, 1.0])], i * 8);
    }
    addLayer('gal', d, MPC, { on: () => state.layers.gal, floor: 0.45 });
    loadGalaxyNames().then((list) => {
      for (const g of list) {
        const o = g.i * c.stride;
        const p: V3 = [c.rows[o] * MPC, c.rows[o + 1] * MPC, c.rows[o + 2] * MPC];
        add({ name: NICK[g.n] ?? g.n, kind: 'galaxy', pos: () => p, size: 40000, M: c.rows[o + 3] + 3, z: g.z, info: `galaxy at redshift z = ${g.z}` });
      }
      fillSearch();
      done();
    });
  });
  loadQuasars().then((c) => {
    qsos = c;
    const d = new Float32Array(c.n * 8);
    let far = 0;
    for (let i = 0; i < c.n; i++) {
      const o = i * c.stride, z = c.rows[o + 3];
      // the colour runs from white nearby to deep red at the far end
      const f = Math.min(1, z / 4);
      d.set([c.rows[o], c.rows[o + 1], c.rows[o + 2], 0, 0, 1.0, 0.85 - 0.55 * f, 0.9 - 0.65 * f], i * 8);
      if (z > c.rows[far * c.stride + 3]) far = i;
    }
    addLayer('qso', d, MPC, { on: () => state.layers.qso, floor: 0.5, fade: () => scaleFade(20, 200), min: 1.4 });
    const o = far * c.stride, zf = c.rows[o + 3];
    const p: V3 = [c.rows[o] * MPC, c.rows[o + 1] * MPC, c.rows[o + 2] * MPC];
    add({ name: 'Most distant quasar in the sample', kind: 'quasar', pos: () => p, size: 300 * MPC, z: zf, info: `SDSS quasar at z = ${zf.toFixed(2)}` });
    fillSearch();
    done();
  });

  loadWeb().then((c) => {
    const d = new Float32Array(c.n * 8);
    for (let i = 0; i < c.n; i++) {
      const o = i * 4, M = c.rows[o + 3];
      // size from luminosity; bright galaxies a little warmer in colour
      const R = 0.011 * Math.pow(10, -0.2 * (M + 21.5));
      const warm = Math.min(1, Math.max(0, (-M - 20) / 3));
      d.set([c.rows[o], c.rows[o + 1], c.rows[o + 2], R, lum(M + 0.3), 0.7 + 0.3 * warm, 0.78 + 0.05 * warm, 1.0 - 0.3 * warm], i * 8);
    }
    // The floor keeps faint survey galaxies visible as structure, which only
    // makes sense once the view is wide enough to hold some of it: from inside
    // the Milky Way the survey stripes would otherwise paint the sky.
    addLayer('web', d, MPC, { on: () => state.layers.web, floor: 0.32, fade: () => scaleFade(0.5, 5), min: 1.4 });
    done();
  });

  // =====================================================================
  //  Camera
  // =====================================================================
  const R_MIN = 3e-9, R_MAX = 1.6e11;

  function eyeNow() {
    view.orbit(state.centre, state.r, state.yaw, state.pitch);
    return view.eye;
  }

  /**
   * Fly to `to`, ending `r1` from it, along van Wijk and Nuij's optimal path
   * for zooming and panning together: zoom out until both ends fit, cross,
   * zoom in. The trip takes time in proportion to its length on that path.
   */
  function flyTo(to: Obj, r1 = frameDist(to)) {
    const P0 = state.centre, P1 = to.pos();
    const w0 = state.r, w1 = Math.max(R_MIN, Math.min(R_MAX, r1));
    const u1 = v3.len(v3.sub(P1, P0));
    const rho = 1.4;
    let path: (s: number) => { u: number; w: number }, S: number;
    if (u1 < 1e-6 * Math.min(w0, w1)) {
      const k = Math.log(w1 / w0) / rho;
      S = Math.abs(k);
      path = (s) => ({ u: 0, w: w0 * Math.exp(Math.sign(k) * rho * s) });
    } else {
      const b0 = (w1 * w1 - w0 * w0 + rho ** 4 * u1 * u1) / (2 * w0 * rho * rho * u1);
      const b1 = (w1 * w1 - w0 * w0 - rho ** 4 * u1 * u1) / (2 * w1 * rho * rho * u1);
      const r0 = -Math.asinh(b0), r1b = -Math.asinh(b1);
      S = (r1b - r0) / rho;
      const ch = Math.cosh(r0), sh = Math.sinh(r0);
      path = (s) => ({ u: (w0 / (rho * rho)) * (ch * Math.tanh(rho * s + r0) - sh), w: (w0 * ch) / Math.cosh(rho * s + r0) });
    }
    state.target = to;
    state.fly = { t0: performance.now(), dur: Math.max(900, Math.min(7000, S * 380)), path, S, P0, P1, u1, to };
    dirty = true;
  }

  function frameDist(o: Obj) {
    if (o.kind === 'edge') return R_CMB * 2.8;
    if (o.kind === 'planet' || o.kind === 'probe') return o.size;
    return o.size * 3;
  }

  function stepFly(now: number) {
    const f = state.fly;
    if (!f) return;
    const t = Math.min(1, (now - f.t0) / f.dur);
    const e = t * t * (3 - 2 * t);
    const { u, w } = f.path(e * f.S);
    const P1 = f.to.pos();
    state.centre = f.u1 > 0 ? v3.mix(f.P0, P1, Math.min(1, u / f.u1)) : P1;
    state.r = w;
    if (t >= 1) {
      state.centre = P1;
      state.fly = null;
    }
    dirty = true;
  }

  // =====================================================================
  //  Drawing
  // =====================================================================
  function drawGL() {
    if (!gl || !pointProg) return;
    const dpr = fitCanvas(glc, W, H);
    gl.viewport(0, 0, glc.width, glc.height);
    gl.clearColor(0.004, 0.006, 0.014, 1);
    gl.clear(gl.COLOR_BUFFER_BIT);
    gl.enable(gl.BLEND);
    gl.blendFunc(gl.ONE, gl.ONE);
    const eye = view.eye;

    // the microwave background first, everything else glows over it
    const eyeR = v3.len(eye);
    const cmbA = state.layers.cmb ? Math.min(1, Math.max(0, (Math.log10(eyeR) - Math.log10(1.5e9)) / (Math.log10(1e10) - Math.log10(1.5e9)))) : 0;
    if (skyProg && skyReady && cmbA > 0.01) {
      gl.useProgram(skyProg.prog);
      gl.bindVertexArray(skyVao);
      const e = v3.mul(eye, 1 / MPC);
      gl.uniform3f(skyProg.u('uEye'), e[0], e[1], e[2]);
      gl.uniform3f(skyProg.u('uRight'), ...view.right);
      gl.uniform3f(skyProg.u('uUp'), ...view.up);
      gl.uniform3f(skyProg.u('uFwd'), ...view.fwd);
      gl.uniform1f(skyProg.u('uTanY'), view.tanY);
      gl.uniform1f(skyProg.u('uAspect'), view.aspect);
      gl.uniform1f(skyProg.u('uR'), R_CMB / MPC);
      gl.uniform1f(skyProg.u('uAlpha'), cmbA);
      gl.uniformMatrix3fv(skyProg.u('uToEq'), false, EQ_TO_GAL.flat());
      gl.activeTexture(gl.TEXTURE0);
      gl.bindTexture(gl.TEXTURE_2D, skyTex);
      gl.uniform1i(skyProg.u('uTex'), 0);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    }

    gl.useProgram(pointProg.prog);
    const expo = Math.pow(10, 0.4 * state.lim);
    for (const key of ['mw', 'dust', 'disks', 'qso', 'web', 'gal', 'lg', 'stars']) {
      const L = layers[key];
      if (!L || !L.on()) continue;
      // dust multiplies what is already drawn by (1 − its colour)
      if (L.dust) gl.blendFunc(gl.ZERO, gl.ONE_MINUS_SRC_COLOR);
      else gl.blendFunc(gl.ONE, gl.ONE);
      gl.uniform1i(pointProg.u('uDust'), L.dust ? 1 : 0);
      setView(gl, pointProg, view, v3.mul(eye, 1 / L.unit));
      gl.uniform1f(pointProg.u('uUnit'), L.unit);
      gl.uniform1f(pointProg.u('uExpo'), expo);
      gl.uniform1f(pointProg.u('uMin'), L.min);
      gl.uniform1f(pointProg.u('uMax'), Math.min(maxPoint / dpr, 260));
      gl.uniform1f(pointProg.u('uDpr'), dpr);
      // survey points keep a floor so the structure stays visible however far away
      gl.uniform1f(pointProg.u('uFloor'), L.floor * L.fade());
      gl.uniform1f(pointProg.u('uGain'), L.gain);
      gl.bindVertexArray(L.vao);
      gl.drawArrays(gl.POINTS, 0, L.count);
    }
    gl.bindVertexArray(null);
  }

  type Placed = { x: number; y: number; w: number; h: number };
  let labelSpots: { o: Obj; x: number; y: number }[] = [];

  /**
   * How much a label deserves the space, or null to hide it. Most kinds only
   * label what lies within reach of the scale you are looking at, so the
   * planets are not buried under the names of galaxies behind them.
   */
  function labelScore(o: Obj, d: number, eyeFromSun: number): number | null {
    const reach = state.r * 150;
    switch (o.kind) {
      case 'sun':
        // near home, and again once the whole galaxy is a dot, as a marker for 'here'
        return eyeFromSun < 30000 || eyeFromSun > 2.5e7 ? 1000 : null;
      case 'planet':
      case 'probe':
        return eyeFromSun < 0.02 ? 900 - (o.kind === 'probe' ? 50 : 0) : null;
      case 'star': {
        const m = (o.M ?? 5) + 5 * Math.log10(Math.max(d, 1e-6) / 10);
        // the brightest stay as landmarks on the sky
        if (m < 1.2 && eyeFromSun < 50) return 520 - m * 10;
        return d < reach * 3 && m < Math.min(state.lim, 6.5) - 1 && eyeFromSun < 5000 ? 500 - m * 10 : null;
      }
      case 'arm':
        return d > 9000 && d < 150000 ? 640 : null;
      case 'mw':
        if (o === MW) return d > 40000 && d < 2.5e7 ? 700 : null;
        return d > 2500 && d < 25000 ? 650 : null;
      case 'lg': {
        const m = (o.M ?? -10) + 5 * Math.log10(d / 10);
        return d < reach && d < 1.5e7 && m < state.lim + 4 ? 400 - m * 5 : null;
      }
      case 'galaxy':
        return d < reach && d < 1.2e8 && d > 2e5 ? 200 - (o.M ?? -20) - Math.log10(d) * 20 : null;
      case 'structure':
        return d > o.size * 1.5 && d < reach && d < 2.5e9 ? 300 - Math.log10(o.size) : null;
      case 'quasar':
        return eyeFromSun > 3e9 && d < 6e10 ? 120 : null;
      case 'edge':
        return null;
    }
  }

  function drawOverlay() {
    ctx.clearRect(0, 0, W, H);
    const eye = view.eye;
    const eyeR = v3.len(eye);
    const placed: Placed[] = [];
    labelSpots = [];
    const free = (b: Placed) => !placed.some((p) => b.x < p.x + p.w && b.x + b.w > p.x && b.y < p.y + p.h && b.y + b.h > p.y);

    // --- rings of equal distance from the Sun, in the galactic plane -------
    if (state.layers.rings) {
      // powers of ten: in AU inside the Solar System, light-years beyond
      const radii: number[] = [];
      for (let k = 0; k <= 4; k++) radii.push(10 ** k / AU_PER_PC);
      for (let k = 0; k <= 11; k++) radii.push(10 ** k / LY_PER_PC);
      ctx.font = '11px ui-sans-serif, system-ui, sans-serif';
      for (const rpc of radii) {
        const pix = view.pxPer(Math.max(eyeR, rpc)) * rpc;
        if (pix < 60 || rpc > eyeR * 3 || rpc < eyeR / 40) continue;
        ringPath(rpc);
        ctx.strokeStyle = 'rgba(94,234,212,0.22)';
        ctx.lineWidth = 1;
        ctx.stroke();
        const lp = view.project([rpc * Math.cos(state.yaw + 0.5), rpc * Math.sin(state.yaw + 0.5), 0], W, H);
        if (lp && lp.x > 10 && lp.x < W - 60 && lp.y > 10 && lp.y < H - 10) {
          ctx.fillStyle = 'rgba(94,234,212,0.7)';
          ctx.fillText(fmtDist(rpc), lp.x + 4, lp.y - 4);
        }
      }
      // the edge of what we can see
      if (eyeR > 2e8) {
        ringPath(R_EDGE);
        ctx.strokeStyle = 'rgba(245,194,107,0.5)';
        ctx.setLineDash([5, 5]);
        ctx.stroke();
        ctx.setLineDash([]);
        const lp = view.project([R_EDGE * Math.cos(state.yaw + 0.9), R_EDGE * Math.sin(state.yaw + 0.9), 0], W, H);
        if (lp) {
          ctx.fillStyle = 'rgba(245,194,107,0.85)';
          ctx.fillText(`edge of the observable universe, ${fmtDist(R_EDGE)}`, lp.x + 6, lp.y - 6);
        }
      }
    }

    // --- planets ---------------------------------------------------------
    const near = eyeR < 0.02;
    if (state.layers.planets && near) {
      for (const p of PLANETS) {
        ctx.beginPath();
        for (let i = 0; i <= 160; i++) {
          const q = view.project(eclToGal(kepler(p, state.jd, (i / 160) * 360 - 180)), W, H);
          if (!q) continue;
          if (i === 0) ctx.moveTo(q.x, q.y); else ctx.lineTo(q.x, q.y);
        }
        ctx.strokeStyle = 'rgba(160,175,210,0.28)';
        ctx.lineWidth = 1;
        ctx.stroke();
      }
      for (const p of PLANETS) {
        const pos = planetPos.get(p.n)!;
        const q = view.project(pos, W, H);
        if (!q) continue;
        const rad = Math.max(2.4, (p.r / KM_PER_AU / AU_PER_PC) * view.pxPer(q.z));
        ctx.beginPath();
        ctx.arc(q.x, q.y, rad, 0, 2 * Math.PI);
        ctx.fillStyle = p.c;
        ctx.fill();
      }
    }
    // the Sun's disk, once it is more than a point
    {
      const q = view.project([0, 0, 0], W, H);
      if (q) {
        const rad = (696000 / KM_PER_AU / AU_PER_PC) * view.pxPer(q.z);
        if (rad > 1.2) {
          const g = ctx.createRadialGradient(q.x, q.y, 0, q.x, q.y, rad * 3);
          g.addColorStop(0, 'rgba(255,240,200,1)');
          g.addColorStop(0.33, 'rgba(255,214,140,0.9)');
          g.addColorStop(1, 'rgba(255,180,90,0)');
          ctx.fillStyle = g;
          ctx.beginPath();
          ctx.arc(q.x, q.y, rad * 3, 0, 2 * Math.PI);
          ctx.fill();
        }
      }
    }

    // --- labels ----------------------------------------------------------
    if (state.layers.labels) {
      const cand: { o: Obj; x: number; y: number; s: number }[] = [];
      for (const o of objects) {
        if (!layerOn(o)) continue;
        const p = o.pos();
        const d = v3.len(v3.sub(p, eye));
        const s = labelScore(o, d, eyeR);
        if (s == null) continue;
        const q = view.project(p, W, H);
        if (!q || q.x < -20 || q.x > W + 20 || q.y < -20 || q.y > H + 20) continue;
        cand.push({ o, x: q.x, y: q.y, s });
      }
      cand.sort((a, b) => b.s - a.s);
      let shown = 0;
      for (const c of cand) {
        if (shown > 40) break;
        if (c.o === state.target) continue;
        const big = c.o.kind === 'structure' || c.o === MW;
        ctx.font = big ? '600 12px ui-sans-serif, system-ui, sans-serif' : '11px ui-sans-serif, system-ui, sans-serif';
        const w = ctx.measureText(c.o.name).width;
        const box = { x: c.x + 6, y: c.y - 14, w: w + 4, h: 15 };
        if (!free(box)) continue;
        placed.push(box);
        ctx.fillStyle = labelColour(c.o);
        ctx.fillText(c.o.name, c.x + 7, c.y - 3);
        if (!big) {
          ctx.beginPath();
          ctx.arc(c.x, c.y, 1.6, 0, 2 * Math.PI);
          ctx.fill();
        }
        labelSpots.push({ o: c.o, x: c.x, y: c.y });
        shown++;
      }
    }

    // --- the target ------------------------------------------------------
    if (state.target && state.target.kind !== 'edge') {
      const q = view.project(state.target.pos(), W, H);
      if (q) {
        ctx.strokeStyle = GOLD;
        ctx.lineWidth = 1.4;
        const s = 9;
        ctx.beginPath();
        for (const [dx, dy] of [[-1, -1], [1, -1], [1, 1], [-1, 1]]) {
          ctx.moveTo(q.x + dx * s, q.y + dy * (s - 4));
          ctx.lineTo(q.x + dx * s, q.y + dy * s);
          ctx.lineTo(q.x + dx * (s - 4), q.y + dy * s);
        }
        ctx.stroke();
        ctx.font = '600 12px ui-sans-serif, system-ui, sans-serif';
        ctx.fillStyle = GOLD;
        ctx.fillText(state.target.name, q.x + s + 5, q.y + 4);
        labelSpots.push({ o: state.target, x: q.x, y: q.y });
      }
    }

    // --- the bar at the bottom -------------------------------------------
    ctx.font = '12px ui-sans-serif, system-ui, sans-serif';
    ctx.fillStyle = 'rgba(232,233,236,0.75)';
    const span = 2 * state.r * view.tanY * view.aspect;
    ctx.fillText(`view ${fmtDist(span)} across`, 14, H - 14);
    if (loaded < TOTAL) {
      ctx.fillStyle = 'rgba(232,233,236,0.85)';
      ctx.fillText(`Loading catalogues… ${loaded}/${TOTAL}`, 14, 24);
    }
  }

  function ringPath(rpc: number) {
    ctx.beginPath();
    let pen = false;
    for (let i = 0; i <= 180; i++) {
      const a = (i / 180) * 2 * Math.PI;
      const q = view.project([rpc * Math.cos(a), rpc * Math.sin(a), 0], W, H);
      if (!q) { pen = false; continue; }
      if (!pen) ctx.moveTo(q.x, q.y); else ctx.lineTo(q.x, q.y);
      pen = true;
    }
  }

  function layerOn(o: Obj) {
    const L = state.layers;
    switch (o.kind) {
      case 'planet': case 'probe': return L.planets;
      case 'star': return L.stars;
      case 'mw': case 'arm': return L.mw;
      case 'lg': return L.lg;
      case 'galaxy': return L.gal;
      case 'quasar': return L.qso;
      default: return true;
    }
  }

  function labelColour(o: Obj) {
    switch (o.kind) {
      case 'planet': case 'probe': return o.colour ?? '#e8e9ec';
      case 'star': case 'sun': return 'rgba(255,226,176,0.9)';
      case 'mw': case 'arm': return 'rgba(201,184,255,0.95)';
      case 'lg': case 'galaxy': return 'rgba(156,196,255,0.9)';
      case 'structure': return 'rgba(232,233,236,0.8)';
      case 'quasar': return 'rgba(255,122,138,0.95)';
      default: return '#e8e9ec';
    }
  }

  // =====================================================================
  //  Numbers
  // =====================================================================
  const fmt = (v: number, n = 2) => v.toFixed(n);
  function updateText() {
    const t = state.target ?? SUN;
    const p = t.pos();
    const earth = planetPos.get('Earth') ?? [0, 0, 0];
    const dEarth = t.kind === 'edge' ? R_CMB : v3.len(v3.sub(p, earth));
    const dEye = v3.len(v3.sub(p, view.eye));
    const eyeR = v3.len(view.eye);
    const mFromEye = t.M != null ? t.M + 5 * Math.log10(Math.max(dEye, 1e-9) / 10) : null;
    const date = new Date((state.jd - 2440587.5) * 86400000);

    // light-travel time: with expansion it is the lookback time, not distance / c
    let light = fmtLightTime(dEarth) + ' ago';
    if (t.z != null && t.z > 0.01) light = `${lookback(t.z)} ago`;
    setRows({
      'r-target': t === SUN ? '1 AU (Earth)' : fmtDist(dEarth),
      'r-light': t.kind === 'edge' ? '13.8 billion years ago' : light,
      'r-eye': fmtDist(eyeR),
      'r-view': fmtDist(2 * state.r * view.tanY * view.aspect),
      'r-mag': mFromEye != null ? fmt(mFromEye, 1) + (mFromEye < 6 ? '  (naked eye)' : '') : '—',
      'r-date': date.toISOString().slice(0, 10),
    });
    drawHud(t, t === SUN ? 'home' : fmtDist(dEarth), t.kind === 'edge' ? '13.8 billion years ago' : light);
  }

  /** The target's card in the top-left corner, and the flying hint in the bottom-right. */
  function drawHud(t: Obj, dist: string, light: string) {
    const x = 16;
    let y = 26;
    ctx.textBaseline = 'alphabetic';
    ctx.shadowColor = 'rgba(0,0,0,0.8)';
    ctx.shadowBlur = 4;
    ctx.font = '600 17px ui-sans-serif, system-ui, sans-serif';
    ctx.fillStyle = state.target ? GOLD : 'rgba(232,233,236,0.85)';
    ctx.fillText(state.target ? t.name : 'Free flight', x, y);
    ctx.font = '12.5px ui-sans-serif, system-ui, sans-serif';
    ctx.fillStyle = 'rgba(232,233,236,0.85)';
    if (state.target) {
      y += 19;
      ctx.fillText(t.info, x, y);
      y += 17;
      ctx.fillText(t === SUN ? 'Our star: its light takes 8.3 minutes to reach Earth' : `${dist} from Earth, its light left ${light}`, x, y);
    } else {
      y += 19;
      ctx.fillText(`${fmtDist(v3.len(view.eye))} from the Sun`, x, y);
    }
    ctx.font = '11.5px ui-sans-serif, system-ui, sans-serif';
    ctx.fillStyle = 'rgba(232,233,236,0.55)';
    ctx.textAlign = 'right';
    ctx.fillText(state.camMode === 'orbit' ? 'drag: turn · right-drag: slide · scroll: zoom · WASD QE: fly · double-click: go' : 'drag: look · WASD QE: fly (Shift faster) · scroll: speed · double-click: go', W - 14, H - 14);
    ctx.textAlign = 'left';
    ctx.shadowBlur = 0;
  }

  /** Lookback time to redshift z under Planck 2018. */
  function lookback(z: number) {
    const H0 = PLANCK18.H0, tH = 977.792 / H0;
    const n = 400;
    let s = 0;
    for (let i = 0; i < n; i++) {
      const zz = ((i + 0.5) / n) * z;
      s += 1 / ((1 + zz) * Math.sqrt(PLANCK18.Om * (1 + zz) ** 3 + PLANCK18.Or * (1 + zz) ** 4 + PLANCK18.OL));
    }
    const gyr = (tH * s * z) / n;
    return gyr < 1 ? `${Math.round(gyr * 1000)} million years` : `${gyr.toFixed(2)} billion years`;
  }

  // =====================================================================
  //  Loop
  // =====================================================================
  let last = performance.now();
  function frame(now: number) {
    const dt = Math.min(0.1, (now - last) / 1000);
    last = now;
    if (state.running) {
      state.jd += dt * 20; // twenty days a second
      state.yaw += dt * 0.04;
      dirty = true;
    }
    if (state.keys.size) { flyKeys(dt); dirty = true; }
    if (state.fly) stepFly(now);
    else if (state.target) {
      // follow a moving target, a planet say
      const p = state.target.pos();
      if (v3.len(v3.sub(p, state.centre)) > 0) { state.centre = p; }
    }
    if (dirty) {
      for (const p of PLANETS) planetPos.set(p.n, eclToGal(kepler(p, state.jd)));
      eyeNow();
      drawGL();
      drawOverlay();
      updateText();
      dirty = false;
    }
    requestAnimationFrame(frame);
  }
  for (const p of PLANETS) planetPos.set(p.n, eclToGal(kepler(p, state.jd)));
  state.target = SUN;
  requestAnimationFrame(frame);

  // =====================================================================
  //  Pointer: orbit, zoom, pick
  // =====================================================================
  const pointers = new Map<number, { x: number; y: number }>();
  let downAt = { x: 0, y: 0, t: 0 }, moved = false, pinch0 = 0, r0 = 0;
  const local = (e: PointerEvent | MouseEvent) => {
    const b = canvas.getBoundingClientRect();
    return { x: ((e.clientX - b.left) / b.width) * W, y: ((e.clientY - b.top) / b.height) * H };
  };
  let panning = false;
  canvas.addEventListener('contextmenu', (e) => e.preventDefault());
  canvas.addEventListener('pointerdown', (e) => {
    canvas.setPointerCapture(e.pointerId);
    panning = e.button === 2 || e.shiftKey;
    pointers.set(e.pointerId, local(e));
    downAt = { ...local(e), t: performance.now() };
    moved = false;
    if (pointers.size === 2) {
      const [a, b] = [...pointers.values()];
      pinch0 = Math.hypot(a.x - b.x, a.y - b.y);
      r0 = state.r;
    }
  });
  canvas.addEventListener('pointermove', (e) => {
    const prev = pointers.get(e.pointerId);
    if (!prev) return;
    const p = local(e);
    pointers.set(e.pointerId, p);
    if (Math.hypot(p.x - downAt.x, p.y - downAt.y) > 4) moved = true;
    if (pointers.size === 2) {
      const [a, b] = [...pointers.values()];
      const d = Math.hypot(a.x - b.x, a.y - b.y);
      if (pinch0 > 0) zoomTo(r0 * (pinch0 / Math.max(d, 1)));
      // two fingers also slide, by the motion of their midpoint
      const k = (2 * state.r * view.tanY) / H / 2;
      state.centre = v3.add(state.centre, v3.add(v3.mul(view.right, -(p.x - prev.x) * k), v3.mul(view.up, (p.y - prev.y) * k)));
      state.target = null;
      return;
    }
    const dx = p.x - prev.x, dy = p.y - prev.y;
    if (panning) {
      // slide the view sideways: the point under the pointer stays under it
      const k = (2 * state.r * view.tanY) / H;
      state.fly = null;
      state.target = null;
      state.centre = v3.add(state.centre, v3.add(v3.mul(view.right, -dx * k), v3.mul(view.up, dy * k)));
    } else if (state.camMode === 'look') {
      // turn the head: the eye stays put and the centre swings round it
      const eye = view.eye;
      state.fly = null;
      state.target = null;
      state.yaw += dx * 0.004;
      state.pitch = Math.max(-1.55, Math.min(1.55, state.pitch - dy * 0.004));
      const cp = Math.cos(state.pitch);
      state.centre = v3.sub(eye, v3.mul([cp * Math.cos(state.yaw), cp * Math.sin(state.yaw), Math.sin(state.pitch)], state.r));
    } else {
      state.yaw -= dx * 0.006;
      state.pitch = Math.max(-1.55, Math.min(1.55, state.pitch + dy * 0.006));
    }
    dirty = true;
  });
  const up = (e: PointerEvent) => {
    pointers.delete(e.pointerId);
    if (pointers.size < 2) pinch0 = 0;
  };
  canvas.addEventListener('pointerup', (e) => {
    const was = pointers.has(e.pointerId) && pointers.size === 1;
    up(e);
    if (was && !moved) {
      const hit = pick(local(e));
      if (hit) {
        state.target = hit;
        dirty = true;
      }
    }
  });
  canvas.addEventListener('pointercancel', up);
  canvas.addEventListener('dblclick', (e) => {
    const hit = pick(local(e));
    if (hit) flyTo(hit);
  });
  canvas.addEventListener(
    'wheel',
    (e) => {
      e.preventDefault();
      const k = Math.exp(e.deltaY * (e.deltaMode === 1 ? 0.05 : 0.0016));
      if (state.camMode === 'look') {
        // in flight the wheel sets the scale you move at, and the eye stays where it is
        const eye = view.eye;
        state.r = Math.max(R_MIN, Math.min(R_MAX, state.r * k));
        state.centre = v3.add(eye, v3.mul(view.fwd, state.r));
        state.target = null;
        state.fly = null;
        dirty = true;
      } else zoomTo(state.r * k);
    },
    { passive: false }
  );

  /**
   * Keyboard flight. Speed follows the scale in view (the orbit distance r),
   * so the same keys cross the Solar System or a supercluster in a few seconds.
   */
  const FLY_KEYS: Record<string, [number, number, number]> = {
    w: [1, 0, 0], arrowup: [1, 0, 0], s: [-1, 0, 0], arrowdown: [-1, 0, 0],
    a: [0, -1, 0], arrowleft: [0, -1, 0], d: [0, 1, 0], arrowright: [0, 1, 0],
    e: [0, 0, 1], q: [0, 0, -1],
  };
  function flyKeys(dt: number) {
    let f = 0, r = 0, u = 0;
    for (const k of state.keys) {
      const m = FLY_KEYS[k];
      if (m) { f += m[0]; r += m[1]; u += m[2]; }
    }
    if (!f && !r && !u) return;
    const speed = state.r * 0.9 * (state.keys.has('shift') ? 4 : 1);
    const step = v3.add(v3.add(v3.mul(view.fwd, f), v3.mul(view.right, r)), v3.mul(view.up, u));
    state.centre = v3.add(state.centre, v3.mul(step, speed * dt));
    state.fly = null;
    state.target = null;
  }
  const typing = (e: KeyboardEvent) => {
    const t = e.target as HTMLElement | null;
    return !!t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable);
  };
  document.addEventListener('keydown', (e) => {
    if (typing(e) || e.ctrlKey || e.metaKey || e.altKey) return;
    const k = e.key.toLowerCase();
    if (k in FLY_KEYS || k === 'shift') {
      // only while the stage is on screen, so the arrows still scroll the page elsewhere
      const b = wrap.getBoundingClientRect();
      if (b.bottom < 0 || b.top > window.innerHeight) return;
      if (k.startsWith('arrow')) e.preventDefault();
      state.keys.add(k);
    }
  });
  document.addEventListener('keyup', (e) => { state.keys.delete(e.key.toLowerCase()); });
  window.addEventListener('blur', () => state.keys.clear());

  function zoomTo(r: number) {
    state.fly = null;
    const floor = state.target?.kind === 'planet' ? state.target.size / 20 : R_MIN;
    state.r = Math.max(floor, Math.min(R_MAX, r));
    dirty = true;
  }

  /** The labelled object nearest the pointer, else the nearest bright star or galaxy. */
  function pick(m: { x: number; y: number }): Obj | null {
    let best: Obj | null = null, bd = 14;
    for (const s of labelSpots) {
      const d = Math.hypot(s.x - m.x, s.y - m.y);
      if (d < bd) { bd = d; best = s.o; }
    }
    if (best) return best;
    bd = 8;
    const eye = view.eye;
    const tryCat = (c: Catalogue | null, unit: number, make: (i: number, p: V3) => Obj, bright: (i: number, d: number) => boolean) => {
      if (!c) return;
      for (let i = 0; i < c.n; i++) {
        const o = i * c.stride;
        const p: V3 = [c.rows[o] * unit, c.rows[o + 1] * unit, c.rows[o + 2] * unit];
        const q = view.project(p, W, H);
        if (!q) continue;
        const d = Math.hypot(q.x - m.x, q.y - m.y);
        if (d < bd && bright(i, v3.len(v3.sub(p, eye)))) { bd = d; best = make(i, p); }
      }
    };
    if (state.layers.stars)
      tryCat(stars, 1, (i, p) => {
        const c = stars!, M = c.rows[i * c.stride + 3];
        const d = v3.len(p);
        return { name: 'Unnamed star', kind: 'star', pos: () => p, size: 0.05, M, info: `HYG star, ${fmtDist(d)} from the Sun, absolute magnitude ${M.toFixed(1)}` };
      }, (i, d) => stars!.rows[i * stars!.stride + 3] + 5 * Math.log10(d / 10) < state.lim);
    if (state.layers.gal && !best)
      tryCat(gals, MPC, (i, p) => {
        const d = v3.len(p);
        return { name: '2MRS galaxy', kind: 'galaxy', pos: () => p, size: 40000, M: gals!.rows[i * gals!.stride + 3] + 3, z: undefined, info: `galaxy ${fmtDist(d)} away (from its redshift)` };
      }, () => true);
    if (state.layers.qso && !best)
      tryCat(qsos, MPC, (i, p) => {
        const z = qsos!.rows[i * qsos!.stride + 3];
        return { name: `Quasar, z = ${z.toFixed(2)}`, kind: 'quasar', pos: () => p, size: 200 * MPC, z, info: 'a galaxy whose central black hole outshines it' };
      }, () => true);
    return best;
  }

  // =====================================================================
  //  Panel
  // =====================================================================
  const PRESETS: Record<string, () => void> = {
    solar: () => { state.pitch = 0.45; flyTo(SUN, 45 / AU_PER_PC); },
    stars: () => { state.pitch = 0.35; flyTo(SUN, 14 / LY_PER_PC); },
    hood: () => { state.pitch = 0.3; flyTo(SUN, 1500 / LY_PER_PC); },
    mw: () => { state.pitch = 0.75; flyTo(MW, 36000); },
    lg: () => {
      const m31 = byName.get('andromeda galaxy (m31)');
      const mid = m31 ? v3.mul(m31.pos(), 0.4) : [0, 0, 0] as V3;
      state.pitch = 0.5;
      flyTo({ name: 'Local Group', kind: 'structure', pos: () => mid, size: 1e6, info: 'the Milky Way, Andromeda, Triangulum and about a hundred dwarf galaxies' }, 2.6e6);
    },
    web: () => { state.pitch = 0.6; flyTo(SUN, 420 * MPC); },
    obs: () => { state.pitch = 0.25; flyTo(EDGE, R_CMB * 2.8); },
  };
  const scaleSeg = segmented('scale', (v) => PRESETS[v]?.());

  const runCtl = transport({
    onRun: (on) => { state.running = on; },
    onReset: () => {
      state.jd = 2440587.5 + Date.now() / 86400000;
      state.yaw = -2.1;
      state.pitch = 0.42;
      state.fly = null;
      state.centre = [0, 0, 0];
      state.r = 45 / AU_PER_PC;
      state.target = SUN;
      scaleSeg.clear();
      dirty = true;
    },
  });
  void runCtl;
  slider('lim', (v) => { state.lim = v; dirty = true; }, (v) => v.toFixed(1));
  const LAYER_IDS: [keyof typeof state.layers, string][] = [
    ['planets', 'l-planets'], ['stars', 'l-stars'], ['mw', 'l-mw'], ['lg', 'l-lg'], ['gal', 'l-gal'],
    ['qso', 'l-qso'], ['web', 'l-web'], ['cmb', 'l-cmb'], ['labels', 'l-labels'], ['rings', 'l-rings'],
  ];
  for (const [k, id] of LAYER_IDS) check(id, (on) => { state.layers[k] = on; dirty = true; });

  const find = el('find') as HTMLInputElement;
  const list = el('find-list');
  function fillSearch() {
    const names = objects.map((o) => o.name).sort((a, b) => a.localeCompare(b));
    list.innerHTML = names.map((n) => `<option value="${n.replace(/"/g, '&quot;')}"></option>`).join('');
  }
  const go = () => {
    const q = find.value.trim().toLowerCase();
    if (!q) return;
    const o = byName.get(q) ?? objects.find((x) => x.name.toLowerCase().includes(q));
    if (o) {
      scaleSeg.clear();
      flyTo(o);
      find.blur();
    }
  };
  find.addEventListener('change', go);
  find.addEventListener('keydown', (e) => { if (e.key === 'Enter') go(); });
  el('go').addEventListener('click', go);
  fillSearch();

  tries({
    proxima: () => { scaleSeg.clear(); const o = byName.get('proxima centauri'); if (o) { state.pitch = 0.3; flyTo(o, 6 / LY_PER_PC); } },
    mw: () => { scaleSeg.select('mw'); PRESETS.mw(); },
    andromeda: () => { scaleSeg.clear(); const o = byName.get('andromeda galaxy (m31)'); if (o) flyTo(o, 85000); },
    web: () => { scaleSeg.select('web'); state.pitch = 0.02; flyTo(SUN, 420 * MPC); },
    edge: () => { scaleSeg.select('obs'); PRESETS.obs(); },
  });

  if (!gl) {
    ctx.fillStyle = '#e8e9ec';
    ctx.font = '14px ui-sans-serif, system-ui, sans-serif';
    ctx.fillText('This simulation needs WebGL2, which this browser does not offer.', 20, 30);
  }
  void wrap;
</script>

<style>
  /* the canvas is the whole stage: no frame of padding around it */
  .ua-stage {
    padding: 0;
    overflow: hidden;
  }
  .ua-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 960 / 600;
    overflow: hidden;
    background: #010204;
  }
  .ua-wrap canvas {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    max-height: none !important;
    margin: 0 !important;
    border-radius: 0;
  }
  #uagl {
    pointer-events: none;
  }
  #ua {
    background: transparent !important;
    cursor: grab;
    touch-action: none;
  }
  #ua:active {
    cursor: grabbing;
  }
  .ua-toggle {
    display: none;
  }

  /* Fullscreen: the sky fills the screen and the controls float over it,
     folded away with the button in the corner. */
  :global(.sim.ua-sim:fullscreen) {
    display: block;
    position: relative;
    padding: 0;
    overflow: hidden;
    background: #010204;
  }
  :global(.sim.ua-sim:fullscreen > *) {
    overflow: visible;
  }
  :global(.ua-sim:fullscreen) .ua-stage {
    width: 100vw;
    height: 100vh;
    border: 0;
    border-radius: 0;
  }
  :global(.ua-sim:fullscreen) .ua-wrap {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }
  :global(.ua-sim:fullscreen) .ua-toggle {
    display: block;
    position: absolute;
    top: 20px;
    right: 124px;
    z-index: 3;
    height: 30px;
    padding: 0 11px;
    font: inherit;
    font-size: 0.78rem;
    color: #cdd2e0;
    background: rgba(20, 22, 28, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    cursor: pointer;
    backdrop-filter: blur(6px);
  }
  :global(.ua-sim:fullscreen) .ua-toggle[aria-pressed='true'] {
    color: #fff;
    border-color: rgba(201, 184, 255, 0.5);
  }
  :global(.sim.ua-sim:fullscreen > .sim-panel) {
    position: absolute;
    top: 62px;
    right: 12px;
    z-index: 2;
    width: min(320px, calc(100vw - 24px));
    max-height: calc(100vh - 124px);
    overflow-y: auto;
    padding: 14px;
    box-sizing: border-box;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    backdrop-filter: blur(10px);
  }
  :global(.sim.ua-sim.ua-panel-off:fullscreen > .sim-panel) {
    display: none;
  }
  .ua-find {
    display: flex;
    gap: 6px;
  }
  .ua-find input {
    flex: 1;
    min-width: 0;
    font: inherit;
    font-size: 0.85rem;
    padding: 6px 9px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
  }
  .ua-credits {
    margin: 8px 0 0;
    padding-left: 1.1em;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--text-muted);
    display: grid;
    gap: 5px;
  }
</style>
