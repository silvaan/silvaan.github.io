---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Transport from '../../../components/sim/Transport.astro';
import Readout from '../../../components/sim/Readout.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Try from '../../../components/sim/Try.astro';

const E_COLOR = '#60a5fa', B_COLOR = '#f87171', S_COLOR = '#fbbf24';
---

<SimLayout
  areaSlug="electronics"
  title="Transmission Lines"
  description="Close a switch on a two-wire line and watch where the energy really goes: not down the copper, but through the space between the wires, riding the fields as a wave at v = 1/√(LC). Change the load and the wave bounces back doubled, inverted, or not at all."
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas id="tl" class="tl-canvas" width="900" height="780" role="img" aria-label="A two-wire transmission line in three dimensions between a source and a load, with the electric and magnetic fields around it, the Poynting vector showing the energy flow, a shaded plane of energy density, and a strip plotting voltage and current along the line."></canvas>
      </div>
      <Caption
        legend={[
          { label: 'E (from the charge, ∝ V)', color: E_COLOR },
          { label: 'B (from the current, ∝ I)', color: B_COLOR },
          { label: 'energy flow S = E × H', color: S_COLOR },
          { label: 'shading on the plane', color: '#a78bfa', id: 'lg-shade' },
        ]}
        hint="Drag to orbit · scroll to zoom · dots on the wires drift with the current"
      />
      <Result label="Power into the load" />
    </div>

    <div class="sim-panel">
      <Seg
        id="src"
        label="Source"
        attr="s"
        options={[
          { value: 'step', label: 'Switch on (step)' },
          { value: 'pulse', label: 'Pulse' },
          { value: 'ac', label: 'AC' },
        ]}
      />
      <Transport step running />
      <div id="freq-wrap" hidden>
        <Slider id="freq" label="Frequency (line length in wavelengths)" min={0.25} max={3} step={0.05} value={1.5} display="ℓ = 1.50 λ" />
      </div>
      <Seg
        id="load"
        label="Load"
        attr="l"
        options={[
          { value: 'matched', label: 'Matched (R = Z<sub>0</sub>)' },
          { value: 'open', label: 'Open' },
          { value: 'short', label: 'Short' },
          { value: 'res', label: 'Resistor' },
          { value: 'cap', label: 'Capacitor' },
        ]}
      />
      <div id="rl-wrap" hidden>
        <Slider id="rl" label="Load R<sub>L</sub>" min={0} max={5} step={0.05} value={3} display="150 Ω" />
      </div>
      <div id="cl-wrap" hidden>
        <Slider id="cl" label="Load time constant Z<sub>0</sub>C" min={0.05} max={1} step={0.05} value={0.3} display="0.30 T" />
      </div>
      <Slider id="rs" label="Source resistance R<sub>s</sub>" min={0} max={5} step={0.05} value={1} display="50 Ω" />
      <Seg
        id="show"
        label="Show"
        options={[
          { value: 'e', label: 'E' },
          { value: 'b', label: 'B' },
          { value: 's', label: 'S' },
          { value: 'eb', label: 'E + B' },
          { value: 'all', label: 'All' },
          { value: 'off', label: 'Off' },
        ]}
        active="s"
      />
      <Seg
        id="shade"
        label="Shade"
        options={[
          { value: 'u', label: 'Energy u' },
          { value: 'flux', label: 'Flow |S|' },
          { value: 'phi', label: 'Potential φ' },
          { value: 'off', label: 'Off' },
        ]}
      />
      <div id="fog-wrap" hidden>
        <Seg
          id="fogmode"
          label="Draw it as"
          options={[
            { value: 'both', label: 'Fog + plane' },
            { value: 'fog', label: 'Fog' },
            { value: 'plane', label: 'Plane' },
          ]}
        />
        <Slider id="fogop" label="Fog density" min={0.2} max={3} step={0.1} value={1} display="1.0" />
      </div>
      <Seg
        id="plane"
        label="Plane"
        options={[
          { value: 'xy', label: 'Wire plane' },
          { value: 'yz', label: 'Cross-section' },
          { value: 'xz', label: 'Mid-plane' },
        ]}
      />
      <Slider id="offset" label="Plane at z" min={-6.5} max={6.5} step={0.1} value={0} display="0.0" />
      <Seg
        id="layout"
        label="Arrows"
        options={[
          { value: 'plane', label: 'On a plane' },
          { value: 'volume', label: 'Volume (3D)' },
        ]}
      />
      <Slider id="density" label="Density" min={1} max={8} step={1} value={4} display="4" />
      <Readout
        title="Values"
        rows={[
          { id: 'tOut', label: 'time t' },
          { id: 'gOut', label: 'Γ<sub>L</sub> = (R<sub>L</sub> − Z<sub>0</sub>)/(R<sub>L</sub> + Z<sub>0</sub>)' },
          { id: 'vlOut', label: 'V at the load' },
          { id: 'ilOut', label: 'I at the load' },
          { id: 'plOut', label: 'power into the load' },
          { id: 'esOut', label: 'work done by the source' },
          { id: 'erOut', label: 'heat in R<sub>s</sub>' },
          { id: 'ewOut', label: 'stored in the line ½∫(CV² + LI²)dx' },
          { id: 'elOut', label: 'delivered to the load' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      <b>Close the switch</b> and the load stays dark until the wavefront has
      crossed the line. The glowing fog is the energy: it fills the space
      between the wires, not the copper, and the gold <b>S</b> arrows show it
      flowing to the load. <Try id="switch" />
    </li>
    <li>
      An <b>open end</b> sends the wave back with the same sign: the voltage
      doubles and the current stops behind it. A <b>short</b> sends it back
      inverted, so V drops to zero. <Try id="open" label="Open end" /> <Try id="short" label="Short" />
    </li>
    <li>
      With a <b>matched load</b> nothing comes back: the pulse is swallowed
      whole and the line is empty again. <Try id="matched" />
    </li>
    <li>
      Drive a mismatched line with <b>AC</b> and the two waves add into a <b>standing wave</b>:
      V has nodes exactly where I peaks. <Try id="standing" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { el, segmented, slider, transport, readout, result, tries } from '../../../lib/panel';
  import {
    Camera3D, orbitControls, drawBackdrop, drawGizmo, drawArrow3D, PlaneShade,
    ramp32, fieldRamp, planePoint, line3,
    type Vec, type RGB, type PlaneAxis,
  } from '../../../lib/scene3d';
  import { VolumeView } from '../../../lib/volume3d';

  const canvas = el('tl') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const css = (v: string) => getComputedStyle(canvas).getPropertyValue(v).trim();
  const isLight = () => css('--stage-light') === '1';
  const ink = () => css('--stage-ink') || '232,233,236';

  const E_COLOR = '#60a5fa', B_COLOR = '#f87171', S_COLOR = '#fbbf24';
  const TAU = Math.PI * 2;

  // --- the line -------------------------------------------------------------------
  //
  // Normalised units: L = C = 1 per unit length, so v = 1 and Z0 = 1 (shown as
  // 50 Ω), and time is counted in one-way delays T. At a Courant number of 1
  // the leapfrog (FDTD) update of the telegrapher equations is an exact shift,
  // so the line is kept as its two travelling waves: a runs towards the load,
  // b back towards the source, V = a + b and I = (a − b)/Z0. Each step moves
  // both by one cell; the ends are solved exactly, so open, short and any R
  // are all stable.
  const N = 400;
  const a = new Float64Array(N + 1);
  const b = new Float64Array(N + 1);
  const DT = 1 / N; // one step, in T
  const T_REAL = 3; // seconds of animation per one-way delay

  // what the normalised numbers mean in the readouts
  const VS_VOLT = 10, Z0_OHM = 50, T_NS = 10;

  type Source = 'step' | 'pulse' | 'ac';
  type Load = 'matched' | 'open' | 'short' | 'res' | 'cap';
  type Show = 'e' | 'b' | 's' | 'eb' | 'all' | 'off';
  type Shade = 'u' | 'flux' | 'phi' | 'off';

  const state = {
    src: 'step' as Source,
    load: 'matched' as Load,
    rl: 3,
    tauC: 0.3,
    rs: 1,
    freq: 1.5,
    show: 's' as Show,
    shade: 'u' as Shade,
    plane: 'xy' as PlaneAxis,
    offset: 0,
    layout: 'plane' as 'plane' | 'volume',
    density: 4,
    fogMode: 'both' as 'both' | 'fog' | 'plane',
    fogOpacity: 1,
  };

  let n = 0; // steps since the switch closed
  let vc = 0; // capacitor voltage at the load
  let eSrc = 0, eRs = 0, eLoad = 0;
  let pAvg = 0;
  const time = () => n * DT;

  function vs(t: number) {
    if (t <= 0) return 0;
    const rise = 0.03, edge = (u: number) => 0.5 - 0.5 * Math.cos(Math.PI * Math.max(0, Math.min(1, u)));
    if (state.src === 'step') return edge(t / rise);
    if (state.src === 'pulse') return edge(t / 0.04) - edge((t - 0.3) / 0.04);
    return Math.sin(TAU * state.freq * t);
  }

  /** Reflection coefficient of the load; NaN for the capacitor, which has none fixed. */
  function gammaL() {
    switch (state.load) {
      case 'matched': return 0;
      case 'open': return 1;
      case 'short': return -1;
      case 'res': return (state.rl - 1) / (state.rl + 1);
      default: return NaN;
    }
  }

  function stepLine() {
    n++;
    const t = time();
    a.copyWithin(1, 0, N);
    b.copyWithin(0, 1, N + 1);
    const inc = a[N];
    if (state.load === 'cap') {
      // C dV/dt = (2a − V)/Z0, solved exactly over the step
      vc = 2 * inc + (vc - 2 * inc) * Math.exp(-DT / state.tauC);
      b[N] = vc - inc;
    } else b[N] = gammaL() * inc;
    // Thevenin source: V0 = Vs − Rs I0
    const e = vs(t), rs = state.rs;
    a[0] = e / (1 + rs) + ((rs - 1) / (rs + 1)) * b[0];
    const i0 = a[0] - b[0];
    const vl = a[N] + b[N], il = a[N] - b[N];
    eSrc += e * i0 * DT;
    eRs += rs * i0 * i0 * DT;
    eLoad += vl * il * DT;
    const k = state.src === 'ac' ? Math.min(1, DT * state.freq * 1.5) : 0.02;
    pAvg += (vl * il - pAvg) * k;
  }

  function storedEnergy() {
    let s = 0;
    for (let k = 0; k < N; k++) s += a[k] * a[k];
    for (let k = 1; k <= N; k++) s += b[k] * b[k];
    return s / N;
  }

  function resetLine() {
    a.fill(0);
    b.fill(0);
    n = 0;
    vc = 0;
    eSrc = eRs = eLoad = 0;
    pAvg = 0;
    resetDots();
    exposure = 0;
    shadeKey = '';
  }

  const Vn = (k: number) => a[k] + b[k];
  const In = (k: number) => a[k] - b[k];
  /** V and I at a world x on the line (interpolated). */
  function lineAt(x: number, out: Float64Array) {
    const p = Math.max(0, Math.min(N, ((x + XL) / (2 * XL)) * N));
    const k = Math.min(N - 1, Math.floor(p)), f = p - k;
    out[0] = Vn(k) + (Vn(k + 1) - Vn(k)) * f;
    out[1] = In(k) + (In(k + 1) - In(k)) * f;
  }
  const LA = new Float64Array(2);

  // --- geometry and the fields ------------------------------------------------------
  //
  // The two wires run along x at y = ±D. Each is cut into M pieces; piece j of
  // the top wire carries the charge +V_j per unit length and the current +I_j
  // (the bottom one the opposite), and every piece adds the exact field of a
  // finite line charge and a finite current. Far from the ends that is the
  // familiar two-wire pattern scaled by the local V and I; at the ends it
  // fringes and turns into the source and the load on its own.

  const XL = 6, D = 0.8, AW = 0.07, AW2 = AW * AW;
  const M = 64;
  const XB = new Float64Array(M + 1);
  for (let j = 0; j <= M; j++) XB[j] = -XL + (2 * XL * j) / M;
  // k fixed so the wires really sit V apart: 4kλ ln((2D − a)/a) = V for λ = V
  const K = 1 / (4 * Math.log((2 * D - AW) / AW));
  const dV = new Float64Array(M + 1);
  const dI = new Float64Array(M + 1);
  let iSrc = 0, iLoad = 0;

  /** Per-piece V and I from the line, as the jumps between neighbouring pieces. */
  function loadPieces() {
    let pv = 0, pi = 0;
    const per = N / M;
    for (let j = 0; j <= M; j++) {
      let v = 0, c = 0;
      if (j < M) {
        const k0 = Math.round(j * per), k1 = Math.round((j + 1) * per);
        for (let k = k0; k <= k1; k++) { v += Vn(k); c += In(k); }
        v /= k1 - k0 + 1;
        c /= k1 - k0 + 1;
      }
      dV[j] = pv - v;
      dI[j] = pi - c;
      pv = v;
      pi = c;
    }
    iSrc = In(0);
    iLoad = In(N);
  }

  // E, B and the potential at a point, written into F: Ex Ey Ez Bx By Bz φ
  const F = new Float64Array(7);
  const GL_R2 = 0.12 * 0.12;

  function fieldAt(x: number, y: number, z: number, phi: boolean) {
    let ex = 0, ey = 0, ez = 0, by = 0, bz = 0, bx = 0, ph = 0;
    for (let w = 0; w < 2; w++) {
      const sg = w === 0 ? 1 : -1;
      const ry = y - sg * D, rz = z;
      let r2 = ry * ry + rz * rz;
      if (r2 < AW2) r2 = AW2;
      let gs = 0, gx = 0, hs = 0, pl = 0;
      for (let j = 0; j <= M; j++) {
        const s = XB[j] - x;
        const R = Math.sqrt(s * s + r2), iR = 1 / R, g = s * iR;
        gs += dV[j] * g;
        gx += dV[j] * iR;
        hs += dI[j] * g;
        if (phi) pl += dV[j] * (s > 0 ? Math.log(s + R) : Math.log(r2 / (R - s)));
      }
      const f = (sg * K) / r2;
      ey += f * ry * gs;
      ez += f * rz * gs;
      ex += sg * K * gx;
      by -= f * rz * hs;
      bz += f * ry * hs;
      ph += sg * K * pl;
    }
    // the source (current up, +y) and the load (current down, −y) close the loop
    for (let e = 0; e < 2; e++) {
      const x0 = e === 0 ? -XL : XL, cur = e === 0 ? iSrc : -iLoad;
      if (cur === 0) continue;
      const rx = x - x0, rz = z;
      let r2 = rx * rx + rz * rz;
      if (r2 < GL_R2) r2 = GL_R2;
      const s1 = -D - y, s2 = D - y;
      const fac = (K * cur * (s2 / Math.sqrt(s2 * s2 + r2) - s1 / Math.sqrt(s1 * s1 + r2))) / r2;
      bx += fac * rz;
      bz -= fac * rx;
    }
    F[0] = ex; F[1] = ey; F[2] = ez; F[3] = bx; F[4] = by; F[5] = bz; F[6] = ph;
  }

  // The same field along a whole row of the long plane at once. The row's
  // points are spaced so that the piece ends fall on them (a piece is exactly
  // RM grid cells long), so every distance from a point to a piece end is one
  // of a few hundred values: the square roots and logs are taken once per row
  // in a table and the sum over pieces becomes lookups.
  const LG = 160, LHALF = 7.5, LDX = (2 * LHALF) / LG;
  const RM = Math.round((2 * XL) / M / LDX);
  const S00 = XB[0] - (-LHALF + 0.5 * LDX);
  const NT = RM * M + LG;
  const TG = new Float64Array(NT), TI = new Float64Array(NT), TL = new Float64Array(NT);
  const RF = new Float64Array(7 * LG);

  function fieldRow(y: number, z: number, phi: boolean) {
    RF.fill(0);
    for (let w = 0; w < 2; w++) {
      const sg = w === 0 ? 1 : -1;
      const ry = y - sg * D, rz = z;
      let r2 = ry * ry + rz * rz;
      if (r2 < AW2) r2 = AW2;
      for (let t = 0; t < NT; t++) {
        const s = S00 + (t - (LG - 1)) * LDX;
        const R = Math.sqrt(s * s + r2);
        TG[t] = s / R;
        TI[t] = 1 / R;
        if (phi) TL[t] = s > 0 ? Math.log(s + R) : Math.log(r2 / (R - s));
      }
      const f = (sg * K) / r2;
      for (let i = 0; i < LG; i++) {
        let gs = 0, gx = 0, hs = 0, pl = 0;
        let t = LG - 1 - i;
        for (let j = 0; j <= M; j++, t += RM) {
          gs += dV[j] * TG[t];
          gx += dV[j] * TI[t];
          hs += dI[j] * TG[t];
          if (phi) pl += dV[j] * TL[t];
        }
        RF[i] += sg * K * gx;
        RF[LG + i] += f * ry * gs;
        RF[2 * LG + i] += f * rz * gs;
        RF[4 * LG + i] -= f * rz * hs;
        RF[5 * LG + i] += f * ry * hs;
        RF[6 * LG + i] += sg * K * pl;
      }
    }
    for (let e = 0; e < 2; e++) {
      const x0 = e === 0 ? -XL : XL, cur = e === 0 ? iSrc : -iLoad;
      if (cur === 0) continue;
      const s1 = -D - y, s2 = D - y;
      for (let i = 0; i < LG; i++) {
        const rx = -LHALF + (i + 0.5) * LDX - x0;
        let r2 = rx * rx + z * z;
        if (r2 < GL_R2) r2 = GL_R2;
        const fac = (K * cur * (s2 / Math.sqrt(s2 * s2 + r2) - s1 / Math.sqrt(s1 * s1 + r2))) / r2;
        RF[3 * LG + i] += fac * z;
        RF[5 * LG + i] -= fac * rx;
      }
    }
  }

  // reference sizes: a matched line at the source's half voltage, midway between the wires
  const E_REF = (4 * K * 0.5) / D;
  const U_REF = E_REF * E_REF; // ½(E² + B²) with E = B
  const S_REF = E_REF * E_REF;

  // --- the camera and the planes ----------------------------------------------------

  const STRIP = 132;
  const H3 = H - STRIP;
  const cam = new Camera3D(W, H3, { dist: 17, yaw: 0.42, pitch: -0.5, zoom: 1.12 });
  const BAND = 3.6, HALF_X = 2.6;
  const shadeLong = new PlaneShade(W, H, { half: LHALF, grid: LG, step: 2 });
  const shadeCross = new PlaneShade(W, H, { half: HALF_X, grid: 84, step: 1.5 });
  const shadeObj = () => (state.plane === 'yz' ? shadeCross : shadeLong);
  /** Half extents (u, v) of the shaded rectangle. */
  const extent = (): [number, number] => (state.plane === 'yz' ? [HALF_X, HALF_X] : [7.2, BAND]);

  let exposure = 0;
  let shadeKey = '';
  const QS = new Float32Array(4096);

  function updateShade() {
    const key = [n, state.plane, state.offset, state.shade, state.load, state.src].join('|');
    if (key === shadeKey) return;
    shadeKey = key;
    const ps = shadeObj();
    const A = ps.a;
    A.fill(0);
    const [, ev] = extent();
    const phi = state.shade === 'phi', flux = state.shade === 'flux';
    const G = ps.grid;
    let q = 0;
    const rows = state.plane !== 'yz';
    for (let j = 0; j < G; j++) {
      const v = ps.coord(j);
      if (Math.abs(v) > ev + 0.15) continue;
      if (rows) {
        if (state.plane === 'xy') fieldRow(v, state.offset, phi);
        else fieldRow(state.offset, v, phi);
      }
      for (let i = 0; i < G; i++) {
        if (rows) {
          for (let c = 0; c < 7; c++) F[c] = RF[c * G + i];
        } else {
          const P = planePoint(state.plane, state.offset, ps.coord(i), v);
          fieldAt(P.x, P.y, P.z, phi);
        }
        let val: number;
        if (phi) val = F[6];
        else if (flux) {
          const sx = F[1] * F[5] - F[2] * F[4], sy = F[2] * F[3] - F[0] * F[5], sz = F[0] * F[4] - F[1] * F[3];
          val = Math.hypot(sx, sy, sz);
        } else val = 0.5 * (F[0] * F[0] + F[1] * F[1] + F[2] * F[2] + F[3] * F[3] + F[4] * F[4] + F[5] * F[5]);
        A[j * G + i] = val;
        if (((i * 7 + j * 13) & 3) === 0 && q < QS.length) QS[q++] = val;
      }
    }
    ps.blur(A);
    if (!phi && q) {
      const s = QS.subarray(0, q).sort();
      const ref = flux ? S_REF : U_REF;
      const target = Math.max(0.25 * ref, s[Math.floor(q * 0.9)]);
      exposure = exposure ? exposure * 0.97 + target * 0.03 : Math.max(target, ref);
    }
  }

  let rampLight: boolean | null = null;
  // pixel tables over the shaded value: log-like for u and |S| (value × 3 /
  // exposure from 0 to LOG_TOP), a 0.7 power for |φ| (0 to PHI_TOP × half the source)
  const CT = 4096, LOG_TOP = 24, PHI_TOP = 1.2;
  const logU = new Uint32Array(CT), logS = new Uint32Array(CT), phiPos = new Uint32Array(CT), phiNeg = new Uint32Array(CT);
  function buildRamps() {
    const light = isLight();
    if (light === rampLight) return;
    rampLight = light;
    fillTables(light);
  }
  let rampU = new Uint32Array(256), rampFlux = rampU, rampPos = rampU, rampNeg = rampU;
  function fillTables(light: boolean) {
    const r = makeRamps(light);
    rampU = r.u; rampFlux = r.flux; rampPos = r.pos; rampNeg = r.neg;
    const norm = 255 / Math.log(1 + LOG_TOP);
    for (let i = 0; i < CT; i++) {
      const x = (i / (CT - 1)) * LOG_TOP;
      const li = Math.min(255, (Math.log(1 + x) * norm) | 0);
      logU[i] = r.u[li];
      logS[i] = r.flux[li];
      const p = Math.min(255, (Math.pow((i / (CT - 1)) * PHI_TOP, 0.7) * 255) | 0);
      phiPos[i] = r.pos[p];
      phiNeg[i] = r.neg[p];
    }
  }
  function makeRamps(light: boolean): Record<string, Uint32Array> {
    return {
      u: fieldRamp(light),
      flux: ramp32(
        light
          ? [[0, 254, 243, 199, 0], [0.3, 253, 224, 130, 0.35], [0.65, 245, 158, 11, 0.5], [1, 146, 64, 14, 0.7]]
          : [[0, 120, 53, 15, 0], [0.3, 180, 83, 9, 0.32], [0.65, 245, 158, 11, 0.5], [1, 254, 240, 138, 0.75]]
      ),
      pos: ramp32(
        light
          ? [[0, 254, 226, 226, 0], [0.4, 248, 113, 113, 0.35], [1, 153, 27, 27, 0.7]]
          : [[0, 127, 29, 29, 0], [0.4, 220, 38, 38, 0.36], [1, 254, 202, 202, 0.75]]
      ),
      neg: ramp32(
        light
          ? [[0, 219, 234, 254, 0], [0.4, 96, 165, 250, 0.35], [1, 30, 64, 175, 0.7]]
          : [[0, 30, 58, 138, 0], [0.4, 37, 99, 235, 0.36], [1, 191, 219, 254, 0.75]]
      ),
    };
  }

  function drawShade() {
    if (state.shade === 'off') return;
    updateShade();
    buildRamps();
    const ps = shadeObj();
    // the colour of every pixel comes from a table, so the per-pixel work is
    // one multiply and two lookups
    if (state.shade === 'phi') {
      const pos = phiPos, neg = phiNeg;
      // the wires sit at ±V/2; half the source voltage fills the scale
      const k = (CT - 1) / (0.5 * PHI_TOP);
      ps.render(ctx, cam, state.plane, state.offset, (v) => {
        let i = (v < 0 ? -v : v) * k;
        if (i > CT - 1) i = CT - 1;
        return (v < 0 ? neg : pos)[i | 0];
      });
      return;
    }
    const lut = state.shade === 'u' ? logU : logS;
    const k = (CT - 1) / (LOG_TOP * Math.max(1e-9, exposure) / 3);
    ps.render(ctx, cam, state.plane, state.offset, (v) => {
      let i = v * k;
      if (i > CT - 1) i = CT - 1;
      return lut[i | 0];
    });
  }

  function drawPlaneFrame() {
    const [eu, ev] = extent();
    const light = isLight();
    const col = `rgba(${ink()},${light ? 0.1 : 0.07})`;
    const edge = `rgba(${ink()},${light ? 0.32 : 0.26})`;
    const P = (u: number, v: number) => planePoint(state.plane, state.offset, u, v);
    const nu = Math.round(eu / 0.6), nv = Math.round(ev / 0.6);
    for (let i = -nu; i <= nu; i++) {
      const u = (eu * i) / nu;
      line3(ctx, cam, P(u, -ev), P(u, ev), Math.abs(i) === nu ? edge : col, 1);
    }
    for (let i = -nv; i <= nv; i++) {
      const v = (ev * i) / nv;
      line3(ctx, cam, P(-eu, v), P(eu, v), Math.abs(i) === nv ? edge : col, 1);
    }
    // the label goes under whichever corner sits lowest on screen
    let lab = cam.project(P(-eu, -ev));
    for (const [cu, cv] of [[eu, -ev], [-eu, ev], [eu, ev]]) {
      const c = cam.project(P(cu, cv));
      if (c.sy > lab.sy) lab = c;
    }
    const name = { xy: 'wire plane · z', yz: 'cross-section · x', xz: 'mid-plane · y' }[state.plane];
    ctx.fillStyle = `rgba(${ink()},0.5)`;
    ctx.font = "500 11px 'JetBrains Mono', monospace";
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(`${name} = ${state.offset.toFixed(1)}`, Math.max(110, Math.min(W - 110, lab.sx)), Math.min(H3 - 10, lab.sy + 14));
  }

  // --- arrows -----------------------------------------------------------------------

  const E_RGB: RGB = [96, 165, 250], B_RGB: RGB = [248, 113, 113], S_RGB: RGB = [251, 191, 36];
  const E_RGB_L: RGB = [37, 99, 235], B_RGB_L: RGB = [220, 38, 38], S_RGB_L: RGB = [217, 119, 6];

  function samples() {
    const pts: Vec[] = [];
    const d = state.density;
    if (state.layout === 'plane') {
      const [eu, ev] = extent();
      const nu = state.plane === 'yz' ? 5 + 2 * d : 9 + 3 * d;
      const sp = (2 * eu) / (nu - 1);
      // across the line, a step that divides the gap between the wires, so
      // rows fall between them and never on them
      const odd = Math.max(3, 2 * Math.round(((2 * D) / sp - 1) / 2) + 1);
      const spv = state.plane === 'yz' ? sp : (2 * D) / odd;
      const nv = Math.floor(ev / spv + 1e-6);
      for (let i = 0; i < nu; i++)
        for (let j = -nv; j <= nv; j++) pts.push(planePoint(state.plane, state.offset, -eu + sp * i, spv * j));
      return { pts, spacing: 1.15 * Math.min(sp, spv * 1.4) };
    }
    const k = 3 + d;
    const ey = 2.8, sp = (2 * ey) / (k - 1);
    const nx = Math.round(14 / sp) + 1, spx = 14 / (nx - 1);
    for (let i = 0; i < nx; i++)
      for (let j = 0; j < k; j++)
        for (let l = 0; l < k; l++) pts.push({ x: -7 + spx * i, y: -ey + sp * j, z: -ey + sp * l });
    return { pts, spacing: Math.min(sp, spx) };
  }

  type Item = { z: number; draw: () => void };

  function pushArrows(items: Item[]) {
    if (state.show === 'off') return;
    const sh = state.show;
    const wantE = sh === 'e' || sh === 'eb' || sh === 'all';
    const wantB = sh === 'b' || sh === 'eb' || sh === 'all';
    const wantS = sh === 's' || sh === 'all';
    const light = isLight();
    const { pts, spacing } = samples();
    const o = { spacing, gain: 1.35, half: 7.5, light };
    for (const p of pts) {
      // skip points inside a wire
      if (p.x > -XL - 0.1 && p.x < XL + 0.1 && Math.min(Math.hypot(p.y - D, p.z), Math.hypot(p.y + D, p.z)) < 0.16) continue;
      fieldAt(p.x, p.y, p.z, false);
      const z = cam.toCam(p).zc;
      const Ex = F[0], Ey = F[1], Ez = F[2], Bx = F[3], By = F[4], Bz = F[5];
      const add = (fx: number, fy: number, fz: number, ref: number, rgb: RGB, dz: number) => {
        const m = Math.hypot(fx, fy, fz);
        if (m < 1e-9) return;
        // a square-root squash, so the field a few gaps out still shows
        const mm = Math.sqrt(m / ref), s = mm / m;
        const f = { x: fx * s, y: fy * s, z: fz * s };
        items.push({ z: z - dz, draw: () => drawArrow3D(ctx, cam, p, f, mm, rgb, o) });
      };
      if (wantE) add(Ex, Ey, Ez, E_REF, light ? E_RGB_L : E_RGB, 0);
      if (wantB) add(Bx, By, Bz, E_REF, light ? B_RGB_L : B_RGB, 1e-3);
      if (wantS) add(Ey * Bz - Ez * By, Ez * Bx - Ex * Bz, Ex * By - Ey * Bx, 0.6 * S_REF, light ? S_RGB_L : S_RGB, 2e-3);
    }
  }

  // --- wires, charges, source and load -------------------------------------------------

  /** Copper tinted towards red where the wire sits at + potential and blue at −. */
  function wireColour(phi: number, light: boolean): [number, number, number] {
    const base = light ? [180, 100, 30] : [217, 132, 52];
    const tint = phi > 0 ? (light ? [220, 38, 38] : [248, 90, 90]) : light ? [29, 78, 216] : [59, 130, 246];
    const k = Math.min(1, Math.abs(phi) / 0.5) * (phi > 0 ? 0.9 : 1);
    return [0, 1, 2].map((c) => Math.round(base[c] + (tint[c] - base[c]) * k)) as [number, number, number];
  }

  function tube(p: Vec, q: Vec, rgb: [number, number, number], light: boolean, r = AW) {
    const pa = cam.project(p), pb = cam.project(q);
    if (pa.zc < 0.3 || pb.zc < 0.3) return;
    const w = Math.max(2, 2 * r * ((pa.s + pb.s) / 2) * cam.scale);
    const fog = cam.fog((pa.zc + pb.zc) / 2, 7.5);
    ctx.lineCap = 'round';
    ctx.strokeStyle = light ? `rgba(60,40,20,${0.35 * fog})` : `rgba(0,0,0,${0.5 * fog})`;
    ctx.lineWidth = w + 2.5;
    ctx.beginPath(); ctx.moveTo(pa.sx, pa.sy); ctx.lineTo(pb.sx, pb.sy); ctx.stroke();
    ctx.strokeStyle = `rgba(${rgb[0]},${rgb[1]},${rgb[2]},${0.55 + 0.45 * fog})`;
    ctx.lineWidth = w;
    ctx.beginPath(); ctx.moveTo(pa.sx, pa.sy); ctx.lineTo(pb.sx, pb.sy); ctx.stroke();
    const hl = rgb.map((c) => Math.round(c + (255 - c) * 0.55));
    ctx.strokeStyle = `rgba(${hl[0]},${hl[1]},${hl[2]},${0.75 * fog})`;
    ctx.lineWidth = Math.max(0.8, w * 0.3);
    ctx.beginPath(); ctx.moveTo(pa.sx, pa.sy - w * 0.18); ctx.lineTo(pb.sx, pb.sy - w * 0.18); ctx.stroke();
  }

  const WSEG = 48;
  function pushWires(items: Item[]) {
    const light = isLight();
    for (const sg of [1, -1]) {
      for (let s = 0; s < WSEG; s++) {
        const x0 = -XL + (2 * XL * s) / WSEG, x1 = -XL + (2 * XL * (s + 1)) / WSEG;
        lineAt((x0 + x1) / 2, LA);
        const rgb = wireColour((sg * LA[0]) / 2, light);
        const p = { x: x0, y: sg * D, z: 0 }, q = { x: x1, y: sg * D, z: 0 };
        items.push({ z: cam.toCam({ x: (x0 + x1) / 2, y: sg * D, z: 0 }).zc + 0.02, draw: () => tube(p, q, rgb, light) });
      }
    }
  }

  // charge carriers: dots that drift round the loop at a speed ∝ the local current.
  // The loop runs along the top wire, down the load, back along the bottom
  // wire and up through the source.
  const LOOP = 4 * XL + 4 * D;
  const NDOT = 84;
  const dots = new Float64Array(NDOT);
  function resetDots() {
    for (let i = 0; i < NDOT; i++) dots[i] = ((i + 0.5) / NDOT) * LOOP;
  }
  function loopPoint(s: number, out: { x: number; y: number; seg: number }) {
    s = ((s % LOOP) + LOOP) % LOOP;
    const L2 = 2 * XL, V2 = 2 * D;
    if (s < L2) { out.x = -XL + s; out.y = D; out.seg = 0; }
    else if (s < L2 + V2) { out.x = XL; out.y = D - (s - L2); out.seg = 1; }
    else if (s < 2 * L2 + V2) { out.x = XL - (s - L2 - V2); out.y = -D; out.seg = 2; }
    else { out.x = -XL; out.y = -D + (s - 2 * L2 - V2); out.seg = 3; }
  }
  const LP = { x: 0, y: 0, seg: 0 };
  const KAPPA = 6;
  function moveDots(dtT: number) {
    for (let i = 0; i < NDOT; i++) {
      loopPoint(dots[i], LP);
      let cur: number;
      if (LP.seg === 1) cur = In(N);
      else if (LP.seg === 3) cur = In(0);
      else { lineAt(LP.x, LA); cur = LA[1]; }
      dots[i] = (((dots[i] + KAPPA * cur * dtT) % LOOP) + LOOP) % LOOP;
    }
  }

  function pushDots(items: Item[]) {
    const light = isLight();
    for (let i = 0; i < NDOT; i++) {
      loopPoint(dots[i], LP);
      if (LP.seg === 1 && (state.load === 'open' || (state.load === 'cap' && Math.abs(LP.y) < 0.14))) continue;
      const p = { x: LP.x, y: LP.y, z: 0 };
      const c = cam.toCam(p);
      items.push({
        z: c.zc - 0.05,
        draw: () => {
          const pr = cam.project(p);
          if (pr.zc < 0.3) return;
          const r = Math.max(1.3, 0.05 * pr.s * cam.scale);
          ctx.fillStyle = light ? 'rgba(68,40,12,0.9)' : 'rgba(255,250,235,0.95)';
          ctx.beginPath();
          ctx.arc(pr.sx, pr.sy, r, 0, TAU);
          ctx.fill();
        },
      });
    }
  }

  /** A polyline through world points. */
  function poly(pts: Vec[], col: string, w: number) {
    ctx.strokeStyle = col;
    ctx.lineWidth = w;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.beginPath();
    pts.forEach((p, i) => {
      const pr = cam.project(p);
      if (i) ctx.lineTo(pr.sx, pr.sy); else ctx.moveTo(pr.sx, pr.sy);
    });
    ctx.stroke();
  }

  function zigzag(x: number, y0: number, y1: number, amp: number): Vec[] {
    const pts: Vec[] = [{ x, y: y0, z: 0 }];
    const k = 6;
    for (let i = 0; i < k; i++) {
      const y = y0 + ((y1 - y0) * (i + 0.5)) / k;
      pts.push({ x: x + (i % 2 ? -amp : amp), y, z: 0 });
    }
    pts.push({ x, y: y1, z: 0 });
    return pts;
  }

  function label(p: Vec, text: string, dy = 0) {
    const pr = cam.project(p);
    ctx.fillStyle = `rgba(${ink()},0.6)`;
    ctx.font = "500 11px 'JetBrains Mono', monospace";
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(text, pr.sx, pr.sy + dy);
  }

  function drawSource() {
    const light = isLight();
    const metal = light ? 'rgba(71,85,105,0.95)' : 'rgba(203,213,225,0.9)';
    const x = -XL;
    const wpx = Math.max(1.6, 2 * AW * cam.project({ x, y: 0, z: 0 }).s * cam.scale * 0.6);
    // internal resistance at the top, the EMF below it
    poly([{ x, y: D, z: 0 }, { x, y: 0.62, z: 0 }], metal, wpx);
    poly(zigzag(x, 0.62, 0.22, 0.11), metal, wpx * 0.8);
    if (state.src === 'ac') {
      poly([{ x, y: 0.22, z: 0 }, { x, y: 0.06, z: 0 }], metal, wpx);
      const c: Vec[] = [];
      for (let i = 0; i <= 40; i++) {
        const th = (i / 40) * TAU;
        c.push({ x: x + 0.27 * Math.cos(th), y: -0.21 + 0.27 * Math.sin(th), z: 0 });
      }
      poly(c, metal, wpx * 0.8);
      const sw: Vec[] = [];
      for (let i = 0; i <= 24; i++) {
        const u = i / 24;
        sw.push({ x: x - 0.17 + 0.34 * u, y: -0.21 + 0.1 * Math.sin(TAU * u), z: 0 });
      }
      poly(sw, light ? '#b45309' : S_COLOR, wpx * 0.7);
      poly([{ x, y: -0.48, z: 0 }, { x, y: -D, z: 0 }], metal, wpx);
    } else {
      poly([{ x, y: 0.22, z: 0 }, { x, y: 0.02, z: 0 }], metal, wpx);
      poly([{ x: x - 0.3, y: 0.02, z: 0 }, { x: x + 0.3, y: 0.02, z: 0 }], light ? '#b91c1c' : '#fca5a5', wpx * 1.1);
      poly([{ x: x - 0.15, y: -0.12, z: 0 }, { x: x + 0.15, y: -0.12, z: 0 }], light ? '#1d4ed8' : '#93c5fd', wpx * 1.6);
      // the switch: open until t = 0
      const closed = n > 0;
      const piv = { x, y: -0.36, z: 0 };
      const tip = closed ? { x, y: -0.12, z: 0 } : { x: x + 0.2, y: -0.18, z: 0 };
      poly([{ x, y: -D, z: 0 }, piv], metal, wpx);
      poly([piv, tip], metal, wpx);
    }
    label({ x, y: -D - 0.38, z: 0 }, state.src === 'ac' ? 'AC source' : 'source');
  }

  function drawLoad() {
    const light = isLight();
    const metal = light ? 'rgba(71,85,105,0.95)' : 'rgba(203,213,225,0.9)';
    const x = XL;
    const c = cam.project({ x, y: 0, z: 0 });
    const wpx = Math.max(1.6, 2 * AW * c.s * cam.scale * 0.6);
    const pl = In(N) * Vn(N);
    if (state.load === 'matched' || state.load === 'res') {
      // the lamp glows with the power it takes in
      const g = 1 - Math.exp(-3 * Math.max(0, pl) / 0.25);
      if (g > 0.01) {
        const r = 1.1 * c.s * cam.scale * (0.6 + 0.6 * g);
        const halo = ctx.createRadialGradient(c.sx, c.sy, 0, c.sx, c.sy, r);
        halo.addColorStop(0, `rgba(255,236,180,${0.85 * g})`);
        halo.addColorStop(0.35, `rgba(251,191,36,${0.45 * g})`);
        halo.addColorStop(1, 'rgba(251,146,60,0)');
        ctx.fillStyle = halo;
        ctx.beginPath();
        ctx.arc(c.sx, c.sy, r, 0, TAU);
        ctx.fill();
      }
      const cold = light ? [71, 85, 105] : [203, 213, 225], hot = light ? [234, 88, 12] : [255, 214, 120];
      const col = cold.map((v, i) => Math.round(v + (hot[i] - v) * g));
      poly([{ x, y: D, z: 0 }, { x, y: 0.5, z: 0 }], metal, wpx);
      poly(zigzag(x, 0.5, -0.5, 0.13), `rgb(${col[0]},${col[1]},${col[2]})`, wpx * (1 + 0.4 * g));
      poly([{ x, y: -0.5, z: 0 }, { x, y: -D, z: 0 }], metal, wpx);
    } else if (state.load === 'short') {
      poly([{ x, y: D, z: 0 }, { x, y: -D, z: 0 }], metal, wpx * 1.3);
    } else if (state.load === 'open') {
      for (const sg of [1, -1]) {
        const pr = cam.project({ x, y: sg * D, z: 0 });
        ctx.strokeStyle = metal;
        ctx.lineWidth = 1.4;
        ctx.beginPath();
        ctx.arc(pr.sx, pr.sy, Math.max(3, wpx * 1.6), 0, TAU);
        ctx.stroke();
      }
    } else {
      poly([{ x, y: D, z: 0 }, { x, y: 0.1, z: 0 }], metal, wpx);
      poly([{ x, y: -0.1, z: 0 }, { x, y: -D, z: 0 }], metal, wpx);
      const top = wireColour(vc / 2, light), bot = wireColour(-vc / 2, light);
      poly([{ x: x - 0.32, y: 0.1, z: 0 }, { x: x + 0.32, y: 0.1, z: 0 }], `rgb(${top.join(',')})`, wpx * 1.8);
      poly([{ x: x - 0.32, y: -0.1, z: 0 }, { x: x + 0.32, y: -0.1, z: 0 }], `rgb(${bot.join(',')})`, wpx * 1.8);
    }
    const name = { matched: 'load R = Z₀', res: `load R = ${(state.rl * Z0_OHM).toFixed(0)} Ω`, short: 'short', open: 'open end', cap: 'capacitor' }[state.load];
    label({ x, y: -D - 0.38, z: 0 }, name);
  }

  // --- the strip: V(x) and I(x) along the line right now ------------------------------

  let yScale = 1;
  function drawStrip() {
    const light = isLight();
    const x0 = 100, x1 = W - 40, y0 = H3 + 14, y1 = H - 16, ym = (y0 + y1) / 2, hh = (y1 - y0) / 2 - 6;
    ctx.beginPath();
    ctx.roundRect(x0 - 84, y0 - 6, x1 - x0 + 108, y1 - y0 + 12, 8);
    ctx.fillStyle = css('--stage-bg') || (light ? '#fff' : '#0d0e12');
    ctx.fill();
    ctx.fillStyle = `rgba(${ink()},${light ? 0.035 : 0.045})`;
    ctx.strokeStyle = `rgba(${ink()},0.1)`;
    ctx.lineWidth = 1;
    ctx.fill();
    ctx.stroke();

    let mx = 0;
    for (let k = 0; k <= N; k += 2) mx = Math.max(mx, Math.abs(Vn(k)), Math.abs(In(k)));
    const target = Math.max(1, mx * 1.08);
    yScale = target > yScale ? target : yScale + (target - yScale) * 0.02;

    const X = (k: number) => x0 + ((x1 - x0) * k) / N;
    const Y = (v: number) => ym - (v / yScale) * hh;
    ctx.strokeStyle = `rgba(${ink()},0.22)`;
    ctx.beginPath();
    ctx.moveTo(x0, ym);
    ctx.lineTo(x1, ym);
    ctx.stroke();
    ctx.setLineDash([3, 4]);
    ctx.strokeStyle = `rgba(${ink()},0.12)`;
    for (const v of [1, -1]) {
      ctx.beginPath();
      ctx.moveTo(x0, Y(v * 0.5));
      ctx.lineTo(x1, Y(v * 0.5));
      ctx.stroke();
    }
    ctx.setLineDash([]);

    // power flowing past each point, P = VI, as a soft fill
    ctx.fillStyle = light ? 'rgba(217,119,6,0.18)' : 'rgba(251,191,36,0.16)';
    ctx.beginPath();
    ctx.moveTo(X(0), ym);
    for (let k = 0; k <= N; k += 2) ctx.lineTo(X(k), Y(2 * Vn(k) * In(k)));
    ctx.lineTo(X(N), ym);
    ctx.closePath();
    ctx.fill();

    for (const [f, col, dash] of [[Vn, light ? '#2563eb' : E_COLOR, 0], [In, light ? '#dc2626' : B_COLOR, 1]] as [(k: number) => number, string, number][]) {
      ctx.strokeStyle = col;
      ctx.lineWidth = dash ? 2 : 2.6;
      ctx.setLineDash(dash ? [7, 5] : []);
      ctx.beginPath();
      for (let k = 0; k <= N; k += 2) {
        if (k) ctx.lineTo(X(k), Y(f(k))); else ctx.moveTo(X(k), Y(f(k)));
      }
      ctx.stroke();
    }
    ctx.setLineDash([]);
    if (state.plane === 'yz') {
      const xs = X(((state.offset + XL) / (2 * XL)) * N);
      if (xs >= x0 && xs <= x1) {
        ctx.strokeStyle = `rgba(${ink()},0.35)`;
        ctx.setLineDash([2, 3]);
        ctx.beginPath();
        ctx.moveTo(xs, y0);
        ctx.lineTo(xs, y1);
        ctx.stroke();
        ctx.setLineDash([]);
      }
    }
    ctx.font = "600 11px 'JetBrains Mono', monospace";
    ctx.textBaseline = 'middle';
    ctx.textAlign = 'right';
    ctx.fillStyle = light ? '#2563eb' : E_COLOR;
    ctx.fillText('V(x)', x0 - 8, y0 + 8);
    ctx.fillStyle = light ? '#dc2626' : B_COLOR;
    ctx.fillText('I(x)·Z₀', x0 - 8, y0 + 24);
    ctx.fillStyle = light ? '#b45309' : S_COLOR;
    ctx.fillText('P(x)', x0 - 8, y0 + 40);
    ctx.fillStyle = `rgba(${ink()},0.5)`;
    ctx.font = "500 10px 'JetBrains Mono', monospace";
    ctx.textAlign = 'left';
    ctx.fillText('source', x0, y1 + 2);
    ctx.textAlign = 'right';
    ctx.fillText('load', x1, y1 + 2);
    ctx.textAlign = 'right';
    ctx.font = "600 11px 'JetBrains Mono', monospace";
    ctx.fillStyle = `rgba(${ink()},0.7)`;
    ctx.fillText(`t = ${time().toFixed(2)} T`, x0 - 8, y1 - 2);
  }

  // --- the fog: energy in 3D, raymarched by the shared volume renderer -----------------
  //
  // Away from the ends the line's field is the two-wire pattern of its cross
  // section scaled by the local V and I (quasi-TEM). So the 3D grid is a
  // product: a fixed pattern over (y, z) times profiles along x. The profiles
  // are blurred more the farther a point is from the wires, as the exact sum
  // over pieces does (a point at distance r sees the line smeared over ~r), and
  // fade out past the ends.

  const fog = VolumeView.create(canvas, W, H, 'signed');
  const FX = 112, FY = 40, FZ = 40;
  const FLO: [number, number, number] = [-7.4, -2.6, -2.6], FHI: [number, number, number] = [7.4, 2.6, 2.6];
  const fogVol = new Float32Array(FX * FY * FZ);
  // the cross-section pattern for V = 1 (and I = 1): |e|² and the potential
  const PE2 = new Float32Array(FY * FZ), PPHI = new Float32Array(FY * FZ);
  const PLEV = new Uint8Array(FY * FZ), PW = new Float32Array(FY * FZ);
  const SIG = [0, 0.3, 0.7, 1.4];
  for (let k = 0; k < FZ; k++) {
    const z = FLO[2] + ((k + 0.5) * (FHI[2] - FLO[2])) / FZ;
    for (let j = 0; j < FY; j++) {
      const y = FLO[1] + ((j + 0.5) * (FHI[1] - FLO[1])) / FY;
      const r1 = Math.max(AW2, (y - D) ** 2 + z * z), r2 = Math.max(AW2, (y + D) ** 2 + z * z);
      const ey = 2 * K * ((y - D) / r1 - (y + D) / r2), ez = 2 * K * (z / r1 - z / r2);
      const c = k * FY + j;
      PE2[c] = ey * ey + ez * ez;
      PPHI[c] = K * Math.log(r2 / r1);
      // which two blur levels to mix, by the distance to the nearer wire
      const sg = 0.5 * Math.sqrt(Math.min(r1, r2));
      let l = 0;
      while (l < SIG.length - 2 && sg > SIG[l + 1]) l++;
      PLEV[c] = l;
      PW[c] = Math.max(0, Math.min(1, (sg - SIG[l]) / (SIG[l + 1] - SIG[l])));
    }
  }
  const PV = SIG.map(() => new Float64Array(FX)), PI = SIG.map(() => new Float64Array(FX));
  // per blur level, the line quantity the shaded value needs: V² + I², |VI| or V
  const PQ = SIG.map(() => new Float32Array(FX));
  // log(1 + x)/log 25 by table, x from 0 to LT_TOP
  const LT = 8192, LT_TOP = 200;
  const LOGT = new Float32Array(LT);
  for (let i = 0; i < LT; i++) LOGT[i] = Math.log(1 + (i / (LT - 1)) * LT_TOP) / Math.log(25);
  const FDX = (FHI[0] - FLO[0]) / FX;

  /** V and I at x, fading out over half a unit past either end. */
  function lineTaper(x: number, out: Float64Array) {
    lineAt(x, out);
    const over = Math.abs(x) - XL;
    if (over > 0) { const f = Math.exp(-((over / 0.45) ** 2)); out[0] *= f; out[1] *= f; }
  }

  function profiles() {
    for (let l = 0; l < SIG.length; l++) {
      const s = SIG[l];
      for (let i = 0; i < FX; i++) {
        const x = FLO[0] + (i + 0.5) * FDX;
        if (s === 0) { lineTaper(x, LA); PV[l][i] = LA[0]; PI[l][i] = LA[1]; continue; }
        let v = 0, c = 0, w = 0;
        const h = s / 4;
        for (let q = -12; q <= 12; q++) {
          const g = Math.exp(-0.5 * ((q * h) / s) ** 2);
          lineTaper(x + q * h, LA);
          v += g * LA[0]; c += g * LA[1]; w += g;
        }
        PV[l][i] = v / w; PI[l][i] = c / w;
      }
    }
  }

  let fogKey = '';
  function fillFog() {
    const key = [n, state.shade, state.load, state.src, exposure.toPrecision(3)].join('|');
    if (key === fogKey) return;
    fogKey = key;
    profiles();
    const sh = state.shade;
    for (let l = 0; l < SIG.length; l++)
      for (let i = 0; i < FX; i++) {
        const V = PV[l][i], I = PI[l][i];
        PQ[l][i] = sh === 'phi' ? V : sh === 'flux' ? Math.abs(V * I) : 0.5 * (V * V + I * I);
      }
    const inv = 3 / Math.max(1e-9, exposure), tk = (LT - 1) / LT_TOP;
    let o = 0;
    for (let k = 0; k < FZ; k++)
      for (let j = 0; j < FY; j++) {
        const c = k * FY + j, l = PLEV[c], w = PW[c];
        const qa = PQ[l], qb = PQ[l + 1];
        if (sh === 'phi') {
          // signed, red where φ > 0 and blue where φ < 0; squared, so the slow
          // 1/r tail of the potential does not fill the whole box
          const ph = PPHI[c] * 2;
          for (let i = 0; i < FX; i++, o++) {
            const f = (qa[i] + (qb[i] - qa[i]) * w) * ph;
            fogVol[o] = f * (f < 0 ? -f : f) * 1.3;
          }
        } else {
          const m = PE2[c] * inv * tk;
          for (let i = 0; i < FX; i++, o++) {
            let x = (qa[i] + (qb[i] - qa[i]) * w) * m;
            if (x > LT - 1) x = LT - 1;
            fogVol[o] = LOGT[x | 0];
          }
        }
      }
    fog!.setVolume(fogVol, [FX, FY, FZ], FLO, FHI);
  }

  let fogColours = '';
  let bgLight: boolean | null = null;
  let planeKey = '';
  function renderFog() {
    if (!fog) return;
    const light = isLight();
    if (bgLight !== light) {
      bgLight = light;
      fog.canvas.style.background = `radial-gradient(circle at 50% 42%, rgba(99,102,241,${light ? 0.06 : 0.12}), rgba(99,102,241,0) 70%), var(--stage-bg)`;
    }
    const sh = state.shade;
    if (sh === 'off') { fog.render(cam, { cloud: false, plane: false, gain: 1, light }); return; }
    buildRamps();
    const ck = `${light}|${sh}`;
    if (ck !== fogColours) {
      fogColours = ck;
      if (sh === 'phi') fog.setColours(rampPos, rampNeg);
      else fog.setColours(sh === 'u' ? rampU : rampFlux);
    }
    const showPlane = state.fogMode !== 'fog', showCloud = state.fogMode !== 'plane';
    // the plane's samples also set the exposure the fog follows
    updateShade();
    const pk = shadeKey;
    if (showPlane && pk !== planeKey) {
      planeKey = pk;
      const ps = shadeObj();
      fog.setPlane(ps.a, ps.grid, state.plane, state.offset, ps.half);
    }
    if (!showPlane) { planeKey = ''; fog.setPlane(null, 0, state.plane, 0, 0); }
    if (showCloud) fillFog();
    fog.render(cam, {
      cloud: showCloud,
      plane: showPlane,
      gain: 1,
      // a plane level of ~1 where the 2D shading saturates
      planeGain: sh === 'phi' ? 2 : 0.25 / Math.max(1e-9, exposure),
      opacity: 0.9 * state.fogOpacity,
      len: 1.1,
      light,
      planeAlpha: 0.55,
    });
  }

  // --- frame ----------------------------------------------------------------------

  function draw() {
    ctx.clearRect(0, 0, W, H);
    loadPieces();
    if (fog) renderFog();
    else {
      drawBackdrop(ctx, W, H, isLight());
      drawShade();
    }
    const planeShown = state.shade !== 'off' && (!fog || state.fogMode !== 'fog');
    if (planeShown || (state.layout === 'plane' && state.show !== 'off')) drawPlaneFrame();

    const items: Item[] = [];
    pushArrows(items);
    pushWires(items);
    pushDots(items);
    items.push({ z: cam.toCam({ x: -XL, y: 0, z: 0 }).zc, draw: drawSource });
    items.push({ z: cam.toCam({ x: XL, y: 0, z: 0 }).zc, draw: drawLoad });
    items.sort((p, q) => q.z - p.z);
    for (const it of items) it.draw();

    drawGizmo(ctx, cam, H3);
    drawStrip();
    sync();
  }

  // --- words and numbers -------------------------------------------------------------

  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  const fmtE = (e: number) => `${(e * (VS_VOLT * VS_VOLT / Z0_OHM) * T_NS).toFixed(2)} nJ`;
  const fmtW = (p: number) => `${(p * (VS_VOLT * VS_VOLT / Z0_OHM)).toFixed(2)} W`;
  const ohm = (r: number) => `${(r * Z0_OHM).toFixed(0)} Ω`;

  function describe(): { status: string; note: string } {
    const t = time();
    const g = gammaL();
    const swr = Number.isFinite(g) ? (Math.abs(g) >= 0.999 ? '∞' : ((1 + Math.abs(g)) / (1 - Math.abs(g))).toFixed(2)) : '';
    if (state.src === 'ac') {
      if (t < 1) return { status: `the wave is ${Math.round(t * 100)}% of the way down`, note: 'Nothing reaches the load before one delay T: the energy is still in the fields between the wires, on its way.' };
      if (state.load === 'matched' || (state.load === 'res' && Math.abs(g) < 0.01))
        return { status: `matched: a pure travelling wave · average ${fmtW(pAvg)}`, note: 'No reflection: every point of the line sees the same wave go by, a little later. S always points towards the load.' };
      return {
        status: `standing wave · SWR ${swr || 'varies'} · average ${fmtW(pAvg)}`,
        note: 'The forward and reflected waves add: V and I have fixed nodes a quarter wavelength apart, and the energy sloshes back and forth between them.',
      };
    }
    if (t < 1) {
      const where = state.src === 'pulse' ? 'pulse' : 'wavefront';
      return {
        status: `the ${where} is ${Math.round(t * 100)}% of the way down the line`,
        note: state.src === 'step'
          ? 'The switch is closed but the load is still dark: the energy is in the fields between the wires, travelling at v = 1/√(LC).'
          : 'The pulse carries its energy in the fields around it; the wires only guide it.',
      };
    }
    if (state.src === 'pulse') {
      if (state.load === 'matched') return { status: 'absorbed: nothing comes back', note: 'A matched load takes the whole pulse, so the line is left empty.' };
      if (state.load === 'open') return { status: 'reflected with the same sign (Γ = +1)', note: 'At the open end the current must vanish, so the pulse returns upright with its current reversed.' };
      if (state.load === 'short') return { status: 'reflected inverted (Γ = −1)', note: 'At a short the voltage must vanish, so the pulse returns upside down.' };
      if (state.load === 'cap') return { status: 'the capacitor first shorts, then opens', note: 'The front of the pulse sees a short, the tail a charged capacitor: the echo is a down-up wiggle.' };
      return { status: `part reflected (Γ = ${g.toFixed(2)}), part absorbed`, note: 'The load keeps a fraction 1 − Γ² of the energy that hits it.' };
    }
    const settled = state.rs === 1 ? t > 2.2 : t > 8;
    if (state.load === 'matched') return { status: 'matched: no reflection', note: 'The load takes all the power the wave brings. The energy flows steadily through the space between the wires into it.' };
    if (state.load === 'open')
      return settled
        ? { status: 'charged: V everywhere, no current', note: 'No current and no energy flow: the line is a charged capacitor, its energy all in the electric field.' }
        : { status: 'reflected: the voltage doubles behind the returning front', note: 'The open end turns the wave round with the same sign; behind it V doubles and I stops.' };
    if (state.load === 'short')
      return settled
        ? { status: 'steady: full current, V = 0', note: 'The line is now a loop of current with no voltage: its energy is all in the magnetic field.' }
        : { status: 'reflected inverted: V = 0 behind the returning front', note: 'The short turns the wave round upside down; behind it the voltage is gone and the current doubles.' };
    if (state.load === 'cap') return { status: 'first a short, then an open end', note: 'The uncharged capacitor reflects like a short; as it charges it ends up reflecting like an open end.' };
    return { status: `reflected with Γ = ${g.toFixed(2)}`, note: `After a few round trips it settles to V = Vs·R_L/(R_s + R_L), as if the line were not there.` };
  }

  function sync() {
    const g = gammaL();
    const vl = Vn(N), il = In(N), pl = vl * il;
    setRows({
      tOut: `${time().toFixed(2)} T  (${(time() * T_NS).toFixed(1)} ns)`,
      gOut: Number.isFinite(g) ? (g >= 0 ? '+' : '−') + Math.abs(g).toFixed(2) : 'changes with time',
      vlOut: `${(vl * VS_VOLT).toFixed(2)} V`,
      ilOut: `${((il * VS_VOLT) / Z0_OHM * 1000).toFixed(0)} mA`,
      plOut: fmtW(pl),
      esOut: fmtE(eSrc),
      erOut: fmtE(eRs),
      ewOut: fmtE(storedEnergy()),
      elOut: fmtE(eLoad),
    });
    const gTex = state.load === 'open' ? '+1' : state.load === 'cap' ? '\\text{varies}' : (g >= 0 ? '+' : '-') + Math.abs(g).toFixed(2);
    setEq({
      rule: [
        '\\partial_x', [ 'V', E_COLOR ], '=-L\\,\\partial_t', [ 'I', B_COLOR ],
        '\\quad \\partial_x', [ 'I', B_COLOR ], '=-C\\,\\partial_t', [ 'V', E_COLOR ],
        '\\qquad', [ '\\mathbf S', S_COLOR ], '=', [ '\\mathbf E', E_COLOR ], '\\times', [ '\\mathbf H', B_COLOR ],
      ],
      live: [
        `\\Gamma_L = ${gTex}`,
        '\\quad v = 1/\\sqrt{LC} = 2\\times10^{8}\\,\\text{m/s}',
        [`\\quad P_L = ${(pl * (VS_VOLT * VS_VOLT / Z0_OHM)).toFixed(2)}\\,\\text{W}`, S_COLOR],
      ],
    });
    const d = describe();
    setResult({ value: fmtW(pl), status: d.status, note: d.note });
  }

  // --- controls -------------------------------------------------------------------

  function panelFor() {
    el('freq-wrap').hidden = state.src !== 'ac';
    el('rl-wrap').hidden = state.load !== 'res';
    el('cl-wrap').hidden = state.load !== 'cap';
    const lab = document.querySelector('label[for="offset"] span');
    if (lab) lab.textContent = { xy: 'Plane at z', yz: 'Cross-section at x', xz: 'Plane at y' }[state.plane];
    const lg = el('lg-shade');
    lg.hidden = state.shade === 'off';
    const where = fog ? (state.fogMode === 'fog' ? 'as fog' : state.fogMode === 'plane' ? 'on the plane' : 'as fog and on the plane') : 'on the plane';
    const names = { u: 'energy density u', flux: 'energy flow |S|', phi: 'potential φ (red +, blue −)', off: '' };
    lg.textContent = state.shade === 'off' ? '' : `${names[state.shade]} ${where}`;
    lg.style.setProperty('--dot', state.shade === 'u' ? '#a78bfa' : state.shade === 'flux' ? S_COLOR : '#f87171');
  }

  function view(which: 'line' | 'cross') {
    if (which === 'cross') { cam.yaw = 1.3; cam.pitch = -0.28; cam.zoom = 1.9; }
    else { cam.yaw = 0.42; cam.pitch = -0.5; cam.zoom = 1.12; }
  }

  const tr = transport({
    onStep: () => { advanceSteps(10); draw(); },
    onReset: () => { resetLine(); draw(); },
  });
  const srcSeg = segmented('src', (v) => { state.src = v as Source; resetLine(); panelFor(); draw(); });
  const loadSeg = segmented('load', (v) => { state.load = v as Load; resetLine(); panelFor(); draw(); });
  const setRl = slider('rl', (v) => { state.rl = v; shadeKey = ''; draw(); }, (v) => `${ohm(v)} (${v.toFixed(2)} Z₀)`);
  slider('cl', (v) => { state.tauC = v; draw(); }, (v) => `${v.toFixed(2)} T`);
  const setRs = slider('rs', (v) => { state.rs = v; draw(); }, (v) => `${ohm(v)}`);
  const setFreq = slider('freq', (v) => { state.freq = v; draw(); }, (v) => `ℓ = ${v.toFixed(2)} λ`);
  const showSeg = segmented('show', (v) => { state.show = v as Show; draw(); });
  const shadeSeg = segmented('shade', (v) => { state.shade = v as Shade; exposure = 0; panelFor(); draw(); });
  const setOffset = slider('offset', (v) => { state.offset = v; draw(); }, (v) => v.toFixed(1));
  const planeSeg = segmented('plane', (v) => {
    const was = state.plane;
    state.plane = v as PlaneAxis;
    state.offset = 0;
    // face the cross-section, so it is not seen edge-on; back again after
    if (v === 'yz') view('cross');
    else if (was === 'yz') view('line');
    setOffset(0);
    exposure = 0;
    panelFor();
    draw();
  });
  segmented('fogmode', (v) => { state.fogMode = v as typeof state.fogMode; panelFor(); draw(); });
  slider('fogop', (v) => { state.fogOpacity = v; draw(); }, (v) => v.toFixed(1));
  el('fog-wrap').hidden = !fog;
  const layoutSeg = segmented('layout', (v) => { state.layout = v as 'plane' | 'volume'; draw(); });
  const setDensity = slider('density', (v) => { state.density = v; draw(); });

  orbitControls(canvas, cam, W, H, { changed: () => { if (!tr.running()) draw(); } });

  function advanceSteps(k: number) {
    for (let i = 0; i < k; i++) stepLine();
    moveDots(k * DT);
  }

  function setup(o: {
    src: Source; load: Load; show?: Show; shade?: Shade; plane?: PlaneAxis; layout?: 'plane' | 'volume';
    rl?: number; rs?: number; freq?: number; offset?: number;
  }) {
    state.src = o.src; srcSeg.select(o.src);
    state.load = o.load; loadSeg.select(o.load);
    state.show = o.show ?? 's'; showSeg.select(state.show);
    state.shade = o.shade ?? 'u'; shadeSeg.select(state.shade);
    state.plane = o.plane ?? 'xy'; planeSeg.select(state.plane);
    state.layout = o.layout ?? 'plane'; layoutSeg.select(state.layout);
    state.offset = o.offset ?? 0; setOffset(state.offset);
    state.rs = o.rs ?? 1; setRs(state.rs);
    if (o.rl !== undefined) { state.rl = o.rl; setRl(o.rl); }
    if (o.freq !== undefined) { state.freq = o.freq; setFreq(o.freq); }
    state.density = 4; setDensity(4);
    view(state.plane === 'yz' ? 'cross' : 'line');
    resetLine();
    panelFor();
    tr.setRunning(true);
    draw();
  }

  tries({
    switch: () => setup({ src: 'step', load: 'matched', show: 's', shade: 'u' }),
    open: () => setup({ src: 'step', load: 'open', show: 'eb', shade: 'phi' }),
    short: () => setup({ src: 'step', load: 'short', show: 'eb', shade: 'u' }),
    matched: () => setup({ src: 'pulse', load: 'matched', show: 's', shade: 'u' }),
    standing: () => setup({ src: 'ac', load: 'open', show: 'eb', shade: 'phi', freq: 1.5 }),
  });

  let acc = 0;
  let last = 0;
  function loop(ts: number) {
    const dt = last ? Math.min(0.1, (ts - last) / 1000) : 0;
    last = ts;
    if (tr.running()) {
      acc += (dt / T_REAL) * N;
      const k = Math.floor(acc);
      acc -= k;
      if (k > 0) advanceSteps(k);
      draw();
    }
    requestAnimationFrame(loop);
  }

  resetDots();
  panelFor();
  draw();
  requestAnimationFrame(loop);
</script>

<style>
  .tl-canvas {
    cursor: grab;
    touch-action: none;
  }

  .tl-canvas:active {
    cursor: grabbing;
  }
</style>
