---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="electronics"
  title="Memristor"
  description="A resistor that remembers the charge that went through it: push one way and its conducting layer grows, push back and it shrinks, stop and it stays. On AC its I–V curve is a pinched loop."
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas id="mr" class="mr-canvas" width="1000" height="700" role="img" aria-label="A thin film with a moving boundary between doped and undoped halves, oxygen vacancies as dots, and the current–voltage curve tracing a pinched loop."></canvas>
      </div>
      <Caption
        legend={[
          { label: 'oxygen vacancy', color: '#5eead4' },
          { label: 'boundary', color: '#7c8cff' },
          { label: 'current', color: '#34d399' },
        ]}
        hint="The boundary between the doped and undoped halves is the device's entire memory"
      />
      <Result label="Resistance right now" />
    </div>

    <div class="sim-panel">
      <Transport />
      <Seg
        id="src"
        label="Source"
        attr="s"
        options={[
          { value: 'manual', label: 'Manual' },
          { value: 'ac', label: 'AC' },
          { value: 'pulse', label: 'Pulses' },
        ]}
      />
      <div id="ctl-v">
        <Slider
          id="vs"
          label='<span id="vlab">Drive it yourself</span>'
          min={-150}
          max={150}
          value={0}
          display="0.00 V"
          hint={['drag me up and down', '']}
        />
      </div>
      <div id="ctl-f" class="mr-opt">
        <Slider id="freq" label="Frequency" min={10} max={600} step={5} value={100} display="1.00 Hz" hint={['slow, fat loop', 'fast, thin loop']} />
      </div>
      <Slider id="ron" label="R<sub>on</sub> (fully doped)" min={20} max={400} step={10} value={100} display="—" />
      <Slider id="roff" label="R<sub>off</sub> (fully undoped)" min={10} max={400} step={5} value={160} display="—" />
      <Slider id="d" label="Film thickness D" min={5} max={30} value={10} display="10 nm" />
      <Slider id="mu" label="Ion mobility µ<sub>v</sub>" min={20} max={300} step={5} value={100} display="—" hint={['sluggish', 'eager']} />
      <Seg
        id="win"
        label="Boundary"
        attr="w"
        options={[
          { value: 'hard', label: 'Hard stop' },
          { value: 'soft', label: 'Sticky' },
        ]}
      />
      <Slider id="rate" label="Time rate" min={10} max={300} step={5} value={100} display="1.0×" />
      <Readout
        title="Values"
        rows={[1, 2, 3, 4, 5, 6, 7].map((n) => ({ id: `r${n}`, label: `<span id="l${n}">—</span>` }))}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Push the drive up and the vacancies drift, the doped layer grows and the
      resistance falls. Drop it back to zero and the boundary <b>stays where
      you left it</b>: the resistance is a record of the charge pushed through. <Try id="push" />
    </li>
    <li>
      On <b>AC</b> the current-voltage curve is a loop <b>pinched at the
      origin</b>. Since v = M·i with M finite, zero current means zero voltage,
      a shape no resistor, capacitor or inductor can draw. <Try id="loop" />
    </li>
    <li>
      Raise the frequency and the loop <b>collapses towards a line</b>: the
      boundary has no time to move within a cycle, so M barely changes and it
      acts like a plain resistor. <Try id="fast" />
    </li>
    <li>
      Hit it with <b>pulses</b> big enough to slam the boundary into the walls.
      It latches between R<sub>on</sub> and R<sub>off</sub>, which is what makes
      it a memory cell. <Try id="latch" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText, subHtml, isCompact } from '../../../lib/sim';
  import { eng as engRaw, fixed } from '../../../lib/draw';
  import { equation } from '../../../lib/equation';
  import { el, segmented, slider, transport, result, tries } from '../../../lib/panel';

  // ---------------------------------------------------------------------------
  // The HP / Strukov thin-film model. A film of thickness D is split into a
  // doped region of width w (oxygen vacancies present, conducting) and an
  // undoped one (insulating). The vacancies are charged, so current drags the
  // boundary along with it, and the resistance is whatever the two layers make
  // in series.
  //
  //      x = w/D            M(x) = R_on x + R_off (1 - x)
  //      dw/dt = µ_v (R_on/D) i      so      dx/dt = (µ_v R_on / D²) i
  //
  // The state moves with the *integral* of the current, which is exactly why
  // this element remembers charge and a resistor does not.
  // ---------------------------------------------------------------------------

  const state = {
    src: 'manual' as 'manual' | 'ac' | 'pulse',
    win: 'hard' as 'hard' | 'soft',
    vs: 0, // live drive volts, or the amplitude in AC / pulse
    // 1 Hz at the default amplitude swings the boundary over roughly 0.35..0.83
    // without ever touching a rail, which is the loop at its fattest before
    // saturation starts flattening it into two plain resistor lines.
    freq: 1, // Hz
    ron: 100, // Ω
    roff: 16000, // Ω
    D: 10e-9, // m
    mu: 1e-14, // m²/(V·s)
    rate: 1,
    running: false,
  };

  const X0 = 0.35; // where the boundary sits after a reset
  let x = X0; // w/D, the one state variable
  let q = 0; // charge that has been through, C
  let phi = 0; // flux linkage, Wb
  let clock = 0; // simulated seconds since reset
  let drift = 0; // a phase used to shuffle the vacancy dots along

  /** dx per coulomb: the whole device in one number. */
  const kq = () => (state.mu * state.ron) / (state.D * state.D);
  const mem = () => state.ron * x + state.roff * (1 - x);

  /**
   * How freely the boundary moves near the edges. `hard` lets it run right up
   * to the wall and stop; `soft` is the Joglekar window, which throttles the
   * drift to nothing at both ends and can strand the state there.
   */
  function window_(xx: number) {
    if (state.win === 'hard') return 1;
    const u = 2 * xx - 1;
    return 1 - u * u * u * u; // p = 2
  }

  function vSource(tt: number) {
    if (state.src === 'manual') return state.vs;
    const s = Math.sin(2 * Math.PI * state.freq * tt);
    return state.src === 'ac' ? state.vs * s : state.vs * Math.sign(s || 1);
  }

  type Sample = { t: number; v: number; i: number; x: number };
  let hist: Sample[] = [];
  let loop: { v: number; i: number; t: number }[] = [];
  let pq: { q: number; phi: number }[] = [];

  function reset() {
    x = X0;
    q = 0;
    phi = 0;
    clock = 0;
    drift = 0;
    hist = [];
    loop = [];
    pq = [];
  }

  function physics(dtReal: number) {
    const dt = dtReal * state.rate;
    const steps = 48;
    const h = dt / steps;
    for (let s = 0; s < steps; s++) {
      clock += h;
      const v = vSource(clock);
      const i = v / mem();
      q += i * h;
      phi += v * h;
      x = Math.max(0, Math.min(1, x + kq() * i * window_(x) * h));
      drift += i * h * 4e4;
      // sampled well inside the frame, so a fast loop still draws smoothly
      if (s % 6 === 0) {
        loop.push({ v, i, t: clock });
        pq.push({ q, phi });
      }
    }
    const v = vSource(clock);
    hist.push({ t: clock, v, i: v / mem(), x });

    const span = histSpan();
    while (hist.length > 2 && hist[0].t < clock - span) hist.shift();
    const lspan = state.src === 'manual' ? 4 : 2 / state.freq;
    while (loop.length > 2 && loop[0].t < clock - lspan) loop.shift();
    if (loop.length > 1400) loop.splice(0, loop.length - 1400);
    if (pq.length > 2600) pq.splice(0, pq.length - 2600);
  }

  const histSpan = () => (state.src === 'manual' ? 6 : Math.max(2, 4 / state.freq));

  // --- formatting ------------------------------------------------------------

  /** eng() with a real minus sign. */
  const eng = (v: number, unit: string, digits = 2) => engRaw(v, unit, digits).replace('-', '−');
  const fmtR = (r: number) =>
    r >= 1e6 ? (r / 1e6).toFixed(r >= 1e7 ? 0 : 1) + ' MΩ'
    : r >= 1000 ? (r / 1000).toFixed(r >= 1e4 ? 0 : 1) + ' kΩ'
    : r.toFixed(0) + ' Ω';

  // --- canvas ----------------------------------------------------------------

  const canvas = document.getElementById('mr') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const cssVar = (n: string) => getComputedStyle(canvas).getPropertyValue(n).trim();
  const inkRGB = () => cssVar('--stage-ink') || '232,233,236';
  const inkA = (a: number) => `rgba(${inkRGB()},${a})`;
  const bg = () => cssVar('--stage-bg') || '#0d0e12';
  const { label, textWidth } = makeText(ctx, inkA, 1.42, undefined, 11);
  let compact = false;

  const ACC = '#7c8cff';
  const WARM = '#f59e0b'; // voltage
  const GREEN = '#34d399'; // current
  const VAC = '#5eead4'; // an oxygen vacancy
  const HOT = '#f9736a';

  const SCENE = { x: 20, y: 16, w: 960, h: 396 };
  const SCOPE = { x: 20, y: 452, w: 400, h: 230 };
  const LOOP = { x: 444, y: 452, w: 290, h: 230 };
  const PHIQ = { x: 758, y: 452, w: 222, h: 230 };

  function rr(x0: number, y0: number, w: number, h: number, r: number) {
    const rad = Math.min(r, Math.abs(w) / 2, Math.abs(h) / 2);
    ctx.beginPath();
    ctx.moveTo(x0 + rad, y0);
    ctx.lineTo(x0 + w - rad, y0);
    ctx.quadraticCurveTo(x0 + w, y0, x0 + w, y0 + rad);
    ctx.lineTo(x0 + w, y0 + h - rad);
    ctx.quadraticCurveTo(x0 + w, y0 + h, x0 + w - rad, y0 + h);
    ctx.lineTo(x0 + rad, y0 + h);
    ctx.quadraticCurveTo(x0, y0 + h, x0, y0 + h - rad);
    ctx.lineTo(x0, y0 + rad);
    ctx.quadraticCurveTo(x0, y0, x0 + rad, y0);
    ctx.closePath();
  }
  function panel(p: { x: number; y: number; w: number; h: number }, title: string) {
    ctx.strokeStyle = inkA(0.1);
    ctx.lineWidth = 1;
    rr(p.x, p.y, p.w, p.h, 10);
    ctx.stroke();
    if (title) label(title, p.x + 2, p.y - 10, 0.5, 'left', 11);
  }
  function arrow(x1: number, y1: number, x2: number, y2: number, size = 5) {
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y2);
    ctx.stroke();
    const a = Math.atan2(y2 - y1, x2 - x1);
    ctx.beginPath();
    ctx.moveTo(x2, y2);
    ctx.lineTo(x2 - size * Math.cos(a - 0.4), y2 - size * Math.sin(a - 0.4));
    ctx.lineTo(x2 - size * Math.cos(a + 0.4), y2 - size * Math.sin(a + 0.4));
    ctx.closePath();
    ctx.fill();
  }

  // --- the film --------------------------------------------------------------

  const FILM = { x: 350, w: 480, h: 150 };
  const midY = () => SCENE.y + 165;
  const filmY = () => midY() - FILM.h / 2;

  /** Vacancy sites: a fixed scatter, so a dot appearing is the boundary moving. */
  const SITES = (() => {
    let s = 20240917;
    const rnd = () => ((s = (s * 1664525 + 1013904223) >>> 0) / 4294967296);
    const out: { u: number; v: number }[] = [];
    const COLS = 24, ROWS = 7;
    for (let c = 0; c < COLS; c++)
      for (let r = 0; r < ROWS; r++)
        out.push({
          u: (c + 0.5 + (rnd() - 0.5) * 0.7) / COLS,
          v: (r + 0.5 + (rnd() - 0.5) * 0.7) / ROWS,
        });
    return out;
  })();

  function drawFilm() {
    const y0 = filmY(), y1 = y0 + FILM.h;
    const bx = FILM.x + x * FILM.w; // the boundary
    const i = vSource(clock) / mem();

    // the two layers
    ctx.fillStyle = 'rgba(94,234,212,0.12)';
    ctx.fillRect(FILM.x, y0, x * FILM.w, FILM.h);
    ctx.fillStyle = 'rgba(245,158,11,0.07)';
    ctx.fillRect(bx, y0, (1 - x) * FILM.w, FILM.h);
    ctx.strokeStyle = inkA(0.22);
    ctx.lineWidth = 1;
    ctx.strokeRect(FILM.x, y0, FILM.w, FILM.h);

    // the vacancies themselves
    const moving = Math.abs(i) > 1e-7;
    const dir = Math.sign(i) || 1;
    let n = 0;
    for (const s of SITES) {
      const sx = FILM.x + s.u * FILM.w;
      const sy = y0 + s.v * FILM.h;
      if (s.u < x) {
        n++;
        // a short tail on the ones nearest the front, showing which way they drift
        if (moving && Math.abs(s.u - x) < 0.22) {
          ctx.strokeStyle = `rgba(94,234,212,${0.5 * (1 - Math.abs(s.u - x) / 0.22)})`;
          ctx.lineWidth = 1.6;
          ctx.beginPath();
          ctx.moveTo(sx - dir * 9, sy);
          ctx.lineTo(sx, sy);
          ctx.stroke();
        }
        ctx.fillStyle = VAC;
        ctx.beginPath();
        ctx.arc(sx, sy, 3.6, 0, Math.PI * 2);
        ctx.fill();
      } else {
        ctx.strokeStyle = inkA(0.13);
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.arc(sx, sy, 3, 0, Math.PI * 2);
        ctx.stroke();
      }
    }

    // the boundary: the entire memory of the device
    ctx.strokeStyle = ACC;
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(bx, y0 - 8);
    ctx.lineTo(bx, y1 + 8);
    ctx.stroke();
    if (moving) {
      ctx.strokeStyle = ACC;
      ctx.fillStyle = ACC;
      ctx.lineWidth = 2;
      arrow(bx + dir * 8, y0 - 20, bx + dir * 34, y0 - 20, 7);
    }

    // the electrodes
    ctx.fillStyle = inkA(0.3);
    rr(FILM.x - 54, y0 - 10, 54, FILM.h + 20, 4);
    ctx.fill();
    rr(FILM.x + FILM.w, y0 - 10, 54, FILM.h + 20, 4);
    ctx.fill();
    label('Pt', FILM.x - 27, midY() + 5, 0.55, 'center', 11);
    label('Pt', FILM.x + FILM.w + 27, midY() + 5, 0.55, 'center', 11);

    // what the two halves are
    label(compact ? 'doped' : `doped · ${n} vacancies`, FILM.x + 4, y1 + 26, 0.85, 'left', 11, VAC);
    label('undoped', FILM.x + FILM.w - 4, y1 + 26, 0.7, 'right', 11, WARM);

    // the dimensions the model is written in
    ctx.strokeStyle = inkA(0.35);
    ctx.fillStyle = inkA(0.35);
    ctx.lineWidth = 1;
    const wy = y0 - 44;
    arrow(FILM.x, wy, bx, wy, 5);
    arrow(bx, wy, FILM.x, wy, 5);
    label(`w = ${(x * state.D * 1e9).toFixed(2)} nm`, Math.max(FILM.x + 60, (FILM.x + bx) / 2), wy - 10, 0.6, 'center', 11, ACC);
    if (!compact) {
      const dy = y1 + 58;
      arrow(FILM.x, dy, FILM.x + FILM.w, dy, 5);
      arrow(FILM.x + FILM.w, dy, FILM.x, dy, 5);
      label(`D = ${(state.D * 1e9).toFixed(0)} nm`, FILM.x + FILM.w / 2, dy + 22, 0.5, 'center', 11);
    }

    return { n, i };
  }

  function drawSource(sx: number, sy: number) {
    const v = vSource(clock);
    ctx.lineWidth = 2;
    if (state.src === 'manual') {
      ctx.fillStyle = bg();
      ctx.beginPath();
      ctx.arc(sx, sy, 30, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = inkA(0.5);
      ctx.stroke();
      const ang = -Math.PI / 2 + (v / 1.5) * 2.2;
      ctx.strokeStyle = WARM;
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.moveTo(sx, sy);
      ctx.lineTo(sx + Math.cos(ang) * 22, sy + Math.sin(ang) * 22);
      ctx.stroke();
      ctx.fillStyle = WARM;
      ctx.beginPath();
      ctx.arc(sx, sy, 3.6, 0, Math.PI * 2);
      ctx.fill();
    } else {
      ctx.fillStyle = bg();
      ctx.beginPath();
      ctx.arc(sx, sy, 28, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = inkA(0.6);
      ctx.stroke();
      ctx.beginPath();
      for (let k = 0; k <= 28; k++) {
        const f = k / 28;
        const px = sx - 16 + f * 32;
        const s = Math.sin(f * Math.PI * 2);
        const py = sy - (state.src === 'ac' ? s : Math.sign(s || 1)) * 10;
        k ? ctx.lineTo(px, py) : ctx.moveTo(px, py);
      }
      ctx.stroke();
    }
    label(`${v >= 0 ? '+' : ''}${fixed(v, 3)} V`, sx + 14, sy + 64, 0.9, 'left', 14, WARM);
  }

  function drawScene() {
    panel(SCENE, '');
    const my = midY();
    const sx = SCENE.x + 130;
    const retY = my + 172;

    // the loop the current goes round
    ctx.strokeStyle = inkA(0.4);
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(sx + 30, my);
    ctx.lineTo(FILM.x - 54, my);
    ctx.moveTo(FILM.x + FILM.w + 54, my);
    ctx.lineTo(SCENE.x + SCENE.w - 30, my);
    ctx.lineTo(SCENE.x + SCENE.w - 30, retY);
    ctx.lineTo(sx, retY);
    ctx.lineTo(sx, my + 30);
    ctx.stroke();

    drawSource(sx, my);
    const { i } = drawFilm();

    // the current, drawn where it flows
    const moving = Math.abs(i) > 1e-7;
    if (moving) {
      const dir = Math.sign(i);
      ctx.strokeStyle = GREEN;
      ctx.fillStyle = GREEN;
      ctx.lineWidth = 2;
      const mx = (sx + FILM.x - 54) / 2;
      arrow(mx - dir * 30, my - 20, mx + dir * 30, my - 20, 8);
      label(eng(Math.abs(i), 'A'), mx, my - 34, 0.85, 'center', 12, GREEN);
    } else if (!compact) {
      label('no current', (sx + FILM.x - 54) / 2, my - 24, 0.45, 'center', 11);
    }

    // the resistance, as a bar between the two rails it lives between
    const bx = SCENE.x + 40, bw = 250, by = SCENE.y + SCENE.h - 30;
    const f = (mem() - state.ron) / Math.max(1, state.roff - state.ron);
    ctx.fillStyle = inkA(0.07);
    rr(bx, by, bw, 14, 4);
    ctx.fill();
    ctx.fillStyle = ACC;
    rr(bx, by, Math.max(3, (1 - f) * bw), 14, 4);
    ctx.fill();
    if (!compact) {
      label('R_on', bx, by - 8, 0.4, 'left', 11);
      label('R_off', bx + bw, by - 8, 0.4, 'right', 11);
    }
    label(`M = ${fmtR(mem())}`, bx + bw + 16, by + 14, 0.95, 'left', 14, ACC);
  }

  // --- scope -----------------------------------------------------------------

  function drawScope() {
    panel(SCOPE, compact ? 'TIME' : 'OVER TIME');
    const px = SCOPE.x + (compact ? 16 : 56), py = SCOPE.y + 34, pw = SCOPE.w - (compact ? 32 : 72), ph = SCOPE.h - 50;
    const span = histSpan();
    const t1 = Math.max(span, clock), t0 = t1 - span;
    const X = (t: number) => px + ((t - t0) / span) * pw;

    let vmax = 1e-6, imax = 1e-12;
    for (const h of hist) {
      vmax = Math.max(vmax, Math.abs(h.v));
      imax = Math.max(imax, Math.abs(h.i));
    }
    const Yv = (v: number) => py + ph * 0.22 - (v / vmax) * (ph * 0.18);
    const Yi = (i: number) => py + ph * 0.62 - (i / imax) * (ph * 0.18);
    const Yx = (xx: number) => py + ph - 6 - xx * (ph * 0.26);

    ctx.strokeStyle = inkA(0.18);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(px, py);
    ctx.lineTo(px, py + ph);
    ctx.lineTo(px + pw, py + ph);
    ctx.stroke();
    for (const [y, txt] of [
      [Yv(0), '0 V'],
      [Yi(0), '0 A'],
    ] as [number, string][]) {
      ctx.strokeStyle = inkA(0.12);
      ctx.setLineDash([3, 3]);
      ctx.beginPath();
      ctx.moveTo(px, y);
      ctx.lineTo(px + pw, y);
      ctx.stroke();
      ctx.setLineDash([]);
      if (!compact) label(txt, px - 8, y + 5, 0.35, 'right', 11);
    }

    if (hist.length > 1) {
      const series: [string, (h: Sample) => number, number][] = [
        [WARM, (h) => Yv(h.v), 1.8],
        [GREEN, (h) => Yi(h.i), 1.8],
        [ACC, (h) => Yx(h.x), 2.2],
      ];
      for (const [col, fn, lw] of series) {
        ctx.strokeStyle = col;
        ctx.lineWidth = lw;
        ctx.beginPath();
        hist.forEach((h, k) => (k ? ctx.lineTo(X(h.t), fn(h)) : ctx.moveTo(X(h.t), fn(h))));
        ctx.stroke();
      }
    }
    let lx = px;
    for (const [t, c] of (compact ? [] : [['voltage', WARM], ['current', GREEN], ['w/D', ACC]]) as [string, string][]) {
      label(t, lx, SCOPE.y + 22, 0.8, 'left', 11, c);
      lx += textWidth(t, 11) + 18;
    }
  }

  // --- the pinched loop ------------------------------------------------------

  function drawLoop() {
    panel(LOOP, compact ? 'I–V' : 'CURRENT AGAINST VOLTAGE');
    const px = LOOP.x + 20, py = LOOP.y + 16, pw = LOOP.w - 40, ph = LOOP.h - 32;
    const cx = px + pw / 2, cy = py + ph / 2;
    let vmax = 1e-6, imax = 1e-12;
    for (const s of loop) {
      vmax = Math.max(vmax, Math.abs(s.v));
      imax = Math.max(imax, Math.abs(s.i));
    }
    const X = (v: number) => cx + (v / vmax) * (pw / 2) * 0.9;
    const Y = (i: number) => cy - (i / imax) * (ph / 2) * 0.9;

    ctx.strokeStyle = inkA(0.16);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(px, cy);
    ctx.lineTo(px + pw, cy);
    ctx.moveTo(cx, py);
    ctx.lineTo(cx, py + ph);
    ctx.stroke();
    label('V', px + pw, cy + 20, 0.35, 'right', 11);
    label('I', cx + 8, py + 12, 0.35, 'left', 11);

    // the trace, fading into the past so the direction of travel reads
    if (loop.length > 2) {
      for (let k = 1; k < loop.length; k++) {
        const f = k / loop.length;
        ctx.strokeStyle = `rgba(52,211,153,${(0.08 + 0.75 * f * f).toFixed(3)})`;
        ctx.lineWidth = 1.1 + 1.4 * f;
        ctx.beginPath();
        ctx.moveTo(X(loop[k - 1].v), Y(loop[k - 1].i));
        ctx.lineTo(X(loop[k].v), Y(loop[k].i));
        ctx.stroke();
      }
      const last = loop[loop.length - 1];
      ctx.fillStyle = GREEN;
      ctx.beginPath();
      ctx.arc(X(last.v), Y(last.i), 4, 0, Math.PI * 2);
      ctx.fill();
    }

    // the pinch: the one point every memristor loop has to pass through
    ctx.strokeStyle = HOT;
    ctx.lineWidth = 1.6;
    ctx.beginPath();
    ctx.arc(cx, cy, 7, 0, Math.PI * 2);
    ctx.stroke();
    if (!compact) label('pinch', cx - 11, cy + 22, 0.75, 'right', 11, HOT);
  }

  // --- the constitutive curve ------------------------------------------------

  function drawPhiQ() {
    panel(PHIQ, compact ? 'Φ–q' : 'FLUX AGAINST CHARGE');
    ctx.save();
    rr(PHIQ.x, PHIQ.y, PHIQ.w, PHIQ.h - 40, 10);
    ctx.clip();
    const px = PHIQ.x + 16, py = PHIQ.y + 16, pw = PHIQ.w - 32, ph = PHIQ.h - 52;

    let q0 = 0, q1 = 0, p0 = 0, p1 = 0;
    for (const s of pq) {
      q0 = Math.min(q0, s.q); q1 = Math.max(q1, s.q);
      p0 = Math.min(p0, s.phi); p1 = Math.max(p1, s.phi);
    }
    const qs = Math.max(1e-9, (q1 - q0) * 0.6 + 1e-12);
    const ps = Math.max(1e-9, (p1 - p0) * 0.6 + 1e-12);
    const qm = (q0 + q1) / 2, pm = (p0 + p1) / 2;
    const X = (qq: number) => px + pw / 2 + ((qq - qm) / qs) * (pw / 2) * 0.85;
    const Y = (pp: number) => py + ph / 2 - ((pp - pm) / ps) * (ph / 2) * 0.85;

    ctx.strokeStyle = inkA(0.16);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(px, Y(pm));
    ctx.lineTo(px + pw, Y(pm));
    ctx.moveTo(X(qm), py);
    ctx.lineTo(X(qm), py + ph);
    ctx.stroke();
    label('q', px + pw, Y(pm) + 20, 0.35, 'right', 11);
    label('Φ', X(qm) + 8, py + 12, 0.35, 'left', 11);

    // The device's own curve, φ(q) = ∫M dq, drawn over the range in which the
    // boundary is still free to move. The trace has to lie on it whatever the
    // drive is doing, which is what makes M a property of the device and not of
    // the experiment. A sticky boundary makes the state path-dependent, so the
    // curve is only claimed for the hard-stop case.
    if (state.win === 'hard') {
      const k = kq();
      const qlo = -X0 / k, qhi = (1 - X0) / k;
      const dR = state.roff - state.ron;
      const phiOf = (qq: number) => state.roff * qq - dR * (X0 * qq + (k * qq * qq) / 2);
      ctx.strokeStyle = inkA(0.3);
      ctx.setLineDash([4, 4]);
      ctx.lineWidth = 1.4;
      ctx.beginPath();
      for (let n = 0; n <= 60; n++) {
        const qq = qlo + ((qhi - qlo) * n) / 60;
        const px2 = X(qq), py2 = Y(phiOf(qq));
        n ? ctx.lineTo(px2, py2) : ctx.moveTo(px2, py2);
      }
      ctx.stroke();
      ctx.setLineDash([]);
    }

    if (pq.length > 2) {
      ctx.strokeStyle = VAC;
      ctx.lineWidth = 2.2;
      ctx.beginPath();
      pq.forEach((s, k) => (k ? ctx.lineTo(X(s.q), Y(s.phi)) : ctx.moveTo(X(s.q), Y(s.phi))));
      ctx.stroke();
      const last = pq[pq.length - 1];
      ctx.fillStyle = VAC;
      ctx.beginPath();
      ctx.arc(X(last.q), Y(last.phi), 4, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.restore();
    if (!compact && state.win === 'hard') label('slope = M', px, py + ph + 24, 0.45, 'left', 11);
  }

  // --- readouts --------------------------------------------------------------

  const setResult = result();
  const setEq = equation();
  /** An eng() string as TeX, with the unit upright. */
  const tex = (s: string) =>
    s.replace(/ ([^ ]+)$/, (_, u: string) =>
      '\\,' + u.replace(/([A-Za-z]+)/g, '\\mathrm{$1}').replace(/µ/g, '\\mu ').replace(/Ω/g, '\\Omega'));
  const setRow = (n: number, lab: string, val: string) => {
    el('l' + n).innerHTML = subHtml(lab);
    el('r' + n).textContent = val;
  };
  function updateReadout() {
    const v = vSource(clock);
    const i = v / mem();
    setRow(1, 'Voltage V', fixed(v, 3) + ' V');
    setRow(2, 'Current I', eng(i, 'A'));
    setRow(3, 'Resistance M', fmtR(mem()));
    setRow(4, 'State w/D', x.toFixed(4));
    setRow(5, 'Charge through q', eng(q, 'C'));
    setRow(6, 'Flux linkage Φ', eng(phi, 'Wb'));
    setRow(7, 'On/off ratio', (state.roff / state.ron).toFixed(0) + '×');
    const xs = x.toFixed(3);
    setEq({
      rule: [['v', WARM], ' = M(', ['x', ACC], ')\\,', ['i', GREEN]],
      live: ['M = R_{on}\\,', [xs, ACC], ' + R_{off}(1 - ', [xs, ACC], `) = ${tex(fmtR(mem()))}`],
    });
    setResult({
      value: fmtR(mem()),
      status: `V = ${fixed(v, 3)} V · I = ${eng(i, 'A')} · w/D = ${x.toFixed(3)}`,
      note: state.src === 'manual'
        ? 'Stop pushing and the boundary stays exactly where it is: the resistance you read now depends on everything that has flowed before.'
        : 'The current–voltage curve is a loop pinched at the origin, the fingerprint no resistor, capacitor or inductor can produce.',
    });
  }

  // --- loop ------------------------------------------------------------------

  function draw() {
    ctx.clearRect(0, 0, W, H);
    compact = isCompact(canvas);
    drawScene();
    drawScope();
    drawLoop();
    drawPhiQ();
  }

  let last = performance.now();
  function frame(now: number) {
    let dt = (now - last) / 1000;
    last = now;
    dt = Math.min(0.05, Math.max(0, dt));
    if (state.running) physics(dt);
    draw();
    updateReadout();
    requestAnimationFrame(frame);
  }

  // --- controls --------------------------------------------------------------

  const tp = transport({
    onRun: (running) => (state.running = running),
    onReset: reset,
  });

  let ready = false;
  const restart = () => { if (ready) reset(); };
  const setVs = slider('vs', (n) => (state.vs = n / 100), (n) => `${(n / 100).toFixed(2)} V`);
  const setFreq = slider('freq', (n) => (state.freq = n / 100), (n) => `${(n / 100).toFixed(2)} Hz`);
  slider('ron', (n) => (state.ron = n), (n) => fmtR(n));
  slider('roff', (n) => (state.roff = n * 100), (n) => fmtR(n * 100));
  slider('d', (n) => { state.D = n * 1e-9; restart(); }, (n) => `${n} nm`);
  slider('mu', (n) => (state.mu = (n / 100) * 1e-14), (n) => eng((n / 100) * 1e-14, 'm²/Vs', 1));
  slider('rate', (n) => (state.rate = n / 100), (n) => `${(n / 100).toFixed(1)}×`);

  function syncControls() {
    // stays in place, dimmed, so the panel never jumps
    el('ctl-f').classList.toggle('off', state.src === 'manual');
    el('ctl-f').inert = state.src === 'manual';
    el('vlab').textContent = state.src === 'manual' ? 'Drive it yourself' : 'Amplitude';
    el('ctl-v').querySelector('.scale-hint span')!.textContent =
      state.src === 'manual' ? 'drag me up and down' : 'peak volts';
    const inp = el('vs') as HTMLInputElement;
    inp.min = state.src === 'manual' ? '-150' : '0';
    if (state.src !== 'manual' && +inp.value <= 0) inp.value = '100';
    state.vs = +inp.value / 100;
    setVs(+inp.value);
  }

  const pickSrc = (v: string) => {
    state.src = v as 'manual' | 'ac' | 'pulse';
    syncControls();
    reset();
  };
  const srcSeg = segmented('src', pickSrc);
  segmented('win', (w) => (state.win = w as 'hard' | 'soft'));

  // --- what to observe -------------------------------------------------------

  const play = () => { if (!tp.running()) el('run').click(); };
  const source = (v: 'manual' | 'ac' | 'pulse') => { srcSeg.select(v); pickSrc(v); };
  const drive = (n: number) => { setVs(n); state.vs = n / 100; };
  const freq = (n: number) => { setFreq(n); state.freq = n / 100; };
  tries({
    push: () => { source('manual'); drive(100); play(); },
    loop: () => { source('ac'); drive(100); freq(100); play(); },
    fast: () => { source('ac'); drive(100); freq(600); play(); },
    latch: () => { source('pulse'); drive(150); freq(100); play(); },
  });

  syncControls();
  reset();
  ready = true;
  requestAnimationFrame(frame);
</script>

<style>
  .mr-canvas {
    touch-action: none;
  }
  .mr-opt {
    transition: opacity 0.2s;
  }
  .mr-opt.off {
    opacity: 0.35;
  }
</style>
