    touch-action: none;
  }
  .check {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.86rem;
    color: var(--text-muted);
    cursor: pointer;
    margin-bottom: 6px;
  }
  .check input {
    accent-color: var(--accent);
    width: 15px;
    height: 15px;
  }
  .scale-hint {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: var(--text-faint);
    margin-top: 3px;
  }
  .dev-only,
  .gate-only {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .dev-only[hidden],
  .gate-only[hidden] {
    display: none;
  }
</style>
