---
import SimLayout from '../../../layouts/SimLayout.astro';
---

<SimLayout
  areaSlug="electronics"
  title="Diodes & Transistors"
  description="Pick a device, turn the supply up and watch the two kinds of charge that run every chip: electrons and the holes they leave behind. A diode is a one-way valve, a transistor is a valve with a knob, and both are just doped silicon with a barrier you can raise and lower."
>
  <div class="sim">
    <div class="sim-stage">
      <canvas id="sc" class="sc-canvas" width="1000" height="880"></canvas>
    </div>

    <div class="sim-panel">
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <button class="btn" id="run">Pause</button>
        <button class="btn ghost" id="reset">Reset</button>
      </div>

      <div class="control">
        <label>Device</label>
        <select id="dev" class="select">
          <optgroup label="Diodes">
            <option value="pn">Silicon PN diode</option>
            <option value="schottky">Schottky diode</option>
            <option value="zener">Zener diode</option>
            <option value="led">LED</option>
          </optgroup>
          <optgroup label="Transistors">
            <option value="npn">NPN bipolar (BJT)</option>
            <option value="pnp">PNP bipolar (BJT)</option>
            <option value="nmos">N-channel MOSFET</option>
            <option value="pmos">P-channel MOSFET</option>
          </optgroup>
        </select>
      </div>

      <div class="control" id="ctl-colour">
        <label>LED colour</label>
        <div class="seg" id="colour">
          <button data-c="red" class="active">Red</button>
          <button data-c="green">Green</button>
          <button data-c="blue">Blue</button>
        </div>
      </div>

      <div class="control" id="ctl-vs">
        <label><span id="vslab">Supply V<sub>S</sub></span> <b id="vsval">2.0 V</b></label>
        <input type="range" id="vs" min="-120" max="120" step="1" value="20" />
        <div class="scale-hint"><span id="vsmin">reverse</span><span>forward</span></div>
      </div>

      <div class="control" id="ctl-r">
        <label><span id="rlab">Series resistor</span> <b id="rval">1.0 kΩ</b></label>
        <input type="range" id="r" min="0" max="100" step="1" value="50" />
        <div class="scale-hint"><span>10 Ω</span><span>100 kΩ</span></div>
      </div>

      <div class="control" id="ctl-ib">
        <label>Base current I<sub>B</sub> <b id="ibval">20 µA</b></label>
        <input type="range" id="ib" min="0" max="200" step="1" value="20" />
        <div class="scale-hint"><span>off</span><span>200 µA</span></div>
      </div>

      <div class="control" id="ctl-beta">
        <label>Current gain β <b id="betaval">120</b></label>
        <input type="range" id="beta" min="10" max="400" step="5" value="120" />
      </div>

      <div class="control" id="ctl-vg">
        <label>Gate voltage V<sub>GS</sub> <b id="vgval">2.50 V</b></label>
        <input type="range" id="vg" min="0" max="500" step="2" value="250" />
        <div class="scale-hint"><span>0 V</span><span>5 V</span></div>
      </div>

      <div class="control" id="ctl-vth">
        <label>Threshold V<sub>th</sub> <b id="vthval">1.00 V</b></label>
        <input type="range" id="vth" min="20" max="250" step="5" value="100" />
      </div>

      <div class="control" id="ctl-kp">
        <label>Channel strength k <b id="kpval">4.0 mA/V²</b></label>
        <input type="range" id="kp" min="5" max="200" step="5" value="40" />
        <div class="scale-hint"><span>narrow</span><span>wide</span></div>
      </div>

      <div class="control" id="ctl-dop">
        <label>Doping N <b id="dopval">1.0e16 cm⁻³</b></label>
        <input type="range" id="dop" min="150" max="185" step="1" value="160" />
        <div class="scale-hint"><span>light</span><span>heavy</span></div>
      </div>

      <div class="control" id="ctl-vz">
        <label>Zener voltage V<sub>Z</sub> <b id="vzval">5.6 V</b></label>
        <input type="range" id="vz" min="30" max="120" step="1" value="56" />
      </div>

      <div class="control" id="ctl-temp">
        <label>Temperature <b id="tempval">300 K</b></label>
        <input type="range" id="temp" min="250" max="420" step="1" value="300" />
        <div class="scale-hint"><span>cold</span><span>hot</span></div>
      </div>

      <div class="control" id="ctl-rate">
        <label>Time rate <b id="rateval">1.0×</b></label>
        <input type="range" id="rate" min="10" max="200" step="5" value="100" />
      </div>

      <label class="check"><input type="checkbox" id="ions" checked /> Show fixed dopant ions</label>

      <div class="readout">
        <div class="row"><span id="l1">Current</span><b id="r1">—</b></div>
        <div class="row"><span id="l2">Across the device</span><b id="r2">—</b></div>
        <div class="row"><span id="l3">Control input</span><b id="r3">—</b></div>
        <div class="row"><span id="l4">Operating region</span><b id="r4">—</b></div>
        <div class="row"><span id="l5">Barrier</span><b id="r5">—</b></div>
        <div class="row"><span id="l6">Measured</span><b id="r6">—</b></div>
        <div class="row"><span id="l7">Power in the device</span><b id="r7">—</b></div>
      </div>

      <p style="font-size:.82rem;color:var(--text-faint);margin:0;line-height:1.5">
        Blue dots are electrons, red dots are holes. The pale circled charges are
        dopant atoms bolted into the crystal: they never move, they only set up
        the built-in field.
      </p>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Start with the PN diode and the supply at zero. Nothing flows, yet nothing
      is still: every carrier jitters. Look at the middle. Holes stop short on
      the left, electrons stop short on the right, and between them sits a strip
      of naked dopant ions, the <b>depletion region</b>. Its field is exactly
      what keeps the two crowds apart.
    </li>
    <li>
      Push the supply up slowly. Below about 0.6 V almost nothing happens, then
      the current takes off. Watch why: forward bias <b>shrinks the depletion
      region</b> until the crowds can reach each other, and every crossing ends
      in a recombination flash. The knee is not a threshold anybody built in, it
      is an exponential caught in the act.
    </li>
    <li>
      Now drive the supply negative. The depletion region swells, the carriers
      are pushed back to their contacts, and the current falls to a leak worth
      picoamps. One device, two completely different behaviours, from nothing
      but which way the barrier leans.
    </li>
    <li>
      Raise the temperature with the diode forward biased. The forward drop
      falls by roughly 2 mV per kelvin and the reverse leak climbs fast, because
      heat generates electron and hole pairs on its own. This is why datasheets
      never quote 0.7 V without a temperature next to it.
    </li>
    <li>
      Switch to the Zener and sweep the supply to −10 V. Past V<sub>Z</sub> the
      reverse barrier gives way and the current comes back hard, but the voltage
      across the device barely moves. That flat wall in the I-V plot is the whole
      reason Zeners exist: a voltage reference made of a controlled failure.
    </li>
    <li>
      Pick the LED and try each colour. Blue needs about 2.9 V, red about 1.9 V,
      and the photons only appear where electrons and holes actually meet. The
      forward drop is not a design choice, it is the band gap, and the band gap
      is the colour.
    </li>
    <li>
      Watch a recombination closely, then switch between the silicon diode and
      the LED. It is the same event either way, an electron dropping into a
      hole, and the energy has to leave. Silicon hands it to the crystal as
      <b>heat</b>, the LED hands it over as a <b>photon</b>. That single
      difference, direct gap against indirect gap, is why one of them lights up
      and the other just gets warm.
    </li>
    <li>
      Go to the NPN and set the base current to a few microamps. Count the
      streams: a trickle of holes goes into the base, a flood of electrons
      crosses it into the collector. The measured gain settles near β, and yet
      the base is doing nothing but letting the emitter's electrons over a hill
      it has lowered.
    </li>
    <li>
      Keep raising I<sub>B</sub>. The collector current climbs, then stops:
      V<sub>CE</sub> has hit the bottom and the resistor now owns the current.
      That is <b>saturation</b>, the transistor used as a closed switch. Between
      cutoff and saturation lies the active region where it is an amplifier.
    </li>
    <li>
      Switch to the NMOS with the gate at 0 V. No channel exists at all, just a
      depletion region under the oxide. Raise V<sub>GS</sub> past V<sub>th</sub>
      and an <b>inversion layer</b> of electrons condenses at the surface out of
      nowhere. No current ever flows into the gate: it is a capacitor plate, and
      that is why CMOS logic burns almost nothing while it holds a value.
    </li>
    <li>
      With the channel on, raise the drain voltage. The channel tapers, thins to
      a point, and <b>pinches off</b>, and from there the current stops caring
      about V<sub>DS</sub>. Note the carriers speed up where the channel is
      thinnest: the same current through a narrower pipe.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText, subHtml } from '../../../lib/sim';

  // ---------------------------------------------------------------------------
  // Devices are simulated at two levels at once: a compact-model DC solve that
  // gives the true operating point (load line + device equation), and a carrier
  // animation whose speeds and spawn rates are driven by that solved current.
  // The particles are illustrative, the numbers in the readout are not.
  // ---------------------------------------------------------------------------

  type Dev = 'pn' | 'schottky' | 'zener' | 'led' | 'npn' | 'pnp' | 'nmos' | 'pmos';

  const state = {
    dev: 'pn' as Dev,
    colour: 'red' as 'red' | 'green' | 'blue',
    vs: 2, // supply, V
    r: 1000, // series resistor, Ω
    ib: 20, // base current, µA
    beta: 120,
    vg: 2.5, // gate voltage, V
    vth: 1.0,
    kp: 4, // mA/V²
    dop: 16, // log10 doping in cm^-3
    vz: 5.6,
    temp: 300,
    rate: 1,
    running: true,
    ions: true,
  };

  const isDiode = () => ['pn', 'schottky', 'zener', 'led'].includes(state.dev);
  const isBJT = () => state.dev === 'npn' || state.dev === 'pnp';
  const isMOS = () => state.dev === 'nmos' || state.dev === 'pmos';
  /** PNP and PMOS are the same picture with the two carriers swapped. */
  const flipped = () => state.dev === 'pnp' || state.dev === 'pmos';
  /** Sign used only when reporting voltages and currents to the reader. */
  const sgn = () => (flipped() ? -1 : 1);

  const ELECTRON = 0, HOLE = 1;

  // --- physics ---------------------------------------------------------------

  const K_OVER_Q = 8.617333e-5; // V/K
  const VT = () => K_OVER_Q * state.temp;

  const LED_COLOURS = {
    red: { vf: 1.9, eg: 1.95, css: '#ff5a52' },
    green: { vf: 2.2, eg: 2.25, css: '#4ade80' },
    blue: { vf: 2.9, eg: 2.95, css: '#5b9dff' },
  };

  /** Built-in potential from the doping: Vbi = Vt ln(Na Nd / ni²). */
  function vbiCalc() {
    const N = Math.pow(10, state.dop);
    return VT() * Math.log((N * N) / 1e20);
  }

  /**
   * Saturation current tracks T³ exp(−Eg/kT), which is where the famous
   * −2 mV/K forward drop and the doubling leakage every 10 K come from.
   */
  function satScale(eg: number) {
    const t = state.temp;
    return (
      Math.pow(t / 300, 3) * Math.exp((eg / K_OVER_Q) * (1 / 300 - 1 / t))
    );
  }

  function dparams() {
    switch (state.dev) {
      case 'schottky':
        // A metal-semiconductor barrier: no minority injection, so it turns on
        // early (~0.3 V) and leaks far more than a PN junction.
        return { is: 1e-8, n: 1.05, eg: 0.72, vbr: 25, vbi: 0.55 };
      case 'zener':
        return { is: 1e-14, n: 1.0, eg: 1.12, vbr: state.vz, vbi: vbiCalc() };
      case 'led': {
        const c = LED_COLOURS[state.colour];
        const n = 1.85;
        // Pin Is so the forward drop lands on the colour's photon energy.
        return {
          is: 1e-3 / Math.exp(c.vf / (n * 0.02585)),
          n,
          eg: c.eg,
          vbr: 12,
          // A wide-gap junction sits most of its band gap high, which is
          // exactly why the forward drop is the colour.
          vbi: c.eg - 0.2,
        };
      }
      default:
        return { is: 1e-14, n: 1.0, eg: 1.12, vbr: 60, vbi: vbiCalc() };
    }
  }

  // High enough that a blue LED's 2.9 V exponent is never truncated, low
  // enough that Is·exp() cannot reach Infinity for any slider setting.
  const EXP_CAP = 200;
  const ex = (x: number) => Math.exp(Math.min(x, EXP_CAP));

  /** Diode I(V), monotonic in V: forward exponential minus a breakdown term. */
  function diodeI(v: number) {
    const p = dparams();
    const vt = VT();
    const isat = p.is * satScale(p.eg);
    const fwd = isat * (ex(v / (p.n * vt)) - 1);
    const brk = 1e-9 * ex((-v - p.vbr) / 0.025);
    return fwd - brk;
  }

  /** Bisect the load line Vs = I R + V against the device equation. */
  function solveDiode() {
    let lo = -90, hi = 6;
    const f = (v: number) => (state.vs - v) / state.r - diodeI(v);
    for (let i = 0; i < 90; i++) {
      const m = 0.5 * (lo + hi);
      if (f(m) > 0) lo = m;
      else hi = m;
    }
    const v = 0.5 * (lo + hi);
    return { v, i: (state.vs - v) / state.r };
  }

  const VA = 80; // Early voltage
  /** Collector current with a soft knee, so the solve stays monotonic. */
  function bjtIc(vce: number, ibA: number, beta: number) {
    const v = Math.max(0, vce);
    return beta * ibA * (1 + v / VA) * Math.tanh(v / 0.09);
  }

  function solveBJT() {
    const ibA = state.ib * 1e-6;
    let lo = 0, hi = Math.max(0.001, state.vs);
    const f = (v: number) => (state.vs - v) / state.r - bjtIc(v, ibA, state.beta);
    for (let i = 0; i < 70; i++) {
      const m = 0.5 * (lo + hi);
      if (f(m) > 0) lo = m;
      else hi = m;
    }
    const vce = 0.5 * (lo + hi);
    const ic = (state.vs - vce) / state.r;
    const vbe = ibA > 0 ? VT() * Math.log(1 + ibA / 1e-16) : 0;
    let region: string;
    if (state.ib < 0.05) region = 'cutoff (switch off)';
    else if (ic < 0.95 * state.beta * ibA || vce < 0.3) region = 'saturation (switch on)';
    else region = 'forward active (amplifier)';
    return { vce, ic, ib: ibA, vbe, region };
  }

  /** Long-channel MOSFET with a subthreshold tail, so "off" is never exactly 0. */
  function mosId(vds: number, vgs: number) {
    const vov = vgs - state.vth;
    const k = state.kp * 1e-3;
    const v = Math.max(0, vds);
    if (vov <= 0) return 1e-9 * ex(vov / 0.075) * (1 - Math.exp(-v / 0.04));
    if (v < vov) return k * (vov * v - 0.5 * v * v);
    return 0.5 * k * vov * vov * (1 + 0.02 * (v - vov));
  }

  function solveMOS() {
    let lo = 0, hi = Math.max(0.001, state.vs);
    const f = (v: number) => (state.vs - v) / state.r - mosId(v, state.vg);
    for (let i = 0; i < 70; i++) {
      const m = 0.5 * (lo + hi);
      if (f(m) > 0) lo = m;
      else hi = m;
    }
    const vds = 0.5 * (lo + hi);
    const id = (state.vs - vds) / state.r;
    const vov = state.vg - state.vth;
    let region: string;
    if (vov <= 0) region = 'cutoff (no channel)';
    else if (vds < vov) region = 'triode (resistive)';
    else region = 'saturation (pinched off)';
    return { vds, id, vov, region };
  }

  // The one operating point everything on screen is drawn from.
  type OP = {
    i: number; // current through the series resistor
    v1: number; // voltage across the device (Vd / Vce / Vds)
    v2: number; // control voltage (Vbe / Vgs)
    region: string;
    vov: number;
  };
  let op: OP = { i: 0, v1: 0, v2: 0, region: '', vov: 0 };

  function solve() {
    if (isDiode()) {
      const d = solveDiode();
      const p = dparams();
      let region: string;
      if (Math.abs(d.v) < 0.002 && Math.abs(state.vs) < 0.002) region = 'equilibrium (no bias)';
      else if (d.v > 0.15) region = 'forward (conducting)';
      else if (d.v < -p.vbr + 0.35) region = 'reverse breakdown';
      else region = 'reverse (blocking)';
      op = { i: d.i, v1: d.v, v2: 0, region, vov: 0 };
    } else if (isBJT()) {
      const b = solveBJT();
      op = { i: b.ic, v1: b.vce, v2: b.vbe, region: b.region, vov: 0 };
    } else {
      const m = solveMOS();
      op = { i: m.id, v1: m.vds, v2: state.vg, region: m.region, vov: m.vov };
    }
  }

  /** Depletion width in metres for the current diode bias. */
  function depWidth(v: number) {
    const N = Math.pow(10, state.dop) * 1e6; // m^-3
    const eps = 11.7 * 8.854e-12, q = 1.602e-19;
    const psi = Math.max(0.02, dparams().vbi - v);
    return Math.sqrt(((2 * eps * psi) / q) * (2 / N));
  }

  // --- formatting ------------------------------------------------------------

  function fmtI(i: number) {
    const a = Math.abs(i);
    if (a < 1e-12) return (i * 1e15).toFixed(1) + ' fA';
    if (a < 1e-9) return (i * 1e12).toFixed(1) + ' pA';
    if (a < 1e-6) return (i * 1e9).toFixed(2) + ' nA';
    if (a < 1e-3) return (i * 1e6).toFixed(2) + ' µA';
    if (a < 1) return (i * 1e3).toFixed(3) + ' mA';
    return i.toFixed(3) + ' A';
  }
  function fmtR(r: number) {
    if (r >= 1000) return (r / 1000).toFixed(r >= 10000 ? 0 : 1) + ' kΩ';
    return r.toFixed(0) + ' Ω';
  }
  function fmtP(p: number) {
    const a = Math.abs(p);
    if (a < 1e-3) return (p * 1e6).toFixed(1) + ' µW';
    if (a < 1) return (p * 1e3).toFixed(2) + ' mW';
    return p.toFixed(3) + ' W';
  }

  // --- canvas ----------------------------------------------------------------

  const canvas = document.getElementById('sc') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const cssVar = (v: string) => getComputedStyle(canvas).getPropertyValue(v).trim();
  const ink = () => cssVar('--stage-ink') || '232,233,236';
  const inkA = (a: number) => `rgba(${ink()},${a})`;
  const { label, textWidth } = makeText(ctx, inkA);

  const C_E = '#5b8cff'; // electrons
  const C_H = '#f9736a'; // holes
  const ACC = '#7c8cff';
  const WARM = '#f59e0b';
  const GREEN = '#34d399';

  const cCarrier = (t: number) => (t === ELECTRON ? C_E : C_H);

  // The cross-section gets the whole top half: recombination, the depletion
  // region and the channel taper are the things worth looking at closely.
  const DEV = { x: 20, y: 76, w: 960, h: 452 };
  const CIR = { x: 20, y: 566, w: 230, h: 294 };
  const BAND = { x: 270, y: 566, w: 340, h: 294 };
  const IV = { x: 630, y: 566, w: 350, h: 294 };

  const BAR = { x: 156, y: 150, w: 692, h: 286 };

  function rr(x: number, y: number, w: number, h: number, r: number) {
    const rad = Math.min(r, w / 2, h / 2);
    ctx.beginPath();
    ctx.moveTo(x + rad, y);
    ctx.lineTo(x + w - rad, y);
    ctx.quadraticCurveTo(x + w, y, x + w, y + rad);
    ctx.lineTo(x + w, y + h - rad);
    ctx.quadraticCurveTo(x + w, y + h, x + w - rad, y + h);
    ctx.lineTo(x + rad, y + h);
    ctx.quadraticCurveTo(x, y + h, x, y + h - rad);
    ctx.lineTo(x, y + rad);
    ctx.quadraticCurveTo(x, y, x + rad, y);
    ctx.closePath();
  }

  function panel(p: { x: number; y: number; w: number; h: number }, title: string) {
    ctx.strokeStyle = inkA(0.1);
    ctx.lineWidth = 1;
    rr(p.x, p.y, p.w, p.h, 10);
    ctx.stroke();
    label(title, p.x + 2, p.y - 8, 0.5);
  }

  function arrow(x1: number, y1: number, x2: number, y2: number, size = 5) {
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y2);
    ctx.stroke();
    const a = Math.atan2(y2 - y1, x2 - x1);
    ctx.beginPath();
    ctx.moveTo(x2, y2);
    ctx.lineTo(x2 - size * Math.cos(a - 0.4), y2 - size * Math.sin(a - 0.4));
    ctx.lineTo(x2 - size * Math.cos(a + 0.4), y2 - size * Math.sin(a + 0.4));
    ctx.closePath();
    ctx.fill();
  }

  // --- carriers --------------------------------------------------------------

  type Carrier = {
    x: number;
    y: number;
    t: number; // logical type before the PNP/PMOS swap
    st: number; // 0 = majority at home, 1 = injected minority, 2 = swept
    rx: number; // where it will recombine, when injected
    home: number; // 0 = left contact, 1 = right contact, 2 = base/gate contact
    sp: number; // per-particle speed spread
  };

  let carriers: Carrier[] = [];
  /** kind 0 = a pair recombined here, 1 = a pair was generated here. */
  type Flash = { x: number; y: number; life: number; kind: number };
  let flashes: Flash[] = [];
  /**
   * What the recombination gives off. Silicon hands the energy to the lattice
   * as heat, a direct-gap LED hands it over as a photon: same event, and the
   * difference is the whole reason one of them lights up.
   */
  type Quantum = { x: number; y: number; vx: number; vy: number; life: number; light: boolean; ph: number };
  let quanta: Quantum[] = [];
  let nCross = 0, nBase = 0; // BJT gain tally
  let clock = 0;

  const rnd = (a: number, b: number) => a + Math.random() * (b - a);
  /** Exponentially distributed hop, the shape a diffusion length really has. */
  const expRand = (mean: number) => -mean * Math.log(1 - Math.random() * 0.98);

  function newCarrier(x: number, y: number, t: number, home: number): Carrier {
    return { x, y, t, st: 0, rx: 0, home, sp: rnd(0.75, 1.3) };
  }

  function buildCarriers() {
    carriers = [];
    flashes = [];
    quanta = [];
    nCross = 0;
    nBase = 0;
    if (isDiode()) {
      const w = depPx();
      for (let i = 0; i < 105; i++)
        carriers.push(
          newCarrier(rnd(BAR.x + 6, xJ() - w / 2 - 8), rndY(), HOLE, 0)
        );
      for (let i = 0; i < 105; i++)
        carriers.push(
          newCarrier(rnd(xJ() + w / 2 + 8, BAR.x + BAR.w - 6), rndY(), ELECTRON, 1)
        );
    } else if (isBJT()) {
      for (let i = 0; i < 96; i++)
        carriers.push(newCarrier(rnd(BAR.x + 6, EB() - 20), rndY(), ELECTRON, 0));
      for (let i = 0; i < 54; i++)
        carriers.push(
          newCarrier(rnd(BC() + 24, BAR.x + BAR.w - 6), rndY(), ELECTRON, 1)
        );
      for (let i = 0; i < 22; i++)
        carriers.push(newCarrier(rnd(EB() + 8, BC() - 8), rndY(), HOLE, 2));
    } else {
      const s = mosGeom();
      for (let i = 0; i < 30; i++)
        carriers.push(
          newCarrier(rnd(s.src.x + 4, s.src.x + s.src.w - 4), rnd(s.src.y + 6, s.src.y + s.src.h - 4), ELECTRON, 0)
        );
      for (let i = 0; i < 30; i++) {
        // Drain-side electrons start "already collected", so they live in the
        // drain well instead of being clamped into the source.
        const c = newCarrier(
          rnd(s.drn.x + 4, s.drn.x + s.drn.w - 4),
          rnd(s.drn.y + 6, s.drn.y + s.drn.h - 4),
          ELECTRON,
          1
        );
        c.st = 2;
        carriers.push(c);
      }
      for (let i = 0; i < 46; i++)
        carriers.push(
          newCarrier(rnd(s.sub.x + 8, s.sub.x + s.sub.w - 8), rnd(s.sub.y + 80, s.sub.y + s.sub.h - 8), HOLE, 2)
        );
    }
  }

  const rndY = () => rnd(BAR.y + 14, BAR.y + BAR.h - 14);
  const xJ = () => BAR.x + BAR.w / 2;
  const EB = () => BAR.x + 268; // emitter-base junction
  const BC = () => BAR.x + 368; // base-collector junction

  /** Depletion width in pixels, from the physical width. */
  function depPx() {
    const nm = depWidth(op.v1) * 1e9;
    return Math.max(12, Math.min(300, nm * 0.26));
  }

  function mosGeom() {
    const sub = { x: BAR.x, y: BAR.y + 54, w: BAR.w, h: BAR.h - 54 };
    const src = { x: sub.x + 26, y: sub.y, w: 150, h: 58 };
    const drn = { x: sub.x + sub.w - 176, y: sub.y, w: 150, h: 58 };
    const gate = { x: src.x + src.w - 20, y: sub.y - 40, w: drn.x - src.x - src.w + 40, h: 18 };
    const ox = { x: gate.x, y: sub.y - 14, w: gate.w, h: 11 };
    return { sub, src, drn, gate, ox };
  }

  /** Animation speed in px/s from the solved current: log so µA still moves. */
  function flowSpeed(i: number) {
    return Math.min(250, 42 * Math.log10(1 + Math.abs(i) / 2e-7));
  }

  const THERM = 40; // thermal jitter, px/s

  function jitter(c: Carrier, dt: number) {
    c.x += (Math.random() - 0.5) * THERM * dt * 2;
    c.y += (Math.random() - 0.5) * THERM * dt * 2;
  }

  function clampY(c: Carrier, top: number, bot: number) {
    if (c.y < top) c.y = top;
    if (c.y > bot) c.y = bot;
  }

  function flash(x: number, y: number) {
    flashes.push({ x, y, life: 1, kind: 0 });
    const light = state.dev === 'led';
    const a = light ? rnd(-Math.PI, 0) : rnd(-2.5, -0.65);
    const sp = light ? 150 : 40;
    quanta.push({ x, y, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp, life: 1, light, ph: rnd(0, 6.3) });
  }

  // --- carrier updates -------------------------------------------------------

  function stepDiode(dt: number) {
    const i = op.i;
    const fwd = i > 1e-9;
    const sp = flowSpeed(i);
    const w = depPx();
    const xL = xJ() - w / 2, xR = xJ() + w / 2;
    const top = BAR.y + 6, bot = BAR.y + BAR.h - 6;
    const L = 42; // diffusion length in px

    for (const c of carriers) {
      jitter(c, dt);
      clampY(c, top, bot);
      if (c.st === 0) {
        if (fwd) {
          const dir = c.t === HOLE ? 1 : -1;
          c.x += dir * sp * c.sp * dt;
          if (c.t === HOLE && c.x > xL) {
            c.st = 1;
            c.rx = xR + expRand(L);
          } else if (c.t === ELECTRON && c.x < xR) {
            c.st = 1;
            c.rx = xL - expRand(L);
          }
        }
        // Still a majority carrier, so the depletion region is a wall: it is
        // what stops them even at zero bias. Only ever applied to carriers
        // that did not just cross, otherwise the wall would hold them for
        // several frames and pile them into a fake queue. The random bounce
        // keeps that crowd from lining up dead straight.
        if (c.st === 0) {
          // Under reverse bias the wall throws them back a random step, which
          // is the crowd piling up outside a barrier they cannot climb. Under
          // forward bias it only stops them at the very edge, so the next
          // step carries them across instead of queueing there for frames.
          const back = fwd ? 0.5 : 1 + Math.random() * 14;
          if (c.t === HOLE) c.x = Math.min(c.x, xL - back);
          else c.x = Math.max(c.x, xR + back);
          c.x = Math.max(BAR.x + 4, Math.min(BAR.x + BAR.w - 4, c.x));
        }
      } else if (c.st === 1) {
        const dir = c.t === HOLE ? 1 : -1;
        c.x += dir * sp * 1.15 * c.sp * dt;
        const done = c.t === HOLE ? c.x >= c.rx : c.x <= c.rx;
        const out = c.x > BAR.x + BAR.w - 6 || c.x < BAR.x + 6;
        if (done || out) {
          flash(c.x, c.y);
          respawnDiode(c);
        }
      }
    }

    // Reverse leakage and breakdown: pairs generated inside the depletion
    // region and pulled apart by its field.
    if (!fwd) {
      const rate = Math.min(70, Math.abs(i) / 2e-8);
      if (Math.random() < rate * dt) {
        const y = rndY();
        const x = rnd(xL, xR);
        const e = newCarrier(x, y, ELECTRON, 1);
        e.st = 2;
        const h = newCarrier(x, y, HOLE, 0);
        h.st = 2;
        carriers.push(e, h);
        flashes.push({ x, y, life: 1, kind: 1 });
      }
    }
    // swept pairs head for their contacts and vanish there
    for (let k = carriers.length - 1; k >= 0; k--) {
      const c = carriers[k];
      if (c.st !== 2) continue;
      const dir = c.t === HOLE ? -1 : 1;
      c.x += dir * Math.max(90, sp) * dt;
      if (c.x < BAR.x + 4 || c.x > BAR.x + BAR.w - 4) carriers.splice(k, 1);
    }
    if (carriers.length > 420) carriers.splice(0, carriers.length - 420);
  }

  function respawnDiode(c: Carrier) {
    c.st = 0;
    c.y = rndY();
    if (c.t === HOLE) c.x = BAR.x + rnd(6, 44);
    else c.x = BAR.x + BAR.w - rnd(6, 44);
  }

  function stepBJT(dt: number) {
    const ic = op.i;
    const ibA = state.ib * 1e-6;
    const on = op.v2 > 0.45 && state.ib > 0.05;
    const spE = flowSpeed(ic);
    const spB = flowSpeed(ibA);
    const top = BAR.y + 6, bot = BAR.y + BAR.h - 6;
    const eb = EB(), bc = BC();
    const ebw = on ? 8 : 22; // forward bias thins the emitter junction
    const bcw = 14 + 20 * Math.sqrt(Math.max(0.05, op.v1));
    const frac = 1 / (1 + state.beta); // share of electrons lost in the base

    for (const c of carriers) {
      jitter(c, dt);
      clampY(c, top, bot);
      if (c.t === ELECTRON && c.home === 0) {
        if (c.st === 0) {
          if (on) {
            c.x += spE * c.sp * dt;
            if (c.x > eb - ebw) {
              c.st = 1;
              c.rx = Math.random() < frac ? rnd(eb + 6, bc - 6) : 1e9;
            }
          }
          // Same rule as the diode: only carriers that have not just been
          // injected feel the emitter barrier.
          if (c.st === 0) {
            c.x = Math.min(c.x, eb - ebw - (on ? 0.5 : 1 + Math.random() * 14));
            c.x = Math.max(BAR.x + 4, c.x);
          }
        } else if (c.st === 1) {
          // Inside the base: sprint across, unless this one is the unlucky
          // 1 in (β+1) that meets a hole first.
          c.x += spE * 1.25 * c.sp * dt;
          if (c.x >= c.rx) {
            flash(c.x, c.y);
            nBase++;
            c.st = 0;
            c.x = BAR.x + rnd(6, 40);
            c.y = rndY();
          } else if (c.x > bc) {
            c.st = 2;
          }
        } else if (c.st === 2) {
          // Swept down the collector field, then collected.
          c.x += spE * 2.1 * c.sp * dt;
          if (c.x > BAR.x + BAR.w - 6) {
            nCross++;
            c.st = 0;
            c.x = BAR.x + rnd(6, 40);
            c.y = rndY();
          }
        }
      } else if (c.t === ELECTRON && c.home === 1) {
        // Collector majority carriers drift out through the contact and into
        // the wire, so send them back in at the junction side rather than
        // letting them stack against the edge.
        c.x += spE * 0.3 * c.sp * dt;
        if (c.x > BAR.x + BAR.w - 6) {
          c.x = bc + bcw + rnd(0, 50);
          c.y = rndY();
        }
        c.x = Math.max(bc + bcw, c.x);
      } else {
        // Base holes come in from the base contact and are used up.
        if (on) {
          c.y += spB * 0.5 * c.sp * dt;
          c.x -= spB * 0.35 * c.sp * dt;
        }
        if (c.x < eb - 2 || c.y > bot - 2) {
          c.x = rnd(eb + 8, bc - 8);
          c.y = BAR.y + rnd(2, 22);
        }
        c.x = Math.max(eb - 2, Math.min(bc - 2, c.x));
      }
    }
  }

  function stepMOS(dt: number) {
    const g = mosGeom();
    const id = op.i;
    const vov = op.vov;
    const on = vov > 0;
    const sp = flowSpeed(id);
    const chTop = g.sub.y + 1;

    for (const c of carriers) {
      jitter(c, dt);
      if (c.t === HOLE) {
        // Holes are repelled from the surface as the gate goes positive: that
        // repulsion is the depletion region, and it comes before inversion.
        const dep = depthPx(state.vg);
        c.x = Math.max(g.sub.x + 6, Math.min(g.sub.x + g.sub.w - 6, c.x));
        const insideGate = c.x > g.gate.x && c.x < g.gate.x + g.gate.w;
        const floor = insideGate ? g.sub.y + dep : g.sub.y + 66;
        if (c.y < floor) c.y += 50 * dt + (floor - c.y) * 3 * dt;
        c.y = Math.max(floor, Math.min(g.sub.y + g.sub.h - 6, c.y));
        continue;
      }
      if (c.st === 0) {
        // sitting in the source
        c.x = Math.max(g.src.x + 4, Math.min(g.src.x + g.src.w - 2, c.x));
        clampY(c, g.src.y + 5, g.src.y + g.src.h - 4);
        if (on && c.x > g.src.x + g.src.w - 18 && Math.random() < 3 * dt) {
          c.st = 1;
          c.y = chTop + rnd(1, 5);
        } else if (on) {
          c.x += sp * 0.5 * c.sp * dt;
        }
      } else if (c.st === 1) {
        // in the channel: same current through a thinner pipe means faster
        const u = (c.x - g.src.x - g.src.w) / (g.drn.x - g.src.x - g.src.w);
        const th = channelThickness(Math.max(0, Math.min(1, u)));
        c.x += sp * c.sp * dt * Math.min(4, 18 / Math.max(4, th));
        c.y = chTop + rnd(0.5, Math.max(2.5, th - 1.5));
        if (c.x >= g.drn.x) {
          c.st = 2;
          c.x = g.drn.x + 2;
        }
        if (!on) {
          c.st = 0;
          c.x = g.src.x + g.src.w - 14;
        }
      } else {
        // in the drain, then recycled back to the source contact
        c.x += sp * (c.home === 0 ? 1.1 : 0.4) * c.sp * dt;
        clampY(c, g.drn.y + 5, g.drn.y + g.drn.h - 4);
        if (c.x > g.drn.x + g.drn.w - 4) {
          if (c.home === 1) {
            c.x = rnd(g.drn.x + 4, g.drn.x + g.drn.w - 6);
          } else {
            c.st = 0;
            c.x = rnd(g.src.x + 4, g.src.x + 44);
            c.y = rnd(g.src.y + 6, g.src.y + g.src.h - 4);
          }
        }
      }
    }
  }

  /** How deep the gate has pushed the holes away, in px. */
  function depthPx(vg: number) {
    return 12 + 42 * Math.sqrt(Math.max(0, Math.min(vg, state.vth)) / Math.max(0.2, state.vth));
  }

  /**
   * Channel thickness at fraction u along it. V(u) follows from the same
   * gradual-channel integral that gives the square-law current, so the taper
   * and the pinch-off point are not decoration.
   */
  function channelThickness(u: number) {
    const vov = op.vov;
    if (vov <= 0) return 0;
    const k = state.kp * 1e-3;
    const inner = Math.max(0, vov * vov - (2 * op.i * u) / k);
    const local = Math.sqrt(inner); // = Vov − V(u)
    return 2 + 15 * (local / vov);
  }

  function stepCarriers(dt: number) {
    if (isDiode()) stepDiode(dt);
    else if (isBJT()) stepBJT(dt);
    else stepMOS(dt);

    for (let k = flashes.length - 1; k >= 0; k--) {
      flashes[k].life -= dt * 2.1;
      if (flashes[k].life <= 0) flashes.splice(k, 1);
    }
    for (let k = quanta.length - 1; k >= 0; k--) {
      const q = quanta[k];
      q.x += q.vx * dt;
      q.y += q.vy * dt;
      q.life -= dt * (q.light ? 1.4 : 1.1);
      if (q.life <= 0) quanta.splice(k, 1);
    }
    if (quanta.length > 120) quanta.splice(0, quanta.length - 120);
  }

  // --- device drawing --------------------------------------------------------

  /** `raw` keeps electrons electrons: the band diagram never swaps carriers. */
  function drawCarrier(x: number, y: number, t: number, r = 3.2, raw = false) {
    const tt = flipped() && !raw ? 1 - t : t;
    ctx.fillStyle = cCarrier(tt);
    ctx.beginPath();
    ctx.arc(x, y, r, 0, Math.PI * 2);
    ctx.fill();
  }

  function drawIon(x: number, y: number, positive: boolean) {
    ctx.strokeStyle = positive ? 'rgba(249,115,106,0.45)' : 'rgba(91,140,255,0.45)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.arc(x, y, 5.6, 0, Math.PI * 2);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(x - 3, y);
    ctx.lineTo(x + 3, y);
    if (positive) {
      ctx.moveTo(x, y - 3);
      ctx.lineTo(x, y + 3);
    }
    ctx.stroke();
  }

  function contact(x: number, y: number, w: number, h: number) {
    ctx.fillStyle = inkA(0.16);
    rr(x, y, w, h, 3);
    ctx.fill();
  }

  function wire(x1: number, y1: number, x2: number, y2: number) {
    ctx.strokeStyle = inkA(0.4);
    ctx.lineWidth = 1.6;
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y2);
    ctx.stroke();
  }

  const P_TINT = 'rgba(249,115,106,0.07)';
  const N_TINT = 'rgba(91,140,255,0.075)';
  const NP_TINT = 'rgba(91,140,255,0.13)';

  function regionFill(x: number, w: number, tint: string, y = BAR.y, h = BAR.h) {
    ctx.fillStyle = tint;
    ctx.fillRect(x, y, w, h);
  }

  function drawDiodeDevice() {
    const w = depPx();
    const xL = xJ() - w / 2, xR = xJ() + w / 2;
    const pt = flipped() ? N_TINT : P_TINT;
    const nt = flipped() ? P_TINT : N_TINT;
    regionFill(BAR.x, xL - BAR.x, pt);
    regionFill(xR, BAR.x + BAR.w - xR, nt);
    ctx.fillStyle = inkA(0.05);
    ctx.fillRect(xL, BAR.y, w, BAR.h);

    if (state.dev === 'schottky') {
      // A metal on one side, not a p-type crystal.
      ctx.fillStyle = inkA(0.14);
      ctx.fillRect(BAR.x, BAR.y, xL - BAR.x, BAR.h);
    }

    // fixed dopant ions, uncovered exactly where the mobile charge left
    if (state.ions) {
      const cols = Math.max(1, Math.floor(w / 24));
      const rows = 6;
      for (let r = 0; r < rows; r++)
        for (let cI = 0; cI < cols; cI++) {
          const x = xL + ((cI + 0.5) * w) / cols;
          const y = BAR.y + 26 + r * ((BAR.h - 78) / (rows - 1));
          drawIon(x, y, x > xJ());
        }
    }

    // built-in field arrows point from the donor ions to the acceptor ions
    ctx.strokeStyle = inkA(0.3);
    ctx.fillStyle = inkA(0.3);
    ctx.lineWidth = 1.2;
    if (w > 28) {
      for (let r = 0; r < 3; r++) {
        const y = BAR.y + 60 + r * 74;
        arrow(xR - 5, y, xL + 5, y, 6);
      }
      if (w > 96) label('built-in field E', (xL + xR) / 2, BAR.y + BAR.h - 10, 0.5, 'center', 10);
    }

    ctx.strokeStyle = inkA(0.18);
    ctx.lineWidth = 1;
    ctx.strokeRect(BAR.x, BAR.y, BAR.w, BAR.h);
    ctx.setLineDash([3, 3]);
    ctx.strokeStyle = inkA(0.3);
    ctx.beginPath();
    ctx.moveTo(xL, BAR.y);
    ctx.lineTo(xL, BAR.y + BAR.h);
    ctx.moveTo(xR, BAR.y);
    ctx.lineTo(xR, BAR.y + BAR.h);
    ctx.stroke();
    ctx.setLineDash([]);

    // avalanche glow when the reverse barrier gives way
    if (op.i < -1e-6) {
      const g = Math.min(0.3, Math.abs(op.i) * 40);
      ctx.fillStyle = `rgba(245,158,11,${g})`;
      ctx.fillRect(xL, BAR.y, w, BAR.h);
    }

    const leftLab = state.dev === 'schottky' ? 'metal' : flipped() ? 'n-type' : 'p-type';
    const rightLab = flipped() ? 'p-type' : 'n-type';
    label(`${leftLab}  ·  anode`, BAR.x + 4, BAR.y - 14, 0.5, 'left', 12);
    label(`cathode  ·  ${rightLab}`, BAR.x + BAR.w - 4, BAR.y - 14, 0.5, 'right', 12);

    const nm = depWidth(op.v1) * 1e9;
    label(
      `depletion region  W = ${nm < 1000 ? nm.toFixed(0) + ' nm' : (nm / 1000).toFixed(2) + ' µm'}`,
      xJ(),
      BAR.y + BAR.h + 28,
      0.5,
      'center',
      12
    );
    ctx.strokeStyle = inkA(0.28);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(xL, BAR.y + BAR.h + 10);
    ctx.lineTo(xR, BAR.y + BAR.h + 10);
    ctx.moveTo(xL, BAR.y + BAR.h + 5);
    ctx.lineTo(xL, BAR.y + BAR.h + 15);
    ctx.moveTo(xR, BAR.y + BAR.h + 5);
    ctx.lineTo(xR, BAR.y + BAR.h + 15);
    ctx.stroke();

    terminals(sgn() * op.v1);

    if (state.dev === 'led' && op.i > 1e-6) {
      const c = LED_COLOURS[state.colour].css;
      const glow = ctx.createRadialGradient(xJ(), BAR.y + BAR.h / 2, 4, xJ(), BAR.y + BAR.h / 2, 170);
      glow.addColorStop(0, c + '2e');
      glow.addColorStop(1, c + '00');
      ctx.fillStyle = glow;
      ctx.fillRect(BAR.x, BAR.y - 40, BAR.w, BAR.h + 60);
    }
  }

  function terminals(vdev: number) {
    contact(BAR.x - 34, BAR.y + 30, 34, BAR.h - 60);
    contact(BAR.x + BAR.w, BAR.y + 30, 34, BAR.h - 60);
    const my = BAR.y + BAR.h / 2;
    wire(DEV.x + 16, my, BAR.x - 34, my);
    wire(BAR.x + BAR.w + 34, my, DEV.x + DEV.w - 16, my);
    label(`anode ${vdev >= 0 ? '+' : ''}${vdev.toFixed(3)} V`, DEV.x + 14, BAR.y + 16, 0.6, 'left', 12, ACC);
    label('cathode 0 V', DEV.x + DEV.w - 14, BAR.y + 16, 0.6, 'right', 12, ACC);
  }

  function drawBJTDevice() {
    const eb = EB(), bc = BC();
    const on = op.v2 > 0.45 && state.ib > 0.05;
    const ebw = on ? 8 : 22;
    const bcw = 14 + 20 * Math.sqrt(Math.max(0.05, op.v1));
    const em = flipped() ? P_TINT : NP_TINT;
    const ba = flipped() ? N_TINT : P_TINT;
    const co = flipped() ? P_TINT : N_TINT;
    regionFill(BAR.x, eb - BAR.x, em);
    regionFill(eb, bc - eb, ba);
    regionFill(bc, BAR.x + BAR.w - bc, co);
    ctx.fillStyle = inkA(0.06);
    ctx.fillRect(eb - ebw, BAR.y, ebw, BAR.h);
    ctx.fillRect(bc, BAR.y, bcw, BAR.h);

    ctx.strokeStyle = inkA(0.18);
    ctx.lineWidth = 1;
    ctx.strokeRect(BAR.x, BAR.y, BAR.w, BAR.h);
    ctx.setLineDash([3, 3]);
    ctx.strokeStyle = inkA(0.28);
    for (const x of [eb, bc]) {
      ctx.beginPath();
      ctx.moveTo(x, BAR.y);
      ctx.lineTo(x, BAR.y + BAR.h);
      ctx.stroke();
    }
    ctx.setLineDash([]);

    const kinds = flipped() ? ['p\u207a', 'n', 'p'] : ['n\u207a', 'p', 'n'];
    label(`emitter ${kinds[0]}`, BAR.x + 6, BAR.y - 14, 0.55, 'left', 12);
    label(`base ${kinds[1]}`, (eb + bc) / 2, BAR.y - 14, 0.55, 'center', 12);
    label(`collector ${kinds[2]}`, BAR.x + BAR.w - 6, BAR.y - 14, 0.55, 'right', 12);
    label('thin, and that is the whole trick', (eb + bc) / 2, BAR.y - 32, 0.35, 'center', 10);

    // contacts: emitter left, collector right, base up through the top
    contact(BAR.x - 34, BAR.y + 30, 34, BAR.h - 60);
    contact(BAR.x + BAR.w, BAR.y + 30, 34, BAR.h - 60);
    contact(eb + 10, BAR.y + BAR.h, bc - eb - 20, 14);
    const my = BAR.y + BAR.h / 2;
    wire(DEV.x + 16, my, BAR.x - 34, my);
    wire(BAR.x + BAR.w + 34, my, DEV.x + DEV.w - 16, my);
    const bx = (eb + bc) / 2;
    wire(bx, BAR.y + BAR.h + 14, bx, BAR.y + BAR.h + 42);
    wire(bx, BAR.y + BAR.h + 42, DEV.x + 60, BAR.y + BAR.h + 42);
    label('base', DEV.x + 54, BAR.y + BAR.h + 46, 0.55, 'right', 12);

    label(`${(sgn() * op.v2).toFixed(3)} V`, bx + 8, BAR.y + BAR.h + 36, 0.6, 'left', 12, ACC);
    label('emitter 0 V', DEV.x + 14, BAR.y + 16, 0.6, 'left', 12, ACC);
    label(
      `V_CE ${(sgn() * op.v1).toFixed(2)} V`,
      DEV.x + DEV.w - 14,
      BAR.y + 16,
      0.6,
      'right',
      12,
      ACC
    );

    if (!on) label('barrier closed: nothing crosses', xJ(), BAR.y + BAR.h + 74, 0.45, 'center', 12);
    else if (op.region.startsWith('sat'))
      label('base flooded: the collector cannot take any more', xJ(), BAR.y + BAR.h + 74, 0.45, 'center', 12);
    else
      label(
        `1 hole in for every ${state.beta} electrons through`,
        xJ(),
        BAR.y + BAR.h + 74,
        0.45,
        'center',
        12
      );
  }

  function drawMOSDevice() {
    const g = mosGeom();
    const on = op.vov > 0;
    const subT = flipped() ? N_TINT : P_TINT;
    const sdT = flipped() ? P_TINT : NP_TINT;
    ctx.fillStyle = subT;
    ctx.fillRect(g.sub.x, g.sub.y, g.sub.w, g.sub.h);

    // depletion under the gate, drawn before the wells so it reads as a layer
    const dep = depthPx(state.vg);
    ctx.fillStyle = inkA(0.09);
    ctx.fillRect(g.gate.x, g.sub.y, g.gate.w, dep);
    ctx.strokeStyle = inkA(0.22);
    ctx.setLineDash([3, 3]);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(g.gate.x, g.sub.y + dep);
    ctx.lineTo(g.gate.x + g.gate.w, g.sub.y + dep);
    ctx.stroke();
    ctx.setLineDash([]);

    ctx.fillStyle = sdT;
    ctx.fillRect(g.src.x, g.src.y, g.src.w, g.src.h);
    ctx.fillRect(g.drn.x, g.drn.y, g.drn.w, g.drn.h);
    ctx.strokeStyle = inkA(0.2);
    ctx.lineWidth = 1;
    ctx.strokeRect(g.sub.x, g.sub.y, g.sub.w, g.sub.h);
    ctx.strokeRect(g.src.x, g.src.y, g.src.w, g.src.h);
    ctx.strokeRect(g.drn.x, g.drn.y, g.drn.w, g.drn.h);

    // oxide and gate metal
    ctx.fillStyle = 'rgba(245,158,11,0.16)';
    ctx.fillRect(g.ox.x, g.ox.y, g.ox.w, g.ox.h);
    ctx.strokeStyle = 'rgba(245,158,11,0.4)';
    ctx.strokeRect(g.ox.x, g.ox.y, g.ox.w, g.ox.h);
    ctx.fillStyle = inkA(0.2);
    rr(g.gate.x, g.gate.y, g.gate.w, g.gate.h, 3);
    ctx.fill();

    // the gate is a capacitor plate: charge on it, mirror charge below
    const nq = Math.round(Math.min(16, (state.vg / 5) * 16));
    for (let i = 0; i < nq; i++) {
      const x = g.gate.x + ((i + 0.5) * g.gate.w) / Math.max(1, nq);
      label(flipped() ? '\u2212' : '+', x, g.gate.y + 14, 0.8, 'center', 13, WARM);
    }

    // inversion channel
    if (on) {
      ctx.beginPath();
      ctx.moveTo(g.src.x + g.src.w, g.sub.y);
      const steps = 48;
      for (let i = 0; i <= steps; i++) {
        const u = i / steps;
        const x = g.src.x + g.src.w + u * (g.drn.x - g.src.x - g.src.w);
        ctx.lineTo(x, g.sub.y + channelThickness(u));
      }
      ctx.lineTo(g.drn.x, g.sub.y);
      ctx.closePath();
      ctx.fillStyle = flipped() ? 'rgba(249,115,106,0.4)' : 'rgba(91,140,255,0.4)';
      ctx.fill();
      label(
        'inversion channel: electrons pulled up to the surface',
        (g.src.x + g.src.w + g.drn.x) / 2,
        g.sub.y + 84,
        0.45,
        'center',
        11
      );
      if (channelThickness(1) < 3.4) {
        label('pinch-off', g.drn.x - 8, g.sub.y - 22, 0.7, 'right', 11, WARM);
        ctx.strokeStyle = 'rgba(245,158,11,0.55)';
        ctx.lineWidth = 1.4;
        ctx.beginPath();
        ctx.moveTo(g.drn.x - 5, g.sub.y - 18);
        ctx.lineTo(g.drn.x - 5, g.sub.y + 12);
        ctx.stroke();
      }
    } else {
      label(
        `no channel, the gate is ${(state.vth - state.vg).toFixed(2)} V short`,
        (g.gate.x + g.gate.x + g.gate.w) / 2,
        g.sub.y + dep + 22,
        0.45,
        'center',
        12
      );
    }

    const kinds = flipped() ? ['p⁺', 'n-substrate'] : ['n⁺', 'p-substrate'];
    label(`source ${kinds[0]}`, g.src.x + 2, g.src.y - 10, 0.55, 'left', 12);
    label(`drain ${kinds[0]}`, g.drn.x + g.drn.w - 2, g.drn.y - 10, 0.55, 'right', 12);
    label(kinds[1], g.sub.x + 8, g.sub.y + g.sub.h - 10, 0.4, 'left', 12);
    label('gate', g.gate.x + 8, g.gate.y - 8, 0.55, 'left', 12);
    label('oxide', g.ox.x + g.ox.w - 5, g.ox.y + 9, 0.8, 'right', 10, WARM);

    // terminals
    contact(g.src.x, g.src.y - 10, 46, 10);
    contact(g.drn.x + g.drn.w - 46, g.drn.y - 10, 46, 10);
    wire(g.src.x + 23, g.src.y - 10, g.src.x + 23, DEV.y + 26);
    wire(g.src.x + 23, DEV.y + 26, DEV.x + 16, DEV.y + 26);
    wire(g.drn.x + g.drn.w - 23, g.drn.y - 10, g.drn.x + g.drn.w - 23, DEV.y + 26);
    wire(g.drn.x + g.drn.w - 23, DEV.y + 26, DEV.x + DEV.w - 16, DEV.y + 26);
    wire(g.gate.x + g.gate.w / 2, g.gate.y, g.gate.x + g.gate.w / 2, DEV.y + 52);
    label('source 0 V', DEV.x + 20, DEV.y + 22, 0.6, 'left', 12, ACC);
    label(`V_DS ${(sgn() * op.v1).toFixed(2)} V`, DEV.x + DEV.w - 20, DEV.y + 22, 0.6, 'right', 12, ACC);
    // body tie: the substrate is a terminal too, held at the source potential
    const bxm = g.sub.x + g.sub.w / 2;
    contact(bxm - 40, g.sub.y + g.sub.h, 80, 12);
    wire(bxm, g.sub.y + g.sub.h + 12, bxm, g.sub.y + g.sub.h + 34);
    label('body (substrate) 0 V', bxm, g.sub.y + g.sub.h + 50, 0.5, 'center', 12, ACC);
    label(
      `V_GS ${(sgn() * state.vg).toFixed(2)} V  ·  gate current 0`,
      g.gate.x + g.gate.w / 2,
      DEV.y + 48,
      0.6,
      'center',
      12,
      ACC
    );
  }

  function drawDevice() {
    panel(DEV, 'INSIDE THE DEVICE');
    if (isDiode()) drawDiodeDevice();
    else if (isBJT()) drawBJTDevice();
    else drawMOSDevice();

    for (const c of carriers) drawCarrier(c.x, c.y, c.t, c.st === 2 ? 4 : 4.6);

    // A recombination: the ring is the pair vanishing, the core is the energy
    // that has to go somewhere.
    for (const f of flashes) {
      const a = Math.max(0, Math.min(1, f.life));
      const gen = f.kind === 1;
      ctx.strokeStyle = gen
        ? `rgba(245,158,11,${a * 0.85})`
        : `rgba(255,236,190,${a * 0.6})`;
      ctx.lineWidth = 1.8;
      ctx.beginPath();
      ctx.arc(f.x, f.y, 4 + (1 - a) * (gen ? 11 : 9), 0, Math.PI * 2);
      ctx.stroke();
      if (!gen && a > 0.5) {
        ctx.fillStyle = `rgba(255,255,255,${(a - 0.5) * 1.6})`;
        ctx.beginPath();
        ctx.arc(f.x, f.y, 3.4 * a, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    const led = LED_COLOURS[state.colour].css;
    for (const q of quanta) {
      const a = Math.max(0, q.life);
      ctx.globalAlpha = a * 0.95;
      ctx.lineWidth = q.light ? 1.9 : 1.4;
      ctx.strokeStyle = q.light ? led : WARM;
      ctx.beginPath();
      if (q.light) {
        ctx.moveTo(q.x, q.y);
        ctx.lineTo(q.x - q.vx * 0.05, q.y - q.vy * 0.05);
      } else {
        // heat leaving as a lattice vibration
        const len = 16, dir = Math.atan2(q.vy, q.vx);
        for (let i = 0; i <= 10; i++) {
          const t = i / 10;
          const off = Math.sin(q.ph + t * 7) * 2.6;
          const px = q.x - Math.cos(dir) * len * t - Math.sin(dir) * off;
          const py = q.y - Math.sin(dir) * len * t + Math.cos(dir) * off;
          i ? ctx.lineTo(px, py) : ctx.moveTo(px, py);
        }
      }
      ctx.stroke();
      ctx.globalAlpha = 1;
    }
  }

  function deviceTitle() {
    switch (state.dev) {
      case 'pn': return 'Silicon PN diode';
      case 'schottky': return 'Schottky diode';
      case 'zener': return 'Zener diode';
      case 'led': return `${state.colour} LED`;
      case 'npn': return 'NPN bipolar transistor';
      case 'pnp': return 'PNP bipolar transistor';
      case 'nmos': return 'N-channel MOSFET';
      default: return 'P-channel MOSFET';
    }
  }

  // --- circuit ---------------------------------------------------------------

  function resistor(x: number, y: number, len: number, horiz: boolean) {
    ctx.strokeStyle = inkA(0.55);
    ctx.lineWidth = 1.6;
    ctx.beginPath();
    const n = 6, amp = 6;
    if (horiz) {
      ctx.moveTo(x, y);
      for (let i = 0; i <= n; i++) {
        const px = x + ((i + 0.5) * len) / (n + 1);
        ctx.lineTo(px, y + (i % 2 ? amp : -amp));
      }
      ctx.lineTo(x + len, y);
    } else {
      ctx.moveTo(x, y);
      for (let i = 0; i <= n; i++) {
        const py = y + ((i + 0.5) * len) / (n + 1);
        ctx.lineTo(x + (i % 2 ? amp : -amp), py);
      }
      ctx.lineTo(x, y + len);
    }
    ctx.stroke();
  }

  function battery(x: number, y: number) {
    ctx.strokeStyle = inkA(0.55);
    ctx.lineWidth = 1.6;
    for (let i = 0; i < 2; i++) {
      const yy = y + i * 12;
      const half = i === 0 ? 13 : 7;
      ctx.beginPath();
      ctx.moveTo(x - half, yy);
      ctx.lineTo(x + half, yy);
      ctx.stroke();
    }
  }

  function diodeSymbol(x: number, y: number) {
    ctx.strokeStyle = inkA(0.65);
    ctx.fillStyle = inkA(0.5);
    ctx.lineWidth = 1.6;
    // triangle pointing down (conventional current flows down through it)
    ctx.beginPath();
    ctx.moveTo(x - 11, y - 8);
    ctx.lineTo(x + 11, y - 8);
    ctx.lineTo(x, y + 6);
    ctx.closePath();
    ctx.fill();
    ctx.beginPath();
    if (state.dev === 'zener') {
      ctx.moveTo(x - 11, y + 6);
      ctx.lineTo(x + 11, y + 6);
      ctx.lineTo(x + 11, y + 12);
      ctx.moveTo(x - 11, y + 6);
      ctx.lineTo(x - 11, y);
    } else if (state.dev === 'schottky') {
      ctx.moveTo(x - 11, y + 12);
      ctx.lineTo(x - 11, y + 6);
      ctx.lineTo(x + 11, y + 6);
      ctx.lineTo(x + 11, y);
    } else {
      ctx.moveTo(x - 11, y + 6);
      ctx.lineTo(x + 11, y + 6);
    }
    ctx.stroke();
    if (state.dev === 'led') {
      ctx.strokeStyle = LED_COLOURS[state.colour].css;
      ctx.fillStyle = LED_COLOURS[state.colour].css;
      for (let i = 0; i < 2; i++) arrow(x + 14, y - 4 + i * 8, x + 26, y - 12 + i * 8, 4);
    }
  }

  function bjtSymbol(x: number, y: number) {
    ctx.strokeStyle = inkA(0.65);
    ctx.fillStyle = inkA(0.65);
    ctx.lineWidth = 1.6;
    ctx.beginPath();
    ctx.arc(x, y, 20, 0, Math.PI * 2);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(x - 8, y - 12);
    ctx.lineTo(x - 8, y + 12);
    ctx.moveTo(x - 8, y - 5);
    ctx.lineTo(x + 12, y - 16);
    ctx.moveTo(x - 8, y + 5);
    ctx.lineTo(x + 12, y + 16);
    ctx.stroke();
    // emitter arrow: out for NPN, in for PNP
    if (state.dev === 'npn') arrow(x + 4, y + 11, x + 12, y + 16, 4);
    else arrow(x + 12, y + 16, x + 4, y + 11, 4);
  }

  function mosSymbol(x: number, y: number) {
    ctx.strokeStyle = inkA(0.65);
    ctx.fillStyle = inkA(0.65);
    ctx.lineWidth = 1.6;
    ctx.beginPath();
    ctx.arc(x, y, 20, 0, Math.PI * 2);
    ctx.moveTo(x - 10, y - 13);
    ctx.lineTo(x - 10, y + 13);
    for (let i = -1; i <= 1; i++) {
      ctx.moveTo(x - 5, y + i * 9 - 4);
      ctx.lineTo(x - 5, y + i * 9 + 4);
    }
    ctx.moveTo(x - 5, y - 9);
    ctx.lineTo(x + 12, y - 9);
    ctx.moveTo(x - 5, y + 9);
    ctx.lineTo(x + 12, y + 9);
    ctx.moveTo(x - 5, y);
    ctx.lineTo(x + 6, y);
    ctx.lineTo(x + 6, y + 9);
    ctx.stroke();
    arrow(x - 5, y, x + 3, y, 4);
  }

  type Pt = { x: number; y: number };
  function pathLength(pts: Pt[]) {
    let L = 0;
    for (let i = 1; i < pts.length; i++) L += Math.hypot(pts[i].x - pts[i - 1].x, pts[i].y - pts[i - 1].y);
    return L;
  }
  function pointAt(pts: Pt[], d: number): Pt {
    let rem = d;
    for (let i = 1; i < pts.length; i++) {
      const seg = Math.hypot(pts[i].x - pts[i - 1].x, pts[i].y - pts[i - 1].y);
      if (rem <= seg) {
        const t = seg === 0 ? 0 : rem / seg;
        return { x: pts[i - 1].x + (pts[i].x - pts[i - 1].x) * t, y: pts[i - 1].y + (pts[i].y - pts[i - 1].y) * t };
      }
      rem -= seg;
    }
    return pts[pts.length - 1];
  }
  function strokePath(pts: Pt[], gapFrom?: number, gapTo?: number) {
    ctx.strokeStyle = inkA(0.45);
    ctx.lineWidth = 1.6;
    ctx.beginPath();
    let d = 0;
    for (let i = 1; i < pts.length; i++) {
      const seg = Math.hypot(pts[i].x - pts[i - 1].x, pts[i].y - pts[i - 1].y);
      const inGap = gapFrom !== undefined && d + seg > gapFrom && d < (gapTo ?? 0);
      if (!inGap) {
        ctx.moveTo(pts[i - 1].x, pts[i - 1].y);
        ctx.lineTo(pts[i].x, pts[i].y);
      }
      d += seg;
    }
    ctx.stroke();
  }

  /** Dots crawling round the loop at a speed set by the real current. */
  function drawFlowDots(pts: Pt[], current: number, colour: string) {
    const L = pathLength(pts);
    const spd = flowSpeed(current) * 1.1 * Math.sign(current || 1);
    const n = 14;
    for (let i = 0; i < n; i++) {
      let d = ((i / n) * L + clock * spd) % L;
      if (d < 0) d += L;
      const p = pointAt(pts, d);
      ctx.fillStyle = colour;
      ctx.globalAlpha = Math.min(1, 0.25 + flowSpeed(current) / 60);
      ctx.beginPath();
      ctx.arc(p.x, p.y, 2.6, 0, Math.PI * 2);
      ctx.fill();
      ctx.globalAlpha = 1;
    }
  }

  function drawCircuit() {
    panel(CIR, 'EXTERNAL CIRCUIT');
    const L = CIR.x + 52, R = CIR.x + CIR.w - 56;
    const T = CIR.y + 62, B = CIR.y + CIR.h - 66;
    const midY = (T + B) / 2;
    const loop: Pt[] = [
      { x: L, y: midY - 7 },
      { x: L, y: T },
      { x: R, y: T },
      { x: R, y: midY - 24 },
      { x: R, y: midY + 24 },
      { x: R, y: B },
      { x: L, y: B },
      { x: L, y: midY + 7 },
    ];
    strokePath(loop);

    battery(L, midY - 7);
    label(`${(sgn() * state.vs).toFixed(1)} V`, L + 14, midY + 5, 0.6, 'left', 12);
    // resistor sits in the top wire
    ctx.fillStyle = cssVar('--stage-bg') || '#0d0e12';
    ctx.fillRect(L + 22, T - 11, 88, 22);
    resistor(L + 22, T, 88, true);
    label(fmtR(state.r), L + 66, T - 16, 0.6, 'center', 12);
    label(fmtI(sgn() * op.i), L + 66, T + 28, 0.8, 'center', 12, ACC);

    ctx.fillStyle = cssVar('--stage-bg') || '#0d0e12';
    ctx.fillRect(R - 26, midY - 26, 52, 52);
    if (isDiode()) diodeSymbol(R, midY);
    else if (isBJT()) bjtSymbol(R, midY);
    else mosSymbol(R, midY);

    // A PNP or PMOS stage runs off a negative rail, so the loop turns the
    // other way round.
    drawFlowDots(loop, sgn() * op.i, ACC);
    label('conventional current', CIR.x + CIR.w / 2, B + 22, 0.4, 'center', 10);

    // the control branch
    if (isBJT()) {
      const bp: Pt[] = [
        { x: CIR.x + 12, y: midY + 52 },
        { x: R - 22, y: midY + 52 },
        { x: R - 22, y: midY },
      ];
      strokePath(bp);
      drawFlowDots(bp, sgn() * state.ib * 1e-6, C_H);
      label(`I_B ${fmtI(sgn() * state.ib * 1e-6)}`, CIR.x + CIR.w / 2, B + 42, 0.7, 'center', 12, C_H);
    } else if (isMOS()) {
      const gp: Pt[] = [
        { x: CIR.x + 12, y: midY + 52 },
        { x: R - 24, y: midY + 52 },
        { x: R - 24, y: midY },
      ];
      strokePath(gp);
      label(`V_GS ${(sgn() * state.vg).toFixed(2)} V`, CIR.x + CIR.w / 2, B + 42, 0.7, 'center', 12, WARM);
      label('no current into the gate', CIR.x + CIR.w / 2, B + 58, 0.4, 'center', 10);
    }
  }

  // --- band diagram ----------------------------------------------------------

  /** Conduction band edge in eV along the device, u from 0 (left) to 1. */
  function bandProfile(u: number) {
    if (isDiode()) {
      const p = dparams();
      const w = depPx() / BAR.w;
      const uL = 0.5 - w / 2, uR = 0.5 + w / 2;
      // Flat bands are the floor: past that the neutral regions take the extra
      // volts, so the hill never turns into a downhill slide.
      const drop = Math.max(0, p.vbi - op.v1);
      // smoothstep across the depletion region, flat bands outside it
      const t = Math.max(0, Math.min(1, (u - uL) / Math.max(1e-6, uR - uL)));
      const s = t * t * (3 - 2 * t);
      return drop * (1 - s);
    }
    if (isBJT()) {
      const uE = (EB() - BAR.x) / BAR.w, uB = (BC() - BAR.x) / BAR.w;
      const hill = Math.max(0.01, 0.75 - op.v2);
      if (u < uE - 0.05) return 0;
      if (u < uE) return hill * smooth((u - (uE - 0.05)) / 0.05);
      if (u < uB) return hill - (hill * 0.25 * (u - uE)) / (uB - uE);
      if (u < uB + 0.08) return (hill * 0.75) * (1 - smooth((u - uB) / 0.08)) - op.v1 * smooth((u - uB) / 0.08);
      return -op.v1;
    }
    const g = mosGeom();
    const uS = (g.src.x + g.src.w - BAR.x) / BAR.w;
    const uD = (g.drn.x - BAR.x) / BAR.w;
    const hill = Math.max(0.02, 0.45 + (state.vth - state.vg) * 0.55);
    if (u < uS - 0.05) return 0;
    if (u < uS) return hill * smooth((u - (uS - 0.05)) / 0.05);
    if (u < uD) {
      const t = (u - uS) / (uD - uS);
      return hill - op.v1 * t * t;
    }
    return hill - op.v1;
  }
  const smooth = (t: number) => {
    const x = Math.max(0, Math.min(1, t));
    return x * x * (3 - 2 * x);
  };

  function bandGap() {
    if (isDiode()) return dparams().eg;
    return 1.12;
  }

  function drawBands() {
    panel(BAND, 'ENERGY OF AN ELECTRON, ALONG THE DEVICE');
    const px = BAND.x + 46, py = BAND.y + 28, pw = BAND.w - 68, ph = BAND.h - 94;
    const eg = bandGap();
    let lo = Infinity, hi = -Infinity;
    const pts: number[] = [];
    for (let i = 0; i <= 120; i++) {
      const e = bandProfile(i / 120);
      pts.push(e);
      lo = Math.min(lo, e - eg);
      hi = Math.max(hi, e);
    }
    const pad = 0.25 * Math.max(0.6, hi - lo);
    lo -= pad;
    hi += pad;
    const Y = (e: number) => py + ph - ((e - lo) / (hi - lo)) * ph;
    const X = (u: number) => px + u * pw;

    ctx.strokeStyle = inkA(0.2);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(px, py);
    ctx.lineTo(px, py + ph);
    ctx.lineTo(px + pw, py + ph);
    ctx.stroke();
    label('energy', px - 6, py + 4, 0.4, 'right', 10);
    label('position', px + pw, py + ph + 14, 0.4, 'right', 10);

    // conduction band
    ctx.strokeStyle = C_E;
    ctx.lineWidth = 2;
    ctx.beginPath();
    pts.forEach((e, i) => (i ? ctx.lineTo(X(i / 120), Y(e)) : ctx.moveTo(X(0), Y(e))));
    ctx.stroke();
    // valence band
    ctx.strokeStyle = C_H;
    ctx.beginPath();
    pts.forEach((e, i) => (i ? ctx.lineTo(X(i / 120), Y(e - eg)) : ctx.moveTo(X(0), Y(e - eg))));
    ctx.stroke();

    // Park each label clear of its own curve: above the highest conduction
    // band on the left third, below the lowest valence band there.
    const leftMax = Math.max(...pts.slice(0, 45));
    const leftMin = Math.min(...pts.slice(0, 45));
    label('conduction band  E_c', X(0.02), Y(leftMax) - 9, 0.75, 'left', 10, C_E);
    label('valence band  E_v', X(0.02), Y(leftMin - eg) + 16, 0.75, 'left', 10, C_H);

    // the barrier that decides everything
    const barrier = Math.max(...pts) - pts[0];
    const iMax = pts.indexOf(Math.max(...pts));
    if (barrier > 0.02) {
      const bx = X(iMax / 120);
      ctx.strokeStyle = inkA(0.35);
      ctx.setLineDash([3, 3]);
      ctx.beginPath();
      ctx.moveTo(bx, Y(pts[0]));
      ctx.lineTo(bx, Y(Math.max(...pts)));
      ctx.stroke();
      ctx.setLineDash([]);
      const side = bx > px + pw * 0.6 ? 'right' : 'left';
      label(
        `barrier ${barrier.toFixed(2)} eV`,
        bx + (side === 'left' ? 8 : -8),
        Y(Math.max(...pts)) + 16,
        0.7,
        side,
        10,
        WARM
      );
    }

    // a few carriers riding the bands
    for (let i = 0; i < 7; i++) {
      const u = 0.06 + i * 0.13;
      const e = bandProfile(u);
      drawCarrier(X(u), Y(e) - 5 + Math.sin(clock * 3 + i) * 1.5, ELECTRON, 2.6, true);
      drawCarrier(X(u), Y(e - eg) + 5 + Math.cos(clock * 3 + i) * 1.5, HOLE, 2.6, true);
    }

    const flat = isDiode() && dparams().vbi - op.v1 < 0.02;
    const note = isDiode()
      ? flat
        ? 'Flat bands: the barrier has collapsed and the junction is wide open.'
        : op.v1 > 0.1
          ? 'Forward bias lowers the hill, so the crowds can walk over it.'
          : 'Reverse bias raises the hill, so nobody gets across.'
      : isBJT()
        ? 'The base lowers the hill, the collector sweeps up whatever crosses.'
        : 'The gate lowers the hill without touching it, the drain tilts it.';
    // two short lines rather than one that runs off the panel
    const words = note.split(' ');
    const lines: string[] = [''];
    for (const word of words) {
      const test = lines[lines.length - 1] ? lines[lines.length - 1] + ' ' + word : word;
      if (textWidth(test, 10) > BAND.w - 24 && lines[lines.length - 1]) lines.push(word);
      else lines[lines.length - 1] = test;
    }
    lines.forEach((ln, i) =>
      label(ln, BAND.x + 12, BAND.y + BAND.h - 26 + i * 14, 0.42, 'left', 10)
    );
  }

  // --- I-V characteristic ----------------------------------------------------

  function drawIV() {
    const title = isDiode()
      ? 'I-V CURVE AND THE LOAD LINE'
      : isBJT()
        ? 'OUTPUT CURVES  I_C vs V_CE'
        : 'OUTPUT CURVES  I_D vs V_DS';
    panel(IV, title);
    const px = IV.x + 62, py = IV.y + 26, pw = IV.w - 108, ph = IV.h - 76;

    if (isDiode()) drawDiodeIV(px, py, pw, ph);
    else drawTransistorIV(px, py, pw, ph);
  }

  function axes(px: number, py: number, pw: number, ph: number, x0: number, y0: number) {
    ctx.strokeStyle = inkA(0.22);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(px, y0);
    ctx.lineTo(px + pw, y0);
    ctx.moveTo(x0, py);
    ctx.lineTo(x0, py + ph);
    ctx.stroke();
  }

  function drawDiodeIV(px: number, py: number, pw: number, ph: number) {
    const p = dparams();
    const vmaxF = Math.max(1.0, Math.min(3.4, p.n * VT() * Math.log(1 + Math.abs(state.vs) / (state.r * p.is * satScale(p.eg))) * 1.05));
    // Only the Zener has a breakdown worth putting on the axis: a plain PN
    // diode breaks down at 60 V, which would squash the knee into the corner.
    const vmin = Math.max(
      -15,
      Math.min(-1, 1.15 * Math.min(0, state.vs), state.dev === 'zener' ? -p.vbr * 1.15 : -1)
    );
    const vmax = Math.max(1.1, vmaxF * 1.15);
    const imax = Math.max(1e-6, (Math.abs(state.vs) / state.r) * 1.25);
    const X = (v: number) => px + ((v - vmin) / (vmax - vmin)) * pw;
    const Y = (i: number) => py + ph / 2 - (i / imax) * (ph / 2);
    axes(px, py, pw, ph, X(0), Y(0));
    label(`${fmtI(imax)}`, px - 6, py + 10, 0.4, 'right', 10);
    label(`${fmtI(-imax)}`, px - 6, py + ph - 2, 0.4, 'right', 10);
    label(`${vmin.toFixed(1)} V`, px + 2, Y(0) + 14, 0.4, 'left', 10);
    label(`${vmax.toFixed(1)} V`, px + pw - 2, Y(0) + 14, 0.4, 'right', 10);

    // device curve
    ctx.strokeStyle = WARM;
    ctx.lineWidth = 2;
    ctx.beginPath();
    let pen = false;
    for (let i = 0; i <= 400; i++) {
      const v = vmin + ((vmax - vmin) * i) / 400;
      const raw = diodeI(v);
      // Lift the pen once the curve leaves the box, so a runaway exponential
      // does not turn into a fake horizontal line along the top.
      if (Math.abs(raw) > imax) {
        if (pen) {
          ctx.lineTo(X(v), Y(Math.sign(raw) * imax));
          pen = false;
        }
        continue;
      }
      const x = X(v), y = Y(raw);
      pen ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
      pen = true;
    }
    ctx.stroke();

    // Load line, clipped to the box: with a small supply and a small resistor
    // its ends sit thousands of milliamps off the top and bottom.
    ctx.strokeStyle = inkA(0.4);
    ctx.setLineDash([5, 4]);
    ctx.lineWidth = 1.4;
    ctx.beginPath();
    let lpen = false;
    for (let i = 0; i <= 120; i++) {
      const v = vmin + ((vmax - vmin) * i) / 120;
      const cur = (state.vs - v) / state.r;
      if (Math.abs(cur) > imax) {
        lpen = false;
        continue;
      }
      lpen ? ctx.lineTo(X(v), Y(cur)) : ctx.moveTo(X(v), Y(cur));
      lpen = true;
    }
    ctx.stroke();
    ctx.setLineDash([]);
    label('load line: slope −1/R', px, py + ph + 30, 0.4, 'left', 10);

    opDot(X(op.v1), Y(op.i));
  }

  function drawTransistorIV(px: number, py: number, pw: number, ph: number) {
    const vmax = Math.max(0.5, state.vs * 1.05);
    const imax = Math.max(1e-9, (state.vs / state.r) * 1.2);
    const X = (v: number) => px + (v / vmax) * pw;
    const Y = (i: number) => py + ph - (i / imax) * ph;
    // PNP and PMOS run on negative rails, so the numbers carry the sign even
    // though the curves themselves are plotted as magnitudes.
    const s = sgn();
    axes(px, py, pw, ph, px, py + ph);
    label(isBJT() ? 'V_CE' : 'V_DS', px + pw / 2, py + ph + 14, 0.4, 'center', 10);
    label(fmtI(s * imax), px - 6, py + 8, 0.4, 'right', 10);
    label('0', px - 6, py + ph + 4, 0.4, 'right', 10);
    label(`${(s * vmax).toFixed(1)} V`, px + pw - 2, py + ph + 14, 0.4, 'right', 10);

    // Spread the family over the drives that actually fit under the load line,
    // so the curves never all pile up above the top of the box.
    const driveMax = isBJT()
      ? Math.max(state.ib, Math.min(200, (imax / state.beta) * 1e6 * 1.2))
      : Math.max(
          state.vg,
          Math.min(5, state.vth + Math.sqrt((2 * imax) / (state.kp * 1e-3)) * 1.1)
        );
    const curve = (drive: number) => {
      ctx.beginPath();
      let pen = false;
      for (let i = 0; i <= 120; i++) {
        const v = (vmax * i) / 120;
        const cur = isBJT() ? bjtIc(v, drive * 1e-6, state.beta) : mosId(v, drive);
        if (cur > imax) {
          if (pen) {
            ctx.lineTo(X(v), Y(imax));
            pen = false;
          }
          continue;
        }
        pen ? ctx.lineTo(X(v), Y(cur)) : ctx.moveTo(X(v), Y(cur));
        pen = true;
      }
      ctx.stroke();
    };
    const tag = (drive: number, alpha: number, colour?: string) => {
      const last = isBJT() ? bjtIc(vmax, drive * 1e-6, state.beta) : mosId(vmax, drive);
      if (last < imax * 1.05 && Y(last) < py + ph - 12)
        label(
          isBJT() ? `${(s * drive).toFixed(0)} µA` : `${(s * drive).toFixed(1)} V`,
          px + pw + 2,
          Y(last) + 3,
          alpha,
          'left',
          9,
          colour
        );
    };
    const n = 5;
    for (let k = 1; k <= n; k++) {
      const drive = (driveMax * k) / n;
      ctx.strokeStyle = inkA(0.22);
      ctx.lineWidth = 1.2;
      curve(drive);
      tag(drive, 0.35);
    }
    // the curve the device is actually sitting on
    const nowDrive = isBJT() ? state.ib : state.vg;
    ctx.strokeStyle = WARM;
    ctx.lineWidth = 2;
    curve(nowDrive);
    tag(nowDrive, 0.85, WARM);

    ctx.strokeStyle = inkA(0.4);
    ctx.setLineDash([5, 4]);
    ctx.lineWidth = 1.4;
    ctx.beginPath();
    ctx.moveTo(X(0), Y(state.vs / state.r));
    ctx.lineTo(X(vmax), Y((state.vs - vmax) / state.r));
    ctx.stroke();
    ctx.setLineDash([]);
    label(isBJT() ? 'one curve per base current' : 'one curve per gate voltage', px, py + ph + 30, 0.4, 'left', 10);
    label(`load line: R = ${fmtR(state.r)}`, px, py + ph + 44, 0.4, 'left', 10);

    opDot(X(op.v1), Y(op.i));
  }

  function opDot(x: number, y: number) {
    ctx.strokeStyle = inkA(0.35);
    ctx.setLineDash([2, 3]);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(x, y);
    ctx.lineTo(x, IV.y + IV.h - 50);
    ctx.moveTo(x, y);
    ctx.lineTo(IV.x + 62, y);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = GREEN;
    ctx.beginPath();
    ctx.arc(x, y, 4.4, 0, Math.PI * 2);
    ctx.fill();
    label('Q', x + 8, y - 6, 0.9, 'left', 11, GREEN);
  }

  // --- legend ----------------------------------------------------------------

  function drawLegend() {
    const items: [string, string][] = [
      [C_E, 'electron'],
      [C_H, 'hole'],
      [inkA(0.45), 'fixed dopant ion'],
      state.dev === 'led'
        ? [LED_COLOURS[state.colour].css, 'photon out']
        : [WARM, 'heat out'],
    ];
    let x = W - 20;
    for (let i = items.length - 1; i >= 0; i--) {
      const [c, t] = items[i];
      const tw = textWidth(t, 11);
      label(t, x, 30, 0.55, 'right', 11);
      ctx.fillStyle = c;
      ctx.beginPath();
      ctx.arc(x - tw - 11, 26, 4, 0, Math.PI * 2);
      ctx.fill();
      x -= tw + 30;
    }
    label(deviceTitle(), 20, 30, 0.85, 'left', 14);
    label(op.region, 20, 52, 0.5, 'left', 11, GREEN);
  }

  // --- readouts --------------------------------------------------------------

  const el = (id: string) => document.getElementById(id) as HTMLElement;
  const setRow = (n: number, lab: string, val: string) => {
    el('l' + n).innerHTML = subHtml(lab);
    el('r' + n).textContent = val;
  };

  function updateReadout() {
    const s = sgn();
    setRow(1, 'Current', fmtI(s * op.i));
    setRow(7, 'Power in the device', fmtP(Math.abs(op.i * op.v1)));
    setRow(4, 'Operating region', op.region);
    if (isDiode()) {
      const p = dparams();
      setRow(2, 'Across the diode', (s * op.v1).toFixed(4) + ' V');
      setRow(3, 'Across the resistor', (s * (state.vs - op.v1)).toFixed(3) + ' V');
      const nm = depWidth(op.v1) * 1e9;
      setRow(5, 'Depletion width', nm < 1000 ? nm.toFixed(0) + ' nm' : (nm / 1000).toFixed(2) + ' µm');
      setRow(6, 'Built-in / thermal V', `${p.vbi.toFixed(2)} / ${(VT() * 1000).toFixed(1)} mV`);
    } else if (isBJT()) {
      setRow(2, 'V_CE', (s * op.v1).toFixed(3) + ' V');
      setRow(3, 'V_BE', (s * op.v2).toFixed(3) + ' V');
      setRow(5, 'I_C / I_B (model)', state.ib > 0.01 ? (op.i / (state.ib * 1e-6)).toFixed(1) : '—');
      setRow(6, 'Counted crossings', nBase > 2 ? `${(nCross / nBase).toFixed(0)} per hole` : 'counting…');
    } else {
      const k = state.kp * 1e-3;
      const gm = op.vov > 0 ? k * Math.min(op.vov, op.v1) : 0;
      setRow(2, 'V_DS', (s * op.v1).toFixed(3) + ' V');
      setRow(3, 'V_GS − V_th', (s * op.vov).toFixed(3) + ' V');
      setRow(5, 'Gate current', '0.00 A');
      setRow(6, 'Transconductance g_m', (gm * 1000).toFixed(2) + ' mA/V');
    }
  }

  // --- loop ------------------------------------------------------------------

  function draw() {
    ctx.clearRect(0, 0, W, H);
    drawLegend();
    drawDevice();
    drawCircuit();
    drawBands();
    drawIV();
  }

  let last = performance.now();
  function frame(now: number) {
    let dt = (now - last) / 1000;
    last = now;
    dt = Math.min(0.05, Math.max(0, dt)) * state.rate;
    solve();
    if (state.running) {
      clock += dt;
      stepCarriers(dt);
    }
    draw();
    updateReadout();
    requestAnimationFrame(frame);
  }

  // --- controls --------------------------------------------------------------

  const runBtn = el('run');
  runBtn.addEventListener('click', () => {
    state.running = !state.running;
    runBtn.textContent = state.running ? 'Pause' : 'Run';
  });
  el('reset').addEventListener('click', () => {
    buildCarriers();
  });

  function bindRange(id: string, apply: (v: number) => void) {
    const inp = el(id) as HTMLInputElement;
    const run = () => apply(+inp.value);
    inp.addEventListener('input', run);
    run();
  }

  bindRange('vs', (v) => {
    state.vs = v / 10;
    el('vsval').textContent = `${(sgn() * state.vs).toFixed(1)} V`;
  });
  bindRange('r', (v) => {
    state.r = Math.round(10 * Math.pow(10, (v / 100) * 4));
    el('rval').textContent = fmtR(state.r);
  });
  bindRange('ib', (v) => {
    state.ib = v;
    el('ibval').textContent = `${v} µA`;
  });
  bindRange('beta', (v) => {
    state.beta = v;
    el('betaval').textContent = String(v);
  });
  bindRange('vg', (v) => {
    state.vg = v / 100;
    el('vgval').textContent = `${(sgn() * state.vg).toFixed(2)} V`;
  });
  bindRange('vth', (v) => {
    state.vth = v / 100;
    el('vthval').textContent = `${(sgn() * state.vth).toFixed(2)} V`;
  });
  bindRange('kp', (v) => {
    state.kp = v / 10;
    el('kpval').textContent = `${state.kp.toFixed(1)} mA/V²`;
  });
  bindRange('dop', (v) => {
    state.dop = v / 10;
    const m = Math.pow(10, state.dop - Math.floor(state.dop));
    el('dopval').textContent = `${m.toFixed(1)}e${Math.floor(state.dop)} cm⁻³`;
  });
  bindRange('vz', (v) => {
    state.vz = v / 10;
    el('vzval').textContent = `${state.vz.toFixed(1)} V`;
  });
  bindRange('temp', (v) => {
    state.temp = v;
    el('tempval').textContent = `${v} K`;
  });
  bindRange('rate', (v) => {
    state.rate = v / 100;
    el('rateval').textContent = `${state.rate.toFixed(1)}×`;
  });

  (el('ions') as HTMLInputElement).addEventListener('change', (e) => {
    state.ions = (e.target as HTMLInputElement).checked;
  });

  el('colour').addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn) return;
    document.querySelectorAll('#colour button').forEach((b) => b.classList.remove('active'));
    btn.classList.add('active');
    state.colour = btn.dataset.c as 'red' | 'green' | 'blue';
  });

  const show = (id: string, on: boolean) => {
    el(id).style.display = on ? '' : 'none';
  };

  function syncControls() {
    const d = isDiode(), b = isBJT(), m = isMOS();
    show('ctl-colour', state.dev === 'led');
    show('ctl-ib', b);
    show('ctl-beta', b);
    show('ctl-vg', m);
    show('ctl-vth', m);
    show('ctl-kp', m);
    show('ctl-dop', d);
    show('ctl-vz', state.dev === 'zener');
    el('vslab').innerHTML = subHtml(d ? 'Supply V_S' : b ? 'Supply V_CC' : 'Supply V_DD');
    el('rlab').innerHTML = subHtml(
      d ? 'Series resistor R' : b ? 'Collector resistor R_C' : 'Drain resistor R_D'
    );
    el('vsmin').textContent = d ? 'reverse' : '0 V';

    // Transistors are only driven forward here, so the supply cannot go negative.
    const vsEl = el('vs') as HTMLInputElement;
    vsEl.min = d ? '-120' : '0';
    if (!d && +vsEl.value < 0) vsEl.value = '50';
    state.vs = +vsEl.value / 10;
    el('vsval').textContent = `${(sgn() * state.vs).toFixed(1)} V`;
    el('vgval').textContent = `${(sgn() * state.vg).toFixed(2)} V`;
    el('vthval').textContent = `${(sgn() * state.vth).toFixed(2)} V`;
  }

  const devEl = el('dev') as HTMLSelectElement;
  devEl.addEventListener('change', () => {
    state.dev = devEl.value as Dev;
    syncControls();
    solve();
    buildCarriers();
  });

  syncControls();
  solve();
  buildCarriers();
  requestAnimationFrame(frame);
</script>

<style>
  .sc-canvas {
    touch-action: none;
  }
  .scale-hint {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: var(--text-faint);
    margin-top: 3px;
  }
  .check {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .check input {
    accent-color: var(--accent);
  }
  .select {
    width: 100%;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    color: var(--text);
    border-radius: var(--radius-sm);
    padding: 8px 10px;
    font: inherit;
  }
</style>
