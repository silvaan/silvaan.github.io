---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';

const LOSS = '#5eead4', STEP = '#7c8cff';
---

<SimLayout
  areaSlug="deep-learning"
  title="Gradient Descent"
  description="Pick a learning rate and a starting point, then watch x roll downhill: converge, oscillate or diverge."
  standard
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="gd"
          width="1000"
          height="600"
          role="img"
          aria-label="A loss curve with the path of gradient descent steps on it, and the loss at each step underneath."
        ></canvas>
      </div>
      <Caption
        legend={[{ label: 'loss f(x)', color: LOSS }, { label: 'steps x<sub>k</sub>', color: STEP }]}
        hint="Run, or take one step at a time"
      />
      <Result label="Loss f(x)" />
    </div>

    <div class="sim-panel">
      <Transport step />
      <Seg
        id="fn"
        label="Loss surface"
        attr="fn"
        options={[
          { value: 'bowl', label: 'Convex' },
          { value: 'double', label: 'Double well' },
          { value: 'wavy', label: 'Wavy' },
        ]}
      />
      <Slider id="lr" label="Learning rate η" min={0.01} max={2.5} step={0.01} value={0.1} display="0.10" />
      <Slider id="x0" label="Start x<sub>0</sub>" min={-3} max={3} step={0.05} value={2.4} display="2.40" />
      <Readout
        rows={[
          { id: 'r-x', label: 'x' },
          { id: 'r-grad', label: 'gradient f′(x)' },
          { id: 'r-iter', label: 'iteration' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      On the <b>Convex</b> bowl, raise the learning rate slowly. Around
      <b>η = 1</b> the steps start to overshoot and bounce across the valley;
      past <b>η = 2</b> the loss curve turns upward and it <b>diverges</b>.
    </li>
    <li>
      The strip under the curve is the "training curve" you will meet everywhere
      in deep learning: down and flattening means converging, up means the step
      is too big.
    </li>
    <li>
      Switch to <b>Double well</b> and drag the start point across the hump. The
      <b>starting point</b> alone decides which minimum you reach: convexity
      guarantees one basin, non-convexity does not.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk, fixed } from '../../../lib/draw';
  import { el, segmented, slider, transport, result, readout } from '../../../lib/panel';

  type Fn = { f: (x: number) => number; g: (x: number) => number };
  const FNS: Record<string, Fn> = {
    bowl: { f: (x) => 0.5 * x * x, g: (x) => x },
    double: { f: (x) => 0.12 * x ** 4 - x * x + 0.4 * x + 1.2, g: (x) => 0.48 * x ** 3 - 2 * x + 0.4 },
    wavy: { f: (x) => 0.25 * x * x + Math.sin(3 * x), g: (x) => 0.5 * x + 3 * Math.cos(3 * x) },
  };
  const LOSS = '#5eead4', STEP = '#7c8cff', BAD = '#f87171';

  const state = { fn: 'bowl', lr: 0.1, x0: 2.4, x: 2.4, iter: 0, path: [] as number[] };
  let raf = 0;

  const canvas = el('gd') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink, inv } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  // the surface on top, the loss at each step in a strip underneath
  const TOP = { x: 48, y: 20, w: W - 72, h: 360 };
  const STRIP = { x: 48, y: 430, w: W - 72, h: 140 };
  const X = { min: -3.2, max: 3.2 };

  function yRange(fn: Fn) {
    let lo = Infinity, hi = -Infinity;
    for (let i = 0; i <= 200; i++) {
      const y = fn.f(X.min + ((X.max - X.min) * i) / 200);
      lo = Math.min(lo, y);
      hi = Math.max(hi, y);
    }
    return { lo: lo - 0.3, hi: hi + 0.4 };
  }

  function drawSurface() {
    const fn = FNS[state.fn];
    const { lo, hi } = yRange(fn);
    const sx = (x: number) => TOP.x + ((x - X.min) / (X.max - X.min)) * TOP.w;
    const sy = (y: number) => TOP.y + TOP.h - ((y - lo) / (hi - lo)) * TOP.h;

    ctx.strokeStyle = ink(0.07);
    ctx.lineWidth = 1;
    for (let i = 0; i <= 8; i++) {
      const xv = X.min + ((X.max - X.min) * i) / 8;
      ctx.beginPath();
      ctx.moveTo(sx(xv), TOP.y);
      ctx.lineTo(sx(xv), TOP.y + TOP.h);
      ctx.stroke();
      label(xv.toFixed(1), sx(xv), TOP.y + TOP.h + 18, 0.3, 'center', 11.5);
    }
    label('x', TOP.x + TOP.w + 14, TOP.y + TOP.h + 4, 0.4, 'center', 11);

    ctx.strokeStyle = LOSS;
    ctx.lineWidth = 2.4;
    ctx.beginPath();
    for (let i = 0; i <= 400; i++) {
      const x = X.min + ((X.max - X.min) * i) / 400;
      i ? ctx.lineTo(sx(x), sy(fn.f(x))) : ctx.moveTo(sx(x), sy(fn.f(x)));
    }
    ctx.stroke();

    // the path so far, fading in towards the present
    ctx.strokeStyle = `rgba(124,140,255,0.35)`;
    ctx.lineWidth = 1;
    ctx.beginPath();
    state.path.forEach((xv, i) => (i ? ctx.lineTo(sx(xv), sy(fn.f(xv))) : ctx.moveTo(sx(xv), sy(fn.f(xv)))));
    ctx.stroke();
    ctx.fillStyle = STEP;
    state.path.forEach((xv, i) => {
      ctx.globalAlpha = 0.25 + (0.75 * i) / Math.max(1, state.path.length - 1);
      ctx.beginPath();
      ctx.arc(sx(xv), sy(fn.f(xv)), 3, 0, Math.PI * 2);
      ctx.fill();
    });
    ctx.globalAlpha = 1;

    // the tangent at the current point, which is the direction of the next step
    const gr = fn.g(state.x), dx = 0.7;
    ctx.strokeStyle = 'rgba(124,140,255,0.6)';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(sx(state.x - dx), sy(fn.f(state.x) - gr * dx));
    ctx.lineTo(sx(state.x + dx), sy(fn.f(state.x) + gr * dx));
    ctx.stroke();

    ctx.fillStyle = STEP;
    ctx.strokeStyle = inv(0.9);
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(sx(state.x), sy(fn.f(state.x)), 7, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();
  }

  function drawStrip() {
    const fn = FNS[state.fn];
    const losses = state.path.map((x) => fn.f(x));
    label('loss at each step', STRIP.x, STRIP.y - 10, 0.45, 'left', 11.5);
    ctx.strokeStyle = ink(0.12);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(STRIP.x, STRIP.y + STRIP.h);
    ctx.lineTo(STRIP.x + STRIP.w, STRIP.y + STRIP.h);
    ctx.stroke();
    if (losses.length < 1) return;
    const lo = Math.min(0, ...losses);
    let hi = Math.max(...losses);
    if (hi - lo < 1e-6) hi = lo + 1;
    const n = Math.max(2, losses.length);
    const sx = (i: number) => STRIP.x + (i / (n - 1)) * STRIP.w;
    const sy = (v: number) => STRIP.y + (1 - (v - lo) / (hi - lo)) * STRIP.h;

    const rising = losses.length > 2 && losses[losses.length - 1] > losses[losses.length - 3];
    ctx.strokeStyle = rising ? BAD : STEP;
    ctx.lineWidth = 2;
    ctx.beginPath();
    losses.forEach((v, i) => (i ? ctx.lineTo(sx(i), sy(v)) : ctx.moveTo(sx(i), sy(v))));
    ctx.stroke();
    const last = losses.length - 1;
    ctx.fillStyle = rising ? BAD : STEP;
    ctx.beginPath();
    ctx.arc(sx(last), sy(losses[last]), 3.5, 0, Math.PI * 2);
    ctx.fill();
    label(fixed(losses[last], 3), sx(last) + 8, sy(losses[last]) + 4, 1, 'left', 11.5, rising ? BAD : STEP);
    label(`k = ${state.iter}`, STRIP.x + STRIP.w, STRIP.y + STRIP.h + 16, 0.4, 'right', 11.5);
  }

  /** What the last few steps have been doing, in one word. */
  function verdict() {
    const fn = FNS[state.fn];
    const g = fn.g(state.x);
    const p = state.path;
    if (Math.abs(g) < 1e-3 && p.length > 1) return { word: 'at a minimum', why: 'The gradient is zero, so the next step goes nowhere.' };
    if (p.length < 3) return { word: 'starting', why: 'Each step moves x against the gradient, scaled by η.' };
    const l = p.slice(-4).map((x) => fn.f(x));
    if (l[l.length - 1] > l[0] && l[l.length - 1] > 1.5 * l[0]) return { word: 'diverging', why: 'The loss is climbing: η is too big for the curvature here.' };
    const d = p.slice(-4).map((x, i, a) => (i ? Math.sign(x - a[i - 1]) : 0)).slice(1);
    if (d[0] !== 0 && d.every((s, i, a) => i === 0 || s === -a[i - 1])) return { word: 'oscillating', why: 'x overshoots the valley and bounces from side to side.' };
    return { word: 'converging', why: 'The loss falls and the steps shrink with the gradient.' };
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    drawSurface();
    drawStrip();

    const fn = FNS[state.fn];
    const g = fn.g(state.x);
    const next = state.x - state.lr * g;
    const v = verdict();
    const S = (t: string) => `\\textcolor{${STEP}}{${t}}`, L = (t: string) => `\\textcolor{${LOSS}}{${t}}`;
    setEq({
      rule: [`${S('x_{k+1}')} = ${S('x_k')} - \\eta\\, ${L("f'(x_k)")}`],
      live: [
        `${S(`x_{${state.iter + 1}}`)} = ${S(fixed(state.x, 3))} - ${state.lr.toFixed(2)} \\times ${L(`(${fixed(g, 3)})`)} = ${S(fixed(next, 3))}`,
      ],
    });
    setResult({
      value: fixed(fn.f(state.x), 4),
      colour: v.word === 'diverging' ? BAD : undefined,
      status: `Iteration ${state.iter} · ${v.word}`,
      note: v.why,
    });
    setRows({ 'r-x': fixed(state.x, 4), 'r-grad': fixed(g, 4), 'r-iter': String(state.iter) });
  }

  // --- the algorithm ---------------------------------------------------------------

  function step() {
    const fn = FNS[state.fn];
    state.x = Math.max(X.min, Math.min(X.max, state.x - state.lr * fn.g(state.x)));
    state.iter++;
    state.path.push(state.x);
    if (state.path.length > 200) state.path.shift();
    draw();
  }
  function reset() {
    stop();
    state.x = state.x0;
    state.iter = 0;
    state.path = [state.x0];
    draw();
  }
  // The pause between steps is a timeout, so stopping has to cancel that too:
  // cancelling only the frame left one more step queued and the chain restarted.
  let timer = 0;
  let alive = false;
  function loop() {
    if (!alive) return;
    step();
    raf = requestAnimationFrame(() => { timer = window.setTimeout(loop, 120); });
  }
  function start() {
    alive = true;
    loop();
  }
  function stop() {
    alive = false;
    cancelAnimationFrame(raf);
    clearTimeout(timer);
    raf = 0;
    timer = 0;
    controls.setRunning(false);
  }

  // --- controls ------------------------------------------------------------------------

  const controls = transport({
    onRun: (running) => (running ? start() : stop()),
    onStep: () => { stop(); step(); },
    onReset: reset,
  });
  segmented('fn', (fn) => { state.fn = fn; reset(); });
  slider('lr', (v) => { state.lr = v; draw(); }, (v) => v.toFixed(2));
  slider('x0', (v) => { state.x0 = v; reset(); }, (v) => v.toFixed(2));

  reset();
</script>
