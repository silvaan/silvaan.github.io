---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Checks from '../../../components/sim/Checks.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
---

<SimLayout
  areaSlug="deep-learning"
  title="Attention as a Soft Lookup"
  description="Every key gets a score for how well it matches the query, softmax turns the scores into weights that add to one, and out comes a blend of all the values. Here the values are colours, so the blend is visible."
  shortcuts={['fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="att"
          width="1000"
          height="600"
          role="img"
          aria-label="A query arrow among six keys in a plane, a table of each key's score and softmax weight, and the blended colour that comes out."
        ></canvas>
      </div>
      <Caption
        legend={[{ label: 'the query', color: '#7c8cff' }, { label: 'a key, in the colour of its value', color: '#f2cd4a' }, { label: 'the output blend', color: 'rgba(160,165,175,0.7)' }]}
        hint="Drag the query arrow · click a row to mask that key out"
      />
      <Result label="Best match" />
    </div>

    <div class="sim-panel">
      <Seg id="preset" label="Ask about" attr="p" options={[{ value: 'fruit', label: 'fruit' }, { value: 'stone', label: 'stone' }, { value: 'between', label: 'in between' }]} />
      <Seg id="metric" label="Score each key by" attr="m" options={[{ value: 'dot', label: 'q·k' }, { value: 'cos', label: 'cos θ' }, { value: 'euc', label: 'distance' }]} />
      <Slider id="temp" label="Temperature τ" min={4} max={200} value={35} display="0.35" hint={['picks one', 'averages all']} />
      <Checks items={[{ id: 'hard', label: 'Hard lookup: all the weight on the best key' }]} />
      <Readout rows={[{ id: 'r-wsum', label: 'weights add to' }, { id: 'r-eff', label: 'keys it really uses' }]} />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Swing the query into the fruit cluster. Two or three keys score well, and
      the output colour becomes a <b>blend of exactly those values</b>. Nothing
      else is retrieved, but nothing is ever fully excluded either.
    </li>
    <li>
      Drag <b>temperature</b> to the left. The weights sharpen until one key has
      almost everything and the output is nearly that value alone: a hard lookup.
      Drag it right and every weight tends to 1/n, the output goes grey, and
      attention has stopped telling you anything.
    </li>
    <li>
      That is what the <b>√d</b> in the real formula is for. Dot products grow
      with the number of dimensions, and without dividing by √d the softmax would
      always land in that first, frozen regime.
    </li>
    <li>
      Watch <b>keys it really uses</b>: it is 1/Σw², the number of keys the
      output effectively draws on. Near one you have a lookup, near six you have
      an average.
    </li>
    <li>
      Mask a key by clicking its row. Its weight goes to zero and the others
      grow to fill the gap, because softmax always renormalises what is left.
      That single trick is how padding and causal masks work.
    </li>
    <li>
      Notice the query never has to equal a key. It only has to <b>point</b> the
      right way, which is why attention can retrieve things it has never seen an
      exact match for.
    </li>
    <li>
      Swap the score for <b>distance</b>. Softmax does not care what it is fed,
      so attention still works, but what it retrieves changes: −‖q−k‖²/2 is
      q·k minus ‖k‖²/2, which is the dot product with a <b>penalty on long
      keys</b>. That is the same fix as normalising, arrived at from the other
      side. Pick <b>cos θ</b> and the length of the query stops mattering at all,
      which is why the rings around the query tip collapse back into rays.
    </li>
    <li>
      Nothing on this page says where the query and the keys came from: they are
      given. Make every one of them a projection of the same sentence and this
      exact machine becomes
      <a href="/simulations/deep-learning/self-attention">Self-Attention</a>,
      where the dictionary being looked up is the sentence itself.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { arrow, roundRect } from '../../../lib/theorem';
  import { stageInk } from '../../../lib/draw';
  import { el, segmented, slider, check, result, readout } from '../../../lib/panel';

  type Item = { w: string; a: number; r: number; c: [number, number, number] };
  // A hand-made two-dimensional "meaning" plane: things that belong together
  // point together. The value each key hands over is a colour.
  const ITEMS: Item[] = [
    { w: 'lemon', a: 74, r: 0.95, c: [242, 205, 74] },
    { w: 'lime', a: 98, r: 0.88, c: [126, 214, 108] },
    { w: 'plum', a: 126, r: 0.8, c: [163, 112, 222] },
    { w: 'sky', a: 208, r: 0.9, c: [92, 168, 240] },
    { w: 'brick', a: 302, r: 0.86, c: [226, 112, 86] },
    { w: 'coal', a: 332, r: 0.78, c: [142, 147, 162] },
  ];
  const D = 2;
  const ACCENT = '#7c8cff', TEAL = '#5eead4';
  const state = { qa: (100 * Math.PI) / 180, ql: 0.95, metric: 'dot' as 'dot' | 'cos' | 'euc', temp: 0.35, hard: false, masked: new Set<number>() };

  const canvas = el('att') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink, inv } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();
  const rgb = (c: number[], a = 1) => `rgba(${c[0]},${c[1]},${c[2]},${a})`;

  const C = { x: 240, y: 250, R: 160 };
  const TAB = { x: 520, y: 60, w: 450, row: 50 };
  const OUT = { x: 30, y: 470, w: W - 60, h: 100 };
  const rad = (d: number) => (d * Math.PI) / 180;
  const kx = (it: Item) => C.x + C.R * it.r * Math.cos(rad(it.a));
  const ky = (it: Item) => C.y - C.R * it.r * Math.sin(rad(it.a));
  const qx = () => C.x + C.R * state.ql * Math.cos(state.qa);
  const qy = () => C.y - C.R * state.ql * Math.sin(state.qa);

  const score = (it: Item) => {
    const dq = rad(it.a) - state.qa;
    if (state.metric === 'cos') return Math.cos(dq);
    const dot = state.ql * it.r * Math.cos(dq);
    if (state.metric === 'dot') return dot / Math.sqrt(D);
    return -(state.ql ** 2 + it.r ** 2 - 2 * dot) / (2 * Math.sqrt(D));
  };
  const SCORE_TEX: Record<string, string> = { dot: '\\dfrac{q\\,K^{\\mathsf T}}{\\sqrt{d}}', cos: '\\cos\\theta', euc: '-\\dfrac{\\lVert q-k\\rVert^2}{2\\sqrt{d}}' };
  const SCORE_TXT: Record<string, string> = { dot: 'score = q·k / √d', cos: 'score = cos θ, length ignored', euc: 'score = −‖q−k‖² / 2√d' };

  function weights() {
    const live = ITEMS.map((it, i) => (state.masked.has(i) ? -Infinity : score(it)));
    if (state.hard) {
      let best = -Infinity, bi = -1;
      live.forEach((s, i) => { if (s > best) { best = s; bi = i; } });
      return live.map((_, i) => (i === bi ? 1 : 0));
    }
    const t = Math.max(0.04, state.temp);
    const mx = Math.max(...live);
    const e = live.map((s) => (s === -Infinity ? 0 : Math.exp((s - mx) / t)));
    const sum = e.reduce((a, b) => a + b, 0) || 1;
    return e.map((v) => v / sum);
  }
  const mix = (w: number[]) => [0, 1, 2].map((k) => Math.round(ITEMS.reduce((s, it, i) => s + w[i] * it.c[k], 0)));

  function drawPlane(w: number[]) {
    label('the query, and every key it could match', 30, 34, 0.45, 'left', 10.5);
    ctx.strokeStyle = ink(0.09);
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.arc(C.x, C.y, C.R, 0, Math.PI * 2); ctx.stroke();
    for (const g of [0, 90, 180, 270]) { ctx.beginPath(); ctx.moveTo(C.x, C.y); ctx.lineTo(C.x + C.R * Math.cos(rad(g)), C.y - C.R * Math.sin(rad(g))); ctx.stroke(); }
    if (state.metric === 'euc') {
      ctx.save();
      ctx.beginPath(); ctx.rect(0, 0, TAB.x - 26, OUT.y - 20); ctx.clip();
      ctx.strokeStyle = ink(0.1);
      ctx.setLineDash([2, 5]);
      for (const rr of [0.3, 0.6, 0.9, 1.2]) { ctx.beginPath(); ctx.arc(qx(), qy(), C.R * rr, 0, Math.PI * 2); ctx.stroke(); }
      ctx.setLineDash([]);
      ctx.restore();
    }
    ITEMS.forEach((it, i) => {
      const x = kx(it), y = ky(it);
      const off = state.masked.has(i);
      if (!off && w[i] > 0.002) {
        ctx.fillStyle = rgb(it.c, 0.16 + 0.34 * w[i]);
        ctx.beginPath(); ctx.arc(x, y, 8 + 34 * Math.sqrt(w[i]), 0, Math.PI * 2); ctx.fill();
      }
      ctx.strokeStyle = off ? ink(0.14) : rgb(it.c, 0.5 + 0.5 * w[i]);
      ctx.lineWidth = off ? 1 : 1.4 + 3 * w[i];
      ctx.beginPath(); ctx.moveTo(C.x, C.y); ctx.lineTo(x, y); ctx.stroke();
      ctx.fillStyle = off ? ink(0.2) : rgb(it.c, 1);
      ctx.beginPath(); ctx.arc(x, y, 5, 0, Math.PI * 2); ctx.fill();
      label(it.w, x + 18 * Math.cos(rad(it.a)), y - 18 * Math.sin(rad(it.a)) + 4, off ? 0.25 : 0.9, Math.cos(rad(it.a)) < -0.3 ? 'right' : Math.cos(rad(it.a)) > 0.3 ? 'left' : 'center', 11, off ? undefined : rgb(it.c, 1));
    });
    arrow(ctx, C.x, C.y, qx(), qy(), ACCENT, 3.4, 12);
    ctx.fillStyle = ACCENT;
    ctx.strokeStyle = inv(0.8);
    ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(qx(), qy(), 6.5, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
    label('query', C.x + (qx() - C.x) * 0.52 + 13 * Math.cos(state.qa + Math.PI / 2), C.y + (qy() - C.y) * 0.52 - 13 * Math.sin(state.qa + Math.PI / 2) + 4, 1, 'center', 11.5, ACCENT);
  }

  function drawTable(w: number[]) {
    label(`each key: a score, then a weight · ${SCORE_TXT[state.metric]}`, TAB.x, 34, 0.45, 'left', 10.5);
    const sc = ITEMS.map(score);
    const smax = Math.max(...sc.map(Math.abs), 0.2);
    const barX = TAB.x + 90, barW = 100;
    const wX = TAB.x + 250, wW = 130;
    ITEMS.forEach((it, i) => {
      const y = TAB.y + 28 + i * TAB.row;
      const off = state.masked.has(i);
      if (off) {
        ctx.fillStyle = ink(0.05);
        roundRect(ctx, TAB.x - 6, y - 18, TAB.w + 6, TAB.row - 10, 7);
        ctx.fill();
      }
      ctx.fillStyle = off ? ink(0.18) : rgb(it.c, 1);
      roundRect(ctx, TAB.x, y - 9, 10, 10, 3);
      ctx.fill();
      label(it.w, TAB.x + 18, y, off ? 0.3 : 0.85, 'left', 11.5);
      const zero = barX + barW / 2;
      ctx.strokeStyle = ink(0.14);
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(zero, y - 12); ctx.lineTo(zero, y + 6); ctx.stroke();
      const bw = (sc[i] / smax) * (barW / 2 - 2);
      ctx.fillStyle = off ? ink(0.12) : ink(0.4);
      ctx.fillRect(Math.min(zero, zero + bw), y - 9, Math.abs(bw), 10);
      label(sc[i].toFixed(2), TAB.x + 238, y, off ? 0.25 : 0.5, 'right', 10.5);
      ctx.fillStyle = ink(0.07);
      roundRect(ctx, wX, y - 10, wW, 12, 4);
      ctx.fill();
      if (w[i] > 0.001) {
        ctx.fillStyle = rgb(it.c, 0.9);
        roundRect(ctx, wX, y - 10, Math.max(2, wW * w[i]), 12, 4);
        ctx.fill();
      }
      label(`${(w[i] * 100).toFixed(1)}%`, wX + wW + 8, y, off ? 0.25 : 1, 'left', 11, off ? undefined : rgb(it.c, 1));
      if (off) label('masked', TAB.x + 18, y + 14, 0.3, 'left', 9.5);
    });
    label('score', barX + barW / 2, TAB.y + 6, 0.35, 'center', 10);
    label('weight', wX + wW / 2, TAB.y + 6, 0.35, 'center', 10);
  }

  function drawOutput(w: number[]) {
    label('what comes out: the values, in those proportions', OUT.x, OUT.y - 12, 0.45, 'left', 10.5);
    const swW = 110, barW = OUT.w - swW - 80;
    let x = OUT.x;
    ITEMS.forEach((it, i) => {
      const seg = barW * w[i];
      if (seg <= 0.4) return;
      ctx.fillStyle = rgb(it.c, 0.92);
      ctx.fillRect(x, OUT.y + 8, seg, 46);
      if (seg > 34) label(it.w, x + seg / 2, OUT.y + 36, 1, 'center', 10.5, 'rgba(12,14,18,0.85)');
      x += seg;
    });
    ctx.strokeStyle = ink(0.12);
    ctx.lineWidth = 1;
    ctx.strokeRect(OUT.x, OUT.y + 8, barW, 46);
    const ax = OUT.x + barW + 16;
    arrow(ctx, ax, OUT.y + 31, ax + 34, OUT.y + 31, ink(0.4), 2, 9);
    const out = mix(w);
    const sx2 = ax + 50;
    ctx.fillStyle = rgb(out, 1);
    roundRect(ctx, sx2, OUT.y + 8, swW, 46, 8);
    ctx.fill();
    ctx.strokeStyle = ink(0.2);
    ctx.stroke();
    label('output', sx2 + swW / 2, OUT.y + 72, 0.45, 'center', 10.5);
    label(`out = Σ w_i v_i = (${out[0]}, ${out[1]}, ${out[2]})`, OUT.x, OUT.y + 72, 0.4, 'left', 11);
  }

  function draw() {
    const w = weights();
    ctx.clearRect(0, 0, W, H);
    drawPlane(w);
    drawTable(w);
    drawOutput(w);
    words(w);
  }

  function words(w: number[]) {
    let bi = 0;
    w.forEach((v, i) => { if (v > w[bi]) bi = i; });
    const sum = w.reduce((s, v) => s + v, 0);
    const eff = 1 / Math.max(1e-9, w.reduce((s, v) => s + v * v, 0));
    const out = mix(w);
    const best = ITEMS[bi];
    setEq({
      rule: [['\\text{attn}(q,K,V)', ACCENT], `=\\operatorname{softmax}\\!\\Big(${SCORE_TEX[state.metric]}\\Big)`, ['V', TEAL]],
      live: [[`w_{\\text{${best.w}}} = ${(w[bi] * 100).toFixed(1)}\\%`, rgb(best.c)], `\\quad\\sum_i w_i = ${sum.toFixed(3)}`, [`\\quad 1/\\!\\sum_i w_i^2 = ${eff.toFixed(2)}\\text{ keys}`, rgb(out)]],
    });
    setResult({
      value: best.w,
      colour: rgb(best.c),
      status: `weight ${(w[bi] * 100).toFixed(1)}% · the six weights add to ${sum.toFixed(3)} · effectively ${eff.toFixed(2)} of ${ITEMS.length} keys used`,
      note: state.hard
        ? 'A hard lookup: one key takes all the weight and the output is exactly its value.'
        : eff < 1.5
          ? 'Nearly a lookup: one key dominates and the output is almost its value alone.'
          : eff > ITEMS.length - 1
            ? 'Nearly an average: every weight is close to 1/n, the output goes grey, and attention has stopped telling you anything.'
            : 'The weights are a soft choice of which values to average, and nothing about attention is more than that.',
    });
    setRows({ 'r-wsum': sum.toFixed(3), 'r-eff': `${eff.toFixed(2)} of ${ITEMS.length}` });
  }

  const local = (e: PointerEvent) => {
    const r = canvas.getBoundingClientRect();
    return { x: ((e.clientX - r.left) / r.width) * W, y: ((e.clientY - r.top) / r.height) * H };
  };
  let dragging = false;
  function aim(p: { x: number; y: number }) {
    const dx = p.x - C.x, dy = C.y - p.y;
    state.qa = Math.atan2(dy, dx);
    state.ql = Math.max(0.25, Math.min(1.15, Math.hypot(dx, dy) / C.R));
    draw();
  }
  canvas.addEventListener('pointerdown', (e) => {
    const p = local(e);
    try { canvas.setPointerCapture(e.pointerId); } catch { /* synthetic pointers are fine to ignore */ }
    if (p.x < TAB.x - 20 && p.y < OUT.y - 20) { dragging = true; aim(p); return; }
    if (p.x >= TAB.x - 20 && p.y > TAB.y && p.y < TAB.y + ITEMS.length * TAB.row + 20) {
      const i = Math.floor((p.y - TAB.y - 2) / TAB.row);
      if (i >= 0 && i < ITEMS.length) {
        state.masked.has(i) ? state.masked.delete(i) : state.masked.add(i);
        if (state.masked.size === ITEMS.length) state.masked.delete(i);
        draw();
      }
    }
  });
  canvas.addEventListener('pointermove', (e) => { if (dragging) aim(local(e)); });
  const drop = () => (dragging = false);
  canvas.addEventListener('pointerup', drop);
  canvas.addEventListener('pointercancel', drop);

  segmented('preset', (p) => { state.qa = rad(p === 'fruit' ? 100 : p === 'stone' ? 316 : 170); state.ql = 0.95; draw(); });
  segmented('metric', (m) => { state.metric = m as 'dot' | 'cos' | 'euc'; draw(); });
  slider('temp', (v) => { state.temp = v / 100; draw(); }, (v) => (v / 100).toFixed(2));
  check('hard', (on) => { state.hard = on; draw(); });

  draw();
</script>

<style>
  #att {
    cursor: crosshair;
    touch-action: none;
  }
</style>
