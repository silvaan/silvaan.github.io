---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="deep-learning"
  title="Optimizers"
  description="Six optimizers descend the same loss: a 1D slice where too big a learning rate overshoots and diverges, a surface you can click on, or a density cloud in three parameters."
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas id="opt" class="probe-canvas" width="1000" height="600" role="img" aria-label="Six optimizers leaving coloured trails as they descend a loss: a curve with the loss at each step underneath, a surface drawn as a wireframe, or a volumetric density cloud."></canvas>
      </div>
      <Caption
        legend={[
          { label: 'GD', color: '#f87171' },
          { label: 'Momentum', color: '#fbbf24' },
          { label: 'Nesterov', color: '#34d399' },
          { label: 'AdaGrad', color: '#f472b6' },
          { label: 'RMSProp', color: '#60a5fa' },
          { label: 'Adam', color: '#c084fc' },
        ]}
        hint="Drag to orbit · scroll to zoom · click the surface to set the start"
      />
      <Result label="Iteration" />
    </div>

    <div class="sim-panel">
      <Transport step>
        <button type="button" class="btn ghost" id="newstart">Random start</button>
        <button type="button" class="btn ghost" id="newfield">New field</button>
      </Transport>
      <Seg
        id="mode"
        label="Landscape"
        attr="m"
        active="surface"
        options={[
          { value: 'slice', label: '1D slice' },
          { value: 'surface', label: 'Surface' },
          { value: 'cloud', label: 'Density cloud' },
        ]}
      />
      <div id="slicewrap" hidden>
        <Seg
          id="curve"
          label="Curve"
          attr="c"
          options={[
            { value: 'bowl', label: 'Convex ½x²' },
            { value: 'double', label: 'Double well' },
            { value: 'wavy', label: 'Wavy' },
          ]}
        />
        <Slider id="eta" label="Learning rate η, all six" min={0.01} max={2.5} step={0.01} value={0.1} display="0.10" />
        <Slider id="x0" label="Start x<sub>0</sub>" min={-3} max={3} step={0.05} value={2.4} display="2.40" />
      </div>
      <div id="surfwrap">
        <Seg
          id="surf"
          label="Surface"
          attr="s"
          options={[
            { value: 'saddle', label: 'Saddle' },
            { value: 'wells', label: 'Two wells' },
            { value: 'ripples', label: 'Ripples' },
            { value: 'ravine', label: 'Ravine' },
            { value: 'monkey', label: 'Monkey' },
            { value: 'basin', label: 'Basin' },
            { value: 'eggcarton', label: 'Egg carton' },
            { value: 'banana', label: 'Banana' },
            { value: 'himmelblau', label: 'Himmelblau' },
          ]}
        />
      </div>
      <Slider id="sp" label="Speed, steps per second" min={2} max={80} value={10} />
      <div id="ptswrap" hidden>
        <Slider id="pts" label="Point density" min={600} max={6000} step={200} value={3500} />
      </div>
      <div class="control">
        <span class="section-label">Arrows</span>
        <div class="seg" id="arrows">
          <button type="button" data-a="grad" aria-pressed="false">Gradient</button>
          <button type="button" data-a="mom" aria-pressed="false">Momentum</button>
        </div>
      </div>
      <div class="control">
        <span class="section-label">Optimizers</span>
        <div id="sections"></div>
      </div>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      On the <b>1D slice</b> ½x², plain GD multiplies x by 1 − η each step. At
      <b>η = 1</b> it lands on the minimum in one step, above 1 it overshoots and
      bounces, above 2 it <b>diverges</b> and the loss strip climbs.
      <Try id="eta1" label="η = 1" /> <Try id="eta15" label="η = 1.5" /> <Try id="eta21" label="η = 2.1" />
    </li>
    <li>
      On the <b>Ravine</b>, GD drops onto the valley floor and then crawls along
      it. Momentum and Adam run along the floor and arrive long before.
      <Try id="ravine" />
    </li>
    <li>
      On <b>Ripples</b>, AdaGrad and RMSProp take the same step, gradient over a
      root of squared gradients. AdaGrad's sum only grows, so it lags far behind;
      RMSProp forgets with ρ and keeps its pace. <Try id="ripples" />
    </li>
    <li>
      In the <b>density cloud</b> the loss lives in three parameters and only the
      haze shows the minima. Orbit while it runs, and hit New field: from one
      start, different optimizers can end in different cores. <Try id="cloud" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { fixed, stageInk } from '../../../lib/draw';
  import { el, segmented, slider, transport, result, tries } from '../../../lib/panel';
  const canvas = el('opt') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const setEq = equation();
  const setResult = result();
  const css = (v: string) => getComputedStyle(canvas).getPropertyValue(v).trim();
  const isLight = () => css('--stage-light') === '1';
  const ink = () => css('--stage-ink') || '232,233,236';
  const { ink: inkA, inv } = stageInk(canvas);
  const { label } = makeText(ctx, inkA);
  const CX = W / 2;
  const CY = H / 2;
  const CAM = 3.25;
  const FOCAL = 2.75;
  const SCALE = 245;
  const EPS = 1e-7;

  /** How far the parameters may wander, per landscape. */
  const LIM = 1.3; // cloud: the box the points are sampled in
  // the surface half-width lives on each entry of SURFACES, read through ext()

  // ---------------------------------------------------------------------------
  // The two landscapes. Both boil down to one thing the optimizers care about:
  // a gradient at a point. Everything else is how it gets drawn.
  // ---------------------------------------------------------------------------
  /**
   * `d` is the half-width of the square of parameters the surface is drawn over,
   * and so also how far the optimizers may wander before they are clamped. It is
   * per surface because widening it is not free: a surface whose walls climb
   * steeply spends the whole height budget on those walls, and the structure in
   * the middle flattens into the floor. Where the formula tolerates a wider box,
   * it gets one; where the shape is what matters, it keeps a tight one.
   *
   * The amplitudes below are set against that. Height is normalised by the range
   * anyway, so scaling a surface changes no picture, only how hard it pushes: the
   * steeper polynomials are damped so that a wider box does not silently turn
   * every step into a leap.
   */
  type Surf = {
    d: number;
    f: (x: number, y: number) => number;
    g: (x: number, y: number) => { x: number; y: number };
  };
  const SURFACES: Record<string, Surf> = {
    // a quadratic is self-similar: a wider box is the same picture with more room
    saddle: { d: 3, f: (x, y) => 0.5 * (x * x - y * y), g: (x, y) => ({ x, y: -y }) },
    // the only tight one. Its walls are quartic and the two wells are at ±1, so
    // any wider and the wells shrink to dimples at the foot of the walls.
    wells: {
      d: 2,
      f: (x, y) => 0.6 * (x * x - 1) ** 2 + 0.5 * y * y,
      g: (x, y) => ({ x: 2.4 * x * (x * x - 1), y }),
    },
    // periodic: a wider box is more ripples, which is the point of it
    ripples: {
      d: 3,
      f: (x, y) => 0.18 * (x * x + y * y) - 0.5 * Math.cos(2.2 * x) - 0.5 * Math.cos(2.2 * y),
      g: (x, y) => ({ x: 0.36 * x + 1.1 * Math.sin(2.2 * x), y: 0.36 * y + 1.1 * Math.sin(2.2 * y) }),
    },
    ravine: {
      d: 3,
      f: (x, y) => 0.035 * x * x + 1.4 * y * y,
      g: (x, y) => ({ x: 0.07 * x, y: 2.8 * y }),
    },
    // cubic: damped by two thirds, so the wider box does not step three times as far
    monkey: {
      d: 3,
      f: (x, y) => 0.268 * (x * x * x - 3 * x * y * y),
      g: (x, y) => ({ x: 0.804 * (x * x - y * y), y: -1.608 * x * y }),
    },
    // bounded above, so the extra width is all flat: the gradient really does vanish
    basin: {
      d: 3,
      f: (x, y) => 1 - Math.exp(-(x * x + y * y)),
      g: (x, y) => { const e = Math.exp(-(x * x + y * y)); return { x: 2 * x * e, y: 2 * y * e }; },
    },
    eggcarton: {
      d: 3,
      f: (x, y) => 0.2 * (x * x + y * y) + 0.5 * Math.sin(2.5 * x) * Math.sin(2.5 * y),
      g: (x, y) => ({
        x: 0.4 * x + 1.25 * Math.cos(2.5 * x) * Math.sin(2.5 * y),
        y: 0.4 * y + 1.25 * Math.sin(2.5 * x) * Math.cos(2.5 * y),
      }),
    },
    banana: {
      d: 3,
      f: (x, y) => 0.011 * (1 - x) ** 2 + 0.11 * (y - x * x) ** 2,
      g: (x, y) => ({
        x: -0.022 * (1 - x) - 0.44 * x * (y - x * x),
        y: 0.22 * (y - x * x),
      }),
    },
    // Himmelblau as it is actually written. Its four minima sit out at a radius of
    // about four, so rather than squeeze the function into everyone else's box,
    // this one gets a box wide enough to hold them.
    himmelblau: {
      d: 4.5,
      f: (x, y) => 0.015 * ((x * x + y - 11) ** 2 + (x + y * y - 7) ** 2),
      g: (x, y) => {
        const a = x * x + y - 11, b = x + y * y - 7;
        return { x: 0.015 * (4 * x * a + 2 * b), y: 0.015 * (2 * a + 4 * y * b) };
      },
    },
  };

  /**
   * The 1D slice: one parameter, so the loss is a curve and each step can be
   * read straight off it. A ball that leaves the window has diverged and stops.
   */
  type Slice = { f: (x: number) => number; g: (x: number) => number };
  const SLICES: Record<string, Slice> = {
    bowl: { f: (x) => 0.5 * x * x, g: (x) => x },
    double: { f: (x) => 0.12 * x ** 4 - x * x + 0.4 * x + 1.2, g: (x) => 0.48 * x ** 3 - 2 * x + 0.4 },
    wavy: { f: (x) => 0.25 * x * x + Math.sin(3 * x), g: (x) => 0.5 * x + 3 * Math.cos(3 * x) },
  };
  const XS = 3.2;
  const LOSS = '#5eead4';

  const NMAX = 6000;
  type Blob = { x: number; y: number; z: number; s: number; a: number };
  let blobs: Blob[] = [];
  const cpx = new Float32Array(NMAX);
  const cpy = new Float32Array(NMAX);
  const cpz = new Float32Array(NMAX);
  const cpt = new Float32Array(NMAX);
  let nPoints = 0;
  let dMin = 0, dSpan = 1;

  function density(x: number, y: number, z: number) {
    let f = 0;
    for (const b of blobs) {
      const dx = x - b.x, dy = y - b.y, dz = z - b.z;
      f += b.a * Math.exp(-(dx * dx + dy * dy + dz * dz) / (2 * b.s * b.s));
    }
    return f;
  }
  // loss = −density, so minimising it means climbing into the dense cores
  const cloudLoss = (p: number[]) => -density(p[0], p[1], p[2]);

  type Mode = 'slice' | 'surface' | 'cloud';
  const state = {
    mode: 'surface' as Mode,
    curve: 'bowl', eta: 0.1,
    start1: [2.4],
    yaw: 0.7, pitch: -0.62, surf: 'saddle', speed: 10, running: false,
    iter: 0, showGrad: false, showMom: false, zoom: 1, count: 3500,
    start2: [1.0, 0.7],
    start3: [0.8, 0.6, 0.5],
  };
  const surfaceMode = () => state.mode === 'surface';
  const sliceMode = () => state.mode === 'slice';
  const start = () => (sliceMode() ? state.start1 : surfaceMode() ? state.start2 : state.start3);
  /** Half-width of the current surface's square of parameters. */
  const ext = () => SURFACES[state.surf].d;
  const limit = () => (sliceMode() ? XS : surfaceMode() ? ext() : LIM);

  let fmin = 0, fspan = 1;
  const curF = (x: number, y: number) => SURFACES[state.surf].f(x, y);

  function computeRange() {
    fmin = Infinity; let fmax = -Infinity;
    const D = ext();
    for (let i = 0; i <= 40; i++)
      for (let j = 0; j <= 40; j++) {
        const f = curF(-D + (2 * D * i) / 40, -D + (2 * D * j) / 40);
        if (f < fmin) fmin = f;
        if (f > fmax) fmax = f;
      }
    fspan = fmax - fmin || 1;
  }

  /** The one call the optimizers make. Analytic on a surface, differenced in the cloud. */
  function grad(p: number[]): number[] {
    if (sliceMode()) return [SLICES[state.curve].g(p[0])];
    if (surfaceMode()) {
      const g = SURFACES[state.surf].g(p[0], p[1]);
      return [g.x, g.y];
    }
    const h = 0.02;
    const out: number[] = [];
    for (let k = 0; k < 3; k++) {
      const a = [...p], b = [...p];
      a[k] += h; b[k] -= h;
      out.push((cloudLoss(a) - cloudLoss(b)) / (2 * h));
    }
    return out;
  }

  /**
   * Parameters to a point in the drawn scene. On a surface the two parameters
   * are the floor and the loss becomes the height; in the cloud all three
   * parameters are already spatial and nothing is added.
   */
  function toWorld(p: number[]): [number, number, number] {
    if (surfaceMode()) {
      const D = ext();
      return [p[0] / D, ((curF(p[0], p[1]) - fmin) / fspan) * 1.3 - 0.65, p[1] / D];
    }
    return [p[0], p[1], p[2]];
  }

  function project(x: number, y: number, z: number) {
    const cy = Math.cos(state.yaw), sy = Math.sin(state.yaw);
    const cp = Math.cos(state.pitch), sp = Math.sin(state.pitch);
    const x1 = x * cy + z * sy;
    const z1 = -x * sy + z * cy;
    const y2 = y * cp - z1 * sp;
    const z2 = y * sp + z1 * cp;
    const zc = z2 + CAM;
    const s = FOCAL / Math.max(0.05, zc);
    const k = s * SCALE * state.zoom;
    return { sx: CX + x1 * k, sy: CY - y2 * k, s: s * state.zoom, zc };
  }
  const projectP = (p: number[]) => {
    const w = toWorld(p);
    return project(w[0], w[1], w[2]);
  };

  function turbo(t: number) {
    t = Math.max(0, Math.min(1, t));
    const stops = [[30, 52, 140], [26, 150, 205], [45, 200, 120], [242, 202, 65], [238, 75, 62]];
    const seg = t * (stops.length - 1);
    const i = Math.min(stops.length - 2, Math.floor(seg));
    const f = seg - i;
    const a = stops[i], b = stops[i + 1];
    return [(a[0] + (b[0] - a[0]) * f) | 0, (a[1] + (b[1] - a[1]) * f) | 0, (a[2] + (b[2] - a[2]) * f) | 0];
  }
  const turboCss = (t: number) => { const c = turbo(t); return `rgb(${c[0]},${c[1]},${c[2]})`; };

  // ---------------------------------------------------------------------------
  // The optimizers, written once in vector form so the same code runs over two
  // parameters or three.
  // ---------------------------------------------------------------------------
  type Cfg = { on: boolean; lr: number; momentum: number; rho: number; beta1: number; beta2: number };
  type RT = { p: number[]; m: number[]; v: number[]; t: number; dead: boolean };

  const DEFS: { name: string; color: string; uses: string[]; step: (o: RT, c: Cfg) => void }[] = [
    {
      // full-batch: the exact gradient every step, no sampling noise
      name: 'GD', color: '#f87171', uses: ['lr'],
      step: (o, c) => {
        const g = grad(o.p);
        for (let k = 0; k < o.p.length; k++) o.p[k] -= c.lr * g[k];
      },
    },
    {
      name: 'Momentum', color: '#fbbf24', uses: ['lr', 'momentum'],
      step: (o, c) => {
        const g = grad(o.p);
        for (let k = 0; k < o.p.length; k++) {
          o.v[k] = c.momentum * o.v[k] - c.lr * g[k];
          o.p[k] += o.v[k];
        }
      },
    },
    {
      name: 'Nesterov', color: '#34d399', uses: ['lr', 'momentum'],
      step: (o, c) => {
        const look = o.p.map((v, k) => v + c.momentum * o.v[k]);
        const g = grad(look);
        for (let k = 0; k < o.p.length; k++) {
          o.v[k] = c.momentum * o.v[k] - c.lr * g[k];
          o.p[k] += o.v[k];
        }
      },
    },
    {
      // no decay on the accumulator: it only ever grows, so the effective step
      // shrinks monotonically. That is both AdaGrad's charm and its problem.
      name: 'AdaGrad', color: '#f472b6', uses: ['lr'],
      step: (o, c) => {
        const g = grad(o.p);
        for (let k = 0; k < o.p.length; k++) {
          o.v[k] += g[k] * g[k];
          o.p[k] -= (c.lr * g[k]) / (Math.sqrt(o.v[k]) + EPS);
        }
      },
    },
    {
      name: 'RMSProp', color: '#60a5fa', uses: ['lr', 'rho'],
      step: (o, c) => {
        const g = grad(o.p);
        for (let k = 0; k < o.p.length; k++) {
          o.v[k] = c.rho * o.v[k] + (1 - c.rho) * g[k] * g[k];
          o.p[k] -= (c.lr * g[k]) / (Math.sqrt(o.v[k]) + EPS);
        }
      },
    },
    {
      name: 'Adam', color: '#c084fc', uses: ['lr', 'beta1', 'beta2'],
      step: (o, c) => {
        const g = grad(o.p); o.t++;
        for (let k = 0; k < o.p.length; k++) {
          o.m[k] = c.beta1 * o.m[k] + (1 - c.beta1) * g[k];
          o.v[k] = c.beta2 * o.v[k] + (1 - c.beta2) * g[k] * g[k];
          const mh = o.m[k] / (1 - c.beta1 ** o.t), vh = o.v[k] / (1 - c.beta2 ** o.t);
          o.p[k] -= (c.lr * mh) / (Math.sqrt(vh) + EPS);
        }
      },
    },
  ];

  /** The velocity to show as the "momentum" arrow, where there is one. */
  function momentumOf(i: number): number[] | null {
    const n = DEFS[i].name;
    if (n === 'Momentum' || n === 'Nesterov') return rt[i].v;
    if (n === 'Adam') return rt[i].m;
    return null;
  }

  const PMETA: Record<string, { label: string; min: number; max: number; scale: number; fmt: number }> = {
    lr: { label: 'Learning rate', min: 2, max: 300, scale: 1000, fmt: 3 },
    momentum: { label: 'Momentum β', min: 0, max: 99, scale: 100, fmt: 2 },
    rho: { label: 'Decay ρ', min: 500, max: 999, scale: 1000, fmt: 3 },
    beta1: { label: 'β₁', min: 0, max: 99, scale: 100, fmt: 2 },
    beta2: { label: 'β₂', min: 9000, max: 9999, scale: 10000, fmt: 4 },
  };

  const cfg: Cfg[] = DEFS.map(() => ({ on: true, lr: 0.04, momentum: 0.9, rho: 0.9, beta1: 0.9, beta2: 0.999 }));
  let rt: RT[] = [];
  const trails: number[][][] = [];

  function resetOpts() {
    const s = start();
    const n = s.length;
    rt = DEFS.map(() => ({ p: [...s], m: new Array(n).fill(0), v: new Array(n).fill(0), t: 0, dead: false }));
    state.iter = 0;
    trails.length = 0;
    for (let i = 0; i < DEFS.length; i++) trails.push([[...s]]);
  }

  function stepAll() {
    const L = limit();
    const slice = sliceMode();
    DEFS.forEach((def, i) => {
      if (!cfg[i].on) return;
      const o = rt[i];
      if (o.dead || !isFinite(o.p[0])) return;
      // in the slice one shared η drives all six, so overshoot reads the same for each
      def.step(o, slice ? { ...cfg[i], lr: state.eta } : cfg[i]);
      if (slice) {
        // no clamping here: leaving the window is the divergence being shown
        if (Math.abs(o.p[0]) > L) o.dead = true;
      } else for (let k = 0; k < o.p.length; k++) o.p[k] = Math.max(-L, Math.min(L, o.p[k]));
      const tr = trails[i];
      tr.push([...o.p]);
      if (tr.length > 600) tr.shift();
    });
    state.iter++;
  }

  function newField() {
    const n = 3 + Math.floor(Math.random() * 3);
    blobs = [];
    for (let i = 0; i < n; i++) {
      blobs.push({
        x: Math.random() * 1.4 - 0.7, y: Math.random() * 1.4 - 0.7, z: Math.random() * 1.4 - 0.7,
        s: 0.2 + Math.random() * 0.22, a: 0.6 + Math.random() * 0.9,
      });
    }
    dMin = Infinity; let dMax = -Infinity;
    for (let i = 0; i < 6000; i++) {
      const d = density(Math.random() * 2.4 - 1.2, Math.random() * 2.4 - 1.2, Math.random() * 2.4 - 1.2);
      if (d < dMin) dMin = d;
      if (d > dMax) dMax = d;
    }
    dSpan = dMax - dMin || 1;

    nPoints = 0;
    let tries = 0;
    while (nPoints < NMAX && tries < NMAX * 60) {
      tries++;
      const x = Math.random() * 2.2 - 1.1, y = Math.random() * 2.2 - 1.1, z = Math.random() * 2.2 - 1.1;
      const t = (density(x, y, z) - dMin) / dSpan;
      if (Math.random() < Math.pow(Math.max(0, t), 1.6) * 0.9 + 0.02) {
        cpx[nPoints] = x; cpy[nPoints] = y; cpz[nPoints] = z; cpt[nPoints] = t;
        nPoints++;
      }
    }
  }

  function arrow(p: number[], dir: number[], L: number, color: string, dashed: boolean) {
    const a = projectP(p);
    const b = projectP(p.map((v, k) => v + dir[k] * L));
    if (a.zc <= 0.1 || b.zc <= 0.1) return;
    ctx.strokeStyle = color; ctx.fillStyle = color; ctx.lineWidth = 2;
    if (dashed) ctx.setLineDash([4, 3]);
    ctx.beginPath(); ctx.moveTo(a.sx, a.sy); ctx.lineTo(b.sx, b.sy); ctx.stroke();
    ctx.setLineDash([]);
    const ang = Math.atan2(b.sy - a.sy, b.sx - a.sx);
    const hs = 7;
    ctx.beginPath();
    ctx.moveTo(b.sx, b.sy);
    ctx.lineTo(b.sx - hs * Math.cos(ang - 0.45), b.sy - hs * Math.sin(ang - 0.45));
    ctx.lineTo(b.sx - hs * Math.cos(ang + 0.45), b.sy - hs * Math.sin(ang + 0.45));
    ctx.closePath(); ctx.fill();
  }

  // --- the two backdrops -----------------------------------------------------
  function drawSurface() {
    const M = 30;
    const D = ext();
    for (let i = 0; i <= M; i++) {
      for (const axis of [0, 1]) {
        ctx.beginPath();
        let started = false;
        for (let j = 0; j <= M; j++) {
          const a = -D + (2 * D * i) / M;
          const b = -D + (2 * D * j) / M;
          const x = axis === 0 ? b : a;
          const y = axis === 0 ? a : b;
          const p = projectP([x, y]);
          if (p.zc <= 0.1) { started = false; continue; }
          if (!started) { ctx.moveTo(p.sx, p.sy); started = true; } else ctx.lineTo(p.sx, p.sy);
        }
        const a = -D + (2 * D * i) / M;
        const tH = (curF(axis === 0 ? 0 : a, axis === 0 ? a : 0) - fmin) / fspan;
        if (isLight()) {
          const m = turbo(tH);
          ctx.strokeStyle = `rgb(${(m[0] * 0.6) | 0},${(m[1] * 0.6) | 0},${(m[2] * 0.6) | 0})`;
          ctx.globalAlpha = 0.65;
        } else {
          ctx.strokeStyle = turboCss(tH);
          ctx.globalAlpha = 0.38;
        }
        ctx.lineWidth = 1;
        ctx.stroke();
        ctx.globalAlpha = 1;
      }
    }

    const sm = projectP(state.start2);
    if (sm.zc > 0.1) {
      ctx.strokeStyle = `rgba(${ink()},0.55)`;
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.arc(sm.sx, sm.sy, 4, 0, 6.2832);
      ctx.stroke();
    }
  }

  function drawCloud() {
    const light = isLight();
    ctx.globalCompositeOperation = light ? 'multiply' : 'lighter';
    const count = Math.min(state.count, nPoints);
    for (let i = 0; i < count; i++) {
      const p = project(cpx[i], cpy[i], cpz[i]);
      if (p.zc <= 0.1) continue;
      const c = turbo(cpt[i]);
      const alpha = light ? 0.1 + 0.44 * cpt[i] : 0.07 + 0.36 * cpt[i];
      const r = Math.max(0.7, 1.5 * p.s);
      ctx.fillStyle = `rgba(${c[0]},${c[1]},${c[2]},${alpha})`;
      ctx.beginPath();
      ctx.arc(p.sx, p.sy, r, 0, 6.2832);
      ctx.fill();
    }
    ctx.globalCompositeOperation = 'source-over';
  }

  // --- the 1D slice: the curve on top, the loss at each step underneath ---------
  const TOP = { x: 48, y: 20, w: W - 72, h: 360 };
  const STRIP = { x: 48, y: 430, w: W - 72, h: 140 };

  function arrowFlat(x1: number, y1: number, x2: number, y2: number, color: string, dashed: boolean) {
    ctx.strokeStyle = color; ctx.fillStyle = color; ctx.lineWidth = 2;
    if (dashed) ctx.setLineDash([4, 3]);
    ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke();
    ctx.setLineDash([]);
    const ang = Math.atan2(y2 - y1, x2 - x1), hs = 7;
    ctx.beginPath();
    ctx.moveTo(x2, y2);
    ctx.lineTo(x2 - hs * Math.cos(ang - 0.45), y2 - hs * Math.sin(ang - 0.45));
    ctx.lineTo(x2 - hs * Math.cos(ang + 0.45), y2 - hs * Math.sin(ang + 0.45));
    ctx.closePath(); ctx.fill();
  }

  function drawSlice() {
    const fn = SLICES[state.curve];
    let lo = Infinity, hi = -Infinity;
    for (let i = 0; i <= 200; i++) {
      const y = fn.f(-XS + (2 * XS * i) / 200);
      lo = Math.min(lo, y); hi = Math.max(hi, y);
    }
    lo -= 0.3; hi += 0.4;
    const sx = (x: number) => TOP.x + ((x + XS) / (2 * XS)) * TOP.w;
    const sy = (y: number) => TOP.y + TOP.h - ((y - lo) / (hi - lo)) * TOP.h;

    ctx.strokeStyle = inkA(0.07);
    ctx.lineWidth = 1;
    for (let i = 0; i <= 8; i++) {
      const xv = -XS + (2 * XS * i) / 8;
      ctx.beginPath(); ctx.moveTo(sx(xv), TOP.y); ctx.lineTo(sx(xv), TOP.y + TOP.h); ctx.stroke();
      label(xv.toFixed(1), sx(xv), TOP.y + TOP.h + 18, 0.3, 'center', 11.5);
    }
    label('x', TOP.x + TOP.w + 14, TOP.y + TOP.h + 4, 0.4, 'center', 11);

    ctx.strokeStyle = LOSS;
    ctx.lineWidth = 2.4;
    ctx.beginPath();
    for (let i = 0; i <= 400; i++) {
      const x = -XS + (2 * XS * i) / 400;
      i ? ctx.lineTo(sx(x), sy(fn.f(x))) : ctx.moveTo(sx(x), sy(fn.f(x)));
    }
    ctx.stroke();

    // start marker
    ctx.strokeStyle = inkA(0.55);
    ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.arc(sx(state.start1[0]), sy(fn.f(state.start1[0])), 4, 0, 6.2832); ctx.stroke();

    ctx.save();
    ctx.beginPath(); ctx.rect(TOP.x, TOP.y, TOP.w, TOP.h); ctx.clip();
    DEFS.forEach((def, i) => {
      if (!cfg[i].on) return;
      const tr = trails[i].slice(-120);
      // the zig-zag between steps, then a dot at each step
      ctx.strokeStyle = def.color;
      ctx.globalAlpha = 0.45;
      ctx.lineWidth = 1;
      ctx.beginPath();
      tr.forEach((pt, k) => (k ? ctx.lineTo(sx(pt[0]), sy(fn.f(pt[0]))) : ctx.moveTo(sx(pt[0]), sy(fn.f(pt[0])))));
      ctx.stroke();
      ctx.fillStyle = def.color;
      tr.forEach((pt, k) => {
        ctx.globalAlpha = 0.2 + (0.6 * k) / Math.max(1, tr.length - 1);
        ctx.beginPath(); ctx.arc(sx(pt[0]), sy(fn.f(pt[0])), 2.6, 0, 6.2832); ctx.fill();
      });
      ctx.globalAlpha = 1;
    });
    ctx.restore();

    DEFS.forEach((def, i) => {
      if (!cfg[i].on) return;
      const o = rt[i];
      const x = Math.max(-XS, Math.min(XS, o.p[0]));
      const px = sx(x), py = Math.max(TOP.y + 6, Math.min(TOP.y + TOP.h, sy(fn.f(x))));
      if (state.showGrad && !o.dead) {
        const g = fn.g(o.p[0]);
        if (Math.abs(g) > 1e-5) arrowFlat(px, py - 12, px - Math.sign(g) * 46, py - 12, `rgba(${ink()},0.92)`, true);
      }
      if (state.showMom && !o.dead) {
        const v = momentumOf(i);
        if (v && Math.abs(v[0]) > 1e-5) {
          const len = Math.min(110, Math.abs(v[0]) * 160) + 10;
          arrowFlat(px, py + 12, px + Math.sign(v[0]) * len, py + 12, def.color, false);
        }
      }
      ctx.fillStyle = def.color;
      ctx.strokeStyle = inv(0.9);
      ctx.lineWidth = 2;
      ctx.beginPath(); ctx.arc(px, py, 6, 0, 6.2832); ctx.fill(); ctx.stroke();
      if (o.dead) label('diverged', px, py + (py < TOP.y + 40 ? 22 : -14), 1, x < 0 ? 'left' : 'right', 11, def.color);
    });

    // the training curve: loss at each step, one line per optimizer
    label('loss at each step', STRIP.x, STRIP.y - 10, 0.45, 'left', 11.5);
    ctx.strokeStyle = inkA(0.12);
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(STRIP.x, STRIP.y + STRIP.h); ctx.lineTo(STRIP.x + STRIP.w, STRIP.y + STRIP.h); ctx.stroke();
    const series = DEFS.map((_, i) => (cfg[i].on ? trails[i].map((pt) => fn.f(pt[0])) : []));
    const all = series.flat();
    if (!all.length) return;
    const slo = Math.min(0, ...all);
    let shi = Math.max(...all);
    if (shi - slo < 1e-6) shi = slo + 1;
    const n = Math.max(2, ...series.map((l) => l.length));
    const tx = (k: number) => STRIP.x + (k / (n - 1)) * STRIP.w;
    const ty = (v: number) => STRIP.y + (1 - (v - slo) / (shi - slo)) * STRIP.h;
    series.forEach((l, i) => {
      if (!l.length) return;
      ctx.strokeStyle = DEFS[i].color;
      ctx.lineWidth = 2;
      ctx.beginPath();
      l.forEach((v, k) => (k ? ctx.lineTo(tx(k), ty(v)) : ctx.moveTo(tx(k), ty(v))));
      ctx.stroke();
      const k = l.length - 1;
      ctx.fillStyle = DEFS[i].color;
      ctx.beginPath(); ctx.arc(tx(k), ty(l[k]), 3.5, 0, 6.2832); ctx.fill();
    });
    label(`k = ${state.iter}`, STRIP.x + STRIP.w, STRIP.y + STRIP.h + 16, 0.4, 'right', 11.5);
  }

  /** What GD's last few steps have been doing, in one word. */
  function verdict() {
    const fn = SLICES[state.curve];
    const o = rt[0];
    const p = trails[0].map((pt) => pt[0]);
    if (!cfg[0].on) return { word: 'off', why: 'Turn GD back on to read its verdict here.' };
    if (o.dead) return { word: 'diverged', why: 'Every step overshot by more than it corrected, so x left the window.' };
    if (Math.abs(fn.g(o.p[0])) < 1e-3 && p.length > 1) return { word: 'at a minimum', why: 'The gradient is zero, so the next step goes nowhere.' };
    if (p.length < 3) return { word: 'starting', why: 'Each step moves x against the gradient, scaled by η.' };
    const l = p.slice(-4).map((x) => fn.f(x));
    if (l[l.length - 1] > 1.5 * l[0] && l[l.length - 1] > l[0]) return { word: 'diverging', why: 'The loss is climbing: η is too big for the curvature here.' };
    const d = p.slice(-4).map((x, i, a) => (i ? Math.sign(x - a[i - 1]) : 0)).slice(1);
    if (d[0] !== 0 && d.every((s, i, a) => i === 0 || s === -a[i - 1])) return { word: 'oscillating', why: 'x overshoots the minimum and bounces from side to side.' };
    return { word: 'converging', why: 'The loss falls and the steps shrink with the gradient.' };
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    if (sliceMode()) {
      drawSlice();
      words();
      return;
    }
    if (surfaceMode()) drawSurface();
    else drawCloud();

    DEFS.forEach((def, i) => {
      if (!cfg[i].on) return;
      const tr = trails[i];
      ctx.strokeStyle = def.color;
      ctx.lineWidth = 2;
      ctx.globalAlpha = 0.85;
      ctx.beginPath();
      let started = false;
      for (const pt of tr) {
        const p = projectP(pt);
        if (p.zc <= 0.1) { started = false; continue; }
        if (!started) { ctx.moveTo(p.sx, p.sy); started = true; } else ctx.lineTo(p.sx, p.sy);
      }
      ctx.stroke();
      ctx.globalAlpha = 1;

      const o = rt[i];
      if (state.showGrad) {
        const g = grad(o.p);
        const m = Math.hypot(...g);
        if (m > 1e-5) arrow(o.p, g.map((v) => -v / m), surfaceMode() ? 0.34 : 0.3, `rgba(${ink()},0.92)`, true);
      }
      if (state.showMom) {
        const v = momentumOf(i);
        if (v) {
          const m = Math.hypot(...v);
          if (m > 1e-5)
            arrow(o.p, v.map((c) => c / m), Math.min(0.55, m * (surfaceMode() ? 5 : 6)) + 0.05, def.color, false);
        }
      }

      const p = projectP(o.p);
      if (p.zc > 0.1) {
        ctx.fillStyle = def.color;
        ctx.beginPath();
        ctx.arc(p.sx, p.sy, Math.max(3.5, 4.5 * p.s), 0, 6.2832);
        ctx.fill();
        ctx.strokeStyle = 'rgba(0,0,0,0.5)';
        ctx.lineWidth = 1;
        ctx.stroke();
      }
    });

    drawGizmo();
    words();
  }

  function words() {
    const on = cfg.filter((c) => c.on).length;
    const s = surfaceMode();
    if (sliceMode()) {
      const fn = SLICES[state.curve];
      const x = rt[0].p[0], g = fn.g(x), v = verdict();
      const GD = DEFS[0].color;
      setEq({
        rule: [['x_{k+1}', GD], '=', ['x_k', GD], '- \\eta\\,', ["f'(x_k)", LOSS]],
        live: [
          [`x_{${trails[0].length}}`, GD], '=', [fixed(x, 3), GD],
          `- ${state.eta.toFixed(2)} \\times`, [`(${fixed(g, 3)})`, LOSS], '=', [fixed(x - state.eta * g, 3), GD],
        ],
      });
      setResult({
        value: String(state.iter),
        colour: v.word.startsWith('diverg') ? GD : undefined,
        status: `GD: ${v.word} · ${on} of ${DEFS.length} optimizers running · 1 parameter`,
        note: v.why,
      });
      return;
    }
    setEq({
      rule: ['\\theta_{t+1} = \\theta_t - \\eta\\,\\hat g_t', '\\qquad', ['\\hat g_t \\in \\{\\, g_t,\\; \\beta m_{t-1} + g_t,\\; g_t / \\sqrt{v_t} \\,\\}', 'rgba(160,165,175,0.9)']],
      live: [`t = ${state.iter}`, `\\quad\\eta_{\\text{GD}} = ${cfg[0].lr.toFixed(3)}`, `\\quad\\beta = ${cfg[1].momentum.toFixed(2)}`, `\\quad d = ${s ? 2 : 3}`],
    });
    setResult({
      value: String(state.iter),
      status: `${on} of ${DEFS.length} optimizers running · ${s ? `${state.surf} surface, 2 parameters` : 'density cloud, 3 parameters'}`,
      note: s
        ? 'The loss is the height. Every optimizer only ever asks one question, the gradient where it stands; the coloured arrow is the inertia a momentum method carries.'
        : 'The loss is minus the density, so the balls climb into the bright cores. Past two parameters there is no height to read off, only the haze.',
    });
  }

  function drawGizmo() {
    const ox = 50, oy = H - 50, len = 28;
    const cy = Math.cos(state.yaw), sy = Math.sin(state.yaw);
    const cp = Math.cos(state.pitch), sp = Math.sin(state.pitch);
    // on a surface the vertical axis is the loss itself, in the cloud it is a
    // third parameter like the other two
    const up = surfaceMode() ? 'f' : 'y';
    const across = surfaceMode() ? 'y' : 'z';
    const axes = [
      { v: [1, 0, 0], c: '#f87171', l: 'x' },
      { v: [0, 1, 0], c: '#4ade80', l: up },
      { v: [0, 0, 1], c: '#60a5fa', l: across },
    ];
    const proj = axes.map((a) => {
      const [x, y, z] = a.v;
      const x1 = x * cy + z * sy;
      const z1 = -x * sy + z * cy;
      const y2 = y * cp - z1 * sp;
      const z2 = y * sp + z1 * cp;
      return { ex: ox + x1 * len, ey: oy - y2 * len, depth: z2, c: a.c, l: a.l };
    });
    proj.sort((a, b) => a.depth - b.depth);
    ctx.lineWidth = 2;
    ctx.font = "600 11px 'JetBrains Mono', monospace";
    for (const a of proj) {
      ctx.strokeStyle = a.c; ctx.fillStyle = a.c;
      ctx.beginPath(); ctx.moveTo(ox, oy); ctx.lineTo(a.ex, a.ey); ctx.stroke();
      ctx.beginPath(); ctx.arc(a.ex, a.ey, 2.3, 0, 6.2832); ctx.fill();
      ctx.fillText(a.l, a.ex + 3, a.ey - 3);
    }
  }

  // per-optimizer cards: coloured checkbox (toggle on/off) + collapsible params
  const sections = document.getElementById('sections')!;
  sections.innerHTML = DEFS
    .map((d, i) => {
      const rows = d.uses
        .map((p) => {
          const m = PMETA[p];
          const val = (cfg[i] as any)[p] as number;
          return `<div class="control${p === 'lr' ? ' opt-lr' : ''}"><label>${m.label} <b id="v-${i}-${p}">${val.toFixed(m.fmt)}</b></label><input type="range" id="s-${i}-${p}" min="${m.min}" max="${m.max}" value="${Math.round(val * m.scale)}"></div>`;
        })
        .join('');
      return `<div class="opt-card" data-i="${i}"><div class="opt-head"><input type="checkbox" class="opt-check" data-i="${i}" checked style="accent-color:${d.color}"><span class="opt-name">${d.name}</span><span class="opt-toggle"></span></div><div class="opt-body">${rows}</div></div>`;
    })
    .join('');

  sections.addEventListener('change', (e) => {
    const cb = (e.target as HTMLElement).closest('.opt-check') as HTMLInputElement | null;
    if (!cb) return;
    setOn(+cb.dataset.i!, cb.checked);
  });
  /** Switch one optimizer on or off, keeping its card in step. */
  function setOn(i: number, on: boolean) {
    cfg[i].on = on;
    const card = sections.querySelector(`.opt-card[data-i="${i}"]`) as HTMLElement;
    (card.querySelector('.opt-check') as HTMLInputElement).checked = on;
    card.classList.toggle('off', !on);
  }
  sections.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('.opt-check')) return;
    const head = (e.target as HTMLElement).closest('.opt-head');
    if (!head) return;
    (head.closest('.opt-card') as HTMLElement).classList.toggle('open');
  });

  sections.querySelectorAll('input[type=range]').forEach((el) => {
    el.addEventListener('input', () => {
      const [, iStr, p] = (el as HTMLInputElement).id.split('-');
      const i = +iStr;
      const m = PMETA[p];
      const v = +(el as HTMLInputElement).value / m.scale;
      (cfg[i] as any)[p] = v;
      (document.getElementById(`v-${i}-${p}`) as HTMLElement).textContent = v.toFixed(m.fmt);
    });
  });

  // ---- click on the surface to set the start ----
  function pickStart(clientX: number, clientY: number) {
    const rect = canvas.getBoundingClientRect();
    const mx = ((clientX - rect.left) / rect.width) * W;
    const my = ((clientY - rect.top) / rect.height) * H;
    if (sliceMode()) {
      if (my > TOP.y + TOP.h + 24 || mx < TOP.x || mx > TOP.x + TOP.w) return;
      const x = Math.max(-3, Math.min(3, -XS + ((mx - TOP.x) / TOP.w) * 2 * XS));
      setStart1(+x.toFixed(2));
      return;
    }
    if (!surfaceMode()) return;
    let bestD = Infinity, bx = 0, by = 0, found = false;
    const G = 80;
    const D = ext();
    for (let i = 0; i <= G; i++)
      for (let j = 0; j <= G; j++) {
        const x = -D + (2 * D * i) / G;
        const y = -D + (2 * D * j) / G;
        const p = projectP([x, y]);
        if (p.zc <= 0.1) continue;
        const d = (p.sx - mx) ** 2 + (p.sy - my) ** 2;
        if (d < bestD) { bestD = d; bx = x; by = y; found = true; }
      }
    if (found && bestD < 44 * 44) {
      state.start2 = [bx, by];
      resetOpts();
    }
  }

  // ---- interaction (orbit vs click) ----
  let dragging = false, moved = false, lastX = 0, lastY = 0, downX = 0, downY = 0;
  canvas.addEventListener('pointerdown', (e) => {
    dragging = true; moved = false;
    lastX = e.clientX; lastY = e.clientY; downX = e.clientX; downY = e.clientY;
    canvas.setPointerCapture(e.pointerId);
  });
  canvas.addEventListener('pointermove', (e) => {
    if (!dragging) return;
    if (Math.hypot(e.clientX - downX, e.clientY - downY) > 4) moved = true;
    if (sliceMode()) return; // a flat plot has nothing to orbit
    state.yaw += (e.clientX - lastX) * 0.01;
    // the surface is only readable from above; the cloud can be seen from anywhere
    const hi = surfaceMode() ? -0.05 : 1.45;
    state.pitch = Math.max(-1.45, Math.min(hi, state.pitch + (e.clientY - lastY) * 0.01));
    lastX = e.clientX; lastY = e.clientY;
    if (!state.running) draw();
  });
  canvas.addEventListener('pointerup', (e) => {
    dragging = false;
    if (!moved) pickStart(e.clientX, e.clientY);
  });
  canvas.addEventListener('pointercancel', () => (dragging = false));

  canvas.addEventListener(
    'wheel',
    (e) => {
      if (sliceMode()) return;
      e.preventDefault();
      state.zoom *= e.deltaY < 0 ? 1.1 : 1 / 1.1;
      state.zoom = Math.max(0.5, Math.min(4, state.zoom));
      if (!state.running) draw();
    },
    { passive: false }
  );

  // ---- controls ----
  /** Show only the controls that mean something for the landscape on screen. */
  const HINTS: Record<Mode, string> = {
    slice: 'Click the curve to set the start · η here is shared by all six',
    surface: 'Drag to orbit · scroll to zoom · click the surface to set the start',
    cloud: 'Drag to orbit · scroll to zoom',
  };
  function syncControls() {
    const m = state.mode;
    el('slicewrap').hidden = m !== 'slice';
    el('surfwrap').hidden = m !== 'surface';
    el('ptswrap').hidden = m !== 'cloud';
    el('newfield').hidden = m !== 'cloud';
    sections.classList.toggle('slice', m === 'slice');
    canvas.classList.toggle('orbit-only', m === 'cloud');
    canvas.classList.toggle('flat', m === 'slice');
    el('scene-hint').textContent = HINTS[m];
  }

  function setMode(m: Mode) {
    state.mode = m;
    modes.select(m);
    if (m === 'cloud') {
      if (!nPoints) newField();
      // looking slightly down suits the cloud; the surface needs a steeper view
      state.pitch = Math.max(-1.45, Math.min(1.45, state.pitch));
    } else if (m === 'surface') {
      state.pitch = Math.max(-1.45, Math.min(-0.05, state.pitch));
    }
    syncControls();
    resetOpts();
    draw();
  }
  function setSurf(sname: string) {
    state.surf = sname;
    surfs.select(sname);
    // surfaces do not share one box any more, so a start picked on a wide one has
    // to be pulled back inside a narrower one
    const D = ext();
    state.start2 = state.start2.map((v) => Math.max(-D, Math.min(D, v)));
    computeRange();
    resetOpts();
  }
  const modes = segmented('mode', (m) => setMode(m as Mode));
  const surfs = segmented('surf', setSurf);
  const curves = segmented('curve', (c) => { state.curve = c; resetOpts(); });
  const setEtaSlider = slider('eta', (v) => (state.eta = v), (v) => v.toFixed(2));
  const setX0Slider = slider('x0', (v) => { state.start1 = [v]; resetOpts(); }, (v) => v.toFixed(2));
  function setStart1(x: number) {
    state.start1 = [x];
    setX0Slider(x);
    resetOpts();
  }

  // both arrows can be on at once, so this group is a pair of toggles, not a choice
  el('arrows').addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn) return;
    btn.classList.toggle('active');
    const on = btn.classList.contains('active');
    btn.setAttribute('aria-pressed', String(on));
    if (btn.dataset.a === 'grad') state.showGrad = on; else state.showMom = on;
    if (!state.running) draw();
  });
  slider('sp', (v) => (state.speed = v));
  slider('pts', (v) => { state.count = v; if (!state.running) draw(); });
  const ctl = transport({
    onRun: (running) => (state.running = running),
    onStep: () => { stepAll(); draw(); },
    onReset: () => { resetOpts(); draw(); },
  });
  el('newfield').addEventListener('click', () => { newField(); resetOpts(); draw(); });
  el('newstart').addEventListener('click', () => {
    if (sliceMode()) {
      setStart1(+(Math.random() * 5.6 - 2.8).toFixed(2));
      draw();
      return;
    }
    if (surfaceMode()) {
      const r = 0.75 * ext();
      state.start2 = [+(Math.random() * 2 * r - r).toFixed(2), +(Math.random() * 2 * r - r).toFixed(2)];
    }
    else
      state.start3 = [
        +(Math.random() * 2 - 1).toFixed(2),
        +(Math.random() * 2 - 1).toFixed(2),
        +(Math.random() * 2 - 1).toFixed(2),
      ];
    resetOpts();
    draw();
  });

  // ---- loop with time-based stepping ----
  let last = 0, acc = 0;
  function loop(ts: number) {
    if (!last) last = ts;
    const dt = Math.min(0.1, (ts - last) / 1000);
    last = ts;
    if (state.running) {
      acc += dt * state.speed;
      let n = 0;
      while (acc >= 1 && n < 300) { stepAll(); acc -= 1; n++; }
    }
    draw();
    requestAnimationFrame(loop);
  }

  // --- the What-to-observe buttons ---------------------------------------------
  /** Only the named optimizers on, from a fresh start, running. */
  function race(names: string[]) {
    DEFS.forEach((d, i) => setOn(i, names.includes(d.name)));
    resetOpts();
    if (!ctl.running()) el('run').click();
  }
  function eta(v: number) {
    setMode('slice');
    state.curve = 'bowl';
    curves.select('bowl');
    state.eta = v;
    setEtaSlider(v);
    state.start1 = [2.4];
    setX0Slider(2.4);
    race(['GD']);
  }
  tries({
    eta1: () => eta(1),
    eta15: () => eta(1.5),
    eta21: () => eta(2.1),
    ravine: () => {
      setMode('surface');
      setSurf('ravine');
      state.start2 = [2.6, 0.8];
      race(['GD', 'Momentum', 'Adam']);
    },
    ripples: () => {
      setMode('surface');
      setSurf('ripples');
      state.start2 = [1, 0.7];
      race(['AdaGrad', 'RMSProp']);
    },
    cloud: () => {
      setMode('cloud');
      race(DEFS.map((d) => d.name));
    },
  });

  computeRange();
  syncControls();
  resetOpts();
  requestAnimationFrame(loop);
</script>

