---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Checks from '../../../components/sim/Checks.astro';
import Actions from '../../../components/sim/Actions.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
---

<SimLayout
  areaSlug="deep-learning"
  title="Inside an MNIST Classifier"
  description="Draw a digit and watch it go through. Both networks here were trained on the real MNIST set beforehand, so nothing is learning while you use them: every number on screen is one forward pass, and the only difference between the two is how they look at the picture."
  shortcuts={['fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="mn"
          width="1000"
          height="620"
          role="img"
          aria-label="A pad to draw a digit on, the 28 by 28 image the network is given, the activations of each hidden layer, and the ten output probabilities."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'the first hidden stage', color: '#5eead4' },
          { label: 'the second', color: '#7c8cff' },
          { label: 'the answer', color: '#f59e0b' },
        ]}
        hint="Draw with the mouse · brighter means a unit is firing harder"
      />
      <Result label="It says" />
    </div>

    <div class="sim-panel">
      <Seg
        id="model"
        label="Architecture"
        attr="m"
        options={[
          { value: 'mlp', label: 'MLP' },
          { value: 'cnn', label: 'CNN' },
        ]}
      />
      <Actions>
        <button type="button" class="btn" id="sample">A real MNIST digit</button>
        <button type="button" class="btn ghost" id="clear">Clear</button>
      </Actions>
      <Checks items={[{ id: 'weights', label: 'Show what each unit looks for' }]} />
      <Readout
        rows={[
          { id: 'r-says', label: 'it says' },
          { id: 'r-conf', label: 'how sure' },
          { id: 'r-second', label: 'runner-up' },
          { id: 'r-acc', label: 'accuracy on the test set' },
          { id: 'r-params', label: 'weights in this model' },
          { id: 'r-active', label: 'units actually firing' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Draw something and look at the middle picture, the one labelled
      <b>what it is given</b>. Your stroke is cropped, scaled to twenty pixels
      and re-centred by its weight before the network ever sees it, because that
      is exactly what was done to every one of the sixty thousand training
      images. Draw tiny in a corner and it still works.
    </li>
    <li>
      Tick <b>show what each unit looks for</b> on the <b>MLP</b>. Each square
      becomes that unit's own weights drawn as a picture, and several come out
      as smudged strokes and loops. Nobody designed those, they are what
      minimising the loss left behind.
    </li>
    <li>
      Now switch to the <b>CNN</b>. The first row is eight copies of your digit,
      each filtered by one small three-by-three kernel, so one lights up on
      vertical edges and another on horizontal ones. The MLP has no such row: it
      sees 784 unrelated numbers, and had to learn from scratch that two
      neighbouring pixels have anything to do with each other.
    </li>
    <li>
      That is the whole argument for convolution, and the panel prices it. The
      CNN scores better on the test set with roughly <b>a sixth</b> of the
      weights, because the same little kernel is reused at every position
      instead of being learned again for each one.
    </li>
    <li>
      Draw a digit deliberately badly, halfway between a 4 and a 9. The answer
      goes soft and the runner-up climbs, and you can watch which units stop
      firing. Softmax still has to hand out one unit of probability, so it will
      always name something, however unlike a digit your drawing is.
    </li>
    <li>
      Draw a shape that is not a digit at all. It answers anyway, often with
      real confidence. A classifier trained on ten digits has no way to say
      <b>none of these</b>, which is the same limit the
      <a href="/simulations/deep-learning/softmax">softmax</a> page is about.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk, roundRect } from '../../../lib/draw';
  import { el, segmented, check, result, readout } from '../../../lib/panel';
  import {
    ACCURACY, CNN, MLP_ARCH, cnnForward, cnnFilter, mlpForward, mlpUnitImage, normalise, samples,
  } from '../../../lib/mnist-model';

  const S1 = '#5eead4', S2 = '#7c8cff', OUT = '#f59e0b';
  const PAD = 140; // the buffer that is actually painted on

  const state = { model: 'mlp', weights: false, sample: -1 };
  const ink28 = new Float32Array(PAD * PAD);
  let seen = new Float32Array(784);
  const SAMPLES = samples();

  const canvas = el('mn') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink, inv } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  const MLP_PARAMS = 784 * 40 + 40 + 40 * 20 + 20 + 20 * 10 + 10;
  const CNN_PARAMS = CNN.c1 * 9 + CNN.c1 + CNN.c2 * CNN.c1 * 9 + CNN.c2 + 10 * CNN.flat + 10;

  // --- layout ----------------------------------------------------------------
  const P = { x: 46, y: 128, s: 216 };
  const V = { x: 46, y: 418, s: 112 };
  const A = { x: 318, y: 150 };
  const B = { x: 604, y: 150 };
  const O = { x: 782, y: 128, w: 176, row: 34 };

  const grey = (v: number) => {
    const g = Math.round(255 * Math.max(0, Math.min(1, v)));
    return `rgb(${g},${g},${g})`;
  };
  /** Weights are signed, so they get two colours rather than a brightness. */
  const signed = (v: number, mx: number) => {
    const t = Math.max(-1, Math.min(1, v / (mx || 1)));
    return t >= 0 ? `rgba(94,234,212,${0.05 + 0.9 * t})` : `rgba(245,158,11,${0.05 + 0.9 * -t})`;
  };

  function tile(x: number, y: number, s: number, n: number, data: ArrayLike<number>, off: number, paint: (v: number) => string) {
    const c = s / n;
    for (let yy = 0; yy < n; yy++)
      for (let xx = 0; xx < n; xx++) {
        ctx.fillStyle = paint(data[off + yy * n + xx]);
        ctx.fillRect(x + xx * c, y + yy * c, c + 0.5, c + 0.5);
      }
  }

  function pad() {
    label('draw a digit here', P.x, P.y - 34, 0.55, 'left', 13);
    label('anywhere on the pad, any size', P.x, P.y - 16, 0.32, 'left', 11);
    ctx.fillStyle = inv(0.6);
    roundRect(ctx, P.x, P.y, P.s, P.s, 10);
    ctx.fill();
    ctx.save();
    roundRect(ctx, P.x, P.y, P.s, P.s, 10);
    ctx.clip();
    const c = P.s / PAD;
    for (let y = 0; y < PAD; y++)
      for (let x = 0; x < PAD; x++) {
        const v = ink28[y * PAD + x];
        if (v < 0.02) continue;
        ctx.fillStyle = grey(v);
        ctx.fillRect(P.x + x * c, P.y + y * c, c + 0.8, c + 0.8);
      }
    ctx.restore();
    ctx.strokeStyle = ink(0.2);
    ctx.lineWidth = 1;
    roundRect(ctx, P.x + 0.5, P.y + 0.5, P.s - 1, P.s - 1, 10);
    ctx.stroke();

    label('what it is given', V.x, V.y - 30, 0.55, 'left', 13);
    label('cropped, scaled and centred, the way MNIST is', V.x, V.y - 12, 0.32, 'left', 11);
    tile(V.x, V.y, V.s, 28, seen, 0, grey);
    ctx.strokeStyle = ink(0.2);
    ctx.strokeRect(V.x, V.y, V.s, V.s);
    label('28 × 28', V.x + V.s + 12, V.y + 16, 0.32, 'left', 11);
  }

  /** A grid of small squares, one per unit, brightness from how hard it fires. */
  function unitGrid(x: number, y: number, cols: number, cell: number, gap: number, act: Float32Array, colour: string, showWeights: boolean) {
    let mx = 1e-6;
    for (const v of act) mx = Math.max(mx, v);
    let wmax = 1e-6;
    if (showWeights)
      for (let u = 0; u < act.length; u++) {
        const img = mlpUnitImage(u);
        for (const v of img) wmax = Math.max(wmax, Math.abs(v));
      }
    act.forEach((v, u) => {
      const cx = x + (u % cols) * (cell + gap);
      const cy = y + Math.floor(u / cols) * (cell + gap);
      const t = v / mx;
      if (showWeights) {
        const img = mlpUnitImage(u);
        ctx.save();
        ctx.globalAlpha = 0.25 + 0.75 * t;
        tile(cx, cy, cell, 28, img, 0, (w) => signed(w, wmax));
        ctx.restore();
      } else {
        ctx.fillStyle = colour;
        ctx.globalAlpha = 0.08 + 0.92 * t;
        roundRect(ctx, cx, cy, cell, cell, 3);
        ctx.fill();
        ctx.globalAlpha = 1;
      }
      if (v <= 0) {
        ctx.strokeStyle = ink(0.12);
        ctx.lineWidth = 1;
        roundRect(ctx, cx + 0.5, cy + 0.5, cell - 1, cell - 1, 3);
        ctx.stroke();
      }
    });
  }

  /** One small picture per channel, which is what a convolution actually makes. */
  function mapGrid(x: number, y: number, cols: number, size: number, gap: number, data: Float32Array, n: number, side: number) {
    let mx = 1e-6;
    for (const v of data) mx = Math.max(mx, v);
    for (let c = 0; c < n; c++) {
      const cx = x + (c % cols) * (size + gap);
      const cy = y + Math.floor(c / cols) * (size + gap);
      tile(cx, cy, size, side, data, c * side * side, (v) => grey(v / mx));
      ctx.strokeStyle = ink(0.12);
      ctx.lineWidth = 1;
      ctx.strokeRect(cx, cy, size, size);
    }
  }

  function arrow(x0: number, x1: number, y: number, text: string) {
    ctx.strokeStyle = ink(0.24);
    ctx.fillStyle = ink(0.24);
    ctx.lineWidth = 1.6;
    ctx.beginPath();
    ctx.moveTo(x0, y);
    ctx.lineTo(x1 - 9, y);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(x1, y);
    ctx.lineTo(x1 - 9, y - 5);
    ctx.lineTo(x1 - 9, y + 5);
    ctx.closePath();
    ctx.fill();
    label(text, (x0 + x1) / 2, y - 12, 0.4, 'center', 11);
  }

  function outputs(p: Float32Array, top: number) {
    label('the answer', O.x, O.y - 34, 0.55, 'left', 13);
    label('ten numbers adding to 1', O.x, O.y - 16, 0.32, 'left', 11);
    for (let d = 0; d < 10; d++) {
      const y = O.y + d * O.row;
      const on = d === top;
      label(String(d), O.x, y + 16, on ? 1 : 0.5, 'left', on ? 15 : 13, on ? OUT : undefined);
      const bx = O.x + 26, bw = O.w - 62;
      ctx.fillStyle = ink(0.07);
      roundRect(ctx, bx, y + 4, bw, 14, 4);
      ctx.fill();
      if (p[d] > 0.002) {
        ctx.fillStyle = on ? OUT : S2;
        ctx.globalAlpha = on ? 0.95 : 0.5;
        roundRect(ctx, bx, y + 4, Math.max(3, bw * p[d]), 14, 4);
        ctx.fill();
        ctx.globalAlpha = 1;
      }
      label(`${(p[d] * 100).toFixed(0)}%`, O.x + O.w, y + 16, on ? 0.95 : 0.4, 'right', 11, on ? OUT : undefined);
    }
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    pad();

    const mlp = state.model === 'mlp';
    let p: Float32Array;
    let firing = 0, total = 0;

    if (mlp) {
      const r = mlpForward(seen);
      p = r.p;
      label(`${MLP_ARCH[1]} units`, A.x, A.y - 34, 0.55, 'left', 13);
      label('each reads all 784 pixels', A.x, A.y - 16, 0.32, 'left', 11);
      unitGrid(A.x, A.y, 8, 26, 5, r.h1, S1, state.weights);
      label(`${MLP_ARCH[2]} units`, B.x, B.y - 34, 0.55, 'left', 13);
      label('reads the layer below', B.x, B.y - 16, 0.32, 'left', 11);
      unitGrid(B.x, B.y, 4, 26, 5, r.h2, S2, false);
      arrow(A.x + 8 * 31 + 6, B.x - 14, A.y + 60, '');
      arrow(B.x + 4 * 31 + 6, O.x - 14, A.y + 60, '');
      for (const v of r.h1) { total++; if (v > 0) firing++; }
      for (const v of r.h2) { total++; if (v > 0) firing++; }
    } else {
      const r = cnnForward(seen);
      p = r.p;
      label(`${CNN.c1} filtered copies`, A.x, A.y - 34, 0.55, 'left', 13);
      label('one 3 × 3 kernel each', A.x, A.y - 16, 0.32, 'left', 11);
      mapGrid(A.x, A.y, 4, 54, 8, r.a1, CNN.c1, CNN.h1);
      // the eight kernels themselves, under their maps
      const ky = A.y + 2 * 62 + 10;
      label('the kernels that made them', A.x, ky + 14, 0.32, 'left', 11);
      for (let c = 0; c < CNN.c1; c++) {
        const f = cnnFilter(c);
        let mx = 1e-6;
        for (const v of f) mx = Math.max(mx, Math.abs(v));
        tile(A.x + c * 26, ky + 22, 20, 3, f, 0, (v) => signed(v, mx));
      }
      label(`${CNN.c2} deeper maps`, B.x, B.y - 34, 0.55, 'left', 13);
      label('each mixes all eight', B.x, B.y - 16, 0.32, 'left', 11);
      mapGrid(B.x, B.y, 4, 34, 6, r.a2, CNN.c2, CNN.h2);
      arrow(A.x + 4 * 62 - 2, B.x - 14, A.y + 60, '');
      arrow(B.x + 4 * 40 - 2, O.x - 14, A.y + 60, '');
      for (const v of r.a1) { total++; if (v > 0) firing++; }
      for (const v of r.a2) { total++; if (v > 0) firing++; }
    }

    let top = 0, second = 1;
    for (let d = 1; d < 10; d++) if (p[d] > p[top]) top = d;
    second = top === 0 ? 1 : 0;
    for (let d = 0; d < 10; d++) if (d !== top && p[d] > p[second]) second = d;
    outputs(p, top);

    const blank = !seen.some((v) => v > 0.02);
    const params = mlp ? MLP_PARAMS : CNN_PARAMS;
    setEq({
      rule: mlp
        ? [['784 \\to 40 \\to 20 \\to 10', S1], '\\qquad', ['a = \\mathrm{ReLU}(Wa + b)', S2]]
        : [['8@3\\times3 \\to \\text{pool} \\to 16@3\\times3 \\to \\text{pool} \\to 10', S1], ],
      live: blank
        ? ['\\text{nothing drawn yet}']
        : [[`\\hat y = ${top}`, OUT], `\\quad p = ${(p[top] * 100).toFixed(1)}\\%`, `\\quad ${params.toLocaleString('en')}\\text{ weights}`],
    });
    setRows({
      'r-says': blank ? '—' : String(top),
      'r-conf': blank ? '—' : `${(p[top] * 100).toFixed(1)}%`,
      'r-second': blank ? '—' : `${second} at ${(p[second] * 100).toFixed(1)}%`,
      'r-acc': `${mlp ? ACCURACY.mlp : ACCURACY.cnn}%`,
      'r-params': params.toLocaleString('en'),
      'r-active': blank ? '—' : `${firing} of ${total}`,
    });
    setResult({
      value: blank ? 'draw something' : String(top),
      colour: blank ? undefined : OUT,
      status: blank
        ? 'draw a digit on the pad, or load a real one from the test set'
        : `${(p[top] * 100).toFixed(1)}% sure, with ${second} behind it at ${(p[second] * 100).toFixed(1)}% · this model gets ${mlp ? ACCURACY.mlp : ACCURACY.cnn}% of the test set right using ${params.toLocaleString('en')} weights`,
      note: blank
        ? 'Both models were trained on the real MNIST set before this page loaded. Nothing here is learning: every number is one forward pass.'
        : p[top] < 0.6
          ? 'It is not sure, and the runner-up is close. Watch which units go dark as you make the stroke more ambiguous.'
          : mlp
            ? 'Every unit here reads all 784 pixels at once, so this model had to learn from scratch that neighbouring pixels are related.'
            : 'The same 3 by 3 kernel is used at every position, which is why this model needs a fraction of the weights and still does better.',
    });
  }

  // --- drawing ---------------------------------------------------------------
  function paint(cx: number, cy: number) {
    const r = 8;
    for (let y = Math.max(0, Math.floor(cy - r)); y <= Math.min(PAD - 1, Math.ceil(cy + r)); y++)
      for (let x = Math.max(0, Math.floor(cx - r)); x <= Math.min(PAD - 1, Math.ceil(cx + r)); x++) {
        const d = Math.hypot(x + 0.5 - cx, y + 0.5 - cy);
        if (d > r) continue;
        const v = Math.min(1, Math.pow(1 - d / r, 1.4) * 1.5);
        const i = y * PAD + x;
        if (v > ink28[i]) ink28[i] = v;
      }
  }
  let drawing = false, last: { x: number; y: number } | null = null;
  const toPad = (e: PointerEvent) => {
    const r = canvas.getBoundingClientRect();
    const x = ((e.clientX - r.left) / r.width) * W;
    const y = ((e.clientY - r.top) / r.height) * H;
    return { x: ((x - P.x) / P.s) * PAD, y: ((y - P.y) / P.s) * PAD, inside: x >= P.x && x <= P.x + P.s && y >= P.y && y <= P.y + P.s };
  };
  function stroke(to: { x: number; y: number }) {
    if (last) {
      const n = Math.ceil(Math.hypot(to.x - last.x, to.y - last.y)) + 1;
      for (let i = 1; i <= n; i++) paint(last.x + ((to.x - last.x) * i) / n, last.y + ((to.y - last.y) * i) / n);
    } else paint(to.x, to.y);
    last = to;
    seen = normalise(ink28, PAD);
    draw();
  }
  canvas.addEventListener('pointerdown', (e) => {
    const p = toPad(e);
    if (!p.inside) return;
    drawing = true;
    last = null;
    state.sample = -1;
    try { canvas.setPointerCapture(e.pointerId); } catch { /* synthetic pointers need no capture */ }
    stroke(p);
  });
  canvas.addEventListener('pointermove', (e) => {
    const p = toPad(e);
    canvas.style.cursor = p.inside ? 'crosshair' : 'default';
    if (drawing) stroke(p);
  });
  const drop = () => { drawing = false; last = null; };
  canvas.addEventListener('pointerup', drop);
  canvas.addEventListener('pointercancel', drop);

  function loadSample() {
    state.sample = (state.sample + 1) % SAMPLES.length;
    const s = SAMPLES[state.sample];
    seen = s.img.slice();
    // show it on the pad too, so the two panels always agree
    ink28.fill(0);
    const scale = PAD / 28;
    for (let y = 0; y < 28; y++)
      for (let x = 0; x < 28; x++) {
        const v = s.img[y * 28 + x];
        if (v < 0.02) continue;
        for (let dy = 0; dy < scale; dy++)
          for (let dx = 0; dx < scale; dx++) ink28[(y * scale + dy) * PAD + (x * scale + dx)] = v;
      }
    draw();
  }

  segmented('model', (m) => { state.model = m; draw(); });
  check('weights', (on) => { state.weights = on; draw(); });
  el('clear').addEventListener('click', () => {
    ink28.fill(0);
    seen = new Float32Array(784);
    state.sample = -1;
    draw();
  });
  el('sample').addEventListener('click', loadSample);

  loadSample();
</script>

<style>
  #mn {
    touch-action: none;
  }
</style>
