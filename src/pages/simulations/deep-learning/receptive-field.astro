---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="deep-learning"
  title="Receptive Field"
  description="One convolution sees three pixels. Stack them and each layer sees three of the layer below, which saw three each of their own, so the window on the original image grows with depth. How fast it grows is decided by three numbers, and they do not all behave the same way."
  shortcuts={['fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="rf"
          width="1000"
          height="640"
          role="img"
          aria-label="A stack of one-dimensional convolution layers with the cone of input pixels feeding one chosen output cell highlighted, and the receptive field size printed for each layer."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'the output cell you picked', color: '#7c8cff' },
          { label: 'everything it can see', color: '#5eead4' },
          { label: 'pixels it will never see', color: 'rgba(160,165,175,0.35)' },
        ]}
        hint="Click any cell in the top row to trace a different output"
      />
      <Result label="Receptive field" />
    </div>

    <div class="sim-panel">
      <Slider id="layers" label="Layers" min={1} max={7} value={4} />
      <Slider id="k" label="Kernel size" min={2} max={7} value={3} />
      <Slider id="s" label="Stride" min={1} max={3} value={1} />
      <Seg
        id="dil"
        label="Dilation"
        attr="d"
        options={[
          { value: 'none', label: 'None' },
          { value: 'exp', label: 'Doubling' },
          { value: 'two', label: 'Always 2' },
        ]}
      />
      <Seg
        id="pad"
        label="Padding"
        attr="p"
        options={[
          { value: 'valid', label: 'None' },
          { value: 'same', label: 'Same' },
        ]}
      />
      <Readout
        rows={[
          { id: 'r-rf', label: 'receptive field' },
          { id: 'r-jump', label: 'distance between neighbours' },
          { id: 'r-width', label: 'width of the top layer' },
          { id: 'r-cost', label: 'weights per layer' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      With stride 1 and no dilation every layer adds <b>k − 1</b> pixels, so the
      field grows only linearly with depth. <Try id="depth" />
    </li>
    <li>
      A <b>stride</b> multiplies the reach of every later layer, and divides the
      width of every row above it: reach bought with resolution. <Try id="stride" />
    </li>
    <li>
      <b>Doubling</b> dilation with <b>same</b> padding: the field grows
      exponentially, the weights per layer stay at k and the width never shrinks.
      The cone stays solid. <Try id="double" />
    </li>
    <li>
      Use dilation <b>2</b> in every layer and all offsets stay even, so only every
      other pixel is ever read. A shared factor in the dilations leaves holes in
      the field. <Try id="grid" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk, roundRect } from '../../../lib/draw';
  import { el, segmented, slider, result, readout, tries } from '../../../lib/panel';

  const PICK = '#7c8cff', SEEN = '#5eead4';
  const IN_W = 96; // pixels in the original image

  const state = { layers: 4, k: 3, s: 1, dil: 'none', pad: 'valid', cell: -1 };

  const canvas = el('rf') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => build());
  const { ink } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  /**
   * One layer: its width, its kernel, stride, dilation and padding, the jump
   * between its cells and its field, both in image pixels, and where its
   * first cell sits on the image.
   */
  type Layer = { width: number; k: number; s: number; d: number; pad: number; jump: number; rf: number; start: number };
  let layers: Layer[] = [];
  /** Layers asked for that did not fit, and the width the first of them was handed. */
  let missing = { count: 0, width: 0, span: 0 };
  const dilation = (l: number) => (state.dil === 'exp' ? 2 ** l : state.dil === 'two' ? 2 : 1);
  /** For each layer, which of its cells the chosen output depends on. */
  let lit: Set<number>[] = [];

  function build() {
    layers = [];
    missing = { count: 0, width: 0, span: 0 };
    let width = IN_W, jump = 1, rf = 1, start = 0;
    for (let l = 0; l < state.layers; l++) {
      const d = dilation(l), s = state.s;
      const eff = d * (state.k - 1) + 1; // the span the kernel actually covers
      // 'same' pads so that, at stride 1, the width comes out unchanged
      const pad = state.pad === 'same' ? Math.floor((eff - 1) / 2) : 0;
      const out = Math.floor((width + 2 * pad - eff) / s) + 1;
      if (out < 1) {
        missing = { count: state.layers - l, width, span: eff };
        break;
      }
      start += ((eff - 1) / 2 - pad) * jump;
      rf += (eff - 1) * jump;
      jump *= s;
      width = out;
      layers.push({ width, k: state.k, s, d, pad, jump, rf, start });
    }
    if (!layers.length) layers.push({ width: IN_W, k: state.k, s: 1, d: 1, pad: 0, jump: 1, rf: 1, start: 0 });
    const top = layers[layers.length - 1];
    if (state.cell < 0 || state.cell >= top.width) state.cell = Math.floor(top.width / 2);
    trace();
    draw();
  }

  /** Walk the chosen output cell back down, layer by layer, collecting inputs. */
  function trace() {
    lit = new Array(layers.length + 1).fill(null).map(() => new Set<number>());
    lit[layers.length].add(state.cell);
    for (let l = layers.length - 1; l >= 0; l--) {
      const L = layers[l];
      const below = lit[l];
      const width = l === 0 ? IN_W : layers[l - 1].width;
      for (const o of lit[l + 1])
        for (let t = 0; t < L.k; t++) {
          // indices outside the row are padding: zeros, not pixels
          const i = o * L.s + t * L.d - L.pad;
          if (i >= 0 && i < width) below.add(i);
        }
    }
  }

  // --- layout ----------------------------------------------------------------
  const GRID = { x: 106, y: 88, w: 748, bottom: 482 };

  function rowY(l: number) {
    const rows = layers.length + 1;
    const pitch = (GRID.bottom - GRID.y) / Math.max(1, rows - 1);
    return GRID.bottom - l * pitch; // layer 0 (the image) at the bottom
  }
  const cellW = () => GRID.w / IN_W;
  function cellX(l: number, i: number) {
    // every layer is drawn in the coordinates of the original image, so a cone
    // is a cone and a stride visibly spreads its outputs apart
    const L = l === 0 ? null : layers[l - 1];
    const jump = L ? L.jump : 1;
    const start = L ? L.start : 0;
    return GRID.x + ((start + i * jump) / IN_W) * GRID.w;
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    const cw = cellW();

    label('every layer drawn over the pixels it reads', GRID.x, GRID.y - 40, 0.5, 'left', 13);
    label('the top row is the output, the bottom row is the image itself', GRID.x, GRID.y - 24, 0.3, 'left', 11);

    // the cone, drawn behind the cells as soft connections
    for (let l = 0; l < layers.length; l++) {
      const L = layers[l];
      const y0 = rowY(l), y1 = rowY(l + 1);
      ctx.strokeStyle = `${SEEN}33`;
      ctx.lineWidth = 1;
      for (const o of lit[l + 1])
        for (let t = 0; t < L.k; t++) {
          const i = o * L.s + t * L.d - L.pad;
          if (!lit[l].has(i)) continue;
          ctx.beginPath();
          ctx.moveTo(cellX(l + 1, o) + cw / 2, y1 + 7);
          ctx.lineTo(cellX(l, i) + cw / 2, y0 - 7);
          ctx.stroke();
        }
    }

    for (let l = 0; l <= layers.length; l++) {
      const width = l === 0 ? IN_W : layers[l - 1].width;
      const y = rowY(l);
      const top = l === layers.length;
      for (let i = 0; i < width; i++) {
        const x = cellX(l, i);
        const on = lit[l].has(i);
        const chosen = top && i === state.cell;
        ctx.fillStyle = chosen ? PICK : on ? SEEN : ink(0.1);
        ctx.globalAlpha = chosen ? 1 : on ? 0.55 : 1;
        roundRect(ctx, x + 0.6, y - 7, Math.max(1.4, cw - 1.4), 14, 2.5);
        ctx.fill();
        ctx.globalAlpha = 1;
      }
      const name = l === 0 ? 'the image' : `layer ${l}`;
      label(name, GRID.x - 12, y + 4, l === layers.length ? 0.85 : 0.4, 'right', 11.5, top ? PICK : undefined);
      label(l === 0 ? `${IN_W} pixels` : `${width} cells`, GRID.x + GRID.w + 12, y + 4, 0.35, 'left', 11);
      if (top) label(`sees ${layers[l - 1].rf}px`, GRID.x - 12, y + 17, 0.55, 'right', 11, SEEN);
    }

    // the span of the field, marked on the image row itself
    const seen = [...lit[0]].sort((a, b) => a - b);
    const holes = seen.length ? seen[seen.length - 1] - seen[0] + 1 - seen.length : 0;
    if (seen.length) {
      const y = rowY(0) + 26;
      const x0 = cellX(0, seen[0]), x1 = cellX(0, seen[seen.length - 1]) + cw;
      ctx.strokeStyle = SEEN;
      ctx.lineWidth = 1.6;
      ctx.beginPath();
      ctx.moveTo(x0, y);
      ctx.lineTo(x1, y);
      ctx.moveTo(x0, y - 5);
      ctx.lineTo(x0, y + 5);
      ctx.moveTo(x1, y - 5);
      ctx.lineTo(x1, y + 5);
      ctx.stroke();
      const rf = seen[seen.length - 1] - seen[0] + 1;
      label(
        `${rf} pixels wide${holes ? `, but ${holes} of them are never read` : ''}`,
        (x0 + x1) / 2,
        y + 22,
        0.75,
        'center',
        12,
        SEEN
      );
    }

    // the arithmetic, in the space under the stack
    const top = layers[layers.length - 1];
    const y = 596;
    label('one layer adds (k − 1) × jump, and multiplies the jump by the stride', GRID.x, y - 22, 0.4, 'left', 11.5);
    label(`${layers.length} layer${layers.length === 1 ? '' : 's'} reach ${top.rf} pixels with a jump of ${top.jump}`, GRID.x, y, 0.9, 'left', 14, SEEN);
    if (missing.count)
      label(
        `${missing.count} more layer${missing.count === 1 ? '' : 's'} did not fit: a window ${missing.span} wide on a row of ${missing.width}`,
        GRID.x + GRID.w,
        y,
        0.9,
        'right',
        12,
        '#f87171'
      );

    const params = state.k;
    setEq({
      rule: [
        ['r_l = r_{l-1} + (k-1)\\,d_l\\,j_{l-1}', SEEN],
        '\\qquad',
        ['j_l = j_{l-1}\\,s_l', PICK],
      ],
      live: [
        [`r = ${top.rf}\\text{ pixels}`, SEEN],
        [`\\quad j = ${top.jump}`, PICK],
        `\\quad k = ${state.k},\\; s = ${top.s},\\; d = ${state.dil === 'exp' ? `2^{l}` : state.dil === 'two' ? '2' : '1'}`,
        `\\quad ${top.width}\\text{ cells left}`,
      ],
    });
    setRows({
      'r-rf': `${top.rf} pixels`,
      'r-jump': `${top.jump} pixel${top.jump === 1 ? '' : 's'}`,
      'r-width': `${top.width} of ${IN_W}`,
      'r-cost': `${params} per channel pair`,
    });
    const frac = top.rf / IN_W;
    setResult({
      value: `${top.rf} pixels`,
      colour: SEEN,
      status: `${frac > 1 ? 'wider than' : `${(frac * 100).toFixed(0)}% of`} a ${IN_W} pixel image · ${top.width} cells left in the top layer · each layer still holds only ${params} weights per channel pair`,
      note: missing.count
        ? `Without padding every layer is narrower than the one below, and after ${layers.length} the row is too short for the next window, so the stack stops there. Same padding keeps the width.`
        : holes
          ? `The field spans more pixels than it reads: ${holes} inside it are never touched. The taps of one layer land further apart than the field of the layer below is wide.`
          : state.dil === 'exp'
          ? `Doubling the dilation doubles the reach at every layer without adding a weight, and each layer exactly fills the gaps of the next, so the field stays solid.${top.s > 1 ? ' The stride still divides the width of every row.' : state.pad === 'same' ? ' Same padding keeps every row full width.' : ' Without padding the rows still shrink, by the window span each time.'}${top.rf > IN_W ? ' The field is now wider than the whole image.' : ''}`
          : top.s > 1
            ? 'Stride multiplies the reach and divides the resolution. Every layer after it inherits the wider spacing, which is why one early stride changes everything above it.'
            : 'With stride one the field grows by the same amount per layer, so reaching across an image this way costs depth in direct proportion to the distance.',
    });
  }

  // --- interaction -----------------------------------------------------------
  canvas.addEventListener('pointerdown', (e) => {
    const r = canvas.getBoundingClientRect();
    const x = ((e.clientX - r.left) / r.width) * W;
    const y = ((e.clientY - r.top) / r.height) * H;
    const top = layers.length;
    if (Math.abs(y - rowY(top)) > 16) return;
    const L = layers[top - 1];
    const px = ((x - GRID.x) / GRID.w) * IN_W;
    const i = Math.round((px - L.start) / L.jump);
    if (i < 0 || i >= L.width) return;
    state.cell = i;
    trace();
    draw();
  });
  canvas.addEventListener('pointermove', (e) => {
    const r = canvas.getBoundingClientRect();
    const y = ((e.clientY - r.top) / r.height) * H;
    canvas.style.cursor = Math.abs(y - rowY(layers.length)) < 16 ? 'pointer' : 'default';
  });

  const setLayers = slider('layers', (v) => { state.layers = v; state.cell = -1; build(); });
  const setK = slider('k', (v) => { state.k = v; state.cell = -1; build(); });
  const setS = slider('s', (v) => { state.s = v; state.cell = -1; build(); });
  const dils = segmented('dil', (d) => { state.dil = d; state.cell = -1; build(); });
  const pads = segmented('pad', (p) => { state.pad = p; state.cell = -1; build(); });

  function show(layers: number, k: number, s: number, dil: string, pad: string) {
    Object.assign(state, { layers, k, s, dil, pad, cell: -1 });
    setLayers(layers); setK(k); setS(s);
    dils.select(dil); pads.select(pad);
    build();
  }
  tries({
    depth: () => show(6, 3, 1, 'none', 'valid'),
    stride: () => show(4, 3, 2, 'none', 'valid'),
    double: () => show(5, 3, 1, 'exp', 'same'),
    grid: () => show(4, 3, 1, 'two', 'same'),
  });

  build();
</script>
