---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="deep-learning"
  title="Backpropagation"
  description="One tiny network, one example, every number on screen. Push the input forward, send the error back down the same wires, then see why the activation's slope decides whether a gradient survives many layers."
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas id="bp" class="bp-canvas" width="1000" height="612" role="img" aria-label="A two-input, two-hidden, one-output network with every weight, activation and partial derivative printed beside it, and a strip of the ten steps of one training pass. A second view plots the activation, its slope, and the gradient left after many layers."></canvas>
      </div>
      <div id="netcap">
        <Caption
          legend={[{ label: 'values going forward', color: '#5eead4' }, { label: 'gradients coming back', color: '#fbbf24' }, { label: 'the update', color: '#7c8cff' }, { label: 'a negative weight', color: '#f87171' }]}
          hint="Wire thickness is the size of the weight · click a cell of the strip to jump to that step"
        />
      </div>
      <div id="actcap" hidden>
        <Caption
          legend={[{ label: 'activation φ(z)', color: '#5eead4' }, { label: 'slope φ′(z)', color: '#fbbf24' }, { label: 'saturated, |φ′| &lt; 0.1', color: 'rgba(248,113,113,0.6)' }]}
          hint="Click the top plot to move z"
          hintId="act-hint"
        />
      </div>
      <Result label="Step" />
    </div>

    <div class="sim-panel">
      <Seg id="view" label="View" attr="v" options={[{ value: 'net', label: 'Network' }, { value: 'act', label: 'Activation φ and depth' }]} />
      <Seg
        id="act"
        label="Activation φ"
        attr="a"
        options={[
          { value: 'tanh', label: 'tanh' },
          { value: 'sig', label: 'σ' },
          { value: 'relu', label: 'ReLU' },
          { value: 'leaky', label: 'Leaky' },
          { value: 'gelu', label: 'GELU' },
          { value: 'softplus', label: 'Softplus' },
        ]}
      />
      <div id="actwrap" hidden>
        <Slider id="z" label="Pre-activation z" min={-5} max={5} step={0.05} value={0} display="0.00" />
        <Slider id="depth" label="Layers n" min={1} max={30} value={10} />
      </div>
      <div id="netwrap">
        <Transport step>
          <button type="button" class="btn ghost" id="fast">Run 100 passes</button>
        </Transport>
        <Slider id="x1" label="Input x<sub>1</sub> = a<sup>[0]</sup><sub>1</sub>" min={-1} max={1} step={0.05} value={0.9} display="0.90" />
        <Slider id="x2" label="Input x<sub>2</sub> = a<sup>[0]</sup><sub>2</sub>" min={-1} max={1} step={0.05} value={0.3} display="0.30" />
        <Seg id="target" label="Target y" attr="y" options={[{ value: '1', label: '1' }, { value: '0', label: '0' }]} />
        <Slider id="lr" label="Learning rate η" min={0.05} max={5} step={0.05} value={0.5} display="0.50" />
        <Readout rows={[{ id: 'pass', label: 'passes done' }, { id: 'yhat', label: 'prediction a<sup>[2]</sup>' }, { id: 'loss', label: 'loss' }]} />
        <div class="control">
          <span class="section-label">Gradients <b id="gstate">none yet</b></span>
          <div class="grads">
            <div class="g" id="cw00"><span>∂L/∂W<sup>[1]</sup><sub>11</sub></span><b>—</b></div>
            <div class="g" id="cw01"><span>∂L/∂W<sup>[1]</sup><sub>12</sub></span><b>—</b></div>
            <div class="g" id="cb0"><span>∂L/∂b<sup>[1]</sup><sub>1</sub></span><b>—</b></div>
            <div class="g" id="cw10"><span>∂L/∂W<sup>[1]</sup><sub>21</sub></span><b>—</b></div>
            <div class="g" id="cw11"><span>∂L/∂W<sup>[1]</sup><sub>22</sub></span><b>—</b></div>
            <div class="g" id="cb1"><span>∂L/∂b<sup>[1]</sup><sub>2</sub></span><b>—</b></div>
            <div class="g" id="cv0"><span>∂L/∂W<sup>[2]</sup><sub>1</sub></span><b>—</b></div>
            <div class="g" id="cv1"><span>∂L/∂W<sup>[2]</sup><sub>2</sub></span><b>—</b></div>
            <div class="g" id="cc"><span>∂L/∂b<sup>[2]</sup></span><b>—</b></div>
          </div>
        </div>
        <div class="control">
          <span class="section-label">Loss after each pass</span>
          <canvas id="losscurve" class="mini-canvas" width="300" height="120" role="img" aria-label="Loss after each training pass"></canvas>
        </div>
      </div>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Step through one pass. Forward (teal), every unit does <b>multiply, add,
      squash</b>. Backward (amber), every unit <b>multiplies by its local slope
      φ′ and hands the result back</b> down the same wires. <Try id="pass" label="Play a pass" />
    </li>
    <li>
      Steps 7 and 9 are one formula: <b>a weight's gradient is the delta at its
      head times the activation at its tail</b>. A bias has no tail, so its
      gradient is the delta itself. <Try id="grads" />
    </li>
    <li>
      With <b>ReLU</b>, push unit 1's z<sup>[1]</sup> below zero. Its slope is
      exactly 0, so its δ and both weights into it get no gradient: a
      <b>dead unit</b>. <Try id="dead" />
    </li>
    <li>
      In the <b>Activation</b> view the bottom plot multiplies φ′ over n layers.
      σ′ never exceeds 0.25, so ten σ layers cut the gradient at least a
      millionfold: it <b>vanishes</b>. tanh′ peaks at 1 and tanh is zero-centred, but
      it saturates in its tails too; ReLU passes exactly 1 for z &gt; 0. <Try id="vanish" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import type { Part } from '../../../lib/equation';
  import { arrow, roundRect } from '../../../lib/theorem';
  import { stageInk } from '../../../lib/draw';
  import { el, segmented, slider, transport, result, readout, tries } from '../../../lib/panel';

  // --- the network -----------------------------------------------------------
  // Two inputs, two hidden units, one output, one training example. Nine
  // parameters in total, which is few enough to print every gradient.
  const sig = (z: number) => 1 / (1 + Math.exp(-z));
  const erf = (x: number) => {
    // Abramowitz-Stegun approximation
    const t = 1 / (1 + 0.3275911 * Math.abs(x));
    const y = 1 - (((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t) * Math.exp(-x * x);
    return x >= 0 ? y : -y;
  };
  const Phi = (z: number) => 0.5 * (1 + erf(z / Math.SQRT2));
  const pdf = (z: number) => Math.exp(-z * z / 2) / Math.sqrt(2 * Math.PI);

  type Act = {
    name: string; f: (z: number) => number; d: (z: number) => number;
    tex: string; dtex: string; ftex: string; note: string;
  };
  const ACTS: Record<string, Act> = {
    tanh: {
      name: 'tanh', f: Math.tanh, d: (z) => 1 - Math.tanh(z) ** 2, tex: '\\tanh', dtex: "\\tanh'",
      ftex: '\\tanh z = \\tfrac{e^{z}-e^{-z}}{e^{z}+e^{-z}}',
      note: 'Zero-centred, with slope 1 at z = 0. Its tails still saturate, so a tanh layer far from 0 passes almost nothing back.',
    },
    sig: {
      name: 'σ', f: sig, d: (z) => sig(z) * (1 - sig(z)), tex: '\\sigma', dtex: "\\sigma'",
      ftex: '\\sigma(z) = \\tfrac{1}{1+e^{-z}}',
      note: 'Its slope peaks at 0.25, at z = 0. Every σ layer at least quarters the gradient, saturated or not, and the tails kill it.',
    },
    relu: {
      name: 'ReLU', f: (z) => Math.max(0, z), d: (z) => (z > 0 ? 1 : 0), tex: '\\mathrm{ReLU}', dtex: "\\mathrm{ReLU}'",
      ftex: '\\mathrm{ReLU}(z) = \\max(0, z)',
      note: 'Slope exactly 1 for z > 0, so depth costs nothing there. Exactly 0 for z < 0: a unit stuck there is dead.',
    },
    leaky: {
      name: 'leaky ReLU', f: (z) => (z > 0 ? z : 0.1 * z), d: (z) => (z > 0 ? 1 : 0.1), tex: '\\mathrm{lReLU}', dtex: "\\mathrm{lReLU}'",
      ftex: '\\mathrm{lReLU}(z) = \\max(0.1\\,z,\\; z)',
      note: 'A ReLU that leaks a slope of 0.1 below zero, so the gradient shrinks there instead of dying.',
    },
    gelu: {
      name: 'GELU', f: (z) => z * Phi(z), d: (z) => Phi(z) + z * pdf(z), tex: '\\mathrm{GELU}', dtex: "\\mathrm{GELU}'",
      ftex: '\\mathrm{GELU}(z) = z\\,\\Phi(z)',
      note: 'A smooth ReLU, the default in most transformers. Its slope overshoots 1 a little past z = 0 (up to 1.13), so a deep stack there can grow the gradient.',
    },
    softplus: {
      name: 'softplus', f: (z) => (z > 30 ? z : Math.log(1 + Math.exp(z))), d: sig, tex: '\\mathrm{softplus}', dtex: "\\mathrm{softplus}'",
      ftex: '\\mathrm{softplus}(z) = \\log(1+e^{z})',
      note: 'A smooth ReLU whose slope is exactly σ(z): near 1 for large z, near 0 far below it.',
    },
  };

  type Params = { w: number[][]; b: number[]; v: number[]; c: number };
  // Hand-picked so the first pass starts visibly wrong and the numbers are
  // short. Reset always comes back here, so a shared link shows the same run.
  const START: Params = {
    w: [[0.6, -0.4], [-0.3, 0.8]],
    b: [0.1, -0.2],
    v: [0.9, -0.7],
    c: 0.2,
  };
  const clone = (p: Params): Params => ({
    w: [p.w[0].slice(), p.w[1].slice()],
    b: p.b.slice(),
    v: p.v.slice(),
    c: p.c,
  });

  type Calc = {
    z: number[]; a: number[]; zo: number; yh: number; L: number;
    e: number; dO: number; dv: number[]; dc: number;
    dh: number[]; dw: number[][]; db: number[];
  };

  const S = {
    k: -1, // index of the last step performed, -1 = nothing yet, 9 = updated
    pass: 0,
    playing: false,
    lr: 0.5,
    x: [0.9, 0.3],
    y: 1,
    act: 'tanh',
    view: 'net' as 'net' | 'act',
    z: 0, // where the activation view reads φ and φ′
    n: 10, // layers in the depth plot
  };

  let P = clone(START);
  let hist: number[] = [];
  // The gradients shown at the update step belong to the pass that produced it,
  // so they are kept aside when the parameters move on.
  let snap: Calc | null = null;

  function compute(p: Params): Calc {
    const A = ACTS[S.act];
    const z = [0, 0];
    const a = [0, 0];
    for (let j = 0; j < 2; j++) {
      z[j] = p.w[j][0] * S.x[0] + p.w[j][1] * S.x[1] + p.b[j];
      a[j] = A.f(z[j]);
    }
    const zo = p.v[0] * a[0] + p.v[1] * a[1] + p.c;
    const yh = sig(zo);
    const L = 0.5 * (yh - S.y) ** 2;

    const e = yh - S.y; // dL/dyhat
    const dO = e * yh * (1 - yh); // delta at the output: dL/dz_o
    const dv = [dO * a[0], dO * a[1]];
    const dc = dO;
    const dh = [dO * p.v[0] * A.d(z[0]), dO * p.v[1] * A.d(z[1])];
    const dw = [
      [dh[0] * S.x[0], dh[0] * S.x[1]],
      [dh[1] * S.x[0], dh[1] * S.x[1]],
    ];
    const db = [dh[0], dh[1]];
    return { z, a, zo, yh, L, e, dO, dv, dc, dh, dw, db };
  }

  let C = compute(P);

  function applyUpdate() {
    snap = C;
    for (let j = 0; j < 2; j++) {
      for (let i = 0; i < 2; i++) P.w[j][i] -= S.lr * C.dw[j][i];
      P.b[j] -= S.lr * C.db[j];
      P.v[j] -= S.lr * C.dv[j];
    }
    P.c -= S.lr * C.dc;
    C = compute(P);
    S.pass++;
    hist.push(C.L);
    S.k = 9;
  }

  /** Gradients on screen: after an update they are last pass's, not this one's. */
  const G = () => (S.k === 9 && snap ? snap : C);
  /** Has step i been performed? Everything is on screen at the update step. */
  const seen = (i: number) => S.k >= i;

  // --- the ten steps ---------------------------------------------------------
  const TITLES = [
    'forward · layer 1, unit 1',
    'forward · layer 1, unit 2',
    'forward · layer 2, the output',
    'forward · the loss',
    'backward · how wrong the output is',
    'backward · δ at layer 2',
    'backward · gradients of W and b at layer 2',
    'backward · δ at layer 1',
    'backward · gradients of W and b at layer 1',
    'update · every parameter steps against its gradient',
  ];
  const PHASE = (k: number) => (k < 0 ? 'idle' : k < 4 ? 'fwd' : k < 9 ? 'bwd' : 'upd');

  // --- canvas ----------------------------------------------------------------
  const setEq = equation();
  const setResult = result();
  const setRows = readout();
  const canvas = el('bp') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { css, ink } = stageInk(canvas);
  const bg = () => css('--stage-bg', '#0d0e12');
  const light = () => +css('--stage-light', '0') === 1;
  const accent = () => css('--accent', '#7c8cff');
  const TEAL = () => css('--accent-2', '#5eead4');
  const AMB = () => (light() ? '#b45309' : '#fbbf24');
  const RED = () => css('--danger', '#f87171');
  const { label, textWidth } = makeText(ctx, ink);

  const IN_X = 122, H_X = 434, O_X = 724, LOSS_X = 898;
  const IN_Y = [196, 388];
  const H_Y = [172, 412];
  const O_Y = 288;
  const R_IN = 26, R_H = 34, R_O = 34;
  const BOX = { x: 838, y: 238, w: 120, h: 82 };
  const BAR = { x: 122, y: 540, w: 836, h: 20, n: 10 };

  const n2 = (v: number) => (Math.abs(v) < 5e-3 ? '0.00' : v.toFixed(2));
  const n3 = (v: number) => (Math.abs(v) < 5e-4 ? '0.000' : v.toFixed(3));
  const pp = (v: number, d = 2) => (v < 0 ? `(${v.toFixed(d)})` : v.toFixed(d));

  // Which pieces glow for the step just performed.
  function hot() {
    const k = S.k;
    const e1: [number, number][] = []; // input -> hidden, as [i, j]
    const e2: number[] = []; // hidden -> output, by j
    const nin: number[] = [];
    const nh: number[] = [];
    let nout = false, nloss = false;
    if (k === 0 || k === 1) {
      nin.push(0, 1); nh.push(k); e1.push([0, k], [1, k]);
    } else if (k === 2) {
      nh.push(0, 1); e2.push(0, 1); nout = true;
    } else if (k === 3) {
      nout = true; nloss = true;
    } else if (k === 4) {
      nloss = true; nout = true;
    } else if (k === 5) {
      nout = true;
    } else if (k === 6) {
      nh.push(0, 1); e2.push(0, 1); nout = true;
    } else if (k === 7) {
      nh.push(0, 1); e2.push(0, 1); nout = true;
    } else if (k === 8) {
      nin.push(0, 1); nh.push(0, 1); e1.push([0, 0], [1, 0], [0, 1], [1, 1]);
    } else if (k === 9) {
      nin.push(0, 1); nh.push(0, 1); nout = true;
      e1.push([0, 0], [1, 0], [0, 1], [1, 1]); e2.push(0, 1);
    }
    return { e1, e2, nin, nh, nout, nloss };
  }

  let t0 = performance.now();
  const now = () => (performance.now() - t0) / 1000;

  function edge(
    x0: number, y0: number, x1: number, y1: number,
    weight: number, live: boolean, back: boolean, flow: string
  ) {
    const mag = Math.min(1, Math.abs(weight) / 1.4);
    ctx.lineCap = 'round';
    if (live) {
      // the resting wire stays visible under the moving dashes
      ctx.strokeStyle = ink(0.1);
      ctx.lineWidth = 1 + 3.2 * mag;
      ctx.beginPath(); ctx.moveTo(x0, y0); ctx.lineTo(x1, y1); ctx.stroke();

      ctx.strokeStyle = flow;
      ctx.lineWidth = 1.4 + 3 * mag;
      ctx.setLineDash([9, 11]);
      ctx.lineDashOffset = (back ? 1 : -1) * now() * 46;
      ctx.beginPath(); ctx.moveTo(x0, y0); ctx.lineTo(x1, y1); ctx.stroke();
      ctx.setLineDash([]);
    } else {
      ctx.strokeStyle = weight >= 0 ? ink(0.26) : RED();
      ctx.globalAlpha = weight >= 0 ? 1 : 0.42;
      ctx.lineWidth = 0.8 + 3 * mag;
      ctx.beginPath(); ctx.moveTo(x0, y0); ctx.lineTo(x1, y1); ctx.stroke();
      ctx.globalAlpha = 1;
    }
  }

  type ChipLine = { t: string; c?: string; a?: number; s?: number };

  /** A small boxed label, used where wires cross behind the text. */
  function chip(cx: number, cy: number, lines: ChipLine[], glow = false) {
    let w = 0;
    for (const l of lines) w = Math.max(w, textWidth(l.t, l.s ?? 10.5));
    const bw = w + 18;
    const bh = lines.length * 17 + 9;
    ctx.fillStyle = bg();
    ctx.globalAlpha = 0.94;
    roundRect(ctx, cx - bw / 2, cy - bh / 2, bw, bh, 6);
    ctx.fill();
    ctx.globalAlpha = 1;
    ctx.strokeStyle = glow ? AMB() : ink(0.14);
    ctx.lineWidth = glow ? 1.4 : 1;
    ctx.stroke();
    lines.forEach((l, i) =>
      label(l.t, cx, cy - bh / 2 + 17 + i * 17 - 4, l.a ?? 0.72, 'center', l.s ?? 10.5, l.c)
    );
  }

  function node(
    x: number, y: number, r: number,
    title: string, value: string, live: boolean, flow: string, fill = 0
  ) {
    ctx.beginPath();
    ctx.arc(x, y, r, 0, Math.PI * 2);
    ctx.fillStyle = bg();
    ctx.fill();
    // a unit's fill tracks what it is holding, so a saturated unit looks it
    ctx.fillStyle = ink(0.05 + 0.14 * Math.min(1, Math.abs(fill)));
    ctx.fill();
    if (live) {
      const pulse = 0.55 + 0.35 * Math.sin(now() * 4.2);
      ctx.strokeStyle = flow;
      ctx.globalAlpha = pulse;
      ctx.lineWidth = 3.4;
      ctx.stroke();
      ctx.globalAlpha = 1;
      ctx.lineWidth = 1.6;
      ctx.stroke();
    } else {
      ctx.strokeStyle = ink(0.22);
      ctx.lineWidth = 1.4;
      ctx.stroke();
    }
    label(title, x, y - r - 11, 0.5, 'center', 12);
    label(value, x, y + 5, value === '?' ? 0.25 : 0.92, 'center', value === '?' ? 15 : 14.5);
  }

  // --- the activation view: φ and φ′ on top, φ′ multiplied over n layers below ---
  const AP = { x: 60, y: 36, w: W - 100, h: 300 };
  const DP = { x: 60, y: 404, w: W - 100, h: 160 };
  const AXR = [-5, 5] as const, AYR = [-1.6, 3] as const;
  const ax = (z: number) => AP.x + ((z - AXR[0]) / (AXR[1] - AXR[0])) * AP.w;
  const ay = (y: number) => AP.y + AP.h - ((y - AYR[0]) / (AYR[1] - AYR[0])) * AP.h;
  // the depth plot is logarithmic: 10 at the top, 1e-12 at the floor
  const LOG_HI = 1, LOG_LO = -12;
  const PRESETS = ['sig', 'tanh', 'relu', 'leaky', 'gelu', 'softplus'];
  const PCOL: Record<string, string> = {
    sig: '#f87171', tanh: '#5eead4', relu: '#7c8cff', leaky: '#a3e635', gelu: '#c084fc', softplus: '#f472b6',
  };
  /** |φ′(z)|ⁿ: the factor left after n layers that all sit at the same z. */
  const survive = (key: string, n: number) => Math.abs(ACTS[key].d(S.z)) ** n;

  function drawAct() {
    const A = ACTS[S.act];
    ctx.clearRect(0, 0, W, H);

    // where the slope has all but vanished
    for (let px = AP.x; px <= AP.x + AP.w; px += 3) {
      const z = AXR[0] + ((px - AP.x) / AP.w) * (AXR[1] - AXR[0]);
      if (Math.abs(A.d(z)) < 0.1) {
        ctx.fillStyle = 'rgba(248,113,113,0.08)';
        ctx.fillRect(px, AP.y, 3, AP.h);
      }
    }
    ctx.strokeStyle = ink(0.07);
    ctx.lineWidth = 1;
    for (let zv = -5; zv <= 5; zv++) {
      ctx.beginPath(); ctx.moveTo(ax(zv), AP.y); ctx.lineTo(ax(zv), AP.y + AP.h); ctx.stroke();
      label(String(zv), ax(zv), AP.y + AP.h + 17, 0.3, 'center', 11.5);
    }
    for (const yv of [-1, 1, 2, 3]) label(String(yv), AP.x - 10, ay(yv) + 4, 0.3, 'right', 11.5);
    ctx.strokeStyle = ink(0.25);
    ctx.beginPath(); ctx.moveTo(AP.x, ay(0)); ctx.lineTo(AP.x + AP.w, ay(0)); ctx.stroke();
    label('z', AP.x + AP.w + 14, ay(0) + 4, 0.4, 'center', 11);

    const plot = (fn: (z: number) => number, color: string, width: number) => {
      ctx.save();
      ctx.beginPath(); ctx.rect(AP.x, AP.y, AP.w, AP.h); ctx.clip();
      ctx.strokeStyle = color;
      ctx.lineWidth = width;
      ctx.beginPath();
      for (let i = 0; i <= 500; i++) {
        const z = AXR[0] + ((AXR[1] - AXR[0]) * i) / 500;
        i ? ctx.lineTo(ax(z), ay(fn(z))) : ctx.moveTo(ax(z), ay(fn(z)));
      }
      ctx.stroke();
      ctx.restore();
    };
    plot(A.d, AMB(), 2);
    plot(A.f, TEAL(), 2.8);

    // where the network's two hidden units sit right now
    for (let j = 0; j < 2; j++) {
      const z = Math.max(AXR[0], Math.min(AXR[1], C.z[j]));
      ctx.strokeStyle = ink(0.35);
      ctx.beginPath(); ctx.moveTo(ax(z), AP.y + AP.h - 10); ctx.lineTo(ax(z), AP.y + AP.h); ctx.stroke();
      label(`z_${j + 1}`, ax(z), AP.y + AP.h - 14, 0.5, 'center', 10.5);
    }

    const zv = S.z;
    ctx.strokeStyle = ink(0.4);
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(ax(zv), AP.y); ctx.lineTo(ax(zv), AP.y + AP.h); ctx.stroke();
    for (const [v, c, r] of [[A.f(zv), TEAL(), 5.5], [A.d(zv), AMB(), 5]] as [number, string, number][]) {
      ctx.fillStyle = c;
      ctx.beginPath(); ctx.arc(ax(zv), ay(v), r, 0, Math.PI * 2); ctx.fill();
    }
    label(`z = ${zv.toFixed(2)}`, ax(zv) + 8, AP.y + 14, 0.6, 'left', 11.5);

    // --- depth: one line per preset, the chosen one bold -----------------------
    label(`|φ′(z)|^k after k layers, every layer at z = ${zv.toFixed(2)} (log scale)`, DP.x, DP.y - 12, 0.5, 'left', 11.5);
    const dy = (v: number) => {
      const l = v <= 0 ? LOG_LO - 1 : Math.log10(v);
      return DP.y + ((LOG_HI - Math.max(LOG_LO, Math.min(LOG_HI, l))) / (LOG_HI - LOG_LO)) * DP.h;
    };
    const dx = (k: number) => DP.x + (k / S.n) * DP.w;
    ctx.strokeStyle = ink(0.08);
    for (const e of [1, 0, -3, -6, -9, -12]) {
      ctx.beginPath(); ctx.moveTo(DP.x, dy(10 ** e)); ctx.lineTo(DP.x + DP.w, dy(10 ** e)); ctx.stroke();
      label(e === 0 ? '1' : e === 1 ? '10' : `1e${e}`, DP.x - 8, dy(10 ** e) + 4, 0.3, 'right', 10.5);
    }
    label('0 layers', DP.x, DP.y + DP.h + 16, 0.3, 'left', 11);
    label(`${S.n}`, DP.x + DP.w, DP.y + DP.h + 16, 0.3, 'right', 11);
    const order = PRESETS.filter((p) => p !== S.act).concat(S.act);
    for (const key of order) {
      const on = key === S.act;
      ctx.strokeStyle = PCOL[key];
      ctx.globalAlpha = on ? 1 : 0.35;
      ctx.lineWidth = on ? 2.6 : 1.4;
      ctx.beginPath();
      for (let k = 0; k <= S.n; k++) {
        const y = dy(survive(key, k));
        k ? ctx.lineTo(dx(k), y) : ctx.moveTo(dx(k), y);
      }
      ctx.stroke();
      ctx.globalAlpha = 1;
    }
    // names at the right end, nudged apart so they never overprint
    const ends = PRESETS.map((key) => ({ key, y: dy(survive(key, S.n)) })).sort((a, b) => a.y - b.y);
    for (let i = 1; i < ends.length; i++) ends[i].y = Math.max(ends[i].y, ends[i - 1].y + 12);
    for (const e of ends)
      label(ACTS[e.key].name, DP.x + DP.w + 6, e.y + 4, e.key === S.act ? 1 : 0.55, 'left', 10.5, PCOL[e.key]);
    words();
  }

  function draw() {
    if (S.view === 'act') return drawAct();
    const k = S.k;
    const g = G();
    const back = PHASE(k) === 'bwd';
    const h = hot();
    const amber = AMB();
    const flow = k === 9 ? accent() : back ? amber : TEAL();
    const dim = k === 9 ? 0.5 : 1; // last pass's gradients, kept but faded

    ctx.clearRect(0, 0, W, H);

    // heading: which step just happened
    label(
      k < 0 ? 'press Step to send the input forward' : `step ${k + 1} of 10 · ${TITLES[k]}`,
      W / 2, 30,
      k < 0 ? 0.35 : 0.72, 'center', 12.5,
      k < 0 ? undefined : flow
    );

    // column captions
    label('a^[0] = x', IN_X, 62, 0.5, 'center', 12);
    label('the example', IN_X, 80, 0.3, 'center', 11);
    label('layer 1', H_X, 62, 0.5, 'center', 12);
    label(`2 units, φ = ${ACTS[S.act].name}`, H_X, 80, 0.3, 'center', 11);
    label('layer 2 = L', O_X, 62, 0.5, 'center', 12);
    label('1 unit, σ', O_X, 80, 0.3, 'center', 11);
    label('loss', LOSS_X, 62, 0.5, 'center', 12);
    label('one number', LOSS_X, 80, 0.3, 'center', 11);

    // --- wires, input to hidden ---------------------------------------------
    // labels sit at different points along the two crossing wires so the boxes
    // never land on top of each other
    const T1 = [[0.34, 0.22], [0.45, 0.34]];
    for (let j = 0; j < 2; j++) {
      for (let i = 0; i < 2; i++) {
        const live = h.e1.some(([a, b]) => a === i && b === j);
        edge(IN_X + R_IN, IN_Y[i], H_X - R_H, H_Y[j], P.w[j][i], live, back, flow);
      }
    }
    for (let j = 0; j < 2; j++) {
      for (let i = 0; i < 2; i++) {
        const t = T1[i][j];
        const cx = IN_X + R_IN + t * (H_X - R_H - IN_X - R_IN);
        const cy = IN_Y[i] + t * (H_Y[j] - IN_Y[i]);
        const lines: ChipLine[] = [{ t: `W^[1]_${j + 1}${i + 1} ${n2(P.w[j][i])}`, a: 0.8 }];
        if (seen(8)) lines.push({ t: `∂ ${n3(g.dw[j][i])}`, c: amber, a: dim, s: 10 });
        chip(cx, cy, lines, seen(8) && h.e1.some(([a, b]) => a === i && b === j));
      }
    }

    // --- wires, hidden to output --------------------------------------------
    for (let j = 0; j < 2; j++)
      edge(H_X + R_H, H_Y[j], O_X - R_O, O_Y, P.v[j], h.e2.includes(j), back, flow);
    for (let j = 0; j < 2; j++) {
      const t = 0.4;
      const cx = H_X + R_H + t * (O_X - R_O - H_X - R_H);
      const cy = H_Y[j] + t * (O_Y - H_Y[j]);
      const lines: ChipLine[] = [{ t: `W^[2]_${j + 1} ${n2(P.v[j])}`, a: 0.8 }];
      if (seen(6)) lines.push({ t: `∂ ${n3(g.dv[j])}`, c: amber, a: dim, s: 10 });
      chip(cx, cy, lines, seen(6) && h.e2.includes(j));
    }

    // --- units ---------------------------------------------------------------
    for (let i = 0; i < 2; i++)
      node(IN_X, IN_Y[i], R_IN, `x_${i + 1}`, n2(S.x[i]), h.nin.includes(i), flow, S.x[i]);

    for (let j = 0; j < 2; j++) {
      const on = seen(j);
      node(H_X, H_Y[j], R_H, `a^[1]_${j + 1}`, on ? n2(C.a[j]) : '?', h.nh.includes(j), flow, on ? C.a[j] : 0);
      const y = H_Y[j] + R_H;
      label(on ? `z^[1]_${j + 1} ${n2(C.z[j])}` : `z^[1]_${j + 1} ?`, H_X, y + 20, 0.45, 'center', 11.5);
      label(
        seen(8) ? `b^[1]_${j + 1} ${n2(P.b[j])}   ∂ ${n3(g.db[j])}` : `b^[1]_${j + 1} ${n2(P.b[j])}`,
        H_X, y + 41, 0.45, 'center', 11.5
      );
      if (seen(7))
        label(`δ^[1]_${j + 1} = ${n3(g.dh[j])}`, H_X, y + 62, dim, 'center', 11.5, amber);
    }

    node(O_X, O_Y, R_O, 'a^[2]', seen(2) ? n2(C.yh) : '?', h.nout, flow, seen(2) ? C.yh : 0);
    label(seen(2) ? `z^[2] ${n2(C.zo)}` : 'z^[2] ?', O_X, O_Y + R_O + 20, 0.45, 'center', 11.5);
    label(
      seen(6) ? `b^[2] ${n2(P.c)}   ∂ ${n3(g.dc)}` : `b^[2] ${n2(P.c)}`,
      O_X, O_Y + R_O + 41, 0.45, 'center', 11.5
    );
    if (seen(5))
      label(`δ^[2] = ${n3(g.dO)}`, O_X, O_Y + R_O + 62, dim, 'center', 11.5, amber);

    // --- the loss ------------------------------------------------------------
    arrow(ctx, O_X + R_O + 6, O_Y, BOX.x - 8, O_Y, h.nloss ? flow : ink(0.26), 1.6, 7);
    ctx.fillStyle = bg();
    roundRect(ctx, BOX.x, BOX.y, BOX.w, BOX.h, 10);
    ctx.fill();
    ctx.strokeStyle = h.nloss ? flow : ink(0.2);
    ctx.lineWidth = h.nloss ? 2 : 1.2;
    ctx.stroke();
    label('½(a^[2] − y)²', LOSS_X, BOX.y + 22, 0.45, 'center', 11.5);
    label(seen(3) ? C.L.toFixed(4) : '?', LOSS_X, BOX.y + 50, seen(3) ? 0.92 : 0.25, 'center', 17);
    label(`target y = ${S.y}`, LOSS_X, BOX.y + 70, 0.45, 'center', 11.5);
    if (seen(4))
      label(`∂L/∂a^[2] = ${n3(g.e)}`, LOSS_X, BOX.y + BOX.h + 22, dim, 'center', 11.5, amber);

    drawBar();
    words();
    syncPanel();
  }

  /** The ten steps as a strip, so the shape of a pass is visible at a glance. */
  function drawBar() {
    const gap = 6;
    const cw = (BAR.w - gap * (BAR.n - 1)) / BAR.n;
    for (let i = 0; i < BAR.n; i++) {
      const x = BAR.x + i * (cw + gap);
      const col = i < 4 ? TEAL() : i < 9 ? AMB() : accent();
      const done = i <= S.k;
      ctx.fillStyle = col;
      ctx.globalAlpha = i === S.k ? 0.85 : done ? 0.4 : 0.1;
      roundRect(ctx, x, BAR.y, cw, BAR.h, 5);
      ctx.fill();
      ctx.globalAlpha = 1;
      if (i === S.k) {
        ctx.strokeStyle = col;
        ctx.lineWidth = 1.6;
        ctx.stroke();
      }
      label(String(i + 1), x + cw / 2, BAR.y + 14, done ? 0.85 : 0.3, 'center', 11.5,
        i === S.k ? bg() : undefined);
    }
    // centre of the cells a..b inclusive
    const span = (a: number, b: number) =>
      BAR.x + (a * (cw + gap) + b * (cw + gap) + cw) / 2;
    label('forward', span(0, 3), BAR.y + 38, 0.4, 'center', 11.5, TEAL());
    label('backward', span(4, 8), BAR.y + 38, 0.4, 'center', 11.5, AMB());
    label('update', span(9, 9), BAR.y + 38, 0.4, 'center', 11.5, accent());
  }

  // --- the line of maths above the stage -------------------------------------
  // Three parts of a fixed height: the rule, the rule with this pass's numbers
  // in it, and one sentence. Partials are written with a slash instead of as
  // built-up fractions, so no step is taller than any other and the picture
  // below never moves when the step changes.
  const dL = (x: string) => `\\partial L/\\partial ${x}`;

  const sci = (v: number) => (v === 0 ? '0' : v >= 1e-3 && v < 1e4 ? v.toPrecision(3) : v.toExponential(1));

  function words() {
    if (S.view === 'act') {
      const A = ACTS[S.act];
      const T = TEAL(), M = AMB();
      const d = A.d(S.z), g = survive(S.act, S.n);
      setEq({
        rule: [[A.ftex, T], '\\qquad', [`g_n = \\prod_{l=1}^{n} ${A.dtex}(z_l)`, M]],
        live: [
          [`${A.tex}(${S.z.toFixed(2)}) = ${A.f(S.z).toFixed(3)}`, T],
          [`\\quad ${A.dtex}(${S.z.toFixed(2)}) = ${d.toFixed(3)}`, M],
          [`\\quad |g_{${S.n}}| = ${sci(g).replace(/e([+-]?\d+)/, '\\times10^{$1}')}`, M],
        ],
      });
      el('result-label').textContent = `Gradient left after ${S.n} layers`;
      setResult({
        value: sci(g),
        colour: g < 1e-3 ? RED() : g > 10 ? RED() : M,
        status: g < 1e-3 ? 'vanished: the first layers get almost no signal' : g > 10 ? 'exploding: each layer multiplies it up' : 'survives the stack',
        note: A.note,
      });
      return;
    }
    el('result-label').textContent = 'Step';
    const [rule, live, sentence] = eqLines();
    setEq({ rule, live });
    const k = S.k;
    const flow = k === 9 ? accent() : PHASE(k) === 'bwd' ? AMB() : TEAL();
    setResult({
      value: k < 0 ? 'ready' : `${k + 1} of 10`,
      colour: k < 0 ? undefined : flow,
      status: k < 0 ? `pass ${S.pass + 1} · press Step to send the input forward` : `pass ${k === 9 ? S.pass : S.pass + 1} · ${TITLES[k]}`,
      note: String(sentence[0]),
    });
  }

  function eqLines(): Part[][] {
    const A = ACTS[S.act];
    const g = G();
    const T = TEAL(), M = AMB(), W2 = accent();
    const k = S.k;
    const phi = A.tex, dphi = A.dtex;

    if (k < 0)
      return [
        [['z^{[l]}', T], '=', ['W^{[l]}', W2], ['a^{[l-1]}', T], '+', ['b^{[l]}', W2], ',\\;\\;', ['a^{[l]}', T], `=${phi}(`, ['z^{[l]}', T], `),\\;\\; a^{[0]}=x`],
        [`x_1=${S.x[0].toFixed(2)},\\; x_2=${S.x[1].toFixed(2)},\\; y=${S.y},\\; \\eta=${S.lr.toFixed(2)},\\; L=2`],
        ['Nine parameters and one example. Every arrow in the picture below is one line of this.'],
      ];

    if (k === 0 || k === 1) {
      const j = k;
      return [
        [[`z^{[1]}_${j + 1}`, T], '=', [`W^{[1]}_{${j + 1}1}`, W2], ['x_1', T], '+', [`W^{[1]}_{${j + 1}2}`, W2], ['x_2', T], '+', [`b^{[1]}_${j + 1}`, W2], `,\\;\\; a^{[1]}_${j + 1}=${phi}(z^{[1]}_${j + 1})`],
        [[`z^{[1]}_${j + 1}=${pp(P.w[j][0])}\\!\\cdot\\!${pp(S.x[0])}+${pp(P.w[j][1])}\\!\\cdot\\!${pp(S.x[1])}+${pp(P.b[j])}=${n3(C.z[j])},\\;\\; a^{[1]}_${j + 1}=${n3(C.a[j])}`, T]],
        ['Every wire multiplies what arrives by its own weight, the unit adds them up with its bias, and the activation squashes the sum.'],
      ];
    }

    if (k === 2)
      return [
        [['z^{[2]}', T], '=', ['W^{[2]}_1', W2], ['a^{[1]}_1', T], '+', ['W^{[2]}_2', W2], ['a^{[1]}_2', T], '+', ['b^{[2]}', W2], ',\\;\\; a^{[2]}=\\sigma(z^{[2]})'],
        [[`z^{[2]}=${pp(P.v[0])}\\!\\cdot\\!${pp(C.a[0], 3)}+${pp(P.v[1])}\\!\\cdot\\!${pp(C.a[1], 3)}+${pp(P.c)}=${n3(C.zo)},\\;\\; a^{[2]}=${n3(C.yh)}`, T]],
        ['The output unit does exactly what the hidden ones did, one layer up. The forward pass is over.'],
      ];

    if (k === 3)
      return [
        [['L', T], '=\\tfrac12(', ['a^{[2]}', T], '-\\,y)^2'],
        [[`L=\\tfrac12(${n3(C.yh)}-${S.y})^2=${C.L.toFixed(4)}`, T]],
        ['One number for how wrong the whole network is. Everything from here on is a derivative of it.'],
      ];

    if (k === 4)
      return [
        [[dL('a^{[2]}'), M], '=', ['a^{[2]}', T], '-\\,y'],
        [[`${dL('a^{[2]}')}=${n3(C.yh)}-${S.y}=${n3(g.e)}`, M]],
        ['Backpropagation starts at the far end and walks backwards. This first derivative is the only free one.'],
      ];

    if (k === 5)
      return [
        [['\\delta^{[2]}', M], '=', [dL('z^{[2]}'), M], '=', [dL('a^{[2]}'), M], "\\cdot\\,\\sigma'(z^{[2]})"],
        [[`\\delta^{[2]}=${pp(g.e, 3)}\\!\\cdot\\!${n3(C.yh * (1 - C.yh))}=${n3(g.dO)}`, M]],
        ['Pull the derivative back through the activation by multiplying by its slope. A delta is the only thing that ever travels backwards.'],
      ];

    if (k === 6)
      return [
        [[dL('W^{[2]}_j'), M], '=', ['\\delta^{[2]}', M], ['a^{[1]}_j', T], ',\\;\\;', [dL('b^{[2]}'), M], '=', ['\\delta^{[2]}', M]],
        [[`${dL('W^{[2]}_1')}=${pp(g.dO, 3)}\\!\\cdot\\!${pp(C.a[0], 3)}=${n3(g.dv[0])},\\;\\; ${dL('W^{[2]}_2')}=${n3(g.dv[1])},\\;\\; ${dL('b^{[2]}')}=${n3(g.dc)}`, M]],
        ['A weight\u2019s gradient is the delta at its head times the activation at its tail. A bias has no tail, so its gradient is the delta itself.'],
      ];

    if (k === 7)
      return [
        [['\\delta^{[1]}_j', M], '=', ['\\delta^{[2]}', M], ['W^{[2]}_j', W2], `\\cdot\\,${dphi}(z^{[1]}_j)`],
        [[`\\delta^{[1]}_1=${pp(g.dO, 3)}\\!\\cdot\\!${pp(P.v[0])}\\!\\cdot\\!${pp(A.d(C.z[0]), 3)}=${n3(g.dh[0])},\\;\\; \\delta^{[1]}_2=${n3(g.dh[1])}`, M]],
        ['The wire that carried the value out carries the blame back, scaled by the same weight. That reuse is the whole trick.'],
      ];

    if (k === 8)
      return [
        [[dL('W^{[1]}_{ji}'), M], '=', ['\\delta^{[1]}_j', M], ['x_i', T], ',\\;\\;', [dL('b^{[1]}_j'), M], '=', ['\\delta^{[1]}_j', M]],
        [[`${dL('W^{[1]}_{11}')}=${pp(g.dh[0], 3)}\\!\\cdot\\!${pp(S.x[0])}=${n3(g.dw[0][0])},\\;\\; ${dL('b^{[1]}_1')}=\\delta^{[1]}_1=${n3(g.db[0])}`, M]],
        ['The same rule as the layer above, one layer down. Every parameter now has a gradient, and one sweep got them all.'],
      ];

    const before = hist.length >= 2 ? hist[hist.length - 2] : snap ? snap.L : C.L;
    return [
      [['\\theta', W2], '\\leftarrow', ['\\theta', W2], '-\\,\\eta\\;', [dL('\\theta'), M]],
      [[`L:\\; ${before.toFixed(4)}\\;\\rightarrow\\; ${C.L.toFixed(4)}`, W2], `\\quad (\\eta=${S.lr.toFixed(2)})`],
      ['All nine parameters move at once, each against its own gradient. Training is this, repeated.'],
    ];
  }

  // --- panel -----------------------------------------------------------------
  const GCELL: [string, () => number, number][] = [
    ['cw00', () => G().dw[0][0], 8], ['cw01', () => G().dw[0][1], 8], ['cb0', () => G().db[0], 8],
    ['cw10', () => G().dw[1][0], 8], ['cw11', () => G().dw[1][1], 8], ['cb1', () => G().db[1], 8],
    ['cv0', () => G().dv[0], 6], ['cv1', () => G().dv[1], 6], ['cc', () => G().dc, 6],
  ];

  function syncPanel() {
    setRows({ pass: String(S.pass), yhat: seen(2) ? C.yh.toFixed(4) : '—', loss: seen(3) ? C.L.toFixed(4) : '—' });
    el('gstate').textContent = seen(8) ? 'all nine' : seen(6) ? 'output layer' : 'none yet';
    for (const [id, get, at] of GCELL) {
      const cell = el(id);
      const on = seen(at);
      cell.classList.toggle('on', on);
      cell.querySelector('b')!.textContent = on ? n3(get()) : '—';
    }
    controls.setRunning(S.playing);
    drawLoss();
  }

  const lossCanvas = el('losscurve') as HTMLCanvasElement;
  const lc = setupCanvas(lossCanvas, () => drawLoss());
  function drawLoss() {
    const c = lc.ctx, Ws = lc.W, Hs = lc.H;
    const pad = { l: 10, r: 10, t: 12, b: 14 };
    c.clearRect(0, 0, Ws, Hs);
    if (hist.length === 0) return;
    const hi = Math.max(...hist, 1e-6) * 1.08;
    const sx = (i: number) =>
      pad.l + (hist.length <= 1 ? 0 : i / (hist.length - 1)) * (Ws - pad.l - pad.r);
    const sy = (v: number) => pad.t + (1 - v / hi) * (Hs - pad.t - pad.b);
    c.strokeStyle = ink(0.16);
    c.lineWidth = 1;
    c.beginPath(); c.moveTo(pad.l, sy(0)); c.lineTo(Ws - pad.r, sy(0)); c.stroke();
    c.strokeStyle = accent();
    c.lineWidth = 2;
    c.beginPath();
    hist.forEach((v, i) => (i ? c.lineTo(sx(i), sy(v)) : c.moveTo(sx(i), sy(v))));
    c.stroke();
    c.fillStyle = accent();
    c.beginPath();
    c.arc(sx(hist.length - 1), sy(hist[hist.length - 1]), 3, 0, Math.PI * 2);
    c.fill();
  }

  // --- driving ---------------------------------------------------------------
  function step() {
    if (S.k === 8) applyUpdate();
    else if (S.k === 9) S.k = 0;
    else S.k += 1;
  }

  function reset() {
    S.playing = false;
    S.k = -1;
    S.pass = 0;
    snap = null;
    P = clone(START);
    C = compute(P);
    hist = [C.L];
  }

  /** Changing the example or the activation invalidates the pass in progress. */
  function restart(clearHistory: boolean) {
    S.k = -1;
    snap = null;
    C = compute(P);
    if (clearHistory) hist = [C.L];
  }

  let last = performance.now();
  const STEP_MS = 780;
  function frame(t: number) {
    if (S.playing && t - last >= STEP_MS) {
      last = t;
      step();
    }
    draw();
    requestAnimationFrame(frame);
  }

  const controls = transport({
    onRun: (running) => {
      S.playing = running;
      last = performance.now();
    },
    onStep: () => {
      S.playing = false;
      step();
    },
    onReset: reset,
  });
  el('fast').addEventListener('click', () => {
    S.playing = false;
    for (let n = 0; n < 100; n++) applyUpdate();
    S.k = 9;
  });

  const two = (v: number) => v.toFixed(2);
  slider('lr', (v) => { S.lr = v; }, two);
  segmented('target', (y) => { S.y = +y; restart(true); });
  const acts = segmented('act', (a) => { S.act = a; restart(true); });
  function setView(v: 'net' | 'act') {
    S.view = v;
    views.select(v);
    if (v === 'act') S.playing = false;
    el('netwrap').hidden = v !== 'net';
    el('netcap').hidden = v !== 'net';
    el('actwrap').hidden = v !== 'act';
    el('actcap').hidden = v !== 'act';
  }
  const views = segmented('view', (v) => setView(v as 'net' | 'act'));
  const setZ = slider('z', (v) => { S.z = v; }, two);
  const setDepth = slider('depth', (v) => { S.n = v; });
  const setX1 = slider('x1', (v) => { S.x[0] = v; restart(true); }, two);
  const setX2 = slider('x2', (v) => { S.x[1] = v; restart(true); }, two);

  // clicking the strip rewinds inside the current pass; nothing has changed yet
  canvas.addEventListener('click', (ev) => {
    const r = canvas.getBoundingClientRect();
    const x = ((ev.clientX - r.left) / r.width) * W;
    const y = ((ev.clientY - r.top) / r.height) * H;
    if (S.view === 'act') {
      if (y < AP.y || y > AP.y + AP.h + 20 || x < AP.x || x > AP.x + AP.w) return;
      S.z = Math.round((AXR[0] + ((x - AP.x) / AP.w) * (AXR[1] - AXR[0])) * 20) / 20;
      setZ(S.z);
      return;
    }
    if (y < BAR.y - 8 || y > BAR.y + BAR.h + 8) return;
    const gap = 6;
    const cw = (BAR.w - gap * (BAR.n - 1)) / BAR.n;
    const i = Math.floor((x - BAR.x) / (cw + gap));
    if (i < 0 || i >= BAR.n) return;
    S.playing = false;
    if (i <= 8) S.k = i;
    else if (S.k === 8) applyUpdate();
  });

  canvas.addEventListener('mousemove', (ev) => {
    const r = canvas.getBoundingClientRect();
    const y = ((ev.clientY - r.top) / r.height) * H;
    if (S.view === 'act') {
      canvas.style.cursor = y > AP.y && y < AP.y + AP.h ? 'crosshair' : 'default';
      return;
    }
    canvas.style.cursor = y > BAR.y - 8 && y < BAR.y + BAR.h + 8 ? 'pointer' : 'default';
  });

  // --- the What-to-observe buttons -------------------------------------------
  function setInputs(a: number, b: number) {
    S.x = [a, b];
    setX1(a);
    setX2(b);
  }
  tries({
    pass: () => {
      setView('net');
      reset();
      S.playing = true;
      last = performance.now() - STEP_MS;
    },
    grads: () => {
      setView('net');
      S.playing = false;
      restart(false);
      S.k = 8;
    },
    dead: () => {
      setView('net');
      S.act = 'relu';
      acts.select('relu');
      // z₁ = 0.6·(−0.5) − 0.4·0.5 + 0.1 = −0.4 with the starting weights
      reset();
      setInputs(-0.5, 0.5);
      restart(true);
      S.k = 8;
    },
    vanish: () => {
      setView('act');
      S.act = 'sig';
      acts.select('sig');
      restart(true);
      S.z = 0.5;
      setZ(0.5);
      S.n = 10;
      setDepth(10);
    },
  });

  reset();
  requestAnimationFrame(frame);
</script>

