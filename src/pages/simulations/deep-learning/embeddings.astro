---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Checks from '../../../components/sim/Checks.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="deep-learning"
  title="Embeddings"
  description="An embedding turns a word into a list of numbers, which is an arrow, and words used alike point alike. Rank the words by the angle, by the dot product and by distance, and see why search normalises every arrow first."
  shortcuts={['fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="cos"
          width="1000"
          height="640"
          role="img"
          aria-label="Words as arrows in three dimensions, grouped by meaning, a query arrow among them, and a ranking of the words by cosine, dot product or distance."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'the query', color: '#7c8cff' },
          { label: 'animals', color: '#5eead4' },
          { label: 'royalty', color: '#c084fc' },
          { label: 'vehicles', color: '#fbbf24' },
          { label: 'food', color: '#f472b6' },
          { label: 'a positive number', color: '#60a5fa' },
          { label: 'a negative number', color: '#fb923c' },
        ]}
        hint="Hover a word to see its numbers · click it to point the query there · drag to turn, scroll to zoom"
      />
      <Result label="Best match for the query" />
    </div>

    <div class="sim-panel">
      <Seg
        id="shape"
        label="Draw each word as"
        attr="m"
        options={[
          { value: 'arrow', label: 'Arrows' },
          { value: 'point', label: 'Points' },
        ]}
      />
      <Seg
        id="rank"
        label="Rank the words by"
        attr="k"
        options={[
          { value: 'cos', label: 'cos θ' },
          { value: 'dot', label: 'dot product' },
          { value: 'dist', label: 'distance' },
        ]}
      />
      <Slider id="qlen" label="Query length" min={20} max={150} value={80} display="0.80" />
      <Checks items={[{ id: 'norm', label: 'Normalise every word to length 1' }]} />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Hover a word: the card shows its three numbers, and dashed steps walk
      them out along x, y and z to the tip of its arrow. A real embedding has
      hundreds of numbers; three are enough to draw.
    </li>
    <li>
      Rank by <b>cos θ</b> and only the angle θ between the query and a word
      counts. Puppy and dog lead, short or long, because they point almost
      the same way as the query. <Try id="cos" />
    </li>
    <li>
      Rank by <b>dot product</b> and <b>thing</b> takes first place. It is long, the way a frequent, vague word
      tends to be, and the dot product rewards length as much as direction. <Try id="dot" />
    </li>
    <li>
      Point a short query along <b>cat</b> and rank by <b>distance</b>: <b>kitten</b> wins, and even puppy beats
      cat, because short arrows sit close to any short query. <Try id="dist" />
    </li>
    <li>
      Make every word length 1 and the three rankings become the same list: on the sphere the dot product is the
      cosine, and distance only depends on the angle. Switch to points to see them all on its surface. <Try id="norm" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk } from '../../../lib/draw';
  import { segmented, slider, check, result, tries } from '../../../lib/panel';
  import { stageCamera } from '../../../lib/stage-camera';
  import { say, withAlpha, isLight, lerp, clamp01, glows } from '../../../lib/story';
  import { strip, token, EMB } from '../../../lib/embedding';

  // Words as arrows in three dimensions. A hand-made embedding: words used
  // alike point alike, and length carries something else (here, as in real
  // models, a frequent vague word like "thing" comes out long and rare
  // specific ones short). The sphere of radius 1 is drawn throughout, since
  // the last chapter pushes every arrow onto it.
  const ACC = '#7c8cff';
  const GROUP: Record<string, { colour: string; name: string }> = {
    a: { colour: '#5eead4', name: 'animals' },
    r: { colour: '#c084fc', name: 'royalty' },
    v: { colour: '#fbbf24', name: 'vehicles' },
    f: { colour: '#f472b6', name: 'food' },
    g: { colour: '#9aa0ac', name: '' },
  };
  type V3 = [number, number, number];
  const fromAngles = (az: number, el: number, l = 1): V3 => {
    const a = (az * Math.PI) / 180, e = (el * Math.PI) / 180;
    return [l * Math.cos(e) * Math.cos(a), l * Math.sin(e), l * Math.cos(e) * Math.sin(a)];
  };
  const dot = (a: V3, b: V3) => a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
  const norm = (a: V3) => Math.sqrt(dot(a, a));
  const scale = (a: V3, k: number): V3 => [a[0] * k, a[1] * k, a[2] * k];
  const unit = (a: V3) => scale(a, 1 / (norm(a) || 1));
  const sub = (a: V3, b: V3): V3 => [a[0] - b[0], a[1] - b[1], a[2] - b[2]];

  const WORDS = (
    [
      ['cat', 180, 15, 0.92, 'a'], ['kitten', 192, 24, 0.55, 'a'], ['dog', 212, 6, 0.96, 'a'], ['puppy', 226, 14, 0.6, 'a'],
      ['thing', 244, -8, 1.45, 'g'],
      ['king', 70, 15, 0.86, 'r'], ['queen', 96, 22, 0.8, 'r'], ['prince', 82, 38, 0.6, 'r'],
      ['car', 318, -10, 0.9, 'v'], ['truck', 338, -18, 0.78, 'v'], ['bus', 328, -34, 0.7, 'v'],
      ['apple', 5, 52, 0.8, 'f'], ['bread', 32, 60, 0.72, 'f'],
    ] as [string, number, number, number, string][]
  ).map(([w, az, el, l, g]) => ({ w, dir: fromAngles(az, el), len: l, g }));
  const PUPPY = WORDS.findIndex((x) => x.w === 'puppy');
  const CAT = WORDS.findIndex((x) => x.w === 'cat');
  const THING = WORDS.findIndex((x) => x.w === 'thing');
  const KITTEN = WORDS.findIndex((x) => x.w === 'kitten');

  const canvas = document.getElementById('cos') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas);
  const { ink, inv } = stageInk(canvas);
  const setEq = equation();
  const setResult = result();

  type Rank = 'cos' | 'dot' | 'dist';
  const S = { rank: 'cos' as Rank, qlen: 0.8, norm: false, ang: 2.97, tilt: 0.35, hover: -1, points: false };
  /** 0: words drawn as arrows, 1: as points at the arrow tips. */
  let pm = 0;
  const glow = glows();
  /** The view sways gently around one that shows the animals side on, until the reader turns it. */
  const BASE = 2.97;
  let turned = false, sway = 0;
  /** Where the query points and how long it is: the goal, and what is drawn on the way there. */
  const goal = { dir: unit(fromAngles(229, 12)), len: 0.8 };
  const Q = { dir: goal.dir as V3, len: 0.8 };
  /** 0: every arrow its own length, 1: every arrow on the sphere. */
  let nu = 0;

  const view = stageCamera(canvas, W, H, {
    canTurn: () => true,
    turn: (dx, dy) => {
      turned = true;
      S.ang -= dx * 0.01;
      S.tilt = Math.max(-1.2, Math.min(1.2, S.tilt + dy * 0.01));
    },
  });

  // ---------- projection ----------
  const O = { x: 660, y: 420, s: 185 };
  /** Ranking by distance leans in on the animals, where the short arrows are. */
  let zf = 1;
  function project(p: V3) {
    const ca = Math.cos(S.ang), sa = Math.sin(S.ang);
    const x = p[0] * ca + p[2] * sa, z = -p[0] * sa + p[2] * ca;
    const ct = Math.cos(S.tilt), st2 = Math.sin(S.tilt);
    const y = p[1] * ct - z * st2, z2 = p[1] * st2 + z * ct;
    const f = 5 / (5 - z2);
    const s = O.s * zf, cx = O.x - (zf - 1) * 150;
    return { x: view.X(cx + x * s * f), y: view.Y(O.y - y * s * f), z: z2, f };
  }

  // ---------- the words as they are now ----------
  const vec = (i: number): V3 => scale(WORDS[i].dir, lerp(WORDS[i].len, 1, nu));
  const qvec = (): V3 => scale(Q.dir, lerp(Q.len, 1, nu));
  function score(i: number, r: Rank) {
    const q = qvec(), w = vec(i);
    if (r === 'cos') return dot(q, w) / (norm(q) * norm(w));
    if (r === 'dot') return dot(q, w);
    return norm(sub(q, w));
  }
  const ranking = (r: Rank) =>
    WORDS.map((_, i) => ({ i, s: score(i, r) })).sort((a, b) => (r === 'dist' ? a.s - b.s : b.s - a.s));

  const rankSeg = segmented('rank', (v) => { S.rank = v as Rank; });
  segmented('shape', (v) => { S.points = v === 'point'; });
  const setLen = slider('qlen', (v) => { S.qlen = v / 100; goal.len = S.qlen; }, (v) => (v / 100).toFixed(2));
  const setNorm = check('norm', (on) => { S.norm = on; });
  function setRank(r: Rank) { S.rank = r; rankSeg.select(r); }
  function aim(dir: V3, len: number) {
    goal.dir = unit(dir);
    goal.len = len;
    S.qlen = len;
    setLen(Math.round(len * 100));
  }

  // ---------- the loop ----------
  /** How much of each ranking's drawing is showing, so switching fades one into the next. */
  const A = { angle: 0, shadow: 0, gap: 0 };
  let before = 0;
  function frame(now: number) {
    const light = isLight(canvas);
    const real = before ? Math.min(0.05, (now - before) / 1000) : 0;
    before = now;
    view.tick();
    if (S.hover < 0) sway += real;
    if (!turned) S.ang = lerp(S.ang, BASE + 0.3 * Math.sin(sway * 0.3), 1 - Math.exp(-real * 2));
    // ease the query, the zoom, the normalisation and the drawings towards their goals
    const k = 1 - Math.exp(-real * 3);
    Q.dir = unit([lerp(Q.dir[0], goal.dir[0], k), lerp(Q.dir[1], goal.dir[1], k), lerp(Q.dir[2], goal.dir[2], k)]);
    Q.len = lerp(Q.len, goal.len, k);
    zf = lerp(zf, S.rank === 'dist' ? 1.6 : 1, 1 - Math.exp(-real * 2));
    nu = lerp(nu, S.norm ? 1 : 0, 1 - Math.exp(-real * 1.6));
    pm = lerp(pm, S.points ? 1 : 0, 1 - Math.exp(-real * 5));
    const f = 1 - Math.exp(-real * 4);
    A.angle = lerp(A.angle, S.rank === 'cos' ? 1 : 0, f);
    A.shadow = lerp(A.shadow, S.rank === 'dot' ? 1 : 0, f);
    A.gap = lerp(A.gap, S.rank === 'dist' ? 1 : 0, f);

    ctx.clearRect(0, 0, W, H);
    sphere(0.3 * nu, light);
    axes(0.6);
    const top = ranking(S.rank)[0].i;
    const compared = S.hover >= 0 ? S.hover : top;

    shadows(compared, A.shadow);
    gaps(A.gap);
    arrows(compared);
    angleArc(compared, Math.max(A.angle, A.shadow));
    if (S.hover >= 0) walk(S.hover);
    groupNames(0.7);
    notes(top);

    focusCard(compared, light);
    if (nu > 0.5) agreeCard(light);
    else rankCard(S.rank, compared, light);

    if (view.away) say(ctx, 'double-click to reset the view', W - 16, H - 14, { colour: ink(0.45), size: 12, align: 'right' });
    panelText();
    eqTick(compared);
    requestAnimationFrame(frame);
  }

  function sphere(a: number, light: boolean) {
    if (a < 0.005) return;
    ctx.save();
    ctx.strokeStyle = light ? `rgba(28,30,36,${a})` : `rgba(232,233,236,${a})`;
    ctx.lineWidth = 1;
    const ring = (f: (u: number) => V3) => {
      ctx.beginPath();
      for (let k = 0; k <= 64; k++) {
        const p = project(f((2 * Math.PI * k) / 64));
        k ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y);
      }
      ctx.stroke();
    };
    for (const el of [-60, -30, 0, 30, 60]) {
      const e = (el * Math.PI) / 180;
      ring((u) => [Math.cos(e) * Math.cos(u), Math.sin(e), Math.cos(e) * Math.sin(u)]);
    }
    for (let m = 0; m < 6; m++) {
      const a2 = (m * Math.PI) / 6;
      ring((u) => [Math.cos(u) * Math.cos(a2), Math.sin(u), Math.cos(u) * Math.sin(a2)]);
    }
    ctx.restore();
  }

  function axes(a: number) {
    if (a <= 0) return;
    const names = ['x', 'y', 'z'];
    for (let k = 0; k < 3; k++) {
      const e: V3 = [0, 0, 0];
      e[k] = 1.25;
      const p = project(e), m = project(scale(e, -1)), o = project([0, 0, 0]);
      ctx.save();
      ctx.strokeStyle = ink(0.16 * a);
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(m.x, m.y);
      ctx.lineTo(p.x, p.y);
      ctx.stroke();
      ctx.restore();
      say(ctx, names[k], p.x + (p.x - o.x) * 0.06, p.y + (p.y - o.y) * 0.06, { colour: ink(0.4 * a), size: 12, align: 'center' });
    }
  }

  /** An arrow from the origin, thicker and brighter in front. */
  function arrow3(v: V3, col: string, a: number, wide = 1) {
    if (a <= 0) return;
    const o = project([0, 0, 0]), p = project(v);
    const depth = clamp01((p.z + 1.5) / 3);
    const dx = p.x - o.x, dy = p.y - o.y, L = Math.hypot(dx, dy) || 1, ux = dx / L, uy = dy / L;
    const head = Math.min(11 * p.f, L * 0.45);
    ctx.save();
    ctx.globalAlpha = a * (0.45 + 0.55 * depth);
    ctx.strokeStyle = col;
    ctx.fillStyle = col;
    ctx.lineWidth = 2.2 * p.f * wide;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(o.x, o.y);
    ctx.lineTo(p.x - ux * head * 0.8, p.y - uy * head * 0.8);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(p.x, p.y);
    ctx.lineTo(p.x - ux * head - uy * head * 0.45, p.y - uy * head + ux * head * 0.45);
    ctx.lineTo(p.x - ux * head + uy * head * 0.45, p.y - uy * head - ux * head * 0.45);
    ctx.closePath();
    ctx.fill();
    ctx.restore();
    return p;
  }

  /**
   * A word as an arrow from the origin, as a point where the arrow ends, or
   * on the way from one to the other. A point that is being compared keeps a
   * faint ray to the origin, since the angle is measured there.
   */
  function mark(v: V3, col: string, a: number, wide: number, ray: boolean, query = false) {
    if (pm < 0.999) arrow3(v, col, a * (1 - pm), wide);
    const p = project(v);
    if (pm > 0.001) {
      const light = isLight(canvas);
      const depth = clamp01((p.z + 1.5) / 3), al = a * pm * (0.5 + 0.5 * depth);
      if (ray) {
        const o = project([0, 0, 0]);
        ctx.save();
        ctx.globalAlpha = al * 0.5;
        ctx.strokeStyle = col;
        ctx.lineWidth = 1.2;
        ctx.setLineDash([3, 4]);
        ctx.beginPath();
        ctx.moveTo(o.x, o.y);
        ctx.lineTo(p.x, p.y);
        ctx.stroke();
        ctx.restore();
      }
      const r = (query ? 6 : 4.2) * p.f * (wide > 1 ? 1.2 : 1);
      const img = glow(col, r, light), s = img.width / 2;
      ctx.save();
      ctx.globalAlpha = al;
      ctx.drawImage(img, p.x - s / 2, p.y - s / 2, s, s);
      if (query) {
        ctx.strokeStyle = col;
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(p.x, p.y, r + 5, 0, Math.PI * 2);
        ctx.stroke();
      }
      ctx.restore();
    }
    return p;
  }

  /** Screen positions of the arrow tips this frame, for hovering and clicking. */
  const tipX = new Float64Array(WORDS.length), tipY = new Float64Array(WORDS.length);
  function arrows(compared: number) {
    if (pm > 0.01) {
      const o = project([0, 0, 0]);
      ctx.fillStyle = ink(0.6 * pm);
      ctx.beginPath();
      ctx.arc(o.x, o.y, 2.5, 0, Math.PI * 2);
      ctx.fill();
      say(ctx, '0', o.x - 8, o.y + 10, { colour: ink(0.45 * pm), size: 11, align: 'right' });
    }
    const order = WORDS.map((_, i) => ({ i, z: project(vec(i)).z })).sort((a, b) => a.z - b.z);
    const top = ranking(S.rank)[0].i;
    for (const { i } of order) {
      const v = vec(i);
      const col = GROUP[WORDS[i].g].colour;
      const hi = i === compared ? 1.5 : 1;
      const p = mark(v, col, 1, hi, i === compared);
      tipX[i] = p.x;
      tipY[i] = p.y;
      const o = project([0, 0, 0]), dx = p.x - o.x, dy = p.y - o.y, L = Math.hypot(dx, dy) || 1;
      const lx = p.x + (dx / L) * 14, ly = p.y + (dy / L) * 12;
      const first = top === i;
      say(ctx, WORDS[i].w, lx, ly, {
        colour: first ? ink(1) : withAlpha(col, 0.95), size: i === compared || first ? 15 : 13, weight: i === compared || first ? 700 : 550,
        align: dx > 8 ? 'left' : dx < -8 ? 'right' : 'center', halo: inv(0.8),
      });
    }
    const p = mark(qvec(), ACC, 1, 1.7, true, true);
    const o = project([0, 0, 0]), dx = p.x - o.x, dy = p.y - o.y, L = Math.hypot(dx, dy) || 1;
    say(ctx, 'query', p.x + (dx / L) * 16, p.y + (dy / L) * 14 + 16, { colour: ACC, size: 14, weight: 700, align: dx > 0 ? 'left' : 'right', halo: inv(0.85) });
  }

  /** A word's three numbers walked out along the axes to the tip of its arrow, in the strip's colours. */
  function walk(i: number) {
    const v = vec(i), steps: V3[] = [[0, 0, 0], [v[0], 0, 0], [v[0], v[1], 0], [v[0], v[1], v[2]]];
    const light = isLight(canvas);
    const cols = v.map((x) => (x >= 0 ? (light ? EMB.posLight : EMB.pos) : light ? EMB.negLight : EMB.neg));
    const names = ['x', 'y', 'z'];
    for (let k = 0; k < 3; k++) {
      const p0 = project(steps[k]), p1 = project(steps[k + 1]);
      ctx.save();
      ctx.strokeStyle = cols[k];
      ctx.lineWidth = 2.2;
      ctx.setLineDash([5, 4]);
      ctx.beginPath();
      ctx.moveTo(p0.x, p0.y);
      ctx.lineTo(p1.x, p1.y);
      ctx.stroke();
      ctx.restore();
      if (Math.hypot(p1.x - p0.x, p1.y - p0.y) > 18)
        say(ctx, names[k], (p0.x + p1.x) / 2, (p0.y + p1.y) / 2 - 10, { colour: cols[k], size: 12, weight: 700, align: 'center', halo: inv(0.85) });
    }
  }

  function groupNames(a: number) {
    if (a <= 0) return;
    for (const g of ['a', 'r', 'v', 'f']) {
      const members = WORDS.map((w, i) => ({ w, i })).filter((x) => x.w.g === g);
      const c = unit(members.reduce((s, x) => [s[0] + x.w.dir[0], s[1] + x.w.dir[1], s[2] + x.w.dir[2]] as V3, [0, 0, 0] as V3));
      const p = project(scale(c, 1.32));
      say(ctx, GROUP[g].name, p.x, p.y, { colour: withAlpha(GROUP[g].colour, 0.55 * a), size: 12, weight: 700, align: 'center' });
    }
  }

  /** The angle between the query and a word, as an arc near the origin. */
  function angleArc(i: number, a: number) {
    if (a <= 0) return;
    const q = Q.dir, w = WORDS[i].dir, th = Math.acos(Math.max(-1, Math.min(1, dot(q, w))));
    if (th < 0.02) return;
    const perp = unit(sub(w, scale(q, dot(w, q))));
    ctx.save();
    ctx.globalAlpha = a;
    ctx.strokeStyle = ink(0.85);
    ctx.lineWidth = 1.6;
    ctx.beginPath();
    for (let k = 0; k <= 24; k++) {
      const s = (th * k) / 24;
      const p = project(scale([q[0] * Math.cos(s) + perp[0] * Math.sin(s), q[1] * Math.cos(s) + perp[1] * Math.sin(s), q[2] * Math.cos(s) + perp[2] * Math.sin(s)], 0.32));
      k ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y);
    }
    ctx.stroke();
    ctx.restore();
    const m = th / 2, p = project(scale([q[0] * Math.cos(m) + perp[0] * Math.sin(m), q[1] * Math.cos(m) + perp[1] * Math.sin(m), q[2] * Math.cos(m) + perp[2] * Math.sin(m)], 0.32));
    const o = project([0, 0, 0]), ox = p.x - o.x, oy = p.y - o.y, ol = Math.hypot(ox, oy) || 1;
    p.x = o.x + (ox / ol) * (ol + 34);
    p.y = o.y + (oy / ol) * (ol + 34) + 14;
    say(ctx, `θ = ${Math.round((th * 180) / Math.PI)}°`, p.x, p.y, { colour: ink(0.9), size: 13, weight: 650, align: 'center', alpha: a, halo: inv(0.85) });
  }

  /** Ranking by dot product: each word's shadow on the query's line, the part the dot product counts. */
  function shadows(compared: number, a: number) {
    if (a <= 0.01) return;
    const q = Q.dir;
    const l0 = project(scale(q, -0.6)), l1 = project(scale(q, 1.6));
    ctx.save();
    ctx.globalAlpha = a;
    ctx.strokeStyle = withAlpha(ACC, 0.35);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(l0.x, l0.y);
    ctx.lineTo(l1.x, l1.y);
    ctx.stroke();
    for (const i of [compared, PUPPY]) {
      const w = vec(i), foot = scale(q, dot(w, q)), pw = project(w), pf = project(foot), o = project([0, 0, 0]);
      const col = GROUP[WORDS[i].g].colour;
      ctx.setLineDash([4, 4]);
      ctx.strokeStyle = withAlpha(col, 0.7);
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      ctx.moveTo(pw.x, pw.y);
      ctx.lineTo(pf.x, pf.y);
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.strokeStyle = withAlpha(col, 0.9);
      ctx.lineWidth = i === compared ? 6 : 4;
      ctx.lineCap = 'round';
      const off = i === compared ? 7 : -7;
      const nx = -(pf.y - o.y), ny = pf.x - o.x, nl = Math.hypot(nx, ny) || 1;
      ctx.beginPath();
      ctx.moveTo(o.x + (nx / nl) * off, o.y + (ny / nl) * off);
      ctx.lineTo(pf.x + (nx / nl) * off, pf.y + (ny / nl) * off);
      ctx.stroke();
    }
    ctx.restore();
  }

  /** Ranking by distance: the straight gaps from the query's tip to the nearest few word tips. */
  function gaps(a: number) {
    if (a <= 0.01) return;
    const pq = project(qvec());
    ranking('dist').slice(0, 3).forEach(({ i, s }, k) => {
      const pw = project(vec(i));
      ctx.save();
      ctx.globalAlpha = a;
      ctx.strokeStyle = k === 0 ? ink(0.95) : ink(0.4);
      ctx.lineWidth = k === 0 ? 2 : 1.2;
      ctx.setLineDash([3, 4]);
      ctx.beginPath();
      ctx.moveTo(pq.x, pq.y);
      ctx.lineTo(pw.x, pw.y);
      ctx.stroke();
      ctx.restore();
      say(ctx, s.toFixed(2), (pq.x + pw.x) / 2, (pq.y + pw.y) / 2, { colour: ink(k === 0 ? 0.95 : 0.6), size: 12, weight: 600, align: 'center', alpha: a, halo: inv(0.85) });
    });
  }

  /** A line next to the word that wins for the wrong reason. */
  function notes(top: number) {
    if (S.hover >= 0 || nu > 0.5) return;
    const at = (i: number, text: string, dy = -26) =>
      say(ctx, text, tipX[i], tipY[i] + dy, { colour: ink(0.9), size: 13.5, weight: 650, align: 'center', halo: inv(0.85) });
    if (S.rank === 'dot' && top === THING) at(THING, 'long and vague: wins on dot product');
    if (S.rank === 'dist' && top === KITTEN) {
      at(KITTEN, 'short: nearest by distance', 54);
      at(CAT, 'right direction, but long');
    }
  }

  // ---------- the card on the left ----------
  const CARD = { x: 30, y: 196, w: 300 };
  function card(h: number, light: boolean, y = CARD.y) {
    ctx.save();
    ctx.beginPath();
    ctx.roundRect(CARD.x, y, CARD.w, h, 12);
    // opaque, so a zoomed-in scene passes behind it
    ctx.fillStyle = inv(0.94);
    ctx.fill();
    ctx.fillStyle = light ? 'rgba(28,30,36,0.035)' : 'rgba(255,255,255,0.03)';
    ctx.fill();
    ctx.strokeStyle = ink(0.08);
    ctx.stroke();
    ctx.restore();
  }

  /** The word in focus, as the site draws an embedding: its chip and its numbers. */
  function focusCard(i: number, light: boolean) {
    const y0 = 20;
    card(162, light, y0);
    const v = vec(i), cell = 30, gap = 14, sx = CARD.x + 18, sy = y0 + 60;
    const col = GROUP[WORDS[i].g].colour;
    ctx.font = '700 17px Inter, ui-sans-serif, system-ui, sans-serif';
    token(ctx, WORDS[i].w, [], sx + (ctx.measureText(WORDS[i].w).width + 22) / 2, y0 + 16, { light, ink, colour: col, focus: true });
    say(ctx, S.hover >= 0 ? 'under the mouse' : 'best match', CARD.x + CARD.w - 16, y0 + 32, { colour: ink(0.45), size: 11.5, align: 'right' });
    const names = ['x', 'y', 'z'];
    for (let k = 0; k < 3; k++) {
      const x = sx + k * (cell + gap);
      strip(ctx, [v[k]], x, sy, { light, ink, cell, scale: 1, more: false });
      say(ctx, (v[k] < 0 ? '−' : '') + Math.abs(v[k]).toFixed(2), x + cell / 2, sy + cell + 14, { colour: ink(0.9), size: 12.5, weight: 650, align: 'center' });
      say(ctx, names[k], x + cell / 2, sy + cell + 29, { colour: ink(0.45), size: 11, align: 'center' });
    }
    const x0 = sx + 3 * (cell + gap) - 6;
    for (let k = 0; k < 4; k++) {
      ctx.fillStyle = ink(0.45 * (1 - k / 4));
      ctx.beginPath();
      ctx.arc(x0 + 4 + k * 9, sy + cell / 2, 2, 0, Math.PI * 2);
      ctx.fill();
    }
    say(ctx, 'a real model:', x0 + 46, sy + 7, { colour: ink(0.5), size: 12 });
    say(ctx, 'hundreds more', x0 + 46, sy + 24, { colour: ink(0.5), size: 12 });
    say(ctx, `length ${norm(v).toFixed(2)}   ·   cos θ with the query ${score(i, 'cos').toFixed(2)}`, sx, y0 + 144, { colour: ink(0.6), size: 12 });
  }

  const RANK_NAME: Record<Rank, string> = { cos: 'cos θ', dot: 'dot product q·w', dist: 'distance ‖q − w‖' };
  const rowY = new Float64Array(WORDS.length).fill(-1);
  function rankCard(r: Rank, compared: number, light: boolean) {
    card(386, light);
    say(ctx, `ranked by ${RANK_NAME[r]}`, CARD.x + 16, CARD.y + 22, { colour: ink(0.6), size: 12.5, weight: 600 });
    const list = ranking(r);
    const vals = list.map((x) => x.s), lo = Math.min(...vals, 0), hi = Math.max(...vals);
    list.forEach(({ i, s }, k) => {
      const target = CARD.y + 50 + k * 26.5;
      rowY[i] = rowY[i] < 0 ? target : lerp(rowY[i], target, 0.15);
      const y = rowY[i], col = GROUP[WORDS[i].g].colour, on = i === compared || k === 0;
      say(ctx, `${k + 1}`, CARD.x + 26, y, { colour: ink(0.4), size: 12, align: 'right' });
      say(ctx, WORDS[i].w, CARD.x + 36, y, { colour: on ? ink(1) : withAlpha(col, 0.9), size: 13, weight: on ? 700 : 500 });
      strip(ctx, vec(i), CARD.x + 96, y - 5, { light, ink, cell: 10, gap: 1.5, scale: 1, more: false, alpha: on ? 1 : 0.8 });
      const bw = 92 * ((s - lo) / (hi - lo || 1));
      ctx.fillStyle = withAlpha(col, on ? 0.85 : 0.45);
      ctx.fillRect(CARD.x + 142, y - 5, Math.max(1, bw), 10);
      say(ctx, (s < 0 ? '−' : '') + Math.abs(s).toFixed(2), CARD.x + CARD.w - 14, y, { colour: ink(on ? 0.95 : 0.6), size: 12, align: 'right', weight: on ? 650 : 400 });
    });
  }

  /** Chapter 5: the three rankings side by side, which become one list on the sphere. */
  function agreeCard(light: boolean) {
    card(250, light);
    const cols: Rank[] = ['cos', 'dot', 'dist'], names = ['cos θ', 'dot', 'distance'];
    const lists = cols.map((r) => ranking(r).slice(0, 6).map((x) => x.i));
    const same = lists.every((l) => l.every((v, k) => v === lists[0][k]));
    cols.forEach((_, c) => {
      const x = CARD.x + 18 + c * 94;
      say(ctx, names[c], x, CARD.y + 22, { colour: ink(0.6), size: 12.5, weight: 600 });
      lists[c].forEach((i, k) => {
        const differs = lists[c][k] !== lists[0][k];
        say(ctx, WORDS[i].w, x, CARD.y + 50 + k * 24, { colour: differs ? '#f9736a' : withAlpha(GROUP[WORDS[i].g].colour, 0.95), size: 13, weight: 550 });
      });
    });
    say(ctx, same ? 'the same list, three ways' : 'three rankings, three lists', CARD.x + 18, CARD.y + 210, { colour: same ? '#5eead4' : '#f9736a', size: 13.5, weight: 650 });
    say(ctx, `arrows at length 1: ${Math.round(nu * 100)}%`, CARD.x + 18, CARD.y + 232, { colour: ink(0.5), size: 12 });
  }

  // ---------- numbers ----------
  let tick = 0;
  function panelText() {
    if (tick++ % 10) return;
    const best = ranking(S.rank)[0];
    const byCos = ranking('cos')[0];
    const agrees = best.i === byCos.i;
    setResult({
      value: WORDS[best.i].w,
      status: `${RANK_NAME[S.rank]} = ${best.s.toFixed(2)}${agrees ? '' : ` · by angle alone it would be ${WORDS[byCos.i].w}`}`,
      note:
        nu > 0.5
          ? 'Every word has length 1: the dot product is the cosine and distance follows the angle, so the three rankings agree.'
          : S.rank === 'cos'
            ? 'cos θ looks at direction alone: a long word and a short one pointing the same way score the same.'
            : S.rank === 'dot'
              ? 'The dot product is length times shadow, so a long word can win while pointing less well.'
              : 'Distance mixes length in the other way: short arrows sit close to any short query.',
      colour: agrees ? '#5eead4' : '#f9736a',
    });
  }

  type Part = string | [string, string];
  let eqKey = '';
  function eqTick(focus: number) {
    const v = vec(focus), f = (x: number) => (x < 0 ? '-' : '') + Math.abs(x).toFixed(2);
    const q = '\\textcolor{' + ACC + '}{q}';
    const mode = nu > 0.5 ? 'norm' : S.rank;
    const key = `${mode}|${focus}|${v.map((x) => x.toFixed(2)).join()}`;
    if (key === eqKey) return;
    eqKey = key;
    const RULE: Record<string, Part[]> = {
      cos: [`\\cos\\theta = \\dfrac{${q} \\cdot w}{\\|${q}\\|\\,\\|w\\|}`],
      dot: [`${q} \\cdot w = \\|${q}\\|\\; \\underbrace{\\|w\\| \\cos\\theta}_{\\text{shadow}}`],
      dist: [`\\|${q} - w\\| = \\sqrt{\\|${q}\\|^2 + \\|w\\|^2 - 2\\, ${q} \\cdot w}`],
      norm: [`\\|${q}\\| = \\|w\\| = 1 \\;\\Rightarrow\\; ${q} \\cdot w = \\cos\\theta, \\;\\; \\|${q} - w\\|^2 = 2 - 2\\cos\\theta`],
    };
    setEq({
      rule: RULE[mode],
      live: [[`\\text{${WORDS[focus].w}}`, GROUP[WORDS[focus].g].colour], `\\;\\mapsto\\; (${f(v[0])},\\; ${f(v[1])},\\; ${f(v[2])})`],
    });
  }

  // ---------- input ----------
  const local = (e: MouseEvent) => {
    const b = canvas.getBoundingClientRect();
    return { x: ((e.clientX - b.left) / b.width) * W, y: ((e.clientY - b.top) / b.height) * H };
  };
  const wordAt = (x: number, y: number) => {
    let best = -1, bd = 18 * 18;
    WORDS.forEach((_, i) => {
      const d = (tipX[i] - x) ** 2 + (tipY[i] - y) ** 2;
      if (d < bd) { bd = d; best = i; }
    });
    return best;
  };
  canvas.addEventListener('pointerleave', () => (S.hover = -1));
  canvas.addEventListener('pointermove', (e) => {
    if (view.busy) return;
    const p = local(e);
    S.hover = wordAt(p.x, p.y);
    canvas.style.cursor = S.hover >= 0 ? 'pointer' : '';
  });
  let down = { x: 0, y: 0 };
  canvas.addEventListener('pointerdown', (e) => (down = local(e)));
  canvas.addEventListener('click', (e) => {
    const p = local(e);
    if (Math.hypot(p.x - down.x, p.y - down.y) > 4) return;
    const i = wordAt(p.x, p.y);
    if (i < 0) return;
    aim(WORDS[i].dir, S.qlen);
  });

  function put(r: Rank, normalise: boolean, dir: V3 = fromAngles(229, 12), len = 0.8) {
    setRank(r);
    aim(dir, len);
    S.norm = normalise;
    setNorm(normalise);
  }
  tries({
    cos: () => put('cos', false),
    dot: () => put('dot', false),
    dist: () => put('dist', false, WORDS[CAT].dir, 0.45),
    norm: () => put('cos', true),
  });

  requestAnimationFrame(frame);
</script>
