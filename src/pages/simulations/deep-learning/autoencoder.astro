---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
---

<SimLayout
  areaSlug="deep-learning"
  title="Autoencoder & Latent Space"
  description="Force a picture through a gap of two numbers and make the network rebuild it from those two alone. Nothing says what the numbers should mean, and yet the only way to pass is to lay every picture out on a map."
  shortcuts={['run', 'reset', 'fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="ae"
          width="1000"
          height="600"
          role="img"
          aria-label="A training image beside its reconstruction, a map of the latent space with every training image placed on it, and the picture decoded from the point you are pointing at."
        ></canvas>
      </div>
      <Caption
        legend={[{ label: 'the point you are decoding', color: '#7c8cff' }, { label: 'one training image', color: '#5eead4' }]}
        hint="Drag anywhere on the map, including the empty parts"
      />
      <Result label="Reconstruction error" />
    </div>

    <div class="sim-panel">
      <Transport reset />
      <Slider id="lat" label="Numbers in the gap" min={1} max={4} value={2} hint={['one', 'four']} />
      <Seg id="data" label="Pictures" attr="d" options={[{ value: 'digits', label: 'Digits' }, { value: 'blobs', label: 'Blobs' }]} />
      <Readout
        rows={[
          { id: 'r-err', label: 'reconstruction error' },
          { id: 'r-steps', label: 'training steps' },
          { id: 'r-comp', label: 'compression' },
          { id: 'r-best1', label: 'best with 1 number' },
          { id: 'r-best2', label: 'best with 2' },
          { id: 'r-best3', label: 'best with 3' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Each picture arrives as 256 numbers and has to come back out of a gap of
      two. Nothing is told to the network about digits, strokes or position: the
      only instruction is to rebuild what it was given.
    </li>
    <li>
      Let it train and watch the map fill in. Pictures that look alike end up
      near each other, so the gap becomes a <b>map of pictures</b> rather than a
      list of them, and that happened on its own.
    </li>
    <li>
      Drag through the empty parts between the points. A picture comes out
      everywhere, and it changes smoothly as you move, sliding from one digit
      into another. That smoothness is the property every generative model is
      built on.
    </li>
    <li>
      Set <b>numbers in the gap</b> to 1. Everything collapses onto a line, the
      error jumps, and the reconstructions turn into an average of whatever was
      nearby. One number is simply not enough addresses to go round.
    </li>
    <li>
      Then try 3 and 4. The panel keeps the best error at each width, and the
      gain from each extra number gets smaller. Where it stops mattering is the
      number of things that genuinely vary in the data, which is what
      <a href="/simulations/generative-ai/data-manifold">The Data Manifold</a>
      is about.
    </li>
    <li>
      Switch to <b>blobs</b>, where only the position of a spot ever changes. Two
      numbers reach almost zero error and a third adds nothing, because the data
      really is two-dimensional. Digits never get that clean, which is the honest
      difference between a toy and a real dataset.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk } from '../../../lib/draw';
  import { digitSet } from '../../../lib/digits';
  import { el, segmented, slider, transport, result, readout } from '../../../lib/panel';

  const PICK = '#7c8cff', DOT = '#5eead4', ERR = '#f87171';
  const IMG = 16, D = IMG * IMG, HID = 48, M = 500, BATCH = 10, SHOWN = 320;
  const CLASSES = [0, 1, 3, 4, 7, 8];
  const PALETTE = ['#5eead4', '#7c8cff', '#f59e0b', '#f87171', '#c084fc', '#60a5fa', '#34d399', '#fbbf24', '#fb7185', '#a3e635'];

  const state = { lat: 2, data: 'digits', running: false, steps: 0, drag: [0, 0, 0, 0] };
  const best: Record<number, number> = {};

  const canvas = el('ae') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink, inv } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  function mulberry32(a: number) {
    return () => {
      a = (a + 0x6d2b79f5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  let rnd = mulberry32(1);
  const gauss = () => {
    const u = Math.max(1e-9, rnd());
    return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * rnd());
  };

  // --- the pictures ----------------------------------------------------------
  let X: Float64Array[] = [];
  /** What made each picture: the digit, or where the blob was. */
  let tag: number[] = [];

  function makeData() {
    rnd = mulberry32(7);
    X = [];
    tag = [];
    if (state.data === 'digits') {
      for (const d of digitSet(M, IMG, 20260907, CLASSES)) {
        X.push(d.img);
        tag.push(d.label);
      }
      return;
    }
    for (let m = 0; m < M; m++) {
      const r = Math.sqrt(rnd()) * 0.78, a = rnd() * Math.PI * 2;
      const cx = r * Math.cos(a), cy = r * Math.sin(a);
      const img = new Float64Array(D);
      const s2 = 2 * 0.22 * 0.22;
      for (let py = 0; py < IMG; py++)
        for (let px = 0; px < IMG; px++) {
          const x = (px / (IMG - 1)) * 2 - 1, y = (py / (IMG - 1)) * 2 - 1;
          img[py * IMG + px] = Math.exp(-((x - cx) ** 2 + (y - cy) ** 2) / s2);
        }
      X.push(img);
      tag.push(((Math.atan2(cy, cx) + Math.PI) / (2 * Math.PI)) * 9.99);
    }
  }
  const colourOf = (m: number) =>
    state.data === 'digits' ? PALETTE[tag[m] % PALETTE.length] : PALETTE[Math.floor(tag[m]) % PALETTE.length];

  // --- the network: 256 → 48 → L → 48 → 256 ----------------------------------
  type P = { w: Float64Array; m: Float64Array; v: Float64Array; n: number };
  let W1: P, W2: P, W3: P, W4: P, b1: P, b2: P, b3: P, b4: P;
  let adamT = 0;

  const par = (n: number, sigma: number): P => {
    const w = new Float64Array(n);
    for (let i = 0; i < n; i++) w[i] = sigma ? gauss() * sigma : 0;
    return { w, m: new Float64Array(n), v: new Float64Array(n), n };
  };

  function initNet() {
    rnd = mulberry32(99 + state.lat);
    const L = state.lat;
    W1 = par(HID * D, Math.sqrt(2 / D));
    b1 = par(HID, 0);
    W2 = par(L * HID, Math.sqrt(1 / HID));
    b2 = par(L, 0);
    W3 = par(HID * L, Math.sqrt(2 / Math.max(1, L)));
    b3 = par(HID, 0);
    W4 = par(D * HID, Math.sqrt(1 / HID));
    b4 = par(D, 0);
    adamT = 0;
    state.steps = 0;
  }

  const h1 = new Float64Array(HID), h2 = new Float64Array(HID);
  const zlat = new Float64Array(8), xhat = new Float64Array(D);

  function encode(x: Float64Array) {
    const L = state.lat;
    for (let j = 0; j < HID; j++) {
      let s = b1.w[j];
      const off = j * D;
      for (let i = 0; i < D; i++) s += W1.w[off + i] * x[i];
      h1[j] = Math.tanh(s);
    }
    for (let j = 0; j < L; j++) {
      let s = b2.w[j];
      const off = j * HID;
      for (let i = 0; i < HID; i++) s += W2.w[off + i] * h1[i];
      zlat[j] = s;
    }
  }
  function decode(z: Float64Array | number[], L: number) {
    for (let j = 0; j < HID; j++) {
      let s = b3.w[j];
      const off = j * L;
      for (let i = 0; i < L; i++) s += W3.w[off + i] * z[i];
      h2[j] = Math.tanh(s);
    }
    for (let j = 0; j < D; j++) {
      let s = b4.w[j];
      const off = j * HID;
      for (let i = 0; i < HID; i++) s += W4.w[off + i] * h2[i];
      xhat[j] = s;
    }
  }
  const forward = (x: Float64Array) => { encode(x); decode(zlat, state.lat); };

  const gW1 = new Float64Array(HID * D), gb1 = new Float64Array(HID);
  const gW2 = new Float64Array(8 * HID), gb2 = new Float64Array(8);
  const gW3 = new Float64Array(HID * 8), gb3 = new Float64Array(HID);
  const gW4 = new Float64Array(D * HID), gb4 = new Float64Array(D);
  const dx = new Float64Array(D), dh2 = new Float64Array(HID), dz = new Float64Array(8), dh1 = new Float64Array(HID);

  function trainStep() {
    const L = state.lat;
    gW1.fill(0); gb1.fill(0); gW2.fill(0); gb2.fill(0);
    gW3.fill(0); gb3.fill(0); gW4.fill(0); gb4.fill(0);
    for (let n = 0; n < BATCH; n++) {
      const x = X[Math.floor(rnd() * M)];
      forward(x);
      for (let i = 0; i < D; i++) dx[i] = (xhat[i] - x[i]) / BATCH;
      for (let j = 0; j < D; j++) {
        const g = dx[j], off = j * HID;
        for (let i = 0; i < HID; i++) gW4[off + i] += g * h2[i];
        gb4[j] += g;
      }
      dh2.fill(0);
      for (let j = 0; j < D; j++) {
        const g = dx[j], off = j * HID;
        for (let i = 0; i < HID; i++) dh2[i] += W4.w[off + i] * g;
      }
      for (let i = 0; i < HID; i++) dh2[i] *= 1 - h2[i] * h2[i];
      for (let j = 0; j < HID; j++) {
        const g = dh2[j], off = j * L;
        for (let i = 0; i < L; i++) gW3[off + i] += g * zlat[i];
        gb3[j] += g;
      }
      dz.fill(0);
      for (let j = 0; j < HID; j++) {
        const g = dh2[j], off = j * L;
        for (let i = 0; i < L; i++) dz[i] += W3.w[off + i] * g;
      }
      for (let j = 0; j < L; j++) {
        const g = dz[j], off = j * HID;
        for (let i = 0; i < HID; i++) gW2[off + i] += g * h1[i];
        gb2[j] += g;
      }
      dh1.fill(0);
      for (let j = 0; j < L; j++) {
        const g = dz[j], off = j * HID;
        for (let i = 0; i < HID; i++) dh1[i] += W2.w[off + i] * g;
      }
      for (let i = 0; i < HID; i++) dh1[i] *= 1 - h1[i] * h1[i];
      for (let j = 0; j < HID; j++) {
        const g = dh1[j], off = j * D;
        if (g === 0) continue;
        for (let i = 0; i < D; i++) gW1[off + i] += g * x[i];
        gb1[j] += g;
      }
    }
    adamT++;
    adam(W1, gW1); adam(b1, gb1); adam(W2, gW2); adam(b2, gb2);
    adam(W3, gW3); adam(b3, gb3); adam(W4, gW4); adam(b4, gb4);
    state.steps++;
  }

  const LR = 0.005, B1 = 0.9, B2 = 0.999;
  function adam(p: P, g: Float64Array) {
    const c1 = 1 - Math.pow(B1, adamT), c2 = 1 - Math.pow(B2, adamT);
    for (let i = 0; i < p.n; i++) {
      p.m[i] = B1 * p.m[i] + (1 - B1) * g[i];
      p.v[i] = B2 * p.v[i] + (1 - B2) * g[i] * g[i];
      p.w[i] -= (LR * (p.m[i] / c1)) / (Math.sqrt(p.v[i] / c2) + 1e-8);
    }
  }

  function measure() {
    let s = 0, n = 0;
    for (let m = 0; m < M; m += 6) {
      forward(X[m]);
      for (let i = 0; i < D; i++) s += (xhat[i] - X[m][i]) ** 2;
      n++;
    }
    return s / (n * D);
  }

  let codes: number[][] = [];
  function encodeAll() {
    codes = [];
    for (let m = 0; m < SHOWN; m++) {
      encode(X[m]);
      codes.push(Array.from(zlat.slice(0, state.lat)));
    }
  }

  // --- layout ----------------------------------------------------------------
  const IN = { x: 66, y: 134, s: 172 };
  const OUT = { x: 66, y: 372, s: 172 };
  const MAP = { x: 306, y: 116, w: 386, h: 420 };
  const DEC = { x: 748, y: 176, s: 224 };

  const grey = (v: number) => {
    const g = Math.round(255 * Math.max(0, Math.min(1, v)));
    return `rgb(${g},${g},${g})`;
  };

  function image(x: number, y: number, s: number, data: ArrayLike<number>, title: string) {
    const c = s / IMG;
    for (let py = 0; py < IMG; py++)
      for (let px = 0; px < IMG; px++) {
        ctx.fillStyle = grey(data[py * IMG + px]);
        ctx.fillRect(x + px * c, y + py * c, c + 0.5, c + 0.5);
      }
    ctx.strokeStyle = ink(0.18);
    ctx.lineWidth = 1;
    ctx.strokeRect(x, y, s, s);
    label(title, x, y - 14, 0.55, 'left', 13);
  }

  function nearest() {
    let bi = 0, bd = Infinity;
    for (let m = 0; m < codes.length; m++) {
      let d = 0;
      for (let i = 0; i < state.lat; i++) d += (codes[m][i] - state.drag[i]) ** 2;
      if (d < bd) { bd = d; bi = m; }
    }
    return bi;
  }

  let bounds = { x0: -1, x1: 1, y0: -1, y1: 1 };
  function latentMap() {
    label('the gap', MAP.x, MAP.y - 32, 0.55, 'left', 13);
    label(
      state.lat === 1 ? 'one number, so every picture is on a line' : `${state.lat} numbers, the first two drawn`,
      MAP.x,
      MAP.y - 14,
      0.32,
      'left',
      11
    );
    ctx.strokeStyle = ink(0.12);
    ctx.lineWidth = 1;
    ctx.strokeRect(MAP.x, MAP.y, MAP.w, MAP.h);
    if (!codes.length) return;
    let x0 = Infinity, x1 = -Infinity, y0 = Infinity, y1 = -Infinity;
    for (const c of codes) {
      x0 = Math.min(x0, c[0]); x1 = Math.max(x1, c[0]);
      const b = state.lat > 1 ? c[1] : 0;
      y0 = Math.min(y0, b); y1 = Math.max(y1, b);
    }
    const padx = (x1 - x0) * 0.14 + 0.05, pady = (y1 - y0) * 0.14 + 0.05;
    bounds = { x0: x0 - padx, x1: x1 + padx, y0: y0 - pady, y1: y1 + pady };
    const sx = (v: number) => MAP.x + ((v - bounds.x0) / (bounds.x1 - bounds.x0)) * MAP.w;
    const sy = (v: number) => MAP.y + MAP.h - ((v - bounds.y0) / (bounds.y1 - bounds.y0)) * MAP.h;

    for (let m = 0; m < codes.length; m++) {
      ctx.fillStyle = colourOf(m);
      ctx.globalAlpha = 0.75;
      ctx.beginPath();
      ctx.arc(sx(codes[m][0]), sy(state.lat > 1 ? codes[m][1] : 0), 3.4, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;

    const px = sx(state.drag[0]), py = sy(state.lat > 1 ? state.drag[1] : 0);
    ctx.strokeStyle = PICK;
    ctx.lineWidth = 1.6;
    ctx.beginPath();
    ctx.moveTo(px - 14, py);
    ctx.lineTo(px + 14, py);
    ctx.moveTo(px, py - 14);
    ctx.lineTo(px, py + 14);
    ctx.stroke();
    ctx.fillStyle = PICK;
    ctx.strokeStyle = inv(0.8);
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(px, py, 7, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();

    if (state.data === 'digits') {
      // a compact key, so the colours mean something without a legend row
      let lx = MAP.x + 8;
      for (const d of CLASSES) {
        ctx.fillStyle = PALETTE[d % PALETTE.length];
        ctx.beginPath();
        ctx.arc(lx + 4, MAP.y + MAP.h - 14, 4, 0, Math.PI * 2);
        ctx.fill();
        label(String(d), lx + 12, MAP.y + MAP.h - 10, 0.6, 'left', 11);
        lx += 30;
      }
    }
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    const m = codes.length ? nearest() : 0;
    forward(X[m]);
    image(IN.x, IN.y, IN.s, X[m], 'goes in');
    image(OUT.x, OUT.y, OUT.s, xhat, 'comes back');

    label(`${D} → ${state.lat} → ${D}`, OUT.x, OUT.y + OUT.s + 22, 0.5, 'left', 12);

    latentMap();
    decode(state.drag, state.lat);
    image(DEC.x, DEC.y, DEC.s, xhat, 'decoded from your point');
    label('including the empty space', DEC.x, DEC.y + DEC.s + 22, 0.32, 'left', 11);

    const err = lastErr;
    setEq({
      rule: [['z = f(x)', PICK], '\\quad', ['\\hat x = g(z)', DOT], '\\qquad', ['\\min \\lVert x - g(f(x))\\rVert^2', ERR]],
      live: [`\\dim x = ${D}`, [`\\quad \\dim z = ${state.lat}`, PICK], [`\\quad \\text{error} = ${err.toFixed(5)}`, ERR], `\\quad ${state.steps}\\text{ steps}`],
    });
    setRows({
      'r-err': err.toFixed(5),
      'r-steps': String(state.steps),
      'r-comp': `${D} → ${state.lat}, ${(D / state.lat).toFixed(0)}×`,
      'r-best1': best[1] ? best[1].toFixed(5) : '—',
      'r-best2': best[2] ? best[2].toFixed(5) : '—',
      'r-best3': best[3] ? best[3].toFixed(5) : '—',
    });
    setResult({
      value: err.toFixed(5),
      colour: state.lat === 1 ? ERR : DOT,
      status: `${D} numbers through a gap of ${state.lat}, a factor of ${(D / state.lat).toFixed(0)} · ${state.steps} training steps`,
      note:
        state.steps < 500
          ? 'Still training. Watch the map: the points start as noise and sort themselves into groups as the network finds what the pictures have in common.'
          : state.lat === 1
            ? 'One number is a line, and a line has nowhere to put pictures that differ in more than one way, so the reconstructions blur into an average.'
            : state.data === 'blobs'
              ? 'Only the position of the blob ever changed, so two numbers are exactly enough and a third buys nothing at all.'
              : 'Nothing asked for this arrangement. Rebuilding a picture from two numbers is only possible if similar pictures are given nearby numbers.',
    });
  }

  // --- interaction -----------------------------------------------------------
  let dragging = false;
  function setDrag(e: PointerEvent) {
    const r = canvas.getBoundingClientRect();
    const x = ((e.clientX - r.left) / r.width) * W;
    const y = ((e.clientY - r.top) / r.height) * H;
    state.drag[0] = bounds.x0 + ((x - MAP.x) / MAP.w) * (bounds.x1 - bounds.x0);
    if (state.lat > 1) state.drag[1] = bounds.y0 + ((MAP.y + MAP.h - y) / MAP.h) * (bounds.y1 - bounds.y0);
  }
  canvas.addEventListener('pointerdown', (e) => {
    const r = canvas.getBoundingClientRect();
    const x = ((e.clientX - r.left) / r.width) * W;
    const y = ((e.clientY - r.top) / r.height) * H;
    if (x < MAP.x || x > MAP.x + MAP.w || y < MAP.y || y > MAP.y + MAP.h) return;
    dragging = true;
    try { canvas.setPointerCapture(e.pointerId); } catch { /* synthetic pointers need no capture */ }
    setDrag(e);
  });
  canvas.addEventListener('pointermove', (e) => { if (dragging) setDrag(e); });
  const drop = () => (dragging = false);
  canvas.addEventListener('pointerup', drop);
  canvas.addEventListener('pointercancel', drop);

  // --- the loop --------------------------------------------------------------
  let frames = 0, lastErr = 1;
  function frame() {
    if (state.running) {
      for (let i = 0; i < 30; i++) trainStep();
      if (frames % 10 === 0) {
        lastErr = measure();
        if (state.steps > 800 && (best[state.lat] === undefined || lastErr < best[state.lat])) best[state.lat] = lastErr;
        encodeAll();
      }
    }
    frames++;
    draw();
    requestAnimationFrame(frame);
  }

  function restart() {
    state.drag = [0, 0, 0, 0];
    makeData();
    initNet();
    encodeAll();
    lastErr = measure();
  }

  slider('lat', (v) => { state.lat = v; restart(); });
  segmented('data', (d) => { state.data = d; restart(); });
  transport({ onRun: (running) => (state.running = running), onReset: () => restart() });

  restart();
  requestAnimationFrame(frame);
</script>

<style>
  #ae {
    cursor: crosshair;
    touch-action: none;
  }
</style>
