---
import SimLayout from '../../../layouts/SimLayout.astro';
---

<SimLayout
  areaSlug="deep-learning"
  title="How Layers Bend Space"
  description="A classifier can only ever draw a straight line. Everything else a network does is bending the space until a straight line is enough. Here every hidden layer is 2 or 3 units wide, so the space it produces can still be drawn: train on XOR, rings or spirals, step through the layers to watch the grid stretch and fold, and switch to 3 units to watch a problem that could not be solved in a plane fall apart in one step."
>
  <div class="sim" id="wrap">
    <div class="sim-stage">
      <canvas id="nn" width="1000" height="748"></canvas>
    </div>

    <div class="sim-panel">
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <button class="btn" id="run">Pause</button>
        <button class="btn ghost" id="step">+200 steps</button>
        <button class="btn ghost" id="reset">New weights</button>
      </div>

      <div class="control">
        <label>Step <b id="stepname">Linear 1</b></label>
        <input type="range" id="within" min="0" max="100" value="0" />
        <label class="sub">how far through this one step <b id="withinval">0%</b></label>
      </div>

      <div class="control">
        <label>Whole network <b id="posval">input</b></label>
        <input type="range" id="pos" min="0" max="700" value="0" />
        <div class="row-controls">
          <button class="btn ghost" id="sweep">Sweep through</button>
        </div>
      </div>

      <div class="control">
        <label>Problem</label>
        <div class="seg" id="problem">
          <button data-p="xor" class="active">XOR</button>
          <button data-p="blobs">Blobs</button>
          <button data-p="circles">Rings</button>
          <button data-p="island">Island</button>
          <button data-p="onion">Onion</button>
          <button data-p="moons">Moons</button>
          <button data-p="spiral">Spiral</button>
          <button data-p="stripes">Stripes</button>
        </div>
      </div>

      <div class="control">
        <label>Units per layer</label>
        <div class="seg" id="width">
          <button data-w="2" class="active">2 · a plane</button>
          <button data-w="3">3 · a volume</button>
        </div>
      </div>

      <div class="control">
        <label>Hidden layers <b id="lval">3</b></label>
        <input type="range" id="L" min="1" max="4" value="3" />
      </div>

      <div class="control">
        <label>Activation of each layer</label>
        <div class="acts" id="acts">
          <div class="actrow" data-i="0">
            <span>layer 1</span>
            <select id="act0">
              <option value="tanh" selected>tanh</option>
              <option value="leaky">leaky relu</option>
              <option value="relu">relu</option>
              <option value="sigmoid">sigmoid</option>
              <option value="linear">linear</option>
            </select>
          </div>
          <div class="actrow" data-i="1">
            <span>layer 2</span>
            <select id="act1">
              <option value="tanh" selected>tanh</option>
              <option value="leaky">leaky relu</option>
              <option value="relu">relu</option>
              <option value="sigmoid">sigmoid</option>
              <option value="linear">linear</option>
            </select>
          </div>
          <div class="actrow" data-i="2">
            <span>layer 3</span>
            <select id="act2">
              <option value="tanh" selected>tanh</option>
              <option value="leaky">leaky relu</option>
              <option value="relu">relu</option>
              <option value="sigmoid">sigmoid</option>
              <option value="linear">linear</option>
            </select>
          </div>
          <div class="actrow" data-i="3">
            <span>layer 4</span>
            <select id="act3">
              <option value="tanh" selected>tanh</option>
              <option value="leaky">leaky relu</option>
              <option value="relu">relu</option>
              <option value="sigmoid">sigmoid</option>
              <option value="linear">linear</option>
            </select>
          </div>
        </div>
      </div>

      <div class="control">
        <label>Learning rate <b id="lrval">0.030</b></label>
        <input type="range" id="lr" min="1" max="100" value="30" />
      </div>

      <div class="readout">
        <div class="row"><span>Showing</span><b id="rstage">input space</b></div>
        <div class="row"><span>Steps</span><b id="rstep">0</b></div>
        <div class="row"><span>Loss</span><b id="rloss">—</b></div>
        <div class="row"><span>Accuracy</span><b id="racc">—</b></div>
        <div class="row"><span>Weights</span><b id="rparams">—</b></div>
      </div>

      <p style="font-size:.82rem;color:var(--text-faint);margin:0;line-height:1.5">
        Click any panel in the top row to see the space as that step leaves it.
        The colours are the network's own answer, carried along by the grid. At
        3 units the spaces are volumes: drag the big panel to turn them, as far
        as you like, in any direction.
      </p>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Start on <b>XOR</b> and let it train. The top row is the whole pipeline,
      one panel per step: the input, then a <b>Linear</b> and an
      <b>Activation</b> for each layer, then the <b>Classifier</b>. The only
      thing the classifier ever draws is a straight line; every panel before it
      is the work done to make that line sufficient.
    </li>
    <li>
      Click back to <b>input space</b>. The same boundary is now a curve, because
      you are seeing it through all the bending in reverse. A network does not
      learn curved boundaries, it learns a change of coordinates in which the
      boundary is straight.
    </li>
    <li>
      Stop on any panel marked <b>Linear</b>. The grid there is still a perfect
      grid: rotated, stretched, sheared, slid sideways, but every line still
      straight and every pair of parallels still parallel. That is the entire
      contribution of the matrix, and it is why stacking matrices alone gets you
      nowhere.
    </li>
    <li>
      Now step forward into the <b>Activation</b> that follows it, and watch the
      straight lines finally bend. Press <b>Sweep through</b> to run the whole
      network as one continuous motion and the rhythm is unmistakable: rigid,
      bend, rigid, bend, until one line is enough.
    </li>
    <li>
      Pick a step and drag <b>how far through this one step</b> slowly. Halfway
      through a <b>Linear</b> step the space is exactly halfway there, because
      the average of two matrices is another matrix. Halfway through an
      <b>Activation</b> it is not, and that is the difference in one sentence.
    </li>
    <li>
      Try <b>Blobs</b>. The classes are already separable, so the layers barely
      move and the grid stays almost square. The amount of bending a network does
      is not a setting, it is whatever the problem demands.
    </li>
    <li>
      Try <b>Rings</b> with everything on <b>tanh</b>. It climbs to about 90%
      and then stops, and leaving it running all afternoon will not help. Every
      tanh layer is <b>reversible</b>: it bends the plane but never glues two
      places together. The region the classifier claims is therefore always the
      bent image of a half-plane, which runs off to infinity and can never be a
      bounded blob. It cannot surround the inner ring without also cutting
      through the outer one.
    </li>
    <li>
      Switch those layers to <b>leaky relu</b> and give it a few thousand steps.
      It usually does reach 100%, sometimes only after a restart. The grid shows
      why: a relu-family activation puts a hard <b>crease</b> in the plane and
      squashes one side of it by tenfold, and a ring flattened onto its own
      crease can be threaded by a straight line, slipping between the sampled
      points where the smooth warp could not.
    </li>
    <li>
      Now the honest answer to why Rings is hard. Put it back on <b>tanh</b>,
      where it was stuck around 94%, and switch to <b>3 units</b>. It closes at
      100%, on the first try, with a <b>single</b> hidden layer. Drag the big
      panel to orbit: the layer lifted one ring out of the plane and a flat
      plane slides between them. Nothing had to be folded, there was simply
      somewhere else to go.
    </li>
    <li>
      That is what width buys, and it is not subtle. On Rings, 2 units reach
      100% in about 1 run in 12; 3 units reach it in 12 out of 12. On XOR it is
      4 in 10 against 10 in 10. Depth bends the space, width decides how much
      room there is to bend it in.
    </li>
    <li>
      <b>Island</b> and <b>Onion</b> are the same trap in different clothes: a
      filled island in a sea, and three nested rings. Each needs the winning
      region to be a closed blob, and a reversible warp of a plane cannot make
      one. Onion is the sharpest of the three, and worth doing in this order:
      at 2 units it hovers around 70%, at 3 units it jumps to about 98%.
    </li>
    <li>
      None of this is the network memorising the dots. Trained on 240 points and
      then asked about 2400 fresh ones from the same shape, the 2-unit runs hold
      their plateau (Rings 87%, Onion 65%) and the 3-unit runs keep their answer
      (Rings 100%, Onion 90%). The extra dimension buys a real boundary, not a
      thread stitched between the samples.
    </li>
    <li>
      Plain <b>relu</b> is worth trying precisely because it is the shakiest of
      the three here. With only two units, one of them can land where its input
      is negative for every single point: it outputs a flat zero, its gradient is
      a flat zero, and it never comes back. Half the space collapses onto a line
      and the run is over before it started. That is a dead unit, seen from the
      inside, and it is why leaky relu exists.
    </li>
    <li>
      Set every activation to <b>linear</b>. However many layers you stack, the
      grid stays a grid: a chain of linear maps is one linear map, so the
      boundary is stuck being straight and XOR stalls in the sixties, which is
      all a straight line can do on it. The squashing is not a detail, it is the
      entire source of a network's power.
    </li>
    <li>
      Try <b>Spiral</b>, the one that stays hard. Two units plateau in the
      seventies; three units get to about 92% and still rarely close it. A
      spiral needs to be unwound, not just lifted, and that takes more room than
      three dimensions. Real networks use hundreds of units per layer for
      exactly this reason, which is also why they can no longer be drawn.
    </li>
    <li>
      Press <b>New weights</b> a few times on the same problem. Sometimes it
      finds the fold in a second, sometimes it never does. At this width the
      starting point genuinely decides the outcome, which is why real training
      runs are restarted and why width buys reliability, not just capacity.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas } from '../../../lib/sim';
  import { equationBar } from '../../../lib/equation';

  // ---------------------------------------------------------------------------
  // A small MLP, trained in the page, whose hidden layers are all 2 units wide
  // so that the space each one produces can be drawn. A grid of the input plane
  // is pushed through the same layers as the data, which is what makes the
  // stretching and folding visible.
  // ---------------------------------------------------------------------------

  type Act = 'tanh' | 'leaky' | 'relu' | 'sigmoid' | 'linear';
  const act = (a: Act, z: number) =>
    a === 'tanh' ? Math.tanh(z)
    : a === 'relu' ? Math.max(0, z)
    : a === 'leaky' ? (z > 0 ? z : 0.1 * z)
    : a === 'sigmoid' ? 1 / (1 + Math.exp(-z))
    : z;
  /** Derivative, given both the pre-activation and what came out of it. */
  const dact = (a: Act, z: number, h: number) =>
    a === 'tanh' ? 1 - h * h
    : a === 'relu' ? (z > 0 ? 1 : 0)
    : a === 'leaky' ? (z > 0 ? 1 : 0.1)
    : a === 'sigmoid' ? h * (1 - h)
    : 1;

  type Layer = {
    nIn: number;
    nOut: number;
    /** row-major, nOut rows of nIn */
    W: number[];
    b: number[];
    a: Act;
    mW: number[]; vW: number[]; mb: number[]; vb: number[];
  };
  type Net = {
    hidden: Layer[];
    out: { nIn: number; W: number[]; b: number[]; mW: number[]; vW: number[]; mb: number[]; vb: number[] };
    t: number;
  };

  const randn = () => {
    let u = 0, v = 0;
    while (!u) u = Math.random();
    while (!v) v = Math.random();
    return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
  };
  const zeros = (n: number) => new Array(n).fill(0);

  function makeLayer(nIn: number, nOut: number, a: Act): Layer {
    const crease = a === 'relu' || a === 'leaky';
    // kept a little livelier than He, since these layers are very narrow
    const gain = (crease ? 2 : 1.55) / Math.sqrt(nIn);
    return {
      nIn,
      nOut,
      W: Array.from({ length: nOut * nIn }, () => randn() * gain),
      // a nudge off zero, which buys plain relu a few less dead units
      b: zeros(nOut).map(() => (a === 'relu' ? 0.05 : 0)),
      a,
      mW: zeros(nOut * nIn), vW: zeros(nOut * nIn), mb: zeros(nOut), vb: zeros(nOut),
    };
  }
  function makeNet(acts: Act[], width: number): Net {
    // the input is always the 2D plane; every hidden layer after the first is
    // square, so the space it makes is the same one the previous layer made
    const hidden = acts.map((a, i) => makeLayer(i === 0 ? 2 : width, width, a));
    return {
      hidden,
      out: {
        nIn: width,
        W: Array.from({ length: width }, () => (randn() * 1.13) / Math.sqrt(width)),
        b: [0],
        mW: zeros(width), vW: zeros(width), mb: zeros(1), vb: zeros(1),
      },
      t: 0,
    };
  }
  const paramCount = () =>
    net.hidden.reduce((n, l) => n + l.nOut * l.nIn + l.nOut, 0) + net.out.nIn + 1;

  // --- data ---------------------------------------------------------------------

  type Pt = { x: number; y: number; c: 0 | 1 };
  const PROBLEMS = [
    'xor', 'blobs', 'circles', 'island', 'onion', 'moons', 'spiral', 'stripes',
  ] as const;
  type Problem = (typeof PROBLEMS)[number];

  function makeData(kind: Problem, n = 240): Pt[] {
    const out: Pt[] = [];
    const jitter = (s: number) => randn() * s;
    while (out.length < n) {
      const i = out.length;
      if (kind === 'blobs') {
        const c = (i % 2) as 0 | 1;
        const sx = c ? 0.85 : -0.85, sy = c ? 0.55 : -0.55;
        out.push({ x: sx + jitter(0.32), y: sy + jitter(0.32), c });
      } else if (kind === 'xor') {
        const x = (Math.random() * 2 - 1) * 1.3, y = (Math.random() * 2 - 1) * 1.3;
        if (Math.abs(x) < 0.16 || Math.abs(y) < 0.16) continue; // keep a margin
        out.push({ x, y, c: (x > 0) === (y > 0) ? 1 : 0 });
      } else if (kind === 'island') {
        // a filled island in a sea: the winning region has to be bounded, and
        // no reversible warp of a plane can make a bounded region
        const want = i % 2;
        const x = (Math.random() * 2 - 1) * 1.45, y = (Math.random() * 2 - 1) * 1.45;
        const r = Math.hypot(x, y);
        if (r > 0.5 && r < 0.78) continue; // a margin, so the edge is not a guess
        const c = (r <= 0.5 ? 1 : 0) as 0 | 1;
        if (c !== want) continue;
        out.push({ x, y, c });
      } else if (kind === 'onion') {
        // three nested rings: now two boundaries have to be closed curves
        const want = i % 2;
        const band = Math.floor(Math.random() * 3);
        const c = (band % 2 === 0 ? 1 : 0) as 0 | 1;
        if (c !== want) continue;
        const r = [0.35, 0.85, 1.35][band] + jitter(0.09);
        const t = Math.random() * Math.PI * 2;
        out.push({ x: r * Math.cos(t), y: r * Math.sin(t), c });
      } else if (kind === 'circles') {
        const c = (i % 2) as 0 | 1;
        const r = (c ? 1.15 : 0.4) + jitter(0.1);
        const t = Math.random() * Math.PI * 2;
        out.push({ x: r * Math.cos(t), y: r * Math.sin(t), c });
      } else if (kind === 'moons') {
        const c = (i % 2) as 0 | 1;
        const t = Math.random() * Math.PI;
        const x = Math.cos(t), y = Math.sin(t);
        out.push(
          c
            ? { x: x * 1.05 + 0.5, y: -y * 1.05 + 0.35, c }
            : { x: x * 1.05 - 0.5, y: y * 1.05 - 0.35, c }
        );
      } else if (kind === 'spiral') {
        const c = (i % 2) as 0 | 1;
        const t = Math.random();
        const r = 0.18 + 1.15 * t;
        const th = t * 2.6 * Math.PI + c * Math.PI;
        out.push({ x: r * Math.cos(th) + jitter(0.04), y: r * Math.sin(th) + jitter(0.04), c });
      } else {
        const x = (Math.random() * 2 - 1) * 1.4, y = (Math.random() * 2 - 1) * 1.3;
        const band = Math.floor((x + 1.4) / 0.7);
        if (Math.abs(((x + 1.4) % 0.7) - 0.35) > 0.29) continue; // keep the bands apart
        out.push({ x, y, c: (band % 2) as 0 | 1 });
      }
    }
    return out;
  }

  // --- state ----------------------------------------------------------------------

  const GN = 25;      // grid vertices per side
  const EXT = 2.1;    // how far the drawn grid reaches in input space

  const state = {
    problem: 'xor' as Problem,
    acts: ['tanh', 'tanh', 'tanh', 'tanh'] as Act[],
    L: 3,
    /** units per hidden layer: 2 keeps every space a plane, 3 gives it room */
    width: 2,
    lr: 0.03,
    running: true,
    /** continuous position over the stages; 0 is the raw input */
    pos: 0,
    /** which step (1..last) the "inside this step" slider drives */
    step: 1,
    sweeping: false,
    steps: 0,
    loss: NaN,
    acc: 0,
  };
  const spatial = () => state.width === 3;

  /**
   * The camera as a rotation matrix rather than a pair of angles. Angles have
   * to be clamped somewhere near straight up, or they fold back on themselves;
   * composing small rotations instead lets the scene be turned any way at all,
   * for as long as you keep dragging. Rows are right, up and away.
   */
  const cam = { R: [1, 0, 0, 0, 1, 0, 0, 0, 1], auto: true, touched: false };
  function camFromAngles(yaw: number, pitch: number) {
    const cy = Math.cos(yaw), sy = Math.sin(yaw), cp = Math.cos(pitch), sp = Math.sin(pitch);
    cam.R = [
      cy, sy, 0,
      sy * sp, -cy * sp, cp,
      -sy * cp, cy * cp, sp,
    ];
  }
  camFromAngles(0.62, 0.5);

  const mat3 = (A: number[], B: number[]) => {
    const C = new Array<number>(9);
    for (let i = 0; i < 3; i++)
      for (let j = 0; j < 3; j++)
        C[i * 3 + j] = A[i * 3] * B[j] + A[i * 3 + 1] * B[3 + j] + A[i * 3 + 2] * B[6 + j];
    return C;
  };
  /** Gram-Schmidt, so thousands of composed turns cannot drift out of shape. */
  function orthonormalize(R: number[]) {
    const row = (i: number) => R.slice(i * 3, i * 3 + 3);
    const dot3 = (a: number[], b: number[]) => a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
    const norm = (a: number[]) => {
      const n = Math.hypot(a[0], a[1], a[2]) || 1;
      return a.map((v) => v / n);
    };
    const r0 = norm(row(0));
    let r1 = row(1);
    const d = dot3(r1, r0);
    r1 = norm(r1.map((v, i) => v - d * r0[i]));
    const r2 = [
      r0[1] * r1[2] - r0[2] * r1[1],
      r0[2] * r1[0] - r0[0] * r1[2],
      r0[0] * r1[1] - r0[1] * r1[0],
    ];
    return [...r0, ...r1, ...r2];
  }
  /** Turn the scene by a drag, in the camera's own frame: no pole to hit. */
  function turn(dx: number, dy: number) {
    const t = dx, f = dy;
    const ct = Math.cos(t), st = Math.sin(t), cf = Math.cos(f), sf = Math.sin(f);
    const Ry = [ct, 0, -st, 0, 1, 0, st, 0, ct];
    const Rx = [1, 0, 0, 0, cf, sf, 0, -sf, cf];
    cam.R = orthonormalize(mat3(Rx, mat3(Ry, cam.R)));
  }
  /** The idle drift, about the world's own vertical. */
  function drift(t: number) {
    const c = Math.cos(t), s = Math.sin(t);
    cam.R = orthonormalize(mat3(cam.R, [c, s, 0, -s, c, 0, 0, 0, 1]));
  }

  let data = makeData(state.problem);
  let net = makeNet(state.acts.slice(0, state.L), state.width);
  const history: number[] = [];

  /** Every stage of the forward pass, for one point. */
  function forwardAll(x0: number, y0: number) {
    const hs: number[][] = [[x0, y0]];
    const zs: number[][] = [];
    for (const l of net.hidden) {
      const h = hs[hs.length - 1];
      const z = new Array<number>(l.nOut);
      for (let i = 0; i < l.nOut; i++) {
        let sum = l.b[i];
        for (let j = 0; j < l.nIn; j++) sum += l.W[i * l.nIn + j] * h[j];
        z[i] = sum;
      }
      zs.push(z);
      hs.push(z.map((v) => act(l.a, v)));
    }
    const hL = hs[hs.length - 1];
    let o = net.out.b[0];
    for (let j = 0; j < net.out.nIn; j++) o += net.out.W[j] * hL[j];
    return { hs, zs, p: 1 / (1 + Math.exp(-o)) };
  }

  function adam(p: number[], g: number[], m: number[], v: number[], lr: number, t: number) {
    const b1t = 1 - Math.pow(0.9, t), b2t = 1 - Math.pow(0.999, t);
    for (let i = 0; i < p.length; i++) {
      m[i] = 0.9 * m[i] + 0.1 * g[i];
      v[i] = 0.999 * v[i] + 0.001 * g[i] * g[i];
      p[i] -= (lr * (m[i] / b1t)) / (Math.sqrt(v[i] / b2t) + 1e-8);
    }
  }

  /** One full-batch step of Adam on the binary cross-entropy. */
  function trainStep() {
    const n = data.length;
    const gW = net.hidden.map((l) => zeros(l.nOut * l.nIn));
    const gb = net.hidden.map((l) => zeros(l.nOut));
    const goW = zeros(net.out.nIn);
    const gob = zeros(1);
    let loss = 0, correct = 0;

    for (const pt of data) {
      const { hs, zs, p } = forwardAll(pt.x, pt.y);
      const y = pt.c;
      loss += -(y * Math.log(p + 1e-9) + (1 - y) * Math.log(1 - p + 1e-9));
      if ((p >= 0.5 ? 1 : 0) === y) correct++;

      // sigmoid + cross-entropy collapse to this one line
      const dO = (p - y) / n;
      const hL = hs[hs.length - 1];
      let dh = new Array<number>(net.out.nIn);
      for (let j = 0; j < net.out.nIn; j++) {
        goW[j] += dO * hL[j];
        dh[j] = net.out.W[j] * dO;
      }
      gob[0] += dO;

      for (let l = net.hidden.length - 1; l >= 0; l--) {
        const L = net.hidden[l], z = zs[l], h = hs[l + 1], hin = hs[l];
        const dz = new Array<number>(L.nOut);
        for (let i = 0; i < L.nOut; i++) dz[i] = dh[i] * dact(L.a, z[i], h[i]);
        for (let i = 0; i < L.nOut; i++) {
          for (let j = 0; j < L.nIn; j++) gW[l][i * L.nIn + j] += dz[i] * hin[j];
          gb[l][i] += dz[i];
        }
        const next = new Array<number>(L.nIn).fill(0);
        for (let j = 0; j < L.nIn; j++)
          for (let i = 0; i < L.nOut; i++) next[j] += L.W[i * L.nIn + j] * dz[i];
        dh = next;
      }
    }

    net.t++;
    for (let l = 0; l < net.hidden.length; l++) {
      const L = net.hidden[l];
      adam(L.W, gW[l], L.mW, L.vW, state.lr, net.t);
      adam(L.b, gb[l], L.mb, L.vb, state.lr, net.t);
    }
    adam(net.out.W, goW, net.out.mW, net.out.vW, state.lr, net.t);
    adam(net.out.b, gob, net.out.mb, net.out.vb, state.lr, net.t);

    state.steps++;
    state.loss = loss / n;
    state.acc = correct / n;
    // a diverging run is worse than a restart, and it can only come from the
    // learning rate being pushed too high
    if (!isFinite(state.loss)) rebuild(false);
  }

  // --- everything the drawing needs, recomputed each frame ---------------------------

  const gridPts: { x: number; y: number }[] = [];
  for (let i = 0; i < GN; i++)
    for (let j = 0; j < GN; j++)
      gridPts.push({ x: -EXT + (2 * EXT * j) / (GN - 1), y: EXT - (2 * EXT * i) / (GN - 1) });

  // Three coordinates are stored for every point at every stage, whatever the
  // width: with two units the third is simply always zero, which is exactly
  // what "the space is a plane" means.
  let gridStage: Float64Array[] = [];
  let dataStage: Float64Array[] = [];
  let gridPred = new Float64Array(0);
  type View = { cx: number; cy: number; cz: number; half: number };
  let views: View[] = [];
  const nStages = () => 2 * state.L + 2;
  type Kind = 'input' | 'linear' | 'act' | 'class';
  const kindOf = (k: number): Kind =>
    k === 0 ? 'input' : k > 2 * state.L ? 'class' : k % 2 === 1 ? 'linear' : 'act';
  const layerOf = (k: number) => Math.min(state.L, Math.ceil(k / 2));

  function ensureBuffers() {
    const S = nStages(), ng = gridPts.length * 3, nd = data.length * 3;
    if (gridStage.length !== S || gridStage[0]?.length !== ng)
      gridStage = Array.from({ length: S }, () => new Float64Array(ng));
    if (dataStage.length !== S || dataStage[0]?.length !== nd)
      dataStage = Array.from({ length: S }, () => new Float64Array(nd));
    if (gridPred.length !== gridPts.length) gridPred = new Float64Array(gridPts.length);
  }

  /** Push one input point through every stage, writing straight into `buf`. */
  function pushThrough(x0: number, y0: number, buf: Float64Array[], i: number) {
    const h = [x0, y0, 0];
    const z = [0, 0, 0];
    buf[0][3 * i] = x0;
    buf[0][3 * i + 1] = y0;
    buf[0][3 * i + 2] = 0;
    for (let l = 0; l < state.L; l++) {
      const L = net.hidden[l];
      for (let o = 0; o < L.nOut; o++) {
        let sum = L.b[o];
        for (let j = 0; j < L.nIn; j++) sum += L.W[o * L.nIn + j] * h[j];
        z[o] = sum;
      }
      for (let o = L.nOut; o < 3; o++) z[o] = 0;
      const s1 = buf[2 * l + 1], s2 = buf[2 * l + 2];
      for (let o = 0; o < 3; o++) {
        s1[3 * i + o] = z[o];
        h[o] = o < L.nOut ? act(L.a, z[o]) : 0;
        s2[3 * i + o] = h[o];
      }
    }
    let out = net.out.b[0];
    for (let j = 0; j < net.out.nIn; j++) out += net.out.W[j] * h[j];
    return 1 / (1 + Math.exp(-out));
  }

  function propagate() {
    ensureBuffers();
    const S = nStages();
    for (let i = 0; i < gridPts.length; i++)
      gridPred[i] = pushThrough(gridPts[i].x, gridPts[i].y, gridStage, i);
    for (let i = 0; i < data.length; i++) pushThrough(data[i].x, data[i].y, dataStage, i);

    // the classifier does not move anything, it only draws its boundary in the
    // space the last activation left behind
    gridStage[S - 1].set(gridStage[S - 2]);
    dataStage[S - 1].set(dataStage[S - 2]);

    // each stage is framed on its own data, eased so training does not jump
    for (let k = 0; k < S; k++) {
      const d = dataStage[k];
      const lo = [Infinity, Infinity, Infinity], hi = [-Infinity, -Infinity, -Infinity];
      for (let i = 0; i < data.length; i++) {
        for (let c = 0; c < 3; c++) {
          const v = d[3 * i + c];
          if (v < lo[c]) lo[c] = v;
          if (v > hi[c]) hi[c] = v;
        }
      }
      const want: View = {
        cx: (lo[0] + hi[0]) / 2,
        cy: (lo[1] + hi[1]) / 2,
        cz: (lo[2] + hi[2]) / 2,
        half: Math.max(
          0.25,
          (Math.max(hi[0] - lo[0], hi[1] - lo[1], hi[2] - lo[2]) / 2) * 1.3
        ),
      };
      const v = views[k];
      const ease = (a: number, b: number) => a + (b - a) * 0.12;
      views[k] = v
        ? {
            cx: ease(v.cx, want.cx),
            cy: ease(v.cy, want.cy),
            cz: ease(v.cz, want.cz),
            half: ease(v.half, want.half),
          }
        : want;
    }
    views.length = S;
  }

  /**
   * The scene at a fractional position: halfway between two stages every point
   * is halfway along its path, which for the linear half is exactly the matrix
   * (1-t)I + tW acting on the space.
   */
  const gridNow = new Float64Array(GN * GN * 3);
  let dataNow = new Float64Array(0);
  function snapshot(src: Float64Array[], pos: number, out: Float64Array) {
    const k = Math.max(0, Math.min(src.length - 1, Math.floor(pos)));
    const t = Math.min(1, Math.max(0, pos - k));
    const a = src[k];
    if (t < 1e-6 || k + 1 >= src.length) {
      out.set(a);
      return;
    }
    const b = src[k + 1];
    for (let i = 0; i < out.length; i++) out[i] = a[i] + (b[i] - a[i]) * t;
  }
  /** The framing for a fractional position, interpolated the same way. */
  function viewAt(pos: number): View {
    const k = Math.max(0, Math.min(views.length - 1, Math.floor(pos)));
    const t = Math.min(1, Math.max(0, pos - k));
    const a = views[k] ?? { cx: 0, cy: 0, cz: 0, half: 1 };
    const b = views[k + 1] ?? a;
    const m = (p: number, q: number) => p + (q - p) * t;
    return { cx: m(a.cx, b.cx), cy: m(a.cy, b.cy), cz: m(a.cz, b.cz), half: m(a.half, b.half) };
  }

  // --- canvas -------------------------------------------------------------------------

  const canvas = document.getElementById('nn') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const cssVar = (n: string) => getComputedStyle(canvas).getPropertyValue(n).trim();
  const inkRGB = () => cssVar('--stage-ink') || '232,233,236';
  const inkA = (a: number) => `rgba(${inkRGB()},${a})`;

  const C0 = [96, 165, 250];  // class 0
  const C1 = [251, 113, 133]; // class 1
  const SEL = '#7c8cff';
  const CUT = '#34d399';      // the classifier's straight line

  const rgba = (c: number[], a: number) => `rgba(${c[0]},${c[1]},${c[2]},${a})`;
  function hexA(hex: string, a: number) {
    const h = hex.replace('#', '');
    const n = parseInt(h.length === 3 ? h.split('').map((c) => c + c).join('') : h, 16);
    return `rgba(${(n >> 16) & 255},${(n >> 8) & 255},${n & 255},${a})`;
  }
  // one string per bucket rather than one per cell, of which there are thousands
  const fillCache = new Map<number, string>();
  function mixed(p: number, a: number) {
    const q = Math.max(0, Math.min(24, Math.round(p * 24)));
    let s = fillCache.get(q);
    if (!s) {
      const t = q / 24;
      s = `rgba(${Math.round(C0[0] + (C1[0] - C0[0]) * t)},${Math.round(
        C0[1] + (C1[1] - C0[1]) * t
      )},${Math.round(C0[2] + (C1[2] - C0[2]) * t)},${a})`;
      fillCache.set(q, s);
    }
    return s;
  }

  const UI = (size: number, weight = 400) =>
    `${weight} ${size}px 'Inter', system-ui, sans-serif`;
  const MONO = (size: number) => `${size}px 'JetBrains Mono', ui-monospace, monospace`;
  function text(
    s: string, x: number, y: number, size: number, col: string,
    align: CanvasTextAlign = 'left', mono = false, weight = 400
  ) {
    ctx.font = mono ? MONO(size) : UI(size, weight);
    ctx.fillStyle = col;
    ctx.textAlign = align;
    ctx.fillText(s, x, y);
    ctx.textAlign = 'left';
  }

  type Box = { x: number; y: number; w: number; h: number };
  function rr(x: number, y: number, w: number, h: number, r: number) {
    const rad = Math.min(r, Math.abs(w) / 2, Math.abs(h) / 2);
    ctx.beginPath();
    ctx.moveTo(x + rad, y);
    ctx.lineTo(x + w - rad, y);
    ctx.quadraticCurveTo(x + w, y, x + w, y + rad);
    ctx.lineTo(x + w, y + h - rad);
    ctx.quadraticCurveTo(x + w, y + h, x + w - rad, y + h);
    ctx.lineTo(x + rad, y + h);
    ctx.quadraticCurveTo(x, y + h, x, y + h - rad);
    ctx.lineTo(x, y + rad);
    ctx.quadraticCurveTo(x, y, x + rad, y);
    ctx.closePath();
  }
  function panel(b: Box, title: string) {
    ctx.strokeStyle = inkA(0.1);
    ctx.lineWidth = 1;
    rr(b.x, b.y, b.w, b.h, 10);
    ctx.stroke();
    text(title, b.x + 2, b.y - 9, 11, inkA(0.5), 'left', true);
  }

  const STRIP: Box = { x: 20, y: 32, w: 960, h: 180 };
  const MAIN: Box = { x: 20, y: 244, w: 480, h: 480 };
  const LOSS: Box = { x: 520, y: 244, w: 460, h: 150 };
  const ARCH: Box = { x: 520, y: 414, w: 460, h: 310 };

  /**
   * Turns a point of the current space into pixels. With two units the space is
   * a plane and this is a plain fit-to-box; with three it is an orbit camera,
   * and `d` (distance from the camera) comes back so quads can be drawn far
   * ones first.
   */
  function mapper(pos: number, b: Box, pad: number) {
    const v = viewAt(pos);
    const side = Math.min(b.w, b.h) - 2 * pad;
    const bx = b.x + b.w / 2, by = b.y + b.h / 2;
    if (!spatial()) {
      const s = side / (2 * v.half);
      return (x: number, y: number, _z: number) => ({
        x: bx + (x - v.cx) * s,
        y: by - (y - v.cy) * s,
        d: 0,
        s: 1,
      });
    }
    const R = cam.R;
    const D = 3.2 * v.half;      // camera distance, in world units
    const f = side * 1.28;       // focal length, in pixels
    return (x: number, y: number, z: number) => {
      const X = x - v.cx, Y = y - v.cy, Z = z - v.cz;
      const right = R[0] * X + R[1] * Y + R[2] * Z;
      const up = R[3] * X + R[4] * Y + R[5] * Z;
      const away = R[6] * X + R[7] * Y + R[8] * Z;
      const depth = Math.max(0.35, D + away);
      const k = f / depth;
      return { x: bx + right * k, y: by - up * k, d: depth, s: D / depth };
    };
  }

  const quadOrder: { i: number; j: number; d: number }[] = [];

  /** The warped grid, as filled cells carrying the network's answer. */
  function drawSpace(pos: number, b: Box, pad: number, step: number, dots: number) {
    if (dataNow.length !== data.length * 3) dataNow = new Float64Array(data.length * 3);
    snapshot(gridStage, pos, gridNow);
    snapshot(dataStage, pos, dataNow);
    const m = mapper(pos, b, pad);
    const P = (i: number) => m(gridNow[3 * i], gridNow[3 * i + 1], gridNow[3 * i + 2]);

    ctx.save();
    rr(b.x + 1, b.y + 1, b.w - 2, b.h - 2, 10);
    ctx.clip();

    // in three dimensions the sheet can pass in front of itself, so the cells
    // are painted from the back forwards
    quadOrder.length = 0;
    for (let i = 0; i + step < GN; i += step)
      for (let j = 0; j + step < GN; j += step) {
        let d = 0;
        if (spatial()) {
          d =
            (P(i * GN + j).d +
              P(i * GN + j + step).d +
              P((i + step) * GN + j + step).d +
              P((i + step) * GN + j).d) / 4;
        }
        quadOrder.push({ i, j, d });
      }
    if (spatial()) quadOrder.sort((p, q) => q.d - p.d);

    for (const { i, j } of quadOrder) {
      const i0 = i * GN + j, i1 = i * GN + j + step;
      const i2 = (i + step) * GN + j + step, i3 = (i + step) * GN + j;
      const a = P(i0), bb = P(i1), c = P(i2), d = P(i3);
      ctx.fillStyle = mixed(
        (gridPred[i0] + gridPred[i1] + gridPred[i2] + gridPred[i3]) / 4,
        spatial() ? 0.6 : 0.4
      );
      ctx.beginPath();
      ctx.moveTo(a.x, a.y);
      ctx.lineTo(bb.x, bb.y);
      ctx.lineTo(c.x, c.y);
      ctx.lineTo(d.x, d.y);
      ctx.closePath();
      ctx.fill();
      if (spatial()) {
        // an edge on every cell, which is what makes the sheet read as a sheet
        ctx.strokeStyle = inkA(0.13);
        ctx.lineWidth = 0.6;
        ctx.stroke();
      }
    }

    if (!spatial()) {
      ctx.strokeStyle = inkA(0.22);
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (let i = 0; i < GN; i += step) {
        for (let j = 0; j < GN; j++) {
          const q = P(i * GN + j);
          if (j === 0) ctx.moveTo(q.x, q.y);
          else ctx.lineTo(q.x, q.y);
        }
      }
      for (let j = 0; j < GN; j += step) {
        for (let i = 0; i < GN; i++) {
          const q = P(i * GN + j);
          if (i === 0) ctx.moveTo(q.x, q.y);
          else ctx.lineTo(q.x, q.y);
        }
      }
      ctx.stroke();
    }

    for (let i = 0; i < data.length; i++) {
      const q = m(dataNow[3 * i], dataNow[3 * i + 1], dataNow[3 * i + 2]);
      ctx.fillStyle = rgba(data[i].c ? C1 : C0, 0.95);
      ctx.beginPath();
      ctx.arc(q.x, q.y, dots * Math.max(0.55, Math.min(1.5, q.s)), 0, Math.PI * 2);
      ctx.fill();
      if (dots > 3) {
        ctx.strokeStyle = 'rgba(13,14,18,0.75)';
        ctx.lineWidth = 1;
        ctx.stroke();
      }
    }

    // what the classifier draws: a line when its space is a plane, a plane when
    // its space is a volume. Both fade in across the classifier's own step.
    const fade = Math.max(0, Math.min(1, pos - (nStages() - 2)));
    if (fade > 0) {
      const v = viewAt(pos);
      const w = net.out.W, bo = net.out.b[0];
      if (!spatial()) {
        const far = v.half * 6;
        const line: number[][] = [];
        if (Math.abs(w[1]) > Math.abs(w[0])) {
          for (const x of [v.cx - far, v.cx + far]) line.push([x, (-bo - w[0] * x) / w[1]]);
        } else if (Math.abs(w[0]) > 1e-9) {
          for (const y of [v.cy - far, v.cy + far]) line.push([(-bo - w[1] * y) / w[0], y]);
        }
        if (line.length === 2) {
          const p1 = m(line[0][0], line[0][1], 0), p2 = m(line[1][0], line[1][1], 0);
          ctx.strokeStyle = `rgba(52,211,153,${fade})`;
          ctx.lineWidth = 2;
          ctx.setLineDash([7, 5]);
          ctx.beginPath();
          ctx.moveTo(p1.x, p1.y);
          ctx.lineTo(p2.x, p2.y);
          ctx.stroke();
          ctx.setLineDash([]);
        }
      } else {
        const n2 = w[0] * w[0] + w[1] * w[1] + w[2] * w[2];
        if (n2 > 1e-9) {
          // the plane through the view centre, spanned by two vectors at right
          // angles to the weight vector
          const t = (w[0] * v.cx + w[1] * v.cy + w[2] * v.cz + bo) / n2;
          const c = [v.cx - w[0] * t, v.cy - w[1] * t, v.cz - w[2] * t];
          const n = [w[0], w[1], w[2]].map((x) => x / Math.sqrt(n2));
          const helper = Math.abs(n[2]) < 0.9 ? [0, 0, 1] : [1, 0, 0];
          const u = [
            n[1] * helper[2] - n[2] * helper[1],
            n[2] * helper[0] - n[0] * helper[2],
            n[0] * helper[1] - n[1] * helper[0],
          ];
          const ul = Math.hypot(u[0], u[1], u[2]) || 1;
          for (let i = 0; i < 3; i++) u[i] /= ul;
          const w2 = [
            n[1] * u[2] - n[2] * u[1],
            n[2] * u[0] - n[0] * u[2],
            n[0] * u[1] - n[1] * u[0],
          ];
          const R = v.half * 1.5;
          const corner = (a: number, b2: number) =>
            m(
              c[0] + u[0] * a * R + w2[0] * b2 * R,
              c[1] + u[1] * a * R + w2[1] * b2 * R,
              c[2] + u[2] * a * R + w2[2] * b2 * R
            );
          const pts = [corner(-1, -1), corner(1, -1), corner(1, 1), corner(-1, 1)];
          ctx.beginPath();
          ctx.moveTo(pts[0].x, pts[0].y);
          for (let i = 1; i < 4; i++) ctx.lineTo(pts[i].x, pts[i].y);
          ctx.closePath();
          ctx.fillStyle = `rgba(52,211,153,${0.16 * fade})`;
          ctx.fill();
          ctx.strokeStyle = `rgba(52,211,153,${0.7 * fade})`;
          ctx.lineWidth = 1.4;
          ctx.stroke();
        }
      }
    }
    ctx.restore();
  }

  // --- the row of stages ---------------------------------------------------------------

  const LIN = '#7c8cff';  // the matrix half of a layer
  const ACTC = '#f59e0b'; // the activation half
  const kindCol = (k: number) => {
    const t = kindOf(k);
    return t === 'linear' ? LIN : t === 'act' ? ACTC : t === 'class' ? CUT : inkA(0.5);
  };

  /** The name of a stage, as it appears on its thumbnail. */
  const shortName = (k: number) => {
    const t = kindOf(k);
    return t === 'input' ? 'Input'
      : t === 'class' ? 'Classifier'
      : t === 'linear' ? `Linear ${layerOf(k)}`
      : `Activation ${layerOf(k)}`;
  };
  /** What that stage does, on the second line. */
  const subName = (k: number) => {
    const t = kindOf(k);
    return t === 'input' ? 'the data'
      : t === 'class' ? 'w · h + b'
      : t === 'linear' ? 'W x + b'
      : state.acts[layerOf(k) - 1];
  };
  /** Long form, for the panel title and the readout. */
  function longName(pos: number) {
    const k = Math.round(pos);
    if (Math.abs(pos - k) > 0.02) {
      const a = Math.floor(pos);
      return `${shortName(a)} → ${shortName(a + 1)}, ${Math.round((pos - a) * 100)}%`;
    }
    const t = kindOf(k);
    return t === 'input' ? 'the input space, before anything'
      : t === 'class' ? 'the space the classifier reads, and its line'
      : t === 'linear' ? `linear step ${layerOf(k)}: W x + b, no activation yet`
      : `activation ${layerOf(k)}: ${state.acts[layerOf(k) - 1]} applied to it`;
  }

  function thumbBoxes(): Box[] {
    const n = nStages();
    const gap = 8;
    const side = Math.min(128, (STRIP.w - 28 - gap * (n - 1)) / n);
    const total = n * side + gap * (n - 1);
    const x0 = STRIP.x + (STRIP.w - total) / 2;
    return Array.from({ length: n }, (_, k) => ({
      x: x0 + k * (side + gap),
      y: STRIP.y + 30,
      w: side,
      h: side,
    }));
  }

  function drawStrip() {
    panel(STRIP, 'EVERY STEP MAKES A NEW SPACE. CLICK ONE, THEN SLIDE THROUGH IT.');
    const boxes = thumbBoxes();
    boxes.forEach((b, k) => {
      drawSpace(k, b, 4, 3, 1.5);
      const on = Math.abs(state.pos - k) < 0.02;
      const col = kindCol(k);
      ctx.strokeStyle = on ? col : kindOf(k) === 'input' ? inkA(0.16) : hexA(col, 0.4);
      ctx.lineWidth = on ? 2.5 : 1;
      rr(b.x, b.y, b.w, b.h, 8);
      ctx.stroke();
      text(shortName(k), b.x + b.w / 2, b.y - 8, 10, on ? col : inkA(0.55), 'center', true);
      text(subName(k), b.x + b.w / 2, b.y + b.h + 14, 10, hexA(col, on ? 0.95 : 0.6), 'center', true);
      // where the slider sits while it is between two of them
      if (!on && state.pos > k && state.pos < k + 1) {
        const t = state.pos - k;
        ctx.fillStyle = SEL;
        ctx.beginPath();
        ctx.arc(b.x + b.w + 4, b.y + b.h / 2 - 6 + t * 12, 3.5, 0, Math.PI * 2);
        ctx.fill();
      }
    });
  }

  // --- loss and architecture --------------------------------------------------------------

  function drawLoss() {
    panel(LOSS, 'LOSS WHILE IT LEARNS');
    // the live numbers ride on the title line, where they cannot crowd the curve
    text(
      `loss ${isFinite(state.loss) ? state.loss.toFixed(4) : '—'} · ${state.steps} steps · ${(
        state.acc * 100
      ).toFixed(1)}% correct`,
      LOSS.x + LOSS.w,
      LOSS.y - 9,
      11,
      inkA(0.75),
      'right',
      true
    );
    const x0 = LOSS.x + 16, y0 = LOSS.y + 24, w = LOSS.w - 32, h = LOSS.h - 34;
    ctx.strokeStyle = inkA(0.12);
    ctx.lineWidth = 1;
    ctx.strokeRect(x0, y0, w, h);
    if (history.length > 1) {
      const max = Math.max(0.12, ...history);
      ctx.strokeStyle = SEL;
      ctx.lineWidth = 1.8;
      ctx.beginPath();
      history.forEach((l, i) => {
        const px = x0 + (i / (history.length - 1)) * w;
        const py = y0 + h - Math.min(1, l / max) * h;
        if (!i) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      });
      ctx.stroke();
      text(max.toFixed(2), x0 + 5, y0 + 12, 10, inkA(0.32), 'left', true);
      text('0', x0 + 5, y0 + h - 5, 10, inkA(0.32), 'left', true);
    }
  }

  function drawArch() {
    panel(ARCH, 'THE NETWORK, ALL OF IT');
    const cols = state.L + 2;
    const x0 = ARCH.x + 44, span = ARCH.w - 88;
    const cy = ARCH.y + 130;
    const colX = (i: number) => x0 + (span * i) / (cols - 1);
    const nodeY = (i: number, n: number) => cy + (i - (n - 1) / 2) * (state.width === 3 ? 38 : 46);

    const count = (i: number) => (i === cols - 1 ? 1 : i === 0 ? 2 : state.width);
    // weights first, so the nodes sit on top of them
    for (let i = 0; i < cols - 1; i++) {
      const wts = i === cols - 2 ? net.out.W : net.hidden[i]?.W;
      if (!wts) continue;
      const nIn = count(i), nOut = count(i + 1);
      for (let o = 0; o < nOut; o++) {
        for (let j = 0; j < nIn; j++) {
          const w = i === cols - 2 ? wts[j] : wts[o * nIn + j];
          const mag = Math.min(4, Math.abs(w));
          ctx.strokeStyle = w >= 0 ? rgba(C1, 0.25 + mag * 0.16) : rgba(C0, 0.25 + mag * 0.16);
          ctx.lineWidth = 0.6 + mag * 0.9;
          ctx.beginPath();
          ctx.moveTo(colX(i) + 13, nodeY(j, nIn));
          ctx.lineTo(colX(i + 1) - 13, nodeY(o, nOut));
          ctx.stroke();
        }
      }
    }
    for (let i = 0; i < cols; i++) {
      const n = count(i);
      const on = i > 0 && i <= state.L && i === layerOf(Math.max(1, Math.ceil(state.pos)));
      for (let j = 0; j < n; j++) {
        ctx.fillStyle = inkA(0.1);
        ctx.strokeStyle = on ? SEL : i === cols - 1 ? CUT : inkA(0.3);
        ctx.lineWidth = on ? 2 : 1.2;
        ctx.beginPath();
        ctx.arc(colX(i), nodeY(j, n), 13, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
      }
      text(
        i === 0 ? 'x, y' : i === cols - 1 ? 'class' : `L${i}`,
        colX(i),
        cy + 66,
        11,
        on ? SEL : inkA(0.5),
        'center',
        true
      );
      if (i > 0 && i < cols - 1) {
        // the activation is greyed out until the slider passes through it
        const done = state.pos >= 2 * i;
        text(state.acts[i - 1], colX(i), cy + 82, 10, done ? inkA(0.5) : inkA(0.22), 'center', true);
      }
    }
  }

  // --- frame ---------------------------------------------------------------------------------

  const el = (id: string) => document.getElementById(id) as HTMLElement;
  const setEq = equationBar();

  /**
   * Only the step being looked at. Every line is kept one line tall and one
   * line wide: a tall \begin{bmatrix} or a wrapping sentence would change the
   * height of the bar, which moves the canvas and the whole page with it.
   * `num` pads positives with the width of a minus so the numbers do not
   * jitter as they train.
   */
  function stepEquation(step: number) {
    const num = (x: number) => (x < 0 ? '' : '\\phantom{-}') + x.toFixed(2);
    const vec = (...xs: number[]) => `(${xs.map(num).join(',\\,')})`;
    /** the image of input basis vector j, which is column j of W */
    const colOf = (L: Layer, j: number) =>
      vec(...Array.from({ length: L.nOut }, (_, i) => L.W[i * L.nIn + j]));
    const basis = (n: number, j: number) =>
      n === 2 ? (j === 0 ? '\\hat\\imath' : '\\hat\\jmath') : `e_${j + 1}`;

    if (step > 2 * state.L) {
      const w = net.out.W;
      return [
        [['\\hat y = \\text{sigmoid}\\left(w\\cdot h + b\\right)', CUT]],
        [`w = ${vec(...w)}\\quad b = ${num(net.out.b[0])}`],
        ['one straight line, which is all a classifier ever gets'],
      ];
    }
    const l = layerOf(step);
    const L = net.hidden[l - 1];
    if (!L) return [[''], [''], ['']];

    if (kindOf(step) === 'linear') {
      const from = l === 1 ? 'x' : `h^{(${l - 1})}`;
      return [
        [[`z^{(${l})} = W^{(${l})}\\,${from} + b^{(${l})}`, LIN]],
        [
          Array.from(
            { length: L.nIn },
            (_, j) => `${basis(L.nIn, j)} \\mapsto ${colOf(L, j)}`
          ).join('\\quad ') + `\\quad b = ${vec(...L.b)}`,
        ],
        ['a matrix and a shift: it can turn and stretch the grid, never bend it'],
      ];
    }
    const f: Record<string, string> = {
      tanh: '\\tanh(z)',
      relu: '\\max(0,\\,z)',
      leaky: '\\max(0.1z,\\,z)',
      sigmoid: '1/(1 + e^{-z})',
      linear: 'z',
    };
    return [
      [[`h^{(${l})} = \\sigma\\left(z^{(${l})}\\right)`, ACTC]],
      [[`\\sigma(z) = ${f[L.a]}`, ACTC]],
      [
        L.a === 'linear'
          ? 'nothing happens here, which is why a linear stack is just one matrix'
          : 'the only step in the whole network that can bend a straight line',
      ],
    ];
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    ctx.textBaseline = 'alphabetic';
    propagate();
    drawStrip();

    panel(MAIN, longName(state.pos).toUpperCase());
    drawSpace(state.pos, MAIN, 18, 1, 4);

    drawLoss();
    drawArch();

    el('rstage').textContent = shortName(Math.round(state.pos));
    el('rstep').textContent = String(state.steps);
    el('rloss').textContent = isFinite(state.loss) ? state.loss.toFixed(4) : '—';
    el('racc').textContent = `${(state.acc * 100).toFixed(1)}%`;
    el('rparams').textContent = String(paramCount());

    setEq(stepEquation(state.step) as Parameters<typeof setEq>[0]);
  }

  let fc = 0;
  let lastTs = 0;
  function frame(ts: number) {
    const dt = lastTs ? Math.min(0.05, (ts - lastTs) / 1000) : 0;
    lastTs = ts;
    if (state.running) {
      for (let i = 0; i < 12; i++) trainStep();
      if (fc++ % 4 === 0) {
        history.push(state.loss);
        if (history.length > 240) history.shift();
      }
    }
    if (spatial() && cam.auto) drift(dt * 0.28);
    if (state.sweeping) {
      // ease through each half-step so every space gets a moment of its own
      sweepT += dt * 0.9;
      const last = nStages() - 1;
      if (sweepT >= last) {
        sweepT = last;
        state.sweeping = false;
        (el('sweep') as HTMLButtonElement).textContent = 'Sweep through';
      }
      const base = Math.floor(sweepT), f = sweepT - base;
      setPos(base + f * f * (3 - 2 * f), true, true);
    }
    draw();
    requestAnimationFrame(frame);
  }

  // --- controls -------------------------------------------------------------------------------

  function rebuild(newData: boolean) {
    if (newData) data = makeData(state.problem);
    net = makeNet(state.acts.slice(0, state.L), state.width);
    state.steps = 0;
    state.loss = NaN;
    state.acc = 0;
    history.length = 0;
    views = [];
    state.step = Math.max(1, Math.min(nStages() - 1, state.step));
    setPos(Math.min(state.pos, nStages() - 1));
  }

  el('problem').addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn) return;
    document.querySelectorAll('#problem button').forEach((b) => b.classList.remove('active'));
    btn.classList.add('active');
    state.problem = (btn.dataset.p as Problem) ?? 'xor';
    rebuild(true);
  });

  function syncActRows() {
    document.querySelectorAll<HTMLElement>('.actrow').forEach((row) => {
      row.style.display = +(row.dataset.i ?? 0) < state.L ? 'flex' : 'none';
    });
  }
  el('width').addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn) return;
    document.querySelectorAll('#width button').forEach((b) => b.classList.remove('active'));
    btn.classList.add('active');
    state.width = btn.dataset.w === '3' ? 3 : 2;
    cam.auto = state.width === 3 && !cam.touched;
    views = [];
    rebuild(false);
  });

  const LEl = el('L') as HTMLInputElement;
  LEl.addEventListener('input', () => {
    state.L = +LEl.value;
    el('lval').textContent = LEl.value;
    syncActRows();
    rebuild(false);
  });
  for (let i = 0; i < 4; i++) {
    const s = el('act' + i) as HTMLSelectElement;
    s.addEventListener('change', () => {
      state.acts[i] = s.value as Act;
      rebuild(false);
    });
  }
  const lrEl = el('lr') as HTMLInputElement;
  lrEl.addEventListener('input', () => {
    state.lr = +lrEl.value / 1000;
    el('lrval').textContent = state.lr.toFixed(3);
  });

  let sweepT = 0;
  const posEl = el('pos') as HTMLInputElement;
  const withinEl = el('within') as HTMLInputElement;

  function syncControls() {
    const last = nStages() - 1;
    posEl.max = String(last * 100);
    posEl.value = String(Math.round(state.pos * 100));
    el('posval').textContent = shortName(Math.round(state.pos));
    const t = Math.max(0, Math.min(1, state.pos - (state.step - 1)));
    withinEl.value = String(Math.round(t * 100));
    el('withinval').textContent = `${Math.round(t * 100)}%`;
    el('stepname').textContent = shortName(state.step);
  }
  /**
   * `retarget` moves which step the within-slider is driving. The within-slider
   * itself must not, or it would jump to the previous step at 0%.
   */
  function setPos(p: number, retarget = true, fromSweep = false) {
    const last = nStages() - 1;
    state.pos = Math.max(0, Math.min(last, p));
    if (retarget) state.step = Math.max(1, Math.min(last, Math.ceil(state.pos - 1e-9)));
    if (!fromSweep) {
      state.sweeping = false;
      sweepT = state.pos;
      (el('sweep') as HTMLButtonElement).textContent = 'Sweep through';
    }
    syncControls();
  }
  /** Jump to a stage and make the step that produced it the selected one. */
  function selectStage(k: number) {
    state.step = Math.max(1, Math.min(nStages() - 1, k));
    setPos(k, false);
  }
  posEl.addEventListener('input', () => setPos(+posEl.value / 100));
  withinEl.addEventListener('input', () =>
    setPos(state.step - 1 + +withinEl.value / 100, false)
  );

  const sweepBtn = el('sweep') as HTMLButtonElement;
  sweepBtn.addEventListener('click', () => {
    if (spatial() && cam.auto) drift(dt * 0.28);
    if (state.sweeping) {
      state.sweeping = false;
      sweepBtn.textContent = 'Sweep through';
      return;
    }
    sweepT = state.pos >= nStages() - 1 - 1e-6 ? 0 : state.pos;
    state.sweeping = true;
    sweepBtn.textContent = 'Stop';
  });

  const runBtn = el('run') as HTMLButtonElement;
  runBtn.addEventListener('click', () => {
    state.running = !state.running;
    runBtn.textContent = state.running ? 'Pause' : 'Train';
  });
  el('step').addEventListener('click', () => {
    for (let i = 0; i < 200; i++) trainStep();
    history.push(state.loss);
  });
  el('reset').addEventListener('click', () => rebuild(false));

  // orbit the volume by dragging the big panel
  let orbiting = false, ox = 0, oy = 0;
  const inMain = (mx: number, my: number) =>
    mx >= MAIN.x && mx <= MAIN.x + MAIN.w && my >= MAIN.y && my <= MAIN.y + MAIN.h;
  canvas.addEventListener('pointerdown', (e) => {
    if (!spatial()) return;
    const r = canvas.getBoundingClientRect();
    if (!inMain(((e.clientX - r.left) / r.width) * W, ((e.clientY - r.top) / r.height) * H)) return;
    orbiting = true;
    cam.auto = false;
    cam.touched = true;
    ox = e.clientX;
    oy = e.clientY;
    canvas.setPointerCapture(e.pointerId);
  });
  canvas.addEventListener('pointermove', (e) => {
    if (!orbiting) return;
    // no clamping anywhere: drag as far as you like, in any direction
    turn((e.clientX - ox) * 0.009, (e.clientY - oy) * 0.009);
    ox = e.clientX;
    oy = e.clientY;
  });
  const endOrbit = () => (orbiting = false);
  canvas.addEventListener('pointerup', endOrbit);
  canvas.addEventListener('pointercancel', endOrbit);

  // pick a stage by clicking its thumbnail
  canvas.addEventListener('click', (e) => {
    const r = canvas.getBoundingClientRect();
    const mx = ((e.clientX - r.left) / r.width) * W;
    const my = ((e.clientY - r.top) / r.height) * H;
    thumbBoxes().forEach((b, k) => {
      if (mx >= b.x && mx <= b.x + b.w && my >= b.y && my <= b.y + b.h) selectStage(k);
    });
  });
  canvas.addEventListener('mousemove', (e) => {
    const r = canvas.getBoundingClientRect();
    const mx = ((e.clientX - r.left) / r.width) * W;
    const my = ((e.clientY - r.top) / r.height) * H;
    const over = thumbBoxes().some(
      (b) => mx >= b.x && mx <= b.x + b.w && my >= b.y && my <= b.y + b.h
    );
    canvas.style.cursor = over ? 'pointer' : spatial() && inMain(mx, my) ? 'grab' : 'default';
  });

  syncActRows();
  selectStage(0);
  requestAnimationFrame(frame);
</script>

<style>
  /* the equation bar sits above the canvas: if its height changed with the
     step being shown, the canvas and the rest of the page would move with it */
  .sim-stage :global(.sim-eq) {
    min-height: 96px;
  }
  @media (max-width: 760px) {
    .sim-stage :global(.sim-eq) {
      min-height: 132px;
    }
  }
  .sub {
    font-size: 0.76rem !important;
    color: var(--text-faint) !important;
    margin: 6px 0 0 !important;
  }
  .acts {
    display: grid;
    gap: 8px;
  }
  .actrow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .actrow span {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
  }
  .actrow select {
    flex: 0 0 118px;
    padding: 5px 8px;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: var(--bg-elev);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }
  .actrow select:focus {
    outline: none;
    border-color: var(--accent);
  }
</style>
