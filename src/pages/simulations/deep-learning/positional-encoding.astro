---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Actions from '../../../components/sim/Actions.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="deep-learning"
  title="Positional Encoding"
  description="Attention looks at a set, not a sequence: shuffle the words and every score comes out the same. Position has to be written into the vectors, and the question is whether the score between two words then depends only on how far apart they are or also on where they sit."
  shortcuts={['fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="pe"
          width="1000"
          height="620"
          role="img"
          aria-label="The positional encoding matrix as a heatmap of positions against dimensions, the vector for the chosen position, and the attention score between two words plotted against their offset, for the query at two different positions."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'query at position p', color: '#7c8cff' },
          { label: 'query at position p′', color: '#f472b6' },
          { label: 'a fast dimension', color: '#f59e0b' },
        ]}
        hint="Click a row of the heatmap to move p"
      />
      <Result label="Largest gap between the two curves" />
    </div>

    <div class="sim-panel">
      <Seg
        id="kind"
        label="Encoding"
        attr="k"
        options={[
          { value: 'sin', label: 'Sinusoidal' },
          { value: 'rope', label: 'Rotary' },
          { value: 'table', label: 'Random table' },
          { value: 'none', label: 'None' },
        ]}
      />
      <Seg
        id="words"
        label="Query and key"
        attr="w"
        options={[
          { value: 'diff', label: 'Two words' },
          { value: 'same', label: 'Same word' },
        ]}
      />
      <Slider id="pos" label="Position p" min={0} max={63} value={8} />
      <Slider id="pos2" label="Position p′" min={0} max={63} value={40} />
      <Slider id="dim" label="Dimensions d" min={8} max={64} step={4} value={32} />
      <Slider id="base" label="Base B" min={10} max={50} value={40} display="10000" hint={['every dimension fast', 'the last ones very slow']} />
      <Actions>
        <button type="button" class="btn ghost" id="shuffle">New words</button>
      </Actions>
      <Readout
        title="Values"
        rows={[
          { id: 'r-0', label: 'score at offset 0, from p / p′' },
          { id: 'r-1', label: 'score at offset 1, from p / p′' },
          { id: 'r-10', label: 'score at offset 10, from p / p′' },
          { id: 'r-slow', label: 'slowest wavelength' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      <b>Sinusoidal</b> adds the waves to the word vectors. The score then mixes
      word with position, so the same offset scores differently from p and from
      p′: the two curves part. <Try id="sin" />
    </li>
    <li>
      <b>Rotary</b> rotates each pair of dimensions instead, and rotations
      compose: (R<sub>p</sub>x)·(R<sub>q</sub>y) = x·R<sub>q−p</sub>y. The two curves
      lie exactly on top of each other, for any words. <Try id="rope" label="New words" />
    </li>
    <li>
      Drag the <b>base</b> down and every dimension turns fast: the score
      collapses to a narrow spike at offset 0. A large base keeps slow
      dimensions that tell distant positions apart. <Try id="base" />
    </li>
    <li>
      A <b>table</b> of one vector per position starts out as noise, shown here
      untrained. Training shapes it, but it can only cover the positions it was
      given rows for. <Try id="table" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk } from '../../../lib/draw';
  import { el, segmented, slider, result, readout, tries } from '../../../lib/panel';

  const PICK = '#7c8cff', PICK2 = '#f472b6', SIM = '#5eead4', FAST = '#f59e0b';
  const LEN = 64;

  type Kind = 'sin' | 'rope' | 'table' | 'none';
  const state = { kind: 'sin' as Kind, same: false, pos: 8, pos2: 40, dim: 32, base: 10000, seed: 7 };

  const canvas = el('pe') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => build());
  const { ink } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  function mulberry32(a: number) {
    return () => {
      a = (a + 0x6d2b79f5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  /** A vector of normal numbers with variance one half, the same size as a sinusoidal row. */
  function gauss(rnd: () => number, d: number) {
    const v = new Float64Array(d);
    for (let i = 0; i < d; i++) {
      const u = Math.max(1e-12, rnd()), w = rnd();
      v[i] = Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * w) * Math.SQRT1_2;
    }
    return v;
  }

  /** One row per position, one column per dimension: what is drawn in the heatmap. */
  let PE: Float64Array[] = [];
  /** Content vectors of the query word and the key word. */
  let x = new Float64Array(1), y = new Float64Array(1);
  /** Score against offset, for the query at p and at p′; null where the key falls off the sequence. */
  let curves: (number | null)[][] = [[], []];

  const omega = (i: number) => 1 / Math.pow(state.base, (2 * Math.floor(i / 2)) / state.dim);
  const dot = (a: Float64Array, b: Float64Array) => a.reduce((s, v, i) => s + v * b[i], 0);
  const cos = (a: Float64Array, b: Float64Array) => dot(a, b) / Math.max(1e-9, Math.sqrt(dot(a, a) * dot(b, b)));
  /** Rotate each pair (2i, 2i+1) of v by p·ω_i. */
  function rotate(v: Float64Array, p: number) {
    const out = new Float64Array(v.length);
    for (let i = 0; i + 1 < v.length; i += 2) {
      const a = p * omega(i), c = Math.cos(a), s = Math.sin(a);
      out[i] = c * v[i] - s * v[i + 1];
      out[i + 1] = s * v[i] + c * v[i + 1];
    }
    return out;
  }
  const add = (a: Float64Array, b: Float64Array) => a.map((v, i) => v + b[i]);

  /** The encoded vector of a word with content v at position p. */
  function encode(v: Float64Array, p: number) {
    if (state.kind === 'rope') return rotate(v, p);
    if (state.kind === 'none') return v;
    return add(v, PE[p]);
  }

  function build() {
    const { dim } = state;
    const rnd = mulberry32(state.seed);
    x = gauss(rnd, dim);
    y = state.same ? x : gauss(rnd, dim);
    const trnd = mulberry32(1234);
    PE = [];
    for (let p = 0; p < LEN; p++) {
      const v = new Float64Array(dim);
      if (state.kind === 'table') v.set(gauss(trnd, dim));
      else if (state.kind !== 'none')
        // sinusoidal adds these to a word; rotary uses the same angles to rotate it
        for (let i = 0; i < dim; i++) v[i] = i % 2 === 0 ? Math.sin(p * omega(i)) : Math.cos(p * omega(i));
      PE.push(v);
    }
    curves = [state.pos, state.pos2].map((p) => {
      const qv = encode(x, p);
      const out: (number | null)[] = [];
      for (let o = -(LEN - 1); o <= LEN - 1; o++) {
        const q = p + o;
        out.push(q < 0 || q >= LEN ? null : cos(qv, encode(y, q)));
      }
      return out;
    });
    draw();
  }

  /** Score at offset o from the query at position p (curve 0) or p′ (curve 1). */
  const at = (c: number, o: number) => curves[c][o + LEN - 1];
  /** Largest difference between the curves where both exist. */
  function gap() {
    let g = 0, where = 0;
    for (let o = -(LEN - 1); o <= LEN - 1; o++) {
      const a = at(0, o), b = at(1, o);
      if (a === null || b === null) continue;
      if (Math.abs(a - b) > g) { g = Math.abs(a - b); where = o; }
    }
    return { g, where };
  }

  // --- layout ----------------------------------------------------------------
  const HM = { x: 122, y: 96, w: 412, h: 330 };
  const VEC = { x: 122, y: 470, w: 412, h: 46 };
  const PL = { x: 600, y: 96, w: 350, h: 330 };

  const heat = (v: number) => {
    // −1 amber, 0 background, +1 teal
    const t = Math.max(-1, Math.min(1, v));
    return t >= 0
      ? `rgba(94,234,212,${0.08 + 0.72 * t})`
      : `rgba(245,158,11,${0.08 + 0.72 * -t})`;
  };

  function heatmap() {
    const titles: Record<Kind, [string, string]> = {
      sin: ['the encoding, one row per position', 'left columns turn fast, right ones slowly'],
      rope: ['the rotation angles, one row per position', 'sin and cos of each pair’s angle p·ω'],
      table: ['a table of vectors, one row per position', 'random, as before training'],
      none: ['nothing is added', 'every row is the same'],
    };
    label(titles[state.kind][0], HM.x, HM.y - 32, 0.5, 'left', 13);
    label(titles[state.kind][1], HM.x, HM.y - 16, 0.3, 'left', 11);
    const cw = HM.w / state.dim, rh = HM.h / LEN;
    for (let p = 0; p < LEN; p++)
      for (let i = 0; i < state.dim; i++) {
        ctx.fillStyle = heat(PE[p][i]);
        ctx.fillRect(HM.x + i * cw, HM.y + p * rh, cw + 0.5, rh + 0.5);
      }
    ctx.strokeStyle = ink(0.12);
    ctx.lineWidth = 1;
    ctx.strokeRect(HM.x, HM.y, HM.w, HM.h);

    for (const [p, col, name] of [[state.pos, PICK, 'p'], [state.pos2, PICK2, 'p′']] as [number, string, string][]) {
      ctx.strokeStyle = col;
      ctx.lineWidth = 2;
      ctx.strokeRect(HM.x - 2, HM.y + p * rh - 1, HM.w + 4, Math.max(3, rh) + 2);
      label(`${name} = ${p}`, HM.x - 10, HM.y + p * rh + Math.max(3, rh) / 2 + 4, 1, 'right', 11.5, col);
    }
    label('dimension 0', HM.x, HM.y + HM.h + 18, 0.3, 'left', 11);
    label(`${state.dim - 1}`, HM.x + HM.w, HM.y + HM.h + 18, 0.3, 'right', 11);
  }

  function vector() {
    const p0 = state.pos;
    const v = encode(x, p0);
    label(`the query word as it enters attention at position ${p0}`, VEC.x, VEC.y - 14, 0.45, 'left', 12);
    const cw = VEC.w / state.dim;
    const big = Math.max(1e-9, ...Array.from(v, Math.abs));
    for (let i = 0; i < state.dim; i++) {
      const h = (Math.abs(v[i]) / big) * (VEC.h / 2);
      ctx.fillStyle = v[i] >= 0 ? SIM : FAST;
      ctx.globalAlpha = 0.85;
      const mid = VEC.y + VEC.h / 2;
      ctx.fillRect(VEC.x + i * cw + 0.5, v[i] >= 0 ? mid - h : mid, Math.max(1, cw - 1), Math.max(1, h));
      ctx.globalAlpha = 1;
    }
    ctx.strokeStyle = ink(0.18);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(VEC.x, VEC.y + VEC.h / 2);
    ctx.lineTo(VEC.x + VEC.w, VEC.y + VEC.h / 2);
    ctx.stroke();
    label(
      state.kind === 'rope' ? 'the word rotated, pair by pair' : state.kind === 'none' ? 'the word alone' : 'the word plus its row',
      VEC.x, VEC.y + VEC.h + 18, 0.3, 'left', 11
    );
  }

  function plot() {
    label('score between the two words, by offset', PL.x, PL.y - 32, 0.5, 'left', 13);
    label('cosine of query and key, key at query + offset', PL.x, PL.y - 16, 0.3, 'left', 11);
    const R = LEN - 1;
    const px = (o: number) => PL.x + ((o + R) / (2 * R)) * PL.w;
    const py = (v: number) => PL.y + PL.h / 2 - (Math.max(-1, Math.min(1, v)) * PL.h) / 2;
    ctx.strokeStyle = ink(0.12);
    ctx.lineWidth = 1;
    ctx.strokeRect(PL.x, PL.y, PL.w, PL.h);
    for (const v of [1, 0.5, 0, -0.5, -1]) {
      ctx.strokeStyle = ink(v === 0 ? 0.24 : 0.07);
      ctx.beginPath();
      ctx.moveTo(PL.x, py(v));
      ctx.lineTo(PL.x + PL.w, py(v));
      ctx.stroke();
      label(v.toFixed(1), PL.x - 8, py(v) + 4, 0.3, 'right', 11);
    }
    ctx.strokeStyle = ink(0.2);
    ctx.setLineDash([3, 4]);
    ctx.beginPath();
    ctx.moveTo(px(0), PL.y);
    ctx.lineTo(px(0), PL.y + PL.h);
    ctx.stroke();
    ctx.setLineDash([]);

    // p′ first and wider, so a curve lying exactly on it still shows both colours
    for (const [c, col, w] of [[1, PICK2, 4.5], [0, PICK, 2]] as [number, string, number][]) {
      ctx.strokeStyle = col;
      ctx.lineWidth = w;
      ctx.beginPath();
      let pen = false;
      for (let o = -R; o <= R; o++) {
        const v = at(c, o);
        if (v === null) { pen = false; continue; }
        pen ? ctx.lineTo(px(o), py(v)) : ctx.moveTo(px(o), py(v));
        pen = true;
      }
      ctx.stroke();
    }
    label(`−${R}`, PL.x, PL.y + PL.h + 18, 0.3, 'left', 11);
    label('offset 0', px(0), PL.y + PL.h + 18, 0.3, 'center', 11);
    label(`+${R}`, PL.x + PL.w, PL.y + PL.h + 18, 0.3, 'right', 11);

    const { g } = gap();
    label('largest gap between the curves', PL.x, PL.y + PL.h + 54, 0.45, 'left', 12);
    label(g.toFixed(3), PL.x, PL.y + PL.h + 84, 1, 'left', 22, g < 1e-9 ? SIM : FAST);
    label(
      g < 1e-9 ? 'the score depends on the offset alone' : 'the score also depends on where the pair sits',
      PL.x, PL.y + PL.h + 104, 0.35, 'left', 11
    );
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    heatmap();
    vector();
    plot();

    const { g, where } = gap();
    const wl = 2 * Math.PI * Math.pow(state.base, (state.dim - 2) / state.dim);
    const pair = (o: number) => [0, 1].map((c) => { const v = at(c, o); return v === null ? 'off the end' : v.toFixed(3); }).join(' / ');
    const rules: Record<Kind, [string, string][]> = {
      sin: [['s(p,q) = \\cos\\angle\\big(x + PE_p,\\; y + PE_q\\big)', SIM]],
      rope: [['(R_p x)\\cdot(R_q y) = x \\cdot R_{q-p}\\, y', SIM]],
      table: [['s(p,q) = \\cos\\angle\\big(x + E_p,\\; y + E_q\\big)', SIM]],
      none: [['s(p,q) = \\cos\\angle(x,\\, y)', SIM]],
    };
    setEq({
      rule: rules[state.kind],
      live: [
        [`p = ${state.pos}`, PICK],
        [`\\quad p' = ${state.pos2}`, PICK2],
        `\\quad d = ${state.dim},\\; B = ${state.base}`,
        [`\\quad \\text{gap} = ${g.toFixed(3)}`, g < 1e-9 ? SIM : FAST],
      ],
    });
    setRows({
      'r-0': pair(0),
      'r-1': pair(1),
      'r-10': pair(10),
      'r-slow': state.kind === 'sin' || state.kind === 'rope' ? `${wl > 1e5 ? wl.toExponential(1) : wl.toFixed(0)} positions` : 'no waves here',
    });
    setResult({
      value: g.toFixed(3),
      colour: g < 1e-9 ? SIM : FAST,
      status: g < 1e-9 ? 'the curves coincide' : `largest at offset ${where} · query at ${state.pos} and at ${state.pos2}`,
      note:
        state.kind === 'none'
          ? 'Nothing marks position, so the score is the same at every offset: attention sees a set, and word order does not exist for it.'
          : state.kind === 'rope'
            ? 'Rotating by p and by q leaves only the rotation by q − p between the two words, so the score is a function of the offset alone, whatever the words.'
            : state.kind === 'table'
              ? 'An untrained table is noise: neighbours score no closer than strangers. Training shapes the rows, but a position past the end of the table has no row at all.'
              : 'Adding the waves to the words leaves cross terms like x · PE_q in the score, so the same offset scores differently depending on where the pair sits.',
    });
  }

  // --- interaction -----------------------------------------------------------
  const setPos = slider('pos', (v) => { state.pos = v; build(); });
  const setPos2 = slider('pos2', (v) => { state.pos2 = v; build(); });
  canvas.addEventListener('pointerdown', (e) => {
    const r = canvas.getBoundingClientRect();
    const px = ((e.clientX - r.left) / r.width) * W;
    const py = ((e.clientY - r.top) / r.height) * H;
    if (px < HM.x - 20 || px > HM.x + HM.w + 20 || py < HM.y || py > HM.y + HM.h) return;
    const p = Math.max(0, Math.min(LEN - 1, Math.floor(((py - HM.y) / HM.h) * LEN)));
    state.pos = p;
    setPos(p);
    build();
  });

  const kinds = segmented('kind', (k) => { state.kind = k as Kind; build(); });
  const words = segmented('words', (w) => { state.same = w === 'same'; build(); });
  slider('dim', (v) => { state.dim = v; build(); });
  const toBase = (v: number) => Math.round(10 ** (v / 10));
  const setBase = slider('base', (v) => { state.base = toBase(v); build(); }, (v) => String(toBase(v)));
  el('shuffle').addEventListener('click', () => { state.seed = 1 + Math.floor(Math.random() * 1e6); build(); });

  function show(kind: Kind, same: boolean, base = 40) {
    state.kind = kind;
    kinds.select(kind);
    state.same = same;
    words.select(same ? 'same' : 'diff');
    state.base = toBase(base);
    setBase(base);
    state.pos = 8; setPos(8);
    state.pos2 = 40; setPos2(40);
  }
  tries({
    sin: () => { show('sin', false); build(); },
    rope: () => { show('rope', false); state.seed = 1 + Math.floor(Math.random() * 1e6); build(); },
    base: () => { show('rope', true, 12); build(); },
    table: () => { show('table', true); build(); },
  });

  build();
</script>

<style>
  #pe {
    cursor: crosshair;
  }
</style>
