---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="deep-learning"
  title="Contrastive Learning"
  description="Nobody says where anything goes. You only say which two things count as a pair; the loss pulls pairs together and pushes everything else apart, and the space sorts itself out. Labels, random versions of one picture, or a picture and its caption: one method, different rules."
  shortcuts={['run', 'reset', 'fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="con"
          width="1000"
          height="640"
          role="img"
          aria-label="Little pictures of shapes in colours placed in a disc by a small network, pulled towards the things they are paired with and pushed away from everything else."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'pull: a pair', color: '#5eead4' },
          { label: 'push: not a pair', color: '#f9736a' },
        ]}
        hint="Drag to turn · scroll to zoom · double-click to reset · hover a picture to follow it"
      />
      <Result label="Lookups that find the right thing" />
    </div>

    <div class="sim-panel">
      <Seg
        id="ch"
        label="Chapter"
        attr="c"
        options={[
          { value: '0', label: '1 · Near means alike' },
          { value: '1', label: '2 · Who is a pair' },
          { value: '2', label: '3 · Pull &amp; push' },
          { value: '3', label: '4 · Three losses' },
          { value: '4', label: '5 · What it is for' },
        ]}
      />
      <Transport>
        <button type="button" class="btn ghost" id="next">Next chapter →</button>
      </Transport>
      <Seg
        id="rule"
        label="Two things are a pair when they"
        attr="r"
        options={[
          { value: 'shape', label: 'share a shape' },
          { value: 'colour', label: 'share a colour' },
          { value: 'versions', label: 'are versions of one picture' },
          { value: 'caption', label: 'are a picture and its caption' },
        ]}
      />
      <Seg
        id="loss"
        label="Loss"
        attr="l"
        active="nce"
        options={[
          { value: 'pairs', label: 'Pairs' },
          { value: 'triplet', label: 'Triplet' },
          { value: 'nce', label: 'InfoNCE' },
        ]}
      />
      <Slider id="mar" label="Margin m" min={10} max={100} value={50} display="0.50" />
      <Slider id="tau" label="Temperature τ" min={2} max={50} value={10} display="0.10" hint={['sharp', 'soft']} />
      <Readout
        title="Now"
        rows={[
          { id: 'r-step', label: 'step' },
          { id: 'r-loss', label: 'loss' },
          { id: 'r-pos', label: 'mean distance, pairs' },
          { id: 'r-neg', label: 'mean distance, the rest' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Pulling pairs together is all that <b>pull alone</b> asks, and putting everything in one place does it
      perfectly. The loss reaches zero and the space is useless: <b>collapse</b>. The push is what rules it out.
      <Try id="collapse" />
    </li>
    <li>
      Same pictures, same network, same loss: pair them by <b>colour</b> instead of shape and the space is sorted
      by colour. What "alike" means is whatever the pairing rule says. <Try id="colour" />
    </li>
    <li>
      With <b>versions</b> there are no labels at all, yet the pictures group by shape: a random version keeps the
      shape and scrambles the colour, so the network learns to ignore colour. <Try id="versions" />
    </li>
    <li>
      With <b>captions</b> two different networks, one for pictures and one for words, learn one shared space. Each
      caption lands among the pictures it describes, so a sentence can find a picture. <Try id="caption" />
    </li>
    <li>
      The three losses agree on what is a pair, not on the shape of the space: pairs stop at the margin and leave
      tight clumps, InfoNCE never quite stops pushing and spreads them out. <Try id="losses" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk } from '../../../lib/draw';
  import { segmented, slider, result, readout, tries } from '../../../lib/panel';
  import { pictures, alter, rng, Run, pushes, lookup, CAPTIONS, SHAPES, COLOURS } from '../../../lib/contrastive';
  import type { Pic, Rule, Loss } from '../../../lib/contrastive';
  import { stageCamera } from '../../../lib/stage-camera';
  import { story, headline, say, withAlpha, isLight, beat, lerp, clamp01 } from '../../../lib/story';

  // The general idea as one picture: little pictures on a sphere, placed by a
  // small network whose output is normalised to length 1, as real systems do. The reader picks which two things count as a pair; the
  // loss pulls pairs and pushes everything else, and the disc sorts itself
  // by whatever the pairing rule meant by "alike".
  const PULL = '#5eead4', PUSH = '#f9736a', ACC = '#7c8cff';
  const COL = ['#f87171', '#60a5fa', '#fbbf24', '#4ade80'];
  const SANS = "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif";
  const END = 400;

  const canvas = document.getElementById('con') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas);
  const { ink, inv } = stageInk(canvas);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  const P = pictures();
  const n = P.length, NC = CAPTIONS.length;
  /** A blue star: the picture the story follows when nobody hovers. */
  const FOCAL = (3 * 4 + 1) * 3;
  const S = { rule: 'shape' as Rule, loss: 'nce' as Loss, margin: 0.5, tau: 0.1, hover: -1 };
  const params = () => ({ margin: S.margin, tau: S.tau });

  let run = new Run(P, S.rule, S.loss, params());
  let runT = 0, acc = 0, hist: number[] = [];
  /** Chapter 3 runs pull alone first, then the real loss. */
  let phase: 'pull' | 'push' = 'push';
  function fresh(rule: Rule, loss: Loss) {
    run = new Run(P, rule, loss, params());
    runT = 0;
    acc = 0;
    hist = [];
  }
  /** Chapter 4 keeps one run per loss, each trained in turn as it is shown. */
  let trio: Record<string, Run> = {};
  const makeTrio = () => {
    trio = Object.fromEntries((['pairs', 'triplet', 'nce'] as Loss[]).map((l) => [l, new Run(P, S.rule, l, params())]));
  };

  // ---------- geometry ----------
  type V3 = [number, number, number];
  const O = { x: 676, y: 410, s: 196 };
  const CARD = { x: 30, y: 236, w: 340 };
  const view3 = { ang: 0.6, tilt: 0.35, turned: false };
  const view = stageCamera(canvas, W, H, {
    canTurn: () => true,
    turn: (dx, dy) => {
      view3.turned = true;
      view3.ang -= dx * 0.01;
      view3.tilt = Math.max(-1.3, Math.min(1.3, view3.tilt + dy * 0.01));
    },
  });
  function project(p: V3 | Float64Array | number[]) {
    const ca = Math.cos(view3.ang), sa = Math.sin(view3.ang);
    const x = p[0] * ca + p[2] * sa, z = -p[0] * sa + p[2] * ca;
    const ct = Math.cos(view3.tilt), st2 = Math.sin(view3.tilt);
    const y = p[1] * ct - z * st2, z2 = p[1] * st2 + z * ct;
    const f = 5 / (5 - z2);
    return { x: view.X(O.x + x * O.s * f), y: view.Y(O.y - y * O.s * f), z: z2, f };
  }
  /** What is drawn: every picture, then every caption, eased towards where the network puts them. */
  const Yd = new Float64Array(3 * (n + NC));
  let first = true;
  const vecOf = (i: number): V3 => [Yd[3 * i], Yd[3 * i + 1], Yd[3 * i + 2]];
  const hx = new Float64Array(n + NC), hy = new Float64Array(n + NC), hz = new Float64Array(n + NC), hf = new Float64Array(n + NC);
  /** Points on the far side of the sphere fade back. */
  const depthA = (i: number) => 0.3 + 0.7 * clamp01((hz[i] + 0.6) / 1.4);
  const showsCaptions = (ch: number, rule: Rule) => rule === 'caption' && ch !== 0;

  // ---------- chapters ----------
  const chapters = [
    {
      dur: 9,
      title: 'A space where near means alike',
      body: 'A network places every picture somewhere on a sphere. We want alike things close and different things far, so that finding similar things is just looking nearby. Untrained, the places mean nothing yet.',
    },
    {
      dur: 16,
      title: 'You only say who is a pair',
      body: 'Nobody says where anything goes. You pick one rule for which two things count as a pair; everything else is not a pair. Labels, random versions of one picture, a picture and its caption: same method, different rule.',
    },
    {
      dur: Infinity,
      title: 'Pull the pairs, push the rest',
      body: 'The loss pulls every pair together. Pull alone has a lazy perfect answer: put everything in one place. So it also pushes apart whatever is not a pair, and the space sorts itself out.',
    },
    {
      dur: 18,
      title: 'Three ways to say it',
      body: 'Pairs, triplet and InfoNCE all pull pairs and push the rest. They differ in how hard they push and when they stop: at a margin, once the order is right, or never quite, with the nearest pushing hardest.',
    },
    {
      dur: Infinity,
      title: 'What it is for',
      body: 'Now near means alike, in the sense the rule chose. Finding similar things is a lookup of the nearest points: the idea behind image search, face recognition and finding pictures from words.',
    },
  ];

  const st = story({
    chapters,
    enter(i) {
      if (i <= 1) fresh(S.rule, S.loss);
      if (i === 2) { fresh(S.rule, 'pull'); phase = 'pull'; }
      if (i === 3) makeTrio();
      if (i === 4) {
        const same = run.rule === S.rule && run.loss === S.loss && run.k.margin === S.margin && run.k.tau === S.tau;
        if (!same) fresh(S.rule, S.loss);
        query = 0;
      }
    },
    done: (i, t) => (i === 2 ? phase === 'push' && run.step >= END && runT > 15 : t >= chapters[i].dur),
    relevant: (i) => (i === 0 ? [] : i === 1 ? ['rule'] : i === 3 ? ['rule', 'mar', 'tau'] : null),
    frame,
  });

  const shownLoss = (t: number): Loss => (st.manual() ? S.loss : t < 6 ? 'pairs' : t < 12 ? 'triplet' : 'nce');
  const RULES: Rule[] = ['shape', 'colour', 'versions', 'caption'];
  const shownRule = (ch: number, t: number): Rule => (ch === 1 && !st.manual() && t < 14.4 ? RULES[Math.floor(t / 3.6)] : S.rule);

  function steps(k: number, r: Run, cap: number) {
    acc += k;
    while (acc >= 1 && r.step < cap) {
      r.learn();
      if (r === run) hist.push(r.L);
      acc -= 1;
    }
    if (r.step >= cap) acc = 0;
  }
  function train(ch: number, t: number, live: number) {
    if (live <= 0) return;
    if (ch === 2) {
      runT += live;
      if (phase === 'pull' && runT > 7 && !st.manual()) { fresh(S.rule, S.loss); phase = 'push'; }
      const rate = phase === 'pull' ? 25 : runT < 4 ? 2 : Math.min(60, 2 + (runT - 4) ** 2 * 15);
      steps(rate * live, run, END);
    } else if (ch === 3) {
      const r = trio[shownLoss(t)];
      for (let k = 0; k < 12 && r.step < END; k++) r.learn();
    } else if (ch === 4) steps(90 * live, run, END);
  }

  // ---------- drawing ----------
  let before = 0;
  function frame(ch: number, t: number, _dt: number, live: number) {
    const light = isLight(canvas);
    const now = performance.now(), real = before ? Math.min(0.05, (now - before) / 1000) : 0;
    before = now;
    view.tick();
    if (!view3.turned && S.hover < 0) view3.ang += real * 0.12;
    train(ch, t, live);
    const r = ch === 3 ? trio[shownLoss(t)] : run;
    const Y = r.layout();
    const k = ch === 3 ? 0.08 : 0.3;
    for (let i = 0; i < Yd.length; i++) Yd[i] = first ? Y[i] : lerp(Yd[i], Y[i], k);
    first = false;
    // eased points slip off the sphere; put them back on it
    for (let i = 0; i < n + NC; i++) {
      const l = Math.hypot(Yd[3 * i], Yd[3 * i + 1], Yd[3 * i + 2]) || 1;
      for (let c = 0; c < 3; c++) Yd[3 * i + c] /= l;
      const p = project(vecOf(i));
      hx[i] = p.x; hy[i] = p.y; hz[i] = p.z; hf[i] = p.f;
    }

    ctx.clearRect(0, 0, W, H);
    sphere(light);
    const rule = shownRule(ch, t);
    const anchor = S.hover >= 0 ? S.hover : FOCAL;

    if (ch === 0) neighbours0(t, anchor);
    if (ch === 1) pairsOf(rule, t, anchor);
    if (ch === 2 || ch === 3) forces(r, anchor, ch === 3 ? 0.6 : 1);
    if (ch === 4) lookups(t);

    // the pictures, and the captions when they take part
    const fade = ch === 0 ? (i: number) => beat(t, (i % 9) * 0.08, 0.6 + (i % 9) * 0.08) : () => 1;
    const capA = ch === 1 ? (rule === 'caption' ? segA(t, 3) : 0) : showsCaptions(ch, S.rule) ? 1 : 0;
    const order = Array.from({ length: capA > 0 ? n + NC : n }, (_, i) => i).sort((a, b) => hz[a] - hz[b]);
    for (const i of order) {
      if (i < n) icon(P[i], hx[i], hy[i], fade(i) * depthA(i), hf[i], light);
      else pill(i - n, hx[i], hy[i], capA * depthA(i));
    }

    if (ch === 1) versionsOf(rule, t, anchor, light);
    if (ch === 2) words2(anchor);
    if (S.hover >= 0) ring(hx[S.hover], hy[S.hover]);

    if (ch === 0) lookupCard(anchor, beat(t, 2.6, 3.4), false, light);
    if (ch === 1) ruleCards(rule, light);
    if (ch === 2) forceCard(anchor);
    if (ch === 3) lossCard(shownLoss(t), t);
    if (ch === 4) lookupCard(queryNow(), 1, true, light);

    headline(ctx, ink, { index: ch, count: chapters.length, title: chapters[ch].title, body: chapters[ch].body, t, width: 470, manual: st.manual() });
    say(ctx, 'the embedding space', W - 24, 196, { colour: ink(0.55), size: 13, weight: 600, align: 'right' });
    if (ch >= 2) say(ctx, `step ${r.step} · loss ${r.L.toFixed(3)}`, W - 24, 216, { colour: ink(0.42), size: 12, align: 'right' });
    if (view.away) say(ctx, 'double-click to reset the view', W - 16, H - 14, { colour: ink(0.45), size: 12, align: 'right' });
    panelText(ch, r, Y);
    eqTick(ch, t);
  }

  function sphere(light: boolean) {
    ctx.save();
    ctx.strokeStyle = light ? 'rgba(28,30,36,0.08)' : 'rgba(232,233,236,0.07)';
    ctx.lineWidth = 1;
    const ring = (f: (u: number) => V3) => {
      ctx.beginPath();
      for (let k = 0; k <= 64; k++) {
        const p = project(f((2 * Math.PI * k) / 64));
        k ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y);
      }
      ctx.stroke();
    };
    for (const el of [-60, -30, 0, 30, 60]) {
      const e = (el * Math.PI) / 180;
      ring((u) => [Math.cos(e) * Math.cos(u), Math.sin(e), Math.cos(e) * Math.sin(u)]);
    }
    for (let m = 0; m < 6; m++) {
      const a2 = (m * Math.PI) / 6;
      ring((u) => [Math.cos(u) * Math.cos(a2), Math.sin(u), Math.cos(u) * Math.sin(a2)]);
    }
    ctx.restore();
  }

  /** The short way between two points on the sphere, along its surface. */
  function arc(u: V3, v: V3, col: string, a: number, w: number) {
    const c = Math.max(-1, Math.min(1, u[0] * v[0] + u[1] * v[1] + u[2] * v[2])), th = Math.acos(c);
    if (a <= 0.005) return;
    const steps = Math.max(2, Math.ceil(th * 10)), sn = Math.sin(th);
    ctx.save();
    ctx.strokeStyle = withAlpha(col, a);
    ctx.lineWidth = w;
    ctx.lineCap = 'round';
    ctx.beginPath();
    for (let k = 0; k <= steps; k++) {
      const s2 = k / steps;
      // slerp, or a straight blend when the two are nearly the same point
      const wa = sn < 1e-4 ? 1 - s2 : Math.sin((1 - s2) * th) / sn, wb = sn < 1e-4 ? s2 : Math.sin(s2 * th) / sn;
      const p = project([wa * u[0] + wb * v[0], wa * u[1] + wb * v[1], wa * u[2] + wb * v[2]]);
      k ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y);
    }
    ctx.stroke();
    ctx.restore();
  }

  /** A little picture: its shape, in its colour, at its size and turn. */
  function icon(p: { shape: number; colour: number; size?: number; turn?: number }, x: number, y: number, a = 1, scale = 1, light = false) {
    if (a <= 0) return;
    const r = 7 * (p.size ?? 1) * scale;
    ctx.save();
    ctx.globalAlpha = a;
    ctx.translate(x, y);
    ctx.rotate(p.turn ?? 0);
    ctx.beginPath();
    if (p.shape === 0) ctx.arc(0, 0, r, 0, Math.PI * 2);
    else if (p.shape === 1)
      for (let k = 0; k < 3; k++) {
        const a2 = -Math.PI / 2 + (k * 2 * Math.PI) / 3;
        ctx[k ? 'lineTo' : 'moveTo'](1.3 * r * Math.cos(a2), 1.3 * r * Math.sin(a2));
      }
    else if (p.shape === 2) ctx.rect(-0.88 * r, -0.88 * r, 1.76 * r, 1.76 * r);
    else
      for (let k = 0; k < 10; k++) {
        const a2 = -Math.PI / 2 + (k * Math.PI) / 5, rr = k % 2 ? 0.55 * r : 1.35 * r;
        ctx[k ? 'lineTo' : 'moveTo'](rr * Math.cos(a2), rr * Math.sin(a2));
      }
    ctx.closePath();
    ctx.fillStyle = COL[p.colour];
    ctx.fill();
    ctx.lineWidth = 1.2;
    ctx.strokeStyle = light ? 'rgba(255,255,255,0.9)' : 'rgba(13,14,18,0.85)';
    ctx.stroke();
    ctx.restore();
  }

  const capText = (c: number) => `${COLOURS[CAPTIONS[c].colour]} ${SHAPES[CAPTIONS[c].shape]}`;
  /** A caption, as a small label in its colour. */
  function pill(c: number, x: number, y: number, a = 1, big = false) {
    if (a <= 0) return;
    ctx.save();
    ctx.globalAlpha = a;
    ctx.font = `600 ${big ? 13 : 11}px ${SANS}`;
    const text = capText(c), w = ctx.measureText(text).width + 14, h = big ? 22 : 18;
    ctx.beginPath();
    ctx.roundRect(x - w / 2, y - h / 2, w, h, h / 2);
    ctx.fillStyle = inv(0.92);
    ctx.fill();
    ctx.strokeStyle = COL[CAPTIONS[c].colour];
    ctx.lineWidth = 1.5;
    ctx.stroke();
    ctx.fillStyle = ink(0.92);
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(text, x, y + 0.5);
    ctx.restore();
  }

  function ring(x: number, y: number) {
    ctx.beginPath();
    ctx.arc(x, y, 14, 0, Math.PI * 2);
    ctx.strokeStyle = ink(0.9);
    ctx.lineWidth = 1.5;
    ctx.stroke();
  }

  function line(x1: number, y1: number, x2: number, y2: number, col: string, a: number, w: number, dash = false) {
    ctx.save();
    ctx.strokeStyle = withAlpha(col, a);
    ctx.lineWidth = w;
    if (dash) ctx.setLineDash([4, 4]);
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y2);
    ctx.stroke();
    ctx.restore();
  }

  /** The k nearest pictures to item q (a picture or a caption), on the drawn layout. */
  function nearest(q: number, k = 5) {
    const d = (j: number) => (Yd[3 * q] - Yd[3 * j]) ** 2 + (Yd[3 * q + 1] - Yd[3 * j + 1]) ** 2 + (Yd[3 * q + 2] - Yd[3 * j + 2]) ** 2;
    return Array.from({ length: n }, (_, j) => j).filter((j) => j !== q).sort((a, b) => d(a) - d(b)).slice(0, k)
      .map((j) => ({ j, d: Math.sqrt(d(j)) }));
  }
  /** Does picture j answer a lookup for q in the sense the rule chose? */
  function matches(q: number, j: number) {
    const a = q < n ? P[q] : CAPTIONS[q - n], b = P[j];
    if (S.rule === 'caption') return a.shape === b.shape && a.colour === b.colour;
    return S.rule === 'colour' ? a.colour === b.colour : a.shape === b.shape;
  }

  // chapter 1: an untrained network, and the nearest neighbours it gives
  function neighbours0(t: number, i: number) {
    const a = beat(t, 2.6, 3.4);
    if (a <= 0) return;
    for (const { j } of nearest(i)) arc(vecOf(i), vecOf(j), ACC, 0.7 * a, 1.6);
    ring(hx[i], hy[i]);
  }

  // chapter 2: who is a pair under each rule
  /** Fade of the i-th rule's turn in chapter 2, or 1 once the reader has picked. */
  const segA = (t: number, i: number) => (st.manual() || t >= 14.4 ? 1 : beat(t - i * 3.6, 0, 0.5) * (i === 3 ? 1 : 1 - beat(t - i * 3.6, 3.1, 3.6)));
  function pairsOf(rule: Rule, t: number, i: number) {
    const a = segA(t, RULES.indexOf(rule));
    if (rule === 'versions') return;
    let posAt = -1, negAt = -1;
    const targets = rule === 'caption' ? Array.from({ length: NC }, (_, c) => n + c) : Array.from({ length: n }, (_, j) => j);
    for (const j of targets) {
      if (j === i) continue;
      const q = j < n ? P[j] : CAPTIONS[j - n], p = P[i];
      const pair = rule === 'caption' ? p.shape === q.shape && p.colour === q.colour : rule === 'shape' ? p.shape === q.shape : p.colour === q.colour;
      arc(vecOf(i), vecOf(j), pair ? PULL : PUSH, (pair ? 0.75 : 0.13) * a, pair ? 1.8 : 1);
      if (pair && posAt < 0) posAt = j;
      if (!pair && negAt < 0) negAt = j;
    }
    ring(hx[i], hy[i]);
    if (posAt >= 0) say(ctx, 'a pair', (hx[i] + hx[posAt]) / 2, (hy[i] + hy[posAt]) / 2 - 10, { colour: PULL, size: 13, weight: 650, align: 'center', alpha: a, halo: inv(0.85) });
    if (negAt >= 0) say(ctx, 'not a pair', (hx[i] + hx[negAt]) / 2, (hy[i] + hy[negAt]) / 2 - 10, { colour: PUSH, size: 13, weight: 650, align: 'center', alpha: a, halo: inv(0.85) });
  }
  /** Two random versions of picture i, the same two every time it is shown. */
  const versionsCache = new Map<number, Pic[]>();
  function versionsOf2(i: number) {
    let v = versionsCache.get(i);
    if (!v) {
      const r = rng(97 + i);
      v = [alter(P[i], r), alter(P[i], r)];
      versionsCache.set(i, v);
    }
    return v;
  }
  function versionsOf(rule: Rule, t: number, i: number, light: boolean) {
    if (rule !== 'versions' || i >= n) return;
    const a = segA(t, 2), [v1, v2] = versionsOf2(i);
    const x1 = hx[i] - 44, x2 = hx[i] + 44, y = hy[i] - 46;
    line(hx[i], hy[i], x1, y, ink(1), 0.4 * a, 1, true);
    line(hx[i], hy[i], x2, y, ink(1), 0.4 * a, 1, true);
    line(x1, y, x2, y, PULL, 0.9 * a, 2.2);
    for (const [v, x] of [[v1, x1], [v2, x2]] as [Pic, number][]) {
      ctx.save();
      ctx.globalAlpha = a;
      ctx.beginPath();
      ctx.arc(x, y, 17, 0, Math.PI * 2);
      ctx.fillStyle = inv(0.9);
      ctx.fill();
      ctx.strokeStyle = withAlpha(PULL, 0.8);
      ctx.lineWidth = 1.5;
      ctx.stroke();
      ctx.restore();
      icon(v, x, y, a, 1.15, light);
    }
    say(ctx, 'two random versions: a pair', hx[i], y - 30, { colour: PULL, size: 13, weight: 650, align: 'center', alpha: a, halo: inv(0.85) });
    say(ctx, 'every other picture: not a pair', hx[i], hy[i] + 26, { colour: PUSH, size: 12.5, weight: 600, align: 'center', alpha: a, halo: inv(0.85) });
    ring(hx[i], hy[i]);
  }

  // chapters 3 and 4: the pull and push on one item, from the loss itself
  const dd = new Float64Array(2 * (n + NC));
  const rowVec = (r: Run, j: number): V3 => [r.Z[3 * j], r.Z[3 * j + 1], r.Z[3 * j + 2]];
  /** The batch row the story follows, and where each row of the batch is drawn. */
  function rowsOf(r: Run, i: number) {
    const vers = r.rule === 'versions';
    const a = vers ? (i < n ? i : FOCAL) : r.rule === 'caption' ? i : i < n ? i : FOCAL;
    const at = (j: number): V3 => (vers ? rowVec(r, j) : vecOf(r.B.src[j]));
    return { a, at };
  }
  function forces(r: Run, i: number, alpha: number) {
    const { a, at } = rowsOf(r, i);
    pushes(r.Z, r.B, r.loss, r.k, a, dd);
    let mx = 1e-12;
    for (let j = 0; j < r.B.m; j++) mx = Math.max(mx, Math.abs(dd[j]));
    const A = at(a);
    for (let j = 0; j < r.B.m; j++) {
      if (!dd[j]) continue;
      const u = Math.abs(dd[j]) / mx;
      arc(A, at(j), dd[j] > 0 ? PULL : PUSH, alpha * (0.15 + 0.7 * u), 0.6 + 2.4 * u);
    }
    const pa = project(A);
    if (r.rule === 'versions' && r.B.vers) {
      // the two versions the batch made of it this step
      const T = at(a + n), pt = project(T);
      arc(A, T, PULL, 0.9 * alpha, 2.2);
      icon(r.B.vers[a], pa.x, pa.y, alpha, 1.1 * pa.f);
      icon(r.B.vers[a + n], pt.x, pt.y, alpha, 1.1 * pt.f);
      ring(pa.x, pa.y);
      ring(pt.x, pt.y);
    } else ring(pa.x, pa.y);
  }

  /** How far the pictures are from all sitting in one place. */
  function spread() {
    const m: V3 = [0, 0, 0];
    let s = 0;
    for (let i = 0; i < n; i++) for (let c = 0; c < 3; c++) m[c] += Yd[3 * i + c] / n;
    for (let i = 0; i < n; i++) s += Math.hypot(Yd[3 * i] - m[0], Yd[3 * i + 1] - m[1], Yd[3 * i + 2] - m[2]) / n;
    const p = project(m);
    return { s, x: p.x, y: p.y };
  }
  function words2(i: number) {
    const A = { x: hx[i < n ? i : FOCAL], y: hy[i < n ? i : FOCAL] };
    if (phase === 'pull') {
      say(ctx, 'only pull: pairs together', A.x, A.y - 26, { colour: PULL, size: 14, weight: 650, align: 'center', alpha: 1 - beat(runT, 3, 3.6), halo: inv(0.85) });
      const sp = spread();
      if (sp.s < 0.06 && run.step > 20) {
        const b = beat(-sp.s, -0.06, -0.02);
        say(ctx, 'collapse: everything in one place', sp.x, sp.y - 42, { colour: PUSH, size: 15, weight: 650, align: 'center', alpha: b, halo: inv(0.85) });
        say(ctx, 'every pair is perfect, and the space is useless', sp.x, sp.y - 22, { colour: ink(0.8), size: 13, align: 'center', alpha: b, halo: inv(0.85) });
      }
    } else {
      const b = 1 - beat(runT, 5, 6);
      say(ctx, 'now also push what is not a pair', A.x, A.y - 26, { colour: PUSH, size: 14, weight: 650, align: 'center', alpha: b, halo: inv(0.85) });
    }
  }

  // ---------- the card on the left ----------
  function card(y: number, h: number, on: number, light: boolean) {
    ctx.save();
    ctx.beginPath();
    ctx.roundRect(CARD.x, y, CARD.w, h, 12);
    // opaque, so the turning sphere passes behind it
    ctx.fillStyle = inv(0.94);
    ctx.fill();
    ctx.fillStyle = light ? 'rgba(28,30,36,0.035)' : 'rgba(255,255,255,0.03)';
    ctx.fill();
    ctx.strokeStyle = on ? withAlpha(ACC, 0.7) : ink(0.08);
    ctx.lineWidth = on ? 1.5 : 1;
    ctx.stroke();
    ctx.restore();
  }

  function lookupCard(q: number, a: number, marks: boolean, light: boolean) {
    if (a <= 0) return;
    ctx.save();
    ctx.globalAlpha = a;
    card(CARD.y, 360, 0, light);
    say(ctx, 'look up', CARD.x + 16, CARD.y + 22, { colour: ink(0.55), size: 12.5, weight: 600 });
    if (q < n) icon(P[q], CARD.x + 100, CARD.y + 22, 1, 1.5, light);
    else pill(q - n, CARD.x + 120, CARD.y + 22, 1, true);
    say(ctx, 'its 5 nearest pictures', CARD.x + 16, CARD.y + 56, { colour: ink(0.55), size: 12.5, weight: 600 });
    nearest(q).forEach(({ j, d }, k) => {
      const y = CARD.y + 92 + k * 52;
      icon(P[j], CARD.x + 40, y, 1, 1.4, light);
      say(ctx, `distance ${d.toFixed(2)}`, CARD.x + 80, y, { colour: ink(0.65), size: 12.5 });
      if (marks) {
        const ok = matches(q, j);
        say(ctx, ok ? '✓' : '✗', CARD.x + CARD.w - 30, y, { colour: ok ? PULL : PUSH, size: 18, weight: 700, align: 'center' });
      }
    });
    if (!marks) say(ctx, 'untrained: nearby means nothing yet', CARD.x + 16, CARD.y + 340, { colour: ink(0.5), size: 12 });
    ctx.restore();
  }

  const RULE_CARD: Record<Rule, { title: string; tag: string }> = {
    shape: { title: 'Same shape', tag: 'from labels · supervised' },
    colour: { title: 'Same colour', tag: 'from labels · supervised' },
    versions: { title: 'Two versions of one picture', tag: 'no labels · SimCLR' },
    caption: { title: 'A picture and its caption', tag: 'two networks · CLIP' },
  };
  function ruleCards(rule: Rule, light: boolean) {
    const star = P[FOCAL];
    RULES.forEach((r, k) => {
      const y = CARD.y + k * 92, on = r === rule;
      ctx.save();
      ctx.globalAlpha = on ? 1 : 0.42;
      card(y, 82, on ? 1 : 0, light);
      say(ctx, RULE_CARD[r].title, CARD.x + 14, y + 20, { colour: ink(0.95), size: 14, weight: 650 });
      say(ctx, RULE_CARD[r].tag, CARD.x + 14, y + 38, { colour: ink(0.5), size: 11.5 });
      const ey = y + 62;
      icon(star, CARD.x + 26, ey, 1, 1.1, light);
      say(ctx, '+', CARD.x + 48, ey, { colour: PULL, size: 16, weight: 700, align: 'center' });
      if (r === 'shape') {
        icon({ shape: 3, colour: 0 }, CARD.x + 70, ey, 1, 1.1, light);
        say(ctx, 'pair', CARD.x + 88, ey, { colour: PULL, size: 12 });
        icon({ shape: 0, colour: 1 }, CARD.x + 170, ey, 1, 1.1, light);
        say(ctx, 'not a pair', CARD.x + 188, ey, { colour: PUSH, size: 12 });
      } else if (r === 'colour') {
        icon({ shape: 0, colour: 1 }, CARD.x + 70, ey, 1, 1.1, light);
        say(ctx, 'pair', CARD.x + 88, ey, { colour: PULL, size: 12 });
        icon({ shape: 3, colour: 0 }, CARD.x + 170, ey, 1, 1.1, light);
        say(ctx, 'not a pair', CARD.x + 188, ey, { colour: PUSH, size: 12 });
      } else if (r === 'versions') {
        const [v1] = versionsOf2(FOCAL);
        icon(v1, CARD.x + 70, ey, 1, 1.1, light);
        say(ctx, 'pair: the same picture, altered', CARD.x + 88, ey, { colour: PULL, size: 12 });
      } else {
        pill(4 * 3 + 1, CARD.x + 92, ey, 1);
        say(ctx, 'pair: the words for it', CARD.x + 128, ey, { colour: PULL, size: 12 });
      }
      ctx.restore();
    });
  }

  function forceCard(i: number) {
    const light = isLight(canvas);
    card(CARD.y, 250, 0, light);
    const { a } = rowsOf(run, i);
    let np = 0, nn = 0;
    for (let j = 0; j < run.B.m; j++) if (run.B.cand[a * run.B.m + j]) run.B.pos[a * run.B.m + j] ? np++ : nn++;
    say(ctx, 'on the ringed picture', CARD.x + 16, CARD.y + 22, { colour: ink(0.55), size: 12.5, weight: 600 });
    line(CARD.x + 16, CARD.y + 54, CARD.x + 52, CARD.y + 54, PULL, 0.9, 3);
    say(ctx, `pulled by its ${np} pair${np === 1 ? '' : 's'}`, CARD.x + 64, CARD.y + 54, { colour: ink(0.85), size: 13 });
    line(CARD.x + 16, CARD.y + 82, CARD.x + 52, CARD.y + 82, PUSH, phase === 'pull' ? 0.25 : 0.9, 3);
    say(ctx, phase === 'pull' ? 'no push yet' : `pushed by the ${nn} others`, CARD.x + 64, CARD.y + 82, { colour: ink(phase === 'pull' ? 0.45 : 0.85), size: 13 });
    // the loss so far
    const x0 = CARD.x + 16, y0 = CARD.y + 226, w = CARD.w - 32, h = 100;
    say(ctx, phase === 'pull' ? 'loss, pull alone' : `loss, ${LOSS_NAME[run.loss]}`, x0, y0 - h - 14, { colour: ink(0.55), size: 12 });
    if (hist.length > 1) {
      const top = Math.max(...hist, 1e-9);
      ctx.save();
      ctx.strokeStyle = phase === 'pull' ? PULL : ACC;
      ctx.lineWidth = 1.8;
      ctx.beginPath();
      hist.forEach((v, k) => {
        const x = x0 + (k / Math.max(END, hist.length - 1)) * w, y = y0 - (v / top) * h;
        k ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
      });
      ctx.stroke();
      ctx.restore();
    }
    ctx.strokeStyle = ink(0.15);
    ctx.beginPath();
    ctx.moveTo(x0, y0);
    ctx.lineTo(x0 + w, y0);
    ctx.stroke();
  }

  const LOSS_NAME: Record<Loss, string> = { pull: 'pull alone', pairs: 'pairs (margin)', triplet: 'triplet', nce: 'InfoNCE' };
  const LOSS_SAYS: Record<string, string[]> = {
    pairs: ['Pairs go to distance 0. Others are pushed', 'out to the margin m, then left alone.'],
    triplet: ['Only the order counts: each pair nearer', 'than each other by m. Then nothing moves.'],
    nce: ['A softmax: the nearest others push hardest,', 'far ones barely, and it never quite stops.'],
  };
  /** How hard the loss pulls a pair, and pushes a non-pair, at each distance. */
  function curve(loss: Loss, d: number, pair: boolean) {
    const m = S.margin, tau = S.tau;
    if (loss === 'pairs') return pair ? d : Math.max(0, m - d);
    // triplet: as seen with the others at 1 and the pairs at 0.2
    if (loss === 'triplet') return pair ? (d - 1 + m > 0 ? 1 : 0) : (0.2 - d + m > 0 ? 1 : 0);
    return pair ? d : d * Math.exp(-(d * d) / tau);
  }
  function lossCard(loss: Loss, t: number) {
    const light = isLight(canvas);
    card(CARD.y, 360, 0, light);
    const a = st.manual() ? 1 : beat(t % 6, 0, 0.6);
    say(ctx, LOSS_NAME[loss], CARD.x + 16, CARD.y + 24, { colour: ACC, size: 17, weight: 650, alpha: a });
    const x0 = CARD.x + 30, y0 = CARD.y + 230, w = CARD.w - 50, h = 150;
    ctx.strokeStyle = ink(0.2);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(x0, y0 - h);
    ctx.lineTo(x0, y0);
    ctx.lineTo(x0 + w, y0);
    ctx.stroke();
    say(ctx, 'distance →', x0 + w, y0 + 14, { colour: ink(0.45), size: 11.5, align: 'right' });
    say(ctx, 'force', x0 - 6, y0 - h - 10, { colour: ink(0.45), size: 11.5 });
    for (const pair of [true, false]) {
      let top = 1e-9;
      for (let k = 0; k <= 120; k++) top = Math.max(top, curve(loss, (2 * k) / 120, pair));
      ctx.save();
      ctx.strokeStyle = withAlpha(pair ? PULL : PUSH, a);
      ctx.lineWidth = 2.4;
      ctx.beginPath();
      for (let k = 0; k <= 120; k++) {
        const d = (2 * k) / 120, x = x0 + (d / 2) * w, y = y0 - (curve(loss, d, pair) / top) * (h - 10) * 0.9;
        k ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
      }
      ctx.stroke();
      ctx.restore();
    }
    say(ctx, 'pull on a pair', x0 + w, y0 - h + 4, { colour: PULL, size: 12, weight: 600, align: 'right', alpha: a });
    say(ctx, 'push on the rest', x0 + w, y0 - h + 22, { colour: PUSH, size: 12, weight: 600, align: 'right', alpha: a });
    if (loss !== 'nce') {
      const xm = x0 + (S.margin / 2) * w;
      line(xm, y0 - h + 34, xm, y0, '#fbbf24', 0.7, 1.2, true);
      say(ctx, 'm', xm, y0 + 14, { colour: '#fbbf24', size: 12, weight: 600, align: 'center' });
    }
    LOSS_SAYS[loss].forEach((l, k) => say(ctx, l, CARD.x + 16, CARD.y + 290 + k * 20, { colour: ink(0.75), size: 13, alpha: a }));
    if (loss === 'triplet') say(ctx, '(drawn with pairs at 0.2, others at 1)', CARD.x + 16, CARD.y + 336, { colour: ink(0.4), size: 11 });
  }

  // chapter 5: lookups, one after another
  let query = 0;
  const QUERIES = { pics: [FOCAL, 4, 22, 30, 11], caps: [n + 13, n + 2, n + 8, n + 7, n + 4] };
  function queryNow() {
    if (S.hover >= 0) return S.hover;
    const list = S.rule === 'caption' ? QUERIES.caps : QUERIES.pics;
    return list[query % list.length];
  }
  let lastSwitch = 0;
  function lookups(t: number) {
    if (S.hover < 0 && t - lastSwitch > 3.2) { query++; lastSwitch = t; }
    if (t < lastSwitch) lastSwitch = t;
    const q = queryNow();
    for (const { j } of nearest(q)) arc(vecOf(q), vecOf(j), matches(q, j) ? PULL : PUSH, 0.75, 1.8);
    ring(hx[q], hy[q]);
  }

  // ---------- numbers ----------
  let tick = 0;
  const NOTE: Record<Rule, string> = {
    shape: 'For each picture: does its nearest neighbour have the same shape?',
    colour: 'For each picture: does its nearest neighbour have the same colour?',
    versions: 'For each picture: does its nearest neighbour have the same shape? No label was used; the random versions change colour, never shape.',
    caption: 'For each caption: is the nearest picture the one it describes?',
  };
  function panelText(ch: number, r: Run, Y: Float64Array) {
    if (tick++ % 10) return;
    const { B, Z } = r;
    let sp = 0, cp = 0, sn = 0, cn = 0;
    for (let a = 0; a < B.m; a++)
      for (let b = a + 1; b < B.m; b++) {
        if (!B.cand[a * B.m + b]) continue;
        const d = Math.hypot(Z[3 * a] - Z[3 * b], Z[3 * a + 1] - Z[3 * b + 1], Z[3 * a + 2] - Z[3 * b + 2]);
        if (B.pos[a * B.m + b]) { sp += d; cp++; } else { sn += d; cn++; }
      }
    setRows({
      'r-step': `${r.step}`,
      'r-loss': r.L.toFixed(3),
      'r-pos': (sp / Math.max(1, cp)).toFixed(2),
      'r-neg': (sn / Math.max(1, cn)).toFixed(2),
    });
    const k = lookup(Y, P, r.rule), collapsed = spread().s < 0.06;
    setResult({
      value: `${Math.round(k * 100)}%`,
      status: collapsed ? 'collapsed: every lookup is a guess' : r.step === 0 ? 'an untrained network' : k > 0.95 ? 'near means alike' : 'still sorting',
      note: NOTE[r.rule],
      colour: k > 0.95 && !collapsed ? PULL : collapsed ? PUSH : undefined,
    });
  }

  type Part = string | [string, string];
  const EQ: Record<string, Part[]> = {
    0: ['z = f(x)', '\\qquad \\text{near} \\iff \\text{alike}'],
    1: ['\\text{you choose the pairs } (x,\\,', ['x^{+}', PULL], ')', '\\text{; every other } ', ['x^{-}', PUSH], '\\text{ is not a pair}'],
    2: ['\\mathcal L = \\textstyle\\sum \\text{pull}(', ['d^{+}', PULL], ') + \\textstyle\\sum \\text{push}(', ['d^{-}', PUSH], ')'],
    pairs: ['\\mathcal L = ', ['(d^{+})^2', PULL], '+', ['\\max(0,\\, m - d^{-})^2', PUSH]],
    triplet: ['\\mathcal L = \\max(0,\\;', ['d^{+}', PULL], '-', ['d^{-}', PUSH], '+ m)'],
    nce: ['\\mathcal L = -\\log \\dfrac{e^{-', ['(d^{+})^2', PULL], '/\\tau}}{\\sum_j e^{-', ['d_j^2', PUSH], '/\\tau}}'],
    4: ['\\text{look up } q:\\;\\; \\arg\\min_x \\|f(q) - f(x)\\|'],
  };
  let eqFor = '';
  function eqTick(ch: number, t: number) {
    const key = ch === 3 ? shownLoss(t) : String(ch);
    if (key === eqFor) return;
    eqFor = key;
    setEq({ rule: EQ[key] });
  }

  // ---------- input ----------
  canvas.addEventListener('pointerleave', () => (S.hover = -1));
  canvas.addEventListener('pointermove', (e) => {
    if (view.busy) return;
    const b = canvas.getBoundingClientRect();
    const x = ((e.clientX - b.left) / b.width) * W, y = ((e.clientY - b.top) / b.height) * H;
    const ch = st.chapter(), m = showsCaptions(ch, S.rule) ? n + NC : n;
    let best = -1, bd = 12 * 12;
    for (let i = 0; i < m; i++) {
      const d = (hx[i] - x) ** 2 + (hy[i] - y) ** 2;
      if (d < bd) { bd = d; best = i; }
    }
    S.hover = best;
    canvas.style.cursor = best >= 0 ? 'pointer' : '';
  });

  // ---------- panel ----------
  /** New settings: redo what the current chapter shows, learning live where it learns. */
  function restart() {
    const c = st.chapter();
    if (c === 2) { fresh(S.rule, S.loss); phase = 'push'; }
    else if (c === 3) makeTrio();
    else fresh(S.rule, S.loss);
  }
  const ruleSeg = segmented('rule', (v) => { S.rule = v as Rule; restart(); });
  const lossSeg = segmented('loss', (v) => { S.loss = v as Loss; restart(); });
  slider('mar', (v) => { S.margin = v / 100; restart(); }, (v) => (v / 100).toFixed(2));
  slider('tau', (v) => { S.tau = v / 100; restart(); }, (v) => (v / 100).toFixed(2));

  const pick = (rule: Rule) => { S.rule = rule; ruleSeg.select(rule); };
  tries({
    collapse: () => { st.go(2); st.play(true); },
    colour: () => { pick('colour'); st.go(4); st.play(true); },
    versions: () => { pick('versions'); st.go(4); st.play(true); },
    caption: () => { pick('caption'); st.go(4); st.play(true); },
    losses: () => { S.loss = 'nce'; lossSeg.select('nce'); st.go(3); st.play(true); },
  });

  st.start();
</script>
