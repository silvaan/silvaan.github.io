---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
---

<SimLayout
  areaSlug="deep-learning"
  title="Contrastive Learning"
  description="Nobody says where anything goes. The only instruction is that things of a kind belong together and everything else belongs apart, and the embedding arranges itself from that. Four different losses say it in four different ways, and you can watch each one push."
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="con"
          width="1000"
          height="560"
          role="img"
          aria-label="Points of several classes arranging themselves in a bounded space, with every other point laid out on a distance ruler beside them showing which way the loss is pushing it."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'pull it closer', color: '#5eead4' },
          { label: 'push it away', color: '#f87171' },
          { label: 'the margin', color: '#f59e0b' },
        ]}
        hint="Run to learn · hover any point to look at the loss from there"
      />
      <Result label="Nearest neighbour agrees" />
    </div>

    <div class="sim-panel">
      <Seg
        id="loss"
        label="Loss"
        attr="l"
        options={[
          { value: 'pairs', label: 'Pairs' },
          { value: 'triplet', label: 'Triplet' },
          { value: 'hard', label: 'Hardest triplet' },
          { value: 'nce', label: 'InfoNCE' },
        ]}
      />
      <Slider id="k" label="Classes" min={2} max={6} value={4} />
      <Slider id="m" label="Points in each" min={2} max={8} value={6} />
      <Slider id="mar" label="Margin" min={20} max={150} value={80} display="0.80" />
      <Slider id="tau" label="Temperature τ" min={3} max={60} value={15} display="0.15" hint={['sharp', 'soft']} />
      <Transport step />
      <Readout
        rows={[
          { id: 'r-loss', label: 'loss' },
          { id: 'r-in', label: 'distance within a class' },
          { id: 'r-out', label: 'distance between classes' },
          { id: 'r-viol', label: 'constraints still broken' },
          { id: 'r-nn', label: 'nearest neighbour agrees' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Every point starts in a heap in the middle and no point is told where to
      go. The only thing any of these losses knows is which points share a class,
      and the arrangement is entirely a consequence of that.
    </li>
    <li>
      Two items are never allowed to occupy the same place, which is why a class
      settles into a small packed cluster instead of a single dot. Take that rule
      away and every loss on this page would crush each class to nothing, and
      crushing a class to nothing is exactly what collapse means.
    </li>
    <li>
      Hover a point. The ruler on the right lays every other point out by its
      distance from that one, same class above the line and everything else
      below, and the arrow under each one is the direction that loss is pushing
      it. That arrow is the loss; the picture on the left is only its
      consequence.
    </li>
    <li>
      <b>Pairs</b> is the blunt version: pull every pair of the same class to
      zero, push every other pair past the margin, and stop caring once it is
      past. Watch the red arrows vanish one at a time as points cross the margin
      line. The teal ones never vanish, because a positive pair is given no
      threshold to reach and is pulled for as long as any distance remains.
    </li>
    <li>
      <b>Triplet</b> never asks for an absolute distance. It asks only that the
      same class be <em>nearer than</em> the other one by the margin, so the
      clusters are free to sit wherever they like as long as the ordering holds.
      That is why it survives classes of wildly different spread, where pairs
      does not.
    </li>
    <li>
      <b>Hardest triplet</b> keeps only the worst positive and the nearest
      negative for each point, which is most of the signal in a tiny fraction of
      the terms. It converges faster and it is far more likely to fold two
      classes together and never recover, because one bad pair now speaks for
      everything.
    </li>
    <li>
      <b>InfoNCE</b> replaces the margin with a softmax, so nothing is ever fully
      satisfied and every negative keeps contributing something. Lower the
      <b>temperature</b> and almost all the push comes from the single nearest
      wrong point, which is hard negative mining arriving for free out of the
      arithmetic. Raise it and every negative pushes about equally.
    </li>
    <li>
      The space is bounded, so pushing one thing away always costs room
      somewhere. That competition is the whole reason the classes end up spread
      round the edge rather than piled anywhere convenient.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk, roundRect, arrow } from '../../../lib/draw';
  import { el, segmented, slider, transport, result, readout } from '../../../lib/panel';

  const PULL = '#5eead4';
  const PUSH = '#f87171';
  const MARK = '#f59e0b';
  const HUES = ['#5eead4', '#f59e0b', '#a78bfa', '#f87171', '#60a5fa', '#a3e635'];
  // Two different items never land on exactly the same point. Without that rule
  // every loss here would happily crush a class to nothing, which is what
  // collapse means; with it, a class settles into a small packed cluster.
  const SEP = 0.09;

  const state = { loss: 'pairs', k: 4, m: 6, margin: 0.8, tau: 0.15, running: false, anchor: 0 };

  const canvas = el('con') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink, inv } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  // --- the points ------------------------------------------------------------
  // Every embedding is a free pair of numbers. Nothing produces them, so what is
  // on screen is the loss and nothing else.
  let P: number[][] = [];
  let cls: number[] = [];
  let trace: number[] = [];
  let mAdam: number[][] = [], vAdam: number[][] = [], tAdam = 0;

  const N = () => state.k * state.m;

  function scatter() {
    P = [];
    cls = [];
    for (let c = 0; c < state.k; c++)
      for (let i = 0; i < state.m; i++) {
        const r = 0.12 * Math.sqrt(Math.random()), a = Math.random() * Math.PI * 2;
        P.push([r * Math.cos(a), r * Math.sin(a)]);
        cls.push(c);
      }
    mAdam = P.map(() => [0, 0]);
    vAdam = P.map(() => [0, 0]);
    tAdam = 0;
    trace = [];
    if (state.anchor >= P.length) state.anchor = 0;
  }

  const dist = (i: number, j: number) => Math.hypot(P[i][0] - P[j][0], P[i][1] - P[j][1]);

  /**
   * Every loss here is a rule about distances, so each one is written as the
   * derivative it wants with respect to one distance. Turning that into a
   * gradient on the points is the same three lines for all of them.
   */
  function lossAndGrad() {
    const n = N(), m = state.margin, t = state.tau;
    const g: number[][] = P.map(() => [0, 0]);
    let loss = 0, broken = 0;
    // dL/dd for the pair (i, j), applied to both ends
    const apply = (i: number, j: number, dd: number, d: number) => {
      if (!dd || d < 1e-9) return;
      const ux = (P[i][0] - P[j][0]) / d, uy = (P[i][1] - P[j][1]) / d;
      g[i][0] += dd * ux;
      g[i][1] += dd * uy;
      g[j][0] -= dd * ux;
      g[j][1] -= dd * uy;
    };

    if (state.loss === 'pairs') {
      let pairs = 0;
      for (let i = 0; i < n; i++)
        for (let j = i + 1; j < n; j++) {
          const d = dist(i, j);
          pairs++;
          if (cls[i] === cls[j]) {
            loss += d * d;
            apply(i, j, 2 * d, d);
          } else if (d < m) {
            loss += (m - d) ** 2;
            apply(i, j, -2 * (m - d), d);
            broken++;
          }
        }
      loss /= Math.max(1, pairs);
      for (const q of g) { q[0] /= pairs; q[1] /= pairs; }
    } else if (state.loss === 'triplet' || state.loss === 'hard') {
      const hard = state.loss === 'hard';
      let terms = 0;
      for (let i = 0; i < n; i++) {
        const pos: number[] = [], neg: number[] = [];
        for (let j = 0; j < n; j++) {
          if (j === i) continue;
          (cls[j] === cls[i] ? pos : neg).push(j);
        }
        if (!pos.length || !neg.length) continue;
        // batch hard keeps the positive that is furthest and the negative that is nearest
        const ps = hard ? [pos.reduce((a, b) => (dist(i, b) > dist(i, a) ? b : a))] : pos;
        const ns = hard ? [neg.reduce((a, b) => (dist(i, b) < dist(i, a) ? b : a))] : neg;
        for (const p of ps)
          for (const q of ns) {
            terms++;
            const dp = dist(i, p), dn = dist(i, q);
            const v = dp - dn + m;
            if (v <= 0) continue;
            broken++;
            loss += v;
            apply(i, p, 1, dp);
            apply(i, q, -1, dn);
          }
      }
      loss /= Math.max(1, terms);
      for (const q of g) { q[0] /= Math.max(1, terms); q[1] /= Math.max(1, terms); }
    } else {
      for (let i = 0; i < n; i++) {
        const others: number[] = [];
        for (let j = 0; j < n; j++) if (j !== i) others.push(j);
        const pos = others.filter((j) => cls[j] === cls[i]);
        if (!pos.length) continue;
        const s = others.map((j) => -(dist(i, j) ** 2) / t);
        let mx = -Infinity;
        for (const v of s) mx = Math.max(mx, v);
        let sum = 0;
        const ex = s.map((v) => {
          const e = Math.exp(v - mx);
          sum += e;
          return e;
        });
        const lse = Math.log(sum) + mx;
        for (const p of pos) loss += (lse - s[others.indexOf(p)]) / (pos.length * n);
        others.forEach((j, idx) => {
          const q = ex[idx] / sum;
          const dLds = (q - (cls[j] === cls[i] ? 1 / pos.length : 0)) / n;
          const d = dist(i, j);
          // s = -d²/τ, so dL/dd = dL/ds · (-2d/τ)
          apply(i, j, dLds * (-2 * d) / t, d);
        });
      }
      broken = -1;
    }
    return { loss, g, broken };
  }

  /** Adam, so every loss moves at a comparable speed however it is scaled. */
  function stepOnce() {
    const { loss, g } = lossAndGrad();
    tAdam++;
    const lr = 0.02, b1 = 0.9, b2 = 0.999, eps = 1e-8;
    const c1 = 1 - Math.pow(b1, tAdam), c2 = 1 - Math.pow(b2, tAdam);
    for (let i = 0; i < P.length; i++)
      for (let k = 0; k < 2; k++) {
        mAdam[i][k] = b1 * mAdam[i][k] + (1 - b1) * g[i][k];
        vAdam[i][k] = b2 * vAdam[i][k] + (1 - b2) * g[i][k] * g[i][k];
        P[i][k] -= (lr * (mAdam[i][k] / c1)) / (Math.sqrt(vAdam[i][k] / c2) + eps);
      }
    // the space is bounded, so room is finite and pushing costs something
    for (const p of P) {
      const r = Math.hypot(p[0], p[1]);
      if (r > 1) { p[0] /= r; p[1] /= r; }
    }
    // and no two items share a point, so a class packs rather than vanishes
    for (let pass = 0; pass < 3; pass++) {
      for (let i = 0; i < P.length; i++)
        for (let j = i + 1; j < P.length; j++) {
          let dx = P[i][0] - P[j][0], dy = P[i][1] - P[j][1];
          let d = Math.hypot(dx, dy);
          if (d >= SEP) continue;
          if (d < 1e-6) { dx = Math.cos(i * 2.4) * 1e-3; dy = Math.sin(i * 2.4) * 1e-3; d = 1e-3; }
          const push = (SEP - d) / 2 / d;
          P[i][0] += dx * push;
          P[i][1] += dy * push;
          P[j][0] -= dx * push;
          P[j][1] -= dy * push;
        }
      for (const p of P) {
        const r = Math.hypot(p[0], p[1]);
        if (r > 1) { p[0] /= r; p[1] /= r; }
      }
    }
    trace.push(loss);
    if (trace.length > 260) trace.shift();
  }

  /** What the loss asks of every other point, seen from one of them. */
  function fromAnchor(i: number) {
    const n = N(), m = state.margin, t = state.tau;
    const out: { j: number; d: number; dd: number; same: boolean }[] = [];
    const others: number[] = [];
    for (let j = 0; j < n; j++) if (j !== i) others.push(j);

    if (state.loss === 'nce') {
      const s = others.map((j) => -(dist(i, j) ** 2) / t);
      let mx = -Infinity;
      for (const v of s) mx = Math.max(mx, v);
      let sum = 0;
      const ex = s.map((v) => {
        const e = Math.exp(v - mx);
        sum += e;
        return e;
      });
      const np = others.filter((j) => cls[j] === cls[i]).length || 1;
      others.forEach((j, idx) => {
        const q = ex[idx] / sum;
        const d = dist(i, j);
        out.push({ j, d, dd: (q - (cls[j] === cls[i] ? 1 / np : 0)) * (-2 * d) / t, same: cls[j] === cls[i] });
      });
      return out;
    }
    if (state.loss === 'pairs') {
      for (const j of others) {
        const d = dist(i, j), same = cls[j] === cls[i];
        out.push({ j, d, dd: same ? 2 * d : d < m ? -2 * (m - d) : 0, same });
      }
      return out;
    }
    const hard = state.loss === 'hard';
    const pos = others.filter((j) => cls[j] === cls[i]);
    const neg = others.filter((j) => cls[j] !== cls[i]);
    const ps = hard && pos.length ? [pos.reduce((a, b) => (dist(i, b) > dist(i, a) ? b : a))] : pos;
    const ns = hard && neg.length ? [neg.reduce((a, b) => (dist(i, b) < dist(i, a) ? b : a))] : neg;
    const w = new Map<number, number>();
    for (const p of ps)
      for (const q of ns) {
        if (dist(i, p) - dist(i, q) + m <= 0) continue;
        w.set(p, (w.get(p) ?? 0) + 1);
        w.set(q, (w.get(q) ?? 0) - 1);
      }
    for (const j of others) out.push({ j, d: dist(i, j), dd: w.get(j) ?? 0, same: cls[j] === cls[i] });
    return out;
  }

  // --- layout ----------------------------------------------------------------
  const DISC = { x: 282, y: 306, r: 190 };
  const RUL = { x: 578, y: 274, w: 366 };
  const TR = { x: 578, y: 428, w: 366, h: 92 };
  const sx = (p: number[]) => DISC.x + p[0] * DISC.r;
  const sy = (p: number[]) => DISC.y - p[1] * DISC.r;
  const near0 = (v: number, n: number) => (Math.abs(v) < 0.5 * 10 ** -n ? 0 : v).toFixed(n);

  function disc() {
    label('the embedding space', DISC.x - DISC.r, 92, 0.55, 'left', 13);
    label('colour is the class, and nothing else is given', DISC.x - DISC.r, 110, 0.32, 'left', 11);
    ctx.strokeStyle = ink(0.12);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.arc(DISC.x, DISC.y, DISC.r, 0, Math.PI * 2);
    ctx.stroke();

    const a = state.anchor;
    const rows = fromAnchor(a);
    // what the anchor is bound to, drawn where it happens
    for (const r of rows) {
      if (!r.dd) continue;
      ctx.strokeStyle = r.dd > 0 ? 'rgba(94,234,212,0.4)' : 'rgba(248,113,113,0.32)';
      ctx.lineWidth = Math.min(3, 0.6 + Math.abs(r.dd) * 1.6);
      ctx.beginPath();
      ctx.moveTo(sx(P[a]), sy(P[a]));
      ctx.lineTo(sx(P[r.j]), sy(P[r.j]));
      ctx.stroke();
    }
    if (state.loss !== 'nce') {
      ctx.strokeStyle = 'rgba(245,158,11,0.5)';
      ctx.lineWidth = 1.2;
      ctx.setLineDash([4, 4]);
      ctx.beginPath();
      ctx.arc(sx(P[a]), sy(P[a]), state.margin * DISC.r, 0, Math.PI * 2);
      ctx.stroke();
      ctx.setLineDash([]);
    }
    for (let i = 0; i < P.length; i++) {
      ctx.fillStyle = HUES[cls[i] % HUES.length];
      ctx.beginPath();
      ctx.arc(sx(P[i]), sy(P[i]), i === a ? 7.5 : 5.5, 0, Math.PI * 2);
      ctx.fill();
      if (i === a) {
        ctx.strokeStyle = ink(0.95);
        ctx.lineWidth = 2.2;
        ctx.beginPath();
        ctx.arc(sx(P[i]), sy(P[i]), 11, 0, Math.PI * 2);
        ctx.stroke();
      }
    }
  }

  const RULE: Record<string, string> = {
    pairs: 'to zero, or past the margin',
    triplet: 'nearer than the other class by the margin',
    hard: 'only the worst pair of each kind counts',
    nce: 'a softmax, so nothing is ever finished',
  };

  /** Every other point laid out by its distance, with the push it is under. */
  function ruler() {
    const a = state.anchor;
    label('what the loss asks, seen from that point', RUL.x, 92, 0.55, 'left', 13);
    label(RULE[state.loss], RUL.x, 110, 0.32, 'left', 11);

    const px = (d: number) => RUL.x + (Math.min(2, d) / 2) * RUL.w;
    ctx.strokeStyle = ink(0.2);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(RUL.x, RUL.y);
    ctx.lineTo(RUL.x + RUL.w, RUL.y);
    ctx.stroke();
    for (const d of [0, 0.5, 1, 1.5, 2]) {
      ctx.strokeStyle = ink(0.12);
      ctx.beginPath();
      ctx.moveTo(px(d), RUL.y - 4);
      ctx.lineTo(px(d), RUL.y + 4);
      ctx.stroke();
      label(d.toFixed(1), px(d), RUL.y + 18, 0.3, 'center', 10.5);
    }
    label('distance from it', RUL.x + RUL.w, RUL.y + 84, 0.32, 'right', 11);
    label('same class', RUL.x - 10, RUL.y - 22, 0.55, 'right', 11, PULL);
    label('other classes', RUL.x - 10, RUL.y + 44, 0.55, 'right', 11, PUSH);

    if (state.loss !== 'nce') {
      ctx.strokeStyle = MARK;
      ctx.lineWidth = 1.4;
      ctx.setLineDash([4, 4]);
      ctx.beginPath();
      ctx.moveTo(px(state.margin), RUL.y - 54);
      ctx.lineTo(px(state.margin), RUL.y + 64);
      ctx.stroke();
      ctx.setLineDash([]);
      label('margin', px(state.margin), RUL.y - 62, 0.7, 'center', 11, MARK);
    }

    const rows = fromAnchor(a);
    let mx = 1e-9;
    for (const r of rows) mx = Math.max(mx, Math.abs(r.dd));
    for (const r of rows) {
      const x = px(r.d), y = RUL.y + (r.same ? -26 : 40);
      ctx.fillStyle = HUES[cls[r.j] % HUES.length];
      ctx.beginPath();
      ctx.arc(x, y, 5.5, 0, Math.PI * 2);
      ctx.fill();
      if (!r.dd) continue;
      // the arrow is the loss: which way it wants this point to move
      const len = 8 + 26 * Math.min(1, Math.abs(r.dd) / mx);
      const dir = r.dd > 0 ? -1 : 1;
      const ay = y + (r.same ? -16 : 16);
      ctx.strokeStyle = r.dd > 0 ? PULL : PUSH;
      ctx.fillStyle = ctx.strokeStyle;
      ctx.lineWidth = 1.8;
      arrow(ctx, x, ay, x + dir * len, ay, 5);
    }
    const still = rows.filter((r) => r.dd).length;
    label(
      still ? `${still} of these ${rows.length} are still being pushed` : 'nothing here is being pushed any more',
      RUL.x,
      RUL.y + 108,
      0.35,
      'left',
      11.5,
      still ? undefined : PULL
    );
  }

  function tracePlot() {
    label('the loss', TR.x, TR.y - 12, 0.45, 'left', 12);
    ctx.fillStyle = inv(0.45);
    roundRect(ctx, TR.x, TR.y, TR.w, TR.h, 8);
    ctx.fill();
    if (trace.length < 2) return;
    let top = 1e-9;
    for (const v of trace) top = Math.max(top, v);
    const py = (v: number) => TR.y + TR.h - 5 - (Math.max(0, v) / top) * (TR.h - 12);
    ctx.strokeStyle = PULL;
    ctx.lineWidth = 2;
    ctx.beginPath();
    trace.forEach((v, i) => {
      const x = TR.x + 3 + (i / (trace.length - 1)) * (TR.w - 6);
      i ? ctx.lineTo(x, py(v)) : ctx.moveTo(x, py(v));
    });
    ctx.stroke();
    label(near0(trace[trace.length - 1], 3), TR.x + TR.w - 6, TR.y + 16, 0.7, 'right', 12, PULL);
  }

  function quality() {
    const n = N();
    let within = 0, wc = 0, between = 0, bc = 0, agree = 0;
    for (let i = 0; i < n; i++) {
      let best = -1;
      for (let j = 0; j < n; j++) {
        if (j === i) continue;
        const d = dist(i, j);
        if (cls[i] === cls[j]) { within += d; wc++; } else { between += d; bc++; }
        if (best < 0 || d < dist(i, best)) best = j;
      }
      if (best >= 0 && cls[best] === cls[i]) agree++;
    }
    return { within: within / Math.max(1, wc), between: between / Math.max(1, bc), agree };
  }

  const EQ: Record<string, string> = {
    pairs: '\\mathcal{L} = d_+^2 + \\max(0,\\, m - d_-)^2',
    triplet: '\\mathcal{L} = \\max(0,\\, d_+ - d_- + m)',
    hard: '\\mathcal{L} = \\max(0,\\, \\max d_+ - \\min d_- + m)',
    nce: '\\mathcal{L} = -\\log \\frac{e^{-d_+^2/\\tau}}{\\sum_j e^{-d_j^2/\\tau}}',
  };

  function draw() {
    ctx.clearRect(0, 0, W, H);
    disc();
    ruler();
    tracePlot();

    const { within, between, agree } = quality();
    const { loss, broken } = lossAndGrad();
    const n = N();
    setEq({
      rule: [[EQ[state.loss], PULL]],
      live: [
        [`d_+ = ${within.toFixed(2)}`, PULL],
        [`\\quad d_- = ${between.toFixed(2)}`, PUSH],
        state.loss === 'nce' ? `\\quad \\tau = ${state.tau.toFixed(2)}` : [`\\quad m = ${state.margin.toFixed(2)}`, MARK],
        `\\quad \\mathcal{L} = ${near0(loss, 3)}`,
      ],
    });
    setRows({
      'r-loss': near0(loss, 4),
      'r-in': within.toFixed(3),
      'r-out': between.toFixed(3),
      'r-viol': broken < 0 ? '—' : String(broken),
      'r-nn': `${agree} of ${n}`,
    });
    setResult({
      value: `${agree} of ${n}`,
      colour: agree === n ? PULL : agree < n * 0.6 ? PUSH : MARK,
      status: `${state.k} classes of ${state.m} · within ${within.toFixed(2)}, between ${between.toFixed(2)} · loss ${near0(loss, 3)}${broken < 0 ? '' : ` · ${broken} broken`}`,
      note:
        state.loss === 'nce'
          ? 'A softmax never reaches zero, so every negative goes on pushing however far away it already is. The temperature decides whether that push is shared out or spent almost entirely on the nearest wrong point.'
          : state.loss === 'hard'
            ? 'Only the furthest matching point and the nearest wrong one are used, which is where nearly all the signal lives. It learns faster and it can also drag two classes together and never let go.'
            : state.loss === 'triplet'
              ? 'Only the ordering is asked for, never a distance, so each class can sit at whatever spread suits it as long as it stays nearer to itself than to anything else.'
              : 'Every pair is given an absolute target: zero for a match, at least the margin for anything else. Once a pair is past the margin it stops contributing entirely.',
    });
  }

  // --- interaction -----------------------------------------------------------
  canvas.addEventListener('pointermove', (e) => {
    const r = canvas.getBoundingClientRect();
    const x = ((e.clientX - r.left) / r.width) * W, y = ((e.clientY - r.top) / r.height) * H;
    let best = -1, bd = 16;
    for (let i = 0; i < P.length; i++) {
      const d = Math.hypot(x - sx(P[i]), y - sy(P[i]));
      if (d < bd) { bd = d; best = i; }
    }
    canvas.style.cursor = best >= 0 ? 'pointer' : 'default';
    if (best < 0 || best === state.anchor) return;
    state.anchor = best;
    draw();
  });

  let last = 0, acc = 0;
  function loop(ts: number) {
    if (!last) last = ts;
    const dt = Math.min(0.05, (ts - last) / 1000);
    last = ts;
    if (state.running) {
      acc += dt;
      let moved = false;
      while (acc >= 0.014) {
        acc -= 0.014;
        stepOnce();
        moved = true;
      }
      if (moved) draw();
    }
    requestAnimationFrame(loop);
  }

  const restart = () => { scatter(); draw(); };
  segmented('loss', (l) => { state.loss = l; trace = []; draw(); });
  slider('k', (v) => { state.k = v; restart(); });
  slider('m', (v) => { state.m = v; restart(); });
  slider('mar', (v) => { state.margin = v / 100; trace = []; draw(); }, (v) => (v / 100).toFixed(2));
  slider('tau', (v) => { state.tau = v / 100; trace = []; draw(); }, (v) => (v / 100).toFixed(2));
  transport({
    onRun: (running) => (state.running = running),
    onStep: () => { stepOnce(); draw(); },
    onReset: () => restart(),
  });

  restart();
  requestAnimationFrame(loop);
</script>
