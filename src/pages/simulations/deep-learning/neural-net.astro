---
import SimLayout from '../../../layouts/SimLayout.astro';
---

<SimLayout
  areaSlug="deep-learning"
  title="Neural Network Playground"
  description="A small neural network learning to separate two colours of dots. Watch the decision boundary bend and fold in real time as gradient descent trains the weights, and see why depth and width let a network carve curved regions a straight line never could."
>
  <div class="sim">
    <div class="sim-stage">
      <canvas id="nn" width="600" height="600"></canvas>
    </div>

    <div class="sim-panel">
      <div class="control">
        <label>Dataset</label>
        <div class="seg" id="data">
          <button data-d="moons" class="active">Moons</button>
          <button data-d="circles">Circles</button>
          <button data-d="xor">XOR</button>
          <button data-d="spiral">Spiral</button>
        </div>
      </div>

      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <button class="btn" id="run">Train</button>
        <button class="btn ghost" id="reset">Reset</button>
      </div>

      <div class="control">
        <label>Hidden layers</label>
        <div class="seg" id="layers">
          <button data-l="0">0</button>
          <button data-l="1">1</button>
          <button data-l="2" class="active">2</button>
          <button data-l="3">3</button>
        </div>
      </div>

      <div class="control">
        <label>Neurons per layer <b id="hval">8</b></label>
        <input type="range" id="h" min="2" max="16" value="8" />
      </div>

      <div class="control">
        <label>Learning rate <b id="lrval">0.30</b></label>
        <input type="range" id="lr" min="1" max="150" value="30" />
      </div>

      <div class="control">
        <label>Activation</label>
        <div class="seg" id="act">
          <button data-a="tanh" class="active">tanh</button>
          <button data-a="relu">ReLU</button>
        </div>
      </div>

      <div class="readout">
        <div class="row"><span>Epoch</span><b id="epoch">0</b></div>
        <div class="row"><span>Loss</span><b id="loss">—</b></div>
        <div class="row"><span>Accuracy</span><b id="acc">—</b></div>
      </div>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      With <b>0 hidden layers</b> a network can only draw a straight line. Add a
      hidden layer and it starts <b>bending</b> the boundary; the neurons are
      learning their own features.
    </li>
    <li>
      Try <b>Spiral</b>, the hardest set. A narrow network stalls; widen it or
      add a layer and it finally wraps the boundary around the arms. More
      capacity buys more curvature.
    </li>
    <li>
      Push the <b>learning rate</b> up. Training gets faster until it becomes
      unstable and the loss jumps around, the same knife-edge as the gradient
      descent demo, now in many dimensions.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas } from '../../../lib/sim';

  type Pt = { x: number; y: number; y0: number };
  type Net = { sizes: number[]; W: number[][][]; b: number[][] };

  const state = {
    data: 'moons',
    layers: 2,
    hidden: 8,
    lr: 0.3,
    act: 'tanh',
    training: false,
    epoch: 0,
  };
  const DOM = 4; // input domain is [-DOM, DOM] in both axes

  const canvas = document.getElementById('nn') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const css = (v: string) => getComputedStyle(canvas).getPropertyValue(v).trim();

  let data: Pt[] = [];
  let net: Net;

  // ---- datasets (labels 0/1), coordinates in [-DOM, DOM] ----
  const rand = (a: number, b: number) => a + Math.random() * (b - a);
  function makeData(kind: string): Pt[] {
    const out: Pt[] = [];
    const n = 120;
    if (kind === 'moons') {
      for (let i = 0; i < n; i++) {
        const t = Math.PI * (i / n);
        const r = 2.2 + rand(-0.28, 0.28);
        out.push({ x: r * Math.cos(t) - 1.1, y: r * Math.sin(t) - 0.8, y0: 0 });
        out.push({ x: r * Math.cos(t) + 1.1, y: -r * Math.sin(t) + 0.8, y0: 1 });
      }
    } else if (kind === 'circles') {
      for (let i = 0; i < n; i++) {
        const a = rand(0, Math.PI * 2);
        const r0 = rand(0, 1.3);
        out.push({ x: r0 * Math.cos(a), y: r0 * Math.sin(a), y0: 0 });
        const r1 = 2.6 + rand(-0.3, 0.3);
        out.push({ x: r1 * Math.cos(a), y: r1 * Math.sin(a), y0: 1 });
      }
    } else if (kind === 'xor') {
      for (let i = 0; i < 2 * n; i++) {
        const x = rand(-3, 3);
        const y = rand(-3, 3);
        out.push({ x, y, y0: x * y > 0 ? 0 : 1 });
      }
    } else {
      for (let i = 0; i < n; i++) {
        const r = (i / n) * 3;
        const t = (i / n) * 3.2 + rand(-0.12, 0.12);
        out.push({ x: r * Math.cos(t), y: r * Math.sin(t), y0: 0 });
        out.push({ x: r * Math.cos(t + Math.PI), y: r * Math.sin(t + Math.PI), y0: 1 });
      }
    }
    return out;
  }

  // ---- tiny MLP ----
  function makeNet(): Net {
    const sizes = [2];
    for (let i = 0; i < state.layers; i++) sizes.push(state.hidden);
    sizes.push(1);
    const W: number[][][] = [[]];
    const b: number[][] = [[]];
    for (let l = 1; l < sizes.length; l++) {
      const scale = Math.sqrt(2 / sizes[l - 1]);
      const wl: number[][] = [];
      const bl: number[] = [];
      for (let j = 0; j < sizes[l]; j++) {
        const row: number[] = [];
        for (let k = 0; k < sizes[l - 1]; k++) row.push((Math.random() * 2 - 1) * scale);
        wl.push(row);
        bl.push(0);
      }
      W.push(wl);
      b.push(bl);
    }
    return { sizes, W, b };
  }

  const sigmoid = (x: number) => 1 / (1 + Math.exp(-x));
  const activate = (x: number) => (state.act === 'relu' ? Math.max(0, x) : Math.tanh(x));
  const dActivate = (x: number) =>
    state.act === 'relu' ? (x > 0 ? 1 : 0) : 1 - Math.tanh(x) ** 2;

  function forward(input: number[]) {
    const a: number[][] = [input.slice()];
    const z: (number[] | null)[] = [null];
    const L = net.sizes.length - 1;
    for (let l = 1; l <= L; l++) {
      const zl: number[] = [];
      const al: number[] = [];
      const prev = a[l - 1];
      for (let j = 0; j < net.sizes[l]; j++) {
        let s = net.b[l][j];
        const wl = net.W[l][j];
        for (let k = 0; k < prev.length; k++) s += wl[k] * prev[k];
        zl.push(s);
        al.push(l === L ? sigmoid(s) : activate(s));
      }
      z.push(zl);
      a.push(al);
    }
    return { a, z };
  }

  const predict = (x: number, y: number) => forward([x, y]).a[net.sizes.length - 1][0];

  function trainEpoch() {
    const L = net.sizes.length - 1;
    const gW: number[][][] = net.W.map((wl) => wl.map((row) => row.map(() => 0)));
    const gB: number[][] = net.b.map((bl) => bl.map(() => 0));
    let loss = 0;

    for (const pt of data) {
      const { a, z } = forward([pt.x, pt.y]);
      const out = a[L][0];
      loss += -(pt.y0 * Math.log(out + 1e-9) + (1 - pt.y0) * Math.log(1 - out + 1e-9));
      let delta = [out - pt.y0];
      for (let l = L; l >= 1; l--) {
        for (let j = 0; j < net.sizes[l]; j++) {
          gB[l][j] += delta[j];
          for (let k = 0; k < net.sizes[l - 1]; k++) gW[l][j][k] += delta[j] * a[l - 1][k];
        }
        if (l > 1) {
          const nd = new Array(net.sizes[l - 1]).fill(0);
          for (let k = 0; k < net.sizes[l - 1]; k++) {
            let s = 0;
            for (let j = 0; j < net.sizes[l]; j++) s += net.W[l][j][k] * delta[j];
            nd[k] = s * dActivate((z[l - 1] as number[])[k]);
          }
          delta = nd;
        }
      }
    }

    const lr = state.lr / data.length;
    for (let l = 1; l <= L; l++)
      for (let j = 0; j < net.sizes[l]; j++) {
        net.b[l][j] -= lr * gB[l][j];
        for (let k = 0; k < net.sizes[l - 1]; k++) net.W[l][j][k] -= lr * gW[l][j][k];
      }
    state.epoch++;
    return loss / data.length;
  }

  function accuracy() {
    let ok = 0;
    for (const pt of data) if ((predict(pt.x, pt.y) > 0.5 ? 1 : 0) === pt.y0) ok++;
    return ok / data.length;
  }

  // ---- rendering ----
  const GRID = 58;
  const sx = (x: number) => ((x + DOM) / (2 * DOM)) * W;
  const sy = (y: number) => H - ((y + DOM) / (2 * DOM)) * H;

  function mix(a: number[], b: number[], t: number) {
    return `rgb(${(a[0] + (b[0] - a[0]) * t) | 0},${(a[1] + (b[1] - a[1]) * t) | 0},${(a[2] + (b[2] - a[2]) * t) | 0})`;
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    const light = css('--stage-light') === '1';
    // class tints for the decision background
    const c0 = light ? [206, 214, 250] : [40, 52, 120];
    const c1 = light ? [250, 224, 200] : [120, 74, 40];

    const cell = W / GRID;
    for (let i = 0; i < GRID; i++)
      for (let j = 0; j < GRID; j++) {
        const x = -DOM + ((i + 0.5) / GRID) * 2 * DOM;
        const y = DOM - ((j + 0.5) / GRID) * 2 * DOM;
        const o = predict(x, y);
        ctx.fillStyle = mix(c0, c1, o);
        ctx.fillRect(i * cell, j * cell, cell + 1, cell + 1);
      }

    // data points
    const p0 = css('--accent') || '#7c8cff';
    for (const pt of data) {
      ctx.fillStyle = pt.y0 === 1 ? '#f59e0b' : p0;
      ctx.strokeStyle = light ? 'rgba(255,255,255,0.9)' : 'rgba(0,0,0,0.55)';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.arc(sx(pt.x), sy(pt.y), 4.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
    }

    (document.getElementById('epoch') as HTMLElement).textContent = String(state.epoch);
  }

  function updateMetrics(loss: number) {
    (document.getElementById('loss') as HTMLElement).textContent = loss.toFixed(4);
    (document.getElementById('acc') as HTMLElement).textContent = (accuracy() * 100).toFixed(1) + '%';
  }

  function rebuild() {
    data = makeData(state.data);
    net = makeNet();
    state.epoch = 0;
    updateMetrics(0);
    draw();
  }

  function loop() {
    if (state.training) {
      let loss = 0;
      for (let k = 0; k < 4; k++) loss = trainEpoch();
      updateMetrics(loss);
      draw();
    }
    requestAnimationFrame(loop);
  }

  // ---- controls ----
  function segBind(id: string, apply: (v: string) => void) {
    document.getElementById(id)!.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      if (!btn) return;
      document.querySelectorAll(`#${id} button`).forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      apply(btn.dataset[Object.keys(btn.dataset)[0]]!);
    });
  }
  segBind('data', (v) => {
    state.data = v;
    rebuild();
  });
  segBind('layers', (v) => {
    state.layers = +v;
    rebuild();
  });
  segBind('act', (v) => {
    state.act = v;
    rebuild();
  });

  const hEl = document.getElementById('h') as HTMLInputElement;
  hEl.addEventListener('input', () => {
    state.hidden = +hEl.value;
    (document.getElementById('hval') as HTMLElement).textContent = hEl.value;
    rebuild();
  });
  const lrEl = document.getElementById('lr') as HTMLInputElement;
  lrEl.addEventListener('input', () => {
    state.lr = +lrEl.value / 100;
    (document.getElementById('lrval') as HTMLElement).textContent = state.lr.toFixed(2);
  });

  const runBtn = document.getElementById('run') as HTMLButtonElement;
  runBtn.addEventListener('click', () => {
    state.training = !state.training;
    runBtn.textContent = state.training ? 'Pause' : 'Train';
  });
  document.getElementById('reset')!.addEventListener('click', () => {
    state.training = false;
    runBtn.textContent = 'Train';
    rebuild();
  });

  rebuild();
  requestAnimationFrame(loop);
</script>
