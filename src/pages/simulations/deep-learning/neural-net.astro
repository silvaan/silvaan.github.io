---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Checks from '../../../components/sim/Checks.astro';
import Actions from '../../../components/sim/Actions.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
---

<SimLayout
  areaSlug="deep-learning"
  title="Neuron Activations"
  description="A network trains in front of you on shapes drawn with the brush you are about to use. Draw one, watch it go through, and click any neuron to see the picture it has learned to look for."
  shortcuts={['fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas id="nn" class="nn-canvas" width="1000" height="600" role="img" aria-label="A 10 by 10 drawing grid, its pixels wired through two hidden layers of ReLU units to six softmax outputs, and the weights of the selected neuron drawn as a picture."></canvas>
      </div>
      <Caption
        legend={[{ label: 'a wire carrying a positive value', color: '#5eead4' }, { label: 'a wire carrying a negative value', color: '#f87171' }, { label: 'the selected neuron', color: '#7c8cff' }]}
        hint="Drag on the grid to draw · click a neuron to open it"
      />
      <Result label="It says" />
    </div>

    <div class="sim-panel">
      <Actions>
        <button type="button" class="btn" id="step">Random shape</button>
        <button type="button" class="btn ghost" id="reset">Clear</button>
        <button type="button" class="btn ghost" id="retrain">Train again</button>
      </Actions>
      <Seg id="brush" label="Brush" attr="b" options={[{ value: 'draw', label: 'draw' }, { value: 'erase', label: 'erase' }]} />
      <Slider id="edges" label="Connections drawn" min={2} max={100} value={18} display="18%" hint={['only the loudest', 'all of them']} />
      <Checks items={[{ id: 'signed', label: 'Colour a wire by the sign of what it carries', checked: true }]} />
      <Readout rows={[{ id: 'epoch', label: 'epoch' }, { id: 'loss', label: 'loss' }, { id: 'acc', label: 'accuracy on unseen shapes' }]} />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Draw a single <b>vertical stroke</b>, then drag it slowly sideways. The
      output barely flinches. Now tip it over towards horizontal ten degrees at
      a time. The answer does not slide, it <b>hands over</b>: vertical holds,
      then rising takes it, then horizontal, because those are the only answers
      it has anywhere near that angle. Somewhere on the way it may jump, briefly
      and with total confidence, to something absurd.
    </li>
    <li>
      Click a neuron in the <b>first hidden layer</b>. Its incoming weights are
      one number per pixel, so they are a picture, and it is drawn below the
      grid. Several of them come out as smudged strokes at some angle: nobody
      asked for edge detectors, they are just what minimising the loss produced.
    </li>
    <li>
      Turn <b>connections drawn</b> down to a few percent. What is left is the
      handful of wires actually carrying the decision. Count the units marked
      <b>off</b>: for any one stroke about half the first layer sits at exactly
      zero, and a ReLU that is off sends exactly <b>zero</b> down every wire
      leaving it, however large the weight on that wire happens to be.
    </li>
    <li>
      Watch the wires while it trains, and watch the epoch counter. Almost all
      of the movement is over in the <b>first two or three epochs</b>: the first
      layer alone changes by more than half its own size in epoch one, and
      everything after that is polishing. The loss keeps falling long after the
      picture has stopped visibly changing.
    </li>
    <li>
      Erase until only a few pixels are left. The answer does not fade towards
      "nothing", it stays <b>above 90%</b> on whichever of the six is nearest. A
      softmax has to divide one unit of probability among its outputs, so a
      classifier trained on six shapes has no way at all to say
      <b>none of these</b>, and confidence is not evidence that it was asked a
      fair question.
    </li>
    <li>
      Press <b>train again</b> a few times. The accuracy lands in the same
      place, but the pictures inside are different every run. What a particular
      neuron means is an accident of where the weights started, and only the
      layer as a whole has a fixed job. The geometry behind that job is the
      subject of
      <a href="/simulations/deep-learning/space-warping">How Layers Bend Space</a>.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { roundRect } from '../../../lib/theorem';
  import { stageInk } from '../../../lib/draw';
  import { el, segmented, slider, check, result, readout } from '../../../lib/panel';

  // ---------------------------------------------------------------------------
  // A 10x10 drawing, three layers of weights, six shapes. The training set is
  // generated with the same brush the mouse uses, so what you draw by hand is
  // the same kind of thing the network was shown, and the whole run happens in
  // the page rather than arriving as a file of numbers from somewhere else.
  // ---------------------------------------------------------------------------

  const G = 10; // the drawing is G x G
  const SZ = [G * G, 12, 8, 6];
  const L = SZ.length - 1; // three weight matrices
  const EPOCHS = 20;
  const NTRAIN = 900;
  const NTEST = 240;
  const LR = 0.25;
  const BATCH = 16;

  const CLASSES = [
    { name: 'vertical', glyph: '|' },
    { name: 'horizontal', glyph: '—' },
    { name: 'rising', glyph: '/' },
    { name: 'falling', glyph: '\\' },
    { name: 'ring', glyph: 'O' },
    { name: 'blob', glyph: '@' },
  ];

  // --- a repeatable random source -------------------------------------------
  function mulberry32(a: number) {
    return () => {
      a = (a + 0x6d2b79f5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  let rnd = mulberry32(20260823);
  const gauss = () => {
    const u = Math.max(1e-9, rnd());
    return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * rnd());
  };

  // --- the brush, shared by the mouse and by the training set ----------------
  function paint(img: Float64Array, cx: number, cy: number, r: number, amp = 1) {
    const x0 = Math.max(0, Math.floor(cx - r - 1));
    const x1 = Math.min(G - 1, Math.ceil(cx + r + 1));
    const y0 = Math.max(0, Math.floor(cy - r - 1));
    const y1 = Math.min(G - 1, Math.ceil(cy + r + 1));
    for (let gy = y0; gy <= y1; gy++)
      for (let gx = x0; gx <= x1; gx++) {
        const d = Math.hypot(gx + 0.5 - cx, gy + 0.5 - cy);
        const v = Math.max(0, 1 - (d / r) ** 2) * amp;
        const k = gy * G + gx;
        img[k] = amp >= 0 ? Math.min(1, img[k] + v) : Math.max(0, img[k] + v);
      }
  }

  function stroke(
    img: Float64Array,
    x0: number,
    y0: number,
    x1: number,
    y1: number,
    r: number
  ) {
    const n = Math.ceil(Math.hypot(x1 - x0, y1 - y0) * 4) + 1;
    for (let i = 0; i <= n; i++)
      paint(img, x0 + ((x1 - x0) * i) / n, y0 + ((y1 - y0) * i) / n, r, 0.5);
  }

  /** One training example of class k, drawn the way a hand would draw it. */
  function sample(k: number): Float64Array {
    const img = new Float64Array(G * G);
    const r = 1.0 + rnd() * 0.55;
    const wob = () => (rnd() - 0.5) * 1.2;
    const span = () => 5.5 + rnd() * 3.2;
    switch (k) {
      case 0: {
        const x = 1.6 + rnd() * 6.8;
        const l = span();
        const y0 = 0.5 + rnd() * (9.5 - l);
        stroke(img, x, y0, x + wob(), y0 + l, r);
        break;
      }
      case 1: {
        const y = 1.6 + rnd() * 6.8;
        const l = span();
        const x0 = 0.5 + rnd() * (9.5 - l);
        stroke(img, x0, y, x0 + l, y + wob(), r);
        break;
      }
      case 2: {
        const l = 5 + rnd() * 3.4;
        const x0 = 0.4 + rnd() * (9.2 - l);
        const y0 = 0.4 + rnd() * (9.2 - l);
        stroke(img, x0, y0 + l, x0 + l, y0, r); // bottom left to top right
        break;
      }
      case 3: {
        const l = 5 + rnd() * 3.4;
        const x0 = 0.4 + rnd() * (9.2 - l);
        const y0 = 0.4 + rnd() * (9.2 - l);
        stroke(img, x0, y0, x0 + l, y0 + l, r);
        break;
      }
      case 4: {
        const rad = 2.4 + rnd() * 1.3;
        const cx = rad + 0.4 + rnd() * (9.2 - 2 * rad);
        const cy = rad + 0.4 + rnd() * (9.2 - 2 * rad);
        for (let a = 0; a < Math.PI * 2; a += 0.12)
          paint(img, cx + rad * Math.cos(a), cy + rad * Math.sin(a), r * 0.8, 0.5);
        break;
      }
      default: {
        const rad = 1.3 + rnd() * 0.9;
        const cx = rad + 0.8 + rnd() * (8.4 - 2 * rad);
        const cy = rad + 0.8 + rnd() * (8.4 - 2 * rad);
        for (let a = 0; a < Math.PI * 2; a += 0.25)
          for (const f of [0.3, 0.65, 1])
            paint(img, cx + rad * f * Math.cos(a), cy + rad * f * Math.sin(a), r * 0.8, 0.5);
        break;
      }
    }
    for (let i = 0; i < img.length; i++)
      img[i] = Math.min(1, Math.max(0, img[i] + (rnd() - 0.5) * 0.14));
    return img;
  }

  // --- the network -----------------------------------------------------------
  let Wt: Float64Array[] = [];
  let Bs: Float64Array[] = [];
  let GW: Float64Array[] = [];
  let GB: Float64Array[] = [];
  const A: Float64Array[] = SZ.map((n) => new Float64Array(n));
  const D: Float64Array[] = SZ.map((n) => new Float64Array(n));

  function initNet() {
    Wt = [];
    Bs = [];
    GW = [];
    GB = [];
    for (let l = 0; l < L; l++) {
      const w = new Float64Array(SZ[l + 1] * SZ[l]);
      const s = Math.sqrt(2 / SZ[l]); // He, which is the one ReLU wants
      for (let i = 0; i < w.length; i++) w[i] = gauss() * s;
      Wt.push(w);
      Bs.push(new Float64Array(SZ[l + 1]));
      GW.push(new Float64Array(w.length));
      GB.push(new Float64Array(SZ[l + 1]));
    }
  }

  function forward(x: Float64Array) {
    A[0].set(x);
    for (let l = 0; l < L; l++) {
      const a = A[l];
      const out = A[l + 1];
      const w = Wt[l];
      const b = Bs[l];
      for (let j = 0; j < SZ[l + 1]; j++) {
        let s = b[j];
        const off = j * SZ[l];
        for (let i = 0; i < SZ[l]; i++) s += w[off + i] * a[i];
        out[j] = s;
      }
      if (l < L - 1) {
        for (let j = 0; j < out.length; j++) if (out[j] < 0) out[j] = 0;
      } else {
        let mx = -Infinity;
        for (const v of out) mx = Math.max(mx, v);
        let sum = 0;
        for (let j = 0; j < out.length; j++) sum += out[j] = Math.exp(out[j] - mx);
        for (let j = 0; j < out.length; j++) out[j] /= sum;
      }
    }
    return A;
  }

  /**
   * One example's worth of gradient, added to the pile. Nothing moves yet: a
   * single drawing pulls the weights about as hard as the weights are big, so
   * updating on one at a time tears the network apart. A batch is averaged
   * first, and what survives the averaging is what the examples agree on.
   */
  function accumulate(x: Float64Array, y: number) {
    forward(x);
    const outD = D[L];
    for (let j = 0; j < SZ[L]; j++) outD[j] = A[L][j] - (j === y ? 1 : 0);
    for (let l = L - 1; l >= 0; l--) {
      const dn = D[l + 1];
      const a = A[l];
      const w = Wt[l];
      const b = Bs[l];
      if (l > 0) {
        const dp = D[l];
        dp.fill(0);
        for (let j = 0; j < SZ[l + 1]; j++) {
          const g = dn[j];
          if (g === 0) continue;
          const off = j * SZ[l];
          for (let i = 0; i < SZ[l]; i++) dp[i] += w[off + i] * g;
        }
        // a ReLU that was off passes nothing back, exactly as it passed
        // nothing forward
        for (let i = 0; i < SZ[l]; i++) if (a[i] <= 0) dp[i] = 0;
      }
      const gw = GW[l];
      const gb = GB[l];
      for (let j = 0; j < SZ[l + 1]; j++) {
        const g = dn[j];
        if (g === 0) continue;
        const off = j * SZ[l];
        for (let i = 0; i < SZ[l]; i++) gw[off + i] += g * a[i];
        gb[j] += g;
      }
    }
    return -Math.log(Math.max(1e-12, A[L][y]));
  }

  function applyGrads(lr: number, n: number) {
    const k = lr / n;
    for (let l = 0; l < L; l++) {
      const w = Wt[l];
      const gw = GW[l];
      for (let i = 0; i < w.length; i++) {
        w[i] -= k * gw[i];
        gw[i] = 0;
      }
      const b = Bs[l];
      const gb = GB[l];
      for (let j = 0; j < b.length; j++) {
        b[j] -= k * gb[j];
        gb[j] = 0;
      }
    }
  }

  // --- data and the run ------------------------------------------------------
  type Set = { x: Float64Array[]; y: number[] };
  let train: Set = { x: [], y: [] };
  let test: Set = { x: [], y: [] };
  const order: number[] = [];

  const run = {
    step: 0,
    epoch: 0,
    loss: 0,
    acc: 0,
    done: false,
  };

  function build(seed: number) {
    rnd = mulberry32(seed);
    const make = (n: number): Set => {
      const x: Float64Array[] = [];
      const y: number[] = [];
      for (let i = 0; i < n; i++) {
        const k = i % CLASSES.length;
        x.push(sample(k));
        y.push(k);
      }
      return { x, y };
    };
    train = make(NTRAIN);
    test = make(NTEST);
    order.length = 0;
    for (let i = 0; i < NTRAIN; i++) order.push(i);
    initNet();
    run.step = 0;
    run.epoch = 0;
    run.loss = 0;
    run.acc = 0;
    run.done = false;
  }

  function shuffle() {
    for (let i = order.length - 1; i > 0; i--) {
      const j = Math.floor(rnd() * (i + 1));
      [order[i], order[j]] = [order[j], order[i]];
    }
  }

  function accuracy() {
    let ok = 0;
    for (let i = 0; i < test.x.length; i++) {
      const p = forward(test.x[i])[L];
      let b = 0;
      for (let j = 1; j < 6; j++) if (p[j] > p[b]) b = j;
      if (b === test.y[i]) ok++;
    }
    return ok / test.x.length;
  }

  /** One slice of training per frame, so the wires can be watched sorting
   *  themselves out instead of appearing already sorted. */
  function trainSlice(budget: number) {
    let acc = 0;
    let seen = 0;
    for (let n = 0; n < budget && !run.done; n++) {
      if (run.step % NTRAIN === 0) shuffle();
      const i = order[run.step % NTRAIN];
      acc += accumulate(train.x[i], train.y[i]);
      run.step++;
      seen++;
      if (run.step % BATCH === 0) applyGrads(LR, BATCH);
      if (run.step % NTRAIN === 0) {
        run.epoch++;
        run.acc = accuracy();
        if (run.epoch >= EPOCHS) run.done = true;
      }
    }
    if (seen) run.loss = run.loss ? run.loss * 0.9 + (acc / seen) * 0.1 : acc / seen;
  }

  // --- layout ----------------------------------------------------------------
  const setEq = equation();
  const setResult = result();
  const setRows = readout();
  const canvas = el('nn') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { css, ink } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const accent = () => css('--accent', '#7c8cff');
  const POS = '#5eead4';
  const NEG = '#f87171';

  const IMG = { x: 44, y: 96, s: 200 };
  const CELL = IMG.s / G;
  const INS = { x: 44, y: 372, s: 176 };
  const COL = [
    { x: 470, n: SZ[1], gap: 40, r: 13 },
    { x: 680, n: SZ[2], gap: 48, r: 15 },
    { x: 850, n: SZ[3], gap: 58, r: 17 },
  ];
  const nodeY = (l: number, i: number) => 300 + (i - (COL[l].n - 1) / 2) * COL[l].gap;
  const pixX = (i: number) => IMG.x + ((i % G) + 0.5) * CELL;
  const pixY = (i: number) => IMG.y + (Math.floor(i / G) + 0.5) * CELL;

  const drawing = new Float64Array(G * G);
  const state = {
    brush: 'draw' as 'draw' | 'erase',
    edges: 0.18,
    signed: true,
    sel: null as { l: number; i: number } | null,
  };

  // --- the picture -----------------------------------------------------------
  function drawImage() {
    label('draw a shape here', IMG.x, IMG.y - 14, 0.45, 'left', 11);
    for (let i = 0; i < G * G; i++) {
      const x = IMG.x + (i % G) * CELL;
      const y = IMG.y + Math.floor(i / G) * CELL;
      const v = drawing[i];
      ctx.fillStyle = v > 0.004 ? `rgba(${css('--stage-ink', '232,233,236')},${0.08 + 0.85 * v})` : ink(0.04);
      ctx.fillRect(x + 1, y + 1, CELL - 2, CELL - 2);
    }
    ctx.strokeStyle = ink(0.18);
    ctx.lineWidth = 1;
    ctx.strokeRect(IMG.x, IMG.y, IMG.s, IMG.s);
    label(`${G}×${G} = ${G * G} numbers, each one an input`, IMG.x, IMG.y + IMG.s + 20, 0.3, 'left', 11.5);
  }

  /** Every wire of one transition, keeping only the loudest ones. */
  function drawEdges(l: number) {
    const from = A[l];
    const w = Wt[l];
    const nIn = SZ[l];
    const nOut = SZ[l + 1];
    const list: { i: number; j: number; c: number }[] = [];
    let mx = 1e-9;
    for (let j = 0; j < nOut; j++) {
      const off = j * nIn;
      for (let i = 0; i < nIn; i++) {
        const c = w[off + i] * from[i];
        if (Math.abs(c) < 1e-4) continue;
        list.push({ i, j, c });
        mx = Math.max(mx, Math.abs(c));
      }
    }
    // an empty grid sends nothing anywhere, and then there is no wire to draw
    if (!list.length) return;
    list.sort((a, b) => Math.abs(b.c) - Math.abs(a.c));
    const keep = Math.min(list.length, Math.max(1, Math.round(list.length * state.edges)));

    for (let k = keep - 1; k >= 0; k--) {
      const e = list[k];
      const t = Math.abs(e.c) / mx;
      const x0 = l === 0 ? pixX(e.i) : COL[l - 1].x;
      const y0 = l === 0 ? pixY(e.i) : nodeY(l - 1, e.i);
      const col = state.signed ? (e.c >= 0 ? POS : NEG) : css('--accent', '#7c8cff');
      ctx.strokeStyle = col;
      ctx.globalAlpha = 0.06 + 0.72 * t * t;
      ctx.lineWidth = 0.5 + 2.2 * t;
      ctx.beginPath();
      ctx.moveTo(x0, y0);
      ctx.lineTo(COL[l].x, nodeY(l, e.j));
      ctx.stroke();
    }
    ctx.globalAlpha = 1;
  }

  function drawNodes() {
    const names = ['hidden 1', 'hidden 2', 'output'];
    for (let l = 0; l < 3; l++) {
      const a = A[l + 1];
      let mx = 1e-9;
      for (const v of a) mx = Math.max(mx, Math.abs(v));
      label(names[l], COL[l].x, 62, 0.45, 'center', 11);
      label(
        l < 2 ? `${SZ[l + 1]} units · ReLU` : 'softmax',
        COL[l].x,
        78,
        0.28,
        'center',
        11
      );

      for (let i = 0; i < COL[l].n; i++) {
        const y = nodeY(l, i);
        const t = Math.min(1, a[i] / mx);
        const sel = state.sel && state.sel.l === l && state.sel.i === i;
        ctx.fillStyle = ink(0.07);
        ctx.beginPath();
        ctx.arc(COL[l].x, y, COL[l].r, 0, Math.PI * 2);
        ctx.fill();
        if (t > 0.004) {
          ctx.fillStyle = `${POS}${Math.round(40 + 190 * t)
            .toString(16)
            .padStart(2, '0')}`;
          ctx.beginPath();
          ctx.arc(COL[l].x, y, COL[l].r * (0.35 + 0.65 * Math.sqrt(t)), 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.strokeStyle = sel ? accent() : ink(a[i] > 0 ? 0.3 : 0.14);
        ctx.lineWidth = sel ? 2.4 : 1;
        ctx.beginPath();
        ctx.arc(COL[l].x, y, COL[l].r, 0, Math.PI * 2);
        ctx.stroke();
        if (l < 2 && a[i] <= 0)
          label('off', COL[l].x, y + 4, 0.3, 'center', 11);
      }
    }

    // the six answers, with the probability the softmax gives each
    const p = A[L];
    let best = 0;
    for (let j = 1; j < 6; j++) if (p[j] > p[best]) best = j;
    for (let i = 0; i < 6; i++) {
      const y = nodeY(2, i);
      const c = CLASSES[i];
      label(c.glyph, COL[2].x, y + 5, i === best ? 1 : 0.4, 'center', 15,
        i === best ? accent() : undefined);
      label(c.name, COL[2].x + 26, y - 3, i === best ? 1 : 0.45, 'left', 11,
        i === best ? accent() : undefined);
      const bx = COL[2].x + 26;
      const bw = 104;
      ctx.fillStyle = ink(0.07);
      roundRect(ctx, bx, y + 5, bw, 8, 4);
      ctx.fill();
      ctx.fillStyle = i === best ? accent() : ink(0.3);
      roundRect(ctx, bx, y + 5, Math.max(2, bw * p[i]), 8, 4);
      ctx.fill();
      label(`${(p[i] * 100).toFixed(0)}%`, bx + bw + 6, y + 13, 0.4, 'left', 11);
    }
  }

  /** What the selected neuron is looking for, drawn at its own scale. */
  function drawInspector() {
    label('inside one neuron', INS.x, INS.y - 28, 0.45, 'left', 11);
    if (!state.sel) {
      label('click any neuron on the right', INS.x, INS.y - 11, 0.28, 'left', 11.5);
      ctx.strokeStyle = ink(0.1);
      ctx.setLineDash([4, 5]);
      ctx.lineWidth = 1;
      roundRect(ctx, INS.x, INS.y, INS.s, INS.s, 8);
      ctx.stroke();
      ctx.setLineDash([]);
      return;
    }
    const { l, i } = state.sel;
    const nIn = SZ[l];
    const w = Wt[l];
    const off = i * nIn;
    let mx = 1e-9;
    for (let k = 0; k < nIn; k++) mx = Math.max(mx, Math.abs(w[off + k]));
    const act = A[l + 1][i];

    label(
      l === 0
        ? `hidden 1, unit ${i + 1}: one weight per pixel`
        : l === 1
          ? `hidden 2, unit ${i + 1}: one weight per unit below`
          : `output "${CLASSES[i].name}": one weight per unit below`,
      INS.x,
      INS.y - 11,
      0.32,
      'left',
      11.5
    );

    if (l === 0) {
      const c = INS.s / G;
      for (let k = 0; k < nIn; k++) {
        const v = w[off + k] / mx;
        ctx.fillStyle =
          v >= 0
            ? `rgba(94,234,212,${Math.abs(v) * 0.92})`
            : `rgba(248,113,113,${Math.abs(v) * 0.92})`;
        ctx.fillRect(INS.x + (k % G) * c, INS.y + Math.floor(k / G) * c, c, c);
      }
      ctx.strokeStyle = ink(0.18);
      ctx.lineWidth = 1;
      ctx.strokeRect(INS.x, INS.y, INS.s, INS.s);
    } else {
      const pitch = INS.s / nIn;
      const mid = INS.x + INS.s / 2;
      for (let k = 0; k < nIn; k++) {
        const v = w[off + k] / mx;
        const y = INS.y + k * pitch;
        ctx.fillStyle = v >= 0 ? POS : NEG;
        ctx.globalAlpha = 0.35 + 0.6 * Math.min(1, A[l][k] > 0 ? 1 : 0.25);
        const bw = (INS.s / 2 - 6) * Math.abs(v);
        ctx.fillRect(v >= 0 ? mid : mid - bw, y + 2, bw, pitch - 4);
        ctx.globalAlpha = 1;
        label(`${k + 1}`, INS.x - 6, y + pitch / 2 + 3, 0.3, 'right', 11);
      }
      ctx.strokeStyle = ink(0.2);
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(mid, INS.y);
      ctx.lineTo(mid, INS.y + INS.s);
      ctx.stroke();
    }

    label(
      `bias ${Bs[l][i].toFixed(2)}   ·   it is firing at ${act.toFixed(3)}`,
      INS.x,
      INS.y + INS.s + 20,
      0.45,
      'left',
      11.5,
      act > 0 ? POS : undefined
    );
    label(
      l === 0
        ? 'teal wants ink here, red wants it empty'
        : 'teal listens for, red listens against',
      INS.x,
      INS.y + INS.s + 36,
      0.3,
      'left',
      11
    );
  }

  function drawProgress() {
    if (run.done) return;
    const w = 168;
    const x = W - w - 24;
    const y = 560;
    ctx.fillStyle = ink(0.08);
    roundRect(ctx, x, y, w, 8, 4);
    ctx.fill();
    ctx.fillStyle = accent();
    roundRect(ctx, x, y, Math.max(3, (w * run.step) / (NTRAIN * EPOCHS)), 8, 4);
    ctx.fill();
    label(
      `learning: epoch ${run.epoch + 1} of ${EPOCHS}`,
      x,
      y - 8,
      0.5,
      'left',
      11.5,
      accent()
    );
  }

  function draw() {
    forward(drawing);
    ctx.clearRect(0, 0, W, H);
    for (let l = 0; l < 3; l++) drawEdges(l);
    drawImage();
    drawNodes();
    drawInspector();
    drawProgress();
    sync();
  }

  function sync() {
    const p = A[L];
    let best = 0;
    for (let j = 1; j < 6; j++) if (p[j] > p[best]) best = j;
    let lit = 0;
    for (const v of drawing) if (v > 0.02) lit++;
    setRows({
      epoch: `${run.epoch} / ${EPOCHS}`,
      loss: run.loss ? run.loss.toFixed(3) : '—',
      acc: run.acc ? `${(run.acc * 100).toFixed(1)}%` : '—',
    });
    setEq({
      rule: [['a^{(l)}', POS], '=\\operatorname{ReLU}\\!\\big(W^{(l)}', ['a^{(l-1)}', POS], '+\\,b^{(l)}\\big)', '\\qquad p = \\operatorname{softmax}(z^{(3)})'],
      live: [
        `${SZ[0]}\\to${SZ[1]}\\to${SZ[2]}\\to${SZ[3]}`,
        `\\quad ${SZ[0] * SZ[1] + SZ[1] * SZ[2] + SZ[2] * SZ[3]}\\text{ weights}`,
        [`\\quad p_{\\text{${CLASSES[best].name}}} = ${p[best].toFixed(2)}`, accent()],
      ],
    });
    setResult({
      value: lit ? CLASSES[best].name : 'nothing drawn',
      colour: lit ? accent() : undefined,
      status: lit
        ? `${(p[best] * 100).toFixed(0)}% confident · ${run.done ? 'training finished' : `training, epoch ${run.epoch + 1} of ${EPOCHS}`}`
        : 'draw on the grid, or press Random shape',
      note: run.done
        ? 'Nothing in here was designed: every picture inside a neuron is a leftover of minimising one loss.'
        : 'Watch the wires while it learns: nearly all the movement happens in the first two or three epochs.',
    });
  }

  // --- interaction -----------------------------------------------------------
  const local = (e: PointerEvent) => {
    const r = canvas.getBoundingClientRect();
    return {
      x: ((e.clientX - r.left) / r.width) * W,
      y: ((e.clientY - r.top) / r.height) * H,
    };
  };
  let painting = false;
  let lastPt: { x: number; y: number } | null = null;

  function brushAt(p: { x: number; y: number }) {
    const cx = (p.x - IMG.x) / CELL;
    const cy = (p.y - IMG.y) / CELL;
    const amp = state.brush === 'draw' ? 0.55 : -1;
    if (lastPt) {
      const lx = (lastPt.x - IMG.x) / CELL;
      const ly = (lastPt.y - IMG.y) / CELL;
      const n = Math.ceil(Math.hypot(cx - lx, cy - ly) * 4) + 1;
      for (let i = 1; i <= n; i++)
        paint(drawing, lx + ((cx - lx) * i) / n, ly + ((cy - ly) * i) / n, 1.15, amp);
    } else paint(drawing, cx, cy, 1.15, amp);
    lastPt = p;
  }

  canvas.addEventListener('pointerdown', (e) => {
    const p = local(e);
    for (let l = 0; l < 3; l++)
      for (let i = 0; i < COL[l].n; i++)
        if (Math.hypot(p.x - COL[l].x, p.y - nodeY(l, i)) < COL[l].r + 6) {
          state.sel =
            state.sel && state.sel.l === l && state.sel.i === i ? null : { l, i };
          return;
        }
    if (p.x > IMG.x - 8 && p.x < IMG.x + IMG.s + 8 && p.y > IMG.y - 8 && p.y < IMG.y + IMG.s + 8) {
      painting = true;
      lastPt = null;
      try {
        canvas.setPointerCapture(e.pointerId);
      } catch {
        /* synthetic pointers need no capture */
      }
      brushAt(p);
    }
  });
  canvas.addEventListener('pointermove', (e) => {
    if (painting) brushAt(local(e));
  });
  const drop = () => {
    painting = false;
    lastPt = null;
  };
  canvas.addEventListener('pointerup', drop);
  canvas.addEventListener('pointercancel', drop);

  segmented('brush', (v) => (state.brush = v as 'draw' | 'erase'));
  slider('edges', (v) => (state.edges = v / 100), (v) => `${v}%`);
  check('signed', (on) => (state.signed = on));

  el('reset').addEventListener('click', () => drawing.fill(0));
  el('step').addEventListener('click', () => {
    const keep = rnd;
    rnd = mulberry32((Math.random() * 1e9) | 0);
    drawing.set(sample(Math.floor(Math.random() * CLASSES.length)));
    rnd = keep;
  });
  el('retrain').addEventListener('click', () => {
    build((Math.random() * 1e9) | 0);
  });

  // --- the loop --------------------------------------------------------------
  function loop() {
    if (!run.done) trainSlice(420);
    draw();
    requestAnimationFrame(loop);
  }

  build(20260823);
  drawing.set(sample(0));
  requestAnimationFrame(loop);
</script>

<style>
  .nn-canvas {
    cursor: crosshair;
    touch-action: none;
  }
</style>
