---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Checks from '../../../components/sim/Checks.astro';
import Actions from '../../../components/sim/Actions.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
---

<SimLayout
  areaSlug="deep-learning"
  title="Neuron Activations"
  description="Draw a digit and watch it go through a network that already knows how to read one. Every wire is lit by what it carries, every neuron by how hard it is firing, and clicking one opens it up to show the picture it looks for."
  shortcuts={['fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="nn"
          width="1000"
          height="660"
          role="img"
          aria-label="A drawing pad, the network drawn as neurons joined by wires with the loudest ones lit, and the ten outputs with their probabilities."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'a wire carrying a positive value', color: '#5eead4' },
          { label: 'a wire carrying a negative one', color: '#f87171' },
          { label: 'the neuron you opened', color: '#7c8cff' },
        ]}
        hint="Drag on the pad to draw · click any neuron to open it"
      />
      <Result label="It says" />
    </div>

    <div class="sim-panel">
      <Seg id="model" label="Architecture" attr="m" options={[{ value: 'mlp', label: 'Plain layers' }, { value: 'cnn', label: 'Convolutional' }]} />
      <Actions>
        <button type="button" class="btn" id="sample">A real digit</button>
        <button type="button" class="btn ghost" id="clear">Clear</button>
      </Actions>
      <Slider id="edges" label="Wires drawn" min={1} max={100} value={12} display="12%" hint={['only the loudest', 'all of them']} />
      <Checks items={[{ id: 'signed', label: 'Colour a wire by the sign of what it carries', checked: true }]} />
      <Readout
        rows={[
          { id: 'r-says', label: 'it says' },
          { id: 'r-conf', label: 'how sure' },
          { id: 'r-second', label: 'runner-up' },
          { id: 'r-firing', label: 'neurons firing' },
          { id: 'r-params', label: 'weights in this network' },
          { id: 'r-acc', label: 'accuracy on unseen digits' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Draw a stroke and turn <b>wires drawn</b> down to a few percent. What is
      left is the handful of connections actually carrying the decision, and you
      can watch them move as you change the stroke.
    </li>
    <li>
      Count the neurons marked <b>off</b>. For any one digit about half of the
      first layer sits at exactly zero, and a ReLU that is off sends exactly
      <b>zero</b> down every wire leaving it, however large the weight on that
      wire happens to be.
    </li>
    <li>
      Click a neuron in the first layer. Its incoming weights are one number per
      pixel, so they are a picture, and it is drawn under the pad. Several come
      out as smudged strokes and loops: nobody asked for those, they are what
      minimising the loss left behind.
    </li>
    <li>
      Switch to <b>convolutional</b>. The first stage is now eight copies of
      your digit, each filtered by one three-by-three kernel that is reused at
      every position. Click one to see the nine numbers that made it.
    </li>
    <li>
      The panel prices the difference. The convolutional network is right more
      often on digits it has never seen, using about <b>a sixth</b> of the
      weights, because it is told in advance that neighbouring pixels are
      related and the plain stack has to discover that for itself.
    </li>
    <li>
      Draw something that is not a digit at all. It answers anyway, often with
      real confidence. Softmax has to hand out one unit of probability, so a
      classifier trained on ten digits has no way at all to say
      <b>none of these</b>.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk, roundRect } from '../../../lib/draw';
  import { el, segmented, slider, check, result, readout } from '../../../lib/panel';
  import {
    ACCURACY, CNN, MLP_ARCH, cnnForward, cnnFilter, cnnFilter2, mlpForward, mlpUnitImage,
    mlpWeightsInto, normalise, samples,
  } from '../../../lib/mnist-model';

  const POS = '#5eead4', NEG = '#f87171', PICK = '#7c8cff', OUT = '#f59e0b';
  const PAD = 140;

  const state = { model: 'mlp', edges: 0.12, signed: true, sample: -1, sel: null as { layer: number; i: number } | null };
  const ink140 = new Float32Array(PAD * PAD);
  let seen = new Float32Array(784);
  const SAMPLES = samples();

  const canvas = el('nn') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink, inv } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  const MLP_PARAMS = 784 * 40 + 40 + 40 * 20 + 20 + 20 * 10 + 10;
  const CNN_PARAMS = CNN.c1 * 9 + CNN.c1 + CNN.c2 * CNN.c1 * 9 + CNN.c2 + 10 * CNN.flat + 10;

  // --- layout ----------------------------------------------------------------
  const IMG = { x: 40, y: 96, s: 196 };
  const INS = { x: 40, y: 388, s: 196 };
  const COL = {
    mlp: [
      { x: 424, n: 40, pitch: 13.6, r: 5, y: 96 },
      { x: 646, n: 20, pitch: 27.5, r: 8, y: 106 },
    ],
    cnn: [
      { x: 352, n: CNN.c1, cols: 2, size: 62, gap: 10, y: 100 },
      { x: 566, n: CNN.c2, cols: 4, size: 40, gap: 7, y: 100 },
    ],
  };
  const O = { x: 838, n: 10, pitch: 54, r: 13, y: 118 };
  const nodeY = (c: { y: number; pitch: number }, i: number) => c.y + i * c.pitch + c.pitch / 2;
  const outY = (i: number) => O.y + i * O.pitch + O.pitch / 2;
  const pixX = (i: number) => IMG.x + ((i % 28) + 0.5) * (IMG.s / 28);
  const pixY = (i: number) => IMG.y + (Math.floor(i / 28) + 0.5) * (IMG.s / 28);
  /** Where a CNN feature map sits, so a wire can leave from its middle. */
  function mapBox(stage: 0 | 1, c: number) {
    const g = COL.cnn[stage];
    return {
      x: g.x + (c % g.cols) * (g.size + g.gap),
      y: g.y + Math.floor(c / g.cols) * (g.size + g.gap),
      s: g.size,
    };
  }

  const grey = (v: number) => {
    const g = Math.round(255 * Math.max(0, Math.min(1, v)));
    return `rgb(${g},${g},${g})`;
  };
  const signedFill = (v: number, mx: number) => {
    const t = Math.max(-1, Math.min(1, v / (mx || 1)));
    return t >= 0 ? `rgba(94,234,212,${0.06 + 0.9 * t})` : `rgba(248,113,113,${0.06 + 0.9 * t * -1})`;
  };
  function tile(x: number, y: number, s: number, n: number, data: ArrayLike<number>, off: number, paint: (v: number) => string) {
    const c = s / n;
    for (let yy = 0; yy < n; yy++)
      for (let xx = 0; xx < n; xx++) {
        ctx.fillStyle = paint(data[off + yy * n + xx]);
        ctx.fillRect(x + xx * c, y + yy * c, c + 0.6, c + 0.6);
      }
  }

  // --- the pad and what the network is handed --------------------------------
  function pad() {
    label('draw a digit here', IMG.x, IMG.y - 30, 0.55, 'left', 13);
    label('any size, anywhere on the pad', IMG.x, IMG.y - 12, 0.32, 'left', 11);
    ctx.fillStyle = inv(0.6);
    roundRect(ctx, IMG.x, IMG.y, IMG.s, IMG.s, 8);
    ctx.fill();
    tile(IMG.x, IMG.y, IMG.s, 28, seen, 0, grey);
    ctx.strokeStyle = ink(0.2);
    ctx.lineWidth = 1;
    roundRect(ctx, IMG.x + 0.5, IMG.y + 0.5, IMG.s - 1, IMG.s - 1, 8);
    ctx.stroke();
    label('cropped and centred', IMG.x, IMG.y + IMG.s + 20, 0.32, 'left', 11);
  }

  /** What the neuron you clicked is looking for, drawn at its own scale. */
  function inspector(run: { h1: Float32Array; h2: Float32Array } | null, cnn: ReturnType<typeof cnnForward> | null) {
    label('inside one neuron', INS.x, INS.y - 30, 0.55, 'left', 13);
    const sel = state.sel;
    if (!sel) {
      label('click a neuron', INS.x, INS.y - 12, 0.32, 'left', 11);
      ctx.strokeStyle = ink(0.1);
      ctx.setLineDash([4, 5]);
      ctx.lineWidth = 1;
      roundRect(ctx, INS.x, INS.y, INS.s, INS.s, 8);
      ctx.stroke();
      ctx.setLineDash([]);
      return;
    }
    if (state.model === 'mlp') {
      if (sel.layer === 0) {
        label(`unit ${sel.i + 1}: one weight a pixel`, INS.x, INS.y - 12, 0.32, 'left', 11);
        const img = mlpUnitImage(sel.i);
        let mx = 1e-6;
        for (const v of img) mx = Math.max(mx, Math.abs(v));
        tile(INS.x, INS.y, INS.s, 28, img, 0, (v) => signedFill(v, mx));
        label('teal wants ink, red wants none', INS.x, INS.y + INS.s + 20, 0.32, 'left', 11);
        if (run) label(`firing at ${run.h1[sel.i].toFixed(3)}`, INS.x, INS.y + INS.s + 38, 0.55, 'left', 12, run.h1[sel.i] > 0 ? POS : undefined);
      } else {
        const nIn = sel.layer === 1 ? MLP_ARCH[1] : MLP_ARCH[2];
        label(sel.layer === 1 ? `unit ${sel.i + 1}: one weight per unit below` : `output ${sel.i}: one weight per unit below`, INS.x, INS.y - 12, 0.32, 'left', 11);
        const w = mlpWeightsInto(sel.layer, sel.i);
        let mx = 1e-6;
        for (const v of w) mx = Math.max(mx, Math.abs(v));
        const pitch = INS.s / nIn, mid = INS.x + INS.s / 2;
        for (let k = 0; k < nIn; k++) {
          const bw = (INS.s / 2 - 6) * (Math.abs(w[k]) / mx);
          ctx.fillStyle = w[k] >= 0 ? POS : NEG;
          ctx.globalAlpha = 0.8;
          ctx.fillRect(w[k] >= 0 ? mid : mid - bw, INS.y + k * pitch + 1, bw, Math.max(1, pitch - 2));
          ctx.globalAlpha = 1;
        }
        ctx.strokeStyle = ink(0.2);
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(mid, INS.y);
        ctx.lineTo(mid, INS.y + INS.s);
        ctx.stroke();
        label('teal listens for, red listens against', INS.x, INS.y + INS.s + 20, 0.32, 'left', 11);
      }
      return;
    }
    if (sel.layer === 0) {
      label(`filter ${sel.i + 1}: the nine numbers`, INS.x, INS.y - 12, 0.32, 'left', 11);
      const f = cnnFilter(sel.i);
      let mx = 1e-6;
      for (const v of f) mx = Math.max(mx, Math.abs(v));
      const cell = INS.s / 3;
      for (let r = 0; r < 3; r++)
        for (let c = 0; c < 3; c++) {
          ctx.fillStyle = signedFill(f[r * 3 + c], mx);
          roundRect(ctx, INS.x + c * cell + 2, INS.y + r * cell + 2, cell - 4, cell - 4, 5);
          ctx.fill();
          label(f[r * 3 + c].toFixed(2), INS.x + c * cell + cell / 2, INS.y + r * cell + cell / 2 + 5, 0.95, 'center', 13);
        }
      label('the same nine, used at every position', INS.x, INS.y + INS.s + 20, 0.32, 'left', 11);
    } else if (sel.layer === 1) {
      label(`map ${sel.i + 1}: eight kernels, one per map below`, INS.x, INS.y - 12, 0.32, 'left', 11);
      const cell = INS.s / 4 - 4;
      for (let d = 0; d < CNN.c1; d++) {
        const f = cnnFilter2(sel.i, d);
        let mx = 1e-6;
        for (const v of f) mx = Math.max(mx, Math.abs(v));
        const bx = INS.x + (d % 4) * (cell + 5), by = INS.y + Math.floor(d / 4) * (cell + 22);
        tile(bx, by, cell, 3, f, 0, (v) => signedFill(v, mx));
        label(String(d + 1), bx + cell / 2, by + cell + 14, 0.32, 'center', 11);
      }
      label('added together to make one map', INS.x, INS.y + INS.s + 20, 0.32, 'left', 11);
    } else {
      label(`output ${sel.i}: what it reads from the maps`, INS.x, INS.y - 12, 0.32, 'left', 11);
      const w = mlpWeightsInto(-1, sel.i); // the dense layer of the CNN
      let mx = 1e-6;
      for (const v of w) mx = Math.max(mx, Math.abs(v));
      const cell = INS.s / 4 - 4;
      for (let c = 0; c < CNN.c2; c++) {
        const bx = INS.x + (c % 4) * (cell + 5), by = INS.y + Math.floor(c / 4) * (cell + 5);
        tile(bx, by, cell, CNN.p2, w, c * CNN.p2 * CNN.p2, (v) => signedFill(v, mx));
      }
      label('one small picture per map below', INS.x, INS.y + INS.s + 20, 0.32, 'left', 11);
      void cnn;
    }
  }

  // --- the wires -------------------------------------------------------------
  type Wire = { x0: number; y0: number; x1: number; y1: number; c: number };
  function drawWires(list: Wire[]) {
    if (!list.length) return;
    // the left column belongs to the picture and the inspector: a wire leaving a
    // pixel is only drawn once it is clear of the pad, so the digit stays legible
    ctx.save();
    ctx.beginPath();
    ctx.rect(0, 0, W, H);
    ctx.rect(IMG.x - 8, IMG.y - 46, IMG.s + 16, H - IMG.y + 46);
    ctx.clip('evenodd');
    let mx = 1e-9;
    for (const w of list) mx = Math.max(mx, Math.abs(w.c));
    list.sort((a, b) => Math.abs(b.c) - Math.abs(a.c));
    const keep = Math.max(1, Math.round(list.length * state.edges));
    for (let k = keep - 1; k >= 0; k--) {
      const e = list[k];
      const t = Math.abs(e.c) / mx;
      ctx.strokeStyle = state.signed ? (e.c >= 0 ? POS : NEG) : PICK;
      ctx.globalAlpha = 0.05 + 0.7 * t * t;
      ctx.lineWidth = 0.4 + 2.2 * t;
      ctx.beginPath();
      ctx.moveTo(e.x0, e.y0);
      ctx.lineTo(e.x1, e.y1);
      ctx.stroke();
    }
    ctx.globalAlpha = 1;
    ctx.restore();
  }

  function neuron(x: number, y: number, r: number, v: number, mx: number, colour: string, on: boolean) {
    ctx.fillStyle = ink(0.06);
    ctx.beginPath();
    ctx.arc(x, y, r, 0, Math.PI * 2);
    ctx.fill();
    if (v > 0) {
      const t = Math.min(1, v / (mx || 1));
      ctx.fillStyle = colour;
      ctx.globalAlpha = 0.15 + 0.85 * Math.sqrt(t);
      ctx.beginPath();
      ctx.arc(x, y, r * (0.36 + 0.64 * Math.sqrt(t)), 0, Math.PI * 2);
      ctx.fill();
      ctx.globalAlpha = 1;
    }
    ctx.strokeStyle = on ? PICK : ink(v > 0 ? 0.3 : 0.14);
    ctx.lineWidth = on ? 2.4 : 1;
    ctx.beginPath();
    ctx.arc(x, y, r, 0, Math.PI * 2);
    ctx.stroke();
  }

  function outputs(p: Float32Array, top: number) {
    label('the answer', O.x - 12, O.y - 30, 0.55, 'left', 13);
    let mx = 1e-9;
    for (const v of p) mx = Math.max(mx, v);
    for (let d = 0; d < 10; d++) {
      const y = outY(d), on = d === top;
      neuron(O.x, y, O.r, p[d], mx, OUT, state.sel?.layer === 2 && state.sel.i === d);
      label(String(d), O.x, y + 5, on ? 1 : 0.55, 'center', 14, on ? OUT : undefined);
      const bx = O.x + O.r + 10, bw = 78;
      ctx.fillStyle = ink(0.07);
      roundRect(ctx, bx, y - 6, bw, 12, 4);
      ctx.fill();
      if (p[d] > 0.003) {
        ctx.fillStyle = on ? OUT : PICK;
        ctx.globalAlpha = on ? 0.95 : 0.45;
        roundRect(ctx, bx, y - 6, Math.max(3, bw * p[d]), 12, 4);
        ctx.fill();
        ctx.globalAlpha = 1;
      }
      label(`${(p[d] * 100).toFixed(0)}%`, bx + bw + 8, y + 5, on ? 0.95 : 0.35, 'left', 11, on ? OUT : undefined);
    }
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    pad();

    const mlp = state.model === 'mlp';
    let p: Float32Array, firing = 0, total = 0;
    let run: ReturnType<typeof mlpForward> | null = null;
    let cnn: ReturnType<typeof cnnForward> | null = null;

    if (mlp) {
      run = mlpForward(seen);
      p = run.p;
      const [c1, c2] = COL.mlp;
      // input to the first layer, only from pixels that actually carry something
      const w1: Wire[] = [];
      for (let i = 0; i < 784; i++) {
        if (seen[i] < 0.03) continue;
        for (let j = 0; j < c1.n; j++)
          w1.push({ x0: pixX(i), y0: pixY(i), x1: c1.x, y1: nodeY(c1, j), c: mlpUnitImage(j)[i] * seen[i] });
      }
      const w2: Wire[] = [];
      for (let j = 0; j < c2.n; j++) {
        const w = mlpWeightsInto(1, j);
        for (let i = 0; i < c1.n; i++)
          w2.push({ x0: c1.x, y0: nodeY(c1, i), x1: c2.x, y1: nodeY(c2, j), c: w[i] * run.h1[i] });
      }
      const w3: Wire[] = [];
      for (let j = 0; j < 10; j++) {
        const w = mlpWeightsInto(2, j);
        for (let i = 0; i < c2.n; i++)
          w3.push({ x0: c2.x, y0: nodeY(c2, i), x1: O.x, y1: outY(j), c: w[i] * run.h2[i] });
      }
      drawWires(w1);
      drawWires(w2);
      drawWires(w3);

      let m1 = 1e-9, m2 = 1e-9;
      for (const v of run.h1) m1 = Math.max(m1, v);
      for (const v of run.h2) m2 = Math.max(m2, v);
      label(`${c1.n} units`, c1.x - 26, c1.y - 30, 0.55, 'left', 13);
      label('reads all 784 pixels', c1.x - 26, c1.y - 12, 0.32, 'left', 11);
      for (let i = 0; i < c1.n; i++) {
        neuron(c1.x, nodeY(c1, i), c1.r, run.h1[i], m1, POS, state.sel?.layer === 0 && state.sel.i === i);
        if (run.h1[i] <= 0) firing += 0; else firing++;
        total++;
      }
      label(`${c2.n} units`, c2.x - 24, c2.y - 30, 0.55, 'left', 13);
      label('reads layer 1', c2.x - 24, c2.y - 12, 0.32, 'left', 11);
      for (let i = 0; i < c2.n; i++) {
        neuron(c2.x, nodeY(c2, i), c2.r, run.h2[i], m2, POS, state.sel?.layer === 1 && state.sel.i === i);
        if (run.h2[i] > 0) firing++;
        total++;
      }
    } else {
      cnn = cnnForward(seen);
      p = cnn.p;
      const g1 = COL.cnn[0], g2 = COL.cnn[1];
      // the dense layer is the only place a wire still means one multiplication
      const w3: Wire[] = [];
      for (let j = 0; j < 10; j++) {
        const w = mlpWeightsInto(-1, j);
        for (let c = 0; c < CNN.c2; c++) {
          let s = 0;
          for (let k = 0; k < CNN.p2 * CNN.p2; k++) s += w[c * CNN.p2 * CNN.p2 + k] * cnn.p2[c * CNN.p2 * CNN.p2 + k];
          const b = mapBox(1, c);
          w3.push({ x0: b.x + b.s, y0: b.y + b.s / 2, x1: O.x - O.r, y1: outY(j), c: s });
        }
      }
      drawWires(w3);

      label(`${CNN.c1} filtered copies`, g1.x, g1.y - 30, 0.55, 'left', 13);
      label('one 3 × 3 kernel each', g1.x, g1.y - 12, 0.32, 'left', 11);
      let m1 = 1e-9;
      for (const v of cnn.a1) m1 = Math.max(m1, v);
      for (let c = 0; c < CNN.c1; c++) {
        const b = mapBox(0, c);
        tile(b.x, b.y, b.s, CNN.h1, cnn.a1, c * CNN.h1 * CNN.h1, (v) => grey(v / m1));
        const on = state.sel?.layer === 0 && state.sel.i === c;
        ctx.strokeStyle = on ? PICK : ink(0.14);
        ctx.lineWidth = on ? 2.4 : 1;
        ctx.strokeRect(b.x, b.y, b.s, b.s);
      }
      label(`${CNN.c2} deeper maps`, g2.x, g2.y - 30, 0.55, 'left', 13);
      label('each mixes all eight', g2.x, g2.y - 12, 0.32, 'left', 11);
      let m2 = 1e-9;
      for (const v of cnn.a2) m2 = Math.max(m2, v);
      for (let c = 0; c < CNN.c2; c++) {
        const b = mapBox(1, c);
        tile(b.x, b.y, b.s, CNN.h2, cnn.a2, c * CNN.h2 * CNN.h2, (v) => grey(v / m2));
        const on = state.sel?.layer === 1 && state.sel.i === c;
        ctx.strokeStyle = on ? PICK : ink(0.14);
        ctx.lineWidth = on ? 2.4 : 1;
        ctx.strokeRect(b.x, b.y, b.s, b.s);
      }
      for (const v of cnn.a1) { total++; if (v > 0) firing++; }
      for (const v of cnn.a2) { total++; if (v > 0) firing++; }
    }

    let top = 0;
    for (let d = 1; d < 10; d++) if (p[d] > p[top]) top = d;
    let second = top === 0 ? 1 : 0;
    for (let d = 0; d < 10; d++) if (d !== top && p[d] > p[second]) second = d;
    outputs(p, top);
    inspector(run, cnn);

    const blank = !seen.some((v) => v > 0.02);
    const params = mlp ? MLP_PARAMS : CNN_PARAMS;
    setEq({
      rule: mlp
        ? [['a^{(l)} = \\mathrm{ReLU}(W^{(l)}a^{(l-1)} + b^{(l)})', POS], '\\qquad', ['784 \\to 40 \\to 20 \\to 10', PICK]]
        : [['\\text{one kernel, slid over everything}', POS], '\\qquad', ['8 \\to 16 \\to 10', PICK]],
      live: blank
        ? ['\\text{nothing drawn yet}']
        : [[`\\hat y = ${top}`, OUT], `\\quad p = ${(p[top] * 100).toFixed(1)}\\%`, `\\quad ${params.toLocaleString('en')}\\text{ weights}`],
    });
    setRows({
      'r-says': blank ? '—' : String(top),
      'r-conf': blank ? '—' : `${(p[top] * 100).toFixed(1)}%`,
      'r-second': blank ? '—' : `${second} at ${(p[second] * 100).toFixed(1)}%`,
      'r-firing': blank ? '—' : `${firing} of ${total}`,
      'r-params': params.toLocaleString('en'),
      'r-acc': `${mlp ? ACCURACY.mlp : ACCURACY.cnn}%`,
    });
    setResult({
      value: blank ? 'draw something' : String(top),
      colour: blank ? undefined : OUT,
      status: blank
        ? 'draw a digit on the pad, or load one it has never seen'
        : `${(p[top] * 100).toFixed(1)}% sure, with ${second} behind it at ${(p[second] * 100).toFixed(1)}% · ${firing} of ${total} neurons firing · ${params.toLocaleString('en')} weights, ${mlp ? ACCURACY.mlp : ACCURACY.cnn}% right on digits it never saw`,
      note: blank
        ? 'The network was trained before this page loaded, so nothing here is learning. Every wire and every neuron is one forward pass.'
        : p[top] < 0.6
          ? 'It is not sure, and the runner-up is close. Turn the wires down and watch which connections it is relying on.'
          : mlp
            ? 'Every unit here reads all 784 pixels at once, so this network had to learn for itself that neighbouring pixels are related.'
            : 'The same nine numbers are used at every position, which is why this network needs a fraction of the weights and is still right more often.',
    });
  }

  // --- drawing ---------------------------------------------------------------
  function paint(cx: number, cy: number) {
    const r = 8;
    for (let y = Math.max(0, Math.floor(cy - r)); y <= Math.min(PAD - 1, Math.ceil(cy + r)); y++)
      for (let x = Math.max(0, Math.floor(cx - r)); x <= Math.min(PAD - 1, Math.ceil(cx + r)); x++) {
        const d = Math.hypot(x + 0.5 - cx, y + 0.5 - cy);
        if (d > r) continue;
        const v = Math.min(1, Math.pow(1 - d / r, 1.4) * 1.5);
        const i = y * PAD + x;
        if (v > ink140[i]) ink140[i] = v;
      }
  }
  let drawing = false, last: { x: number; y: number } | null = null;
  const local = (e: PointerEvent) => {
    const r = canvas.getBoundingClientRect();
    return { x: ((e.clientX - r.left) / r.width) * W, y: ((e.clientY - r.top) / r.height) * H };
  };
  const toPad = (pt: { x: number; y: number }) => ({
    x: ((pt.x - IMG.x) / IMG.s) * PAD,
    y: ((pt.y - IMG.y) / IMG.s) * PAD,
    inside: pt.x >= IMG.x && pt.x <= IMG.x + IMG.s && pt.y >= IMG.y && pt.y <= IMG.y + IMG.s,
  });
  function stroke(to: { x: number; y: number }) {
    if (last) {
      const n = Math.ceil(Math.hypot(to.x - last.x, to.y - last.y)) + 1;
      for (let i = 1; i <= n; i++) paint(last.x + ((to.x - last.x) * i) / n, last.y + ((to.y - last.y) * i) / n);
    } else paint(to.x, to.y);
    last = to;
    seen = normalise(ink140, PAD);
    draw();
  }

  /** Which neuron, if any, is under the pointer. */
  function hit(pt: { x: number; y: number }) {
    if (state.model === 'mlp') {
      const cols = COL.mlp;
      for (let l = 0; l < 2; l++)
        for (let i = 0; i < cols[l].n; i++)
          if (Math.hypot(pt.x - cols[l].x, pt.y - nodeY(cols[l], i)) < cols[l].r + 5) return { layer: l, i };
    } else {
      for (let l = 0; l < 2; l++) {
        const g = COL.cnn[l as 0 | 1];
        for (let c = 0; c < g.n; c++) {
          const b = mapBox(l as 0 | 1, c);
          if (pt.x >= b.x && pt.x <= b.x + b.s && pt.y >= b.y && pt.y <= b.y + b.s) return { layer: l, i: c };
        }
      }
    }
    for (let d = 0; d < 10; d++) if (Math.hypot(pt.x - O.x, pt.y - outY(d)) < O.r + 5) return { layer: 2, i: d };
    return null;
  }

  canvas.addEventListener('pointerdown', (e) => {
    const pt = local(e);
    const h = hit(pt);
    if (h) {
      state.sel = state.sel && state.sel.layer === h.layer && state.sel.i === h.i ? null : h;
      draw();
      return;
    }
    const p = toPad(pt);
    if (!p.inside) return;
    drawing = true;
    last = null;
    state.sample = -1;
    try { canvas.setPointerCapture(e.pointerId); } catch { /* synthetic pointers need no capture */ }
    stroke(p);
  });
  canvas.addEventListener('pointermove', (e) => {
    const pt = local(e);
    if (drawing) { stroke(toPad(pt)); return; }
    canvas.style.cursor = hit(pt) ? 'pointer' : toPad(pt).inside ? 'crosshair' : 'default';
  });
  const drop = () => { drawing = false; last = null; };
  canvas.addEventListener('pointerup', drop);
  canvas.addEventListener('pointercancel', drop);

  function loadSample() {
    state.sample = (state.sample + 1) % SAMPLES.length;
    const s = SAMPLES[state.sample];
    seen = s.img.slice();
    ink140.fill(0);
    const k = PAD / 28;
    for (let y = 0; y < 28; y++)
      for (let x = 0; x < 28; x++) {
        const v = s.img[y * 28 + x];
        if (v < 0.02) continue;
        for (let dy = 0; dy < k; dy++)
          for (let dx = 0; dx < k; dx++) ink140[(y * k + dy) * PAD + (x * k + dx)] = v;
      }
    draw();
  }

  segmented('model', (m) => { state.model = m; state.sel = null; draw(); });
  slider('edges', (v) => { state.edges = v / 100; draw(); }, (v) => `${v}%`);
  check('signed', (on) => { state.signed = on; draw(); });
  el('clear').addEventListener('click', () => {
    ink140.fill(0);
    seen = new Float32Array(784);
    state.sample = -1;
    draw();
  });
  el('sample').addEventListener('click', loadSample);

  loadSample();
</script>

<style>
  #nn {
    touch-action: none;
  }
</style>
