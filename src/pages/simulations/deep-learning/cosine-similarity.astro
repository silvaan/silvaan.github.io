---
import SimLayout from '../../../layouts/SimLayout.astro';
---

<SimLayout
  areaSlug="deep-learning"
  title="Embeddings & Cosine Similarity"
  description="An embedding turns a word into an arrow. Two words mean similar things when their arrows point the same way, so similarity is an angle and nothing else. Drag the query arrow around and watch which word it lines up with."
>
  <div class="sim">
    <div class="sim-stage">
      <canvas id="cos" width="820" height="510"></canvas>
    </div>

    <div class="sim-panel">
      <div class="control">
        <label>Rank the words by</label>
        <div class="seg" id="score">
          <button data-s="cos" class="active">cos θ</button>
          <button data-s="dot">dot product</button>
        </div>
      </div>

      <div class="control">
        <label for="compare">Compare the query with</label>
        <select id="compare">
          <option value="best">its best match</option>
        </select>
      </div>

      <div class="wlist" id="list"></div>

      <label class="check"
        ><input type="checkbox" id="unit" /> Force the query to length 1</label
      >
      <label class="check"
        ><input type="checkbox" id="proj" checked /> Show the shadow the query casts</label
      >

      <div class="readout">
        <div class="row"><span>Angle θ</span><b id="ang">—</b></div>
        <div class="row"><span>cos θ</span><b id="cosv">—</b></div>
        <div class="row"><span>Dot product</span><b id="dotv">—</b></div>
        <div class="row"><span>Query length</span><b id="qlen">—</b></div>
      </div>

      <p class="note">
        Drag the arrow anywhere on the stage to move the query, or click a word to
        compare with it. Real embeddings have hundreds of dimensions; this one has
        two so the angle is something you can see.
      </p>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Swing the query around the circle. The match changes the moment the
      <b>angle</b> changes, and it never changes while you only make the arrow
      longer or shorter. Cosine similarity divides the length out, so it measures
      <b>direction alone</b>.
    </li>
    <li>
      cos θ runs from <b>1</b> (same direction, same meaning) through <b>0</b> (at
      right angles, unrelated) to <b>−1</b> (opposite). Lay the query straight on
      <b>puppy</b> and the panel reads 1.00, with dog just behind it, car near 0
      and king below zero. Those numbers are the whole of semantic search.
    </li>
    <li>
      Turn on the shadow. The dashed line drops the query tip onto the word's
      direction, and the bright segment left behind has length |q| cos θ. That
      shadow is what the dot product measures; the cosine is the same shadow after
      dividing by both lengths.
    </li>
    <li>
      Now switch the ranking to <b>dot product</b>. The generic word <b>thing</b>,
      drawn long because it appears everywhere, takes over the top spot from
      whatever you are actually pointing at. Raw dot products reward long vectors,
      which is exactly why retrieval systems normalise and use the cosine.
    </li>
    <li>
      Tick <b>force the query to length 1</b>. Every arrow now sits on the circle,
      the dot product and the cosine become the same number, and the shadow is
      literally cos θ. Normalised embeddings are used precisely so these two agree.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';

  const canvas = document.getElementById('cos') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const css = (v: string, f = '') =>
    getComputedStyle(canvas).getPropertyValue(v).trim() || f;
  const ink = (a: number) => `rgba(${css('--stage-ink', '232,233,236')},${a})`;
  const { label } = makeText(ctx, ink);
  const accent = () => css('--accent', '#7c8cff');
  const teal = () => css('--accent-2', '#5eead4');

  // A hand-made two-dimensional "embedding": words that mean similar things
  // point the same way, and `thing` is long the way a very frequent generic
  // word is long in a real model.
  const WORDS = [
    { w: 'king', a: 76, r: 0.84 },
    { w: 'queen', a: 102, r: 0.79 },
    { w: 'cat', a: 162, r: 0.92 },
    { w: 'kitten', a: 180, r: 0.58 },
    { w: 'dog', a: 204, r: 0.96 },
    { w: 'puppy', a: 224, r: 0.62 },
    { w: 'thing', a: 244, r: 1.42 },
    { w: 'car', a: 316, r: 0.88 },
    { w: 'truck', a: 334, r: 0.74 },
  ];

  const state = {
    qa: (232 * Math.PI) / 180,
    ql: 0.8,
    score: 'cos' as 'cos' | 'dot',
    compare: 'best',
    unit: false,
    proj: true,
  };

  const C = { x: 300, y: 238, R: 158 };
  const rad = (deg: number) => (deg * Math.PI) / 180;
  const toX = (a: number, r: number) => C.x + C.R * r * Math.cos(a);
  const toY = (a: number, r: number) => C.y - C.R * r * Math.sin(a);
  const qlen = () => (state.unit ? 1 : state.ql);

  const cosOf = (a: number) => Math.cos(a - state.qa);
  const dotOf = (a: number, r: number) => qlen() * r * Math.cos(a - state.qa);
  const scoreOf = (word: { a: number; r: number }) =>
    state.score === 'cos' ? cosOf(rad(word.a)) : dotOf(rad(word.a), word.r);

  function ranked() {
    return WORDS.map((x) => ({ ...x, s: scoreOf(x) })).sort((p, q) => q.s - p.s);
  }
  function target() {
    if (state.compare !== 'best') {
      const f = WORDS.find((x) => x.w === state.compare);
      if (f) return f;
    }
    return ranked()[0];
  }

  function arrow(a: number, r: number, colour: string, width: number) {
    const x = toX(a, r),
      y = toY(a, r);
    ctx.strokeStyle = colour;
    ctx.lineWidth = width;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(C.x, C.y);
    ctx.lineTo(x, y);
    ctx.stroke();
    const head = 5 + width * 1.8;
    ctx.fillStyle = colour;
    ctx.beginPath();
    ctx.moveTo(x, y);
    ctx.lineTo(
      x - head * Math.cos(a - 0.38),
      y + head * Math.sin(a - 0.38)
    );
    ctx.lineTo(
      x - head * Math.cos(a + 0.38),
      y + head * Math.sin(a + 0.38)
    );
    ctx.closePath();
    ctx.fill();
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    const t = target();
    const ta = rad(t.a);
    const q = state.qa;
    const c = cosOf(ta);
    const theta = (Math.acos(Math.max(-1, Math.min(1, c))) * 180) / Math.PI;

    // unit circle
    ctx.strokeStyle = ink(0.16);
    ctx.lineWidth = 1;
    ctx.setLineDash([3, 5]);
    ctx.beginPath();
    ctx.arc(C.x, C.y, C.R, 0, Math.PI * 2);
    ctx.stroke();
    ctx.setLineDash([]);
    label('length 1', C.x + C.R + 8, C.y - 6, 0.3, 'left', 10.5);

    // the shadow of the query on the matched direction
    if (state.proj) {
      const shadow = qlen() * c;
      ctx.strokeStyle = ink(0.14);
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(toX(ta, -1.5), toY(ta, -1.5));
      ctx.lineTo(toX(ta, 1.7), toY(ta, 1.7));
      ctx.stroke();
      ctx.strokeStyle = teal();
      ctx.lineWidth = 6;
      ctx.globalAlpha = 0.35;
      ctx.beginPath();
      ctx.moveTo(C.x, C.y);
      ctx.lineTo(toX(ta, shadow), toY(ta, shadow));
      ctx.stroke();
      ctx.globalAlpha = 1;
      ctx.strokeStyle = ink(0.35);
      ctx.setLineDash([4, 4]);
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(toX(q, qlen()), toY(q, qlen()));
      ctx.lineTo(toX(ta, shadow), toY(ta, shadow));
      ctx.stroke();
      ctx.setLineDash([]);
    }

    // angle wedge between the query and the compared word
    const wr = 74;
    let a0 = q,
      a1 = ta;
    if (((a1 - a0 + Math.PI * 4) % (Math.PI * 2)) > Math.PI) [a0, a1] = [a1, a0];
    ctx.fillStyle = `${teal()}22`;
    ctx.beginPath();
    ctx.moveTo(C.x, C.y);
    ctx.arc(C.x, C.y, wr, -a0, -a1, true);
    ctx.closePath();
    ctx.fill();

    // the vocabulary
    for (const word of WORDS) {
      const a = rad(word.a);
      const on = word.w === t.w;
      arrow(a, word.r, on ? teal() : ink(0.3), on ? 3 : 1.6);
      const lx = toX(a, word.r) + 14 * Math.cos(a);
      const ly = toY(a, word.r) - 14 * Math.sin(a) + 4;
      label(
        word.w,
        lx,
        ly,
        on ? 1 : 0.5,
        Math.cos(a) < -0.25 ? 'right' : Math.cos(a) > 0.25 ? 'left' : 'center',
        on ? 13 : 12,
        on ? teal() : undefined
      );
    }

    // the query
    arrow(q, qlen(), accent(), 3.4);
    ctx.fillStyle = accent();
    ctx.beginPath();
    ctx.arc(toX(q, qlen()), toY(q, qlen()), 7, 0, Math.PI * 2);
    ctx.fill();
    label(
      'query',
      toX(q, qlen()) + 26 * Math.cos(q),
      toY(q, qlen()) - 26 * Math.sin(q) + 4,
      1,
      Math.cos(q) < -0.25 ? 'right' : Math.cos(q) > 0.25 ? 'left' : 'center',
      12,
      accent()
    );

    // the answer, in words
    const bx = 590;
    label('SIMILARITY WITH', bx, 176, 0.45, 'left', 11);
    label(t.w, bx, 214, 1, 'left', 22, teal());
    label('cos θ', bx, 268, 0.45, 'left', 11);
    label(c.toFixed(2), bx, 312, 1, 'left', 30, accent());
    label(`θ = ${theta.toFixed(1)}°`, bx, 344, 0.55, 'left', 12);
    label(
      state.proj ? `shadow = |q| cos θ = ${(qlen() * c).toFixed(2)}` : '',
      bx,
      370,
      0.45,
      'left',
      11
    );
    label('drag the arrow · click a word', 32, 32, 0.32, 'left', 10.5);

    updatePanel(c, theta, t);
  }

  // --- panel -----------------------------------------------------------------
  const listEl = document.getElementById('list') as HTMLElement;
  const $ = (id: string) => document.getElementById(id) as HTMLElement;

  function updatePanel(c: number, theta: number, t: { w: string; r: number }) {
    const rows = ranked();
    const span = Math.max(...rows.map((r) => Math.abs(r.s)), 0.001);
    listEl.innerHTML = rows
      .map((r) => {
        const w = (Math.abs(r.s) / span) * 50;
        const side = r.s >= 0 ? `left:50%` : `right:50%`;
        return `<div class="cs-row${r.w === t.w ? ' sel' : ''}" data-w="${r.w}">
          <span class="nm">${r.w}</span>
          <span class="bar"><i style="${side};width:${w}%"></i><s></s></span>
          <b>${r.s.toFixed(2)}</b>
        </div>`;
      })
      .join('');
    $('ang').textContent = `${theta.toFixed(1)}°`;
    $('cosv').textContent = c.toFixed(3);
    $('dotv').textContent = (qlen() * t.r * c).toFixed(3);
    $('qlen').textContent = qlen().toFixed(2);
  }

  const sel = $('compare') as HTMLSelectElement;
  for (const word of WORDS) {
    const o = document.createElement('option');
    o.value = word.w;
    o.textContent = word.w;
    sel.appendChild(o);
  }

  sel.addEventListener('change', () => {
    state.compare = sel.value;
    draw();
  });
  listEl.addEventListener('click', (e) => {
    const row = (e.target as HTMLElement).closest('.cs-row') as HTMLElement | null;
    if (!row) return;
    state.compare = state.compare === row.dataset.w ? 'best' : row.dataset.w!;
    sel.value = state.compare;
    draw();
  });
  $('score').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (!b) return;
    document
      .querySelectorAll('#score button')
      .forEach((x) => x.classList.remove('active'));
    b.classList.add('active');
    state.score = b.dataset.s as 'cos' | 'dot';
    draw();
  });
  ($('unit') as HTMLInputElement).addEventListener('change', (e) => {
    state.unit = (e.target as HTMLInputElement).checked;
    draw();
  });
  ($('proj') as HTMLInputElement).addEventListener('change', (e) => {
    state.proj = (e.target as HTMLInputElement).checked;
    draw();
  });

  // --- dragging --------------------------------------------------------------
  let dragging = false;
  function pointer(e: PointerEvent) {
    const b = canvas.getBoundingClientRect();
    return {
      x: ((e.clientX - b.left) / b.width) * W,
      y: ((e.clientY - b.top) / b.height) * H,
    };
  }
  function setQuery(p: { x: number; y: number }) {
    const dx = p.x - C.x,
      dy = C.y - p.y;
    state.qa = Math.atan2(dy, dx);
    if (!state.unit)
      state.ql = Math.max(0.15, Math.min(1.6, Math.hypot(dx, dy) / C.R));
    draw();
  }

  canvas.addEventListener('pointerdown', (e) => {
    const p = pointer(e);
    // a click on a word tip pins the comparison instead of moving the query
    for (const word of WORDS) {
      const a = rad(word.a);
      if (Math.hypot(p.x - toX(a, word.r), p.y - toY(a, word.r)) < 22) {
        state.compare = state.compare === word.w ? 'best' : word.w;
        sel.value = state.compare;
        draw();
        return;
      }
    }
    dragging = true;
    canvas.setPointerCapture(e.pointerId);
    setQuery(p);
  });
  canvas.addEventListener('pointermove', (e) => {
    if (dragging) setQuery(pointer(e));
  });
  canvas.addEventListener('pointerup', () => (dragging = false));
  canvas.addEventListener('pointercancel', () => (dragging = false));

  draw();
</script>

<style>
  #cos {
    cursor: crosshair;
    touch-action: none;
  }
  .sim-panel select {
    width: 100%;
    padding: 7px 9px;
    font: inherit;
    font-size: 0.85rem;
    color: var(--text);
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .wlist {
    display: grid;
    gap: 2px;
  }
  .check {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .note {
    font-size: 0.82rem;
    color: var(--text-faint);
    margin: 0;
    line-height: 1.55;
  }
</style>

<!-- The ranking rows are injected via innerHTML, so they never carry Astro's
     scoped attribute; these rules have to be global to reach them. -->
<style is:global>
  .cs-row {
    display: grid;
    grid-template-columns: 58px 1fr 40px;
    align-items: center;
    gap: 9px;
    padding: 4px 5px;
    border-radius: 6px;
    cursor: pointer;
  }
  .cs-row:hover {
    background: var(--bg-elev);
  }
  .cs-row.sel {
    background: var(--accent-soft);
  }
  .cs-row .nm {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .cs-row.sel .nm {
    color: var(--text);
  }
  .cs-row .bar {
    position: relative;
    display: block;
    height: 8px;
    background: var(--bg-elev);
    border-radius: 4px;
    overflow: hidden;
  }
  .cs-row .bar i {
    position: absolute;
    top: 0;
    bottom: 0;
    background: var(--accent);
    opacity: 0.55;
  }
  .cs-row.sel .bar i {
    background: var(--accent-2);
    opacity: 0.9;
  }
  .cs-row .bar s {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--border-strong);
  }
  .cs-row b {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.78rem;
    text-align: right;
    color: var(--accent-2);
  }
</style>
