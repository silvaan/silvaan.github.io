---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Matrix from '../../../components/sim/Matrix.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';

const PRESETS = [
  { value: '0,-1,1,0', label: 'Rotate 90°' },
  { value: 'r45', label: 'Rotate 45°' },
  { value: '1,1,0,1', label: 'Shear' },
  { value: '-1,0,0,1', label: 'Reflect' },
];
---

<SimLayout
  areaSlug="linear-algebra"
  title="Matrix Multiplication"
  description="Multiplying two matrices chains their maps: AB means apply B, then A. Run both orders side by side and watch the letter F end up in two different places."
  shortcuts={['animate', 'fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="mm"
          width="1000"
          height="600"
          role="img"
          aria-label="Two copies of the plane with a letter F. On the left the plane is moved by B and then by A, ending at the map AB; on the right by A and then by B, ending at BA. The images of the basis vectors and the unit square are drawn in each."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'A', color: '#f472b6' },
          { label: 'B', color: '#fb923c' },
          { label: 'image of î', color: '#7c8cff' },
          { label: 'image of ĵ', color: '#5eead4' },
          { label: 'the F', color: '#fbbf24' },
        ]}
        hint="Hover or tap an entry of the product to see where it comes from"
      />
      <Result label="Order matters?" />
      <div class="prod" id="prod" aria-label="The product, entry by entry">
        <div class="prod-row">
          <div class="pm" id="pL">
            <span class="pm-name" id="pL-name">A</span>
            <div class="pm-body">
              <span id="pL-0"></span><span id="pL-1"></span><span id="pL-2"></span><span id="pL-3"></span>
            </div>
          </div>
          <span class="op">·</span>
          <div class="pm" id="pR">
            <span class="pm-name" id="pR-name">B</span>
            <div class="pm-body">
              <span id="pR-0"></span><span id="pR-1"></span><span id="pR-2"></span><span id="pR-3"></span>
            </div>
          </div>
          <span class="op">=</span>
          <div class="pm pm-out" id="pP">
            <span class="pm-name" id="pP-name">AB</span>
            <div class="pm-body">
              <button type="button" id="pP-0" data-ij="0"></button><button type="button" id="pP-1" data-ij="1"></button><button type="button" id="pP-2" data-ij="2"></button><button type="button" id="pP-3" data-ij="3"></button>
            </div>
          </div>
        </div>
        <p class="prod-line" id="prod-line"></p>
      </div>
    </div>

    <div class="sim-panel">
      <Matrix
        label="Matrix <span style='color:#f472b6'>A</span>"
        view
        step={0.01}
        entries={[
          { id: 'aa', label: 'a', value: 1 },
          { id: 'ab', label: 'b', value: 1 },
          { id: 'ac', label: 'c', value: 0 },
          { id: 'ad', label: 'd', value: 1 },
        ]}
      />
      <Seg
        id="pre-a"
        attr="m"
        active="1,1,0,1"
        options={[...PRESETS, { value: '1.5,0,0,0.75', label: 'Stretch' }, { value: '1,0,0,0', label: 'Project' }]}
      />
      <Matrix
        label="Matrix <span style='color:#fb923c'>B</span>"
        view
        step={0.01}
        entries={[
          { id: 'ba', label: 'a', value: 0 },
          { id: 'bb', label: 'b', value: -1 },
          { id: 'bc', label: 'c', value: 1 },
          { id: 'bd', label: 'd', value: 0 },
        ]}
      />
      <Seg
        id="pre-b"
        attr="m"
        active="0,-1,1,0"
        options={[
          ...PRESETS,
          { value: '1.25,0,0,1.5', label: 'Stretch' },
          { value: '1,0,0,0', label: 'Project' },
          { value: 'inv', label: 'A⁻¹' },
        ]}
      />
      <Seg
        id="view"
        label="Show"
        attr="v"
        options={[
          { value: 'both', label: 'Both orders' },
          { value: 'ab', label: 'B, then A' },
          { value: 'ba', label: 'A, then B' },
        ]}
      />
      <Slider id="s" label="Maps applied" min={0} max={200} value={200} display="2.00" hint={['none', 'both']} />
      <Transport animate="Animate both orders" reset={false} />
      <Readout
        title="Values"
        rows={[
          { id: 'r-da', label: 'det A' },
          { id: 'r-db', label: 'det B' },
          { id: 'r-dab', label: 'det AB' },
          { id: 'r-dba', label: 'det BA' },
          { id: 'r-ab', label: 'AB' },
          { id: 'r-ba', label: 'BA' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Take A = <b>Shear</b> and B = <b>Rotate 90°</b> and run both orders. Rotating
      and then shearing leaves the F somewhere else than shearing and
      then rotating, so <b>AB ≠ BA</b>. <Try id="order" label="Animate" />
    </li>
    <li>
      Two rotations <b>commute</b>: 90° then 45° is 45° then 90°, and both sides end
      on the same F. Two diagonal stretches commute too, since each just scales the
      axes. <Try id="commute" label="Animate" />
    </li>
    <li>
      Set B = <b>A⁻¹</b>. B undoes the shear before A redoes it, so the F comes
      back home and AB is the identity. <Try id="inverse" label="Animate" />
    </li>
    <li>
      Watch the <b>area</b> factor in each panel: B scales areas by det B, then A
      by det A, so det AB = det A · det B in either order. A reflection makes it
      negative and flips the F. <Try id="det" label="Animate" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation, type Part } from '../../../lib/equation';
  import { stageInk, fixed } from '../../../lib/draw';
  import { el, segmented, slider, matrix, result, readout, tries } from '../../../lib/panel';

  type M2 = { a: number; b: number; c: number; d: number };
  type Pt = { x: number; y: number };
  type Box = { x0: number; y0: number; x1: number; y1: number };

  // Canvas colours: the site's dark-stage hues, deepened on the light stage so they hold up on white.
  const DARK = { AC: '#f472b6', BC: '#fb923c', IH: '#7c8cff', JH: '#5eead4', FC: '#fbbf24', NEG: '#f87171', OK: '#34d399' };
  const LIGHT = { AC: '#db2777', BC: '#ea580c', IH: '#4f5fe0', JH: '#0d9488', FC: '#d97706', NEG: '#dc2626', OK: '#059669' };
  let { AC, BC, IH, JH, FC, NEG, OK } = DARK;
  const rgbaOf = (hex: string, a: number) =>
    `rgba(${parseInt(hex.slice(1, 3), 16)},${parseInt(hex.slice(3, 5), 16)},${parseInt(hex.slice(5, 7), 16)},${a})`;

  const A: M2 = { a: 1, b: 1, c: 0, d: 1 };
  const B: M2 = { a: 0, b: -1, c: 1, d: 0 };
  const state = { s: 2, view: 'both', hover: -1, pinned: -1 };

  const canvas = el('mm') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink, inv, css } = stageInk(canvas);
  function paint() {
    const rgb = css('--stage-ink', '232,233,236').split(',').map(Number);
    ({ AC, BC, IH, JH, FC, NEG, OK } = rgb[0] + rgb[1] + rgb[2] < 384 ? LIGHT : DARK);
  }
  const { label, textWidth } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  // ---- matrix helpers -------------------------------------------------------
  const mul = (X: M2, Y: M2): M2 => ({
    a: X.a * Y.a + X.b * Y.c,
    b: X.a * Y.b + X.b * Y.d,
    c: X.c * Y.a + X.d * Y.c,
    d: X.c * Y.b + X.d * Y.d,
  });
  const det = (X: M2) => X.a * X.d - X.b * X.c;
  const apply = (X: M2, p: Pt): Pt => ({ x: X.a * p.x + X.b * p.y, y: X.c * p.x + X.d * p.y });
  const I2: M2 = { a: 1, b: 0, c: 0, d: 1 };
  const same = (X: M2, Y: M2) => Math.max(Math.abs(X.a - Y.a), Math.abs(X.b - Y.b), Math.abs(X.c - Y.c), Math.abs(X.d - Y.d)) < 1e-3;
  const n2 = (v: number) => fixed(v, 2);
  /** The same number for KaTeX, with an ASCII minus. */
  const t2 = (v: number) => n2(v).replace('−', '-');
  const mat = (X: M2) => `[${n2(X.a)} ${n2(X.b)}; ${n2(X.c)} ${n2(X.d)}]`;

  /**
   * The frame partway from I to X: R(tθ) times a straight blend of X's
   * symmetric stretch (X = R(θ)S), so a rotation turns rigidly instead of
   * cutting the corner through a shrunken grid.
   */
  function partway(X: M2, t: number): M2 {
    if (t <= 0) return { ...I2 };
    if (t >= 1) return { ...X };
    const th = Math.atan2(X.c - X.b, X.a + X.d), c = Math.cos(th), s = Math.sin(th);
    const S = { a: c * X.a + s * X.c, b: c * X.b + s * X.d, c: -s * X.a + c * X.c, d: -s * X.b + c * X.d };
    const Bl = { a: 1 - t + t * S.a, b: t * S.b, c: t * S.c, d: 1 - t + t * S.d };
    const ct = Math.cos(t * th), st = Math.sin(t * th);
    return { a: ct * Bl.a - st * Bl.c, b: ct * Bl.b - st * Bl.d, c: st * Bl.a + ct * Bl.c, d: st * Bl.b + ct * Bl.d };
  }
  /** first map, then second, at progress s in [0, 2]. */
  const frameAt = (first: M2, second: M2, s: number) => mul(partway(second, s - 1), partway(first, Math.min(1, s)));

  // ---- the F: an asymmetric letter so a flip or a turn reads at a glance ------
  const F_SHAPE: Pt[] = [
    [0, 0], [0.34, 0], [0.34, 0.74], [0.8, 0.74], [0.8, 1.06], [0.34, 1.06], [0.34, 1.38], [1.05, 1.38], [1.05, 1.7], [0, 1.7],
  ].map(([x, y]) => ({ x: x + 0.55, y: y + 0.2 }));

  // ---- layout ---------------------------------------------------------------
  type Panel = { x0: number; w: number; first: 'A' | 'B'; o: Pt; unit: number };
  function panels(): Panel[] {
    const top = 34; // room for the title line
    const mk = (x0: number, w: number, first: 'A' | 'B', unit: number): Panel => ({ x0, w, first, unit, o: { x: x0 + w / 2, y: top + (H - top) / 2 + 6 } });
    if (state.view === 'both') return [mk(0, W / 2, 'B', 66), mk(W / 2, W / 2, 'A', 66)];
    return [mk(0, W, state.view === 'ab' ? 'B' : 'A', 80)];
  }

  /** Text gets bigger as the canvas gets smaller on screen, so a phone can still read it. */
  let fs = 1;
  const refreshScale = () => { fs = Math.max(1, Math.min(2.1, 760 / Math.max(1, canvas.clientWidth))); };
  new ResizeObserver(() => { const old = fs; refreshScale(); if (old !== fs) draw(); }).observe(canvas);

  // ---- label placement: measured boxes, nudged to a free spot -----------------
  let boxes: Box[] = [];
  let segs: [Pt, Pt][] = [];
  const overlap = (p: Box, q: Box) => Math.max(0, Math.min(p.x1, q.x1) - Math.max(p.x0, q.x0)) * Math.max(0, Math.min(p.y1, q.y1) - Math.max(p.y0, q.y0));
  function segHits(b: Box, p: Pt, q: Pt) {
    // sample the segment; count samples that fall inside the padded box
    let n = 0;
    for (let i = 0; i <= 16; i++) {
      const x = p.x + ((q.x - p.x) * i) / 16, y = p.y + ((q.y - p.y) * i) / 16;
      if (x > b.x0 - 3 && x < b.x1 + 3 && y > b.y0 - 3 && y < b.y1 + 3) n++;
    }
    return n;
  }
  /** Place text near an anchor, trying spots around it, avoiding earlier labels and arrows. */
  function place(text: string, at: Pt, col: string, size: number, clip: Box, alpha = 0.95) {
    const sz = size * fs;
    const w = textWidth(text, sz), px = Math.round(sz * 1.42);
    const h = px;
    const gap = 7;
    const spots: [number, number][] = [
      [gap, -gap - h], [gap, gap], [-gap - w, -gap - h], [-gap - w, gap], [-w / 2, -gap - h - 4], [-w / 2, gap + 4],
      [gap + 8, -h / 2], [-gap - w - 8, -h / 2], [gap + 14, -gap - h - 14], [-gap - w - 14, gap + 14], [gap + 14, gap + 14], [-gap - w - 14, -gap - h - 14],
    ];
    let best: Box | null = null, bestScore = Infinity;
    for (let k = 0; k < spots.length; k++) {
      const b = { x0: at.x + spots[k][0], y0: at.y + spots[k][1], x1: at.x + spots[k][0] + w, y1: at.y + spots[k][1] + h };
      let score = k * 0.5;
      if (b.x0 < clip.x0 + 2 || b.x1 > clip.x1 - 2 || b.y0 < clip.y0 + 2 || b.y1 > clip.y1 - 2) score += 4000;
      for (const o of boxes) score += overlap(b, o) * 4;
      for (const [p, q] of segs) score += segHits(b, p, q) * 60;
      if (score < bestScore) { bestScore = score; best = b; }
      if (score < 1) break;
    }
    const b = best!;
    boxes.push(b);
    ctx.fillStyle = inv(0.72);
    ctx.fillRect(b.x0 - 2, b.y0, b.x1 - b.x0 + 4, b.y1 - b.y0);
    label(text, b.x0, b.y0 + px * 0.8, alpha, 'left', sz, col);
  }

  // ---- drawing --------------------------------------------------------------
  function arrow(o: Pt, p: Pt, col: string, lw: number, dash: number[] = []) {
    const an = Math.atan2(p.y - o.y, p.x - o.x);
    const len = Math.hypot(p.x - o.x, p.y - o.y);
    const head = Math.min(13, len * 0.45);
    ctx.strokeStyle = col;
    ctx.fillStyle = col;
    ctx.lineWidth = lw;
    ctx.setLineDash(dash);
    ctx.beginPath();
    ctx.moveTo(o.x, o.y);
    ctx.lineTo(p.x - head * 0.8 * Math.cos(an), p.y - head * 0.8 * Math.sin(an));
    ctx.stroke();
    ctx.setLineDash([]);
    if (len < 2) return;
    ctx.beginPath();
    ctx.moveTo(p.x, p.y);
    ctx.lineTo(p.x - head * Math.cos(an - 0.38), p.y - head * Math.sin(an - 0.38));
    ctx.lineTo(p.x - head * Math.cos(an + 0.38), p.y - head * Math.sin(an + 0.38));
    ctx.closePath();
    ctx.fill();
    segs.push([o, p]);
  }

  function drawPanel(P: Panel, index: number) {
    const first = P.first === 'B' ? B : A, second = P.first === 'B' ? A : B;
    const fN = P.first, sN = P.first === 'B' ? 'A' : 'B';
    const fC = P.first === 'B' ? BC : AC, sC = P.first === 'B' ? AC : BC;
    const prodName = sN + fN;
    const s = state.s;
    const M = frameAt(first, second, s);
    const S = (q: Pt): Pt => ({ x: P.o.x + q.x * P.unit, y: P.o.y - q.y * P.unit });
    const T = (q: Pt) => S(apply(M, q));
    const clip: Box = { x0: P.x0, y0: 0, x1: P.x0 + P.w, y1: H };

    ctx.save();
    ctx.beginPath();
    ctx.rect(P.x0, 0, P.w, H);
    ctx.clip();

    // home grid, faint and dashed
    const R = 30;
    ctx.strokeStyle = ink(0.09);
    ctx.lineWidth = 1;
    ctx.setLineDash([3, 4]);
    ctx.beginPath();
    for (let i = -R; i <= R; i++) {
      const a1 = S({ x: i, y: -R }), a2 = S({ x: i, y: R }), b1 = S({ x: -R, y: i }), b2 = S({ x: R, y: i });
      ctx.moveTo(a1.x, a1.y); ctx.lineTo(a2.x, a2.y); ctx.moveTo(b1.x, b1.y); ctx.lineTo(b2.x, b2.y);
    }
    ctx.stroke();
    ctx.setLineDash([]);

    // the moving grid
    ctx.strokeStyle = ink(0.2);
    ctx.beginPath();
    for (let i = -R; i <= R; i++) {
      const a1 = T({ x: i, y: -R }), a2 = T({ x: i, y: R }), b1 = T({ x: -R, y: i }), b2 = T({ x: R, y: i });
      ctx.moveTo(a1.x, a1.y); ctx.lineTo(a2.x, a2.y); ctx.moveTo(b1.x, b1.y); ctx.lineTo(b2.x, b2.y);
    }
    ctx.stroke();
    // home axes, so every panel shows the same fixed origin cross
    ctx.strokeStyle = ink(0.16);
    ctx.beginPath();
    { const a1 = S({ x: -R, y: 0 }), a2 = S({ x: R, y: 0 }), b1 = S({ x: 0, y: -R }), b2 = S({ x: 0, y: R });
      ctx.moveTo(a1.x, a1.y); ctx.lineTo(a2.x, a2.y); ctx.moveTo(b1.x, b1.y); ctx.lineTo(b2.x, b2.y); }
    ctx.stroke();
    // the moved axes, tinted by the basis vector that runs along each, so a tilted one reads as î's or ĵ's line
    const axis = (d: Pt, col: string) => {
      const p1 = T({ x: -R * d.x, y: -R * d.y }), p2 = T({ x: R * d.x, y: R * d.y });
      ctx.strokeStyle = col;
      ctx.lineWidth = 1.2;
      ctx.beginPath(); ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y); ctx.stroke();
    };
    axis({ x: 1, y: 0 }, rgbaOf(IH, 0.3));
    axis({ x: 0, y: 1 }, rgbaOf(JH, 0.28));
    ctx.lineWidth = 1;

    // unit square, shaded by the sign of the area factor
    const dM = det(M);
    const sq = [{ x: 0, y: 0 }, { x: 1, y: 0 }, { x: 1, y: 1 }, { x: 0, y: 1 }].map(T);
    ctx.fillStyle = dM >= 0 ? rgbaOf(JH, 0.13) : rgbaOf(NEG, 0.16);
    ctx.beginPath();
    sq.forEach((p, i) => (i ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y)));
    ctx.closePath();
    ctx.fill();

    // the F at home (outline) and where it is now
    const fHome = F_SHAPE.map(S), fNow = F_SHAPE.map(T);
    ctx.strokeStyle = ink(0.32);
    ctx.lineWidth = 1.2;
    ctx.setLineDash([4, 4]);
    ctx.beginPath();
    fHome.forEach((p, i) => (i ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y)));
    ctx.closePath();
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = rgbaOf(FC, 0.42);
    ctx.strokeStyle = FC;
    ctx.lineWidth = 2;
    ctx.beginPath();
    fNow.forEach((p, i) => (i ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y)));
    ctx.closePath();
    ctx.fill();
    ctx.stroke();

    // columns: where î and ĵ are now; after the first map, also where the first map left them
    const o = S({ x: 0, y: 0 });
    const hoverCol = state.hover >= 0 && index === 0 ? state.hover % 2 : -1;
    const mid = first;
    const dim = (k: number) => hoverCol >= 0 && hoverCol !== k;
    if (s > 1.001) {
      arrow(o, S(apply(mid, { x: 1, y: 0 })), rgbaOf(IH, dim(0) ? 0.25 : 0.75), 1.6, [5, 4]);
      arrow(o, S(apply(mid, { x: 0, y: 1 })), rgbaOf(JH, dim(1) ? 0.22 : 0.75), 1.6, [5, 4]);
    }
    const iNow = T({ x: 1, y: 0 }), jNow = T({ x: 0, y: 1 });
    arrow(o, iNow, dim(0) ? rgbaOf(IH, 0.3) : IH, hoverCol === 0 ? 4.4 : 3);
    arrow(o, jNow, dim(1) ? rgbaOf(JH, 0.3) : JH, hoverCol === 1 ? 4.4 : 3);

    // title and phase
    boxes = [];
    const tsz = 12 * fs;
    let tx = P.x0 + 14;
    const ty = 10 + Math.round(tsz * 1.42) * 0.8;
    const seg = (t: string, col?: string, alpha = 0.6) => { label(t, tx, ty, alpha, 'left', tsz, col); tx += textWidth(t, tsz); };
    const phase = s <= 0 ? 0 : s < 1 ? 1 : s < 2 ? 2 : 3;
    seg(fN, fC, 1);
    seg(', then ', undefined, 0.6);
    seg(sN, sC, phase >= 2 || phase === 0 ? 1 : 0.45);
    seg(phase === 3 ? `  =  ${prodName}` : phase === 0 ? '  (nothing yet)' : phase === 1 ? `  applying ${fN}` : `  applying ${sN}`, undefined, 0.85);
    boxes.push({ x0: P.x0 + 8, y0: 4, x1: tx + 6, y1: 12 + Math.round(tsz * 1.42) });

    // area factor, bottom left
    const asz = 11 * fs;
    const areaText = `area ×${fixed(dM, 2)}${dM < -1e-9 ? ' (flipped)' : Math.abs(dM) < 1e-9 ? ' (flattened)' : ''}`;
    const ay = H - 12, aw = textWidth(areaText, asz);
    // the second of two panels keeps its readout on the far side, clear of the verdict in the middle
    const ax = index === 1 ? P.x0 + P.w - 14 - aw : P.x0 + 14;
    label(areaText, ax, ay, 0.9, 'left', asz, dM < -1e-9 || Math.abs(dM) < 1e-9 ? NEG : undefined);
    boxes.push({ x0: ax - 4, y0: ay - Math.round(asz * 1.42), x1: ax + aw + 4, y1: H });

    // labels for the arrows, placed where they don't collide
    const lsz = 12;
    const iName = phase === 3 ? `${prodName}î` : phase >= 2 ? `${sN}(${fN}î)` : phase === 1 ? `${fN}î` : 'î';
    const jName = phase === 3 ? `${prodName}ĵ` : phase >= 2 ? `${sN}(${fN}ĵ)` : phase === 1 ? `${fN}ĵ` : 'ĵ';
    place(iName, iNow, dim(0) ? rgbaOf(IH, 0.45) : IH, lsz, clip);
    place(jName, jNow, dim(1) ? rgbaOf(JH, 0.45) : JH, lsz, clip);
    if (s > 1.001 && fs < 1.6) {
      place(`${fN}î`, S(apply(mid, { x: 1, y: 0 })), rgbaOf(IH, 0.85), 10.5, clip, 0.8);
      place(`${fN}ĵ`, S(apply(mid, { x: 0, y: 1 })), rgbaOf(JH, 0.85), 10.5, clip, 0.8);
    }
    ctx.restore();
    segs = [];
  }

  function draw() {
    paint();
    ctx.clearRect(0, 0, W, H);
    const ps = panels();
    ps.forEach((P, k) => drawPanel(P, k));
    if (ps.length === 2) {
      ctx.strokeStyle = ink(0.16);
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(W / 2, 0); ctx.lineTo(W / 2, H); ctx.stroke();
    }
    // the verdict, once both maps have been applied
    const AB = mul(A, B), BA = mul(B, A);
    const commute = same(AB, BA);
    if (ps.length === 2 && state.s >= 2) {
      const t = commute ? 'AB = BA' : 'AB ≠ BA';
      const sz = 12.5 * fs, px = Math.round(sz * 1.42), w = textWidth(t, sz) + 20;
      const x = W / 2 - w / 2, y = H - px - 18;
      ctx.fillStyle = inv(0.9);
      ctx.strokeStyle = commute ? OK : NEG;
      ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.roundRect(x, y, w, px + 10, 8); ctx.fill(); ctx.stroke();
      label(t, W / 2, y + 5 + px * 0.8, 1, 'center', sz, commute ? OK : NEG);
    }
    panelText();
  }

  // ---- numbers: equation, result, the product widget -------------------------
  function panelText() {
    const leftFirst = state.view !== 'ba';
    const L = leftFirst ? A : B, Rm = leftFirst ? B : A;
    const LN = leftFirst ? 'A' : 'B', RN = leftFirst ? 'B' : 'A';
    const LC = leftFirst ? AC : BC, RC = leftFirst ? BC : AC;
    const P = mul(L, Rm);
    const dA = det(A), dB = det(B), dAB = det(mul(A, B));
    const AB = mul(A, B), BA = mul(B, A);
    const commute = same(AB, BA);

    const col = (k: 0 | 1) => apply(P, k ? { x: 0, y: 1 } : { x: 1, y: 0 });
    const ci = col(0), cj = col(1);
    // the opening brace sets the whole rule as one formula, so it shrinks to fit rather than breaking
    const rule: Part[] = ['{(', [LN, LC], [RN, RC], ')\\,v \\;=\\; ', [LN, LC], '(', [RN, RC], 'v)', '\\qquad \\det(', [LN, LC], [RN, RC], ') = \\det ', [LN, LC], '\\cdot\\det ', [RN, RC], '}'];
    setEq({
      rule,
      live: [
        [`${LN}${RN}\\hat{\\imath} = ${LN}(${RN}\\hat{\\imath}) = (${t2(ci.x)},\\,${t2(ci.y)})`, IH],
        [`\\quad ${LN}${RN}\\hat{\\jmath} = (${t2(cj.x)},\\,${t2(cj.y)})`, JH],
        `\\quad \\det = ${t2(det(L))}\\cdot ${t2(det(Rm))} = ${t2(det(P))}`,
      ],
    });

    const inverse = same(AB, I2) && same(BA, I2);
    setResult({
      value: commute ? 'AB = BA' : 'AB ≠ BA',
      colour: commute ? OK : NEG,
      status: `det AB = ${fixed(dA, 2)} × ${fixed(dB, 2)} = ${fixed(dAB, 2)}${inverse ? ' · B = A⁻¹' : ''}`,
      note: inverse
        ? 'B undoes A, so either order brings the F straight back home: AB = BA = I.'
        : commute
          ? 'These two maps commute: either order lands the F in the same place.'
          : 'Same two maps, different order, different result. The product is not commutative.',
    });
    setRows({
      'r-da': fixed(dA, 3),
      'r-db': fixed(dB, 3),
      'r-dab': fixed(dAB, 3),
      'r-dba': fixed(det(BA), 3),
      'r-ab': mat(AB),
      'r-ba': mat(BA),
    });

    for (const k of ['a', 'b', 'c', 'd'] as const) {
      el('m-a' + k).textContent = n2(A[k]);
      el('m-b' + k).textContent = n2(B[k]);
    }

    // the widget: L · R = P, with entry (i, j) = row i of L · column j of R
    el('pL-name').textContent = LN;
    el('pR-name').textContent = RN;
    el('pP-name').textContent = LN + RN;
    el('pL-name').style.color = LC;
    el('pR-name').style.color = RC;
    const Lv = [L.a, L.b, L.c, L.d], Rv = [Rm.a, Rm.b, Rm.c, Rm.d], Pv = [P.a, P.b, P.c, P.d];
    const h = state.hover;
    const hi = h >= 0 ? Math.floor(h / 2) : -1, hj = h >= 0 ? h % 2 : -1;
    for (let k = 0; k < 4; k++) {
      const r = Math.floor(k / 2), c = k % 2;
      const l = el('pL-' + k), rr = el('pR-' + k), p = el('pP-' + k);
      l.textContent = n2(Lv[k]);
      rr.textContent = n2(Rv[k]);
      p.textContent = n2(Pv[k]);
      l.classList.toggle('on', r === hi);
      rr.classList.toggle('on', c === hj);
      // without a hover, colour the columns of R and P by the basis vector they belong to
      rr.classList.toggle('ci', h < 0 && c === 0);
      rr.classList.toggle('cj', h < 0 && c === 1);
      p.classList.toggle('ci', c === 0);
      p.classList.toggle('cj', c === 1);
      p.classList.toggle('on', k === h);
      p.setAttribute('aria-pressed', String(k === state.pinned));
    }
    const line = el('prod-line');
    if (h >= 0) {
      const x1 = Lv[hi * 2], x2 = Lv[hi * 2 + 1], y1 = Rv[hj], y2 = Rv[2 + hj];
      const hat = hj ? 'ĵ' : 'î';
      line.innerHTML =
        `Entry (${hi + 1},${hj + 1}) = <span class="hl">row ${hi + 1} of ${LN}</span> · <span class="hl">column ${hj + 1} of ${RN}</span> = ` +
        `${n2(x1)}·${n2(y1)} + ${n2(x2)}·${n2(y2)} = <b>${n2(x1 * y1 + x2 * y2)}</b>. ` +
        `Column ${hj + 1} of ${LN}${RN} is ${LN} applied to ${RN}${hat} (bold on the ${state.view === 'both' ? 'left' : 'stage'}).`;
    } else {
      line.innerHTML =
        `Column view: each column of ${LN}${RN} is ${LN} applied to a column of ${RN}. ` +
        `<span class="ci">${LN}(${RN}î) = (${n2(ci.x)}, ${n2(ci.y)})</span>, <span class="cj">${LN}(${RN}ĵ) = (${n2(cj.x)}, ${n2(cj.y)})</span>.`;
    }
  }

  // ---- controls -------------------------------------------------------------
  const R45 = Math.SQRT1_2;
  const parse = (v: string): M2 | null => {
    if (v === 'r45') return { a: R45, b: -R45, c: R45, d: R45 };
    if (v === 'inv') {
      const D = det(A);
      if (Math.abs(D) < 1e-6) return null;
      return { a: A.d / D, b: -A.b / D, c: -A.c / D, d: A.a / D };
    }
    const [a, b, c, d] = v.split(',').map(Number);
    return { a, b, c, d };
  };

  let raf = 0;
  const stop = () => cancelAnimationFrame(raf);
  const setS = slider('s', (v) => { stop(); state.s = v / 100; draw(); }, (v) => (v / 100).toFixed(2));
  const finish = () => { state.s = 2; setS(200); };

  // The Matrix sliders are named aa…ad and ba…bd; these views read and write A and B's a, b, c, d.
  const entries = (M: M2) => {
    const view = {} as Record<string, number>;
    for (const k of ['a', 'b', 'c', 'd'] as const)
      Object.defineProperty(view, (M === A ? 'a' : 'b') + k, { get: () => M[k], set: (v: number) => { M[k] = v; } });
    return view;
  };
  const syncA = matrix(entries(A), ['aa', 'ab', 'ac', 'ad'], () => { stop(); preA.clear(); finish(); keepInverse(); draw(); });
  const syncB = matrix(entries(B), ['ba', 'bb', 'bc', 'bd'], () => { stop(); preB.clear(); finish(); draw(); });
  /** While B is set to A⁻¹, keep it the inverse as A changes. */
  function keepInverse() {
    if (preB.value() !== 'inv') return;
    const inv = parse('inv');
    if (inv) { Object.assign(B, inv); syncB(); } else preB.clear();
  }

  const preA = segmented('pre-a', (v) => {
    const m = parse(v);
    if (!m) return;
    stop(); Object.assign(A, m); syncA(); keepInverse(); finish(); draw();
  });
  const preB = segmented('pre-b', (v) => {
    const m = parse(v);
    stop();
    if (!m) {
      preB.clear();
      setResult({ value: 'no A⁻¹', colour: NEG, status: `det A = ${fixed(det(A), 2)}`, note: 'A squashes the plane onto a line, so no B can bring the F back: A has no inverse.' });
      return;
    }
    Object.assign(B, m); syncB(); finish(); draw();
  });
  const views = segmented('view', (v) => { state.view = v; draw(); });

  el('run').addEventListener('click', () => {
    stop();
    const t0 = performance.now();
    const ease = (x: number) => x * x * (3 - 2 * x);
    const tick = (now: number) => {
      const ms = now - t0;
      // first map 1.1 s, a short rest, second map 1.1 s
      const s = ms < 1100 ? ease(ms / 1100) : ms < 1450 ? 1 : 1 + ease(Math.min(1, (ms - 1450) / 1100));
      state.s = s;
      setS(Math.round(s * 100));
      draw();
      if (ms < 2550) raf = requestAnimationFrame(tick);
    };
    state.s = 0;
    raf = requestAnimationFrame(tick);
  });

  // hover / tap an entry of the product
  const cells = Array.from(document.querySelectorAll<HTMLButtonElement>('#pP button'));
  for (const c of cells) {
    const k = +(c.dataset.ij ?? -1);
    c.addEventListener('pointerenter', () => { state.hover = k; draw(); });
    c.addEventListener('pointerleave', () => { state.hover = state.pinned; draw(); });
    c.addEventListener('focus', () => { state.hover = k; draw(); });
    c.addEventListener('blur', () => { state.hover = state.pinned; draw(); });
    c.addEventListener('click', () => { state.pinned = state.pinned === k ? -1 : k; state.hover = state.pinned; draw(); });
  }

  function setup(a: string, b: string, view = 'both') {
    stop();
    state.pinned = -1;
    state.hover = -1;
    preA.select(a);
    Object.assign(A, parse(a)!);
    syncA();
    preB.select(b);
    Object.assign(B, parse(b)!);
    syncB();
    state.view = view;
    views.select(view);
  }
  tries({
    order: () => { setup('1,1,0,1', '0,-1,1,0'); el('run').click(); },
    commute: () => { setup('0,-1,1,0', 'r45'); el('run').click(); },
    inverse: () => { setup('1,1,0,1', 'inv'); el('run').click(); },
    det: () => { setup('1.5,0,0,0.75', '-1,0,0,1'); el('run').click(); },
  });

  refreshScale();
  draw();
</script>

