    border-radius: 3px;
    padding: 0 3px;
  }
  .prod-line :global(.ci) {
    color: #7c8cff;
  }
  .prod-line :global(.cj) {
    color: #5eead4;
  }
  .prod-line :global(b) {
    color: var(--text);
  }
  #mm {
    touch-action: manipulation;
  }
</style>
