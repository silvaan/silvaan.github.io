  }
  .pm-name {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .pm-out .pm-name {
    color: var(--text);
  }
  .pm-body {
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: 2px 4px;
    padding: 3px 6px;
    border-left: 2px solid var(--border-strong);
    border-right: 2px solid var(--border-strong);
    border-radius: 4px;
  }
  .pm-body span,
  .pm-body button {
    font-family: var(--font-mono);
    font-size: 0.86rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
    min-width: 5.2ch;
    padding: 2px 5px;
    border-radius: 4px;
    color: var(--text-muted);
    background: none;
    border: 1px solid transparent;
  }
  .pm-body button {
    cursor: pointer;
    color: var(--text);
    border-color: var(--border);
  }
  .pm-body button:hover,
  .pm-body button:focus-visible {
    outline: none;
  }
  .pm-body .ci {
    color: #7c8cff;
  }
  .pm-body .cj {
    color: #5eead4;
  }
  :global(:root[data-theme='light']) .pm-body .ci,
  :global(:root[data-theme='light']) .prod-line :global(.ci) {
    color: #4f5fe0;
  }
  :global(:root[data-theme='light']) .pm-body .cj,
  :global(:root[data-theme='light']) .prod-line :global(.cj) {
    color: #0d9488;
  }
  .pm-body .on {
    background: var(--accent-soft);
