---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Matrix from '../../../components/sim/Matrix.astro';
import Checks from '../../../components/sim/Checks.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';

const C = Math.SQRT1_2;
---

<SimLayout
  areaSlug="linear-algebra"
  title="Change of Basis"
  description="The same arrow, described in two different grids, gets two different pairs of numbers. The matrix of basis vectors is the dictionary between them, and the pairs it can produce are exactly the span of the basis."
  shortcuts={['animate', 'fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="cob"
          width="1000"
          height="600"
          role="img"
          aria-label="One fixed arrow v on a grid that bends between our square grid and the grid spanned by b1 and b2, with v's coordinates drawn as a walk along each grid's basis vectors and printed beside it in both rulers."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'b₁', color: '#7c8cff' },
          { label: 'b₂', color: '#5eead4' },
          { label: 'v', color: '#f59e0b', id: 'lg-v' },
          { label: 'a·b₁ + b·b₂', color: '#e879f9', id: 'lg-comb' },
          { label: 'the figure F', color: '#f59e0b', id: 'lg-f' },
          { label: 'A F, applied directly', color: '#f9736a', id: 'lg-af' },
        ]}
        hint="Drag the tips of b₁, b₂ and v"
      />
      <Result label="v in their coordinates, [v]<sub>B</sub>" />
    </div>

    <div class="sim-panel">
      <Seg
        id="view"
        label="View"
        attr="w"
        options={[
          { value: 'coords', label: 'Coordinates' },
          { value: 'span', label: 'Span' },
          { value: 'sandwich', label: 'A = PA′P⁻¹' },
        ]}
      />
      <div class="mode-group" id="g-coords">
        <Seg
          id="grid"
          label="Ruler"
          attr="g"
          active="theirs"
          options={[
            { value: 'ours', label: 'Our grid' },
            { value: 'theirs', label: 'Their grid' },
          ]}
        />
      </div>
      <div class="mode-group" id="g-sandwich" hidden>
        <Seg
          id="map"
          label="A′, the simple map in their grid"
          attr="t"
          options={[
            { value: 'stretch', label: 'Stretch b₁ ×2' },
            { value: 'flip', label: 'Flip b₂' },
            { value: 'shear', label: 'Shear' },
            { value: 'rot', label: 'Quarter turn' },
          ]}
        />
        <Slider id="stage" label="Step of P A′ P⁻¹" min={0} max={300} value={0} display="F" hint={['F', 'P⁻¹ · A′ · P']} />
        <Transport animate="Animate the three steps" reset={false} />
      </div>
      <Matrix label="Their first basis vector b<sub>1</sub>" entries={[{ id: 'b1x', label: 'x', value: 2 }, { id: 'b1y', label: 'y', value: 1 }]} />
      <Matrix label="Their second basis vector b<sub>2</sub>" entries={[{ id: 'b2x', label: 'x', value: -1 }, { id: 'b2y', label: 'y', value: 1 }]} />
      <div class="mode-group" id="g-v">
        <Matrix label="The vector v, in our coordinates" min={-5} max={5} entries={[{ id: 'vx', label: 'x', value: 5 }, { id: 'vy', label: 'y', value: 1 }]} />
      </div>
      <Seg
        id="presets"
        label="Presets for the basis"
        attr="b"
        options={[
          { value: '2,1,-1,1', label: 'Skewed' },
          { value: '1,0,0,1', label: 'Ours' },
          { value: `${C},${C},${-C},${C}`, label: 'Rotated' },
          { value: '2,0,0,0.5', label: 'Stretched' },
          { value: '1,1,2,2', label: 'Degenerate' },
        ]}
      />
      <div class="mode-group" id="g-span" hidden>
        <Slider id="ca" label="a, steps along b<sub>1</sub>" min={-5} max={5} step={0.05} value={1} display="1.00" />
        <Slider id="cb" label="b, steps along b<sub>2</sub>" min={-5} max={5} step={0.05} value={1} display="1.00" />
        <Checks items={[{ id: 'solve', label: 'Solve a, b so the walk lands on v' }]} />
      </div>
      <Readout
        title="Values"
        rows={[
          { id: 'r-det', label: 'det P' },
          { id: 'r-pinv', label: 'P⁻¹' },
          { id: 'r-ab', label: 'A′, their grid' },
          { id: 'r-ae', label: 'A = P A′ P⁻¹, our grid' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Switch to <b>their grid</b>: the grid bends onto b₁, b₂ but v never moves.
      The walk 5 along î, 1 along ĵ becomes 2 along b₁, −1 along b₂, and
      <b>P = [b₁ b₂]</b> turns (2, −1) back into (5, 1). <Try id="morph" label="Animate" />
    </li>
    <li>
      On <b>Stretched</b>, b₁ is twice as long as î, so v needs 2.5 of them
      instead of 5, while the half-length b₂ turns 1 into 2. A longer ruler
      gives a smaller number. <Try id="stretched" label="Animate" />
    </li>
    <li>
      In <b>Span</b> view, line b₁ and b₂ up: every walk stays on one line,
      det P = 0, and v, off that line, has <b>no coordinates</b> at all. <Try id="dependent" />
    </li>
    <li>
      Animate <b>A = P A′ P⁻¹</b>: translate into their grid (P⁻¹), stretch
      along b₁ (A′ is diagonal there), translate back (P). The F lands exactly
      on A F, four messy numbers in our grid. <Try id="sandwich" label="Animate" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { fixed } from '../../../lib/draw';
  import { el, segmented, slider, matrix, check, result, readout, tries } from '../../../lib/panel';

  // ---------------------------------------------------------------------------
  // Maths. P = [b₁ b₂] turns their numbers into ours (v = P[v]_B); P⁻¹ goes back.
  // ---------------------------------------------------------------------------
  type Vec = { x: number; y: number };
  type Mat = { a: number; b: number; c: number; d: number };
  type Box = { x0: number; y0: number; x1: number; y1: number };
  const I: Mat = { a: 1, b: 0, c: 0, d: 1 };
  const det = (m: Mat) => m.a * m.d - m.b * m.c;
  const mul = (p: Mat, q: Mat): Mat => ({ a: p.a * q.a + p.b * q.c, b: p.a * q.b + p.b * q.d, c: p.c * q.a + p.d * q.c, d: p.c * q.b + p.d * q.d });
  const app = (m: Mat, p: Vec): Vec => ({ x: m.a * p.x + m.b * p.y, y: m.c * p.x + m.d * p.y });
  const lerpM = (p: Mat, q: Mat, s: number): Mat => ({ a: p.a + (q.a - p.a) * s, b: p.b + (q.b - p.b) * s, c: p.c + (q.c - p.c) * s, d: p.d + (q.d - p.d) * s });
  const lerpV = (p: Vec, q: Vec, s: number): Vec => ({ x: p.x + (q.x - p.x) * s, y: p.y + (q.y - p.y) * s });
  const sc = (p: Vec, s: number): Vec => ({ x: p.x * s, y: p.y * s });
  const add = (p: Vec, q: Vec): Vec => ({ x: p.x + q.x, y: p.y + q.y });
  const cols = (u: Vec, w: Vec): Mat => ({ a: u.x, b: w.x, c: u.y, d: w.y });
  function inv(m: Mat): Mat | null {
    const D = det(m);
    if (Math.abs(D) < 1e-6) return null;
    return { a: m.d / D, b: -m.b / D, c: -m.c / D, d: m.a / D };
  }
  const ease = (p: number) => { const q = Math.max(0, Math.min(1, p)); return q * q * (3 - 2 * q); };
  const clamp = (x: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, x));
  /** Whole numbers print bare, everything else with two decimals and a real minus. */
  const nf = (x: number) => {
    if (!Number.isFinite(x)) return '—';
    const r = Math.round(x);
    return Math.abs(x - r) < 0.005 ? fixed(r, 0) : fixed(x, 2);
  };

  const B1 = { b1x: 2, b1y: 1 }, B2 = { b2x: -1, b2y: 1 }, V = { vx: 5, vy: 1 };
  const b1 = (): Vec => ({ x: B1.b1x, y: B1.b1y });
  const b2 = (): Vec => ({ x: B2.b2x, y: B2.b2y });
  const v = (): Vec => ({ x: V.vx, y: V.vy });
  const P = (): Mat => cols(b1(), b2());
  const EX: Vec = { x: 1, y: 0 }, EY: Vec = { x: 0, y: 1 }, O: Vec = { x: 0, y: 0 };

  type View = 'coords' | 'span' | 'sandwich';
  const S = { view: 'coords' as View, g: 1, map: 'stretch', t: 0, ca: 1, cb: 1, solve: false };
  const MAPS: Record<string, { m: Mat; name: string }> = {
    stretch: { m: { a: 2, b: 0, c: 0, d: 1 }, name: 'stretch b₁ ×2' },
    flip: { m: { a: 1, b: 0, c: 0, d: -1 }, name: 'flip b₂' },
    shear: { m: { a: 1, b: 1, c: 0, d: 1 }, name: 'shear: b₂ leans onto b₁' },
    rot: { m: { a: 0, b: -1, c: 1, d: 0 }, name: 'quarter turn' },
  };
  // the asymmetric figure that rides through A = P A′ P⁻¹, in our coordinates
  const FIG: Vec[] = [[0, 0], [0.34, 0], [0.34, 0.74], [0.95, 0.74], [0.95, 1.04], [0.34, 1.04], [0.34, 1.5], [1.25, 1.5], [1.25, 1.82], [0, 1.82]]
    .map(([x, y]) => ({ x: x + 0.45, y: y + 0.25 }));

  /** Where the drawing sits at step t of the story: T is the frame the grids are drawn in, Mf what the figure has been through. */
  function stage(t: number, Pi: Mat | null, Ap: Mat, A: Mat) {
    if (!Pi) return { T: I, Mf: I };
    if (t <= 1) { const T = lerpM(I, Pi, ease(t)); return { T, Mf: T }; }
    if (t <= 2) return { T: Pi, Mf: mul(lerpM(I, Ap, ease(t - 1)), Pi) };
    const T = lerpM(Pi, I, ease(t - 2));
    return { T, Mf: mul(T, A) };
  }

  // ---------------------------------------------------------------------------
  // Canvas, theme and layout (a side column when wide, a block underneath when narrow)
  // ---------------------------------------------------------------------------
  const canvas = el('cob') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const css = (n: string) => getComputedStyle(canvas).getPropertyValue(n).trim();
  let inkT = '232,233,236', invT = '13,14,18';
  const ink = (a: number) => `rgba(${inkT},${a})`;
  const inv2 = (a: number) => `rgba(${invT},${a})`;
  const T = makeText(ctx, ink);
  const label = T.label;
  const DARK = { B1: '#7c8cff', B2: '#5eead4', V: '#f59e0b', HOT: '#f9736a', COMB: '#e879f9' };
  const LIGHT = { B1: '#4f5bd5', B2: '#0d9488', V: '#d97706', HOT: '#dc2626', COMB: '#c026d3' };
  let K = DARK;
  const rgbOf = (hex: string) => { const n = parseInt(hex.slice(1), 16); return [(n >> 16) & 255, (n >> 8) & 255, n & 255]; };
  const hexA = (hex: string, a: number) => `rgba(${rgbOf(hex).join(',')},${a})`;
  /** Blend the stage ink into a colour: s = 0 is ink, s = 1 the colour. */
  const mix = (hex: string, s: number, a = 1) => {
    const p = inkT.split(',').map(Number), q = rgbOf(hex);
    return `rgba(${p.map((x, i) => Math.round(x + (q[i] - x) * s)).join(',')},${a})`;
  };
  function readTheme() {
    inkT = css('--stage-ink').replace(/\s/g, '') || '232,233,236';
    invT = css('--stage-ink-inv').replace(/\s/g, '') || '13,14,18';
    K = css('--stage-light') === '1' ? LIGHT : DARK;
  }

  type Lay = { narrow: boolean; W: number; H: number; pl: Box; sd: Box };
  const layout = (narrow: boolean): Lay =>
    narrow
      ? { narrow, W: 560, H: 850, pl: { x0: 0, y0: 0, x1: 560, y1: 500 }, sd: { x0: 18, y0: 500, x1: 542, y1: 850 } }
      : { narrow, W: 1000, H: 600, pl: { x0: 0, y0: 0, x1: 672, y1: 600 }, sd: { x0: 696, y0: 0, x1: 986, y1: 600 } };
  let L = layout(false);
  let lastDpr = 0;
  function resize(force = false) {
    const narrow = (canvas.parentElement?.clientWidth ?? 1000) < 620;
    const dpr = Math.min(3, window.devicePixelRatio || 1);
    if (!force && narrow === L.narrow && dpr === lastDpr) return;
    lastDpr = dpr;
    L = layout(narrow);
    canvas.width = Math.round(L.W * dpr);
    canvas.height = Math.round(L.H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    refit(true);
    draw();
  }

  // camera: world → plane pixels, eased toward a target that frames what matters
  const cam = { ox: 300, oy: 300, u: 60 }, tgt = { ox: 300, oy: 300, u: 60 };
  const scr = (p: Vec) => ({ x: cam.ox + p.x * cam.u, y: cam.oy - p.y * cam.u });
  const world = (x: number, y: number): Vec => ({ x: (x - cam.ox) / cam.u, y: (cam.oy - y) / cam.u });
  function fitTo(pts: Vec[], top: number, snap: boolean) {
    const pad = L.narrow ? 44 : 54, { pl } = L;
    let x0 = 0, x1 = 0, y0 = 0, y1 = 0;
    for (const p of pts) {
      if (!Number.isFinite(p.x) || !Number.isFinite(p.y) || Math.abs(p.x) > 40 || Math.abs(p.y) > 40) continue;
      x0 = Math.min(x0, p.x); x1 = Math.max(x1, p.x); y0 = Math.min(y0, p.y); y1 = Math.max(y1, p.y);
    }
    const w = Math.max(x1 - x0, 2.5), h = Math.max(y1 - y0, 2.5);
    const pw = pl.x1 - pl.x0 - 2 * pad, ph = pl.y1 - pl.y0 - 2 * pad - top;
    const u = clamp(Math.min(pw / w, ph / h), 24, L.narrow ? 105 : 120);
    tgt.u = u;
    tgt.ox = (pl.x0 + pl.x1) / 2 - ((x0 + x1) / 2) * u;
    tgt.oy = (pl.y0 + pl.y1 + top) / 2 + ((y0 + y1) / 2) * u;
    if (snap) Object.assign(cam, tgt);
    kick();
  }
  function refit(snap = false) {
    if (drag) return;
    const Pm = P(), Pi = inv(Pm);
    const pts: Vec[] = [b1(), b2(), EX, EY];
    if (S.view === 'coords') {
      pts.push(v(), { x: V.vx, y: 0 });
      if (Pi) { const c = app(Pi, v()); if (Math.abs(c.x) < 20) pts.push(sc(b1(), c.x)); }
    } else if (S.view === 'span') {
      pts.push(v(), sc(b1(), S.ca), add(sc(b1(), S.ca), sc(b2(), S.cb)));
      if (Pi && S.solve) { const c = app(Pi, v()); pts.push(sc(b1(), c.x)); }
    } else {
      const Ap = MAPS[S.map].m, A = Pi ? mul(mul(Pm, Ap), Pi) : I;
      for (const t of Pi ? [0, 0.5, 1, 1.5, 2, 2.5, 3] : [0]) {
        const st = stage(t, Pi, Ap, A);
        for (const p of FIG) pts.push(app(st.Mf, p), app(mul(st.T, A), p));
        pts.push(app(st.T, b1()), app(st.T, b2()), app(st.Mf, b1()), app(st.Mf, b2()));
      }
    }
    fitTo(pts, S.view === 'sandwich' ? 64 : 30, snap);
  }

  // ---------------------------------------------------------------------------
  // Animation: grid morph, the three-step story and the camera share one loop
  // ---------------------------------------------------------------------------
  let raf = 0, lastT = 0;
  let gAnim: { from: number; to: number; start: number; delay: number } | null = null;
  let tAnim: { start: number } | null = null;
  const kick = () => { if (!raf) raf = requestAnimationFrame(frame); };
  function frame(now: number) {
    raf = 0;
    const dt = lastT ? Math.min(60, now - lastT) : 16;
    lastT = now;
    let more = false;
    if (gAnim) {
      const p = (now - gAnim.start - gAnim.delay) / 1300;
      S.g = gAnim.from + (gAnim.to - gAnim.from) * ease(p);
      if (p >= 1) { S.g = gAnim.to; gAnim = null; } else more = true;
    }
    if (tAnim) {
      const p = (now - tAnim.start) / 5200;
      S.t = clamp(p, 0, 1) * 3;
      setStage(Math.round(S.t * 100));
      if (p >= 1) { S.t = 3; tAnim = null; } else more = true;
    }
    const k = 1 - Math.exp(-dt / 110);
    let moving = false;
    for (const key of ['ox', 'oy', 'u'] as const) {
      const d = tgt[key] - cam[key];
      if (Math.abs(d) > (key === 'u' ? 0.02 : 0.2)) { cam[key] += d * k; moving = true; } else cam[key] = tgt[key];
    }
    draw();
    if (more || moving) kick(); else lastT = 0;
  }
  function morphTo(to: number, delay = 0) {
    gAnim = { from: S.g, to, start: performance.now(), delay };
    gridSeg.select(to > 0.5 ? 'theirs' : 'ours');
    kick();
  }
  function play() {
    if (!inv(P())) { S.t = 0; setStage(0); draw(); return; }
    tAnim = { start: performance.now() };
    kick();
  }

  // ---------------------------------------------------------------------------
  // Drawing primitives. Every arrow and leg records its segment, every label its
  // box, so a label only goes where it covers neither.
  // ---------------------------------------------------------------------------
  let boxes: Box[] = [];
  let segs: number[][] = [];
  const FS = 1.42;
  function segHits(x1: number, y1: number, x2: number, y2: number, b: Box) {
    let t0 = 0, t1 = 1;
    const dx = x2 - x1, dy = y2 - y1;
    const p = [-dx, dx, -dy, dy], q = [x1 - b.x0, b.x1 - x1, y1 - b.y0, b.y1 - y1];
    for (let i = 0; i < 4; i++) {
      if (p[i] === 0) { if (q[i] < 0) return false; continue; }
      const r = q[i] / p[i];
      if (p[i] < 0) { if (r > t1) return false; if (r > t0) t0 = r; } else { if (r < t0) return false; if (r < t1) t1 = r; }
    }
    return true;
  }
  const overlaps = (a: Box, b: Box) => a.x0 < b.x1 && b.x0 < a.x1 && a.y0 < b.y1 && b.y0 < a.y1;
  function free(b: Box, area: Box) {
    if (b.x0 < area.x0 + 3 || b.x1 > area.x1 - 3 || b.y0 < area.y0 + 3 || b.y1 > area.y1 - 3) return false;
    if (boxes.some((o) => overlaps(o, b))) return false;
    return !segs.some((s) => segHits(s[0], s[1], s[2], s[3], b));
  }
  function rr(x: number, y: number, w: number, h: number, r: number) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.arcTo(x + w, y, x + w, y + h, r);
    ctx.arcTo(x + w, y + h, x, y + h, r);
    ctx.arcTo(x, y + h, x, y, r);
    ctx.arcTo(x, y, x + w, y, r);
    ctx.closePath();
  }
  /** A label next to a point, in the first free spot around it (preferred direction first), on a soft chip. */
  function tag(text: string, at: { x: number; y: number }, dir: number, colour: string, size = 12, gap = 9) {
    const w = T.textWidth(text, size), h = size * FS;
    const turns = [0, 0.45, -0.45, 0.9, -0.9, 1.35, -1.35, 1.8, -1.8, 2.4, -2.4, Math.PI];
    let pick: Box | null = null, cx = 0, cy = 0;
    outer: for (const r of [gap, gap + 12, gap + 28, gap + 48]) {
      for (const d of turns) {
        const th = dir + d;
        const x = at.x + Math.cos(th) * (r + w / 2), y = at.y + Math.sin(th) * (r + h / 2);
        const b = { x0: x - w / 2 - 4, y0: y - h / 2 - 2, x1: x + w / 2 + 4, y1: y + h / 2 + 2 };
        if (free(b, L.pl)) { pick = b; cx = x; cy = y; break outer; }
      }
    }
    if (!pick) return;
    boxes.push(pick);
    ctx.fillStyle = inv2(0.72);
    rr(pick.x0, pick.y0, pick.x1 - pick.x0, pick.y1 - pick.y0, 4);
    ctx.fill();
    label(text, cx, cy + h * 0.32, 1, 'center', size, colour);
  }
  /** Fixed text that reserves its box, for captions on the plane. */
  function note(text: string, x: number, y: number, colour: string, size = 11, align: CanvasTextAlign = 'left') {
    const w = T.textWidth(text, size), h = size * FS;
    const x0 = align === 'left' ? x : align === 'right' ? x - w : x - w / 2;
    boxes.push({ x0: x0 - 4, y0: y - h * 0.8, x1: x0 + w + 4, y1: y + h * 0.3 });
    label(text, x, y, 1, align, size, colour);
  }
  function arrow(from: Vec, to: Vec, colour: string, lw = 3, head = 13) {
    const a = scr(from), b = scr(to);
    const len = Math.hypot(b.x - a.x, b.y - a.y);
    if (len < 1.5) return;
    const ux = (b.x - a.x) / len, uy = (b.y - a.y) / len;
    const hd = Math.min(head, len * 0.6);
    ctx.strokeStyle = colour;
    ctx.fillStyle = colour;
    ctx.lineWidth = lw;
    ctx.lineCap = 'round';
    ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x - ux * hd * 0.7, b.y - uy * hd * 0.7); ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(b.x, b.y);
    ctx.lineTo(b.x - ux * hd - uy * hd * 0.42, b.y - uy * hd + ux * hd * 0.42);
    ctx.lineTo(b.x - ux * hd + uy * hd * 0.42, b.y - uy * hd - ux * hd * 0.42);
    ctx.closePath();
    ctx.fill();
    segs.push([a.x, a.y, b.x, b.y]);
  }
  /** One leg of a coordinate walk: a broad translucent band with dots at each whole step. */
  function leg(from: Vec, step: Vec, n: number, colour: (a: number) => string) {
    const to = add(from, sc(step, n));
    const a = scr(from), b = scr(to);
    ctx.lineCap = 'round';
    ctx.strokeStyle = colour(0.22);
    ctx.lineWidth = 9;
    ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
    ctx.strokeStyle = colour(0.95);
    ctx.lineWidth = 2;
    ctx.setLineDash([7, 5]);
    ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
    ctx.setLineDash([]);
    const stepPx = Math.hypot(step.x, step.y) * cam.u;
    if (stepPx > 9 && Math.abs(n) < 40) {
      ctx.fillStyle = colour(1);
      for (let k = 1; k <= Math.floor(Math.abs(n) + 1e-6); k++) {
        const p = scr(add(from, sc(step, Math.sign(n) * k)));
        ctx.beginPath(); ctx.arc(p.x, p.y, 3.4, 0, Math.PI * 2); ctx.fill();
      }
    }
    segs.push([a.x, a.y, b.x, b.y]);
    return to;
  }
  /** Grid lines k·e₁ + s·e₂ covering the plane; false when e₁, e₂ are parallel. */
  function lattice(e1: Vec, e2: Vec, stroke: string, axis: string, lw = 1) {
    const D = e1.x * e2.y - e1.y * e2.x;
    if (Math.abs(D) < 1e-3) return false;
    const { pl } = L;
    let s0 = Infinity, s1 = -Infinity, t0 = Infinity, t1 = -Infinity;
    for (const [x, y] of [[pl.x0, pl.y0], [pl.x1, pl.y0], [pl.x0, pl.y1], [pl.x1, pl.y1]]) {
      const p = world(x, y);
      const s = (p.x * e2.y - p.y * e2.x) / D, t = (e1.x * p.y - e1.y * p.x) / D;
      s0 = Math.min(s0, s); s1 = Math.max(s1, s); t0 = Math.min(t0, t); t1 = Math.max(t1, t);
    }
    if (s1 - s0 > 140 || t1 - t0 > 140) return true;
    const line = (k: number, along: 's' | 't') => {
      const a = along === 's' ? add(sc(e1, k), sc(e2, t0)) : add(sc(e1, s0), sc(e2, k));
      const b = along === 's' ? add(sc(e1, k), sc(e2, t1)) : add(sc(e1, s1), sc(e2, k));
      const p = scr(a), q = scr(b);
      ctx.moveTo(p.x, p.y); ctx.lineTo(q.x, q.y);
    };
    ctx.lineWidth = lw;
    ctx.strokeStyle = stroke;
    ctx.beginPath();
    for (let k = Math.ceil(s0); k <= Math.floor(s1); k++) if (k) line(k, 's');
    for (let k = Math.ceil(t0); k <= Math.floor(t1); k++) if (k) line(k, 't');
    ctx.stroke();
    ctx.strokeStyle = axis;
    ctx.lineWidth = lw * 1.4;
    ctx.beginPath();
    line(0, 's'); line(0, 't');
    ctx.stroke();
    return true;
  }
  function clipPlane() {
    const { pl } = L;
    ctx.save();
    ctx.beginPath();
    ctx.rect(pl.x0, pl.y0, pl.x1 - pl.x0, pl.y1 - pl.y0);
    ctx.clip();
  }
  const angle = (from: Vec, to: Vec) => { const a = scr(from), b = scr(to); return Math.atan2(b.y - a.y, b.x - a.x); };
  /** Label for the middle of a walk leg, pushed away from the triangle the walk makes with v. */
  function legTag(text: string, from: Vec, to: Vec, centroid: Vec, colour: string) {
    const a = scr(from), b = scr(to);
    if (Math.hypot(b.x - a.x, b.y - a.y) < 18) return;
    const m = { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 }, c = scr(centroid);
    let dir = Math.atan2(b.y - a.y, b.x - a.x) + Math.PI / 2;
    if (Math.cos(dir) * (m.x - c.x) + Math.sin(dir) * (m.y - c.y) < 0) dir += Math.PI;
    tag(text, m, dir, colour, 12, 8);
  }
  function ring(p: Vec, colour: string) {
    const s = scr(p);
    ctx.strokeStyle = colour;
    ctx.lineWidth = 1.6;
    ctx.beginPath(); ctx.arc(s.x, s.y, 8, 0, Math.PI * 2); ctx.stroke();
  }

  // side-panel pieces: runs of coloured text, a column vector and a 2×2 matrix in brackets
  function runs(parts: [string, string][], x: number, y: number, size: number) {
    let cx = x;
    for (const [t, col] of parts) { label(t, cx, y, 1, 'left', size, col); cx += T.textWidth(t, size); }
    return cx;
  }
  function brackets(x: number, y: number, w: number, h: number, col: string) {
    ctx.strokeStyle = col;
    ctx.lineWidth = 1.6;
    ctx.beginPath();
    ctx.moveTo(x + 7, y); ctx.lineTo(x, y); ctx.lineTo(x, y + h); ctx.lineTo(x + 7, y + h);
    ctx.moveTo(x + w - 7, y); ctx.lineTo(x + w, y); ctx.lineTo(x + w, y + h); ctx.lineTo(x + w - 7, y + h);
    ctx.stroke();
  }
  function vecBox(x: number, y: number, nums: string[], colours: string[], size: number) {
    const w = Math.max(...nums.map((n) => T.textWidth(n, size))) + 28;
    const row = size * FS * 1.18, h = row * 2 + 10;
    brackets(x, y, w, h, ink(0.45));
    nums.forEach((n, i) => label(n, x + w - 13, y + 6 + row * (i + 0.78), 1, 'right', size, colours[i]));
    return { w, h, row };
  }
  function matBox(x: number, y: number, m: Mat, colours: [string, string], size = 11.5) {
    const cells = [[m.a, m.b], [m.c, m.d]].map((r) => r.map(nf));
    const cw = [0, 1].map((j) => Math.max(T.textWidth(cells[0][j], size), T.textWidth(cells[1][j], size)));
    const row = size * FS * 1.25, gapc = 16, w = cw[0] + cw[1] + gapc + 24, h = row * 2 + 8;
    brackets(x, y, w, h, ink(0.4));
    for (let i = 0; i < 2; i++) {
      label(cells[i][0], x + 12 + cw[0], y + 4 + row * (i + 0.78), 1, 'right', size, colours[0]);
      label(cells[i][1], x + 12 + cw[0] + gapc + cw[1], y + 4 + row * (i + 0.78), 1, 'right', size, colours[1]);
    }
    return { w, h };
  }
  function wrap(text: string, maxW: number, size: number) {
    const out: string[] = [];
    let cur = '';
    for (const word of text.split(' ')) {
      const next = cur ? `${cur} ${word}` : word;
      if (cur && T.textWidth(next, size) > maxW) { out.push(cur); cur = word; } else cur = next;
    }
    if (cur) out.push(cur);
    return out;
  }
  function panelBg(x: number, y: number, w: number, h: number, on: boolean) {
    if (!on) return;
    ctx.fillStyle = ink(0.045);
    rr(x, y, w, h, 8);
    ctx.fill();
    ctx.strokeStyle = ink(0.12);
    ctx.lineWidth = 1;
    ctx.stroke();
  }
  function vArrow(x1: number, y1: number, x2: number, y2: number, col: string) {
    ctx.strokeStyle = col;
    ctx.fillStyle = col;
    ctx.lineWidth = 1.8;
    const a = Math.atan2(y2 - y1, x2 - x1);
    ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2 - 6 * Math.cos(a), y2 - 6 * Math.sin(a)); ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(x2, y2);
    ctx.lineTo(x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45));
    ctx.lineTo(x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45));
    ctx.closePath();
    ctx.fill();
  }

  // ---------------------------------------------------------------------------
  // View 1: one arrow, two rulers
  // ---------------------------------------------------------------------------
  function drawCoords() {
    const Pm = P(), Pi = inv(Pm), g = S.g, vv = v();
    const e1 = lerpV(EX, b1(), g), e2 = lerpV(EY, b2(), g);
    const Ei = inv(cols(e1, e2));
    let c = Ei ? app(Ei, vv) : null;
    if (c && (Math.abs(c.x) > 60 || Math.abs(c.y) > 60)) c = null;
    const c1 = (a: number) => mix(K.B1, g, a), c2 = (a: number) => mix(K.B2, g, a);

    clipPlane();
    if (g > 0.02) lattice(EX, EY, ink(0.05 * g), ink(0.1 * g));
    const ok = lattice(e1, e2, mix(K.B1, g, 0.13 + 0.09 * g), mix(K.B1, g, 0.3 + 0.1 * g));
    if (!ok) {
      const d = Math.hypot(b1().x, b1().y) > 1e-6 ? b1() : b2();
      const p = scr(sc(d, 40)), q = scr(sc(d, -40));
      ctx.strokeStyle = hexA(K.HOT, 0.28);
      ctx.lineWidth = 9;
      ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(q.x, q.y); ctx.stroke();
    }
    let corner: Vec | null = null;
    if (c) {
      corner = leg(O, e1, c.x, c1);
      leg(corner, e2, c.y, c2);
    }
    if (g < 0.995) {
      arrow(O, e1, c1(1 - 0.6 * g), 2.4, 11);
      arrow(O, e2, c2(1 - 0.6 * g), 2.4, 11);
    }
    const ba = 0.45 + 0.55 * g;
    arrow(O, b1(), hexA(K.B1, ba), 3.2);
    arrow(O, b2(), hexA(K.B2, ba), 3.2);
    arrow(O, vv, K.V, 4.2, 15);
    ring(vv, hexA(K.V, 0.6));
    ctx.restore();

    // labels, most important first
    const { pl } = L;
    const cap = g < 0.03 ? 'our grid: î and ĵ, square' : g > 0.97 ? (Pi ? 'their grid: spanned by b₁ and b₂' : 'their grid: collapsed onto a line') : 'the grid bends, v stays put';
    note(cap, pl.x0 + 16, pl.y0 + 26, ink(0.55), 11);
    if (!Pi && g > 0.5) {
      note('b₁ and b₂ lie on one line,', pl.x0 + 16, pl.y1 - 36, K.HOT, 11.5);
      note('so v has no coordinates here', pl.x0 + 16, pl.y1 - 16, ink(0.55), 11);
    }
    boxes.push(...[vv, b1(), b2()].map((p) => { const s = scr(p); return { x0: s.x - 8, y0: s.y - 8, x1: s.x + 8, y1: s.y + 8 }; }));
    tag('v', scr(vv), angle(O, vv), K.V, 14);
    tag('b_1', scr(b1()), angle(O, b1()), hexA(K.B1, ba), 12.5);
    tag('b_2', scr(b2()), angle(O, b2()), hexA(K.B2, ba), 12.5);
    if (g < 0.3) {
      tag('î', scr(e1), angle(O, e1), c1(1), 12.5);
      tag('ĵ', scr(e2), angle(O, e2), c2(1), 12.5);
    }
    if (c && corner && (g < 0.2 || g > 0.8)) {
      const mid: Vec = { x: (corner.x + vv.x) / 3, y: (corner.y + vv.y) / 3 };
      const ours = g < 0.5;
      legTag(`${nf(c.x)} ${ours ? 'î' : 'b_1'}`, O, corner, mid, c1(1));
      legTag(`${nf(c.y)} ${ours ? 'ĵ' : 'b_2'}`, corner, vv, mid, c2(1));
    }
    sideCoords(Pm, Pi);

    const vb = Pi ? app(Pi, vv) : null;
    const f = (p: Vec) => `(${nf(p.x)}, ${nf(p.y)})`;
    setEq({
      rule: [['\\mathbf v', K.V], '=', ['a\\,\\mathbf b_1', K.B1], '+', ['b\\,\\mathbf b_2', K.B2], '= P\\,', ['[\\mathbf v]_B', K.B1]],
      live: vb
        ? [[`(${nf(vv.x)},\\,${nf(vv.y)})`, K.V], '=', [`${nf(vb.x)}\\,\\mathbf b_1`, K.B1], vb.y < 0 ? '-' : '+', [`${nf(Math.abs(vb.y))}\\,\\mathbf b_2`, K.B2], `\\qquad \\det P = ${nf(det(Pm))}`]
        : [['\\det P = 0:\\ \\text{no coordinates in this basis}', K.HOT]],
    });
    el('result-label').innerHTML = 'v in their coordinates, [v]<sub>B</sub>';
    const ortho = Math.abs(Pm.a * Pm.a + Pm.c * Pm.c - 1) < 1e-3 && Math.abs(Pm.b * Pm.b + Pm.d * Pm.d - 1) < 1e-3 && Math.abs(Pm.a * Pm.b + Pm.c * Pm.d) < 1e-3;
    setResult({
      value: vb ? f(vb) : 'undefined',
      colour: vb ? K.B1 : K.HOT,
      status: vb ? `the same arrow reads ${f(vv)} in ours · det P = ${nf(det(Pm))}` : 'b₁ and b₂ are parallel, so P has no inverse',
      note: !vb
        ? 'Two vectors on one line cannot describe the whole plane: only points on that line get numbers, and even those get many.'
        : ortho
          ? 'An orthonormal basis: P⁻¹ is just Pᵀ, so lengths and angles read the same in both rulers.'
          : 'One arrow, two rulers, two pairs of numbers. P turns their pair into ours; P⁻¹ turns ours into theirs.',
    });
  }

  function sideCoords(Pm: Mat, Pi: Mat | null) {
    const { sd, narrow } = L;
    const vb = Pi ? app(Pi, v()) : null;
    const oursOn = S.g < 0.5;
    const x0 = sd.x0, y0 = sd.y0;
    const NUM = narrow ? 17 : 18;
    // a "name = [x; y]" block with the step each number counts
    const block = (bx: number, by: number, bw: number, on: boolean, title: string, name: [string, string][], nums: string[], cs: string[], along: string[] | null) => {
      panelBg(bx - 10, by - 4, bw + 20, 116, on);
      label(title, bx, by + 16, on ? 0.75 : 0.45, 'left', 10.5);
      const nx = runs(name, bx, by + 70, 15);
      const box = vecBox(nx + 10, by + 30, nums, cs, NUM);
      if (along) along.forEach((t, i) => label(t, nx + 10 + box.w + 12, by + 36 + box.row * (i + 0.78), 1, 'left', 10, ink(0.45)));
    };
    const oursNums = [nf(V.vx), nf(V.vy)], theirNums = vb ? [nf(vb.x), nf(vb.y)] : ['?', '?'];
    const theirCols = vb ? [K.B1, K.B2] : [K.HOT, K.HOT];
    if (!narrow) {
      label('one arrow v, two rulers', x0, 38, 0.5, 'left', 11);
      block(x0, 56, 270, oursOn, 'ours: x along î, y along ĵ', [['v', K.V], [' =', ink(0.8)]], oursNums, [ink(0.92), ink(0.92)], ['along î', 'along ĵ']);
      // P⁻¹ down from ours to theirs, P back up
      const xa = x0 + 64, xb = x0 + 104;
      vArrow(xa, 182, xa, 240, Pi ? ink(0.7) : hexA(K.HOT, 0.6));
      vArrow(xb, 240, xb, 182, ink(0.7));
      label('P⁻¹', xa - 12, 216, 1, 'right', 13, Pi ? ink(0.9) : K.HOT);
      label('P', xb + 12, 216, 1, 'left', 13, ink(0.9));
      label(Pi ? '↓ ours to theirs' : '↓ does not exist', x0 + 148, 204, 1, 'left', 9.5, Pi ? ink(0.5) : K.HOT);
      label('↑ theirs to ours', x0 + 148, 228, 0.5, 'left', 9.5);
      block(x0, 254, 270, !oursOn, 'theirs: a along b₁, b along b₂', [['[', ink(0.8)], ['v', K.V], [']_B =', ink(0.8)]], theirNums, theirCols, ['along b₁', 'along b₂']);
      sideMatrices(x0, 398, Pm, Pi, 150);
      runs([['theirs → ours: ', ink(0.45)], ['v', K.V], [' = P [v]_B', ink(0.75)]], x0, 538, 10);
      runs([['ours → theirs: ', ink(0.45)], ['[v]_B', ink(0.75)], [' = P⁻¹', ink(0.75)], [' v', K.V]], x0, 562, 10);
    } else {
      const tx = x0 + 300;
      block(x0, y0 + 14, 190, oursOn, 'ours: î, ĵ', [['v', K.V], [' =', ink(0.8)]], oursNums, [ink(0.92), ink(0.92)], null);
      block(tx, y0 + 14, 210, !oursOn, 'theirs: b₁, b₂', [['[', ink(0.8)], ['v', K.V], [']_B =', ink(0.8)]], theirNums, theirCols, null);
      const xa = x0 + 206, xb = tx - 18;
      vArrow(xa, y0 + 72, xb, y0 + 72, Pi ? ink(0.7) : hexA(K.HOT, 0.6));
      vArrow(xb, y0 + 100, xa, y0 + 100, ink(0.7));
      label('P⁻¹', (xa + xb) / 2, y0 + 62, 1, 'center', 12, Pi ? ink(0.9) : K.HOT);
      label('P', (xa + xb) / 2, y0 + 122, 1, 'center', 12, ink(0.9));
      sideMatrices(x0, y0 + 156, Pm, Pi, 180);
      runs([['theirs → ours: ', ink(0.45)], ['v', K.V], [' = P [v]_B', ink(0.75)]], x0, y0 + 286, 10);
      runs([['ours → theirs: ', ink(0.45)], ['[v]_B', ink(0.75)], [' = P⁻¹', ink(0.75)], [' v', K.V]], x0, y0 + 310, 10);
    }
  }
  function sideMatrices(x: number, y: number, Pm: Mat, Pi: Mat | null, gap: number) {
    runs([['P = [', ink(0.6)], ['b_1', K.B1], [' ', ink(0.6)], ['b_2', K.B2], [']', ink(0.6)]], x, y + 14, 11);
    matBox(x, y + 26, Pm, [K.B1, K.B2]);
    label('P⁻¹', x + gap, y + 14, 0.6, 'left', 11);
    if (Pi) matBox(x + gap, y + 26, Pi, [ink(0.85), ink(0.85)]);
    else label('none', x + gap, y + 56, 1, 'left', 12, K.HOT);
    const D = det(Pm);
    label(`det P = ${nf(D)}`, L.narrow ? x + 2 * gap - 10 : x, L.narrow ? y + 56 : y + 112, 1, 'left', 11, Math.abs(D) < 1e-6 ? K.HOT : ink(0.6));
  }

  // ---------------------------------------------------------------------------
  // View 2: everything a·b₁ + b·b₂ can reach
  // ---------------------------------------------------------------------------
  function drawSpan() {
    const Pm = P(), Pi = inv(Pm), D = det(Pm), vv = v();
    const zero = Math.hypot(b1().x, b1().y) < 1e-6 && Math.hypot(b2().x, b2().y) < 1e-6;
    const dir = Math.hypot(b1().x, b1().y) > 1e-6 ? b1() : b2();
    if (S.solve && Pi) {
      const vb = app(Pi, vv);
      S.ca = vb.x; S.cb = vb.y;
      setCa(clamp(vb.x, -5, 5)); setCb(clamp(vb.y, -5, 5));
      el('caval').textContent = vb.x.toFixed(2);
      el('cbval').textContent = vb.y.toFixed(2);
    }
    clipPlane();
    const { pl } = L;
    if (Pi) { ctx.fillStyle = hexA(K.B2, 0.05); ctx.fillRect(pl.x0, pl.y0, pl.x1 - pl.x0, pl.y1 - pl.y0); }
    lattice(EX, EY, ink(0.06), ink(0.14));
    if (Pi) lattice(b1(), b2(), hexA(K.B1, 0.2), hexA(K.B1, 0.36));
    else if (!zero) {
      const p = scr(sc(dir, 40)), q = scr(sc(dir, -40));
      ctx.strokeStyle = hexA(K.B2, 0.32);
      ctx.lineWidth = 12;
      ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(q.x, q.y); ctx.stroke();
    }
    const corner = leg(O, b1(), S.ca, (a) => hexA(K.B1, a));
    const comb = leg(corner, b2(), S.cb, (a) => hexA(K.B2, a));
    arrow(O, b1(), K.B1, 3.2);
    arrow(O, b2(), K.B2, 3.2);
    arrow(O, vv, K.V, 4.2, 15);
    ring(vv, hexA(K.V, 0.6));
    const pc = scr(comb);
    ctx.fillStyle = K.COMB;
    ctx.beginPath(); ctx.arc(pc.x, pc.y, 6.5, 0, Math.PI * 2); ctx.fill();
    ctx.restore();

    const off = zero ? Math.hypot(vv.x, vv.y) : Math.abs(dir.x * vv.y - dir.y * vv.x) / Math.hypot(dir.x, dir.y);
    const hit = Math.hypot(comb.x - vv.x, comb.y - vv.y) < 0.05;
    note(Pi ? 'tinted: the span, the whole plane' : zero ? 'the span is a single point' : 'the span is only this line', pl.x0 + 16, pl.y0 + 26, Pi ? ink(0.55) : K.HOT, 11);
    boxes.push(...[vv, b1(), b2(), comb].map((p) => { const s = scr(p); return { x0: s.x - 8, y0: s.y - 8, x1: s.x + 8, y1: s.y + 8 }; }));
    tag('v', scr(vv), angle(O, vv), K.V, 14);
    tag('b_1', scr(b1()), angle(O, b1()), K.B1, 12.5);
    tag('b_2', scr(b2()), angle(O, b2()), K.B2, 12.5);
    if (!hit) tag('a b_1 + b b_2', pc, angle(corner, comb), K.COMB, 11.5);

    // side: the two numbers you pick, and where they land
    const { sd, narrow } = L;
    const x0 = sd.x0, y0 = narrow ? sd.y0 - 14 : 0;
    label('the walk a·b₁ + b·b₂', x0, y0 + 38, 0.5, 'left', 11);
    runs([['a', K.B1], [' = ', ink(0.7)], [nf(S.ca), K.B1]], x0, y0 + 84, 17);
    runs([['b', K.B2], [' = ', ink(0.7)], [nf(S.cb), K.B2]], narrow ? x0 + 260 : x0, narrow ? y0 + 84 : y0 + 124, 17);
    const ry = narrow ? y0 + 128 : y0 + 172;
    runs([['lands on ', ink(0.5)], [`(${nf(comb.x)}, ${nf(comb.y)})`, K.COMB]], x0, ry, 13);
    runs([['v', K.V], [` = (${nf(vv.x)}, ${nf(vv.y)})`, ink(0.7)], [hit ? '  reached' : '', K.B2]], x0, ry + 28, 13);
    runs([['span: ', ink(0.5)], [Pi ? 'the whole plane' : zero ? 'one point' : 'one line', Pi ? K.B2 : K.HOT]], x0, ry + 72, 14);
    label(`det P = ${nf(D)}`, x0, ry + 100, 1, 'left', 11, Pi ? ink(0.6) : K.HOT);
    const msg = Pi
      ? hit ? 'The walk lands on v. These a, b are exactly [v]_B = P⁻¹v: finding coordinates is solving this equation.' : 'Two independent vectors reach every point, each with exactly one pair a, b. Turn on Solve to find the pair for v.'
      : off < 0.05 ? 'v sits on the line, so many pairs a, b reach it: its coordinates are not unique.' : 'v is off the line: no a, b reach it, so it has no coordinates in this "basis".';
    wrap(msg, sd.x1 - sd.x0, 10).forEach((ln, i) => label(ln, x0, ry + 136 + i * 19, 0.6, 'left', 10));

    el('result-label').innerHTML = 'The span of b<sub>1</sub>, b<sub>2</sub>';
    setEq({
      rule: [['\\mathbf v', K.V], '\\overset{?}{=}', ['a\\,\\mathbf b_1', K.B1], '+', ['b\\,\\mathbf b_2', K.B2], '\\qquad', ['(a,b) = [\\mathbf v]_B = P^{-1}\\mathbf v', K.COMB]],
      live: [[`${nf(S.ca)}\\,\\mathbf b_1 ${S.cb < 0 ? '-' : '+'} ${nf(Math.abs(S.cb))}\\,\\mathbf b_2 = (${nf(comb.x)},\\,${nf(comb.y)})`, K.COMB], `\\qquad \\det P = ${nf(D)}`],
    });
    setResult({
      value: Pi ? 'the whole plane' : zero ? 'a single point' : 'a line',
      colour: Pi ? K.B2 : K.HOT,
      status: `det P = ${nf(D)} · ${Pi ? (hit ? 'the walk lands on v' : 'v is reachable, with exactly one a, b') : off < 0.05 ? 'v is on the line' : 'v is out of reach'}`,
      note: Pi ? 'Independent b₁, b₂ span the plane, so every point has coordinates and they are unique.' : 'The two vectors lie on one line, so every combination stays on it.',
    });
  }

  // ---------------------------------------------------------------------------
  // View 3: A = P A′ P⁻¹ as a three-step story
  // ---------------------------------------------------------------------------
  function poly(pts: Vec[], fill: string | null, stroke: string, dash: number[] = [], lw = 2) {
    ctx.beginPath();
    pts.forEach((p, i) => { const s = scr(p); i ? ctx.lineTo(s.x, s.y) : ctx.moveTo(s.x, s.y); });
    ctx.closePath();
    if (fill) { ctx.fillStyle = fill; ctx.fill(); }
    ctx.setLineDash(dash);
    ctx.strokeStyle = stroke;
    ctx.lineWidth = lw;
    ctx.lineJoin = 'round';
    ctx.stroke();
    ctx.setLineDash([]);
  }
  const stepName = (t: number) => (t <= 0.001 ? 'F' : t >= 2.999 ? 'A F' : t <= 1 ? `P⁻¹ ${Math.round(t * 100)}%` : t <= 2 ? `A′ ${Math.round((t - 1) * 100)}%` : `P ${Math.round((t - 2) * 100)}%`);
  function drawSandwich() {
    const Pm = P(), Pi = inv(Pm), Ap = MAPS[S.map].m;
    const A = Pi ? mul(mul(Pm, Ap), Pi) : I;
    const t = Pi ? S.t : 0;
    const { T: Tm, Mf } = stage(t, Pi, Ap, A);
    const { pl } = L;

    clipPlane();
    lattice(app(Tm, EX), app(Tm, EY), ink(0.06), ink(0.16));
    if (Pi) lattice(app(Tm, b1()), app(Tm, b2()), hexA(K.B1, 0.2), hexA(K.B1, 0.36));
    const ghost = FIG.map((p) => app(mul(Tm, A), p));
    const figure = FIG.map((p) => app(Mf, p));
    if (Pi) poly(ghost, null, hexA(K.HOT, 0.85), [6, 5], 1.8);
    poly(figure, hexA(K.V, 0.22), K.V, [], 2.2);
    for (let i = 0; i < figure.length; i++) {
      const a = scr(figure[i]), b = scr(figure[(i + 1) % figure.length]);
      segs.push([a.x, a.y, b.x, b.y]);
    }
    const mb1 = app(Mf, b1()), mb2 = app(Mf, b2());
    arrow(O, mb1, K.B1, 3.2);
    arrow(O, mb2, K.B2, 3.2);
    // after the story, b₁ and b₂ themselves stay as faint handles beside A b₁, A b₂
    if (Pi && t >= 2.999) {
      arrow(O, b1(), hexA(K.B1, 0.4), 1.6, 10);
      arrow(O, b2(), hexA(K.B2, 0.4), 1.6, 10);
      ring(b1(), hexA(K.B1, 0.7)); ring(b2(), hexA(K.B2, 0.7));
    }
    ctx.restore();

    // the step strip, like a progress bar: F → P⁻¹ → A′ → P
    const names = ['F', 'P⁻¹', 'A′', 'P'];
    const sx0 = pl.x0 + 26, gap = L.narrow ? 62 : 74;
    for (let k = 0; k < 4; k++) {
      const x = sx0 + k * gap, on = t >= k - 0.01;
      ctx.fillStyle = on ? K.V : ink(0.2);
      ctx.beginPath(); ctx.arc(x, 22, 4.5, 0, Math.PI * 2); ctx.fill();
      label(names[k], x, 44, on ? 0.9 : 0.35, 'center', 11.5);
      if (k < 3) {
        ctx.strokeStyle = ink(0.15);
        ctx.lineWidth = 2;
        ctx.beginPath(); ctx.moveTo(x + 8, 22); ctx.lineTo(x + gap - 8, 22); ctx.stroke();
        const f = clamp(t - k, 0, 1);
        if (f > 0) { ctx.strokeStyle = K.V; ctx.beginPath(); ctx.moveTo(x + 8, 22); ctx.lineTo(x + 8 + (gap - 16) * f, 22); ctx.stroke(); }
      }
    }
    boxes.push({ x0: pl.x0 + 10, y0: 8, x1: sx0 + 3 * gap + 20, y1: 50 });
    const cap = !Pi
      ? 'P⁻¹ does not exist: there is no "their grid" to translate into'
      : t <= 0.001 ? 'F in our grid; dashed: A F, applying A directly'
        : t <= 1 ? 'P⁻¹: redraw everything in their coordinates'
          : t <= 2 ? `A′ in their grid: ${MAPS[S.map].name}`
            : t < 2.999 ? 'P: translate back into our coordinates' : 'P A′ P⁻¹ F lands exactly on A F';
    note(cap, pl.x0 + 16, 74, !Pi ? K.HOT : t >= 2.999 ? K.HOT : ink(0.6), 11);

    const late = t > 1.02;
    const top = (pts: Vec[]) => pts.reduce((m, p) => (scr(p).y < scr(m).y ? p : m));
    tag(late ? 'A b_1' : 'b_1', scr(mb1), angle(O, mb1), K.B1, 12.5);
    tag(late ? 'A b_2' : 'b_2', scr(mb2), angle(O, mb2), K.B2, 12.5);
    if (Pi && t < 2.999) tag('A F', scr(top(ghost)), -Math.PI / 2, K.HOT, 12);
    tag(t >= 2.999 ? 'F = A F' : 'F', scr(top(figure)), -Math.PI / 2 - 0.6, K.V, 12);

    sideSandwich(Pm, Pi, Ap, A, t);

    el('result-label').innerHTML = 'A in our grid, A = P A′ P<sup>−1</sup>';
    setEq({
      rule: [['A', K.HOT], '=', ['P', K.B1], ["\\,A'\\,", K.V], ['P^{-1}', K.B2]],
      live: Pi
        ? [[`A = \\begin{bmatrix} ${nf(A.a)} & ${nf(A.b)} \\\\ ${nf(A.c)} & ${nf(A.d)} \\end{bmatrix}`, K.HOT], `\\qquad A' = \\begin{bmatrix} ${nf(Ap.a)} & ${nf(Ap.b)} \\\\ ${nf(Ap.c)} & ${nf(Ap.d)} \\end{bmatrix}`]
        : [['\\det P = 0:\\ P^{-1}\\ \\text{does not exist}', K.HOT]],
    });
    setResult({
      value: Pi ? `[${nf(A.a)} ${nf(A.b)}; ${nf(A.c)} ${nf(A.d)}]` : 'undefined',
      colour: Pi ? K.HOT : K.HOT,
      status: Pi ? `A′ = [${nf(Ap.a)} ${nf(Ap.b)}; ${nf(Ap.c)} ${nf(Ap.d)}] in their grid: ${MAPS[S.map].name}` : 'b₁ and b₂ are parallel',
      note: Pi
        ? 'Read the sandwich right to left: translate into their numbers, do the simple thing, translate back. The result is A applied directly.'
        : 'Without an inverse there is no way into their coordinates, so the sandwich cannot be built.',
    });
  }

  function sideSandwich(Pm: Mat, Pi: Mat | null, Ap: Mat, A: Mat, t: number) {
    const { sd, narrow } = L;
    const x0 = sd.x0;
    const steps: { n: string; name: string; desc: string; m: Mat | null; cs: [string, string] }[] = [
      { n: '1', name: 'P⁻¹', desc: 'into their coordinates', m: Pi, cs: [ink(0.85), ink(0.85)] },
      { n: '2', name: 'A′', desc: MAPS[S.map].name, m: Ap, cs: [K.V, K.V] },
      { n: '3', name: 'P', desc: 'back into ours', m: Pm, cs: [K.B1, K.B2] },
    ];
    const active = t <= 0.001 || t >= 2.999 ? -1 : Math.min(2, Math.floor(t));
    const drawStep = (k: number, x: number, y: number, w: number, mx: number, my: number) => {
      const s = steps[k];
      panelBg(x - 8, y - 4, w + 16, narrow ? 156 : 92, active === k);
      const on = active === k || active < 0;
      ctx.fillStyle = on ? K.V : ink(0.25);
      ctx.beginPath(); ctx.arc(x + 9, y + 20, 9, 0, Math.PI * 2); ctx.fill();
      label(s.n, x + 9, y + 25, 1, 'center', 10, inv2(1));
      label(s.name, x + 26, y + 26, on ? 0.95 : 0.5, 'left', 14);
      wrap(s.desc, narrow ? w - 4 : 128, 9.5).forEach((ln, i) => label(ln, x + (narrow ? 0 : 26), y + 50 + i * 16, on ? 0.6 : 0.4, 'left', 9.5));
      if (s.m) matBox(mx, my, s.m, s.cs, 11);
      else label('none', mx, my + 30, 1, 'left', 12, K.HOT);
    };
    if (!narrow) {
      label('A = P A′ P⁻¹, right to left', x0, 38, 0.5, 'left', 11);
      for (let k = 0; k < 3; k++) { const y = 56 + k * 104; drawStep(k, x0, y, 270, x0 + 158, y + 10); }
      const y = 386;
      runs([['A', K.HOT], [', applied directly in our grid', ink(0.5)]], x0, y, 10.5);
      if (Pi) matBox(x0, y + 14, A, [K.HOT, K.HOT], 13);
      wrap(!Pi ? 'Cannot be built: without P⁻¹ there is no way into their grid.' : t >= 2.999 ? 'Same four numbers, same picture: the F sits exactly on A F.' : 'Four messy numbers here, against a simple A′ in their grid.', 270, 10)
        .forEach((ln, i) => label(ln, x0, y + 110 + i * 19, t >= 2.999 && Pi ? 0.85 : 0.55, 'left', 10));
    } else {
      const y0 = sd.y0 + 14, w = 160;
      for (let k = 0; k < 3; k++) { const x = x0 + k * 182; drawStep(k, x, y0, w, x, y0 + 86); }
      const y = y0 + 196;
      runs([['A', K.HOT], [', directly in our grid', ink(0.5)]], x0, y, 10.5);
      if (Pi) matBox(x0, y + 14, A, [K.HOT, K.HOT], 13);
      wrap(!Pi ? 'Cannot be built without P⁻¹.' : t >= 2.999 ? 'Same picture: the F sits exactly on A F.' : 'Four messy numbers, against a simple A′.', 300, 10)
        .forEach((ln, i) => label(ln, x0 + 190, y + 40 + i * 19, t >= 2.999 && Pi ? 0.85 : 0.55, 'left', 10));
    }
  }

  // ---------------------------------------------------------------------------
  function draw() {
    readTheme();
    ctx.clearRect(0, 0, L.W, L.H);
    boxes = [];
    segs = [];
    // the line between the scene and its numbers
    ctx.strokeStyle = ink(0.08);
    ctx.lineWidth = 1;
    ctx.beginPath();
    if (L.narrow) { ctx.moveTo(14, L.pl.y1 + 0.5); ctx.lineTo(L.W - 14, L.pl.y1 + 0.5); } else { ctx.moveTo(L.pl.x1 + 0.5, 20); ctx.lineTo(L.pl.x1 + 0.5, L.H - 20); }
    ctx.stroke();
    if (S.view === 'coords') drawCoords();
    else if (S.view === 'span') drawSpan();
    else drawSandwich();
    const Pm = P(), Pi = inv(Pm), Ap = MAPS[S.map].m;
    const fm = (m: Mat) => `[${nf(m.a)} ${nf(m.b)}; ${nf(m.c)} ${nf(m.d)}]`;
    setRows({ 'r-det': nf(det(Pm)), 'r-pinv': Pi ? fm(Pi) : 'none', 'r-ab': fm(Ap), 'r-ae': Pi ? fm(mul(mul(Pm, Ap), Pi)) : '—' });
  }

  // ---------------------------------------------------------------------------
  // Controls
  // ---------------------------------------------------------------------------
  const setEq = equation();
  const setResult = result();
  const setRows = readout();
  const changed = () => { presets.clear(); refit(); draw(); };
  const syncB1 = matrix(B1, ['b1x', 'b1y'], changed);
  const syncB2 = matrix(B2, ['b2x', 'b2y'], changed);
  const syncV = matrix(V, ['vx', 'vy'], () => { refit(); draw(); });
  // the sliders snap to their step, so print the exact entries (the Rotated preset is 1/√2)
  const syncAll = () => {
    syncB1(); syncB2(); syncV();
    for (const [k, val] of Object.entries({ ...B1, ...B2, ...V })) el(k + 'val').textContent = val.toFixed(2);
  };
  function setBasis(b: string) {
    const [x1, y1, x2, y2] = b.split(',').map(Number);
    Object.assign(B1, { b1x: x1, b1y: y1 });
    Object.assign(B2, { b2x: x2, b2y: y2 });
    syncAll();
  }
  const presets = segmented('presets', (b) => { setBasis(b); refit(); if (S.view === 'sandwich') play(); draw(); });
  const gridSeg = segmented('grid', (g) => morphTo(g === 'theirs' ? 1 : 0));
  const mapSeg = segmented('map', (m) => { S.map = m; refit(); play(); });
  const setStage = slider('stage', (x) => { tAnim = null; S.t = x / 100; draw(); }, (x) => stepName(x / 100));
  const setSolve = check('solve', (on) => { S.solve = on; refit(); draw(); });
  const unsolve = () => { if (S.solve) { S.solve = false; setSolve(false); } };
  const setCa = slider('ca', (x) => { unsolve(); S.ca = x; draw(); }, (x) => x.toFixed(2));
  const setCb = slider('cb', (x) => { unsolve(); S.cb = x; draw(); }, (x) => x.toFixed(2));

  function setView(w: View) {
    S.view = w;
    viewSeg.select(w);
    el('g-coords').hidden = w !== 'coords';
    el('g-span').hidden = w !== 'span';
    el('g-sandwich').hidden = w !== 'sandwich';
    el('g-v').hidden = w === 'sandwich';
    el('lg-v').hidden = w === 'sandwich';
    el('lg-comb').hidden = w !== 'span';
    el('lg-f').hidden = w !== 'sandwich';
    el('lg-af').hidden = w !== 'sandwich';
    el('scene-hint').textContent = w === 'sandwich' ? 'Drag the tips of b₁ and b₂ before or after the three steps' : 'Drag the tips of b₁, b₂ and v';
    tAnim = null;
    if (w === 'sandwich') { S.t = 0; setStage(0); }
    refit();
    draw();
  }
  const viewSeg = segmented('view', (w) => { setView(w as View); if (w === 'sandwich') play(); });
  el('run').addEventListener('click', () => {
    if (S.view === 'sandwich') play();
    else if (S.view === 'coords') morphTo(S.g > 0.5 ? 0 : 1);
  });

  function reset(view: View, basis: string) {
    if (gAnim) { S.g = gAnim.to; gAnim = null; }
    tAnim = null;
    setView(view);
    presets.select(basis);
    setBasis(basis);
    Object.assign(V, { vx: 5, vy: 1 });
    syncAll();
  }
  tries({
    morph: () => { reset('coords', '2,1,-1,1'); S.g = 0; refit(); draw(); morphTo(1, 700); },
    stretched: () => { reset('coords', '2,0,0,0.5'); S.g = 0; refit(); draw(); morphTo(1, 700); },
    dependent: () => {
      reset('span', '1,1,2,2');
      S.solve = false; setSolve(false);
      S.ca = 1; S.cb = 1; setCa(1); setCb(1);
      refit(); draw();
    },
    sandwich: () => { reset('sandwich', '2,1,-1,1'); S.map = 'stretch'; mapSeg.select('stretch'); refit(); play(); },
  });

  // ---------------------------------------------------------------------------
  // Dragging the tips
  // ---------------------------------------------------------------------------
  type Handle = 'b1' | 'b2' | 'v';
  let drag: Handle | null = null;
  const local = (e: PointerEvent) => {
    const r = canvas.getBoundingClientRect();
    return { x: ((e.clientX - r.left) / r.width) * L.W, y: ((e.clientY - r.top) / r.height) * L.H };
  };
  const tip = (h: Handle) => (h === 'b1' ? b1() : h === 'b2' ? b2() : v());
  function hitTest(p: { x: number; y: number }): Handle | null {
    const { pl } = L;
    if (p.x < pl.x0 || p.x > pl.x1 || p.y < pl.y0 || p.y > pl.y1) return null;
    let list: Handle[] = ['v', 'b1', 'b2'];
    if (S.view === 'sandwich') {
      const rest = S.t <= 0.001 || S.t >= 2.999 || !inv(P());
      if (!rest) return null;
      list = ['b1', 'b2'];
    }
    const R = L.narrow ? 26 : 18;
    let best: Handle | null = null, bd = R;
    for (const h of list) {
      const s = scr(tip(h));
      const d = Math.hypot(p.x - s.x, p.y - s.y);
      if (d < bd) { bd = d; best = h; }
    }
    return best;
  }
  canvas.addEventListener('pointerdown', (e) => {
    drag = hitTest(local(e));
    if (drag) { canvas.setPointerCapture(e.pointerId); e.preventDefault(); }
  });
  canvas.addEventListener('pointermove', (e) => {
    const l = local(e);
    if (!drag) { canvas.style.cursor = hitTest(l) ? 'grab' : 'default'; return; }
    const w = world(l.x, l.y);
    const snap = (n: number) => (Math.abs(n - Math.round(n)) < 0.08 ? Math.round(n) : Math.round(n * 20) / 20);
    const lim = drag === 'v' ? 5 : 3;
    const x = clamp(snap(w.x), -lim, lim), y = clamp(snap(w.y), -lim, lim);
    if (drag === 'b1') Object.assign(B1, { b1x: x, b1y: y });
    else if (drag === 'b2') Object.assign(B2, { b2x: x, b2y: y });
    else Object.assign(V, { vx: x, vy: y });
    if (drag !== 'v') presets.clear();
    syncAll();
    draw();
  });
  const stop = () => { if (drag) { drag = null; refit(); } };
  canvas.addEventListener('pointerup', stop);
  canvas.addEventListener('pointercancel', stop);

  new ResizeObserver(() => resize()).observe(canvas.parentElement!);
  document.addEventListener('fullscreenchange', () => resize(true));
  window.addEventListener('themechange', () => draw());
  resize(true);
</script>

<style>
  #cob {
    touch-action: none;
  }
  .mode-group {
    display: contents;
  }
  .mode-group[hidden] {
    display: none;
  }
</style>
