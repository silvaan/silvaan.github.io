  .check input {
    accent-color: var(--accent);
    width: 15px;
    height: 15px;
  }
  .sim-panel .mgrid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 16px;
  }
  .sim-panel .mgrid label {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
    margin-bottom: 3px;
  }
  .sim-panel .mgrid label b {
    color: var(--text);
    font-weight: 500;
  }
  .sim-panel .mgrid input[type='range'] {
    width: 100%;
    accent-color: var(--accent);
  }
</style>
