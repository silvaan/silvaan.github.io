---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Matrix from '../../../components/sim/Matrix.astro';
import Checks from '../../../components/sim/Checks.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';
import { COLOR } from '../../../lib/vector-scene';
import '../../../styles/vector-lab.css';

const PLANES = [
  { component: 'x', plane: 'yz' },
  { component: 'y', plane: 'zx' },
  { component: 'z', plane: 'xy' },
];
---

<SimLayout
  areaSlug="linear-algebra"
  title="Cross Product"
  description="Two vectors span a patch of plane. The cross product is that patch's area, pointed the way the patch faces. Each component is the area of the patch's shadow on one wall."
  shortcuts={['reset', 'fullscreen']}
>
  <div class="sim vector-lab" id="wrap">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="cp"
          width="1000"
          height="600"
          role="img"
          aria-label="Two vectors, the parallelogram they span, its perpendicular a × b, and the parallelogram's shadows on the three coordinate walls."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'a', color: COLOR.a },
          { label: 'b', color: COLOR.b },
          { label: 'a × b', color: COLOR.result },
        ]}
        hint="Drag to orbit · shift-drag to pan · scroll to zoom · set the vectors with the sliders"
      />
      <Result label="Cross product" />
      <section class="component-cards" aria-label="One component per coordinate plane">
        <div class="component-heading">
          <h2>Three shadows, three components</h2>
          <p>
            Each card looks straight at one wall. The signed area of the patch's shadow there is
            one component of a × b. Hover a card to light up its wall in the scene.
          </p>
        </div>
        {
          PLANES.map(({ component, plane }, i) => (
            <article class="component-card" data-plane={i} tabindex="0" style={`--plane-color:${COLOR.axis[i]}`}>
              <h3>
                <span>{plane} plane</span>
                <b id={`component-value-${i}`}>—</b>
              </h3>
              <svg id={`component-plane-${i}`} viewBox="0 0 240 236" role="img" aria-label={`The patch seen down the ${component} axis`}></svg>
              <code id={`component-formula-${i}`}>—</code>
              <p id={`component-orientation-${i}`}>—</p>
            </article>
          ))
        }
      </section>
    </div>

    <div class="sim-panel">
      <Seg
        id="preset"
        label="Scenario"
        attr="p"
        options={[
          { value: 'tilted', label: 'Tilted' },
          { value: 'flat', label: 'Flat on the floor' },
          { value: 'perp', label: 'Right angles' },
          { value: 'parallel', label: 'Nearly parallel' },
        ]}
      />
      <Matrix
        label={`<span style="color:${COLOR.a}">Vector a</span>`}
        min={-3}
        max={3}
        step={0.1}
        entries={[{ id: 'ax', label: 'x', value: 1.5 }, { id: 'ay', label: 'y', value: 1.3 }, { id: 'az', label: 'z', value: 0 }]}
      />
      <Matrix
        label={`<span style="color:${COLOR.b}">Vector b</span>`}
        min={-3}
        max={3}
        step={0.1}
        entries={[{ id: 'bx', label: 'x', value: 0.4 }, { id: 'by', label: 'y', value: -0.5 }, { id: 'bz', label: 'z', value: 1.5 }]}
      />
      <Checks
        items={[
          { id: 'shadows', label: 'Show the shadows on the walls', checked: true },
          { id: 'spin', label: 'Spin the scene' },
        ]}
      />
      <Transport run={false}>
        <button type="button" class="btn ghost" id="swap">Swap a and b</button>
      </Transport>
      <Readout
        title="Values & calculations"
        rows={[
          { id: 'r-area', label: '|a × b|, the patch\'s area' },
          { id: 'r-sine', label: '|a| |b| sin θ' },
          { id: 'r-angle', label: 'angle between' },
          { id: 'r-perp-a', label: 'a · (a × b)' },
          { id: 'r-perp-b', label: 'b · (a × b)' },
        ]}
      >
        <table class="mult-table">
          <caption>
            The unit vectors multiply in the cycle x → y → z → x. Going with the cycle gives +,
            against it −, and anything with itself spans no area. Rows are a, columns are b.
          </caption>
          <thead>
            <tr><th>×</th><th class="ax-x">x̂</th><th class="ax-y">ŷ</th><th class="ax-z">ẑ</th></tr>
          </thead>
          <tbody>
            <tr><th class="ax-x">x̂</th><td class="zero">0</td><td class="ax-z">+ẑ</td><td class="ax-y">−ŷ</td></tr>
            <tr><th class="ax-y">ŷ</th><td class="ax-z">−ẑ</td><td class="zero">0</td><td class="ax-x">+x̂</td></tr>
            <tr><th class="ax-z">ẑ</th><td class="ax-y">+ŷ</td><td class="ax-x">−x̂</td><td class="zero">0</td></tr>
          </tbody>
        </table>
      </Readout>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Bring the arrows into line: the patch between them collapses and the whole
      vector a × b goes to zero. <b>An area wearing a direction</b> has nothing
      left to point. <Try id="parallel" />
    </li>
    <li>
      Each component is the <b>signed area of the patch's shadow</b> on one wall.
      The cards show each shadow head-on next to a<sub>p</sub>b<sub>q</sub> −
      a<sub>q</sub>b<sub>p</sub>, and the two always agree. <Try id="walls" />
    </li>
    <li>
      Lay the patch <b>flat on the floor</b>: the yz and zx shadows are just
      lines, so only the z component survives and a × b points straight up. <Try id="floor" />
    </li>
    <li>
      Press <b>Swap</b>: every shadow is traced the other way round, so every
      component flips sign while the area stays put. <Try id="swap" label="Swap" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { subHtml, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { check, result, readout, tries } from '../../../lib/panel';
  import {
    type Vector3 as Vec,
    O, add, mul, dot, len, cross, angleBetween, componentPlanes,
  } from '../../../lib/vector-geometry';
  import {
    COLOR, rgba, LIMIT, createScene, segmented, vectorSliders, el, degrees,
  } from '../../../lib/vector-scene';

  // ---------------------------------------------------------------------------
  // a × b. The three components come from the formula, and the three shadow
  // areas are measured off the parallelogram on screen. They agree, and that
  // agreement is the reason the formula looks the way it does.
  // ---------------------------------------------------------------------------

  // Angled so the patch reads as a patch and the answer still shows its
  // length: looking straight down the normal would flatten the arrow to a dot.
  const HOME_VIEW = { yaw: 1.3, pitch: -0.5 };
  const PRESETS: Record<string, [Vec, Vec]> = {
    tilted: [{ x: 1.5, y: 1.3, z: 0 }, { x: 0.4, y: -0.5, z: 1.5 }],
    flat: [{ x: 1.8, y: 0.2, z: 0 }, { x: 0.4, y: 1.7, z: 0 }],
    perp: [{ x: 1.9, y: 0, z: 0 }, { x: 0, y: 1.7, z: 0 }],
    parallel: [{ x: 1.6, y: 1.0, z: 0.5 }, { x: 1.7, y: 1.1, z: 0.5 }],
  };

  const state = {
    a: { ...PRESETS.tilted[0] },
    b: { ...PRESETS.tilted[1] },
    shadows: true,
    spin: false,
    focus: -1, // the wall whose card is under the pointer, or none
  };
  const cam = { ...HOME_VIEW, zoom: 1, pan: { x: 0, y: 0 } };

  const canvas = el('cp') as HTMLCanvasElement;
  const W = canvas.width, H = canvas.height;
  // the camera's origin and scale are refitted every frame so that all three
  // arrows, the patch and its shadows stay on the stage from any angle
  let fitS = 150, fitO = { x: W / 2, y: H * 0.53 }, fitted = false;
  const scene = createScene(canvas, cam, {
    origin: () => fitO,
    scale: () => fitS,
    redraw: () => draw(),
  });
  const { label, textWidth } = makeText(scene.ctx, scene.inkA);
  const P = (v: Vec) => scene.project(v);
  const seg = (p: Vec, q: Vec) => { const u = P(p), v = P(q); blockLine(u.x, u.y, v.x, v.y); };
  // --- labels: measured boxes, each one nudged to the nearest free spot --------
  type Box = { x0: number; y0: number; x1: number; y1: number };
  const taken: Box[] = [];
  const segs: number[][] = [];
  const fills: { x: number; y: number }[][] = [];
  const layoutReset = () => { taken.length = 0; segs.length = 0; fills.length = 0; };
  const blockLine = (x1: number, y1: number, x2: number, y2: number) => { segs.push([x1, y1, x2, y2]); };
  const blockPoly = (pts: { x: number; y: number }[]) =>
    pts.forEach((p, i) => { const q = pts[(i + 1) % pts.length]; blockLine(p.x, p.y, q.x, q.y); });
  /** A filled shape: no label may cross its outline or sit inside it. */
  const blockFill = (pts: { x: number; y: number }[]) => { blockPoly(pts); fills.push(pts); };
  const inside = (x: number, y: number, pts: { x: number; y: number }[]) => {
    let hit = false;
    for (let i = 0, j = pts.length - 1; i < pts.length; j = i++)
      if ((pts[i].y > y) !== (pts[j].y > y) && x < ((pts[j].x - pts[i].x) * (y - pts[i].y)) / (pts[j].y - pts[i].y) + pts[i].x) hit = !hit;
    return hit;
  };
  const blockDot = (x: number, y: number, r: number) => { taken.push({ x0: x - r, y0: y - r, x1: x + r, y1: y + r }); };
  /** Does the segment cross the box? (Liang–Barsky clipping.) */
  function crosses(s: number[], b: Box) {
    const [x1, y1, x2, y2] = s;
    const dx = x2 - x1, dy = y2 - y1;
    const p = [-dx, dx, -dy, dy], q = [x1 - b.x0, b.x1 - x1, y1 - b.y0, b.y1 - y1];
    let t0 = 0, t1 = 1;
    for (let i = 0; i < 4; i++) {
      if (p[i] === 0) { if (q[i] < 0) return false; continue; }
      const r = q[i] / p[i];
      if (p[i] < 0) { if (r > t1) return false; if (r > t0) t0 = r; }
      else { if (r < t0) return false; if (r < t1) t1 = r; }
    }
    return true;
  }
  const overlap = (a: Box, b: Box) =>
    Math.max(0, Math.min(a.x1, b.x1) - Math.max(a.x0, b.x0)) * Math.max(0, Math.min(a.y1, b.y1) - Math.max(a.y0, b.y0));
  /**
   * Draw `text` next to the point (ax, ay): on it if `onSpot`, otherwise just
   * beyond it in the direction `prefer` (radians, screen axes), swinging round
   * and stepping out until the box crosses no line and no other label. With
   * `onlyIfFree`, only the spot itself and small nudges of it are tried, and
   * nothing is drawn (false is returned) when none of them is clean.
   */
  function place(text: string, size: number, colour: string, ax: number, ay: number, prefer = -Math.PI / 4, onSpot = false, gap = 7, onlyIfFree = false) {
    const w = textWidth(text, size) + 6, h = size * 1.42 + 4;
    const cands: [number, number][] = onSpot || onlyIfFree ? [[ax, ay]] : [];
    if (onlyIfFree) for (const dy of [0, -6, 6, -12, 12]) for (const dx of [0, -8, 8, -16, 16]) cands.push([ax + dx, ay + dy]);
    else for (const step of [0, 1, 2, 3, 5, 7, 10, 14, 19]) {
      for (let k = 0; k < 12; k++) {
        const an = prefer + (k % 2 ? 1 : -1) * Math.ceil(k / 2) * (Math.PI / 6);
        const c = Math.cos(an), s = Math.sin(an);
        const edge = Math.min(Math.abs(c) > 1e-6 ? w / 2 / Math.abs(c) : 1e9, Math.abs(s) > 1e-6 ? h / 2 / Math.abs(s) : 1e9);
        const d = gap + step * 9 + edge;
        cands.push([ax + c * d, ay + s * d]);
      }
    }
    let best = cands[0], bestCost = Infinity;
    cands.forEach(([cx, cy], i) => {
      const b = { x0: cx - w / 2, y0: cy - h / 2, x1: cx + w / 2, y1: cy + h / 2 };
      let cost = i * 0.6;
      if (b.x0 < 2 || b.y0 < 2 || b.x1 > W - 2 || b.y1 > H - 2) cost += 1e5;
      for (const s of segs) if (crosses(s, b)) cost += 1000;
      for (const t of taken) cost += overlap(b, t) * 30;
      for (const f of fills) if (inside(cx, cy, f)) cost += 1000;
      if (cost < bestCost) { bestCost = cost; best = [cx, cy]; }
    });
    if (onlyIfFree && bestCost >= 1000) return false;
    const [cx, cy] = best;
    taken.push({ x0: cx - w / 2, y0: cy - h / 2, x1: cx + w / 2, y1: cy + h / 2 });
    label(text, cx, cy + size * 1.42 * 0.34, 1, 'center', size, colour);
    return true;
  }

  /** The direction from the origin to a point on screen. */
  const away = (v: Vec) => { const o = P(O), p = P(v); return Math.hypot(p.x - o.x, p.y - o.y) > 4 ? Math.atan2(p.y - o.y, p.x - o.x) : -Math.PI / 4; };

  // --- the picture -----------------------------------------------------------

  /** Where the patch's corner lands on one wall. */
  const onWall = (plane: number, v: Vec): Vec =>
    plane === 0 ? { x: -LIMIT, y: v.y, z: v.z }
    : plane === 1 ? { x: v.x, y: -LIMIT, z: v.z }
    : { x: v.x, y: v.y, z: -LIMIT };

  /** A small arrowhead partway along an edge, showing which way it is traced. */
  function headOn(p: Vec, q: Vec, col: string, size = 7) {
    const { ctx } = scene;
    const u = scene.project(p), v = scene.project(q);
    const mx = (u.x + v.x) / 2, my = (u.y + v.y) / 2;
    const an = Math.atan2(v.y - u.y, v.x - u.x);
    ctx.fillStyle = col;
    ctx.beginPath();
    ctx.moveTo(mx + (size * Math.cos(an)) / 2, my + (size * Math.sin(an)) / 2);
    ctx.lineTo(mx - size * Math.cos(an - 0.5), my - size * Math.sin(an - 0.5));
    ctx.lineTo(mx - size * Math.cos(an + 0.5), my - size * Math.sin(an + 0.5));
    ctx.closePath();
    ctx.fill();
  }

  /**
   * The patch's shadow on one wall, in the colour of the component it stands
   * for. The sign is not a colour but a direction: the two arrowheads show
   * which way round the loop is traced. When a card is hovered, its wall is
   * lit and the other two fade.
   */
  function drawShadow(plane: number) {
    const { a, b } = state;
    const col = COLOR.axis[plane];
    const lit = state.focus < 0 ? 1 : state.focus === plane ? 2 : 0.3;
    const corner = (v: Vec) => onWall(plane, v);
    scene.poly(
      [corner(O), corner(a), corner(add(a, b)), corner(b)],
      rgba(col, 0.11 * lit),
      rgba(col, Math.min(0.9, 0.5 * lit)),
      state.focus === plane ? 2 : 1.2
    );
    blockPoly([corner(O), corner(a), corner(add(a, b)), corner(b)].map(P));
    if (lit >= 1) {
      headOn(corner(O), corner(a), col);
      headOn(corner(add(a, b)), corner(b), col);
    }
    return lit >= 1;
  }

  /** Every point that has to stay on the stage. */
  function keyPoints(): Vec[] {
    const { a, b } = state;
    const c = cross(a, b);
    const R = LIMIT;
    const pts: Vec[] = [O, a, b, add(a, b), c, mul(c, 1.08), { x: 0, y: 0, z: -R }, { x: 0, y: 0, z: R + 0.25 }, { x: R + 0.25, y: 0, z: 0 }, { x: 0, y: R + 0.25, z: 0 }];
    for (const x of [-R, R]) for (const y of [-R, R]) pts.push({ x, y, z: 0 });
    if (state.shadows) for (let w = 0; w < 3; w++) for (const v of [a, b, add(a, b)]) pts.push(onWall(w, v));
    return pts;
  }
  /**
   * Choose the scale and origin (before the reader's own zoom and pan) that fit
   * every key point inside the stage. While spinning, fit the whole turn at
   * once so the picture does not breathe.
   */
  function fitView() {
    fitS = 1;
    fitO = { x: 0, y: 0 };
    const yaw = cam.yaw;
    const yaws = state.spin ? Array.from({ length: 12 }, (_, k) => yaw + (k * Math.PI) / 6) : [yaw];
    const pts = keyPoints();
    let x0 = Infinity, x1 = -Infinity, y0 = Infinity, y1 = -Infinity;
    for (const y of yaws) {
      cam.yaw = y;
      for (const p of pts) {
        const q = scene.project(p);
        const x = (q.x - cam.pan.x) / cam.zoom, yy = (q.y - cam.pan.y) / cam.zoom;
        x0 = Math.min(x0, x); x1 = Math.max(x1, x); y0 = Math.min(y0, yy); y1 = Math.max(y1, yy);
      }
    }
    cam.yaw = yaw;
    const S = Math.min(190, (W - 110) / Math.max(1e-6, x1 - x0), (H - 70) / Math.max(1e-6, y1 - y0));
    const o = { x: W / 2 - ((x0 + x1) / 2) * S, y: H / 2 - ((y0 + y1) / 2) * S };
    return { S, o };
  }
  let target = { S: 150, o: { x: W / 2, y: H * 0.53 } };
  let shown = { S: 150, o: { x: W / 2, y: H * 0.53 } };
  /** Ease the camera towards the fit, so preset changes glide instead of jump. */
  function refit() {
    target = fitView();
    const k = fitted ? 0.18 : 1;
    fitted = true;
    shown = {
      S: shown.S + (target.S - shown.S) * k,
      o: { x: shown.o.x + (target.o.x - shown.o.x) * k, y: shown.o.y + (target.o.y - shown.o.y) * k },
    };
    fitS = shown.S;
    fitO = shown.o;
  }

  function draw() {
    const { ctx, inkA } = scene;
    refit();
    ctx.clearRect(0, 0, W, H);
    layoutReset();
    scene.grid(true, COLOR.axis);
    // the axis names the grid writes
    for (const e of [{ x: LIMIT + 0.25, y: 0, z: 0 }, { x: 0, y: LIMIT + 0.25, z: 0 }, { x: 0, y: 0, z: LIMIT + 0.25 }]) { const q = P(e); blockDot(q.x, q.y - 4, 9); }

    const { a, b } = state;
    const c = cross(a, b);
    const tags: { plane: number; area: number }[] = [];
    if (state.shadows) {
      const planes = componentPlanes(a, b);
      // far walls first, so nothing is drawn over the patch itself
      const order = [0, 1, 2].sort((i, j) => scene.project(onWall(j, O)).d - scene.project(onWall(i, O)).d);
      for (const p of order) if (drawShadow(p)) tags.push({ plane: p, area: planes[p].area });
    }

    // the patch itself, kept neutral so the coloured things stay the vectors
    scene.poly([O, a, add(a, b), b], inkA(0.1), inkA(0.35));
    scene.line(a, add(a, b), inkA(0.25), 1.2, [4, 4]);
    scene.line(b, add(a, b), inkA(0.25), 1.2, [4, 4]);
    blockPoly([O, a, add(a, b), b].map(P));

    scene.arrow(O, a, COLOR.a);
    scene.arrow(O, b, COLOR.b);
    const hasC = len(c) > 1e-6;
    if (hasC) scene.arrow(O, c, COLOR.result, 3.6, 18);
    for (const v of hasC ? [a, b, c] : [a, b]) { seg(O, v); const t = P(v); blockDot(t.x, t.y, 9); }

    // each shadow's signed area: inside the shadow when it fits, else beside it
    for (const { plane, area } of tags) {
      const text = `${area >= 0 ? '+' : '−'}${Math.abs(area).toFixed(2)}`;
      const m = P(onWall(plane, mul(add(a, b), 0.5)));
      const o = P(onWall(plane, O));
      const col = COLOR.axis[plane];
      place(text, 12, col, m.x, m.y, 0, true, 4, true) ||
        place(text, 12, col, m.x, m.y, Math.atan2(m.y - o.y, m.x - o.x) + Math.PI / 2, false, 8);
    }
    // then nothing else may sit inside a shadow
    if (state.shadows) for (let w = 0; w < 3; w++) fills.push([O, a, add(a, b), b].map((v) => P(onWall(w, v))));
    // the vectors' names, each in the first free spot past its tip
    if (hasC) { const t = P(c); place('a × b', 14, COLOR.result, t.x, t.y, away(c), false, 6); }
    for (const [v, name, col] of [[a, 'a', COLOR.a], [b, 'b', COLOR.b]] as [Vec, string, string][]) {
      const t = P(v);
      place(name, 14, col, t.x, t.y, away(v), false, 6);
    }
  }

  // --- the cards: each shadow head-on, next to its arithmetic ----------------

  const num = (n: number) => (n < 0 ? `(${n.toFixed(1)})` : n.toFixed(1));

  function drawCards() {
    const planes = componentPlanes(state.a, state.b);
    // one scale for all three cards, so their areas can be compared by eye
    const extent = Math.max(3, ...planes.flatMap((p) => [p.a[0], p.a[1], p.b[0], p.b[1], p.a[0] + p.b[0], p.a[1] + p.b[1]].map(Math.abs)));
    const S = 100 / extent, CX = 120, CY = 120;
    planes.forEach((plane, i) => {
      const col = COLOR.axis[i];
      const sx = (v: number) => CX + v * S;
      const sy = (v: number) => CY - v * S;
      const point = (v: number[]) => `${sx(v[0])},${sy(v[1])}`;
      const corner = [plane.a[0] + plane.b[0], plane.a[1] + plane.b[1]];
      const arrow = (v: number[], color: string, name: string) =>
        `<line x1="${CX}" y1="${CY}" x2="${sx(v[0])}" y2="${sy(v[1])}" stroke="${color}" stroke-width="2.5" marker-end="url(#arrow-${i}-${name})" />`;
      const R = Math.ceil(extent);
      const gridLines = [];
      for (let v = -R; v <= R; v++)
        gridLines.push(`<path d="M${sx(v)} ${sy(R)} V${sy(-R)} M${sx(-R)} ${sy(v)} H${sx(R)}" fill="none" stroke="currentColor" opacity="${v === 0 ? 0.35 : 0.07}" />`);
      el(`component-plane-${i}`).innerHTML = `
        <defs>${[[COLOR.a, 'a'], [COLOR.b, 'b']].map(([color, name]) => `<marker id="arrow-${i}-${name}" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0 L10 5 L0 10 Z" fill="${color}" /></marker>`).join('')}</defs>
        ${gridLines.join('')}
        <polygon points="${[[0, 0], plane.a, corner, plane.b].map(point).join(' ')}" fill="${col}" fill-opacity="${plane.area === 0 ? 0 : 0.25}" stroke="${col}" stroke-width="1.5" />
        ${arrow(plane.a, COLOR.a, 'a')}${arrow(plane.b, COLOR.b, 'b')}
        <text x="${sx(R) + 6}" y="${CY + 4}" fill="currentColor" font-size="13">${plane.axes[0]}</text>
        <text x="${CX + 6}" y="${sy(R) + 4}" fill="currentColor" font-size="13">${plane.axes[1]}</text>`;

      const [p, q] = plane.axes;
      el(`component-value-${i}`).textContent = `${plane.component} = ${plane.area > 0 ? '+' : ''}${plane.area.toFixed(2)}`;
      el(`component-formula-${i}`).innerHTML = subHtml(
        `a_${p} b_${q} − a_${q} b_${p}<br>= ${num(plane.a[0])}·${num(plane.b[1])} − ${num(plane.a[1])}·${num(plane.b[0])} = ${plane.area.toFixed(2)}`
      );
      el(`component-orientation-${i}`).textContent =
        Math.abs(plane.area) < 1e-10
          ? 'The shadow collapses to a line: zero area.'
          : `Traced ${plane.area > 0 ? 'counterclockwise (+)' : 'clockwise (−)'} from a to b.`;
    });
  }

  // --- the words and numbers, rebuilt only when the vectors change -----------

  const setEq = equation();
  const setResult = result();
  const setRows = readout();
  let lastKey = '';

  function updateReadout() {
    const key = JSON.stringify([state.a, state.b]);
    if (key === lastKey) return;
    lastKey = key;
    drawCards();

    const { a, b } = state;
    const c = cross(a, b);
    const area = len(c);
    const th = angleBetween(a, b);
    const sine = len(a) * len(b) * Math.sin(((th ?? 0) * Math.PI) / 180);
    const zero = th === null;

    setResult({
      value: `(${c.x.toFixed(2)}, ${c.y.toFixed(2)}, ${c.z.toFixed(2)})`,
      colour: COLOR.result,
      status: zero
        ? 'Zero vector'
        : area < 1e-9 ? 'Parallel, so zero area' : `Area ${area.toFixed(2)} · angle ${degrees(th)}`,
      note: zero
        ? 'A zero vector spans no patch, and the angle is undefined.'
        : area < 1e-9
          ? 'Parallel vectors span no patch, so the cross product vanishes.'
          : 'Its length is the area of the patch spanned by a and b, and it points perpendicular to both. Swap a and b to flip it.',
    });
    setRows({
      'r-area': area.toFixed(3),
      'r-sine': sine.toFixed(3),
      'r-angle': degrees(th),
      'r-perp-a': dot(a, c).toFixed(6),
      'r-perp-b': dot(b, c).toFixed(6),
    });

    const A = `\\textcolor{${COLOR.a}}{\\mathbf a}`, B = `\\textcolor{${COLOR.b}}{\\mathbf b}`;
    setEq({
      rule: [`${A}\\times${B}`, '=', ['(a_yb_z-a_zb_y,\\;a_zb_x-a_xb_z,\\;a_xb_y-a_yb_x)', COLOR.result]],
      live: [
        [`|${A}\\times${B}| = ${area.toFixed(3)}`, COLOR.result],
        `\\quad = |\\mathbf a||\\mathbf b|\\sin\\theta = ${sine.toFixed(3)}`,
      ],
    });
  }

  // --- loop ------------------------------------------------------------------

  let last = performance.now();
  function frame(now: number) {
    const dt = Math.min(0.05, Math.max(0, (now - last) / 1000));
    last = now;
    if (state.spin) cam.yaw += dt * 0.28;
    draw();
    updateReadout();
    requestAnimationFrame(frame);
  }

  // --- controls --------------------------------------------------------------

  const presets = segmented('preset', (name) => applyPreset(name));
  const sync = vectorSliders(state, () => presets.clear());

  function applyPreset(name: string) {
    const [a, b] = PRESETS[name] ?? PRESETS.tilted;
    state.a = { ...a };
    state.b = { ...b };
    sync();
  }

  el('swap').addEventListener('click', () => {
    [state.a, state.b] = [state.b, state.a];
    presets.clear();
    sync();
  });

  const setShadows = check('shadows', (on) => (state.shadows = on));
  const setSpin = check('spin', (on) => (state.spin = on));

  function show(name: string) {
    presets.select(name);
    applyPreset(name);
    state.shadows = true;
    setShadows(true);
  }
  el('reset').addEventListener('click', () => {
    show('tilted');
    Object.assign(cam, HOME_VIEW, { zoom: 1, pan: { x: 0, y: 0 } });
    state.spin = false;
    setSpin(false);
  });
  tries({
    parallel: () => show('parallel'),
    walls: () => show('tilted'),
    floor: () => show('flat'),
    swap: () => { show('tilted'); el('swap').click(); },
  });

  // hovering or focusing a card lights up its wall in the scene
  document.querySelectorAll<HTMLElement>('.component-card').forEach((card) => {
    const plane = +card.dataset.plane!;
    const on = () => {
      state.focus = plane;
      card.classList.add('active');
    };
    const off = () => {
      if (state.focus === plane) state.focus = -1;
      card.classList.remove('active');
    };
    card.addEventListener('pointerenter', on);
    card.addEventListener('pointerleave', off);
    card.addEventListener('focus', on);
    card.addEventListener('blur', off);
  });

  scene.pointer({ flat: () => false });

  requestAnimationFrame(frame);
</script>
