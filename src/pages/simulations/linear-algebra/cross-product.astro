---
import SimLayout from '../../../layouts/SimLayout.astro';
import { COLOR } from '../../../lib/vector-scene';
import '../../../styles/vector-lab.css';

const PLANES = [
  { component: 'x', plane: 'yz' },
  { component: 'y', plane: 'zx' },
  { component: 'z', plane: 'xy' },
];
---

<SimLayout
  areaSlug="linear-algebra"
  title="Cross Product"
  description="Two vectors span a patch of plane. The cross product is that patch's area, pointed the way the patch faces. Each component is the area of the patch's shadow on one wall."
  shortcuts={['reset', 'fullscreen']}
  standard
>
  <div class="sim vector-lab" id="wrap">
    <div class="vector-view">
      <div class="sim-stage">
        <canvas
          id="cp"
          width="1000"
          height="600"
          role="img"
          aria-label="Two vectors, the parallelogram they span, its perpendicular a × b, and the parallelogram's shadows on the three coordinate walls."
        ></canvas>
      </div>

      <div class="scene-caption">
        <div class="legend">
          <span class="vector-a">a</span>
          <span class="vector-b">b</span>
          <span class="vector-result">a × b</span>
        </div>
        <p id="scene-hint">Drag to orbit · shift-drag to pan · scroll to zoom · set the vectors with the sliders</p>
      </div>

      <div class="result-strip">
        <div>
          <span class="section-label">Cross product</span>
          <strong id="result-value">—</strong>
        </div>
        <div>
          <b id="result-status">—</b>
          <p id="result-explanation">—</p>
        </div>
      </div>

      <section class="component-cards" aria-label="One component per coordinate plane">
        <div class="component-heading">
          <h2>Three shadows, three components</h2>
          <p>
            Each card looks straight at one wall. The signed area of the patch's shadow there is
            one component of a × b. Hover a card to light up its wall in the scene.
          </p>
        </div>
        {
          PLANES.map(({ component, plane }, i) => (
            <article class="component-card" data-plane={i} tabindex="0" style={`--plane-color:${COLOR.axis[i]}`}>
              <h3>
                <span>{plane} plane</span>
                <b id={`component-value-${i}`}>—</b>
              </h3>
              <svg id={`component-plane-${i}`} viewBox="0 0 240 236" role="img" aria-label={`The patch seen down the ${component} axis`}></svg>
              <code id={`component-formula-${i}`}>—</code>
              <p id={`component-orientation-${i}`}>—</p>
            </article>
          ))
        }
      </section>
    </div>

    <div class="sim-panel">
      <div class="control">
        <label class="section-label">Scenario</label>
        <div class="seg" id="preset">
          <button data-p="tilted" class="active">Tilted</button>
          <button data-p="flat">Flat on the floor</button>
          <button data-p="perp">Right angles</button>
          <button data-p="parallel">Nearly parallel</button>
        </div>
      </div>

      <div class="control vector-control vector-a">
        <label>Vector a</label>
        <div class="vec">
          <div><span>x <b id="axval">1.5</b></span><input aria-label="Vector a, x component" type="range" id="ax" min="-30" max="30" step="1" value="15" /></div>
          <div><span>y <b id="ayval">1.3</b></span><input aria-label="Vector a, y component" type="range" id="ay" min="-30" max="30" step="1" value="13" /></div>
          <div><span>z <b id="azval">0.0</b></span><input aria-label="Vector a, z component" type="range" id="az" min="-30" max="30" step="1" value="0" /></div>
        </div>
      </div>

      <div class="control vector-control vector-b">
        <label>Vector b</label>
        <div class="vec">
          <div><span>x <b id="bxval">0.4</b></span><input aria-label="Vector b, x component" type="range" id="bx" min="-30" max="30" step="1" value="4" /></div>
          <div><span>y <b id="byval">-0.5</b></span><input aria-label="Vector b, y component" type="range" id="by" min="-30" max="30" step="1" value="-5" /></div>
          <div><span>z <b id="bzval">1.5</b></span><input aria-label="Vector b, z component" type="range" id="bz" min="-30" max="30" step="1" value="15" /></div>
        </div>
      </div>

      <button class="btn ghost" id="swap">Swap a and b</button>

      <label class="check"><input type="checkbox" id="shadows" checked /> Show the shadows on the walls</label>
      <label class="check"><input type="checkbox" id="spin" /> Spin the scene</label>

      <button class="btn ghost" id="reset">Reset</button>

      <details class="numeric-details">
        <summary>Values &amp; calculations</summary>
        <div class="readout">
          <div class="row"><span>|a × b|, the patch's area</span><b id="r-area">—</b></div>
          <div class="row"><span>|a| |b| sin θ</span><b id="r-sine">—</b></div>
          <div class="row"><span>angle between</span><b id="r-angle">—</b></div>
          <div class="row"><span>a · (a × b)</span><b id="r-perp-a">—</b></div>
          <div class="row"><span>b · (a × b)</span><b id="r-perp-b">—</b></div>
        </div>
        <table class="mult-table">
          <caption>
            The unit vectors multiply in the cycle x → y → z → x. Going with the cycle gives +,
            against it −, and anything with itself spans no area. Rows are a, columns are b.
          </caption>
          <thead>
            <tr><th>×</th><th class="ax-x">x̂</th><th class="ax-y">ŷ</th><th class="ax-z">ẑ</th></tr>
          </thead>
          <tbody>
            <tr><th class="ax-x">x̂</th><td class="zero">0</td><td class="ax-z">+ẑ</td><td class="ax-y">−ŷ</td></tr>
            <tr><th class="ax-y">ŷ</th><td class="ax-z">−ẑ</td><td class="zero">0</td><td class="ax-x">+x̂</td></tr>
            <tr><th class="ax-z">ẑ</th><td class="ax-y">+ŷ</td><td class="ax-x">−x̂</td><td class="zero">0</td></tr>
          </tbody>
        </table>
      </details>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Slide a and b apart and watch the patch between them open up. The answer
      grows with that patch and with nothing else: <b>a cross product is an area
      wearing a direction</b>, and the direction is just which way the patch
      faces.
    </li>
    <li>
      Bring the two arrows into line. The patch collapses, the area goes to zero
      and so does the whole vector. Parallel vectors span nothing, which is the
      mirror image of perpendicular vectors having no shadow.
    </li>
    <li>
      Now for the formula. The patch throws a shadow on each of the three walls,
      and the <b>signed area of each shadow is exactly one component</b> of
      a × b. The three cards under the scene show each shadow head-on, next to
      the arithmetic, and the two always agree.
    </li>
    <li>
      That is where a<sub>x</sub>b<sub>y</sub> − a<sub>y</sub>b<sub>x</sub>
      comes from: it is the area of a parallelogram in the plane, base times
      height, written in coordinates. Every component is that same two
      dimensional formula, applied to a different pair of axes.
    </li>
    <li>
      Look at the middle card: the pair is taken as z then x, not x then z. The
      three planes are visited in the cycle x → y → z → x, and the sign of every
      term is just which way round that cycle you went.
    </li>
    <li>
      Press swap. Every component changes sign and the vector flips over, because
      the shadow you were measuring is now traced the other way round. The area
      never changed, only the sense of the loop around it.
    </li>
    <li>
      Check the two bottom readouts: a · (a × b) and b · (a × b) are zero, always,
      to the last digit. The answer is perpendicular to both, which is forced,
      because a patch's facing direction cannot lie inside the patch.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { subHtml } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import {
    type Vector3 as Vec,
    O, add, mul, dot, len, cross, angleBetween, componentPlanes,
  } from '../../../lib/vector-geometry';
  import {
    COLOR, rgba, LIMIT, createScene, segmented, vectorSliders, el, degrees,
  } from '../../../lib/vector-scene';

  // ---------------------------------------------------------------------------
  // a × b. The three components come from the formula, and the three shadow
  // areas are measured off the parallelogram on screen. They agree, and that
  // agreement is the reason the formula looks the way it does.
  // ---------------------------------------------------------------------------

  // Angled so the patch reads as a patch and the answer still shows its
  // length: looking straight down the normal would flatten the arrow to a dot.
  const HOME_VIEW = { yaw: 1.3, pitch: -0.5 };
  const PRESETS: Record<string, [Vec, Vec]> = {
    tilted: [{ x: 1.5, y: 1.3, z: 0 }, { x: 0.4, y: -0.5, z: 1.5 }],
    flat: [{ x: 1.8, y: 0.2, z: 0 }, { x: 0.4, y: 1.7, z: 0 }],
    perp: [{ x: 1.9, y: 0, z: 0 }, { x: 0, y: 1.7, z: 0 }],
    parallel: [{ x: 1.6, y: 1.0, z: 0.5 }, { x: 1.7, y: 1.1, z: 0.5 }],
  };

  const state = {
    a: { ...PRESETS.tilted[0] },
    b: { ...PRESETS.tilted[1] },
    shadows: true,
    spin: false,
    focus: -1, // the wall whose card is under the pointer, or none
  };
  const cam = { ...HOME_VIEW, zoom: 1, pan: { x: 0, y: 0 } };

  const canvas = el('cp') as HTMLCanvasElement;
  const W = canvas.width, H = canvas.height;
  const scene = createScene(canvas, cam, {
    origin: () => ({ x: W / 2, y: H * 0.53 }),
    scale: () => 150,
    redraw: () => draw(),
  });

  // --- the picture -----------------------------------------------------------

  /** Where the patch's corner lands on one wall. */
  const onWall = (plane: number, v: Vec): Vec =>
    plane === 0 ? { x: -LIMIT, y: v.y, z: v.z }
    : plane === 1 ? { x: v.x, y: -LIMIT, z: v.z }
    : { x: v.x, y: v.y, z: -LIMIT };

  /** A small arrowhead partway along an edge, showing which way it is traced. */
  function headOn(p: Vec, q: Vec, col: string, size = 7) {
    const { ctx } = scene;
    const u = scene.project(p), v = scene.project(q);
    const mx = (u.x + v.x) / 2, my = (u.y + v.y) / 2;
    const an = Math.atan2(v.y - u.y, v.x - u.x);
    ctx.fillStyle = col;
    ctx.beginPath();
    ctx.moveTo(mx + (size * Math.cos(an)) / 2, my + (size * Math.sin(an)) / 2);
    ctx.lineTo(mx - size * Math.cos(an - 0.5), my - size * Math.sin(an - 0.5));
    ctx.lineTo(mx - size * Math.cos(an + 0.5), my - size * Math.sin(an + 0.5));
    ctx.closePath();
    ctx.fill();
  }

  /**
   * The patch's shadow on one wall, in the colour of the component it stands
   * for. The sign is not a colour but a direction: the two arrowheads show
   * which way round the loop is traced. When a card is hovered, its wall is
   * lit and the other two fade.
   */
  function drawShadow(plane: number, area: number) {
    const { a, b } = state;
    const col = COLOR.axis[plane];
    const lit = state.focus < 0 ? 1 : state.focus === plane ? 2 : 0.3;
    const corner = (v: Vec) => onWall(plane, v);
    scene.poly(
      [corner(O), corner(a), corner(add(a, b)), corner(b)],
      rgba(col, 0.11 * lit),
      rgba(col, Math.min(0.9, 0.5 * lit)),
      state.focus === plane ? 2 : 1.2
    );
    if (lit >= 1) {
      headOn(corner(O), corner(a), col);
      headOn(corner(add(a, b)), corner(b), col);
      scene.tag(`${area >= 0 ? '+' : '−'}${Math.abs(area).toFixed(2)}`, corner(mul(add(a, b), 0.5)), 0, 4, col, 12, 'center');
    }
  }

  function draw() {
    const { ctx, inkA } = scene;
    ctx.clearRect(0, 0, W, H);
    scene.grid(true, COLOR.axis);

    const { a, b } = state;
    const c = cross(a, b);
    if (state.shadows) {
      const planes = componentPlanes(a, b);
      // far walls first, so nothing is drawn over the patch itself
      const order = [0, 1, 2].sort((i, j) => scene.project(onWall(j, O)).d - scene.project(onWall(i, O)).d);
      for (const p of order) drawShadow(p, planes[p].area);
    }

    // the patch itself, kept neutral so the coloured things stay the vectors
    scene.poly([O, a, add(a, b), b], inkA(0.1), inkA(0.35));
    scene.line(a, add(a, b), inkA(0.25), 1.2, [4, 4]);
    scene.line(b, add(a, b), inkA(0.25), 1.2, [4, 4]);

    scene.arrow(O, a, COLOR.a);
    scene.arrow(O, b, COLOR.b);
    if (len(c) > 1e-6) {
      scene.arrow(O, c, COLOR.result, 3.6, 18);
      scene.tag('a × b', mul(c, 1.06), 8, -10, COLOR.result);
    }
    scene.tag('a', mul(a, 1.08), 8, 4, COLOR.a);
    scene.tag('b', mul(b, 1.08), 8, 4, COLOR.b);
  }

  // --- the cards: each shadow head-on, next to its arithmetic ----------------

  const num = (n: number) => (n < 0 ? `(${n.toFixed(1)})` : n.toFixed(1));

  function drawCards() {
    const planes = componentPlanes(state.a, state.b);
    // one scale for all three cards, so their areas can be compared by eye
    const extent = Math.max(3, ...planes.flatMap((p) => [p.a[0], p.a[1], p.b[0], p.b[1], p.a[0] + p.b[0], p.a[1] + p.b[1]].map(Math.abs)));
    const S = 100 / extent, CX = 120, CY = 120;
    planes.forEach((plane, i) => {
      const col = COLOR.axis[i];
      const sx = (v: number) => CX + v * S;
      const sy = (v: number) => CY - v * S;
      const point = (v: number[]) => `${sx(v[0])},${sy(v[1])}`;
      const corner = [plane.a[0] + plane.b[0], plane.a[1] + plane.b[1]];
      const arrow = (v: number[], color: string, name: string) =>
        `<line x1="${CX}" y1="${CY}" x2="${sx(v[0])}" y2="${sy(v[1])}" stroke="${color}" stroke-width="2.5" marker-end="url(#arrow-${i}-${name})" />`;
      const R = Math.ceil(extent);
      const gridLines = [];
      for (let v = -R; v <= R; v++)
        gridLines.push(`<path d="M${sx(v)} ${sy(R)} V${sy(-R)} M${sx(-R)} ${sy(v)} H${sx(R)}" fill="none" stroke="currentColor" opacity="${v === 0 ? 0.35 : 0.07}" />`);
      el(`component-plane-${i}`).innerHTML = `
        <defs>${[[COLOR.a, 'a'], [COLOR.b, 'b']].map(([color, name]) => `<marker id="arrow-${i}-${name}" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0 L10 5 L0 10 Z" fill="${color}" /></marker>`).join('')}</defs>
        ${gridLines.join('')}
        <polygon points="${[[0, 0], plane.a, corner, plane.b].map(point).join(' ')}" fill="${col}" fill-opacity="${plane.area === 0 ? 0 : 0.25}" stroke="${col}" stroke-width="1.5" />
        ${arrow(plane.a, COLOR.a, 'a')}${arrow(plane.b, COLOR.b, 'b')}
        <text x="${sx(R) + 6}" y="${CY + 4}" fill="currentColor" font-size="13">${plane.axes[0]}</text>
        <text x="${CX + 6}" y="${sy(R) + 4}" fill="currentColor" font-size="13">${plane.axes[1]}</text>`;

      const [p, q] = plane.axes;
      el(`component-value-${i}`).textContent = `${plane.component} = ${plane.area > 0 ? '+' : ''}${plane.area.toFixed(2)}`;
      el(`component-formula-${i}`).innerHTML = subHtml(
        `a_${p} b_${q} − a_${q} b_${p}<br>= ${num(plane.a[0])}·${num(plane.b[1])} − ${num(plane.a[1])}·${num(plane.b[0])} = ${plane.area.toFixed(2)}`
      );
      el(`component-orientation-${i}`).textContent =
        Math.abs(plane.area) < 1e-10
          ? 'The shadow collapses to a line: zero area.'
          : `Traced ${plane.area > 0 ? 'counterclockwise (+)' : 'clockwise (−)'} from a to b.`;
    });
  }

  // --- the words and numbers, rebuilt only when the vectors change -----------

  const setEq = equation();
  let lastKey = '';

  function updateReadout() {
    const key = JSON.stringify([state.a, state.b]);
    if (key === lastKey) return;
    lastKey = key;
    drawCards();

    const { a, b } = state;
    const c = cross(a, b);
    const area = len(c);
    const th = angleBetween(a, b);
    const sine = len(a) * len(b) * Math.sin(((th ?? 0) * Math.PI) / 180);
    const zero = th === null;

    el('result-value').textContent = `(${c.x.toFixed(2)}, ${c.y.toFixed(2)}, ${c.z.toFixed(2)})`;
    el('result-status').textContent = zero
      ? 'Zero vector'
      : area < 1e-9 ? 'Parallel, so zero area' : `Area ${area.toFixed(2)} · angle ${degrees(th)}`;
    el('result-explanation').textContent = zero
      ? 'A zero vector spans no patch, and the angle is undefined.'
      : area < 1e-9
        ? 'Parallel vectors span no patch, so the cross product vanishes.'
        : 'Its length is the area of the patch spanned by a and b, and it points perpendicular to both. Swap a and b to flip it.';

    el('r-area').textContent = area.toFixed(3);
    el('r-sine').textContent = sine.toFixed(3);
    el('r-angle').textContent = degrees(th);
    el('r-perp-a').textContent = dot(a, c).toFixed(6);
    el('r-perp-b').textContent = dot(b, c).toFixed(6);

    const A = `\\textcolor{${COLOR.a}}{\\mathbf a}`, B = `\\textcolor{${COLOR.b}}{\\mathbf b}`;
    setEq({
      rule: [`${A}\\times${B}`, '=', ['(a_yb_z-a_zb_y,\\;a_zb_x-a_xb_z,\\;a_xb_y-a_yb_x)', COLOR.result]],
      live: [
        [`|${A}\\times${B}| = ${area.toFixed(3)}`, COLOR.result],
        `\\quad = |\\mathbf a||\\mathbf b|\\sin\\theta = ${sine.toFixed(3)}`,
      ],
    });
  }

  // --- loop ------------------------------------------------------------------

  let last = performance.now();
  function frame(now: number) {
    const dt = Math.min(0.05, Math.max(0, (now - last) / 1000));
    last = now;
    if (state.spin) cam.yaw += dt * 0.28;
    draw();
    updateReadout();
    requestAnimationFrame(frame);
  }

  // --- controls --------------------------------------------------------------

  const presets = segmented('preset', (name) => applyPreset(name));
  const sync = vectorSliders(state, () => presets.clear());

  function applyPreset(name: string) {
    const [a, b] = PRESETS[name] ?? PRESETS.tilted;
    state.a = { ...a };
    state.b = { ...b };
    sync();
  }

  el('swap').addEventListener('click', () => {
    [state.a, state.b] = [state.b, state.a];
    presets.clear();
    sync();
  });

  const shadows = el('shadows') as HTMLInputElement;
  const spin = el('spin') as HTMLInputElement;
  shadows.addEventListener('change', () => (state.shadows = shadows.checked));
  spin.addEventListener('change', () => (state.spin = spin.checked));

  el('reset').addEventListener('click', () => {
    applyPreset('tilted');
    presets.select('tilted');
    Object.assign(cam, HOME_VIEW, { zoom: 1, pan: { x: 0, y: 0 } });
    state.spin = spin.checked = false;
    state.shadows = shadows.checked = true;
  });

  // hovering or focusing a card lights up its wall in the scene
  document.querySelectorAll<HTMLElement>('.component-card').forEach((card) => {
    const plane = +card.dataset.plane!;
    const on = () => {
      state.focus = plane;
      card.classList.add('active');
    };
    const off = () => {
      if (state.focus === plane) state.focus = -1;
      card.classList.remove('active');
    };
    card.addEventListener('pointerenter', on);
    card.addEventListener('pointerleave', off);
    card.addEventListener('focus', on);
    card.addEventListener('blur', off);
  });

  scene.pointer({ flat: () => false });

  requestAnimationFrame(frame);
</script>
