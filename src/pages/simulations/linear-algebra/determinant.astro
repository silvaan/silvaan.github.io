---
import SimLayout from '../../../layouts/SimLayout.astro';
---

<SimLayout
  areaSlug="linear-algebra"
  title="The Determinant"
  description="One number that says what a matrix does to area. The unit square is carried to a parallelogram, and the determinant is how big that parallelogram is, with a minus sign when the plane has been turned over. Squash it to zero and the map has thrown a dimension away, which is exactly when it stops being invertible."
>
  <div class="sim">
    <div class="sim-stage">
      <canvas id="det" width="800" height="700"></canvas>
    </div>

    <div class="sim-panel">
      <div class="control">
        <label>Matrix A</label>
        <div class="matrix-view" aria-label="current matrix">
          <span class="bracket" aria-hidden="true"></span>
          <div class="matrix-cells">
            <b id="m-a">1.00</b><b id="m-b">0.00</b>
            <b id="m-c">0.00</b><b id="m-d">1.00</b>
          </div>
          <span class="bracket" aria-hidden="true"></span>
        </div>
        <div class="mgrid">
          <div><label>a <b id="aval">1.00</b></label><input type="range" id="a" min="-3" max="3" step="0.05" value="1" /></div>
          <div><label>b <b id="bval">0.00</b></label><input type="range" id="b" min="-3" max="3" step="0.05" value="0" /></div>
          <div><label>c <b id="cval">0.00</b></label><input type="range" id="c" min="-3" max="3" step="0.05" value="0" /></div>
          <div><label>d <b id="dval">1.00</b></label><input type="range" id="d" min="-3" max="3" step="0.05" value="1" /></div>
        </div>
      </div>

      <div class="control">
        <label>Sweep&nbsp;&nbsp;I → A <b id="tval">1.00</b></label>
        <input type="range" id="t" min="0" max="1" step="0.01" value="1" />
        <div class="row-controls">
          <button class="btn ghost" id="run">Animate</button>
          <button class="btn ghost" id="reset">Reset</button>
        </div>
      </div>

      <div class="control">
        <label>Presets</label>
        <div class="seg" id="presets">
          <button data-m="1,0,0,1">Identity</button>
          <button data-m="2,0,0,1">Stretch x</button>
          <button data-m="1,0.9,0,1">Shear</button>
          <button data-m="0,-1,1,0">Rotate</button>
          <button data-m="-1,0,0,1">Reflect</button>
          <button data-m="1,2,0.5,1">Collapse</button>
        </div>
      </div>

      <div class="control">
        <label>Then apply B as well</label>
        <div class="seg" id="bmat">
          <button data-b="none" class="active">Nothing</button>
          <button data-b="rot">Rotate 90°</button>
          <button data-b="shear">Shear</button>
          <button data-b="scale">Scale 1.5</button>
          <button data-b="flip">Reflect</button>
        </div>
      </div>

      <div class="control">
        <label>Show</label>
        <label class="check"><input type="checkbox" id="shape" /> A shape inside the square</label>
        <label class="check"><input type="checkbox" id="hgt" /> Base times height</label>
        <label class="check"><input type="checkbox" id="ghost" checked /> The original grid</label>
      </div>

      <div class="readout">
        <div class="row"><span>det A</span><b id="detOut">1.000</b></div>
        <div class="row"><span>Area of the square</span><b id="areaOut">1.000</b></div>
        <div class="row"><span>Orientation</span><b id="oriOut">kept</b></div>
        <div class="row"><span>Shape area, before → after</span><b id="shapeOut">—</b></div>
        <div class="row"><span>det B</span><b id="detBOut">—</b></div>
        <div class="row"><span>det(BA)</span><b id="detBAOut">—</b></div>
        <div class="row"><span>Invertible?</span><b id="invOut">yes</b></div>
      </div>

      <p style="font-size:.82rem;color:var(--text-faint);margin:0;line-height:1.5">
        Drag the tips of the two arrows. They are the columns of A, and the
        parallelogram they span is the whole of what the determinant measures.
      </p>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      The two arrows are the <b>columns of A</b>: where î and ĵ land. The unit
      square between the old ones is carried to the parallelogram between the
      new ones, and the determinant is nothing more exotic than
      <b>its area</b>. Drag a tip and watch the number track the shading.
    </li>
    <li>
      Turn on <b>base times height</b>. The area is the length of one arrow
      times how far the other stands off its line, and the dashed leg is that
      height. Slide the second arrow <b>along</b> the direction of the first:
      the height never changes, so neither does the area. That single fact is
      why adding a multiple of one row to another leaves a determinant alone.
    </li>
    <li>
      Push the arrows towards each other until they line up. The parallelogram
      thins to nothing, <b>det hits 0</b>, and the whole plane has been pressed
      onto a line. Everything on that line now has infinitely many preimages and
      everything off it has none, which is precisely what
      <b>non-invertible</b> means. The determinant answers that question with a
      single number.
    </li>
    <li>
      Keep pushing past the collapse. The shading changes colour and the
      determinant comes out negative. Turn on <b>A shape inside the square</b>:
      the little <b>F flips into its mirror image</b>. The sign is not an
      accident of the formula, it is the record of whether the plane was turned
      over, and to get from a right-handed frame to a left-handed one you have
      to <b>pass through zero</b>, which is what Animate shows on the Reflect
      preset.
    </li>
    <li>
      The square is a convenient object, not a special one. With the shape on,
      watch the row for its area: whatever it started as, it comes out
      multiplied by the <b>same</b> |det A|. The determinant is a property of
      the map, not of the thing being mapped.
    </li>
    <li>
      Now switch <b>B</b> on. Doing A and then B scales area twice over, so
      <b>det(BA) = det B · det A</b> falls out with no algebra at all. Set B to
      Reflect while A is already a reflection: two flips undo each other, two
      minus signs multiply to a plus, and the F comes back the right way round.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equationBar } from '../../../lib/equation';

  // ---------------------------------------------------------------------------
  // ad - bc is not a mnemonic, it is the area of the parallelogram spanned by
  // the columns, signed by whether the plane got turned over on the way. Every
  // property people memorise (multiplicative, zero exactly when singular,
  // unchanged by a shear) is visible in that one picture, so this page draws
  // the picture and lets the formula follow.
  // ---------------------------------------------------------------------------

  type Mat = { a: number; b: number; c: number; d: number };

  const A: Mat = { a: 1, b: 0, c: 0, d: 1 };
  const view = { t: 1, shape: false, hgt: false, ghost: true, bkey: 'none' };

  const BS: Record<string, { m: Mat; name: string }> = {
    none: { m: { a: 1, b: 0, c: 0, d: 1 }, name: 'I' },
    rot: { m: { a: 0, b: -1, c: 1, d: 0 }, name: 'rotate 90°' },
    shear: { m: { a: 1, b: 0.8, c: 0, d: 1 }, name: 'shear' },
    scale: { m: { a: 1.5, b: 0, c: 0, d: 1.5 }, name: 'scale 1.5' },
    flip: { m: { a: -1, b: 0, c: 0, d: 1 }, name: 'reflect' },
  };

  const det = (m: Mat) => m.a * m.d - m.b * m.c;
  const mul = (p: Mat, q: Mat): Mat => ({
    a: p.a * q.a + p.b * q.c,
    b: p.a * q.b + p.b * q.d,
    c: p.c * q.a + p.d * q.c,
    d: p.c * q.b + p.d * q.d,
  });
  /** The matrix actually on screen: the identity swept towards A by t. */
  const shown = (): Mat => ({
    a: 1 + view.t * (A.a - 1),
    b: view.t * A.b,
    c: view.t * A.c,
    d: 1 + view.t * (A.d - 1),
  });

  // --- canvas ----------------------------------------------------------------

  const canvas = document.getElementById('det') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const cssv = (n: string) => getComputedStyle(canvas).getPropertyValue(n).trim();
  const inkA = (a: number) => `rgba(${cssv('--stage-ink') || '232,233,236'},${a})`;
  const { label } = makeText(ctx, inkA);
  const setEq = equationBar();

  const ACC = '#7c8cff'; // first column
  const TEAL = '#5eead4'; // second column, and positive area
  const HOT = '#f9736a'; // negative area
  const WARM = '#f59e0b'; // the composed image

  const O = { x: W / 2 - 30, y: 330 };
  const UNIT = 62;
  const METER = { x: 60, y: 646, w: W - 120 };

  const pt = (m: Mat, x: number, y: number) => ({
    px: O.x + (m.a * x + m.b * y) * UNIT,
    py: O.y - (m.c * x + m.d * y) * UNIT,
  });
  const raw = (x: number, y: number) => ({ px: O.x + x * UNIT, py: O.y - y * UNIT });

  // --- the shape that rides inside the unit square ---------------------------
  // An F, because it has no symmetry at all: a mirrored F cannot be mistaken
  // for a rotated one, so the sign of the determinant becomes visible.

  const F_RAW: [number, number][] = [
    [0, 0], [0.32, 0], [0.32, 0.5], [0.72, 0.5], [0.72, 0.8],
    [0.32, 0.8], [0.32, 1.05], [0.85, 1.05], [0.85, 1.35], [0, 1.35],
  ];
  const SHAPE: [number, number][] = F_RAW.map(([x, y]) => [
    0.1 + x * 0.94,
    0.12 + y * 0.57,
  ]);
  function shoelace(p: [number, number][]) {
    let s = 0;
    for (let i = 0; i < p.length; i++) {
      const q = p[(i + 1) % p.length];
      s += p[i][0] * q[1] - q[0] * p[i][1];
    }
    return s / 2;
  }
  const SHAPE_AREA = Math.abs(shoelace(SHAPE));

  // --- drawing helpers -------------------------------------------------------

  function grid(m: Mat, col: string, dash: number[], alpha: number) {
    const R = 7;
    ctx.strokeStyle = col;
    ctx.lineWidth = 1;
    ctx.globalAlpha = alpha;
    ctx.setLineDash(dash);
    ctx.beginPath();
    for (let i = -R; i <= R; i++) {
      const a1 = pt(m, i, -R), a2 = pt(m, i, R);
      const b1 = pt(m, -R, i), b2 = pt(m, R, i);
      ctx.moveTo(a1.px, a1.py);
      ctx.lineTo(a2.px, a2.py);
      ctx.moveTo(b1.px, b1.py);
      ctx.lineTo(b2.px, b2.py);
    }
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.globalAlpha = 1;
  }

  function arrow(to: { px: number; py: number }, col: string, text: string) {
    ctx.strokeStyle = col;
    ctx.fillStyle = col;
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(O.x, O.y);
    ctx.lineTo(to.px, to.py);
    ctx.stroke();
    const ang = Math.atan2(to.py - O.y, to.px - O.x);
    ctx.beginPath();
    ctx.moveTo(to.px, to.py);
    ctx.lineTo(to.px - 12 * Math.cos(ang - 0.4), to.py - 12 * Math.sin(ang - 0.4));
    ctx.lineTo(to.px - 12 * Math.cos(ang + 0.4), to.py - 12 * Math.sin(ang + 0.4));
    ctx.closePath();
    ctx.fill();
    label(text, to.px + 9, to.py - 9, 1, 'left', 13, col);
  }

  function poly(m: Mat, pts: [number, number][], close = true) {
    ctx.beginPath();
    pts.forEach(([x, y], k) => {
      const p = pt(m, x, y);
      k ? ctx.lineTo(p.px, p.py) : ctx.moveTo(p.px, p.py);
    });
    if (close) ctx.closePath();
  }

  /** The turn from the first column to the second, drawn as an arc. */
  function orientationArc(m: Mat, D: number) {
    const r = 34;
    const a1 = Math.atan2(-(m.c), m.a);
    const a2 = Math.atan2(-(m.d), m.b);
    let sweep = a2 - a1;
    while (sweep > Math.PI) sweep -= 2 * Math.PI;
    while (sweep < -Math.PI) sweep += 2 * Math.PI;
    if (Math.abs(Math.abs(sweep) - Math.PI) < 0.02) return;
    if (Math.abs(D) < 0.06) return; // nearly flat: the arc only adds noise
    ctx.strokeStyle = D >= 0 ? TEAL : HOT;
    ctx.lineWidth = 1.4;
    ctx.beginPath();
    ctx.arc(O.x, O.y, r, a1, a1 + sweep, sweep < 0);
    ctx.stroke();
    const tipA = a1 + sweep;
    const tx = O.x + r * Math.cos(tipA);
    const ty = O.y + r * Math.sin(tipA);
    const tangent = tipA + (sweep > 0 ? Math.PI / 2 : -Math.PI / 2);
    ctx.fillStyle = D >= 0 ? TEAL : HOT;
    ctx.beginPath();
    ctx.moveTo(tx, ty);
    ctx.lineTo(tx - 9 * Math.cos(tangent - 0.45), ty - 9 * Math.sin(tangent - 0.45));
    ctx.lineTo(tx - 9 * Math.cos(tangent + 0.45), ty - 9 * Math.sin(tangent + 0.45));
    ctx.closePath();
    ctx.fill();
  }

  /** Area as base times height, with the height drawn where it is measured. */
  function baseHeight(m: Mat) {
    const u = { x: m.a, y: m.c }; // first column
    const v = { x: m.b, y: m.d }; // second
    const ul = Math.hypot(u.x, u.y);
    if (ul < 1e-6) return;
    const t = (v.x * u.x + v.y * u.y) / (ul * ul); // v projected onto u
    const foot = { x: t * u.x, y: t * u.y };
    const pv = raw(v.x, v.y);
    const pf = raw(foot.x, foot.y);
    ctx.strokeStyle = WARM;
    ctx.setLineDash([5, 4]);
    ctx.lineWidth = 1.6;
    ctx.beginPath();
    ctx.moveTo(pv.px, pv.py);
    ctx.lineTo(pf.px, pf.py);
    ctx.stroke();
    // the line the base lies on, extended so the foot has something to sit on
    const far1 = raw(u.x * 6, u.y * 6), far2 = raw(-u.x * 6, -u.y * 6);
    ctx.strokeStyle = inkA(0.16);
    ctx.beginPath();
    ctx.moveTo(far1.px, far1.py);
    ctx.lineTo(far2.px, far2.py);
    ctx.stroke();
    ctx.setLineDash([]);
    const h = Math.abs(v.x * u.y - v.y * u.x) / ul;
    label(
      `height ${h.toFixed(2)}`,
      (pv.px + pf.px) / 2 + 8,
      (pv.py + pf.py) / 2,
      0.95,
      'left',
      11,
      WARM
    );
    const pm = raw(u.x / 2, u.y / 2);
    label(`base ${ul.toFixed(2)}`, pm.px, pm.py + 18, 0.95, 'center', 11, ACC);
  }

  /** A signed ruler for the determinant, so zero is a place and not a value. */
  function meter(D: number) {
    const cx = METER.x + METER.w / 2;
    const RANGE = 6;
    const X = (v: number) => cx + (Math.max(-RANGE, Math.min(RANGE, v)) / RANGE) * (METER.w / 2);
    ctx.strokeStyle = inkA(0.12);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(METER.x, METER.y);
    ctx.lineTo(METER.x + METER.w, METER.y);
    ctx.stroke();
    for (const v of [-6, 0, 6]) {
      ctx.strokeStyle = inkA(v === 0 ? 0.5 : 0.2);
      ctx.beginPath();
      ctx.moveTo(X(v), METER.y - (v === 0 ? 10 : 5));
      ctx.lineTo(X(v), METER.y + (v === 0 ? 10 : 5));
      ctx.stroke();
      label(String(v), X(v), METER.y + 24, 0.35, 'center', 10);
    }
    ctx.fillStyle = D >= 0 ? TEAL : HOT;
    ctx.fillRect(Math.min(cx, X(D)), METER.y - 5, Math.abs(X(D) - cx), 10);
    ctx.beginPath();
    ctx.arc(X(D), METER.y, 6, 0, Math.PI * 2);
    ctx.fill();
    label(`det A = ${D.toFixed(3)}`, X(D), METER.y - 16, 1, 'center', 13, D >= 0 ? TEAL : HOT);
  }

  // --- the frame -------------------------------------------------------------

  function draw() {
    const M = shown();
    const D = det(M);
    const B = BS[view.bkey].m;
    const BA = mul(B, M);
    ctx.clearRect(0, 0, W, H);

    if (view.ghost) grid({ a: 1, b: 0, c: 0, d: 1 }, cssv('--border') || '#262a32', [3, 4], 0.45);
    grid(M, cssv('--border') || '#262a32', [], 0.9);

    // the image of the unit square: the determinant, drawn
    poly(M, [[0, 0], [1, 0], [1, 1], [0, 1]]);
    ctx.fillStyle = D >= 0 ? 'rgba(94,234,212,0.16)' : 'rgba(249,115,106,0.18)';
    ctx.fill();
    ctx.strokeStyle = D >= 0 ? TEAL : HOT;
    ctx.lineWidth = 1.6;
    ctx.stroke();

    // the same square under B∘A, to make multiplicativity a picture
    if (view.bkey !== 'none') {
      poly(BA, [[0, 0], [1, 0], [1, 1], [0, 1]]);
      ctx.fillStyle = 'rgba(245,158,11,0.10)';
      ctx.fill();
      ctx.strokeStyle = WARM;
      ctx.setLineDash([6, 4]);
      ctx.lineWidth = 1.8;
      ctx.stroke();
      ctx.setLineDash([]);
      const lp = pt(BA, 0.5, 0.5);
      label('B A', lp.px, lp.py + 4, 0.95, 'center', 12, WARM);
    }

    if (view.shape) {
      poly(M, SHAPE);
      ctx.fillStyle = D >= 0 ? 'rgba(94,234,212,0.4)' : 'rgba(249,115,106,0.42)';
      ctx.fill();
    }

    if (view.hgt) baseHeight(M);
    orientationArc(M, D);

    arrow(pt(M, 1, 0), ACC, 'A î');
    arrow(pt(M, 0, 1), TEAL, 'A ĵ');

    const area = Math.abs(D);
    const mid = pt(M, 0.5, 0.5);
    if (area > 0.12)
      label(
        `area ${area.toFixed(2)}`,
        mid.px,
        mid.py + (view.shape ? 34 : 4),
        0.9,
        'center',
        12,
        D >= 0 ? TEAL : HOT
      );
    else label('flattened', mid.px, mid.py - 16, 0.9, 'center', 12, HOT);

    meter(D);

    // --- readouts
    const el = (id: string) => document.getElementById(id) as HTMLElement;
    el('m-a').textContent = M.a.toFixed(2);
    el('m-b').textContent = M.b.toFixed(2);
    el('m-c').textContent = M.c.toFixed(2);
    el('m-d').textContent = M.d.toFixed(2);
    el('detOut').textContent = D.toFixed(3);
    el('areaOut').textContent = area.toFixed(3);
    el('oriOut').textContent =
      Math.abs(D) < 0.02 ? 'gone' : D > 0 ? 'kept' : 'reversed';
    el('shapeOut').textContent = view.shape
      ? `${SHAPE_AREA.toFixed(3)} → ${(SHAPE_AREA * area).toFixed(3)}`
      : '—';
    el('detBOut').textContent =
      view.bkey === 'none' ? '—' : det(B).toFixed(3);
    el('detBAOut').textContent =
      view.bkey === 'none'
        ? '—'
        : `${det(BA).toFixed(3)} = ${det(B).toFixed(2)} × ${D.toFixed(2)}`;
    el('invOut').textContent = Math.abs(D) < 0.02 ? 'no' : 'yes';
    el('invOut').style.color = Math.abs(D) < 0.02 ? HOT : '';

    setEq([
      [
        '\\det A = ',
        ['ad', TEAL],
        '-',
        ['bc', WARM],
        '= \\text{signed area of }',
        ['A\\hat\\imath', ACC],
        ',\\,',
        ['A\\hat\\jmath', TEAL],
      ],
      [
        [
          `\\det A = (${M.a.toFixed(2)})(${M.d.toFixed(2)}) - (${M.b.toFixed(2)})(${M.c.toFixed(2)}) = ${D.toFixed(3)}`,
          D >= 0 ? TEAL : HOT,
        ],
        view.bkey === 'none'
          ? ''
          : [
              `\\quad \\det(BA) = ${det(BA).toFixed(3)} = ${det(B).toFixed(2)}\\cdot ${D.toFixed(2)}`,
              WARM,
            ],
      ],
      [
        Math.abs(D) < 0.02
          ? 'zero area means a whole dimension was thrown away, and nothing thrown away can be recovered'
          : 'every region in the plane, not just this square, comes out scaled by exactly this much',
      ],
    ]);
  }

  // --- controls --------------------------------------------------------------

  const el = (id: string) => document.getElementById(id) as HTMLElement;
  const inp = (id: string) => document.getElementById(id) as HTMLInputElement;

  function syncMatrix() {
    (['a', 'b', 'c', 'd'] as const).forEach((k) => {
      inp(k).value = String(A[k]);
      el(k + 'val').textContent = A[k].toFixed(2);
    });
  }
  function setT(t: number) {
    view.t = t;
    inp('t').value = String(t);
    el('tval').textContent = t.toFixed(2);
  }

  (['a', 'b', 'c', 'd'] as const).forEach((k) => {
    inp(k).addEventListener('input', () => {
      A[k] = +inp(k).value;
      el(k + 'val').textContent = A[k].toFixed(2);
      draw();
    });
  });

  inp('t').addEventListener('input', () => {
    setT(+inp('t').value);
    draw();
  });

  for (const id of ['shape', 'hgt', 'ghost'] as const)
    inp(id).addEventListener('change', () => {
      (view as Record<string, unknown>)[id] = inp(id).checked;
      draw();
    });

  el('presets').addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn) return;
    const [a, b, c, d] = btn.dataset.m!.split(',').map(Number);
    Object.assign(A, { a, b, c, d });
    setT(1);
    syncMatrix();
    draw();
  });

  el('bmat').addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn) return;
    document.querySelectorAll('#bmat button').forEach((b) => b.classList.remove('active'));
    btn.classList.add('active');
    view.bkey = btn.dataset.b!;
    draw();
  });

  let raf = 0;
  el('run').addEventListener('click', () => {
    cancelAnimationFrame(raf);
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min(1, (now - start) / 1400);
      setT(+p.toFixed(3));
      draw();
      if (p < 1) raf = requestAnimationFrame(tick);
    };
    setT(0);
    raf = requestAnimationFrame(tick);
  });

  el('reset').addEventListener('click', () => {
    cancelAnimationFrame(raf);
    Object.assign(A, { a: 1, b: 0, c: 0, d: 1 });
    setT(1);
    syncMatrix();
    draw();
  });

  // --- dragging the two columns ----------------------------------------------

  let drag: 'i' | 'j' | null = null;
  function local(e: PointerEvent) {
    const r = canvas.getBoundingClientRect();
    return {
      x: ((e.clientX - r.left) / r.width) * W,
      y: ((e.clientY - r.top) / r.height) * H,
    };
  }
  function nearTip(l: { x: number; y: number }, which: 'i' | 'j') {
    const p = which === 'i' ? pt(shown(), 1, 0) : pt(shown(), 0, 1);
    return Math.hypot(l.x - p.px, l.y - p.py) < 17;
  }
  canvas.addEventListener('pointerdown', (e) => {
    const l = local(e);
    drag = nearTip(l, 'i') ? 'i' : nearTip(l, 'j') ? 'j' : null;
    if (drag) {
      setT(1);
      canvas.setPointerCapture(e.pointerId);
    }
  });
  canvas.addEventListener('pointermove', (e) => {
    const l = local(e);
    if (!drag) {
      canvas.style.cursor = nearTip(l, 'i') || nearTip(l, 'j') ? 'grab' : 'default';
      return;
    }
    const snap = (v: number) => (Math.abs(v - Math.round(v)) < 0.07 ? Math.round(v) : +v.toFixed(2));
    const x = Math.max(-3, Math.min(3, snap((l.x - O.x) / UNIT)));
    const y = Math.max(-3, Math.min(3, snap((O.y - l.y) / UNIT)));
    if (drag === 'i') {
      A.a = x;
      A.c = y;
    } else {
      A.b = x;
      A.d = y;
    }
    syncMatrix();
    draw();
  });
  const stop = () => (drag = null);
  canvas.addEventListener('pointerup', stop);
  canvas.addEventListener('pointercancel', stop);

  syncMatrix();
  draw();
</script>

