---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Matrix from '../../../components/sim/Matrix.astro';
import Checks from '../../../components/sim/Checks.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
---

<SimLayout
  areaSlug="linear-algebra"
  title="Eigenvectors & Eigenvalues"
  description="A matrix turns almost every vector off its line. Sweep a whole fan of directions through it and watch how far each one is turned: the directions that are not turned at all are the eigenvectors, and how much they stretch is the eigenvalue."
  shortcuts={['animate', 'fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="eigen"
          width="1000"
          height="600"
          role="img"
          aria-label="Left: a fan of unit vectors and where the matrix sends each of them, with one vector v and its image Av highlighted. Right: a graph of how far each direction is turned, crossing zero at the eigenvectors, and a graph of how much it is stretched."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'v, a direction going in', color: '#7c8cff' },
          { label: 'Av, where it lands', color: '#fbbf24' },
          { label: 'not turned at all: an eigenvector', color: '#5eead4' },
        ]}
        hint="Drag on the left to aim v · click the graph to jump to a direction"
      />
      <Result label="How far A turns v" />
    </div>

    <div class="sim-panel">
      <Matrix
        label="Matrix A"
        entries={[
          { id: 'a', label: 'a', value: 2 },
          { id: 'b', label: 'b', value: 1 },
          { id: 'c', label: 'c', value: 1 },
          { id: 'd', label: 'd', value: 2 },
        ]}
      />
      <Seg
        id="presets"
        label="Presets"
        attr="m"
        options={[
          { value: '2,1,1,2', label: 'Symmetric' },
          { value: '2,0,0,-1', label: 'Diagonal' },
          { value: '1,1,0,1', label: 'Shear' },
          { value: '0,-1,1,0', label: 'Rotation' },
          { value: '1.4,0.6,-0.4,0.8', label: 'General' },
        ]}
      />
      <Slider id="th" label="Direction of v" min={0} max={180} value={20} display="20°" />
      <Transport animate="Animate I → A" reset={false}>
        <button type="button" class="btn ghost" id="snap">Snap to an eigenvector</button>
      </Transport>
      <Slider id="t" label="How much of A is applied" min={0} max={100} value={100} display="all of it" hint={['identity', 'full A']} />
      <Checks items={[{ id: 'fan', label: 'Show the whole fan of directions', checked: true }, { id: 'showgrid', label: 'Show the unit circle and its image', checked: true }]} />
      <Readout rows={[{ id: 'r-eig', label: 'eigenvalues' }, { id: 'r-turn', label: 'turn of v' }, { id: 'r-stretch', label: '|Av| / |v|' }]} />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Look at the fan first. Every thin spoke is a direction going in, and the
      amber dot at its tip is where A sends it. Almost every dot has slid
      sideways off its spoke: the matrix <b>turned</b> that direction. Only along
      the teal lines do the dots sit exactly on their spokes.
    </li>
    <li>
      The graph on the right is the same fact as a curve: how far each direction
      is turned, from −90° to 90°. Where the curve <b>crosses zero</b> the
      direction comes out unturned, and that is an eigenvector. Drag v there and
      the result strip lights up teal with <b>Av = λv</b>.
    </li>
    <li>
      The lower graph shows how much each direction is stretched. Read it at a
      zero crossing and you are reading the eigenvalue: the stretch of a
      direction that was only stretched. <b>Symmetric</b> matrices put their two
      crossings exactly 90° apart.
    </li>
    <li>
      Pick <b>Shear</b>: the curve only touches zero once, so there is a single
      eigen-direction. Pick <b>Rotation</b>: the curve sits at a constant 90° and
      never crosses zero. Every real direction is turned, so there are no real
      eigenvectors and the eigenvalues are complex.
    </li>
    <li>
      Press <b>Animate I → A</b>. The matrix is blended in from the identity, and
      the whole fan swings except for the two teal directions, which only slide
      along themselves. A_t = (1−t)I + tA shares A's eigenvectors, which is why
      they never move.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk, arrow } from '../../../lib/draw';
  import { el, segmented, slider, matrix, check, result, readout } from '../../../lib/panel';

  const M = { a: 2, b: 1, c: 1, d: 2 };
  const state = { theta: (20 * Math.PI) / 180, t: 1, animating: false, fan: true, showgrid: true };
  const IN = '#7c8cff', OUT = '#fbbf24', EIG = '#5eead4';

  const canvas = el('eigen') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  // the plane on the left, the two graphs on the right
  const O = { x: 290, y: 310 };
  const UNIT = 92;
  const GT = { x: 620, y: 70, w: 340, h: 220 }; // turn against direction
  const GS = { x: 620, y: 380, w: 340, h: 150 }; // stretch against direction
  const toPx = (x: number, y: number) => ({ px: O.x + x * UNIT, py: O.y - y * UNIT });

  // A_t = (1−t)·I + t·A shares A's eigenvectors, so the eigen-lines stay put while the fan swings.
  const At = () => {
    const t = state.t;
    return { a: 1 - t + t * M.a, b: t * M.b, c: t * M.c, d: 1 - t + t * M.d };
  };
  const apply = (x: number, y: number) => {
    const A = At();
    return { x: A.a * x + A.b * y, y: A.c * x + A.d * y };
  };
  /** How far a direction is turned, folded onto (−90°, 90°] so a flip counts as no turn. */
  function turnOf(th: number) {
    const vx = Math.cos(th), vy = Math.sin(th);
    const w = apply(vx, vy);
    const mag = Math.hypot(w.x, w.y);
    if (mag < 1e-9) return { turn: 0, stretch: 0, signed: 1 };
    let ang = (Math.atan2(vx * w.y - vy * w.x, vx * w.x + vy * w.y) * 180) / Math.PI;
    const signed = Math.abs(ang) > 90 ? -1 : 1;
    if (ang > 90) ang -= 180;
    if (ang < -90) ang += 180;
    return { turn: ang, stretch: mag, signed };
  }

  type Eig = { l: number; th: number };
  /** Real eigen-directions of the full A, as angles in [0, π). */
  function eigen(): Eig[] {
    const tr = M.a + M.d, det = M.a * M.d - M.b * M.c;
    const disc = (tr * tr) / 4 - det;
    if (disc < -1e-9) return [];
    const s = Math.sqrt(Math.max(0, disc));
    const ls = [tr / 2 + s, tr / 2 - s];
    const dirFor = (l: number) => {
      let x: number, y: number;
      if (Math.abs(M.b) > 1e-9) { x = M.b; y = l - M.a; }
      else if (Math.abs(M.c) > 1e-9) { x = l - M.d; y = M.c; }
      else if (Math.abs(M.a - l) < 1e-9) { x = 1; y = 0; }
      else { x = 0; y = 1; }
      let th = Math.atan2(y, x);
      if (th < 0) th += Math.PI;
      if (th >= Math.PI - 1e-9) th -= Math.PI;
      return th;
    };
    const out: Eig[] = [{ l: ls[0], th: dirFor(ls[0]) }];
    if (Math.abs(ls[0] - ls[1]) > 1e-6) out.push({ l: ls[1], th: dirFor(ls[1]) });
    return out;
  }

  function drawPlane(eigs: Eig[]) {
    const R = 2.6;
    ctx.strokeStyle = ink(0.07);
    ctx.lineWidth = 1;
    for (let i = -3; i <= 3; i++) {
      const a = toPx(i, -R), b = toPx(i, R), c = toPx(-R, i), e = toPx(R, i);
      ctx.beginPath(); ctx.moveTo(a.px, a.py); ctx.lineTo(b.px, b.py); ctx.moveTo(c.px, c.py); ctx.lineTo(e.px, e.py); ctx.stroke();
    }
    ctx.strokeStyle = ink(0.2);
    const ax0 = toPx(-R, 0), ax1 = toPx(R, 0), ay0 = toPx(0, -R), ay1 = toPx(0, R);
    ctx.beginPath(); ctx.moveTo(ax0.px, ax0.py); ctx.lineTo(ax1.px, ax1.py); ctx.moveTo(ay0.px, ay0.py); ctx.lineTo(ay1.px, ay1.py); ctx.stroke();

    if (state.showgrid) {
      ctx.strokeStyle = ink(0.3);
      ctx.setLineDash([4, 5]);
      ctx.beginPath(); ctx.arc(O.x, O.y, UNIT, 0, Math.PI * 2); ctx.stroke();
      ctx.setLineDash([]);
      ctx.strokeStyle = 'rgba(251,191,36,0.45)';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      for (let i = 0; i <= 160; i++) {
        const q = apply(Math.cos((i / 160) * Math.PI * 2), Math.sin((i / 160) * Math.PI * 2));
        const p = toPx(q.x, q.y);
        i === 0 ? ctx.moveTo(p.px, p.py) : ctx.lineTo(p.px, p.py);
      }
      ctx.stroke();
    }

    // the eigen-lines, through the origin
    for (const eg of eigs) {
      const vx = Math.cos(eg.th), vy = Math.sin(eg.th);
      const p1 = toPx(vx * R, vy * R), p2 = toPx(-vx * R, -vy * R);
      ctx.strokeStyle = 'rgba(94,234,212,0.8)';
      ctx.lineWidth = 2.2;
      ctx.beginPath(); ctx.moveTo(p1.px, p1.py); ctx.lineTo(p2.px, p2.py); ctx.stroke();
      // the label sits at the far end of the line, away from where Av usually points
      const lp = toPx(-vx * 2.45, -vy * 2.45);
      label(`λ = ${eg.l.toFixed(2)}`, lp.px + (vx >= 0 ? -8 : 8), lp.py + 12, 1, vx >= 0 ? 'right' : 'left', 11, EIG);
    }

    // the fan: every direction going in, and where it lands
    if (state.fan) {
      const N = 36;
      for (let k = 0; k < N; k++) {
        const th = (k / N) * Math.PI * 2;
        const vx = Math.cos(th), vy = Math.sin(th);
        const w = apply(vx, vy);
        const p = toPx(vx, vy), q = toPx(w.x, w.y);
        ctx.strokeStyle = 'rgba(124,140,255,0.22)';
        ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(O.x, O.y); ctx.lineTo(p.px, p.py); ctx.stroke();
        ctx.strokeStyle = ink(0.16);
        ctx.beginPath(); ctx.moveTo(p.px, p.py); ctx.lineTo(q.px, q.py); ctx.stroke();
        ctx.fillStyle = 'rgba(251,191,36,0.75)';
        ctx.beginPath(); ctx.arc(q.px, q.py, 2.6, 0, Math.PI * 2); ctx.fill();
      }
    }
  }

  function drawGraphs(eigs: Eig[], turn: number, stretch: number) {
    const N = 180;
    const xs = (deg: number) => GT.x + (deg / 180) * GT.w;
    // turn against direction
    label('how far each direction is turned', GT.x, GT.y - 26, 0.5, 'left', 11.5);
    label('zero means not turned: an eigenvector', GT.x, GT.y - 10, 0.32, 'left', 11.5);
    ctx.strokeStyle = ink(0.12);
    ctx.lineWidth = 1;
    ctx.strokeRect(GT.x, GT.y, GT.w, GT.h);
    const yT = (deg: number) => GT.y + GT.h / 2 - (deg / 90) * (GT.h / 2);
    ctx.strokeStyle = ink(0.3);
    ctx.beginPath(); ctx.moveTo(GT.x, yT(0)); ctx.lineTo(GT.x + GT.w, yT(0)); ctx.stroke();
    label('+90°', GT.x - 6, GT.y + 4, 0.35, 'right', 11);
    label('0°', GT.x - 6, yT(0) + 4, 0.35, 'right', 11);
    label('−90°', GT.x - 6, GT.y + GT.h + 4, 0.35, 'right', 11);
    for (const eg of eigs) {
      const x = xs((eg.th * 180) / Math.PI);
      ctx.strokeStyle = 'rgba(94,234,212,0.35)';
      ctx.setLineDash([3, 4]);
      ctx.beginPath(); ctx.moveTo(x, GT.y); ctx.lineTo(x, GS.y + GS.h); ctx.stroke();
      ctx.setLineDash([]);
    }
    ctx.strokeStyle = OUT;
    ctx.lineWidth = 2;
    ctx.beginPath();
    let pen = false;
    for (let i = 0; i <= N; i++) {
      const deg = (i / N) * 180;
      const r = turnOf((deg * Math.PI) / 180);
      const y = yT(r.turn);
      // the fold from +90 to −90 is one point, not a line across the graph
      if (pen && i > 0 && Math.abs(r.turn - turnOf(((deg - 180 / N) * Math.PI) / 180).turn) > 120) { ctx.stroke(); ctx.beginPath(); pen = false; }
      pen ? ctx.lineTo(xs(deg), y) : ctx.moveTo(xs(deg), y);
      pen = true;
    }
    ctx.stroke();
    for (const eg of eigs) {
      ctx.fillStyle = EIG;
      ctx.beginPath(); ctx.arc(xs((eg.th * 180) / Math.PI), yT(0), 5, 0, Math.PI * 2); ctx.fill();
    }

    // stretch against direction
    label('how much each direction is stretched', GS.x, GS.y - 26, 0.5, 'left', 11.5);
    label('at a zero crossing, this is the eigenvalue', GS.x, GS.y - 10, 0.32, 'left', 11.5);
    let smax = 1;
    for (let i = 0; i <= N; i++) smax = Math.max(smax, turnOf((i / N) * Math.PI).stretch);
    for (const eg of eigs) smax = Math.max(smax, Math.abs(eg.l));
    smax *= 1.15;
    const yS = (s: number) => GS.y + GS.h - (s / smax) * GS.h;
    ctx.strokeStyle = ink(0.12);
    ctx.lineWidth = 1;
    ctx.strokeRect(GS.x, GS.y, GS.w, GS.h);
    ctx.strokeStyle = ink(0.22);
    ctx.setLineDash([2, 4]);
    ctx.beginPath(); ctx.moveTo(GS.x, yS(1)); ctx.lineTo(GS.x + GS.w, yS(1)); ctx.stroke();
    ctx.setLineDash([]);
    label('×1', GS.x - 6, yS(1) + 4, 0.35, 'right', 11);
    label(`×${smax.toFixed(1)}`, GS.x - 6, GS.y + 4, 0.35, 'right', 11);
    ctx.strokeStyle = OUT;
    ctx.lineWidth = 2;
    ctx.beginPath();
    for (let i = 0; i <= N; i++) {
      const deg = (i / N) * 180;
      const y = yS(turnOf((deg * Math.PI) / 180).stretch);
      i ? ctx.lineTo(xs(deg), y) : ctx.moveTo(xs(deg), y);
    }
    ctx.stroke();
    for (const eg of eigs) {
      const lt = Math.abs(1 - state.t + state.t * eg.l);
      ctx.fillStyle = EIG;
      ctx.beginPath(); ctx.arc(xs((eg.th * 180) / Math.PI), yS(lt), 5, 0, Math.PI * 2); ctx.fill();
      label(`|λ| = ${Math.abs(eg.l).toFixed(2)}`, xs((eg.th * 180) / Math.PI) + 8, yS(lt) - 8, 0.9, 'left', 11.5, EIG);
    }
    for (const deg of [0, 45, 90, 135, 180]) label(`${deg}°`, xs(deg), GS.y + GS.h + 16, 0.35, 'center', 11);

    // the direction currently chosen, on both graphs
    const cur = ((state.theta * 180) / Math.PI) % 180;
    const x = xs(cur);
    ctx.strokeStyle = IN;
    ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(x, GT.y); ctx.lineTo(x, GS.y + GS.h); ctx.stroke();
    ctx.fillStyle = IN;
    ctx.beginPath(); ctx.arc(x, yT(turn), 5, 0, Math.PI * 2); ctx.fill();
    ctx.beginPath(); ctx.arc(x, yS(stretch), 5, 0, Math.PI * 2); ctx.fill();
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    const eigs = eigen();
    drawPlane(eigs);

    const vx = Math.cos(state.theta), vy = Math.sin(state.theta);
    const av = apply(vx, vy);
    const { turn, stretch, signed } = turnOf(state.theta);
    const aligned = stretch > 1e-6 && Math.abs(turn) < 1.5;

    // the turn, as an arc between v and Av
    if (!aligned && stretch > 1e-6) {
      const a0 = -state.theta, a1 = -Math.atan2(av.y, av.x);
      ctx.strokeStyle = 'rgba(251,191,36,0.6)';
      ctx.lineWidth = 2;
      let d = a1 - a0;
      while (d > Math.PI) d -= 2 * Math.PI;
      while (d < -Math.PI) d += 2 * Math.PI;
      ctx.beginPath(); ctx.arc(O.x, O.y, UNIT * 0.55, a0, a0 + d, d < 0); ctx.stroke();
    }
    const p = toPx(av.x, av.y), q = toPx(vx, vy);
    ctx.lineWidth = 3;
    ctx.strokeStyle = ctx.fillStyle = OUT;
    arrow(ctx, O.x, O.y, p.px, p.py, 11);
    ctx.strokeStyle = ctx.fillStyle = IN;
    arrow(ctx, O.x, O.y, q.px, q.py, 11);
    label('v', q.px + 10 * vx + 4, q.py - 10 * vy + 4, 1, 'center', 13, IN);
    if (stretch > 0.05) {
      const n = Math.hypot(av.x, av.y);
      label('Av', p.px + (14 * av.x) / n + 6, p.py - (14 * av.y) / n + 4, 1, 'center', 13, OUT);
    }
    if (aligned) {
      ctx.strokeStyle = EIG;
      ctx.lineWidth = 2.5;
      ctx.beginPath(); ctx.arc(p.px, p.py, 15, 0, Math.PI * 2); ctx.stroke();
    }

    drawGraphs(eigs, turn, stretch);

    const eigText = eigs.length ? eigs.map((e) => e.l.toFixed(2)).join(', ') : 'complex';
    const lam = signed * stretch;
    setEq({
      rule: [['A\\mathbf v', OUT], '=', ['\\lambda\\,\\mathbf v', aligned ? EIG : IN], '\\quad\\text{only for the eigenvectors } \\mathbf v'],
      live: [
        `\\lambda = ${eigs.length ? eigs.map((e) => e.l.toFixed(2)).join(',\\;') : '\\text{complex}'}`,
        [`\\quad |A\\mathbf v| = ${stretch.toFixed(3)}\\,|\\mathbf v|`, OUT],
        [`\\quad \\text{turned } ${Math.abs(turn).toFixed(1)}^{\\circ}`, aligned ? EIG : IN],
      ],
    });
    setResult({
      value: `${Math.abs(turn).toFixed(1)}°`,
      colour: aligned ? EIG : undefined,
      status: aligned
        ? `An eigenvector: Av = λv with λ = ${lam.toFixed(2)}${lam < 0 ? ', flipped straight back along its own line' : ''}`
        : `Av is ${stretch.toFixed(2)} times as long as v, and turned ${Math.abs(turn).toFixed(1)}° off its line`,
      note: eigs.length
        ? state.t < 0.999
          ? `Only ${(state.t * 100).toFixed(0)}% of A is applied, and still the teal directions do not move: A_t shares A's eigenvectors.`
          : `Almost every direction is turned. The curve on the right crosses zero ${eigs.length === 1 ? 'once, so there is one eigen-direction' : 'twice, at the two eigen-directions'}, and the stretch there is λ = ${eigText}.`
        : 'The turn never reaches zero: this matrix turns every real direction, so it has no real eigenvectors and its eigenvalues are complex.',
    });
    setRows({ 'r-eig': eigText, 'r-turn': `${Math.abs(turn).toFixed(1)}°`, 'r-stretch': stretch.toFixed(3) });
  }

  const sync = matrix(M, ['a', 'b', 'c', 'd'], () => draw());
  segmented('presets', (m) => {
    const [a, b, c, d] = m.split(',').map(Number);
    Object.assign(M, { a, b, c, d });
    sync();
    draw();
  });
  const setTh = slider('th', (v) => { state.theta = (v * Math.PI) / 180; draw(); }, (v) => `${Math.round(v)}°`);
  const setT = slider('t', (v) => { state.animating = false; state.t = v / 100; draw(); }, (v) => (v <= 0 ? 'identity' : v >= 100 ? 'all of it' : `${v}%`));
  check('fan', (on) => { state.fan = on; draw(); });
  check('showgrid', (on) => { state.showgrid = on; draw(); });
  el('run').addEventListener('click', () => { state.t = 0; setT(0); state.animating = true; });
  el('snap').addEventListener('click', () => {
    const eigs = eigen();
    if (!eigs.length) return;
    const cur = state.theta % Math.PI;
    // the next eigen-direction clockwise of the current one, wrapping round
    const ahead = eigs.map((e) => e.th).filter((th) => th > cur + 1e-3).sort((p, q) => p - q);
    const th = ahead.length ? ahead[0] : Math.min(...eigs.map((e) => e.th));
    state.theta = th;
    setTh(Math.round((th * 180) / Math.PI));
    draw();
  });

  let last = performance.now();
  function loop(now: number) {
    const dt = Math.min(0.05, Math.max(0, (now - last) / 1000));
    last = now;
    if (state.animating) {
      state.t = Math.min(1, state.t + dt * 0.55);
      setT(Math.round(state.t * 100));
      if (state.t >= 1) state.animating = false;
      draw();
    }
    requestAnimationFrame(loop);
  }
  requestAnimationFrame(loop);

  let dragging = false;
  const local = (e: PointerEvent) => {
    const rect = canvas.getBoundingClientRect();
    return { x: ((e.clientX - rect.left) / rect.width) * W, y: ((e.clientY - rect.top) / rect.height) * H };
  };
  function aim(p: { x: number; y: number }) {
    let deg = (Math.atan2(O.y - p.y, p.x - O.x) * 180) / Math.PI;
    if (deg < 0) deg += 180;
    state.theta = (deg * Math.PI) / 180;
    setTh(Math.round(deg));
    draw();
  }
  function pickOnGraph(p: { x: number; y: number }) {
    const deg = Math.max(0, Math.min(180, ((p.x - GT.x) / GT.w) * 180));
    state.theta = (deg * Math.PI) / 180;
    setTh(Math.round(deg));
    draw();
  }
  canvas.addEventListener('pointerdown', (e) => {
    const p = local(e);
    dragging = true;
    canvas.setPointerCapture(e.pointerId);
    p.x > GT.x - 20 ? pickOnGraph(p) : aim(p);
  });
  canvas.addEventListener('pointermove', (e) => {
    if (!dragging) return;
    const p = local(e);
    p.x > GT.x - 20 ? pickOnGraph(p) : aim(p);
  });
  const stop = () => (dragging = false);
  canvas.addEventListener('pointerup', stop);
  canvas.addEventListener('pointercancel', stop);

  draw();
</script>

<style>
  #eigen {
    cursor: grab;
    touch-action: none;
  }
  #eigen:active {
    cursor: grabbing;
  }
</style>
