---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Matrix from '../../../components/sim/Matrix.astro';
import Checks from '../../../components/sim/Checks.astro';
import Transport from '../../../components/sim/Transport.astro';
import Actions from '../../../components/sim/Actions.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="linear-algebra"
  title="Eigenvectors & Eigenvalues"
  description="A matrix knocks almost every vector off its own line. Aim v anywhere and see whether Av stays on the dashed line through v: where it does, v is an eigenvector, and how far it stretches is the eigenvalue."
  shortcuts={['animate', 'reset', 'fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="eigen"
          width="1000"
          height="600"
          role="img"
          aria-label="A vector v, the dashed line through it, and its image Av, with the eigen-lines of the matrix drawn through the origin."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'v and the line through it', color: '#7c8cff' },
          { label: 'Av, where A sends it', color: '#fbbf24' },
          { label: 'eigen-lines: A keeps them in place', color: '#5eead4' },
        ]}
        hint="Drag anywhere to aim v"
      />
      <Result label="How far Av is off v's line" />
    </div>

    <div class="sim-panel">
      <Matrix
        label="Matrix A"
        view
        entries={[
          { id: 'a', label: 'a', value: 1.5 },
          { id: 'b', label: 'b', value: 0.8 },
          { id: 'c', label: 'c', value: 0.4 },
          { id: 'd', label: 'd', value: 1.1 },
        ]}
      />
      <Seg
        id="presets"
        label="Presets"
        attr="m"
        options={[
          { value: '1.5,0.8,0.4,1.1', label: 'Generic' },
          { value: '2,1,1,2', label: 'Symmetric' },
          { value: '2,0,0,0.5', label: 'Diagonal' },
          { value: '1,1,2,0', label: 'Flip' },
          { value: '1,1,0,1', label: 'Shear' },
          { value: '0,-1,1,0', label: 'Rotate' },
        ]}
      />
      <Slider id="th" label="Direction of v" min={0} max={180} value={60} display="60°" />
      <Actions>
        <button type="button" class="btn" id="snap">Snap to an eigenvector</button>
        <button type="button" class="btn ghost" id="power">Replace v by Av</button>
      </Actions>
      <Slider id="t" label="Sweep I → A" min={0} max={100} value={100} display="1.00" />
      <Transport animate="Animate I → A" />
      <Seg
        id="zoom"
        label="View"
        attr="z"
        options={[
          { value: 'fit', label: 'Fit to the picture' },
          { value: 'wide', label: 'Wide' },
        ]}
      />
      <Checks
        label="Show"
        items={[
          { id: 'fan', label: 'Where A sends every direction' },
          { id: 'circle', label: 'The unit circle and its image', checked: true },
        ]}
      />
      <Readout
        title="Values"
        rows={[
          { id: 'r-eig', label: 'eigenvalues λ' },
          { id: 'r-dir', label: 'eigen-directions' },
          { id: 'r-turn', label: 'turn of v' },
          { id: 'r-stretch', label: '|Av| / |v|' },
          { id: 'r-trdet', label: 'trace, det' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Aim v around the circle. Av almost always lands <b>off</b> the dashed line
      through v. Where it lands on it, nothing turned: <b>Av = λv</b>, and v is
      an eigenvector. <Try id="snap" />
    </li>
    <li>
      λ is how much v is stretched along its line. On <b>Flip</b> one λ is
      negative: Av stays on the line but points the other way. <Try id="flip" label="Flip" />
    </li>
    <li>
      <b>Shear</b> keeps only one line, and <b>Rotate</b> keeps none: every
      direction gets turned, so there is no real eigenvector. <Try id="shear" label="Shear" /> <Try id="rot" label="Rotate" />
    </li>
    <li>
      Press <b>Replace v by Av</b> a few times. Whatever v you start from, it
      swings onto the eigen-line with the biggest |λ|. That is how
      <a href="/simulations/machine-learning/pca">PCA</a> finds its first
      component. <Try id="power" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk, arrow } from '../../../lib/draw';
  import { el, segmented, slider, matrix, check, result, readout, tries } from '../../../lib/panel';

  // The whole question is one picture: does Av stay on the line through v?
  type Mat = { a: number; b: number; c: number; d: number };
  const HOME: Mat = { a: 1.5, b: 0.8, c: 0.4, d: 1.1 };
  const A: Mat = { ...HOME };
  const view = { theta: (60 * Math.PI) / 180, t: 1, fan: false, circle: true, zoom: 'fit' };
  const IN = '#7c8cff', OUT = '#fbbf24', EIG = '#5eead4', HOT = '#f9736a';

  const canvas = el('eigen') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink } = stageInk(canvas);
  const { label, textWidth } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();

  const PLANE = { x: 0, y: 0, w: W, h: H };
  let O = { x: PLANE.w / 2, y: H / 2 };
  let UNIT = 100;
  const toPx = (x: number, y: number) => ({ px: O.x + x * UNIT, py: O.y - y * UNIT });

  // A_t = (1−t)·I + t·A has A's eigenvectors, so the eigen-lines hold still while the sweep runs.
  const At = (): Mat => {
    const t = view.t;
    return { a: 1 - t + t * A.a, b: t * A.b, c: t * A.c, d: 1 - t + t * A.d };
  };
  const apply = (m: Mat, x: number, y: number) => ({ x: m.a * x + m.b * y, y: m.c * x + m.d * y });
  const tr = (m: Mat) => m.a + m.d;
  const det = (m: Mat) => m.a * m.d - m.b * m.c;
  const deg = (r: number) => (r * 180) / Math.PI;

  /** How far a direction is turned, folded onto (−90°, 90°] so a flip counts as no turn. */
  function turnOf(m: Mat, th: number) {
    const vx = Math.cos(th), vy = Math.sin(th);
    const w = apply(m, vx, vy);
    const mag = Math.hypot(w.x, w.y);
    if (mag < 1e-9) return { turn: 0, stretch: 0, signed: 1 };
    let ang = deg(Math.atan2(vx * w.y - vy * w.x, vx * w.x + vy * w.y));
    const signed = Math.abs(ang) > 90 ? -1 : 1;
    if (ang > 90) ang -= 180;
    if (ang < -90) ang += 180;
    return { turn: ang, stretch: mag, signed };
  }

  type Eig = { l: number; th: number };
  /** Real eigen-directions of m, as angles in [0, π). */
  function eigen(m: Mat): Eig[] {
    const h = tr(m) / 2, disc = h * h - det(m);
    if (disc < -1e-9) return [];
    const s = Math.sqrt(Math.max(0, disc));
    const ls = [h + s, h - s];
    const dirFor = (l: number) => {
      let x: number, y: number;
      if (Math.abs(m.b) > 1e-9) { x = m.b; y = l - m.a; }
      else if (Math.abs(m.c) > 1e-9) { x = l - m.d; y = m.c; }
      else if (Math.abs(m.a - l) < 1e-9) { x = 1; y = 0; }
      else { x = 0; y = 1; }
      let th = Math.atan2(y, x);
      if (th < 0) th += Math.PI;
      if (th >= Math.PI - 1e-9) th -= Math.PI;
      return th;
    };
    const out: Eig[] = [{ l: ls[0], th: dirFor(ls[0]) }];
    if (Math.abs(ls[0] - ls[1]) > 1e-6) out.push({ l: ls[1], th: dirFor(ls[1]) });
    return out;
  }

  /** The longest stretch A gives any unit vector: its largest singular value. */
  function sigmaMax(m: Mat) {
    const S = m.a * m.a + m.b * m.b + m.c * m.c + m.d * m.d, D = det(m);
    return Math.sqrt((S + Math.sqrt(Math.max(0, S * S - 4 * D * D))) / 2);
  }
  /**
   * Zoom so the unit circle and its image both fit the plane. The sweep is a
   * straight blend from I to A, so its two ends bound every frame between.
   */
  function fit() {
    O = { x: PLANE.w / 2, y: H / 2 };
    if (view.zoom === 'wide') { UNIT = 46; return; }
    const R = Math.max(1, sigmaMax(A));
    UNIT = Math.max(36, Math.min(130, (H / 2 - 50) / R));
  }

  // --- labels: measured boxes, each one nudged to the nearest free spot --------
  type Box = { x0: number; y0: number; x1: number; y1: number };
  const taken: Box[] = [];
  const segs: number[][] = [];
  const layoutReset = () => { taken.length = 0; segs.length = 0; };
  const blockLine = (x1: number, y1: number, x2: number, y2: number) => { segs.push([x1, y1, x2, y2]); };
  const blockDot = (x: number, y: number, r: number) => { taken.push({ x0: x - r, y0: y - r, x1: x + r, y1: y + r }); };
  /** Does the segment cross the box? (Liang–Barsky clipping.) */
  function crosses(s: number[], b: Box) {
    const [x1, y1, x2, y2] = s;
    const dx = x2 - x1, dy = y2 - y1;
    const p = [-dx, dx, -dy, dy], q = [x1 - b.x0, b.x1 - x1, y1 - b.y0, b.y1 - y1];
    let t0 = 0, t1 = 1;
    for (let i = 0; i < 4; i++) {
      if (p[i] === 0) { if (q[i] < 0) return false; continue; }
      const r = q[i] / p[i];
      if (p[i] < 0) { if (r > t1) return false; if (r > t0) t0 = r; }
      else { if (r < t0) return false; if (r < t1) t1 = r; }
    }
    return true;
  }
  const overlap = (a: Box, b: Box) =>
    Math.max(0, Math.min(a.x1, b.x1) - Math.max(a.x0, b.x0)) * Math.max(0, Math.min(a.y1, b.y1) - Math.max(a.y0, b.y0));
  /**
   * Draw `text` just beyond (ax, ay) in the direction `prefer` (radians, screen
   * axes), swinging round and stepping out until the box crosses no line and
   * no other label, and stays inside `area`.
   */
  function place(text: string, size: number, colour: string, ax: number, ay: number, prefer = -Math.PI / 4, gap = 7, area: Box = { x0: 0, y0: 0, x1: W, y1: H }) {
    const w = textWidth(text, size) + 6, h = size * 1.42 + 4;
    const cands: [number, number][] = [];
    for (const step of [0, 1, 2, 3, 5, 7, 10, 14, 19]) {
      for (let k = 0; k < 12; k++) {
        const an = prefer + (k % 2 ? 1 : -1) * Math.ceil(k / 2) * (Math.PI / 6);
        const c = Math.cos(an), s = Math.sin(an);
        const edge = Math.min(Math.abs(c) > 1e-6 ? w / 2 / Math.abs(c) : 1e9, Math.abs(s) > 1e-6 ? h / 2 / Math.abs(s) : 1e9);
        const d = gap + step * 9 + edge;
        cands.push([ax + c * d, ay + s * d]);
      }
    }
    let best = cands[0], bestCost = Infinity;
    cands.forEach(([cx, cy], i) => {
      const b = { x0: cx - w / 2, y0: cy - h / 2, x1: cx + w / 2, y1: cy + h / 2 };
      let cost = i * 0.6;
      if (b.x0 < area.x0 + 2 || b.y0 < area.y0 + 2 || b.x1 > area.x1 - 2 || b.y1 > area.y1 - 2) cost += 1e5;
      for (const s of segs) if (crosses(s, b)) cost += 1000;
      for (const t of taken) cost += overlap(b, t) * 30;
      if (cost < bestCost) { bestCost = cost; best = [cx, cy]; }
    });
    const [cx, cy] = best;
    taken.push({ x0: cx - w / 2, y0: cy - h / 2, x1: cx + w / 2, y1: cy + h / 2 });
    label(text, cx, cy + size * 1.42 * 0.34, 1, 'center', size, colour);
  }
  const PLANE_BOX: Box = { x0: PLANE.x, y0: PLANE.y, x1: PLANE.x + PLANE.w, y1: PLANE.y + PLANE.h };

  // --- the plane ----------------------------------------------------------------
  function drawPlane(m: Mat, eigs: Eig[]) {
    ctx.save();
    ctx.beginPath(); ctx.rect(PLANE.x, PLANE.y, PLANE.w, PLANE.h); ctx.clip();
    const R = Math.ceil(Math.hypot(PLANE.w, PLANE.h) / UNIT);
    ctx.strokeStyle = ink(0.06);
    ctx.lineWidth = 1;
    ctx.beginPath();
    for (let i = -R; i <= R; i++) {
      const a = toPx(i, -R), b = toPx(i, R), c = toPx(-R, i), e = toPx(R, i);
      ctx.moveTo(a.px, a.py); ctx.lineTo(b.px, b.py); ctx.moveTo(c.px, c.py); ctx.lineTo(e.px, e.py);
    }
    ctx.stroke();
    ctx.strokeStyle = ink(0.18);
    ctx.beginPath(); ctx.moveTo(PLANE.x, O.y); ctx.lineTo(PLANE.x + PLANE.w, O.y); ctx.moveTo(O.x, 0); ctx.lineTo(O.x, H); ctx.stroke();

    if (view.circle) {
      ctx.strokeStyle = ink(0.3);
      ctx.setLineDash([4, 5]);
      ctx.beginPath(); ctx.arc(O.x, O.y, UNIT, 0, Math.PI * 2); ctx.stroke();
      ctx.setLineDash([]);
      ctx.strokeStyle = 'rgba(251,191,36,0.4)';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      for (let i = 0; i <= 160; i++) {
        const q = apply(m, Math.cos((i / 160) * Math.PI * 2), Math.sin((i / 160) * Math.PI * 2));
        const p = toPx(q.x, q.y);
        i === 0 ? ctx.moveTo(p.px, p.py) : ctx.lineTo(p.px, p.py);
      }
      ctx.stroke();
    }

    // the eigen-lines, through the origin and out to the edge
    for (const eg of eigs) {
      const vx = Math.cos(eg.th), vy = Math.sin(eg.th);
      const p1 = toPx(vx * R, vy * R), p2 = toPx(-vx * R, -vy * R);
      ctx.strokeStyle = 'rgba(94,234,212,0.55)';
      ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(p1.px, p1.py); ctx.lineTo(p2.px, p2.py); ctx.stroke();
      blockLine(p1.px, p1.py, p2.px, p2.py);
    }

    // every direction at once: a short trail from v's tip to where A sends it
    if (view.fan) {
      const N = 32;
      for (let k = 0; k < N; k++) {
        const th = (k / N) * Math.PI * 2;
        const vx = Math.cos(th), vy = Math.sin(th);
        const w = apply(m, vx, vy);
        const p = toPx(vx, vy), q = toPx(w.x, w.y);
        ctx.strokeStyle = ink(0.16);
        ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(p.px, p.py); ctx.lineTo(q.px, q.py); ctx.stroke();
        ctx.fillStyle = 'rgba(124,140,255,0.5)';
        ctx.beginPath(); ctx.arc(p.px, p.py, 2, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = 'rgba(251,191,36,0.7)';
        ctx.beginPath(); ctx.arc(q.px, q.py, 2.4, 0, Math.PI * 2); ctx.fill();
      }
    }

    // v's own line: the only place Av is allowed to land if v is an eigenvector
    const vx = Math.cos(view.theta), vy = Math.sin(view.theta);
    const l1 = toPx(vx * R, vy * R), l2 = toPx(-vx * R, -vy * R);
    ctx.strokeStyle = 'rgba(124,140,255,0.55)';
    ctx.lineWidth = 1.3;
    ctx.setLineDash([6, 6]);
    ctx.beginPath(); ctx.moveTo(l1.px, l1.py); ctx.lineTo(l2.px, l2.py); ctx.stroke();
    ctx.setLineDash([]);
    blockLine(l1.px, l1.py, l2.px, l2.py);
    ctx.restore();
  }

  function drawVectors(m: Mat, aligned: boolean, stretch: number) {
    const vx = Math.cos(view.theta), vy = Math.sin(view.theta);
    const av = apply(m, vx, vy);
    // how far Av leans off v's line: a perpendicular from Av's tip down to it
    const along = av.x * vx + av.y * vy;
    const foot = toPx(along * vx, along * vy), p = toPx(av.x, av.y), q = toPx(vx, vy);
    if (!aligned && stretch > 1e-6) {
      ctx.strokeStyle = HOT;
      ctx.lineWidth = 1.6;
      ctx.setLineDash([3, 3]);
      ctx.beginPath(); ctx.moveTo(p.px, p.py); ctx.lineTo(foot.px, foot.py); ctx.stroke();
      ctx.setLineDash([]);
      blockLine(p.px, p.py, foot.px, foot.py);
    }
    ctx.lineWidth = 3;
    ctx.strokeStyle = ctx.fillStyle = aligned ? EIG : OUT;
    arrow(ctx, O.x, O.y, p.px, p.py, 11);
    ctx.strokeStyle = ctx.fillStyle = IN;
    arrow(ctx, O.x, O.y, q.px, q.py, 11);
    for (const t of [p, q]) { blockLine(O.x, O.y, t.px, t.py); blockDot(t.px, t.py, 7); }
    if (aligned) {
      ctx.strokeStyle = EIG;
      ctx.lineWidth = 2.5;
      ctx.beginPath(); ctx.arc(p.px, p.py, 14, 0, Math.PI * 2); ctx.stroke();
      blockDot(p.px, p.py, 16);
    }
    blockDot(O.x, O.y, 8);
    const away = (t: { px: number; py: number }) => Math.atan2(t.py - O.y, t.px - O.x);
    place('v', 15, IN, q.px, q.py, away(q), 6, PLANE_BOX);
    if (stretch > 0.05) place(aligned ? 'Av = λv' : 'Av', 14, aligned ? EIG : OUT, p.px, p.py, away(p), 6, PLANE_BOX);
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    layoutReset();
    const m = At();
    const eigs = eigen(m);
    const { turn, stretch, signed } = turnOf(m, view.theta);
    const aligned = stretch > 1e-6 && Math.abs(turn) < 1;

    drawPlane(m, eigs);
    drawVectors(m, aligned, stretch);
    for (const eg of eigs) {
      // name each eigen-line near the edge of the plane, on the side v is not
      const R = Math.min(O.x - 30, H / 2 - 30) / UNIT;
      const s = Math.cos(eg.th - view.theta) > 0 ? -1 : 1;
      const e = toPx(s * Math.cos(eg.th) * R, s * Math.sin(eg.th) * R);
      place(`λ = ${eg.l.toFixed(2).replace('-', '−')}`, 12, EIG, e.px, e.py, Math.atan2(e.py - O.y, e.px - O.x) + Math.PI / 2, 6, PLANE_BOX);
    }

    (['a', 'b', 'c', 'd'] as const).forEach((k) => (el('m-' + k).textContent = m[k].toFixed(2)));
    const lam = signed * stretch;
    const eigText = eigs.length ? eigs.map((e) => e.l.toFixed(2)).join(', ') : 'complex';
    setEq({
      rule: [['A\\mathbf v', OUT], '=', ['\\lambda\\,\\mathbf v', EIG], '\\quad\\text{Av stays on the line through v}'],
      live: [
        eigs.length ? [`\\lambda = ${eigs.map((e) => e.l.toFixed(2)).join(',\\;')}`, EIG] : ['\\lambda \\notin \\mathbb R', HOT],
        [`\\quad |A\\mathbf v| = ${stretch.toFixed(2)}\\,|\\mathbf v|`, OUT],
        [`\\quad \\text{off its line by } ${Math.abs(turn).toFixed(1)}^{\\circ}`, aligned ? EIG : IN],
      ],
    });
    setResult({
      value: `${Math.abs(turn).toFixed(1)}°`,
      colour: aligned ? EIG : undefined,
      status: aligned
        ? `v is an eigenvector: Av = ${lam.toFixed(2)} v${lam < 0 ? ', flipped back along its own line' : ''}`
        : `Av has left v's line: it is ${Math.abs(turn).toFixed(1)}° off it and ${stretch.toFixed(2)} times as long`,
      note: !eigs.length
        ? 'A turns every real direction, so no v can stay on its line: the eigenvalues are complex.'
        : view.t < 0.999
          ? `Only part of A is applied, and the teal lines still hold still: (1−t)I + tA has the same eigenvectors as A.`
          : eigs.length === 1
            ? 'Only one line through the origin survives A. Every other direction gets turned.'
            : 'Two lines through the origin survive A. Every other direction gets turned toward one of them.',
    });
    setRows({
      'r-eig': eigText,
      'r-dir': eigs.length ? eigs.map((e) => `${deg(e.th).toFixed(1)}°`).join(', ') : '—',
      'r-turn': `${Math.abs(turn).toFixed(1)}°`,
      'r-stretch': stretch.toFixed(3),
      'r-trdet': `${tr(m).toFixed(2)}, ${det(m).toFixed(2)}`,
    });
  }

  // --- controls -----------------------------------------------------------------
  let raf = 0;
  /** By hand, an eigen-direction within 2° pulls v onto it, so it can actually be hit. */
  function magnet(th: number) {
    th = ((th % Math.PI) + Math.PI) % Math.PI;
    for (const e of eigen(At())) {
      const d = Math.abs(th - e.th);
      if (Math.min(d, Math.PI - d) < (2 * Math.PI) / 180) return e.th;
    }
    return th;
  }
  const setTh = slider('th', (v) => { cancelAnimationFrame(raf); view.theta = magnet((v * Math.PI) / 180); draw(); }, (v) => `${Math.round(v)}°`);
  const setT = slider('t', (v) => { cancelAnimationFrame(raf); view.t = v / 100; draw(); }, (v) => (v / 100).toFixed(2));
  const aimAt = (th: number) => {
    th = ((th % Math.PI) + Math.PI) % Math.PI;
    view.theta = th;
    setTh(Math.round(deg(th)));
  };
  const sync = matrix(A, ['a', 'b', 'c', 'd'], () => { presets.clear(); fit(); draw(); });
  function preset(m: string) {
    cancelAnimationFrame(raf);
    const [a, b, c, d] = m.split(',').map(Number);
    Object.assign(A, { a, b, c, d });
    view.t = 1;
    setT(100);
    sync();
    fit();
    draw();
  }
  const presets = segmented('presets', preset);
  segmented('zoom', (z) => { view.zoom = z; fit(); draw(); });
  check('fan', (on) => { view.fan = on; draw(); });
  check('circle', (on) => { view.circle = on; draw(); });

  /** Glide v to a new direction, the short way round the half-circle. */
  function glide(to: number) {
    cancelAnimationFrame(raf);
    const from = view.theta;
    let d = (((to - from) % Math.PI) + Math.PI) % Math.PI;
    if (d > Math.PI / 2) d -= Math.PI;
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min(1, (now - start) / 450);
      const e = p * p * (3 - 2 * p);
      aimAt(from + d * e);
      draw();
      if (p < 1) raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);
  }
  el('snap').addEventListener('click', () => {
    const eigs = eigen(At());
    if (!eigs.length) return;
    const cur = view.theta % Math.PI;
    // the next eigen-direction counter-clockwise of the current one, wrapping round
    const ahead = eigs.map((e) => e.th).filter((th) => th > cur + 1e-3).sort((p, q) => p - q);
    glide(ahead.length ? ahead[0] : Math.min(...eigs.map((e) => e.th)));
  });
  el('power').addEventListener('click', () => {
    const w = apply(At(), Math.cos(view.theta), Math.sin(view.theta));
    if (Math.hypot(w.x, w.y) > 1e-9) glide(Math.atan2(w.y, w.x));
  });
  el('run').addEventListener('click', () => {
    cancelAnimationFrame(raf);
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min(1, (now - start) / 1600);
      view.t = p;
      setT(Math.round(p * 100));
      draw();
      if (p < 1) raf = requestAnimationFrame(tick);
    };
    view.t = 0;
    raf = requestAnimationFrame(tick);
  });
  el('reset').addEventListener('click', () => {
    presets.select('1.5,0.8,0.4,1.1');
    preset('1.5,0.8,0.4,1.1');
    aimAt((60 * Math.PI) / 180);
    draw();
  });

  const pick = (m: string, th?: number) => {
    presets.select(m);
    preset(m);
    if (th !== undefined) aimAt((th * Math.PI) / 180);
    draw();
  };
  tries({
    snap: () => { pick('1.5,0.8,0.4,1.1', 60); el('snap').click(); },
    rot: () => pick('0,-1,1,0', 30),
    flip: () => { pick('1,1,2,0', 60); el('snap').click(); },
    shear: () => pick('1,1,0,1', 50),
    power: () => {
      pick('1.5,0.8,0.4,1.1', 150);
      // three steps, each once the last glide has landed
      let n = 0;
      const go = () => { el('power').click(); if (++n < 3) setTimeout(go, 650); };
      setTimeout(go, 250);
    },
  });

  // --- dragging -----------------------------------------------------------------
  let dragging = false;
  const local = (e: PointerEvent) => {
    const r = canvas.getBoundingClientRect();
    return { x: ((e.clientX - r.left) / r.width) * W, y: ((e.clientY - r.top) / r.height) * H };
  };
  function point(p: { x: number; y: number }) {
    cancelAnimationFrame(raf);
    if (Math.hypot(p.x - O.x, p.y - O.y) > 4) aimAt(magnet(Math.atan2(O.y - p.y, p.x - O.x)));
    draw();
  }
  canvas.addEventListener('pointerdown', (e) => {
    const p = local(e);
    dragging = true;
    canvas.setPointerCapture(e.pointerId);
    point(p);
  });
  canvas.addEventListener('pointermove', (e) => { if (dragging) point(local(e)); });
  const stop = () => (dragging = false);
  canvas.addEventListener('pointerup', stop);
  canvas.addEventListener('pointercancel', stop);

  fit();
  draw();
</script>

<style>
  #eigen {
    cursor: grab;
    touch-action: none;
  }
  #eigen:active {
    cursor: grabbing;
  }
</style>
