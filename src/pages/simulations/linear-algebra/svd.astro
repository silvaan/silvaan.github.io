---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Matrix from '../../../components/sim/Matrix.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="linear-algebra"
  title="Singular Value Decomposition"
  description="Every matrix is three clean steps: rotate, stretch along the axes, rotate again. Watch the unit circle become an ellipse one step at a time."
  shortcuts={['animate', 'fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="svd"
          width="1000"
          height="600"
          role="img"
          aria-label="The unit circle part-way through being rotated, stretched and rotated again into the ellipse a matrix makes of it."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'v₁ → σ₁u₁', color: '#7c8cff' },
          { label: 'v₂ → σ₂u₂', color: '#f59e0b' },
          { label: 'image of the unit circle', color: '#5eead4' },
          { label: 'the unit circle', color: 'rgba(232,233,236,0.35)' },
        ]}
      />
      <Result label="Singular values σ<sub>1</sub>, σ<sub>2</sub>" />
    </div>

    <div class="sim-panel">
      <Matrix
        label="Matrix A"
        view
        min={-2.5}
        max={2.5}
        entries={[
          { id: 'a', label: 'a', value: 1.2 },
          { id: 'b', label: 'b', value: 0.8 },
          { id: 'c', label: 'c', value: 0.3 },
          { id: 'd', label: 'd', value: 1.1 },
        ]}
      />
      <Slider id="t" label="Stage of A = UΣVᵀ" min={0} max={300} value={300} display="whole" hint={['circle', 'Vᵀ · Σ · U']} />
      <Transport animate="Animate the three steps" reset={false} />
      <Seg
        id="presets"
        label="Presets"
        attr="m"
        options={[
          { value: '1.2,0.8,0.3,1.1', label: 'Generic' },
          { value: '2,0,0,0.6', label: 'Diagonal' },
          { value: '1,1,1,1', label: 'Rank 1' },
          { value: '0.8,-1.4,1.4,0.8', label: 'Rotation+' },
          { value: '1,0.6,0.8,-1.2', label: 'Flip' },
        ]}
      />
      <Readout rows={[{ id: 'r-cond', label: 'condition σ<sub>1</sub>/σ<sub>2</sub>' }, { id: 'r-det', label: 'det A = ±σ<sub>1</sub>σ<sub>2</sub>' }, { id: 'r-rank', label: 'rank' }]} />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Animate the stages: the circle <b>rotates</b> (Vᵀ), <b>stretches along the
      axes</b> by σ₁ and σ₂ (Σ), then <b>rotates</b> again (U), and lands
      exactly on A's ellipse. <Try id="steps" label="Animate" />
    </li>
    <li>
      On <b>Flip</b>, det A &lt; 0 and no pair of rotations can do it: one of U, V
      must be a reflection. Here the Σ step carries it as a minus sign on σ₂, so
      the circle flattens and comes back mirrored. <Try id="flip" label="Animate" />
    </li>
    <li>
      On <b>Rank 1</b>, σ₂ = 0: the ellipse is a segment and |det A| = σ₁σ₂ = 0.
      The condition number σ₁/σ₂ blows up, which is what makes a matrix hard
      to invert. <Try id="rank" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk } from '../../../lib/draw';
  import { el, segmented, slider, matrix, result, readout, tries } from '../../../lib/panel';

  const M = { a: 1.2, b: 0.8, c: 0.3, d: 1.1 };
  const view = { t: 3 }; // 0..3 across the three stages
  const V1 = '#7c8cff', V2 = '#f59e0b', TEAL = '#5eead4';

  const canvas = el('svd') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();
  const O = { x: W / 2, y: H / 2 };
  const U = 105;
  const toPx = (x: number, y: number) => ({ px: O.x + x * U, py: O.y - y * U });

  // 2×2 SVD via the symmetric eigenproblem of AᵀA
  function svd() {
    const { a, b, c, d } = M;
    const e = a * a + c * c, f = a * b + c * d, g = b * b + d * d;
    const theta = 0.5 * Math.atan2(2 * f, e - g);
    const cv = Math.cos(theta), sv = Math.sin(theta);
    const v1 = { x: cv, y: sv }, v2 = { x: -sv, y: cv };
    const Av1 = { x: a * v1.x + b * v1.y, y: c * v1.x + d * v1.y };
    const Av2 = { x: a * v2.x + b * v2.y, y: c * v2.x + d * v2.y };
    let s1 = Math.hypot(Av1.x, Av1.y), s2 = Math.hypot(Av2.x, Av2.y);
    const u1 = s1 > 1e-9 ? { x: Av1.x / s1, y: Av1.y / s1 } : { x: 1, y: 0 };
    const u2 = s2 > 1e-9 ? { x: Av2.x / s2, y: Av2.y / s2 } : { x: -u1.y, y: u1.x };
    let Vv1 = v1, U1 = u1;
    if (s2 > s1) { [s1, s2] = [s2, s1]; Vv1 = v2; U1 = u2; }
    // Keep both frames proper rotations: V₂ and U₂ are V₁ and U₁ turned a
    // quarter. Then AV₂ = ±σ₂U₂, and the sign is det A's. A true SVD keeps
    // σ₂ ≥ 0 and puts that reflection in U; here Σ carries it as sg₂ = ±σ₂,
    // so the three steps always multiply back to exactly A.
    const Vv2 = { x: -Vv1.y, y: Vv1.x }, U2 = { x: -U1.y, y: U1.x };
    const AV2 = { x: a * Vv2.x + b * Vv2.y, y: c * Vv2.x + d * Vv2.y };
    const sg2 = AV2.x * U2.x + AV2.y * U2.y;
    return { s1, s2, sg2, flip: sg2 < -1e-9, V1: Vv1, V2: Vv2, U1, U2 };
  }

  // Stage 0-1: rotate by Vᵀ. 1-2: scale by Σ along the axes. 2-3: rotate by U.
  function transformPoint(x: number, y: number, s: ReturnType<typeof svd>, t: number) {
    const angV = Math.atan2(s.V1.y, s.V1.x);
    const angU = Math.atan2(s.U1.y, s.U1.x);
    const r1 = -angV * Math.max(0, Math.min(1, t));
    let px = x * Math.cos(r1) - y * Math.sin(r1), py = x * Math.sin(r1) + y * Math.cos(r1);
    const f2 = Math.max(0, Math.min(1, t - 1));
    px *= 1 + (s.s1 - 1) * f2;
    py *= 1 + (s.sg2 - 1) * f2;
    const r3 = angU * Math.max(0, Math.min(1, t - 2));
    return { x: px * Math.cos(r3) - py * Math.sin(r3), y: px * Math.sin(r3) + py * Math.cos(r3) };
  }

  function arrow(x: number, y: number, color: string, text: string) {
    const p = toPx(x, y);
    ctx.strokeStyle = color;
    ctx.fillStyle = color;
    ctx.lineWidth = 3;
    ctx.beginPath(); ctx.moveTo(O.x, O.y); ctx.lineTo(p.px, p.py); ctx.stroke();
    const ang = Math.atan2(p.py - O.y, p.px - O.x);
    ctx.beginPath();
    ctx.moveTo(p.px, p.py);
    ctx.lineTo(p.px - 12 * Math.cos(ang - 0.4), p.py - 12 * Math.sin(ang - 0.4));
    ctx.lineTo(p.px - 12 * Math.cos(ang + 0.4), p.py - 12 * Math.sin(ang + 0.4));
    ctx.closePath();
    ctx.fill();
    label(text, p.px + 7, p.py - 7, 1, 'left', 13, color);
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    const s = svd();
    const t = view.t;

    ctx.strokeStyle = ink(0.08);
    ctx.lineWidth = 1;
    for (let i = -4; i <= 4; i++) {
      const a = toPx(i, -3), b = toPx(i, 3), c = toPx(-4, i), e = toPx(4, i);
      ctx.beginPath(); ctx.moveTo(a.px, a.py); ctx.lineTo(b.px, b.py); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(c.px, c.py); ctx.lineTo(e.px, e.py); ctx.stroke();
    }
    ctx.strokeStyle = ink(0.25);
    ctx.setLineDash([4, 5]);
    ctx.beginPath(); ctx.arc(O.x, O.y, U, 0, Math.PI * 2); ctx.stroke();
    ctx.setLineDash([]);

    ctx.fillStyle = 'rgba(94,234,212,0.12)';
    ctx.strokeStyle = TEAL;
    ctx.lineWidth = 2.4;
    ctx.beginPath();
    for (let i = 0; i <= 96; i++) {
      const a = (i / 96) * Math.PI * 2;
      const q = transformPoint(Math.cos(a), Math.sin(a), s, t);
      const p = toPx(q.x, q.y);
      i === 0 ? ctx.moveTo(p.px, p.py) : ctx.lineTo(p.px, p.py);
    }
    ctx.closePath();
    ctx.fill();
    ctx.stroke();

    const t1 = transformPoint(s.V1.x, s.V1.y, s, t);
    const t2 = transformPoint(s.V2.x, s.V2.y, s, t);
    arrow(t1.x, t1.y, V1, t < 0.5 ? 'v_1' : 'σ_1');
    arrow(t2.x, t2.y, V2, t < 0.5 ? 'v_2' : s.flip ? '−σ_2' : 'σ_2');

    // which step is under way
    const stage = t <= 1 ? 'Vᵀ: rotate the circle so v₁, v₂ land on the axes' : t <= 2 ? (s.flip ? 'Σ: stretch by σ₁ and −σ₂, the minus sign is the reflection' : 'Σ: stretch along the axes by σ₁ and σ₂') : 'U: rotate into place';
    label(stage, 30, 30, 0.5, 'left', 11);
    for (const [k, name] of [[0, 'circle'], [1, 'Vᵀ'], [2, 'Σ'], [3, 'U']] as [number, string][]) {
      const x = W - 240 + k * 70;
      ctx.fillStyle = t >= k - 0.01 ? TEAL : ink(0.2);
      ctx.beginPath(); ctx.arc(x, 30, 4, 0, Math.PI * 2); ctx.fill();
      label(name, x, 48, t >= k - 0.01 ? 0.9 : 0.35, 'center', 11.5);
      if (k < 3) {
        ctx.strokeStyle = t >= k + 0.99 ? TEAL : ink(0.2);
        ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.moveTo(x + 6, 30); ctx.lineTo(x + 64, 30); ctx.stroke();
      }
    }

    const det = M.a * M.d - M.b * M.c;
    const cond = s.s2 > 1e-4 ? (s.s1 / s.s2).toFixed(2) : '∞';
    const rank = s.s2 > 1e-3 ? '2' : s.s1 > 1e-3 ? '1' : '0';
    (['a', 'b', 'c', 'd'] as const).forEach((k) => (el('m-' + k).textContent = M[k].toFixed(2)));
    setEq({
      rule: ['A = ', ['U', V1], ['\\,\\Sigma\\,', V2], ['V^{\\mathsf T}', TEAL]],
      live: [[`\\sigma_1 = ${s.s1.toFixed(2)}`, V1], [`\\quad\\sigma_2 = ${s.s2.toFixed(2)}`, V2], `\\quad\\det A = \\pm\\sigma_1\\sigma_2 = ${det.toFixed(3)}`],
    });
    setResult({
      value: `${s.s1.toFixed(2)}, ${s.s2.toFixed(2)}`,
      colour: TEAL,
      status: `condition σ₁/σ₂ = ${cond} · det = ${det < 0 ? '−' : '+'}σ₁σ₂ = ${det.toFixed(3)} · rank ${rank}`,
      note: rank !== '2'
        ? 'σ₂ has collapsed: the ellipse is flat, a whole direction has been thrown away, and the matrix cannot be inverted.'
        : s.flip
          ? 'det A < 0, so A turns the plane over. Two rotations cannot do that: one of U, V has to be a reflection, shown here as the minus sign in the stretch.'
          : 'Every matrix is a rotation, then a stretch along two perpendicular axes, then another rotation. The stretch factors are the singular values.',
    });
    setRows({ 'r-cond': cond, 'r-det': det.toFixed(3), 'r-rank': rank });
  }

  const stageName = (t: number) => (t >= 2.99 ? 'whole' : t <= 1 ? `Vᵀ ${(t * 100).toFixed(0)}%` : t <= 2 ? `Σ ${((t - 1) * 100).toFixed(0)}%` : `U ${((t - 2) * 100).toFixed(0)}%`);
  const setT = slider('t', (v) => { cancelAnimationFrame(raf); view.t = v / 100; draw(); }, (v) => stageName(v / 100));
  const sync = matrix(M, ['a', 'b', 'c', 'd'], () => draw());
  let raf = 0;
  function preset(m: string) {
    cancelAnimationFrame(raf);
    const [a, b, c, d] = m.split(',').map(Number);
    Object.assign(M, { a, b, c, d });
    sync();
    view.t = 3;
    setT(300);
    draw();
  }
  const presets = segmented('presets', preset);
  const pick = (m: string) => { presets.select(m); preset(m); };
  tries({
    steps: () => { pick('1.2,0.8,0.3,1.1'); el('run').click(); },
    flip: () => { pick('1,0.6,0.8,-1.2'); el('run').click(); },
    rank: () => pick('1,1,1,1'),
  });
  el('run').addEventListener('click', () => {
    cancelAnimationFrame(raf);
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min(1, (now - start) / 2600);
      view.t = p * 3;
      setT(Math.round(view.t * 100));
      draw();
      if (p < 1) raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);
  });

  draw();
</script>
