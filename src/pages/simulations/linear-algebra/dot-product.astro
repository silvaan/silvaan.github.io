---
import SimLayout from '../../../layouts/SimLayout.astro';
---

<SimLayout
  areaSlug="linear-algebra"
  title="The Dot Product"
  description="Drop one vector perpendicularly onto the other and you get a shadow. The dot product is the length of the second one times that shadow, and nothing else. Drag the arrows and watch the number follow the picture."
>
  <div class="sim two" id="wrap">
    <div class="sim-stage">
      <canvas id="dp" class="dp-canvas" width="1000" height="660"></canvas>
    </div>

    <div class="sim-panel">
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <button class="btn ghost" id="reset">Reset</button>
      </div>

      <div class="control">
        <div class="seg" id="dims">
          <button data-d="2" class="active">2D</button>
          <button data-d="3">3D</button>
        </div>
      </div>

      <div class="control">
        <label>Try one</label>
        <div class="seg" id="preset">
          <button data-p="tilted" class="active">Tilted</button>
          <button data-p="perp">Right angles</button>
          <button data-p="same">Same way</button>
          <button data-p="back">Opposed</button>
        </div>
      </div>

      <div class="control">
        <label>vector a</label>
        <div class="vec">
          <div><span>x <b id="axval">2.0</b></span><input type="range" id="ax" min="-30" max="30" step="1" value="20" /></div>
          <div><span>y <b id="ayval">0.6</b></span><input type="range" id="ay" min="-30" max="30" step="1" value="6" /></div>
          <div class="zrow"><span>z <b id="azval">0.0</b></span><input type="range" id="az" min="-30" max="30" step="1" value="0" /></div>
        </div>
      </div>

      <div class="control">
        <label>vector b</label>
        <div class="vec">
          <div><span>x <b id="bxval">0.8</b></span><input type="range" id="bx" min="-30" max="30" step="1" value="8" /></div>
          <div><span>y <b id="byval">1.8</b></span><input type="range" id="by" min="-30" max="30" step="1" value="18" /></div>
          <div class="zrow"><span>z <b id="bzval">0.0</b></span><input type="range" id="bz" min="-30" max="30" step="1" value="0" /></div>
        </div>
      </div>

      <label class="check zrow"><input type="checkbox" id="spin" /> Spin the scene</label>

      <div class="readout">
        <div class="row"><span>a · b</span><b id="r1">—</b></div>
        <div class="row"><span>shadow of b on a</span><b id="r2">—</b></div>
        <div class="row"><span>length of a</span><b id="r3">—</b></div>
        <div class="row"><span>length of b</span><b id="r4">—</b></div>
        <div class="row"><span>angle between</span><b id="r5">—</b></div>
        <div class="row"><span>from the components</span><b id="r6">—</b></div>
      </div>

      <p style="font-size:.82rem;color:var(--text-faint);margin:0;line-height:1.5">
        Drag either arrowhead, or drag the empty space to move the scene around.
        In 3D the arrows are set with the sliders, dragging orbits and
        shift-dragging pans.
      </p>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Drag the head of <b>b</b> in a circle around the origin, keeping it the
      same length. Its shadow on <b>a</b> grows, shrinks, vanishes and comes back
      negative, and the number follows it exactly. <b>The dot product only ever
      measures that shadow.</b>
    </li>
    <li>
      Stop where the shadow disappears. The arrows are at right angles, the
      number is zero, and it got there smoothly from both sides. Perpendicular
      means "nothing of one goes along the other", which is the one fact this
      operation exists to detect.
    </li>
    <li>
      Push b past that point. The foot of the perpendicular lands on the far side
      of the origin, so the shadow counts as negative and so does the product.
      The sign is not a convention, it is which way the shadow fell.
    </li>
    <li>
      The shaded rectangle is the product made visible: one side is the shadow,
      the other is the length of a, so its <b>area is a · b</b>. Lengthen a and
      the rectangle grows in one direction only; swing b and it grows in the
      other.
    </li>
    <li>
      Make a twice as long. Every bit of the answer doubles, while the angle and
      the shadow direction do not move at all. The dot product knows nothing
      except two lengths and how much they agree.
    </li>
    <li>
      Set a to length 1. Now a · b <b>is</b> the shadow, with no scaling left
      over. That is why "how much of this lies in that direction" is always
      written as a dot product against a unit vector.
    </li>
    <li>
      The panel computes the same number a second way, straight from the
      components: a<sub>x</sub>b<sub>x</sub> + a<sub>y</sub>b<sub>y</sub>. It
      always matches the picture, which is the whole reason the algebraic
      formula is worth trusting. Switch to <b>3D</b> and one more term joins in,
      and nothing else about the picture changes.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText, subHtml } from '../../../lib/sim';
  import { equationBar } from '../../../lib/equation';

  // ---------------------------------------------------------------------------
  // One picture: b dropped perpendicularly onto the line through a, the shadow
  // that lands there, and the rectangle whose area is the product. The number is
  // also computed from the components, and the two always agree.
  // ---------------------------------------------------------------------------

  type Vec = { x: number; y: number; z: number };
  const add = (p: Vec, q: Vec): Vec => ({ x: p.x + q.x, y: p.y + q.y, z: p.z + q.z });
  const sub = (p: Vec, q: Vec): Vec => ({ x: p.x - q.x, y: p.y - q.y, z: p.z - q.z });
  const mul = (p: Vec, s: number): Vec => ({ x: p.x * s, y: p.y * s, z: p.z * s });
  const dot = (p: Vec, q: Vec) => p.x * q.x + p.y * q.y + p.z * q.z;
  const len = (p: Vec) => Math.hypot(p.x, p.y, p.z);
  const unit = (p: Vec): Vec => (len(p) > 1e-9 ? mul(p, 1 / len(p)) : { x: 1, y: 0, z: 0 });
  const O: Vec = { x: 0, y: 0, z: 0 };

  // Looking straight down z: x runs right, y runs up, nothing foreshortened, so
  // the flat view is an ordinary 2D drawing made by the same 3D code.
  const FLAT_CAM = { yaw: 0, pitch: -Math.PI / 2 };
  const CAM_3D = { yaw: 0.7, pitch: -0.36 };
  const kept = { az: 0.4, bz: 1.2, ...CAM_3D };

  const state = {
    a: { x: 2, y: 0.6, z: 0 } as Vec,
    b: { x: 0.8, y: 1.8, z: 0 } as Vec,
    spin: false,
    zoom: 1,
    pan: { x: 0, y: 0 }, // where the reader has dragged the scene to
    yaw: FLAT_CAM.yaw,
    pitch: FLAT_CAM.pitch,
    dim: 2 as 2 | 3,
  };
  const is3D = () => state.dim === 3;
  const AX = ['x', 'y', 'z'] as const;
  const comp = (v: Vec, i: number) => (i === 0 ? v.x : i === 1 ? v.y : v.z);

  // --- canvas ------------------------------------------------------------------

  const canvas = document.getElementById('dp') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const cssVar = (n: string) => getComputedStyle(canvas).getPropertyValue(n).trim();
  const inkRGB = () => cssVar('--stage-ink') || '232,233,236';
  const inkA = (al: number) => `rgba(${inkRGB()},${al})`;
  const bg = () => cssVar('--stage-bg') || '#0d0e12';
  const { label } = makeText(ctx, inkA);

  const A_COL = '#f59e0b'; // a
  const B_COL = '#a78bfa'; // b
  const POS = '#34d399';   // a positive shadow, and the product
  const NEG = '#f9736a';   // a negative one

  const SCENE = { x: 20, y: 44, w: 960, h: 480 };
  const METER = { x: 20, y: 568, w: 960, h: 64 };

  function rr(x: number, y: number, w: number, h: number, r: number) {
    const rad = Math.min(r, Math.abs(w) / 2, Math.abs(h) / 2);
    ctx.beginPath();
    ctx.moveTo(x + rad, y);
    ctx.lineTo(x + w - rad, y);
    ctx.quadraticCurveTo(x + w, y, x + w, y + rad);
    ctx.lineTo(x + w, y + h - rad);
    ctx.quadraticCurveTo(x + w, y + h, x + w - rad, y + h);
    ctx.lineTo(x + rad, y + h);
    ctx.quadraticCurveTo(x, y + h, x, y + h - rad);
    ctx.lineTo(x, y + rad);
    ctx.quadraticCurveTo(x, y, x + rad, y);
    ctx.closePath();
  }
  function panel(p: { x: number; y: number; w: number; h: number }, title: string) {
    ctx.strokeStyle = inkA(0.1);
    ctx.lineWidth = 1;
    rr(p.x, p.y, p.w, p.h, 10);
    ctx.stroke();
    label(title, p.x + 2, p.y - 9, 0.5, 'left', 11);
  }

  // --- projection ----------------------------------------------------------------

  const CAM = 15, FOCAL = 11.5;
  const scale = () => (is3D() ? 150 : 124);
  const OX = SCENE.x + SCENE.w * 0.3;
  const OY = SCENE.y + SCENE.h * 0.52;

  function project(p: Vec) {
    const cy = Math.cos(state.yaw), sy = Math.sin(state.yaw);
    const xr = p.x * cy + p.y * sy;
    const yr = -p.x * sy + p.y * cy;
    const cp = Math.cos(state.pitch), sp = Math.sin(state.pitch);
    const depth = p.z * sp + yr * cp + CAM;
    const k = (FOCAL * state.zoom) / Math.max(0.4, depth);
    return {
      x: OX + state.pan.x + xr * k * scale(),
      y: OY + state.pan.y + (-p.z * cp + yr * sp) * k * scale(),
    };
  }
  /** Only needed while flat, where the projection is a plain scaling. */
  function unproject(sx: number, sy: number): Vec {
    const K = ((FOCAL * state.zoom) / CAM) * scale();
    return { x: (sx - OX - state.pan.x) / K, y: (OY + state.pan.y - sy) / K, z: 0 };
  }

  function line3(p: Vec, q: Vec, col: string, lw: number, dash: number[] = []) {
    const u = project(p), v = project(q);
    ctx.strokeStyle = col;
    ctx.lineWidth = lw;
    ctx.setLineDash(dash);
    ctx.beginPath();
    ctx.moveTo(u.x, u.y);
    ctx.lineTo(v.x, v.y);
    ctx.stroke();
    ctx.setLineDash([]);
  }
  function arrow3(p: Vec, q: Vec, col: string, lw = 3, head = 15) {
    const u = project(p), v = project(q);
    const an = Math.atan2(v.y - u.y, v.x - u.x);
    const back = { x: v.x - head * 0.82 * Math.cos(an), y: v.y - head * 0.82 * Math.sin(an) };
    ctx.strokeStyle = col;
    ctx.lineWidth = lw;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(u.x, u.y);
    ctx.lineTo(back.x, back.y);
    ctx.stroke();
    ctx.lineCap = 'butt';
    ctx.fillStyle = col;
    ctx.beginPath();
    ctx.moveTo(v.x, v.y);
    ctx.lineTo(v.x - head * Math.cos(an - 0.34), v.y - head * Math.sin(an - 0.34));
    ctx.lineTo(v.x - head * Math.cos(an + 0.34), v.y - head * Math.sin(an + 0.34));
    ctx.closePath();
    ctx.fill();
    ctx.strokeStyle = bg();
    ctx.lineWidth = 1.2;
    ctx.stroke();
  }
  function poly(pts: Vec[], fill: string, stroke: string) {
    ctx.beginPath();
    pts.forEach((p, i) => {
      const q = project(p);
      if (i === 0) ctx.moveTo(q.x, q.y);
      else ctx.lineTo(q.x, q.y);
    });
    ctx.closePath();
    ctx.fillStyle = fill;
    ctx.fill();
    ctx.strokeStyle = stroke;
    ctx.lineWidth = 1;
    ctx.stroke();
  }

  // --- the geometry the whole sim is about ------------------------------------------

  function geom() {
    const a = state.a, b = state.b;
    const la = len(a), lb = len(b);
    const ahat = unit(a);
    const s = la > 1e-9 ? dot(a, b) / la : 0; // signed length of the shadow
    const foot = mul(ahat, s);
    // in-plane normal, pointing from the line through a towards b
    const off = sub(b, foot);
    let n = len(off) > 1e-6 ? unit(off) : sideways(a);
    return { a, b, la, lb, ahat, s, foot, n, d: dot(a, b) };
  }
  function sideways(v: Vec): Vec {
    const c: Vec = Math.abs(v.z) < 0.9 * len(v)
      ? { x: -v.y, y: v.x, z: 0 }
      : { x: 0, y: -v.z, z: v.y };
    return unit(c);
  }
  function cosTheta() {
    const la = len(state.a), lb = len(state.b);
    if (la < 1e-9 || lb < 1e-9) return 0;
    return Math.max(-1, Math.min(1, dot(state.a, state.b) / (la * lb)));
  }

  // --- the scene ---------------------------------------------------------------------

  function drawGrid() {
    const R = 3;
    for (let i = -R; i <= R; i++) {
      line3({ x: i, y: -R, z: 0 }, { x: i, y: R, z: 0 }, inkA(i === 0 ? 0.13 : 0.055), 1);
      line3({ x: -R, y: i, z: 0 }, { x: R, y: i, z: 0 }, inkA(i === 0 ? 0.13 : 0.055), 1);
    }
    const tx = project({ x: R + 0.22, y: 0, z: 0 });
    const ty = project({ x: 0, y: R + 0.22, z: 0 });
    label('x', tx.x, tx.y + 4, 0.35, 'center', 11);
    label('y', ty.x, ty.y + 4, 0.35, 'center', 11);
    if (is3D()) {
      line3({ x: 0, y: 0, z: -R }, { x: 0, y: 0, z: R }, inkA(0.13), 1);
      const t = project({ x: 0, y: 0, z: R + 0.22 });
      label('z', t.x, t.y + 4, 0.35, 'center', 11);
    }
  }

  function drawScene() {
    panel(SCENE, 'B, DROPPED ONTO THE LINE THROUGH A');
    ctx.save();
    rr(SCENE.x + 1, SCENE.y + 1, SCENE.w - 2, SCENE.h - 2, 10);
    ctx.clip();
    drawGrid();

    const g = geom();
    const pos = g.s >= 0;
    const SH = pos ? POS : NEG;

    // the line the shadow lives on
    line3(mul(g.ahat, -4), mul(g.ahat, 4), inkA(0.14), 1, [5, 5]);

    // the rectangle: shadow along a, height |a|, so its area is the product.
    // Drawn on the far side from b, where there is room.
    if (Math.abs(g.s) > 0.02 && g.la > 0.02) {
      const h = mul(g.n, -g.la);
      poly(
        [O, g.foot, add(g.foot, h), add(O, h)],
        pos ? 'rgba(52,211,153,0.14)' : 'rgba(249,115,106,0.14)',
        pos ? 'rgba(52,211,153,0.45)' : 'rgba(249,115,106,0.45)'
      );
      const mid = project(add(mul(g.foot, 0.5), mul(h, 0.5)));
      label(`area = a · b = ${g.d.toFixed(2)}`, mid.x, mid.y + 4, 0.9, 'center', 13, SH);
      const hm = project(add(mul(h, 0.5), mul(g.ahat, g.s > 0 ? -0.16 : 0.16)));
      label(`|a| = ${g.la.toFixed(2)}`, hm.x, hm.y + 4, 0.55, 'center', 11);
    }

    // three rays showing where b's shadow falls, the last one the real drop line
    for (const f of [0.4, 0.7, 1]) {
      const from = mul(g.b, f);
      const to = add(mul(g.ahat, dot(g.ahat, from)), O);
      line3(from, to, inkA(f === 1 ? 0.4 : 0.16), f === 1 ? 1.4 : 1, [4, 4]);
    }

    // the right angle at the foot, so it is clear the drop is perpendicular
    if (Math.abs(g.s) > 0.12 && len(sub(g.b, g.foot)) > 0.12) {
      const q = 0.17;
      const c1 = add(g.foot, mul(g.ahat, g.s > 0 ? -q : q));
      const c2 = add(g.foot, mul(g.n, q));
      const c3 = add(c1, mul(g.n, q));
      line3(c1, c3, inkA(0.35), 1);
      line3(c3, c2, inkA(0.35), 1);
    }

    // the shadow itself
    if (Math.abs(g.s) > 1e-6) arrow3(O, g.foot, SH, 6, 16);

    arrow3(O, g.a, A_COL, 3.2, 16);
    arrow3(O, g.b, B_COL, 3.2, 16);
    const pa = project(mul(g.a, 1.1)), pb = project(mul(g.b, 1.12));
    label('a', pa.x + 8, pa.y + 6, 0.95, 'left', 16, A_COL);
    label('b', pb.x + 8, pb.y + 6, 0.95, 'left', 16, B_COL);

    // the angle, at the origin
    if (g.la > 0.2 && g.lb > 0.2) {
      const th = (Math.acos(cosTheta()) * 180) / Math.PI;
      const m = project(add(mul(unit(add(g.ahat, unit(g.b))), 0.62), O));
      label(`${th.toFixed(0)}°`, m.x, m.y + 4, 0.6, 'center', 12);
    }

    const pf = project(add(mul(g.foot, 0.5), mul(g.n, 0.18)));
    label(`shadow ${g.s.toFixed(2)}`, pf.x, pf.y, 0.95, 'center', 12, SH);

    ctx.restore();
    label(
      is3D()
        ? 'drag to orbit · shift-drag to pan · scroll to zoom'
        : 'drag an arrowhead, or the space itself · scroll to zoom',
      SCENE.x + SCENE.w - 12,
      SCENE.y + 22,
      0.4,
      'right',
      11
    );
  }

  // --- the number, on a line from opposed to aligned ----------------------------------

  function drawMeter() {
    const g = geom();
    panel(METER, 'THE NUMBER, BETWEEN THE TWO EXTREMES IT CAN REACH');
    const cx = METER.x + METER.w / 2, y = METER.y + 34;
    const half = METER.w / 2 - 124; // room for the two end labels
    const span = Math.max(1e-6, g.la * g.lb);

    ctx.strokeStyle = inkA(0.16);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(cx - half, y);
    ctx.lineTo(cx + half, y);
    ctx.stroke();
    for (const s of [-1, 0, 1]) {
      ctx.strokeStyle = inkA(s === 0 ? 0.3 : 0.16);
      ctx.beginPath();
      ctx.moveTo(cx + s * half, y - 7);
      ctx.lineTo(cx + s * half, y + 7);
      ctx.stroke();
    }
    const frac = Math.max(-1, Math.min(1, g.d / span));
    const px = cx + frac * half;
    ctx.fillStyle = g.d >= 0 ? 'rgba(52,211,153,0.5)' : 'rgba(249,115,106,0.5)';
    ctx.fillRect(Math.min(cx, px), y - 5, Math.abs(px - cx), 10);
    ctx.fillStyle = g.d >= 0 ? POS : NEG;
    ctx.beginPath();
    ctx.arc(px, y, 6, 0, Math.PI * 2);
    ctx.fill();

    label(`-|a||b| = ${(-span).toFixed(2)}`, cx - half - 10, y + 4, 0.4, 'right', 11);
    label(`|a||b| = ${span.toFixed(2)}`, cx + half + 10, y + 4, 0.4, 'left', 11);
    label('opposed', cx - half, y + 24, 0.35, 'center', 10);
    label('at right angles', cx, y + 24, 0.35, 'center', 10);
    label('same direction', cx + half, y + 24, 0.35, 'center', 10);
    label(
      `a · b = ${g.d.toFixed(2)}`,
      px,
      y - 14,
      0.95,
      Math.abs(frac) > 0.75 ? (frac > 0 ? 'right' : 'left') : 'center',
      13,
      g.d >= 0 ? POS : NEG
    );
  }

  // --- readouts ------------------------------------------------------------------------

  const el = (id: string) => document.getElementById(id) as HTMLElement;
  const setEq = equationBar();

  function updateReadout() {
    const g = geom();
    const idx = [0, 1, 2].slice(0, state.dim);
    const symbolic = idx.map((i) => `a_${AX[i]}b_${AX[i]}`).join('+');
    const numeric = idx
      .map((i) => (comp(state.a, i) * comp(state.b, i)).toFixed(2))
      .join('+')
      .replaceAll('+-', '-');
    const sum = idx.reduce((s, i) => s + comp(state.a, i) * comp(state.b, i), 0);

    el('r1').textContent = g.d.toFixed(3);
    el('r2').textContent = g.s.toFixed(3);
    el('r3').textContent = g.la.toFixed(3);
    el('r4').textContent = g.lb.toFixed(3);
    el('r5').textContent = `${((Math.acos(cosTheta()) * 180) / Math.PI).toFixed(1)}°`;
    el('r6').innerHTML = subHtml(`${numeric} = ${sum.toFixed(3)}`);

    const A = `\\textcolor{${A_COL}}{\\mathbf a}`, Bv = `\\textcolor{${B_COL}}{\\mathbf b}`;
    setEq([
      [`${A}\\cdot${Bv} = |\\mathbf a|\\,|\\mathbf b|\\cos\\theta = ${symbolic}`],
      [
        [`${A}\\cdot${Bv} = ${g.d.toFixed(2)}`, g.d >= 0 ? POS : NEG],
        `\\quad = ${g.la.toFixed(2)}\\times${g.s.toFixed(2)}`,
        `\\quad = ${numeric}`,
      ],
      ['the length of a, times how much of b lies along it'],
    ]);
  }

  // --- loop ------------------------------------------------------------------------------

  function draw() {
    ctx.clearRect(0, 0, W, H);
    drawScene();
    drawMeter();
    updateReadout();
  }

  let last = performance.now();
  function frame(now: number) {
    const dt = Math.min(0.05, Math.max(0, (now - last) / 1000));
    last = now;
    if (state.spin && is3D()) state.yaw += dt * 0.28;
    draw();
    requestAnimationFrame(frame);
  }

  // --- controls ---------------------------------------------------------------------------

  const sliders: [string, 'a' | 'b', 'x' | 'y' | 'z'][] = [
    ['ax', 'a', 'x'], ['ay', 'a', 'y'], ['az', 'a', 'z'],
    ['bx', 'b', 'x'], ['by', 'b', 'y'], ['bz', 'b', 'z'],
  ];
  function syncSliders() {
    for (const [id, v, c] of sliders) {
      (el(id) as HTMLInputElement).value = String(Math.round(state[v][c] * 10));
      el(id + 'val').textContent = state[v][c].toFixed(1);
    }
  }
  for (const [id, v, c] of sliders) {
    const inp = el(id) as HTMLInputElement;
    inp.addEventListener('input', () => {
      state[v][c] = +inp.value / 10;
      el(id + 'val').textContent = state[v][c].toFixed(1);
      if (c === 'z') kept[v === 'a' ? 'az' : 'bz'] = state[v][c];
    });
  }
  syncSliders();
  (el('spin') as HTMLInputElement).addEventListener('change', (e) => {
    state.spin = (e.target as HTMLInputElement).checked;
  });

  const wrap = document.getElementById('wrap') as HTMLElement;
  function setDim(d: 2 | 3) {
    if (d === state.dim) return;
    if (d === 2) {
      kept.az = state.a.z;
      kept.bz = state.b.z;
      kept.yaw = state.yaw;
      kept.pitch = state.pitch;
      state.a.z = 0;
      state.b.z = 0;
      state.yaw = FLAT_CAM.yaw;
      state.pitch = FLAT_CAM.pitch;
      state.spin = false;
      (el('spin') as HTMLInputElement).checked = false;
    } else {
      state.a.z = kept.az;
      state.b.z = kept.bz;
      state.yaw = kept.yaw;
      state.pitch = kept.pitch;
    }
    state.dim = d;
    canvas.style.cursor = d === 3 ? 'grab' : 'move';
    wrap.classList.toggle('two', d === 2);
    document
      .querySelectorAll('#dims button')
      .forEach((b) => b.classList.toggle('active', (b as HTMLElement).dataset.d === String(d)));
    syncSliders();
  }
  el('dims').addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (btn) setDim(btn.dataset.d === '3' ? 3 : 2);
  });

  const PRESETS: Record<string, [Vec, Vec]> = {
    tilted: [{ x: 2, y: 0.6, z: 0.4 }, { x: 0.8, y: 1.8, z: 1.2 }],
    perp: [{ x: 2, y: 0, z: 0 }, { x: 0, y: 1.8, z: 0.9 }],
    same: [{ x: 1.6, y: 1.2, z: 0.6 }, { x: 2.1, y: 1.6, z: 0.8 }],
    back: [{ x: 2, y: 0.8, z: 0.4 }, { x: -1.6, y: -0.5, z: 0.6 }],
  };
  function applyPreset(name: string) {
    const p = PRESETS[name] ?? PRESETS.tilted;
    state.a = { ...p[0] };
    state.b = { ...p[1] };
    kept.az = state.a.z;
    kept.bz = state.b.z;
    if (!is3D()) {
      state.a.z = 0;
      state.b.z = 0;
    }
    syncSliders();
  }
  el('preset').addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn) return;
    document.querySelectorAll('#preset button').forEach((b) => b.classList.remove('active'));
    btn.classList.add('active');
    applyPreset(btn.dataset.p ?? 'tilted');
  });
  el('reset').addEventListener('click', () => {
    applyPreset('tilted');
    document
      .querySelectorAll('#preset button')
      .forEach((b) => b.classList.toggle('active', (b as HTMLElement).dataset.p === 'tilted'));
    const cam = is3D() ? CAM_3D : FLAT_CAM;
    state.yaw = cam.yaw;
    state.pitch = cam.pitch;
    state.zoom = 1;
    state.pan = { x: 0, y: 0 };
  });

  // --- pointer: drag the arrowheads while flat, orbit while spatial -------------------------

  const mouse = (e: PointerEvent) => {
    const r = canvas.getBoundingClientRect();
    return { x: ((e.clientX - r.left) / r.width) * W, y: ((e.clientY - r.top) / r.height) * H };
  };
  const nearTip = (m: { x: number; y: number }, which: 'a' | 'b') => {
    const p = project(state[which]);
    return Math.hypot(m.x - p.x, m.y - p.y) < 20;
  };

  let drag: 'a' | 'b' | null = null;
  let move: 'orbit' | 'pan' | null = null;
  let lx = 0, ly = 0;

  canvas.addEventListener('pointerdown', (e) => {
    const m = mouse(e);
    drag = null;
    move = null;
    if (is3D()) move = e.shiftKey || e.button === 1 ? 'pan' : 'orbit';
    else {
      drag = nearTip(m, 'b') ? 'b' : nearTip(m, 'a') ? 'a' : null;
      // anywhere that is not an arrowhead drags the scene itself
      if (!drag) move = 'pan';
    }
    lx = e.clientX;
    ly = e.clientY;
    canvas.style.cursor = 'grabbing';
    canvas.setPointerCapture(e.pointerId);
  });
  canvas.addEventListener('pointermove', (e) => {
    const m = mouse(e);
    if (move === 'orbit') {
      state.yaw += (e.clientX - lx) * 0.01;
      state.pitch = Math.max(-1.3, Math.min(1.3, state.pitch + (e.clientY - ly) * 0.008));
      lx = e.clientX;
      ly = e.clientY;
      return;
    }
    if (move === 'pan') {
      // clientX is in CSS pixels and the canvas is usually scaled to fit
      const r = canvas.getBoundingClientRect();
      const lim = { x: SCENE.w * 0.9, y: SCENE.h * 0.9 };
      state.pan.x = Math.max(
        -lim.x,
        Math.min(lim.x, state.pan.x + ((e.clientX - lx) * W) / r.width)
      );
      state.pan.y = Math.max(
        -lim.y,
        Math.min(lim.y, state.pan.y + ((e.clientY - ly) * H) / r.height)
      );
      lx = e.clientX;
      ly = e.clientY;
      return;
    }
    if (drag) {
      const w = unproject(m.x, m.y);
      const snap = (t: number) => Math.max(-3, Math.min(3, Math.round(t * 10) / 10));
      state[drag].x = snap(w.x);
      state[drag].y = snap(w.y);
      syncSliders();
      return;
    }
    canvas.style.cursor = is3D() || nearTip(m, 'a') || nearTip(m, 'b') ? 'grab' : 'move';
  });
  const stop = () => {
    drag = null;
    move = null;
    canvas.style.cursor = is3D() ? 'grab' : 'move';
  };
  canvas.addEventListener('pointerup', stop);
  canvas.addEventListener('pointercancel', stop);
  canvas.addEventListener(
    'wheel',
    (e) => {
      e.preventDefault();
      const m = mouse(e);
      const under = is3D() ? null : unproject(m.x, m.y);
      state.zoom = Math.max(0.4, Math.min(4, state.zoom * Math.exp(-e.deltaY * 0.0016)));
      if (under) {
        // keep whatever was under the pointer exactly where it was
        const now = project(under);
        state.pan.x += m.x - now.x;
        state.pan.y += m.y - now.y;
      }
    },
    { passive: false }
  );

  requestAnimationFrame(frame);
</script>

<style>
  .dp-canvas {
    cursor: move;
    touch-action: none;
  }
  /* flat mode has no third component and nothing to spin */
  .two .zrow {
    display: none;
  }
  .two .vec {
    grid-template-columns: repeat(2, 1fr);
  }
  .vec {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  .vec span {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
    margin-bottom: 4px;
  }
  .vec b {
    color: var(--text);
    font-weight: 500;
  }
  .vec input {
    width: 100%;
    accent-color: var(--accent);
  }
  .check {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .check input {
    accent-color: var(--accent);
  }
</style>
