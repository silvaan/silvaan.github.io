---
import SimLayout from '../../../layouts/SimLayout.astro';
import '../../../styles/vector-lab.css';
---

<SimLayout
  areaSlug="linear-algebra"
  title="Dot Product"
  description="Drop b perpendicularly onto a and you get a shadow. The dot product is the length of a times that shadow, and nothing else. Drag the arrows and watch the number follow the picture."
  shortcuts={['reset', 'fullscreen']}
  standard
>
  <div class="sim vector-lab flat" id="wrap">
    <div class="vector-view">
      <div class="sim-stage">
        <canvas
          id="dp"
          width="1000"
          height="600"
          role="img"
          aria-label="Two vectors, the shadow of b on a, and the rectangle whose area is their dot product."
        ></canvas>
      </div>

      <div class="scene-caption">
        <div class="legend">
          <span class="vector-a">a</span>
          <span class="vector-b">b</span>
          <span class="vector-result" id="legend-shadow">shadow of b on a</span>
        </div>
        <p id="scene-hint">Drag an arrowhead to move it · drag empty space to pan · scroll to zoom</p>
      </div>

      <div class="result-strip">
        <div>
          <span class="section-label">Dot product</span>
          <strong id="result-value">—</strong>
        </div>
        <div>
          <b id="result-status">—</b>
          <p id="result-explanation">—</p>
        </div>
      </div>

      <div class="meter" id="meter" role="img" aria-label="Where a · b sits between −|a||b| and |a||b|">
        <div class="meter-track">
          <span class="meter-fill" id="meter-fill"></span>
          <span class="meter-dot" id="meter-dot"></span>
        </div>
        <div class="meter-labels">
          <span>opposed<b id="meter-min">—</b></span>
          <span>right angles<b>0</b></span>
          <span>same direction<b id="meter-max">—</b></span>
        </div>
      </div>
    </div>

    <div class="sim-panel">
      <div class="control">
        <label class="section-label">View</label>
        <div class="seg" id="dims">
          <button data-d="2" class="active">2D</button>
          <button data-d="3">3D</button>
        </div>
      </div>

      <div class="control">
        <label class="section-label">Scenario</label>
        <div class="seg" id="preset">
          <button data-p="tilted" class="active">Tilted</button>
          <button data-p="perp">Right angles</button>
          <button data-p="same">Same way</button>
          <button data-p="back">Opposed</button>
        </div>
      </div>

      <div class="control vector-control vector-a">
        <label>Vector a</label>
        <div class="vec">
          <div><span>x <b id="axval">2.0</b></span><input aria-label="Vector a, x component" type="range" id="ax" min="-30" max="30" step="1" value="20" /></div>
          <div><span>y <b id="ayval">0.6</b></span><input aria-label="Vector a, y component" type="range" id="ay" min="-30" max="30" step="1" value="6" /></div>
          <div class="only-3d"><span>z <b id="azval">0.0</b></span><input aria-label="Vector a, z component" type="range" id="az" min="-30" max="30" step="1" value="0" /></div>
        </div>
      </div>

      <div class="control vector-control vector-b">
        <label>Vector b</label>
        <div class="vec">
          <div><span>x <b id="bxval">0.8</b></span><input aria-label="Vector b, x component" type="range" id="bx" min="-30" max="30" step="1" value="8" /></div>
          <div><span>y <b id="byval">1.8</b></span><input aria-label="Vector b, y component" type="range" id="by" min="-30" max="30" step="1" value="18" /></div>
          <div class="only-3d"><span>z <b id="bzval">0.0</b></span><input aria-label="Vector b, z component" type="range" id="bz" min="-30" max="30" step="1" value="0" /></div>
        </div>
      </div>

      <div class="control vector-control">
        <label for="angle">Angle between them <b id="angle-value">—</b></label>
        <input id="angle" type="range" min="0" max="180" step="1" value="0" />
        <p class="angle-help">Swings b around, keeping its length.</p>
      </div>

      <label class="check only-3d"><input type="checkbox" id="spin" /> Spin the scene</label>

      <button class="btn ghost" id="reset">Reset</button>

      <details class="numeric-details">
        <summary>Values &amp; calculations</summary>
        <div class="readout">
          <div class="row"><span>length of a</span><b id="r-la">—</b></div>
          <div class="row"><span>length of b</span><b id="r-lb">—</b></div>
          <div class="row"><span>shadow of b on a</span><b id="r-shadow">—</b></div>
          <div class="row"><span>angle between</span><b id="r-angle">—</b></div>
        </div>
      </details>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Drag the head of <b>b</b> in a circle around the origin, keeping it the
      same length. Its shadow on <b>a</b> grows, shrinks, vanishes and comes back
      negative, and the number follows it exactly. <b>The dot product only ever
      measures that shadow.</b>
    </li>
    <li>
      Stop where the shadow disappears. The arrows are at right angles, the
      number is zero, and it got there smoothly from both sides. Perpendicular
      means "nothing of one goes along the other", which is the one fact this
      operation exists to detect.
    </li>
    <li>
      Push b past that point. The foot of the perpendicular lands on the far side
      of the origin, so the shadow counts as negative and so does the product.
      The sign is not a convention, it is which way the shadow fell.
    </li>
    <li>
      The shaded rectangle hanging off a is the product made visible: one side is
      the shadow, the other is the length of a, so its <b>area is |a · b|</b> and
      the shadow's direction supplies the sign. Lengthen a and the rectangle
      grows in one direction only; swing b and it grows in the other.
    </li>
    <li>
      Make a twice as long. Every bit of the answer doubles, while the angle and
      the shadow direction do not move at all. The dot product knows nothing
      except two lengths and how much they agree.
    </li>
    <li>
      Set a to length 1. Now a · b <b>is</b> the shadow, with no scaling left
      over. That is why "how much of this lies in that direction" is always
      written as a dot product against a unit vector.
    </li>
    <li>
      The panel computes the same number a second way, straight from the
      components: a<sub>x</sub>b<sub>x</sub> + a<sub>y</sub>b<sub>y</sub>. It
      always matches the picture, which is the whole reason the algebraic
      formula is worth trusting. Switch to <b>3D</b> and one more term joins in,
      and nothing else about the picture changes.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { equation } from '../../../lib/equation';
  import {
    type Vector3 as Vec,
    O, add, sub, mul, len, unit, dotGeometry, AXIS, comp,
  } from '../../../lib/vector-geometry';
  import {
    COLOR, rgba, LIMIT, FLAT_VIEW, createScene, segmented, vectorSliders, el, degrees,
  } from '../../../lib/vector-scene';

  // ---------------------------------------------------------------------------
  // One picture: b dropped perpendicularly onto the line through a, the shadow
  // that lands there, and the rectangle whose area is the product. The number is
  // also computed from the components, and the two always agree.
  // ---------------------------------------------------------------------------

  const SPATIAL_VIEW = { yaw: 0.7, pitch: -0.36 };
  const PRESETS: Record<string, [Vec, Vec]> = {
    tilted: [{ x: 2, y: 0.6, z: 0.4 }, { x: 0.8, y: 1.8, z: 1.2 }],
    perp: [{ x: 2, y: 0, z: 0 }, { x: 0, y: 1.8, z: 0.9 }],
    same: [{ x: 1.6, y: 1.2, z: 0.6 }, { x: 2.1, y: 1.6, z: 0.8 }],
    back: [{ x: 2, y: 0.8, z: 0.4 }, { x: -1.6, y: -0.5, z: 0.6 }],
  };

  const state = {
    a: { x: 2, y: 0.6, z: 0 } as Vec,
    b: { x: 0.8, y: 1.8, z: 0 } as Vec,
    dim: 2 as 2 | 3,
    spin: false,
  };
  const cam = { ...FLAT_VIEW, zoom: 1, pan: { x: 0, y: 0 } };
  // the z components and the camera, remembered while the view is flat
  const kept = { az: 0.4, bz: 1.2, ...SPATIAL_VIEW };
  const is3D = () => state.dim === 3;

  const canvas = el('dp') as HTMLCanvasElement;
  const W = canvas.width, H = canvas.height;
  const scene = createScene(canvas, cam, {
    origin: () => ({ x: W * 0.42, y: H * 0.5 }),
    scale: () => (is3D() ? 140 : 110),
    redraw: () => draw(),
  });

  // --- the geometry the whole sim is about -----------------------------------

  function sideways(v: Vec): Vec {
    return unit(Math.abs(v.z) < 0.9 * len(v) ? { x: -v.y, y: v.x, z: 0 } : { x: 0, y: -v.z, z: v.y });
  }
  function geom() {
    const g = dotGeometry(state.a, state.b);
    const ahat = unit(state.a);
    const foot = mul(ahat, g.projection);
    const off = sub(state.b, foot);
    // in-plane normal, pointing from the line through a towards b
    const n = len(off) > 1e-6 ? unit(off) : sideways(state.a);
    return { ...g, ahat, foot, n };
  }

  // --- the picture -----------------------------------------------------------

  function draw() {
    const { ctx, inkA } = scene;
    ctx.clearRect(0, 0, W, H);
    scene.grid(is3D());

    const { a, b } = state;
    const g = geom();
    const s = g.projection, d = g.product;
    const SH = d >= 0 ? COLOR.result : COLOR.negative;

    // the line the shadow lives on
    scene.line(mul(g.ahat, -LIMIT * 1.5), mul(g.ahat, LIMIT * 1.5), inkA(0.14), 1, [5, 5]);

    // the rectangle: |a| by the shadow, hung on the far side from b, with the
    // shadow named along its top and the product in the middle when there is room
    if (Math.abs(s) > 1e-6 && g.lengthA > 1e-6) {
      const down = mul(g.n, -g.lengthA);
      scene.poly([O, g.foot, add(g.foot, down), down], rgba(SH, 0.12), rgba(SH, 0.45));
      const roomy = Math.abs(s) > 0.6;
      if (roomy && g.lengthA > 0.5)
        scene.tag(`a · b = ${d.toFixed(2)}`, mul(add(g.foot, down), 0.5), 0, 4, SH, 13, 'center');
      if (roomy && g.lengthA > 0.9)
        scene.tag(`shadow ${s.toFixed(2)}`, add(mul(g.foot, 0.5), mul(g.n, -0.17)), 0, 4, SH, 12, 'center');
    }

    // the perpendicular drop from b, with its right angle
    scene.line(b, g.foot, inkA(0.4), 1.4, [4, 4]);
    if (Math.abs(s) > 0.12 && len(sub(b, g.foot)) > 0.12) {
      const q = 0.17;
      const c1 = add(g.foot, mul(g.ahat, s > 0 ? -q : q));
      const c3 = add(c1, mul(g.n, q));
      scene.line(c1, c3, inkA(0.35));
      scene.line(c3, add(g.foot, mul(g.n, q)), inkA(0.35));
    }

    if (Math.abs(s) > 1e-6) scene.arrow(O, g.foot, SH, 6, 16);
    scene.arrow(O, a, COLOR.a);
    scene.arrow(O, b, COLOR.b);
    scene.tag('a', mul(a, 1.1), 8, 6, COLOR.a, 16);
    scene.tag('b', mul(b, 1.12), 8, 6, COLOR.b, 16);

    // the angle, as an arc at the origin: b = |b| (cos θ â + sin θ n)
    if (g.angle !== null && g.lengthA > 0.3 && g.lengthB > 0.3) {
      const th = (g.angle * Math.PI) / 180;
      const arc = (r: number, t: number): Vec => mul(add(mul(g.ahat, Math.cos(t)), mul(g.n, Math.sin(t))), r);
      ctx.strokeStyle = inkA(0.4);
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (let k = 0; k <= 24; k++) {
        const p = scene.project(arc(0.42, (th * k) / 24));
        k ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y);
      }
      ctx.stroke();
      scene.tag(degrees(g.angle), arc(0.74, th / 2), 0, 4, inkA(0.7), 12, 'center');
    }
  }

  // --- the words and numbers, rebuilt only when the vectors change -----------

  const setEq = equation();
  let lastKey = '';

  function updateReadout() {
    const key = JSON.stringify([state.a, state.b, state.dim]);
    if (key === lastKey) return;
    lastKey = key;

    const { a, b } = state;
    const g = geom();
    const s = g.projection, d = g.product;
    const zero = g.lengthA < 1e-9 || g.lengthB < 1e-9;
    const col = d >= 0 ? COLOR.result : COLOR.negative;

    el('result-value').textContent = d.toFixed(2);
    el('result-value').style.color = col;
    el('legend-shadow').style.setProperty('--vector-color', col);
    el('result-status').textContent = zero
      ? 'Zero vector'
      : d === 0 ? 'Perpendicular' : d > 0 ? 'Leaning the same way' : 'Leaning against each other';
    el('result-explanation').textContent = zero
      ? 'A zero vector has no direction, so the angle is undefined and the product is zero.'
      : d === 0
        ? 'Nothing of b lies along a, so the rectangle has no width.'
        : `|a| × shadow = ${g.lengthA.toFixed(2)} × ${s.toFixed(2)}. The shadow falls ${d > 0 ? 'along' : 'against'} a, and that is where the sign comes from.`;

    const span = g.lengthA * g.lengthB;
    const frac = span > 1e-9 ? Math.max(-1, Math.min(1, d / span)) : 0;
    el('meter').style.setProperty('--meter-color', col);
    el('meter-fill').style.left = `${50 + Math.min(0, frac) * 50}%`;
    el('meter-fill').style.width = `${Math.abs(frac) * 50}%`;
    el('meter-dot').style.left = `${50 + frac * 50}%`;
    el('meter-min').textContent = `−|a||b| = ${(-span).toFixed(2)}`;
    el('meter-max').textContent = `|a||b| = ${span.toFixed(2)}`;

    const angle = el('angle') as HTMLInputElement;
    angle.disabled = g.angle === null;
    if (document.activeElement !== angle) angle.value = String(Math.round(g.angle ?? 0));
    el('angle-value').textContent = degrees(g.angle);
    el('scene-hint').textContent = is3D()
      ? 'Drag to orbit · shift-drag to pan · scroll to zoom · set the vectors with the sliders'
      : 'Drag an arrowhead to move it · drag empty space to pan · scroll to zoom';

    el('r-la').textContent = g.lengthA.toFixed(3);
    el('r-lb').textContent = g.lengthB.toFixed(3);
    el('r-shadow').textContent = s.toFixed(3);
    el('r-angle').textContent = degrees(g.angle);

    const idx = [0, 1, 2].slice(0, state.dim);
    const symbolic = idx.map((i) => `a_${AXIS[i]}b_${AXIS[i]}`).join('+');
    const numeric = idx.map((i) => (comp(a, i) * comp(b, i)).toFixed(2)).join('+').replaceAll('+-', '-');
    const A = `\\textcolor{${COLOR.a}}{\\mathbf a}`, B = `\\textcolor{${COLOR.b}}{\\mathbf b}`;
    setEq({
      rule: [`${A}\\cdot${B} = |\\mathbf a|\\,|\\mathbf b|\\cos\\theta = ${symbolic}`],
      live: [
        [`${A}\\cdot${B} = ${d.toFixed(2)}`, col],
        `\\quad = ${g.lengthA.toFixed(2)}\\times${s.toFixed(2)}`,
        `\\quad = ${numeric}`,
      ],
    });
  }

  // --- loop ------------------------------------------------------------------

  let last = performance.now();
  function frame(now: number) {
    const dt = Math.min(0.05, Math.max(0, (now - last) / 1000));
    last = now;
    if (state.spin && is3D()) cam.yaw += dt * 0.28;
    draw();
    updateReadout();
    requestAnimationFrame(frame);
  }

  // --- controls --------------------------------------------------------------

  const presets = segmented('preset', (name) => applyPreset(name));
  const sync = vectorSliders(state, (which, axis) => {
    presets.clear();
    if (axis === 'z') kept[which === 'a' ? 'az' : 'bz'] = state[which].z;
  });

  function applyPreset(name: string) {
    const [a, b] = PRESETS[name] ?? PRESETS.tilted;
    state.a = { ...a };
    state.b = { ...b };
    kept.az = a.z;
    kept.bz = b.z;
    if (!is3D()) state.a.z = state.b.z = 0;
    sync();
  }

  const wrap = el('wrap');
  const spin = el('spin') as HTMLInputElement;
  segmented('dims', (d) => setDim(d === '3' ? 3 : 2));
  function setDim(d: 2 | 3) {
    if (d === state.dim) return;
    if (d === 2) {
      Object.assign(kept, { az: state.a.z, bz: state.b.z, yaw: cam.yaw, pitch: cam.pitch });
      state.a.z = state.b.z = 0;
      Object.assign(cam, FLAT_VIEW);
      state.spin = spin.checked = false;
    } else {
      state.a.z = kept.az;
      state.b.z = kept.bz;
      Object.assign(cam, { yaw: kept.yaw, pitch: kept.pitch });
    }
    state.dim = d;
    wrap.classList.toggle('flat', d === 2);
    pointer.refreshCursor();
    sync();
  }

  spin.addEventListener('change', () => (state.spin = spin.checked));

  el('angle').addEventListener('input', (e) => {
    const theta = (+(e.target as HTMLInputElement).value * Math.PI) / 180;
    const g = geom();
    if (g.lengthA === 0 || g.lengthB === 0) return;
    state.b = add(mul(g.ahat, g.lengthB * Math.cos(theta)), mul(g.n, g.lengthB * Math.sin(theta)));
    presets.clear();
    sync();
  });

  el('reset').addEventListener('click', () => {
    applyPreset('tilted');
    presets.select('tilted');
    Object.assign(cam, is3D() ? SPATIAL_VIEW : FLAT_VIEW, { zoom: 1, pan: { x: 0, y: 0 } });
    state.spin = spin.checked = false;
  });

  const pointer = scene.pointer({
    flat: () => !is3D(),
    hit: (m) => (scene.near(m, state.b) ? 'b' : scene.near(m, state.a) ? 'a' : null),
    drag: (id, w) => {
      const v = state[id as 'a' | 'b'];
      v.x = w.x;
      v.y = w.y;
      presets.clear();
      sync();
    },
  });

  requestAnimationFrame(frame);
</script>
