  .dp-canvas {
    cursor: grab;
    touch-action: none;
  }
  .dp-canvas:active {
    cursor: grabbing;
  }
  .vec {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  .vec span {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
    margin-bottom: 4px;
  }
  .vec b {
    color: var(--text);
    font-weight: 500;
  }
  .vec input {
    width: 100%;
    accent-color: var(--accent);
  }
  .check {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .check input {
    accent-color: var(--accent);
  }
</style>
