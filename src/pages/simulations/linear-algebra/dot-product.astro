---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Matrix from '../../../components/sim/Matrix.astro';
import Checks from '../../../components/sim/Checks.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';
import { COLOR } from '../../../lib/vector-scene';
import '../../../styles/vector-lab.css';
---

<SimLayout
  areaSlug="linear-algebra"
  title="Dot Product"
  description="Drop b perpendicularly onto a and you get a shadow. The dot product is the length of a times that shadow, and nothing else. Drag the arrows and watch the number follow the picture."
  shortcuts={['reset', 'fullscreen']}
>
  <div class="sim vector-lab flat" id="wrap">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="dp"
          width="1000"
          height="600"
          role="img"
          aria-label="Two vectors, the shadow of b on a, and the rectangle whose area is their dot product."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'a', color: COLOR.a },
          { label: 'b', color: COLOR.b },
          { label: 'shadow of b on a', color: COLOR.result, id: 'legend-shadow' },
        ]}
        hint="Drag an arrowhead to move it · drag empty space to pan · scroll to zoom"
      />
      <Result label="Dot product" />
      <div class="meter" id="meter" role="img" aria-label="Where a · b sits between −|a||b| and |a||b|">
        <div class="meter-track">
          <span class="meter-fill" id="meter-fill"></span>
          <span class="meter-dot" id="meter-dot"></span>
        </div>
        <div class="meter-labels">
          <span>opposed<b id="meter-min">—</b></span>
          <span>right angles<b>0</b></span>
          <span>same direction<b id="meter-max">—</b></span>
        </div>
      </div>
    </div>

    <div class="sim-panel">
      <Seg id="dims" label="View" attr="d" options={[{ value: '2', label: '2D' }, { value: '3', label: '3D' }]} />
      <Seg
        id="preset"
        label="Scenario"
        attr="p"
        options={[
          { value: 'tilted', label: 'Tilted' },
          { value: 'perp', label: 'Right angles' },
          { value: 'same', label: 'Same way' },
          { value: 'back', label: 'Opposed' },
        ]}
      />
      <Matrix
        label={`<span style="color:${COLOR.a}">Vector a</span>`}
        min={-3}
        max={3}
        step={0.1}
        entries={[{ id: 'ax', label: 'x', value: 2 }, { id: 'ay', label: 'y', value: 0.6 }, { id: 'az', label: 'z', value: 0 }]}
      />
      <Matrix
        label={`<span style="color:${COLOR.b}">Vector b</span>`}
        min={-3}
        max={3}
        step={0.1}
        entries={[{ id: 'bx', label: 'x', value: 0.8 }, { id: 'by', label: 'y', value: 1.8 }, { id: 'bz', label: 'z', value: 0 }]}
      />
      <Slider id="angle" label="Angle between them, swinging b" min={0} max={180} value={0} display="—" />
      <Checks items={[{ id: 'spin', label: 'Spin the scene' }]} />
      <Transport run={false} />
      <Readout
        title="Values & calculations"
        rows={[
          { id: 'r-la', label: 'length of a' },
          { id: 'r-lb', label: 'length of b' },
          { id: 'r-shadow', label: 'shadow of b on a' },
          { id: 'r-angle', label: 'angle between' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      At <b>right angles</b> the shadow of b on a vanishes and a · b = 0.
      Nothing of one goes along the other. <Try id="perp" />
    </li>
    <li>
      Swing b past 90°: the foot of the perpendicular lands behind the origin,
      the shadow counts as negative, and so does the product. <Try id="back" />
    </li>
    <li>
      Give a <b>length 1</b> and a · b <b>is</b> the shadow, with no scaling left
      over: "how much of b lies along this direction". <Try id="unit" />
    </li>
    <li>
      In <b>3D</b> one more term a<sub>z</sub>b<sub>z</sub> joins the component
      formula, and the picture is the same shadow. <Try id="three" />
    </li>
  </Fragment>
</SimLayout>

<script>
  import { makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { slider, check, result, readout, tries } from '../../../lib/panel';
  import {
    type Vector3 as Vec,
    O, add, sub, mul, len, unit, dotGeometry, AXIS, comp,
  } from '../../../lib/vector-geometry';
  import {
    COLOR, rgba, LIMIT, FLAT_VIEW, createScene, segmented, vectorSliders, el, degrees,
  } from '../../../lib/vector-scene';

  // ---------------------------------------------------------------------------
  // One picture: b dropped perpendicularly onto the line through a, the shadow
  // that lands there, and the rectangle whose area is the product. The number is
  // also computed from the components, and the two always agree.
  // ---------------------------------------------------------------------------

  const SPATIAL_VIEW = { yaw: 0.7, pitch: -0.36 };
  const PRESETS: Record<string, [Vec, Vec]> = {
    tilted: [{ x: 2, y: 0.6, z: 0.4 }, { x: 0.8, y: 1.8, z: 1.2 }],
    perp: [{ x: 2, y: 0, z: 0 }, { x: 0, y: 1.8, z: 0.9 }],
    same: [{ x: 1.6, y: 1.2, z: 0.6 }, { x: 2.1, y: 1.6, z: 0.8 }],
    back: [{ x: 2, y: 0.8, z: 0.4 }, { x: -1.6, y: -0.5, z: 0.6 }],
  };

  const state = {
    a: { x: 2, y: 0.6, z: 0 } as Vec,
    b: { x: 0.8, y: 1.8, z: 0 } as Vec,
    dim: 2 as 2 | 3,
    spin: false,
  };
  const cam = { ...FLAT_VIEW, zoom: 1, pan: { x: 0, y: 0 } };
  // the z components and the camera, remembered while the view is flat
  const kept = { az: 0.4, bz: 1.2, ...SPATIAL_VIEW };
  const is3D = () => state.dim === 3;

  const canvas = el('dp') as HTMLCanvasElement;
  const W = canvas.width, H = canvas.height;
  const scene = createScene(canvas, cam, {
    origin: () => ({ x: W * 0.42, y: H * 0.5 }),
    scale: () => (is3D() ? 140 : 110),
    redraw: () => draw(),
  });

  const { label, textWidth } = makeText(scene.ctx, scene.inkA);
  const P = (v: Vec) => scene.project(v);
  const seg = (p: Vec, q: Vec) => { const u = P(p), v = P(q); blockLine(u.x, u.y, v.x, v.y); };
  // --- labels: measured boxes, each one nudged to the nearest free spot --------
  type Box = { x0: number; y0: number; x1: number; y1: number };
  const taken: Box[] = [];
  const segs: number[][] = [];
  const fills: { x: number; y: number }[][] = [];
  const layoutReset = () => { taken.length = 0; segs.length = 0; fills.length = 0; };
  const blockLine = (x1: number, y1: number, x2: number, y2: number) => { segs.push([x1, y1, x2, y2]); };
  const blockPoly = (pts: { x: number; y: number }[]) =>
    pts.forEach((p, i) => { const q = pts[(i + 1) % pts.length]; blockLine(p.x, p.y, q.x, q.y); });
  /** A filled shape: no label may cross its outline or sit inside it. */
  const blockFill = (pts: { x: number; y: number }[]) => { blockPoly(pts); fills.push(pts); };
  const inside = (x: number, y: number, pts: { x: number; y: number }[]) => {
    let hit = false;
    for (let i = 0, j = pts.length - 1; i < pts.length; j = i++)
      if ((pts[i].y > y) !== (pts[j].y > y) && x < ((pts[j].x - pts[i].x) * (y - pts[i].y)) / (pts[j].y - pts[i].y) + pts[i].x) hit = !hit;
    return hit;
  };
  const blockDot = (x: number, y: number, r: number) => { taken.push({ x0: x - r, y0: y - r, x1: x + r, y1: y + r }); };
  /** Does the segment cross the box? (Liang–Barsky clipping.) */
  function crosses(s: number[], b: Box) {
    const [x1, y1, x2, y2] = s;
    const dx = x2 - x1, dy = y2 - y1;
    const p = [-dx, dx, -dy, dy], q = [x1 - b.x0, b.x1 - x1, y1 - b.y0, b.y1 - y1];
    let t0 = 0, t1 = 1;
    for (let i = 0; i < 4; i++) {
      if (p[i] === 0) { if (q[i] < 0) return false; continue; }
      const r = q[i] / p[i];
      if (p[i] < 0) { if (r > t1) return false; if (r > t0) t0 = r; }
      else { if (r < t0) return false; if (r < t1) t1 = r; }
    }
    return true;
  }
  const overlap = (a: Box, b: Box) =>
    Math.max(0, Math.min(a.x1, b.x1) - Math.max(a.x0, b.x0)) * Math.max(0, Math.min(a.y1, b.y1) - Math.max(a.y0, b.y0));
  /**
   * Draw `text` next to the point (ax, ay): on it if `onSpot`, otherwise just
   * beyond it in the direction `prefer` (radians, screen axes), swinging round
   * and stepping out until the box crosses no line and no other label. With
   * `onlyIfFree`, only the spot itself and small nudges of it are tried, and
   * nothing is drawn (false is returned) when none of them is clean.
   */
  function place(text: string, size: number, colour: string, ax: number, ay: number, prefer = -Math.PI / 4, onSpot = false, gap = 7, onlyIfFree = false) {
    const w = textWidth(text, size) + 6, h = size * 1.42 + 4;
    const cands: [number, number][] = onSpot || onlyIfFree ? [[ax, ay]] : [];
    if (onlyIfFree) for (const dy of [0, -6, 6, -12, 12]) for (const dx of [0, -8, 8, -16, 16]) cands.push([ax + dx, ay + dy]);
    else for (const step of [0, 1, 2, 3, 5, 7, 10, 14, 19]) {
      for (let k = 0; k < 12; k++) {
        const an = prefer + (k % 2 ? 1 : -1) * Math.ceil(k / 2) * (Math.PI / 6);
        const c = Math.cos(an), s = Math.sin(an);
        const edge = Math.min(Math.abs(c) > 1e-6 ? w / 2 / Math.abs(c) : 1e9, Math.abs(s) > 1e-6 ? h / 2 / Math.abs(s) : 1e9);
        const d = gap + step * 9 + edge;
        cands.push([ax + c * d, ay + s * d]);
      }
    }
    let best = cands[0], bestCost = Infinity;
    cands.forEach(([cx, cy], i) => {
      const b = { x0: cx - w / 2, y0: cy - h / 2, x1: cx + w / 2, y1: cy + h / 2 };
      let cost = i * 0.6;
      if (b.x0 < 2 || b.y0 < 2 || b.x1 > W - 2 || b.y1 > H - 2) cost += 1e5;
      for (const s of segs) if (crosses(s, b)) cost += 1000;
      for (const t of taken) cost += overlap(b, t) * 30;
      for (const f of fills) if (inside(cx, cy, f)) cost += 1000;
      if (cost < bestCost) { bestCost = cost; best = [cx, cy]; }
    });
    if (onlyIfFree && bestCost >= 1000) return false;
    const [cx, cy] = best;
    taken.push({ x0: cx - w / 2, y0: cy - h / 2, x1: cx + w / 2, y1: cy + h / 2 });
    label(text, cx, cy + size * 1.42 * 0.34, 1, 'center', size, colour);
    return true;
  }

  /** The direction a vector points on screen, so its name goes past the tip. */
  const away = (v: Vec) => { const o = P(O), p = P(v); return Math.hypot(p.x - o.x, p.y - o.y) > 4 ? Math.atan2(p.y - o.y, p.x - o.x) : -Math.PI / 4; };

  // --- the geometry the whole sim is about -----------------------------------

  function sideways(v: Vec): Vec {
    return unit(Math.abs(v.z) < 0.9 * len(v) ? { x: -v.y, y: v.x, z: 0 } : { x: 0, y: -v.z, z: v.y });
  }
  function geom() {
    const g = dotGeometry(state.a, state.b);
    const ahat = unit(state.a);
    const foot = mul(ahat, g.projection);
    const off = sub(state.b, foot);
    // in-plane normal, pointing from the line through a towards b
    const n = len(off) > 1e-6 ? unit(off) : sideways(state.a);
    return { ...g, ahat, foot, n };
  }

  // --- the picture -----------------------------------------------------------

  function draw() {
    const { ctx, inkA } = scene;
    ctx.clearRect(0, 0, W, H);
    layoutReset();
    scene.grid(is3D());
    // the axis names the grid writes
    for (const e of [{ x: LIMIT + 0.25, y: 0, z: 0 }, { x: 0, y: LIMIT + 0.25, z: 0 }, { x: 0, y: 0, z: LIMIT + 0.25 }].slice(0, is3D() ? 3 : 2)) { const q = P(e); blockDot(q.x, q.y - 4, 9); }

    const { a, b } = state;
    const g = geom();
    const s = g.projection, d = g.product;
    const SH = d >= 0 ? COLOR.result : COLOR.negative;

    // the line the shadow lives on
    scene.line(mul(g.ahat, -LIMIT * 1.5), mul(g.ahat, LIMIT * 1.5), inkA(0.14), 1, [5, 5]);
    seg(mul(g.ahat, -LIMIT * 1.5), mul(g.ahat, LIMIT * 1.5));

    // the rectangle: |a| by the shadow, hung on the far side from b
    const rect = Math.abs(s) > 1e-6 && g.lengthA > 1e-6;
    const down = mul(g.n, -g.lengthA);
    if (rect) {
      const corners = [O, g.foot, add(g.foot, down), down];
      scene.poly(corners, rgba(SH, 0.12), rgba(SH, 0.45));
      blockPoly(corners.map(P));
    }

    // the perpendicular drop from b, with its right angle
    scene.line(b, g.foot, inkA(0.4), 1.4, [4, 4]);
    seg(b, g.foot);
    if (Math.abs(s) > 0.12 && len(sub(b, g.foot)) > 0.12) {
      const q = 0.17;
      const c1 = add(g.foot, mul(g.ahat, s > 0 ? -q : q));
      const c3 = add(c1, mul(g.n, q));
      scene.line(c1, c3, inkA(0.35));
      scene.line(c3, add(g.foot, mul(g.n, q)), inkA(0.35));
    }

    if (Math.abs(s) > 1e-6) scene.arrow(O, g.foot, SH, 6, 16);
    scene.arrow(O, a, COLOR.a);
    scene.arrow(O, b, COLOR.b);
    for (const v of [a, b]) { seg(O, v); const t = P(v); blockDot(t.x, t.y, 8); }

    // the angle, as an arc at the origin: b = |b| (cos θ â + sin θ n)
    let angleAt: Vec | null = null;
    if (g.angle !== null && g.lengthA > 0.3 && g.lengthB > 0.3) {
      const th = (g.angle * Math.PI) / 180;
      const arc = (r: number, t: number): Vec => mul(add(mul(g.ahat, Math.cos(t)), mul(g.n, Math.sin(t))), r);
      ctx.strokeStyle = inkA(0.4);
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (let k = 0; k <= 24; k++) {
        const p = P(arc(0.42, (th * k) / 24));
        k ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y);
        if (k) { const q = P(arc(0.42, (th * (k - 1)) / 24)); blockLine(q.x, q.y, p.x, p.y); }
      }
      ctx.stroke();
      angleAt = arc(0.74, th / 2);
    }

    // names and numbers last, each in the first free spot near what it names
    const ta = P(a), tb = P(b);
    place('a', 16, COLOR.a, ta.x, ta.y, away(a), false, 6);
    place('b', 16, COLOR.b, tb.x, tb.y, away(b), false, 6);
    if (angleAt) { const p = P(angleAt); place(degrees(g.angle), 12, inkA(0.7), p.x, p.y, 0, true, 4); }
    if (rect && Math.abs(s) > 0.3) {
      // the shadow's length: inside the rectangle just under the shadow if it
      // fits, otherwise just past the shadow's end, below the line of a
      const text = `shadow ${s.toFixed(2)}`;
      const m = P(add(mul(g.foot, 0.5), mul(g.n, -0.26)));
      const f = P(g.foot), slant = P(add(g.foot, add(mul(g.ahat, s > 0 ? 0.3 : -0.3), mul(g.n, -0.3))));
      place(text, 12, SH, m.x, m.y, 0, true, 4, true) ||
        place(text, 12, SH, f.x, f.y, Math.atan2(slant.y - f.y, slant.x - f.x), false, 8);
    }
    if (rect && Math.abs(s) > 0.6 && g.lengthA > 0.5) {
      // the product in the middle of the rectangle, or under its far side
      const text = `a · b = ${d.toFixed(2)}`;
      const c = P(mul(add(g.foot, down), 0.5)), e = P(add(mul(g.foot, 0.5), down)), out = P(add(mul(g.foot, 0.5), mul(down, 1.3)));
      place(text, 13, SH, c.x, c.y, 0, true, 4, true) || place(text, 13, SH, e.x, e.y, Math.atan2(out.y - e.y, out.x - e.x), false, 8);
    }
  }

  // --- the words and numbers, rebuilt only when the vectors change -----------

  const setEq = equation();
  const setResult = result();
  const setRows = readout();
  let lastKey = '';

  function updateReadout() {
    const key = JSON.stringify([state.a, state.b, state.dim]);
    if (key === lastKey) return;
    lastKey = key;

    const { a, b } = state;
    const g = geom();
    const s = g.projection, d = g.product;
    const zero = g.lengthA < 1e-9 || g.lengthB < 1e-9;
    const col = d >= 0 ? COLOR.result : COLOR.negative;

    el('legend-shadow').style.setProperty('--dot', col);
    setResult({
      value: d.toFixed(2),
      colour: col,
      status: zero
        ? 'Zero vector'
        : Math.abs(d) < 1e-9 ? 'Perpendicular' : d > 0 ? 'Leaning the same way' : 'Leaning against each other',
      note: zero
        ? 'A zero vector has no direction, so the angle is undefined and the product is zero.'
        : Math.abs(d) < 1e-9
          ? 'Nothing of b lies along a, so the rectangle has no width.'
          : `|a| × shadow = ${g.lengthA.toFixed(2)} × ${s.toFixed(2)}. The shadow falls ${d > 0 ? 'along' : 'against'} a, and that is where the sign comes from.`,
    });

    const span = g.lengthA * g.lengthB;
    const frac = span > 1e-9 ? Math.max(-1, Math.min(1, d / span)) : 0;
    el('meter').style.setProperty('--meter-color', col);
    el('meter-fill').style.left = `${50 + Math.min(0, frac) * 50}%`;
    el('meter-fill').style.width = `${Math.abs(frac) * 50}%`;
    el('meter-dot').style.left = `${50 + frac * 50}%`;
    el('meter-min').textContent = `−|a||b| = ${(-span).toFixed(2)}`;
    el('meter-max').textContent = `|a||b| = ${span.toFixed(2)}`;

    const angle = el('angle') as HTMLInputElement;
    angle.disabled = g.angle === null;
    if (document.activeElement !== angle) setAngle(Math.round(g.angle ?? 0));
    el('angleval').textContent = degrees(g.angle);
    el('scene-hint').textContent = is3D()
      ? 'Drag to orbit · shift-drag to pan · scroll to zoom · set the vectors with the sliders'
      : 'Drag an arrowhead to move it · drag empty space to pan · scroll to zoom';

    setRows({ 'r-la': g.lengthA.toFixed(3), 'r-lb': g.lengthB.toFixed(3), 'r-shadow': s.toFixed(3), 'r-angle': degrees(g.angle) });

    const idx = [0, 1, 2].slice(0, state.dim);
    const symbolic = idx.map((i) => `a_${AXIS[i]}b_${AXIS[i]}`).join('+');
    const numeric = idx.map((i) => (comp(a, i) * comp(b, i)).toFixed(2)).join('+').replaceAll('+-', '-');
    const A = `\\textcolor{${COLOR.a}}{\\mathbf a}`, B = `\\textcolor{${COLOR.b}}{\\mathbf b}`;
    setEq({
      rule: [`${A}\\cdot${B} = |\\mathbf a|\\,|\\mathbf b|\\cos\\theta = ${symbolic}`],
      live: [
        [`${A}\\cdot${B} = ${d.toFixed(2)}`, col],
        `\\quad = ${g.lengthA.toFixed(2)}\\times${s.toFixed(2)}`,
        `\\quad = ${numeric}`,
      ],
    });
  }

  // --- loop ------------------------------------------------------------------

  let last = performance.now();
  function frame(now: number) {
    const dt = Math.min(0.05, Math.max(0, (now - last) / 1000));
    last = now;
    if (state.spin && is3D()) cam.yaw += dt * 0.28;
    draw();
    updateReadout();
    requestAnimationFrame(frame);
  }

  // --- controls --------------------------------------------------------------

  const presets = segmented('preset', (name) => applyPreset(name));
  const sync = vectorSliders(state, (which, axis) => {
    presets.clear();
    if (axis === 'z') kept[which === 'a' ? 'az' : 'bz'] = state[which].z;
  });

  function applyPreset(name: string) {
    const [a, b] = PRESETS[name] ?? PRESETS.tilted;
    state.a = { ...a };
    state.b = { ...b };
    kept.az = a.z;
    kept.bz = b.z;
    if (!is3D()) state.a.z = state.b.z = 0;
    sync();
  }

  const wrap = el('wrap');
  const setSpin = check('spin', (on) => (state.spin = on));
  // the z sliders and the spin switch only mean something in the spatial view
  const only3D = [el('az').parentElement!, el('bz').parentElement!, el('spin').closest('.control') as HTMLElement];
  const showOnly3D = () => only3D.forEach((n) => (n.style.display = is3D() ? '' : 'none'));
  showOnly3D();
  const dims = segmented('dims', (d) => setDim(d === '3' ? 3 : 2));
  function setDim(d: 2 | 3) {
    if (d === state.dim) return;
    if (d === 2) {
      Object.assign(kept, { az: state.a.z, bz: state.b.z, yaw: cam.yaw, pitch: cam.pitch });
      state.a.z = state.b.z = 0;
      Object.assign(cam, FLAT_VIEW);
      state.spin = false;
      setSpin(false);
    } else {
      state.a.z = kept.az;
      state.b.z = kept.bz;
      Object.assign(cam, { yaw: kept.yaw, pitch: kept.pitch });
    }
    state.dim = d;
    dims.select(String(d));
    wrap.classList.toggle('flat', d === 2);
    showOnly3D();
    pointer.refreshCursor();
    sync();
  }

  const setAngle = slider('angle', (deg) => {
    const theta = (deg * Math.PI) / 180;
    const g = geom();
    if (g.lengthA === 0 || g.lengthB === 0) return;
    state.b = add(mul(g.ahat, g.lengthB * Math.cos(theta)), mul(g.n, g.lengthB * Math.sin(theta)));
    presets.clear();
    sync();
  }, (deg) => `${deg}°`);

  el('reset').addEventListener('click', () => {
    applyPreset('tilted');
    presets.select('tilted');
    Object.assign(cam, is3D() ? SPATIAL_VIEW : FLAT_VIEW, { zoom: 1, pan: { x: 0, y: 0 } });
    state.spin = false;
    setSpin(false);
  });

  function show(name: string, dim: 2 | 3 = 2) {
    setDim(dim);
    presets.select(name);
    applyPreset(name);
  }
  tries({
    perp: () => show('perp'),
    back: () => show('back'),
    unit: () => {
      show('tilted');
      presets.clear();
      state.a = { x: 1, y: 0, z: 0 };
      state.b = { x: 1.6, y: 1.2, z: 0 };
      sync();
    },
    three: () => show('tilted', 3),
  });

  const pointer = scene.pointer({
    flat: () => !is3D(),
    hit: (m) => (scene.near(m, state.b) ? 'b' : scene.near(m, state.a) ? 'a' : null),
    drag: (id, w) => {
      const v = state[id as 'a' | 'b'];
      v.x = w.x;
      v.y = w.y;
      presets.clear();
      sync();
    },
  });

  requestAnimationFrame(frame);
</script>
