---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Matrix from '../../../components/sim/Matrix.astro';
import Checks from '../../../components/sim/Checks.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="linear-algebra"
  title="Linear Transformations"
  description="A linear map is fully described by where it sends the basis vectors. Drag the tips of î and ĵ and the whole grid follows."
  shortcuts={['animate', 'fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="lin"
          width="1000"
          height="600"
          role="img"
          aria-label="A grid transformed by a matrix, with the images of the two basis vectors, a draggable vector and its image, and the unit square's image shaded."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'î', color: '#7c8cff' },
          { label: 'ĵ', color: '#5eead4' },
          { label: 'v and Av', color: '#fbbf24' },
          { label: 'unit square, area = det A', color: 'rgba(94,234,212,0.45)' },
        ]}
        hint="Drag the tips of î and ĵ, or the ring marked v"
      />
      <Result label="det of the frame shown" />
    </div>

    <div class="sim-panel">
      <Matrix
        label="Transformation matrix"
        view
        entries={[
          { id: 'a', label: 'a', value: 1 },
          { id: 'b', label: 'b', value: 0 },
          { id: 'c', label: 'c', value: 0 },
          { id: 'd', label: 'd', value: 1 },
        ]}
      />
      <Seg
        id="presets"
        label="Presets"
        attr="m"
        options={[
          { value: '1,0,0,1', label: 'Identity' },
          { value: '0,-1,1,0', label: 'Rotate 90°' },
          { value: '1,1,0,1', label: 'Shear' },
          { value: '-1,0,0,1', label: 'Reflect' },
          { value: '1.5,0,0,0.5', label: 'Scale' },
          { value: '1,1,1,1', label: 'Collapse' },
        ]}
      />
      <Seg
        id="path"
        label="Path from I to A"
        attr="p"
        options={[
          { value: 'polar', label: 'Turn + stretch' },
          { value: 'linear', label: 'Straight blend' },
        ]}
      />
      <Slider id="t" label="Sweep I → A, t" min={0} max={100} value={100} display="1.00" />
      <Transport animate="Animate I → A" reset={false} />
      <Checks
        label="Show"
        items={[
          { id: 'ghost', label: 'The original grid', checked: true },
          { id: 'vec', label: 'A vector to drag', checked: true },
        ]}
      />
      <Readout
        title="Values"
        rows={[
          { id: 'r-i', label: 'î →' },
          { id: 'r-j', label: 'ĵ →' },
          { id: 'r-v', label: 'v' },
          { id: 'r-av', label: 'Av' },
          { id: 'r-turn', label: 'turned so far' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Pick <b>Shear</b> and drag the ring <b>v</b>. Its image is x steps along Aî
      plus y steps along Aĵ (the dashed legs): where the basis lands decides
      everything. <Try id="shear" />
    </li>
    <li>
      Animate <b>Rotate 90°</b> on the <b>Turn + stretch</b> path. The frame at
      time t is R(tθ) blended with A's stretch, so the grid turns rigidly and
      det stays 1 the whole way. <Try id="turn" label="Animate" />
    </li>
    <li>
      Same matrix on the <b>Straight blend</b> (1−t)I + tA. It cuts the corner
      instead of turning: halfway the grid has shrunk to det 0.5, then grows
      back. Both paths end on the same A. <Try id="blend" label="Animate" />
    </li>
    <li>
      The shaded square's area and the directions that only stretch have their
      own pages: <a href="/simulations/linear-algebra/determinant">Determinant</a>
      and <a href="/simulations/linear-algebra/eigenvectors">Eigenvectors</a>.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk } from '../../../lib/draw';
  import { el, segmented, slider, matrix, check, result, readout, tries } from '../../../lib/panel';

  // A = the target matrix; M = the matrix actually drawn, interpolated from I by t.
  const A = { a: 1, b: 0, c: 0, d: 1 };
  const M = { a: 1, b: 0, c: 0, d: 1 };
  const view = { t: 1, path: 'polar', showGhost: true, showVec: true };
  const vec = { x: 2, y: 1 };
  const IH = '#7c8cff', JH = '#5eead4', VEC = '#fbbf24';

  const canvas = el('lin') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();
  const ORIGIN = { x: W / 2, y: H / 2 };
  const UNIT = 52;

  /**
   * The rotation part of A's polar decomposition A = R(θ)S, with S symmetric.
   * θ = atan2(c − b, a + d) is the angle that makes R(−θ)A symmetric.
   */
  const angleOf = () => Math.atan2(A.c - A.b, A.a + A.d);
  function recompute() {
    const t = view.t;
    if (view.path === 'linear') {
      // (1 − t)I + tA: every entry slides straight to its target
      M.a = 1 - t + t * A.a;
      M.b = t * A.b;
      M.c = t * A.c;
      M.d = 1 - t + t * A.d;
      return;
    }
    // R(tθ) · ((1 − t)I + tS): turn by a fraction of the angle, blend in the stretch
    const th = angleOf(), c = Math.cos(th), s = Math.sin(th);
    const S = { a: c * A.a + s * A.c, b: c * A.b + s * A.d, c: -s * A.a + c * A.c, d: -s * A.b + c * A.d };
    const B = { a: 1 - t + t * S.a, b: t * S.b, c: t * S.c, d: 1 - t + t * S.d };
    const ct = Math.cos(t * th), st = Math.sin(t * th);
    M.a = ct * B.a - st * B.c;
    M.b = ct * B.b - st * B.d;
    M.c = st * B.a + ct * B.c;
    M.d = st * B.b + ct * B.d;
  }
  const toScreen = (x: number, y: number) => ({ px: ORIGIN.x + (M.a * x + M.b * y) * UNIT, py: ORIGIN.y - (M.c * x + M.d * y) * UNIT });
  const rawToScreen = (x: number, y: number) => ({ px: ORIGIN.x + x * UNIT, py: ORIGIN.y - y * UNIT });

  function arrowTo(p: { px: number; py: number }, color: string, text: string, width = 3) {
    ctx.strokeStyle = color;
    ctx.fillStyle = color;
    ctx.lineWidth = width;
    ctx.beginPath(); ctx.moveTo(ORIGIN.x, ORIGIN.y); ctx.lineTo(p.px, p.py); ctx.stroke();
    const ang = Math.atan2(p.py - ORIGIN.y, p.px - ORIGIN.x);
    ctx.beginPath();
    ctx.moveTo(p.px, p.py);
    ctx.lineTo(p.px - 12 * Math.cos(ang - 0.4), p.py - 12 * Math.sin(ang - 0.4));
    ctx.lineTo(p.px - 12 * Math.cos(ang + 0.4), p.py - 12 * Math.sin(ang + 0.4));
    ctx.closePath();
    ctx.fill();
    if (text) label(text, p.px + 8, p.py - 8, 1, 'left', 13, color);
  }

  /** The free vector, drawn where it started and where A sends it, built from x·Aî then y·Aĵ. */
  function drawVector() {
    const p = rawToScreen(vec.x, vec.y);
    const q = toScreen(vec.x, vec.y);
    const ai = toScreen(1, 0);
    const mid = { px: ORIGIN.x + vec.x * (ai.px - ORIGIN.x), py: ORIGIN.y + vec.x * (ai.py - ORIGIN.y) };
    const seg = (x1: number, y1: number, x2: number, y2: number, col: string, dash: number[]) => {
      ctx.strokeStyle = col;
      ctx.lineWidth = 1.5;
      ctx.setLineDash(dash);
      ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke();
      ctx.setLineDash([]);
    };
    seg(ORIGIN.x, ORIGIN.y, mid.px, mid.py, IH, [5, 4]);
    seg(mid.px, mid.py, q.px, q.py, JH, [5, 4]);
    seg(ORIGIN.x, ORIGIN.y, p.px, p.py, ink(0.4), [3, 4]);
    arrowTo(q, VEC, 'Av');
    ctx.strokeStyle = VEC;
    ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(p.px, p.py, 6, 0, Math.PI * 2); ctx.stroke();
    label('v', p.px + 10, p.py + 4, 0.6, 'left', 12);
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    const R = 10;
    if (view.showGhost) {
      ctx.strokeStyle = ink(0.12);
      ctx.lineWidth = 1;
      ctx.setLineDash([3, 4]);
      ctx.beginPath();
      for (let i = -R; i <= R; i++) {
        const a1 = rawToScreen(i, -R), a2 = rawToScreen(i, R), b1 = rawToScreen(-R, i), b2 = rawToScreen(R, i);
        ctx.moveTo(a1.px, a1.py); ctx.lineTo(a2.px, a2.py); ctx.moveTo(b1.px, b1.py); ctx.lineTo(b2.px, b2.py);
      }
      ctx.stroke();
      ctx.setLineDash([]);
    }
    ctx.strokeStyle = ink(0.2);
    ctx.lineWidth = 1;
    ctx.beginPath();
    for (let i = -R; i <= R; i++) {
      const a1 = toScreen(i, -R), a2 = toScreen(i, R), b1 = toScreen(-R, i), b2 = toScreen(R, i);
      ctx.moveTo(a1.px, a1.py); ctx.lineTo(a2.px, a2.py); ctx.moveTo(b1.px, b1.py); ctx.lineTo(b2.px, b2.py);
    }
    ctx.stroke();

    const det = M.a * M.d - M.b * M.c;
    const o = toScreen(0, 0), i = toScreen(1, 0), ij = toScreen(1, 1), j = toScreen(0, 1);
    ctx.fillStyle = det >= 0 ? 'rgba(94,234,212,0.14)' : 'rgba(248,113,113,0.16)';
    ctx.beginPath(); ctx.moveTo(o.px, o.py); ctx.lineTo(i.px, i.py); ctx.lineTo(ij.px, ij.py); ctx.lineTo(j.px, j.py); ctx.closePath(); ctx.fill();

    arrowTo(i, IH, 'î');
    arrowTo(j, JH, 'ĵ');
    if (view.showVec) drawVector();

    const vo = { x: M.a * vec.x + M.b * vec.y, y: M.c * vec.x + M.d * vec.y };
    (['a', 'b', 'c', 'd'] as const).forEach((k) => (el('m-' + k).textContent = M[k].toFixed(2)));
    const detA = A.a * A.d - A.b * A.c;
    const turned = view.path === 'polar' ? (angleOf() * view.t * 180) / Math.PI : null;
    const pathNote =
      view.path === 'linear'
        ? 'Straight blend: each entry slides from I to A on its own, so a rotation cuts the corner and the grid shrinks on the way.'
        : detA < 0
          ? 'A turns the plane over, so any path from I has to pass through det 0 on the way; here the stretch part does it.'
          : 'Turn + stretch: the frame is R(tθ) times a blend of A\'s symmetric stretch, so a rotation stays a rotation the whole way.';
    setEq({
      rule: ['A(x,y) = x\\,', ['A\\hat{\\imath}', IH], '+\\;y\\,', ['A\\hat{\\jmath}', JH], '\\qquad\\det A = ad-bc'],
      live: [[`A\\hat{\\imath}=(${M.a.toFixed(2)},${M.c.toFixed(2)})`, IH], [`\\quad A\\hat{\\jmath}=(${M.b.toFixed(2)},${M.d.toFixed(2)})`, JH], `\\quad\\det A = ${det.toFixed(3)}`],
    });
    setResult({
      value: det.toFixed(3),
      colour: Math.abs(det) < 0.02 ? '#f87171' : det >= 0 ? JH : '#f87171',
      status: `t = ${view.t.toFixed(2)} · ${Math.abs(det) < 0.02 ? 'flattened onto a line' : `î → (${M.a.toFixed(2)}, ${M.c.toFixed(2)}) · ĵ → (${M.b.toFixed(2)}, ${M.d.toFixed(2)})${det < 0 ? ' · orientation reversed' : ''}`}`,
      note: view.t >= 0.999 ? 'The two columns are just where the basis lands; every other vector follows by adding.' : pathNote,
    });
    setRows({
      'r-i': `(${M.a.toFixed(2)}, ${M.c.toFixed(2)})`,
      'r-j': `(${M.b.toFixed(2)}, ${M.d.toFixed(2)})`,
      'r-v': view.showVec ? `(${vec.x.toFixed(2)}, ${vec.y.toFixed(2)})` : '—',
      'r-av': view.showVec ? `(${vo.x.toFixed(2)}, ${vo.y.toFixed(2)})` : '—',
      'r-turn': turned === null ? '—' : `${turned.toFixed(1)}°`,
    });
  }

  const sync = matrix(A, ['a', 'b', 'c', 'd'], () => { recompute(); draw(); });
  const setT = slider('t', (v) => { cancelAnimationFrame(raf); view.t = v / 100; recompute(); draw(); }, (v) => (v / 100).toFixed(2));
  function preset(m: string) {
    cancelAnimationFrame(raf);
    const [a, b, c, d] = m.split(',').map(Number);
    Object.assign(A, { a, b, c, d });
    view.t = 1;
    setT(100);
    sync();
    recompute();
    draw();
  }
  const presets = segmented('presets', preset);
  const paths = segmented('path', (p) => { view.path = p; recompute(); draw(); });
  check('ghost', (on) => { view.showGhost = on; draw(); });
  const setVec = check('vec', (on) => { view.showVec = on; draw(); });
  let raf = 0;
  el('run').addEventListener('click', () => {
    cancelAnimationFrame(raf);
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min(1, (now - start) / 1100);
      view.t = p;
      setT(Math.round(p * 100));
      recompute();
      draw();
      if (p < 1) raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);
  });

  function show(m: string, path: string) {
    presets.select(m);
    preset(m);
    view.path = path;
    paths.select(path);
    recompute();
    draw();
  }
  tries({
    shear: () => {
      show('1,1,0,1', 'polar');
      Object.assign(vec, { x: 2, y: 1 });
      view.showVec = true;
      setVec(true);
      draw();
    },
    turn: () => { show('0,-1,1,0', 'polar'); el('run').click(); },
    blend: () => { show('0,-1,1,0', 'linear'); el('run').click(); },
  });

  // drag the basis tips where they land, and the free vector at its input tip
  type Handle = 'i' | 'j' | 'v';
  let dragging: Handle | null = null;
  const mouse = (e: PointerEvent) => {
    const rect = canvas.getBoundingClientRect();
    return { mx: ((e.clientX - rect.left) / rect.width) * W, my: ((e.clientY - rect.top) / rect.height) * H };
  };
  function near(e: PointerEvent, which: Handle) {
    if (which === 'v' && !view.showVec) return false;
    const { mx, my } = mouse(e);
    const t = which === 'i' ? toScreen(1, 0) : which === 'j' ? toScreen(0, 1) : rawToScreen(vec.x, vec.y);
    return Math.hypot(mx - t.px, my - t.py) < 16;
  }
  canvas.addEventListener('pointerdown', (e) => {
    dragging = near(e, 'i') ? 'i' : near(e, 'j') ? 'j' : near(e, 'v') ? 'v' : null;
    if (dragging) {
      if (dragging !== 'v') { cancelAnimationFrame(raf); view.t = 1; setT(100); recompute(); presets.clear(); }
      canvas.setPointerCapture(e.pointerId);
    }
  });
  canvas.addEventListener('pointermove', (e) => {
    if (!dragging) {
      canvas.style.cursor = near(e, 'i') || near(e, 'j') || near(e, 'v') ? 'grab' : 'default';
      return;
    }
    const { mx, my } = mouse(e);
    const wx = (mx - ORIGIN.x) / UNIT, wy = (ORIGIN.y - my) / UNIT;
    const snap = (v: number) => (Math.abs(v - Math.round(v)) < 0.08 ? Math.round(v) : +v.toFixed(2));
    if (dragging === 'v') {
      vec.x = Math.max(-8, Math.min(8, snap(wx)));
      vec.y = Math.max(-5, Math.min(5, snap(wy)));
      draw();
      return;
    }
    if (dragging === 'i') { A.a = Math.max(-3, Math.min(3, snap(wx))); A.c = Math.max(-3, Math.min(3, snap(wy))); }
    else { A.b = Math.max(-3, Math.min(3, snap(wx))); A.d = Math.max(-3, Math.min(3, snap(wy))); }
    sync();
    recompute();
    draw();
  });
  const endDrag = () => (dragging = null);
  canvas.addEventListener('pointerup', endDrag);
  canvas.addEventListener('pointercancel', endDrag);

  recompute();
  draw();
</script>

<style>
  #lin {
    touch-action: none;
  }
</style>
