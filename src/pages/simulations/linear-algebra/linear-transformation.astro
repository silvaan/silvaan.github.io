---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Matrix from '../../../components/sim/Matrix.astro';
import Checks from '../../../components/sim/Checks.astro';
import Transport from '../../../components/sim/Transport.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
import Try from '../../../components/sim/Try.astro';
---

<SimLayout
  areaSlug="linear-algebra"
  title="Linear Transformations"
  description="A linear map is fully described by where it sends the basis vectors. Drag the tips of î and ĵ and the whole grid follows."
  shortcuts={['animate', 'fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="lin"
          width="1000"
          height="600"
          role="img"
          aria-label="A grid transformed by a matrix, with the images of the two basis vectors, a draggable vector and its image, the unit square's image shaded, and a letter F carried along with the grid."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'î', color: '#7c8cff' },
          { label: 'ĵ', color: '#5eead4' },
          { label: 'v and Av', color: '#fbbf24' },
          { label: 'F and its image', color: '#f472b6' },
          { label: 'unit square, area = det A', color: 'rgba(94,234,212,0.45)' },
        ]}
        hint="Drag the tips of î and ĵ, or the ring marked v"
      />
      <Result label="det of the frame shown" />
    </div>

    <div class="sim-panel">
      <Matrix
        label="Transformation matrix"
        view
        entries={[
          { id: 'a', label: 'a', value: 1.4 },
          { id: 'b', label: 'b', value: 0.7 },
          { id: 'c', label: 'c', value: 0.2 },
          { id: 'd', label: 'd', value: 1.1 },
        ]}
      />
      <Seg
        id="presets"
        label="Presets"
        attr="m"
        options={[
          { value: '1.4,0.7,0.2,1.1', label: 'Shear + stretch' },
          { value: '1,0,0,1', label: 'Identity' },
          { value: '0,-1,1,0', label: 'Rotate 90°' },
          { value: '1,1,0,1', label: 'Shear' },
          { value: '-1,0,0,1', label: 'Reflect' },
          { value: '1.5,0,0,0.5', label: 'Scale' },
          { value: '1,1,1,1', label: 'Collapse' },
        ]}
      />
      <Seg
        id="path"
        label="Path from I to A"
        attr="p"
        options={[
          { value: 'polar', label: 'Turn + stretch' },
          { value: 'linear', label: 'Straight blend' },
        ]}
      />
      <Seg
        id="zoom"
        label="View"
        attr="z"
        options={[
          { value: 'fit', label: 'Fit to the picture' },
          { value: 'wide', label: 'Wide' },
        ]}
      />
      <Slider id="t" label="Sweep I → A, t" min={0} max={100} value={100} display="1.00" />
      <Transport animate="Animate I → A" reset={false} />
      <Checks
        label="Show"
        items={[
          { id: 'fig', label: 'The figure, an F', checked: true },
          { id: 'ghost', label: 'The original grid and F', checked: true },
          { id: 'vec', label: 'A vector to drag', checked: true },
        ]}
      />
      <Readout
        title="Values"
        rows={[
          { id: 'r-i', label: 'î →' },
          { id: 'r-j', label: 'ĵ →' },
          { id: 'r-v', label: 'v' },
          { id: 'r-av', label: 'Av' },
          { id: 'r-turn', label: 'turned so far' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Pick <b>Shear</b> and drag the ring <b>v</b>. Its image is x steps along Aî
      plus y steps along Aĵ (the dashed legs): where the basis lands decides
      everything. <Try id="shear" />
    </li>
    <li>
      Animate <b>Rotate 90°</b> on the <b>Turn + stretch</b> path. The frame at
      time t is R(tθ) blended with A's stretch, so the grid and the F turn
      rigidly and det stays 1 the whole way. <Try id="turn" label="Animate" />
    </li>
    <li>
      Same matrix on the <b>Straight blend</b> (1−t)I + tA. It cuts the corner
      instead of turning: halfway the grid has shrunk to det 0.5, then grows
      back. Both paths end on the same A. <Try id="blend" label="Animate" />
    </li>
    <li>
      The shaded square's area and the directions that only stretch have their
      own pages: <a href="/simulations/linear-algebra/determinant">Determinant</a>
      and <a href="/simulations/linear-algebra/eigenvectors">Eigenvectors</a>.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk } from '../../../lib/draw';
  import { el, segmented, slider, matrix, check, result, readout, tries } from '../../../lib/panel';

  // A = the target matrix; M = the matrix actually drawn, interpolated from I by t.
  type Mat = { a: number; b: number; c: number; d: number };
  const A: Mat = { a: 1.4, b: 0.7, c: 0.2, d: 1.1 };
  const M: Mat = { ...A };
  const view = { t: 1, path: 'polar', showGhost: true, showVec: true, showFig: true, zoom: 'fit' };
  const vec = { x: 2, y: 1 };
  const IH = '#7c8cff', JH = '#5eead4', VEC = '#fbbf24', FIG = '#f472b6';

  const canvas = el('lin') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink } = stageInk(canvas);
  const { label, textWidth } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();
  // where the origin sits and how many pixels one unit is; refitted to the picture
  let ORIGIN = { x: W / 2, y: H / 2 };
  let UNIT = 52;

  // An F, because it has no symmetry: a turned F and a mirrored F can't be confused.
  const F_RAW: [number, number][] = [[0, 0], [0.32, 0], [0.32, 0.5], [0.72, 0.5], [0.72, 0.8], [0.32, 0.8], [0.32, 1.05], [0.85, 1.05], [0.85, 1.35], [0, 1.35]];
  const FIG_PTS: [number, number][] = F_RAW.map(([x, y]) => [-1.75 + x * 1.1, -1.95 + y * 1.1]);

  /**
   * The rotation part of A's polar decomposition A = R(θ)S, with S symmetric.
   * θ = atan2(c − b, a + d) is the angle that makes R(−θ)A symmetric.
   */
  const angleOf = () => Math.atan2(A.c - A.b, A.a + A.d);
  function pathAt(t: number): Mat {
    if (view.path === 'linear') {
      // (1 − t)I + tA: every entry slides straight to its target
      return { a: 1 - t + t * A.a, b: t * A.b, c: t * A.c, d: 1 - t + t * A.d };
    }
    // R(tθ) · ((1 − t)I + tS): turn by a fraction of the angle, blend in the stretch
    const th = angleOf(), c = Math.cos(th), s = Math.sin(th);
    const S = { a: c * A.a + s * A.c, b: c * A.b + s * A.d, c: -s * A.a + c * A.c, d: -s * A.b + c * A.d };
    const B = { a: 1 - t + t * S.a, b: t * S.b, c: t * S.c, d: 1 - t + t * S.d };
    const ct = Math.cos(t * th), st = Math.sin(t * th);
    return { a: ct * B.a - st * B.c, b: ct * B.b - st * B.d, c: st * B.a + ct * B.c, d: st * B.b + ct * B.d };
  }
  const recompute = () => Object.assign(M, pathAt(view.t));

  /**
   * Zoom so the whole sweep from I to A fills the stage: every frame of the
   * path is sampled, so animating never runs the picture off the edge.
   * "Wide" is a fixed, far-out view of the plane instead.
   */
  function fit() {
    if (view.zoom === 'wide') { UNIT = 40; ORIGIN = { x: W / 2, y: H / 2 }; return; }
    const pts: [number, number][] = [[0, 0], [1, 0], [0, 1], [1, 1]];
    if (view.showVec) pts.push([vec.x, vec.y]);
    if (view.showFig) pts.push(...FIG_PTS);
    let x0 = Infinity, x1 = -Infinity, y0 = Infinity, y1 = -Infinity;
    for (let k = 0; k <= 12; k++) {
      const m = pathAt(k / 12);
      for (const [x, y] of pts) {
        const X = m.a * x + m.b * y, Y = m.c * x + m.d * y;
        x0 = Math.min(x0, X); x1 = Math.max(x1, X); y0 = Math.min(y0, Y); y1 = Math.max(y1, Y);
      }
    }
    UNIT = Math.max(16, Math.min(120, (W - 130) / Math.max(1e-6, x1 - x0), (H - 90) / Math.max(1e-6, y1 - y0)));
    ORIGIN = { x: W / 2 - ((x0 + x1) / 2) * UNIT, y: H / 2 + ((y0 + y1) / 2) * UNIT };
  }

  const toScreen = (x: number, y: number) => ({ px: ORIGIN.x + (M.a * x + M.b * y) * UNIT, py: ORIGIN.y - (M.c * x + M.d * y) * UNIT });
  const rawToScreen = (x: number, y: number) => ({ px: ORIGIN.x + x * UNIT, py: ORIGIN.y - y * UNIT });
  const xy = (p: { px: number; py: number }) => ({ x: p.px, y: p.py });

  // --- labels: measured boxes, each one nudged to the nearest free spot --------
  type Box = { x0: number; y0: number; x1: number; y1: number };
  const taken: Box[] = [];
  const segs: number[][] = [];
  const fills: { x: number; y: number }[][] = [];
  const layoutReset = () => { taken.length = 0; segs.length = 0; fills.length = 0; };
  const blockLine = (x1: number, y1: number, x2: number, y2: number) => { segs.push([x1, y1, x2, y2]); };
  const blockPoly = (pts: { x: number; y: number }[]) =>
    pts.forEach((p, i) => { const q = pts[(i + 1) % pts.length]; blockLine(p.x, p.y, q.x, q.y); });
  /** A filled shape: no label may cross its outline or sit inside it. */
  const blockFill = (pts: { x: number; y: number }[]) => { blockPoly(pts); fills.push(pts); };
  const inside = (x: number, y: number, pts: { x: number; y: number }[]) => {
    let hit = false;
    for (let i = 0, j = pts.length - 1; i < pts.length; j = i++)
      if ((pts[i].y > y) !== (pts[j].y > y) && x < ((pts[j].x - pts[i].x) * (y - pts[i].y)) / (pts[j].y - pts[i].y) + pts[i].x) hit = !hit;
    return hit;
  };
  const blockDot = (x: number, y: number, r: number) => { taken.push({ x0: x - r, y0: y - r, x1: x + r, y1: y + r }); };
  /** Does the segment cross the box? (Liang–Barsky clipping.) */
  function crosses(s: number[], b: Box) {
    const [x1, y1, x2, y2] = s;
    const dx = x2 - x1, dy = y2 - y1;
    const p = [-dx, dx, -dy, dy], q = [x1 - b.x0, b.x1 - x1, y1 - b.y0, b.y1 - y1];
    let t0 = 0, t1 = 1;
    for (let i = 0; i < 4; i++) {
      if (p[i] === 0) { if (q[i] < 0) return false; continue; }
      const r = q[i] / p[i];
      if (p[i] < 0) { if (r > t1) return false; if (r > t0) t0 = r; }
      else { if (r < t0) return false; if (r < t1) t1 = r; }
    }
    return true;
  }
  const overlap = (a: Box, b: Box) =>
    Math.max(0, Math.min(a.x1, b.x1) - Math.max(a.x0, b.x0)) * Math.max(0, Math.min(a.y1, b.y1) - Math.max(a.y0, b.y0));
  /**
   * Draw `text` next to the point (ax, ay): on it if `onSpot`, otherwise just
   * beyond it in the direction `prefer` (radians, screen axes), swinging round
   * and stepping out until the box crosses no line and no other label. With
   * `onlyIfFree`, only the spot itself and small nudges of it are tried, and
   * nothing is drawn (false is returned) when none of them is clean.
   */
  function place(text: string, size: number, colour: string, ax: number, ay: number, prefer = -Math.PI / 4, onSpot = false, gap = 7, onlyIfFree = false) {
    const w = textWidth(text, size) + 6, h = size * 1.42 + 4;
    const cands: [number, number][] = onSpot || onlyIfFree ? [[ax, ay]] : [];
    if (onlyIfFree) for (const dy of [0, -6, 6, -12, 12]) for (const dx of [0, -8, 8, -16, 16]) cands.push([ax + dx, ay + dy]);
    else for (const step of [0, 1, 2, 3, 5, 7, 10, 14, 19]) {
      for (let k = 0; k < 12; k++) {
        const an = prefer + (k % 2 ? 1 : -1) * Math.ceil(k / 2) * (Math.PI / 6);
        const c = Math.cos(an), s = Math.sin(an);
        const edge = Math.min(Math.abs(c) > 1e-6 ? w / 2 / Math.abs(c) : 1e9, Math.abs(s) > 1e-6 ? h / 2 / Math.abs(s) : 1e9);
        const d = gap + step * 9 + edge;
        cands.push([ax + c * d, ay + s * d]);
      }
    }
    let best = cands[0], bestCost = Infinity;
    cands.forEach(([cx, cy], i) => {
      const b = { x0: cx - w / 2, y0: cy - h / 2, x1: cx + w / 2, y1: cy + h / 2 };
      let cost = i * 0.6;
      if (b.x0 < 2 || b.y0 < 2 || b.x1 > W - 2 || b.y1 > H - 2) cost += 1e5;
      for (const s of segs) if (crosses(s, b)) cost += 1000;
      for (const t of taken) cost += overlap(b, t) * 30;
      for (const f of fills) if (inside(cx, cy, f)) cost += 1000;
      if (cost < bestCost) { bestCost = cost; best = [cx, cy]; }
    });
    if (onlyIfFree && bestCost >= 1000) return false;
    const [cx, cy] = best;
    taken.push({ x0: cx - w / 2, y0: cy - h / 2, x1: cx + w / 2, y1: cy + h / 2 });
    label(text, cx, cy + size * 1.42 * 0.34, 1, 'center', size, colour);
    return true;
  }

  /** Grid lines from −R to R reach every corner of the stage, however hard M squeezes. */
  function reach(m: Mat) {
    const far = Math.hypot(Math.max(ORIGIN.x, W - ORIGIN.x), Math.max(ORIGIN.y, H - ORIGIN.y)) / UNIT;
    const S = m.a * m.a + m.b * m.b + m.c * m.c + m.d * m.d, D = m.a * m.d - m.b * m.c;
    const smin = Math.sqrt(Math.max(0, (S - Math.sqrt(Math.max(0, S * S - 4 * D * D))) / 2));
    return Math.min(80, Math.ceil(far / Math.max(smin, 0.04)) + 1);
  }

  function arrowTo(p: { px: number; py: number }, color: string, width = 3) {
    ctx.strokeStyle = color;
    ctx.fillStyle = color;
    ctx.lineWidth = width;
    ctx.beginPath(); ctx.moveTo(ORIGIN.x, ORIGIN.y); ctx.lineTo(p.px, p.py); ctx.stroke();
    const ang = Math.atan2(p.py - ORIGIN.y, p.px - ORIGIN.x);
    ctx.beginPath();
    ctx.moveTo(p.px, p.py);
    ctx.lineTo(p.px - 12 * Math.cos(ang - 0.4), p.py - 12 * Math.sin(ang - 0.4));
    ctx.lineTo(p.px - 12 * Math.cos(ang + 0.4), p.py - 12 * Math.sin(ang + 0.4));
    ctx.closePath();
    ctx.fill();
    blockLine(ORIGIN.x, ORIGIN.y, p.px, p.py);
    blockDot(p.px, p.py, 7);
  }
  /** The direction an arrow points on screen, so its name goes past the tip. */
  const away = (p: { px: number; py: number }) =>
    Math.hypot(p.px - ORIGIN.x, p.py - ORIGIN.y) > 4 ? Math.atan2(p.py - ORIGIN.y, p.px - ORIGIN.x) : -Math.PI / 4;

  /** The F, where it started (faint, dashed) and where M sends it. */
  function drawFigure() {
    const outline = (map: (x: number, y: number) => { px: number; py: number }) => {
      const pts = FIG_PTS.map(([x, y]) => xy(map(x, y)));
      ctx.beginPath();
      pts.forEach((p, k) => (k ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y)));
      ctx.closePath();
      blockFill(pts);
    };
    if (view.showGhost) {
      outline(rawToScreen);
      ctx.strokeStyle = ink(0.32);
      ctx.lineWidth = 1.2;
      ctx.setLineDash([4, 4]);
      ctx.stroke();
      ctx.setLineDash([]);
    }
    outline(toScreen);
    ctx.fillStyle = 'rgba(244,114,182,0.26)';
    ctx.fill();
    ctx.strokeStyle = FIG;
    ctx.lineWidth = 1.6;
    ctx.stroke();
  }

  /** The free vector, drawn where it started and where A sends it, built from x·Aî then y·Aĵ. */
  function drawVector() {
    const p = rawToScreen(vec.x, vec.y);
    const q = toScreen(vec.x, vec.y);
    const ai = toScreen(1, 0);
    const mid = { px: ORIGIN.x + vec.x * (ai.px - ORIGIN.x), py: ORIGIN.y + vec.x * (ai.py - ORIGIN.y) };
    const seg = (x1: number, y1: number, x2: number, y2: number, col: string, dash: number[]) => {
      ctx.strokeStyle = col;
      ctx.lineWidth = 1.5;
      ctx.setLineDash(dash);
      ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke();
      ctx.setLineDash([]);
      blockLine(x1, y1, x2, y2);
    };
    seg(ORIGIN.x, ORIGIN.y, mid.px, mid.py, IH, [5, 4]);
    seg(mid.px, mid.py, q.px, q.py, JH, [5, 4]);
    seg(ORIGIN.x, ORIGIN.y, p.px, p.py, ink(0.4), [3, 4]);
    arrowTo(q, VEC);
    ctx.strokeStyle = VEC;
    ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(p.px, p.py, 6, 0, Math.PI * 2); ctx.stroke();
    blockDot(p.px, p.py, 8);
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    layoutReset();
    if (view.showGhost) {
      const R = reach({ a: 1, b: 0, c: 0, d: 1 });
      ctx.strokeStyle = ink(0.12);
      ctx.lineWidth = 1;
      ctx.setLineDash([3, 4]);
      ctx.beginPath();
      for (let i = -R; i <= R; i++) {
        const a1 = rawToScreen(i, -R), a2 = rawToScreen(i, R), b1 = rawToScreen(-R, i), b2 = rawToScreen(R, i);
        ctx.moveTo(a1.px, a1.py); ctx.lineTo(a2.px, a2.py); ctx.moveTo(b1.px, b1.py); ctx.lineTo(b2.px, b2.py);
      }
      ctx.stroke();
      ctx.setLineDash([]);
    }
    const R = reach(M);
    ctx.strokeStyle = ink(0.2);
    ctx.lineWidth = 1;
    ctx.beginPath();
    for (let i = -R; i <= R; i++) {
      const a1 = toScreen(i, -R), a2 = toScreen(i, R), b1 = toScreen(-R, i), b2 = toScreen(R, i);
      ctx.moveTo(a1.px, a1.py); ctx.lineTo(a2.px, a2.py); ctx.moveTo(b1.px, b1.py); ctx.lineTo(b2.px, b2.py);
    }
    ctx.stroke();

    const det = M.a * M.d - M.b * M.c;
    const o = toScreen(0, 0), i = toScreen(1, 0), ij = toScreen(1, 1), j = toScreen(0, 1);
    ctx.fillStyle = det >= 0 ? 'rgba(94,234,212,0.14)' : 'rgba(248,113,113,0.16)';
    ctx.beginPath(); ctx.moveTo(o.px, o.py); ctx.lineTo(i.px, i.py); ctx.lineTo(ij.px, ij.py); ctx.lineTo(j.px, j.py); ctx.closePath(); ctx.fill();
    blockPoly([xy(o), xy(i), xy(ij), xy(j)]);
    if (Math.abs(det) < 0.02) {
      // the whole plane on one line: keep names off it
      const k = Math.hypot(i.px - o.px, i.py - o.py) > Math.hypot(j.px - o.px, j.py - o.py) ? i : j;
      const L = Math.hypot(k.px - o.px, k.py - o.py);
      if (L > 1) blockLine(o.px - ((k.px - o.px) / L) * 3000, o.py - ((k.py - o.py) / L) * 3000, o.px + ((k.px - o.px) / L) * 3000, o.py + ((k.py - o.py) / L) * 3000);
    }

    if (view.showFig) drawFigure();
    arrowTo(i, IH);
    arrowTo(j, JH);
    if (view.showVec) drawVector();

    // names last, each in the first free spot past its tip
    place('î', 13, IH, i.px, i.py, away(i));
    place('ĵ', 13, JH, j.px, j.py, away(j));
    if (view.showVec) {
      const q = toScreen(vec.x, vec.y), p = rawToScreen(vec.x, vec.y);
      place('Av', 13, VEC, q.px, q.py, away(q));
      place('v', 12, ink(0.75), p.px, p.py, away(p) + Math.PI / 2);
    }

    const vo = { x: M.a * vec.x + M.b * vec.y, y: M.c * vec.x + M.d * vec.y };
    (['a', 'b', 'c', 'd'] as const).forEach((k) => (el('m-' + k).textContent = M[k].toFixed(2)));
    const detA = A.a * A.d - A.b * A.c;
    const turned = view.path === 'polar' ? (angleOf() * view.t * 180) / Math.PI : null;
    const pathNote =
      view.path === 'linear'
        ? 'Straight blend: each entry slides from I to A on its own, so a rotation cuts the corner and the grid shrinks on the way.'
        : detA < 0
          ? 'A turns the plane over, so any path from I has to pass through det 0 on the way; here the stretch part does it.'
          : 'Turn + stretch: the frame is R(tθ) times a blend of A\'s symmetric stretch, so a rotation stays a rotation the whole way.';
    setEq({
      rule: ['A(x,y) = x\\,', ['A\\hat{\\imath}', IH], '+\\;y\\,', ['A\\hat{\\jmath}', JH], '\\qquad\\det A = ad-bc'],
      live: [[`A\\hat{\\imath}=(${M.a.toFixed(2)},${M.c.toFixed(2)})`, IH], [`\\quad A\\hat{\\jmath}=(${M.b.toFixed(2)},${M.d.toFixed(2)})`, JH], `\\quad\\det A = ${det.toFixed(3)}`],
    });
    setResult({
      value: det.toFixed(3),
      colour: Math.abs(det) < 0.02 ? '#f87171' : det >= 0 ? JH : '#f87171',
      status: `t = ${view.t.toFixed(2)} · ${Math.abs(det) < 0.02 ? 'flattened onto a line' : `î → (${M.a.toFixed(2)}, ${M.c.toFixed(2)}) · ĵ → (${M.b.toFixed(2)}, ${M.d.toFixed(2)})${det < 0 ? ' · orientation reversed' : ''}`}`,
      note: view.t >= 0.999 ? 'The two columns are just where the basis lands; every other vector follows by adding.' : pathNote,
    });
    setRows({
      'r-i': `(${M.a.toFixed(2)}, ${M.c.toFixed(2)})`,
      'r-j': `(${M.b.toFixed(2)}, ${M.d.toFixed(2)})`,
      'r-v': view.showVec ? `(${vec.x.toFixed(2)}, ${vec.y.toFixed(2)})` : '—',
      'r-av': view.showVec ? `(${vo.x.toFixed(2)}, ${vo.y.toFixed(2)})` : '—',
      'r-turn': turned === null ? '—' : `${turned.toFixed(1)}°`,
    });
  }

  const sync = matrix(A, ['a', 'b', 'c', 'd'], () => { recompute(); fit(); draw(); });
  const setT = slider('t', (v) => { cancelAnimationFrame(raf); view.t = v / 100; recompute(); draw(); }, (v) => (v / 100).toFixed(2));
  function preset(m: string) {
    cancelAnimationFrame(raf);
    const [a, b, c, d] = m.split(',').map(Number);
    Object.assign(A, { a, b, c, d });
    view.t = 1;
    setT(100);
    sync();
    recompute();
    fit();
    draw();
  }
  const presets = segmented('presets', preset);
  const paths = segmented('path', (p) => { view.path = p; recompute(); fit(); draw(); });
  segmented('zoom', (z) => { view.zoom = z; fit(); draw(); });
  check('ghost', (on) => { view.showGhost = on; draw(); });
  check('fig', (on) => { view.showFig = on; fit(); draw(); });
  const setVec = check('vec', (on) => { view.showVec = on; fit(); draw(); });
  let raf = 0;
  el('run').addEventListener('click', () => {
    cancelAnimationFrame(raf);
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min(1, (now - start) / 1100);
      view.t = p;
      setT(Math.round(p * 100));
      recompute();
      draw();
      if (p < 1) raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);
  });

  function show(m: string, path: string) {
    presets.select(m);
    preset(m);
    view.path = path;
    paths.select(path);
    recompute();
    fit();
    draw();
  }
  tries({
    shear: () => {
      show('1,1,0,1', 'polar');
      Object.assign(vec, { x: 2, y: 1 });
      view.showVec = true;
      setVec(true);
      fit();
      draw();
    },
    turn: () => { show('0,-1,1,0', 'polar'); el('run').click(); },
    blend: () => { show('0,-1,1,0', 'linear'); el('run').click(); },
  });

  // drag the basis tips where they land, and the free vector at its input tip
  type Handle = 'i' | 'j' | 'v';
  let dragging: Handle | null = null;
  const mouse = (e: PointerEvent) => {
    const rect = canvas.getBoundingClientRect();
    return { mx: ((e.clientX - rect.left) / rect.width) * W, my: ((e.clientY - rect.top) / rect.height) * H };
  };
  function near(e: PointerEvent, which: Handle) {
    if (which === 'v' && !view.showVec) return false;
    const { mx, my } = mouse(e);
    const t = which === 'i' ? toScreen(1, 0) : which === 'j' ? toScreen(0, 1) : rawToScreen(vec.x, vec.y);
    return Math.hypot(mx - t.px, my - t.py) < 16;
  }
  canvas.addEventListener('pointerdown', (e) => {
    dragging = near(e, 'i') ? 'i' : near(e, 'j') ? 'j' : near(e, 'v') ? 'v' : null;
    if (dragging) {
      if (dragging !== 'v') { cancelAnimationFrame(raf); view.t = 1; setT(100); recompute(); presets.clear(); }
      canvas.setPointerCapture(e.pointerId);
    }
  });
  canvas.addEventListener('pointermove', (e) => {
    if (!dragging) {
      canvas.style.cursor = near(e, 'i') || near(e, 'j') || near(e, 'v') ? 'grab' : 'default';
      return;
    }
    const { mx, my } = mouse(e);
    const wx = (mx - ORIGIN.x) / UNIT, wy = (ORIGIN.y - my) / UNIT;
    const snap = (v: number) => (Math.abs(v - Math.round(v)) < 0.08 ? Math.round(v) : +v.toFixed(2));
    if (dragging === 'v') {
      vec.x = Math.max(-8, Math.min(8, snap(wx)));
      vec.y = Math.max(-5, Math.min(5, snap(wy)));
      draw();
      return;
    }
    if (dragging === 'i') { A.a = Math.max(-3, Math.min(3, snap(wx))); A.c = Math.max(-3, Math.min(3, snap(wy))); }
    else { A.b = Math.max(-3, Math.min(3, snap(wx))); A.d = Math.max(-3, Math.min(3, snap(wy))); }
    sync();
    recompute();
    draw();
  });
  // the zoom holds still under the pointer while dragging, and refits after
  const endDrag = () => {
    if (!dragging) return;
    dragging = null;
    fit();
    draw();
  };
  canvas.addEventListener('pointerup', endDrag);
  canvas.addEventListener('pointercancel', endDrag);

  recompute();
  fit();
  draw();
</script>

<style>
  #lin {
    touch-action: none;
  }
</style>
