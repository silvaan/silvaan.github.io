---
import SimLayout from '../../../layouts/SimLayout.astro';
---

<SimLayout
  areaSlug="linear-algebra"
  title="Linear Transformations"
  description="A linear map is fully described by where it sends the basis vectors. Drag the tips of î and ĵ, sweep the transform in from the identity, and reveal the eigen-directions that never rotate."
>
  <div class="sim">
    <div class="sim-stage">
      <canvas id="lin" width="760" height="640"></canvas>
    </div>

    <div class="sim-panel">
      <div class="control">
        <label>Transformation matrix</label>
        <div class="matrix-view" aria-label="current matrix">
          <span class="bracket" aria-hidden="true"></span>
          <div class="matrix-cells">
            <b id="m-a">1.00</b><b id="m-b">0.00</b>
            <b id="m-c">0.00</b><b id="m-d">1.00</b>
          </div>
          <span class="bracket" aria-hidden="true"></span>
        </div>
        <div class="mgrid">
          <div><label>a <b id="aval">1.00</b></label><input type="range" id="a" min="-3" max="3" step="0.05" value="1"></div>
          <div><label>b <b id="bval">0.00</b></label><input type="range" id="b" min="-3" max="3" step="0.05" value="0"></div>
          <div><label>c <b id="cval">0.00</b></label><input type="range" id="c" min="-3" max="3" step="0.05" value="0"></div>
          <div><label>d <b id="dval">1.00</b></label><input type="range" id="d" min="-3" max="3" step="0.05" value="1"></div>
        </div>
      </div>

      <div class="control">
        <label>Interpolate&nbsp;&nbsp;I → A <b id="tval">1.00</b></label>
        <input type="range" id="t" min="0" max="1" step="0.01" value="1" />
        <div class="row-controls">
          <button class="btn ghost" id="animate">Animate</button>
          <label class="check">
            <input type="checkbox" id="eig" /> Eigenvectors
          </label>
          <label class="check">
            <input type="checkbox" id="ghost" checked /> Keep the original grid
          </label>
          <label class="check">
            <input type="checkbox" id="vec" checked /> A vector to drag
          </label>
        </div>
      </div>

      <div class="control">
        <label>Presets</label>
        <div class="seg" id="presets">
          <button data-m="1,0,0,1">Identity</button>
          <button data-m="0,-1,1,0">Rotate 90°</button>
          <button data-m="1,1,0,1">Shear</button>
          <button data-m="-1,0,0,1">Reflect</button>
          <button data-m="1.5,0,0,0.5">Scale</button>
          <button data-m="1,1,1,1">Collapse</button>
        </div>
      </div>

      <div class="readout">
        <div class="row"><span>î → </span><b id="ihat">(1, 0)</b></div>
        <div class="row"><span>ĵ → </span><b id="jhat">(0, 1)</b></div>
        <div class="row"><span>v</span><b id="vin">—</b></div>
        <div class="row"><span>Av</span><b id="vout">—</b></div>
        <div class="row"><span>Determinant</span><b id="det">1.000</b></div>
        <div class="row"><span>Eigenvalues</span><b id="eigval">1, 1</b></div>
      </div>
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Drag the tip of <b>î</b> (indigo) or <b>ĵ</b> (teal). The whole grid follows:
      a linear map is nothing more than where the two basis vectors land.
    </li>
    <li>
      Leave <b>Keep the original grid</b> on and the dotted grid stays where it
      was, so the solid one has something to move against. Every solid line is
      still straight, still evenly spaced, still parallel to its neighbours:
      that, and the origin staying put, is the whole of what <b>linear</b> means.
    </li>
    <li>
      Drag the ring marked <b>v</b>, an ordinary vector that is not a basis
      vector. The two dashed pieces show how its image is assembled: go
      <b>x</b> times where î landed, then <b>y</b> times where ĵ landed. Nothing
      else is ever needed, which is what makes the map linear.
    </li>
    <li>
      Watch the shaded unit square. Its signed area <b>is</b> the determinant;
      pick <b>Collapse</b> and the plane flattens onto a line as
      <b>det → 0</b> (and the map becomes non-invertible).
    </li>
    <li>
      Turn on <b>Eigenvectors</b>. Those dashed lines are the directions that
      only <b>stretch</b>, never rotate, scaled by their eigenvalue. Rotations
      have none (the values go complex).
    </li>
    <li>
      Slide <b>Interpolate</b> or hit <b>Animate</b> to sweep continuously from
      the identity to the matrix, the moving-picture view of a transformation.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas } from '../../../lib/sim';
  import { equationBar } from '../../../lib/equation';

  // A = the target matrix set by sliders / presets / dragging.
  // M = the matrix actually drawn, interpolated from the identity by t.
  const A = { a: 1, b: 0, c: 0, d: 1 };
  const M = { a: 1, b: 0, c: 0, d: 1 };
  const view = { t: 1, showEig: false, showGhost: true, showVec: true };
  // a free vector the reader can drag, to watch A act on something that is not
  // a basis vector
  const vec = { x: 2, y: 1 };
  const VEC_COL = '#fbbf24';

  const setEq = equationBar();
  const canvas = document.getElementById('lin') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const ORIGIN = { x: W / 2, y: H / 2 };
  const UNIT = 52;
  const css = (v: string) =>
    getComputedStyle(canvas).getPropertyValue(v).trim();

  function recompute() {
    const t = view.t;
    M.a = (1 - t) * 1 + t * A.a;
    M.b = t * A.b;
    M.c = t * A.c;
    M.d = (1 - t) * 1 + t * A.d;
  }

  // world (math) coords -> screen pixels, applying the displayed matrix M
  function toScreen(x: number, y: number) {
    const tx = M.a * x + M.b * y;
    const ty = M.c * x + M.d * y;
    return { px: ORIGIN.x + tx * UNIT, py: ORIGIN.y - ty * UNIT };
  }
  // raw math coords -> pixels, no transform (for eigen-lines)
  const rawToScreen = (x: number, y: number) => ({
    px: ORIGIN.x + x * UNIT,
    py: ORIGIN.y - y * UNIT,
  });

  function line(x1: number, y1: number, x2: number, y2: number) {
    const p = toScreen(x1, y1);
    const q = toScreen(x2, y2);
    ctx.beginPath();
    ctx.moveTo(p.px, p.py);
    ctx.lineTo(q.px, q.py);
    ctx.stroke();
  }

  function arrow(x: number, y: number, color: string, label: string) {
    const p = toScreen(x, y);
    ctx.strokeStyle = color;
    ctx.fillStyle = color;
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(ORIGIN.x, ORIGIN.y);
    ctx.lineTo(p.px, p.py);
    ctx.stroke();
    const ang = Math.atan2(p.py - ORIGIN.y, p.px - ORIGIN.x);
    ctx.beginPath();
    ctx.moveTo(p.px, p.py);
    ctx.lineTo(p.px - 12 * Math.cos(ang - 0.4), p.py - 12 * Math.sin(ang - 0.4));
    ctx.lineTo(p.px - 12 * Math.cos(ang + 0.4), p.py - 12 * Math.sin(ang + 0.4));
    ctx.closePath();
    ctx.fill();
    ctx.font = "600 14px 'JetBrains Mono', monospace";
    ctx.fillText(label, p.px + 8, p.py - 8);
  }

  type Eig = { l: number; v: [number, number] };
  function eigen(m: typeof M): Eig[] {
    const tr = m.a + m.d;
    const det = m.a * m.d - m.b * m.c;
    const disc = (tr * tr) / 4 - det;
    if (disc < -1e-9) return []; // complex eigenvalues → no real invariant line
    const s = Math.sqrt(Math.max(0, disc));
    const ls = [tr / 2 + s, tr / 2 - s];
    const norm = (x: number, y: number): [number, number] => {
      const n = Math.hypot(x, y) || 1;
      return [x / n, y / n];
    };
    const vecFor = (l: number): [number, number] => {
      if (Math.abs(m.b) > 1e-9) return norm(m.b, l - m.a);
      if (Math.abs(m.c) > 1e-9) return norm(l - m.d, m.c);
      return Math.abs(m.a - l) < 1e-9 ? [1, 0] : [0, 1];
    };
    const out: Eig[] = [{ l: ls[0], v: vecFor(ls[0]) }];
    if (Math.abs(ls[0] - ls[1]) > 1e-6) out.push({ l: ls[1], v: vecFor(ls[1]) });
    return out;
  }

  function drawEigen() {
    const eigs = eigen(M);
    const el = document.getElementById('eigval') as HTMLElement;
    el.textContent = eigs.length
      ? eigs.map((e) => e.l.toFixed(2)).join(', ')
      : 'complex';
    if (!view.showEig || eigs.length === 0) return;
    const color = '#fbbf24';
    for (const e of eigs) {
      const [vx, vy] = e.v;
      const L = 9;
      const p1 = rawToScreen(vx * L, vy * L);
      const p2 = rawToScreen(-vx * L, -vy * L);
      ctx.strokeStyle = color;
      ctx.lineWidth = 1.5;
      ctx.setLineDash([7, 5]);
      ctx.beginPath();
      ctx.moveTo(p1.px, p1.py);
      ctx.lineTo(p2.px, p2.py);
      ctx.stroke();
      ctx.setLineDash([]);
      // arrow showing the eigenvalue as a stretch of the unit eigenvector
      const lc = Math.max(-3.2, Math.min(3.2, e.l));
      const tip = rawToScreen(vx * lc, vy * lc);
      ctx.strokeStyle = color;
      ctx.fillStyle = color;
      ctx.lineWidth = 2.5;
      ctx.beginPath();
      ctx.moveTo(ORIGIN.x, ORIGIN.y);
      ctx.lineTo(tip.px, tip.py);
      ctx.stroke();
      const ang = Math.atan2(tip.py - ORIGIN.y, tip.px - ORIGIN.x);
      ctx.beginPath();
      ctx.moveTo(tip.px, tip.py);
      ctx.lineTo(tip.px - 10 * Math.cos(ang - 0.4), tip.py - 10 * Math.sin(ang - 0.4));
      ctx.lineTo(tip.px - 10 * Math.cos(ang + 0.4), tip.py - 10 * Math.sin(ang + 0.4));
      ctx.closePath();
      ctx.fill();
      ctx.font = "600 12px 'JetBrains Mono', monospace";
      ctx.fillText('λ=' + e.l.toFixed(2), p1.px + 6, p1.py - 4);
    }
  }

  /**
   * The free vector, drawn twice: where it started (dashed, draggable) and where
   * A sends it, reached along x·Aî then y·Aĵ so the image is visibly built out
   * of the two columns.
   */
  function drawVector(accent: string, teal: string, faint: string) {
    const p = rawToScreen(vec.x, vec.y);
    const q = toScreen(vec.x, vec.y);
    const ai = toScreen(1, 0);
    const mid = {
      px: ORIGIN.x + vec.x * (ai.px - ORIGIN.x),
      py: ORIGIN.y + vec.x * (ai.py - ORIGIN.y),
    };

    const seg = (
      x1: number, y1: number, x2: number, y2: number, col: string, dash: number[]
    ) => {
      ctx.strokeStyle = col;
      ctx.lineWidth = 1.5;
      ctx.setLineDash(dash);
      ctx.beginPath();
      ctx.moveTo(x1, y1);
      ctx.lineTo(x2, y2);
      ctx.stroke();
      ctx.setLineDash([]);
    };
    // x·Aî then y·Aĵ, in the colours of the two basis images
    seg(ORIGIN.x, ORIGIN.y, mid.px, mid.py, accent, [5, 4]);
    seg(mid.px, mid.py, q.px, q.py, teal, [5, 4]);
    // where the vector was before the transformation
    seg(ORIGIN.x, ORIGIN.y, p.px, p.py, faint, [3, 4]);

    ctx.strokeStyle = VEC_COL;
    ctx.fillStyle = VEC_COL;
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(ORIGIN.x, ORIGIN.y);
    ctx.lineTo(q.px, q.py);
    ctx.stroke();
    const ang = Math.atan2(q.py - ORIGIN.y, q.px - ORIGIN.x);
    ctx.beginPath();
    ctx.moveTo(q.px, q.py);
    ctx.lineTo(q.px - 12 * Math.cos(ang - 0.4), q.py - 12 * Math.sin(ang - 0.4));
    ctx.lineTo(q.px - 12 * Math.cos(ang + 0.4), q.py - 12 * Math.sin(ang + 0.4));
    ctx.closePath();
    ctx.fill();
    ctx.font = "600 14px 'JetBrains Mono', monospace";
    ctx.fillText('Av', q.px + 8, q.py - 8);

    // the handle: a ring at the untransformed tip, which is what you drag
    ctx.strokeStyle = VEC_COL;
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(p.px, p.py, 6, 0, Math.PI * 2);
    ctx.stroke();
    ctx.fillStyle = faint;
    ctx.font = "12px 'JetBrains Mono', monospace";
    ctx.fillText('v', p.px + 10, p.py + 4);
  }

  function draw() {
    const grid = css('--border') || '#262a32';
    const accent = css('--accent') || '#7c8cff';
    const teal = css('--accent-2') || '#5eead4';
    ctx.clearRect(0, 0, W, H);

    const R = 7;
    // the untransformed grid, left in place as a ruler to measure the moving
    // one against: without it there is nothing to say how far anything moved
    if (view.showGhost) {
      ctx.strokeStyle = grid;
      ctx.lineWidth = 1;
      ctx.globalAlpha = 0.4;
      ctx.setLineDash([3, 4]);
      ctx.beginPath();
      for (let i = -R; i <= R; i++) {
        const a1 = rawToScreen(i, -R), a2 = rawToScreen(i, R);
        const b1 = rawToScreen(-R, i), b2 = rawToScreen(R, i);
        ctx.moveTo(a1.px, a1.py);
        ctx.lineTo(a2.px, a2.py);
        ctx.moveTo(b1.px, b1.py);
        ctx.lineTo(b2.px, b2.py);
      }
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.globalAlpha = 1;
    }

    // transformed grid
    ctx.strokeStyle = grid;
    ctx.lineWidth = 1;
    ctx.globalAlpha = 0.9;
    for (let i = -R; i <= R; i++) {
      line(i, -R, i, R);
      line(-R, i, R, i);
    }
    ctx.globalAlpha = 1;

    // determinant area (unit square image)
    const det = M.a * M.d - M.b * M.c;
    const o = toScreen(0, 0);
    const i = toScreen(1, 0);
    const ij = toScreen(1, 1);
    const j = toScreen(0, 1);
    ctx.fillStyle = det >= 0 ? 'rgba(94,234,212,0.12)' : 'rgba(248,113,113,0.14)';
    ctx.beginPath();
    ctx.moveTo(o.px, o.py);
    ctx.lineTo(i.px, i.py);
    ctx.lineTo(ij.px, ij.py);
    ctx.lineTo(j.px, j.py);
    ctx.closePath();
    ctx.fill();

    drawEigen();

    // basis vectors
    arrow(1, 0, accent, 'î');
    arrow(0, 1, teal, 'ĵ');

    if (view.showVec) drawVector(accent, teal, css('--text-faint') || '#6b7280');
    const vo = { x: M.a * vec.x + M.b * vec.y, y: M.c * vec.x + M.d * vec.y };
    (document.getElementById('vin') as HTMLElement).textContent = view.showVec
      ? `(${vec.x.toFixed(2)}, ${vec.y.toFixed(2)})`
      : '—';
    (document.getElementById('vout') as HTMLElement).textContent = view.showVec
      ? `(${vo.x.toFixed(2)}, ${vo.y.toFixed(2)})`
      : '—';

    // readouts (reflect the displayed matrix M)
    (document.getElementById('m-a') as HTMLElement).textContent = M.a.toFixed(2);
    (document.getElementById('m-b') as HTMLElement).textContent = M.b.toFixed(2);
    (document.getElementById('m-c') as HTMLElement).textContent = M.c.toFixed(2);
    (document.getElementById('m-d') as HTMLElement).textContent = M.d.toFixed(2);
    (document.getElementById('ihat') as HTMLElement).textContent = `(${M.a.toFixed(2)}, ${M.c.toFixed(2)})`;
    (document.getElementById('jhat') as HTMLElement).textContent = `(${M.b.toFixed(2)}, ${M.d.toFixed(2)})`;
    (document.getElementById('det') as HTMLElement).textContent = det.toFixed(3);
    setEq([
      [
        'A(x,y) = x\\,',
        ['A\\hat{\\imath}', accent],
        '+\\;y\\,',
        ['A\\hat{\\jmath}', teal],
        '\\quad\\det A = ad-bc',
      ],
      [
        [`A\\hat{\\imath}=(${M.a.toFixed(2)},${M.c.toFixed(2)})`, accent],
        [`\\quad A\\hat{\\jmath}=(${M.b.toFixed(2)},${M.d.toFixed(2)})`, teal],
        `\\quad\\det A = ${det.toFixed(3)}`,
      ],
      [
        'the two columns are just where the basis lands; every other vector follows by adding',
      ],
    ]);
  }

  // keep the a/b/c/d sliders + readout labels in sync with A
  function syncInputs() {
    (['a', 'b', 'c', 'd'] as const).forEach((k) => {
      (document.getElementById(k + 'val') as HTMLElement).textContent = A[k].toFixed(2);
      (document.getElementById(k) as HTMLInputElement).value = String(A[k]);
    });
  }
  function setT(t: number) {
    view.t = t;
    (document.getElementById('t') as HTMLInputElement).value = String(t);
    (document.getElementById('tval') as HTMLElement).textContent = t.toFixed(2);
  }

  (['a', 'b', 'c', 'd'] as const).forEach((k) => {
    const el = document.getElementById(k) as HTMLInputElement;
    el.addEventListener('input', () => {
      A[k] = +el.value;
      (document.getElementById(k + 'val') as HTMLElement).textContent = A[k].toFixed(2);
      recompute();
      draw();
    });
  });

  document.getElementById('t')!.addEventListener('input', (e) => {
    view.t = +(e.target as HTMLInputElement).value;
    (document.getElementById('tval') as HTMLElement).textContent = view.t.toFixed(2);
    recompute();
    draw();
  });

  document.getElementById('eig')!.addEventListener('change', (e) => {
    view.showEig = (e.target as HTMLInputElement).checked;
    draw();
  });

  document.getElementById('ghost')!.addEventListener('change', (e) => {
    view.showGhost = (e.target as HTMLInputElement).checked;
    draw();
  });

  document.getElementById('vec')!.addEventListener('change', (e) => {
    view.showVec = (e.target as HTMLInputElement).checked;
    draw();
  });

  let animRAF = 0;
  document.getElementById('animate')!.addEventListener('click', () => {
    cancelAnimationFrame(animRAF);
    const start = performance.now();
    const dur = 1100;
    setT(0);
    const tick = (now: number) => {
      const p = Math.min(1, (now - start) / dur);
      setT(+p.toFixed(3));
      recompute();
      draw();
      if (p < 1) animRAF = requestAnimationFrame(tick);
    };
    animRAF = requestAnimationFrame(tick);
  });

  document.getElementById('presets')!.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn) return;
    const [a, b, c, d] = btn.dataset.m!.split(',').map(Number);
    Object.assign(A, { a, b, c, d });
    setT(1);
    syncInputs();
    recompute();
    draw();
  });

  // ---- drag the basis-vector tips ----
  // î tip sits at math point (A.a, A.c); ĵ tip at (A.b, A.d) when t = 1.
  type Handle = 'i' | 'j' | 'v';
  let dragging: Handle | null = null;
  function tipPixel(which: Handle) {
    // î and ĵ are grabbed where they land; the free vector is grabbed at its
    // untransformed tip, since that is the input you are choosing
    if (which === 'i') return toScreen(1, 0);
    if (which === 'j') return toScreen(0, 1);
    return rawToScreen(vec.x, vec.y);
  }
  function near(e: PointerEvent, which: Handle) {
    if (which === 'v' && !view.showVec) return false;
    const rect = canvas.getBoundingClientRect();
    const mx = ((e.clientX - rect.left) / rect.width) * W;
    const my = ((e.clientY - rect.top) / rect.height) * H;
    const t = tipPixel(which);
    return Math.hypot(mx - t.px, my - t.py) < 16;
  }
  canvas.addEventListener('pointerdown', (e) => {
    dragging = near(e, 'i') ? 'i' : near(e, 'j') ? 'j' : near(e, 'v') ? 'v' : null;
    if (dragging) {
      if (dragging !== 'v') {
        setT(1); // snap to the full transform so the tip you grab is the one you set
        recompute();
      }
      canvas.setPointerCapture(e.pointerId);
    }
  });
  canvas.addEventListener('pointermove', (e) => {
    if (!dragging) {
      canvas.style.cursor =
        near(e, 'i') || near(e, 'j') || near(e, 'v') ? 'grab' : 'default';
      return;
    }
    const rect = canvas.getBoundingClientRect();
    const mx = ((e.clientX - rect.left) / rect.width) * W;
    const my = ((e.clientY - rect.top) / rect.height) * H;
    const wx = (mx - ORIGIN.x) / UNIT;
    const wy = (ORIGIN.y - my) / UNIT;
    const snap = (v: number) => (Math.abs(v - Math.round(v)) < 0.08 ? Math.round(v) : +v.toFixed(2));
    if (dragging === 'v') {
      vec.x = Math.max(-6, Math.min(6, snap(wx)));
      vec.y = Math.max(-6, Math.min(6, snap(wy)));
      draw();
      return;
    }
    if (dragging === 'i') {
      A.a = Math.max(-3, Math.min(3, snap(wx)));
      A.c = Math.max(-3, Math.min(3, snap(wy)));
    } else {
      A.b = Math.max(-3, Math.min(3, snap(wx)));
      A.d = Math.max(-3, Math.min(3, snap(wy)));
    }
    syncInputs();
    recompute();
    draw();
  });
  const endDrag = () => (dragging = null);
  canvas.addEventListener('pointerup', endDrag);
  canvas.addEventListener('pointercancel', endDrag);

  recompute();
  draw();
</script>

<style>
  /* the four entries in the shape of the matrix they are */
  .sim-panel .mgrid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 16px;
    margin-top: 12px;
  }
  .sim-panel .mgrid label {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
    margin-bottom: 3px;
  }
  .sim-panel .mgrid label b {
    color: var(--text);
    font-weight: 500;
  }
  .sim-panel .mgrid input[type='range'] {
    width: 100%;
    accent-color: var(--accent);
  }
  .row-controls {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 10px;
    flex-wrap: wrap;
  }
  .check {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.85rem;
    color: var(--text-muted);
    cursor: pointer;
  }
  .check input {
    accent-color: var(--accent);
    width: 15px;
    height: 15px;
  }
</style>
