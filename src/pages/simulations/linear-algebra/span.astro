---
import SimLayout from '../../../layouts/SimLayout.astro';
import Seg from '../../../components/sim/Seg.astro';
import Slider from '../../../components/sim/Slider.astro';
import Checks from '../../../components/sim/Checks.astro';
import Result from '../../../components/sim/Result.astro';
import Caption from '../../../components/sim/Caption.astro';
import Readout from '../../../components/sim/Readout.astro';
---

<SimLayout
  areaSlug="linear-algebra"
  title="Span"
  description="Everywhere you can reach by scaling and adding two vectors. Usually the whole plane, but line them up and it collapses to a line."
  shortcuts={['fullscreen']}
>
  <div class="sim">
    <div class="sim-view">
      <div class="sim-stage">
        <canvas
          id="span"
          width="1000"
          height="600"
          role="img"
          aria-label="Two basis vectors, the lattice of their combinations, the current combination and a target point."
        ></canvas>
      </div>
      <Caption
        legend={[
          { label: 'u₁', color: '#7c8cff' },
          { label: 'u₂', color: '#f59e0b' },
          { label: 'the combination a·u₁ + b·u₂', color: '#5eead4' },
          { label: 'target', color: 'rgba(232,233,236,0.9)' },
        ]}
        hint="Drag the tips of u₁ and u₂, or the target"
      />
      <Result label="The span of u<sub>1</sub>, u<sub>2</sub>" />
    </div>

    <div class="sim-panel">
      <Slider id="a" label="a, along u<sub>1</sub>" min={-3} max={3} step={0.05} value={1} display="1.00" />
      <Slider id="b" label="b, along u<sub>2</sub>" min={-3} max={3} step={0.05} value={1} display="1.00" />
      <Checks
        items={[
          { id: 'lattice', label: 'Show the combination lattice', checked: true },
          { id: 'solve', label: 'Solve a, b to hit the target' },
        ]}
      />
      <Seg
        id="presets"
        label="Presets"
        attr="m"
        options={[
          { value: '2,0.4,0.6,2', label: 'Independent' },
          { value: '1.6,0.8,0.8,0.4', label: 'Dependent' },
          { value: '1.5,0,0,1.5', label: 'Axes' },
        ]}
      />
      <Readout
        rows={[
          { id: 'r-det', label: 'det [u<sub>1</sub> u<sub>2</sub>]' },
          { id: 'r-v', label: 'combination v' },
          { id: 'r-reach', label: 'target reachable?' },
        ]}
      />
    </div>
  </div>

  <Fragment slot="observe">
    <li>
      Slide <b>a</b> and <b>b</b>: the teal dot sweeps out everything the two
      vectors can build. With independent u₁, u₂ the reachable set is the
      <b>whole plane</b> (shaded), so every target has exactly one pair (a, b).
    </li>
    <li>
      Now drag u₂ until it lies <b>along</b> u₁ (or use the Dependent preset).
      The shaded region collapses to a <b>line</b>: the vectors are linearly
      dependent, the determinant hits 0, and targets off that line become
      <b>unreachable</b>.
    </li>
    <li>
      Turn on <b>Solve</b> and drag the target around. The a, b that hit it are
      its <b>coordinates</b> in the u₁, u₂ basis, read straight off the lattice.
      Watch them explode as the basis gets close to degenerate.
    </li>
  </Fragment>
</SimLayout>

<script>
  import { setupCanvas, makeText } from '../../../lib/sim';
  import { equation } from '../../../lib/equation';
  import { stageInk } from '../../../lib/draw';
  import { el, segmented, slider, check, result, readout } from '../../../lib/panel';

  const U1 = '#7c8cff', U2 = '#f59e0b', TEAL = '#5eead4';
  const u1 = { x: 2, y: 0.4 }, u2 = { x: 0.6, y: 2 }, target = { x: 2.2, y: 1.4 };
  const state = { a: 1, b: 1, lattice: true, solve: false };

  const canvas = el('span') as HTMLCanvasElement;
  const { ctx, W, H } = setupCanvas(canvas, () => draw());
  const { ink, inv } = stageInk(canvas);
  const { label } = makeText(ctx, ink);
  const setEq = equation();
  const setResult = result();
  const setRows = readout();
  const O = { x: W / 2, y: H / 2 };
  const U = 70;
  const toPx = (x: number, y: number) => ({ px: O.x + x * U, py: O.y - y * U });
  const toWorld = (px: number, py: number) => ({ x: (px - O.x) / U, y: (O.y - py) / U });
  const det = () => u1.x * u2.y - u1.y * u2.x;

  function arrow(v: { x: number; y: number }, color: string, text: string) {
    const p = toPx(v.x, v.y);
    ctx.strokeStyle = color;
    ctx.fillStyle = color;
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(O.x, O.y);
    ctx.lineTo(p.px, p.py);
    ctx.stroke();
    const ang = Math.atan2(p.py - O.y, p.px - O.x);
    ctx.beginPath();
    ctx.moveTo(p.px, p.py);
    ctx.lineTo(p.px - 13 * Math.cos(ang - 0.4), p.py - 13 * Math.sin(ang - 0.4));
    ctx.lineTo(p.px - 13 * Math.cos(ang + 0.4), p.py - 13 * Math.sin(ang + 0.4));
    ctx.closePath();
    ctx.fill();
    label(text, p.px + 8, p.py - 8, 1, 'left', 13, color);
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    const D = det();
    const degenerate = Math.abs(D) < 0.06;
    const zero = Math.hypot(u1.x, u1.y) < 1e-6 && Math.hypot(u2.x, u2.y) < 1e-6;

    ctx.strokeStyle = ink(0.08);
    ctx.lineWidth = 1;
    for (let i = -7; i <= 7; i++) {
      const a = toPx(i, -5), b = toPx(i, 5), c = toPx(-7, i), e = toPx(7, i);
      ctx.beginPath(); ctx.moveTo(a.px, a.py); ctx.lineTo(b.px, b.py); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(c.px, c.py); ctx.lineTo(e.px, e.py); ctx.stroke();
    }

    // the span: the whole plane, tinted, or a single line
    if (!degenerate) {
      ctx.fillStyle = 'rgba(94,234,212,0.06)';
      ctx.fillRect(0, 0, W, H);
    } else if (!zero) {
      const dir = Math.hypot(u1.x, u1.y) > 1e-6 ? u1 : u2;
      const p1 = toPx(dir.x * 12, dir.y * 12), p2 = toPx(-dir.x * 12, -dir.y * 12);
      ctx.strokeStyle = 'rgba(94,234,212,0.5)';
      ctx.lineWidth = 10;
      ctx.beginPath(); ctx.moveTo(p1.px, p1.py); ctx.lineTo(p2.px, p2.py); ctx.stroke();
    }

    if (state.lattice) {
      ctx.strokeStyle = ink(0.13);
      ctx.lineWidth = 1;
      for (let i = -8; i <= 8; i++) {
        let s = toPx(u1.x * i - u2.x * 8, u1.y * i - u2.y * 8), e = toPx(u1.x * i + u2.x * 8, u1.y * i + u2.y * 8);
        ctx.beginPath(); ctx.moveTo(s.px, s.py); ctx.lineTo(e.px, e.py); ctx.stroke();
        s = toPx(u2.x * i - u1.x * 8, u2.y * i - u1.y * 8); e = toPx(u2.x * i + u1.x * 8, u2.y * i + u1.y * 8);
        ctx.beginPath(); ctx.moveTo(s.px, s.py); ctx.lineTo(e.px, e.py); ctx.stroke();
      }
    }

    // solving means reading the target's coordinates in this basis
    if (state.solve && !degenerate) {
      state.a = (target.x * u2.y - target.y * u2.x) / D;
      state.b = (u1.x * target.y - u1.y * target.x) / D;
      setA(Math.max(-3, Math.min(3, state.a)));
      setB(Math.max(-3, Math.min(3, state.b)));
    }

    // the two legs of a·u₁ + b·u₂
    const comb = { x: state.a * u1.x + state.b * u2.x, y: state.a * u1.y + state.b * u2.y };
    const pa = toPx(state.a * u1.x, state.a * u1.y), pc = toPx(comb.x, comb.y);
    ctx.strokeStyle = ink(0.4);
    ctx.setLineDash([4, 4]);
    ctx.lineWidth = 1.4;
    ctx.beginPath(); ctx.moveTo(O.x, O.y); ctx.lineTo(pa.px, pa.py); ctx.lineTo(pc.px, pc.py); ctx.stroke();
    ctx.setLineDash([]);

    arrow(u1, U1, 'u_1');
    arrow(u2, U2, 'u_2');

    const tp = toPx(target.x, target.y);
    ctx.fillStyle = ink(1);
    ctx.strokeStyle = inv(0.7);
    ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(tp.px, tp.py, 6.5, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
    label('target', tp.px + 9, tp.py - 8, 0.6, 'left', 11);
    ctx.fillStyle = TEAL;
    ctx.beginPath(); ctx.arc(pc.px, pc.py, 6, 0, Math.PI * 2); ctx.fill();
    label('v', pc.px + 9, pc.py + 14, 1, 'left', 12, TEAL);

    // words
    const spanName = degenerate ? (zero ? 'a single point' : 'a line') : 'the whole plane';
    let reach: string;
    if (!degenerate) reach = state.solve ? 'yes, and a, b are its coordinates' : 'yes, with a unique a, b';
    else {
      const dir = Math.hypot(u1.x, u1.y) > 1e-6 ? u1 : u2;
      const off = Math.abs(dir.x * target.y - dir.y * target.x) / (Math.hypot(dir.x, dir.y) || 1);
      reach = off < 0.12 ? 'only because it sits on the line' : 'no, it is off the span';
    }
    setEq({
      rule: ['\\mathbf v = a\\,', ['\\mathbf u_1', U1], '+\\;b\\,', ['\\mathbf u_2', U2]],
      live: [
        [`\\mathbf v = ${state.a.toFixed(2)}\\,\\mathbf u_1 ${state.b < 0 ? '-' : '+'} ${Math.abs(state.b).toFixed(2)}\\,\\mathbf u_2 = (${comb.x.toFixed(2)},\\,${comb.y.toFixed(2)})`, TEAL],
        `\\quad\\det[\\mathbf u_1\\,\\mathbf u_2] = ${D.toFixed(3)}`,
      ],
    });
    setResult({
      value: spanName,
      colour: degenerate ? U2 : TEAL,
      status: `det = ${D.toFixed(3)} · target ${reach}`,
      note: degenerate
        ? 'The determinant has died: the two arrows only reach their own line, and everything off it is out of reach.'
        : 'Two independent arrows reach everywhere. Every target has exactly one pair (a, b), which are its coordinates in this basis.',
    });
    setRows({ 'r-det': D.toFixed(3), 'r-v': `(${comb.x.toFixed(2)}, ${comb.y.toFixed(2)})`, 'r-reach': reach.split(',')[0] });
  }

  // --- controls ---------------------------------------------------------------
  const setSolve = check('solve', (on) => { state.solve = on; draw(); });
  const setA = slider('a', (v) => { state.a = v; if (state.solve) { state.solve = false; setSolve(false); } draw(); }, (v) => v.toFixed(2));
  const setB = slider('b', (v) => { state.b = v; if (state.solve) { state.solve = false; setSolve(false); } draw(); }, (v) => v.toFixed(2));
  check('lattice', (on) => { state.lattice = on; draw(); });
  segmented('presets', (m) => {
    const [a, b, c, d] = m.split(',').map(Number);
    u1.x = a; u1.y = b; u2.x = c; u2.y = d;
    draw();
  });

  let dragging: 'u1' | 'u2' | 'target' | null = null;
  const near = (px: number, py: number, v: { x: number; y: number }) => { const p = toPx(v.x, v.y); return Math.hypot(px - p.px, py - p.py) < 16; };
  const local = (e: PointerEvent) => {
    const r = canvas.getBoundingClientRect();
    return { x: ((e.clientX - r.left) / r.width) * W, y: ((e.clientY - r.top) / r.height) * H };
  };
  canvas.addEventListener('pointerdown', (e) => {
    const l = local(e);
    dragging = near(l.x, l.y, target) ? 'target' : near(l.x, l.y, u1) ? 'u1' : near(l.x, l.y, u2) ? 'u2' : null;
    if (dragging) canvas.setPointerCapture(e.pointerId);
  });
  canvas.addEventListener('pointermove', (e) => {
    const l = local(e);
    if (!dragging) {
      canvas.style.cursor = near(l.x, l.y, target) || near(l.x, l.y, u1) || near(l.x, l.y, u2) ? 'grab' : 'default';
      return;
    }
    const w = toWorld(l.x, l.y);
    const obj = dragging === 'u1' ? u1 : dragging === 'u2' ? u2 : target;
    obj.x = Math.max(-6, Math.min(6, +w.x.toFixed(2)));
    obj.y = Math.max(-4, Math.min(4, +w.y.toFixed(2)));
    draw();
  });
  const stop = () => (dragging = null);
  canvas.addEventListener('pointerup', stop);
  canvas.addEventListener('pointercancel', stop);

  draw();
</script>

<style>
  #span {
    touch-action: none;
  }
</style>
