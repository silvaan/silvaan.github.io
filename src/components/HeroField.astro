---
/**
 * The live picture at the top of the home page: particles carried by the van
 * der Pol oscillator, x' = y, y' = μ(1 − x²)y − x. Wherever they start they
 * end on the same loop, the limit cycle. Click to drop more. It pauses when
 * off screen, and draws a single still frame for reduced motion.
 */
---

<div class="hero-field">
  <canvas aria-label="Particles flowing in the phase plane of the van der Pol oscillator and settling onto its limit cycle" role="img"></canvas>
  <a class="hero-field-cap" href="/simulations/calculus/differential-equations">
    <span>x′ = y,&nbsp; y′ = μ(1 − x²)y − x</span>
    <span>every start ends on the same loop · click to drop particles →</span>
  </a>
</div>

<script>
  const wrap = document.querySelector<HTMLDivElement>('.hero-field')!;
  const canvas = wrap.querySelector('canvas')!;
  const ctx = canvas.getContext('2d')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const MU = 1;
  const N = 900;
  const LIFE = 260;
  // the field fades out towards the edge of this ellipse, so it has no corners
  const RX = 3.6, RY = 4.6;
  const edge = (x: number, y: number) => Math.hypot(x / RX, y / RY);
  type P = { x: number; y: number; px: number; py: number; age: number };
  let ps: P[] = [];
  let W = 0, H = 0, dpr = 1, scale = 1, cx = 0, cy = 0;
  let bg = '#0b0c0e', light = false;
  let running = false, visible = true, raf = 0;

  // the field, in phase-plane units
  const fx = (_x: number, y: number) => y;
  const fy = (x: number, y: number) => MU * (1 - x * x) * y - x;

  function spawn(p?: P, at?: [number, number]): P {
    // a random point in the ellipse the picture lives in, or near a click
    const a = Math.random() * Math.PI * 2, r = Math.sqrt(Math.random()) * 0.92;
    const x = at ? at[0] + (Math.random() - 0.5) * 0.4 : RX * r * Math.cos(a);
    const y = at ? at[1] + (Math.random() - 0.5) * 0.4 : RY * r * Math.sin(a);
    const q = p ?? ({} as P);
    q.x = q.px = x;
    q.y = q.py = y;
    q.age = at ? 0 : Math.floor(Math.random() * LIFE);
    return q;
  }

  function readTheme() {
    const cs = getComputedStyle(document.documentElement);
    bg = cs.getPropertyValue('--bg').trim() || '#0b0c0e';
    light = document.documentElement.dataset.theme === 'light';
  }

  function resize() {
    const r = wrap.getBoundingClientRect();
    dpr = Math.min(2, devicePixelRatio || 1);
    W = r.width;
    H = r.height;
    canvas.width = Math.round(W * dpr);
    canvas.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    // the loop reaches x = ±2 and y ≈ ±3; keep it inside the box
    scale = Math.min(W / 7.6, H / (2 * RY + 0.4));
    cx = W * (W > 700 ? 0.68 : 0.5);
    cy = H / 2;
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, W, H);
    if (!ps.length) ps = Array.from({ length: N }, () => spawn());
  }

  const toScreen = (x: number, y: number): [number, number] => [cx + x * scale, cy - y * scale];

  function step(dt: number) {
    for (const p of ps) {
      p.px = p.x;
      p.py = p.y;
      // midpoint step, shortened where the flow is fast so every particle
      // leaves a short dash rather than a long streak
      const kx = fx(p.x, p.y), ky = fy(p.x, p.y);
      const h = Math.min(dt, 0.045 / (Math.hypot(kx, ky) + 1e-9));
      const mx = p.x + kx * h / 2, my = p.y + ky * h / 2;
      p.x += fx(mx, my) * h;
      p.y += fy(mx, my) * h;
      if (++p.age > LIFE || edge(p.x, p.y) > 1) spawn(p);
    }
  }

  function draw() {
    // fade the last frame towards the background, leaving trails
    ctx.globalAlpha = light ? 0.16 : 0.1;
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, W, H);
    ctx.globalAlpha = 1;
    ctx.lineWidth = 1.3;
    ctx.lineCap = 'round';
    for (const p of ps) {
      const speed = Math.hypot(fx(p.x, p.y), fy(p.x, p.y));
      // slow particles indigo, fast ones teal
      const t = Math.min(1, speed / 6);
      const hue = 235 - t * 65;
      const fade =
        Math.min(1, p.age / 20) * Math.min(1, (LIFE - p.age) / 30) * Math.max(0, Math.min(1, (1 - edge(p.x, p.y)) / 0.35));
      ctx.strokeStyle = `hsla(${hue}, ${light ? 70 : 85}%, ${light ? 48 : 68}%, ${0.75 * fade})`;
      const [ax, ay] = toScreen(p.px, p.py);
      const [bx, by] = toScreen(p.x, p.y);
      ctx.beginPath();
      ctx.moveTo(ax, ay);
      ctx.lineTo(bx, by);
      ctx.stroke();
    }
  }

  function frame() {
    step(0.012);
    draw();
    raf = requestAnimationFrame(frame);
  }
  function setRunning(on: boolean) {
    if (reduce) return;
    if (on && !running) raf = requestAnimationFrame(frame);
    if (!on) cancelAnimationFrame(raf);
    running = on;
  }

  readTheme();
  resize();
  if (reduce) {
    // one still picture: run the flow forward without animating it
    for (let i = 0; i < 120; i++) (step(0.012), draw());
  } else setRunning(true);

  new ResizeObserver(() => {
    resize();
    if (reduce) for (let i = 0; i < 120; i++) (step(0.012), draw());
  }).observe(wrap);
  new IntersectionObserver(([e]) => {
    visible = e.isIntersecting;
    setRunning(visible && !document.hidden);
  }).observe(wrap);
  document.addEventListener('visibilitychange', () => setRunning(visible && !document.hidden));
  window.addEventListener('themechange', () => {
    readTheme();
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, W, H);
  });
  canvas.addEventListener('pointerdown', (e) => {
    const r = canvas.getBoundingClientRect();
    const x = (e.clientX - r.left - cx) / scale;
    const y = -(e.clientY - r.top - cy) / scale;
    // recycle the oldest particles as a burst where you clicked
    ps.sort((a, b) => b.age - a.age);
    for (let i = 0; i < 120; i++) spawn(ps[i], [x, y]);
    if (reduce) for (let i = 0; i < 200; i++) (step(0.012), draw());
  });
</script>
