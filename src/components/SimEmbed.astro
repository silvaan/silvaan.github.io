---
/**
 * A live simulator inside a post: `<SimEmbed sim="calculus/derivative-limit" />`.
 * The sim page runs in an iframe with ?embed, which hides the site chrome and
 * reports its height so the frame never scrolls.
 */
import { sim as find } from '../data/explore';

interface Props {
  /** `<area>/<slug>` of the simulator. */
  sim: string;
  /** Optional state from the sim's Link button, e.g. "h=0.4&zoom=1". */
  state?: string;
  caption?: string;
}
const { sim, state, caption } = Astro.props;
const entry = find(sim);
if (!entry) throw new Error(`SimEmbed: no simulator "${sim}"`);
const src = `${entry.href}?embed${state ? '&' + state : ''}`;
---

<figure class="sim-embed" style={`--area:${entry.color}`}>
  <iframe src={src} title={entry.title} loading="lazy" data-path={entry.href}></iframe>
  <figcaption>
    <span>{caption ?? entry.title}</span>
    <a href={entry.href}>Open full simulation ↗</a>
  </figcaption>
</figure>

<script>
  window.addEventListener('message', (e) => {
    if (e.origin !== location.origin || e.data?.type !== 'sim-embed-height') return;
    document.querySelectorAll<HTMLIFrameElement>('.sim-embed iframe').forEach((f) => {
      if (f.contentWindow === e.source) f.style.height = `${Math.ceil(e.data.h)}px`;
    });
  });
</script>
