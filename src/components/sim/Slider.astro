---
/** A range input with its live value; the sim wires it with `slider()` from lib/panel. */
interface Props {
  id: string;
  label: string;
  min: number | string;
  max: number | string;
  step?: number | string;
  value: number | string;
  /** Initial text of the value readout, when it is not just the raw value. */
  display?: string;
  /** Words under the two ends of the track. */
  hint?: [string, string];
}
const { id, label, min, max, step = 1, value, display, hint } = Astro.props;
---

<div class="control">
  <label for={id}><span set:html={label} /> <b id={`${id}val`}>{display ?? value}</b></label>
  <input type="range" id={id} min={min} max={max} step={step} value={value} />
  {hint && <div class="scale-hint"><span>{hint[0]}</span><span>{hint[1]}</span></div>}
</div>
