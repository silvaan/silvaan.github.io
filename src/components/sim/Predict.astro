---
/**
 * Ask before showing. Wrap a What-to-observe item: the question and its
 * choices come first, the explanation (the slot) stays hidden until a choice
 * is made, and then the item's "show me" runs so the answer appears on the
 * stage. Any pick reveals; the right one is marked either way.
 */
interface Props {
  /** The question, in a sentence. */
  q: string;
  options: string[];
  /** Index of the right option. */
  answer: number;
  /** The Try id to run once answered. */
  run?: string;
}
const { q, options, answer, run } = Astro.props;
---

<div class="predict" data-answer={answer} data-run={run}>
  <p class="predict-q"><span>Predict</span>{q}</p>
  <div class="predict-options" role="group" aria-label="Choose an answer">
    {options.map((o, i) => <button type="button" data-i={i}>{o}</button>)}
  </div>
  <div class="predict-reveal" hidden>
    <slot />
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.predict').forEach((box) => {
    const answer = Number(box.dataset.answer);
    const reveal = box.querySelector<HTMLElement>('.predict-reveal')!;
    const buttons = Array.from(box.querySelectorAll<HTMLButtonElement>('.predict-options button'));
    for (const b of buttons)
      b.addEventListener('click', () => {
        const i = Number(b.dataset.i);
        for (const o of buttons) {
          o.disabled = true;
          const n = Number(o.dataset.i);
          if (n === answer) o.classList.add('right');
          else if (n === i) o.classList.add('wrong');
        }
        box.classList.add(i === answer ? 'got-it' : 'missed');
        reveal.hidden = false;
        const run = box.dataset.run;
        if (run) box.querySelector<HTMLButtonElement>(`button[data-try="${run}"]`)?.click();
      });
  });
</script>
