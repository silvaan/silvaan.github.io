---
/**
 * A "show me" button at the end of a What-to-observe item. It sets the sim up
 * so the thing the item describes is on screen; the sim wires it with
 * `tries()` from lib/panel.
 */
interface Props {
  id: string;
  label?: string;
}
const { id, label = 'Show me' } = Astro.props;
---

<button type="button" class="try" data-try={id}>{label}</button>
