---
/**
 * Label / value rows. With a `title` they collapse into a details block, which
 * is the rule once there are more than four of them or the values are only
 * there for checking. Extra content (a table, a note) goes in the slot.
 */
interface Props {
  rows: { id: string; label: string }[];
  title?: string;
  open?: boolean;
}
const { rows, title, open = false } = Astro.props;
---

{
  title ? (
    <details class="numeric-details" open={open}>
      <summary>{title}</summary>
      <div class="readout">
        {rows.map((r) => (
          <div class="row"><span set:html={r.label} /><b id={r.id}>—</b></div>
        ))}
      </div>
      <slot />
    </details>
  ) : (
    <div class="readout">
      {rows.map((r) => (
        <div class="row"><span set:html={r.label} /><b id={r.id}>—</b></div>
      ))}
    </div>
  )
}
