---
/** A segmented choice; the sim wires it with `segmented()` from lib/panel. */
interface Props {
  id: string;
  label?: string;
  options: { value: string; label: string }[];
  active?: string;
  /** Name of the data attribute carrying the value, e.g. "p" for data-p. */
  attr?: string;
}
const { id, label, options, active = options[0]?.value, attr = 'v' } = Astro.props;
---

<div class="control">
  {label && <span class="section-label">{label}</span>}
  <div class="seg" id={id}>
    {
      options.map((o) => (
        <button
          type="button"
          {...{ [`data-${attr}`]: o.value }}
          class:list={{ active: o.value === active }}
          aria-pressed={String(o.value === active)}
          set:html={o.label}
        />
      ))
    }
  </div>
</div>
