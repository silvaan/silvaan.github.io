---
/** A group of on/off switches; the sim wires each with `check()` from lib/panel. */
interface Props {
  label?: string;
  items: { id: string; label: string; checked?: boolean }[];
}
const { label, items } = Astro.props;
---

<div class="control">
  {label && <span class="section-label">{label}</span>}
  <div class="checks">
    {
      items.map((i) => (
        <label class="check">
          <input type="checkbox" id={i.id} checked={i.checked} />
          <span set:html={i.label} />
        </label>
      ))
    }
  </div>
</div>
