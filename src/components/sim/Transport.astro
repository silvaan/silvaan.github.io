---
/**
 * Run / Step / Reset, with the ids the keyboard shortcuts click. A one-shot
 * animation passes `animate` with its label instead of a Run/Pause toggle.
 * Extra sim-specific buttons go in the slot.
 */
interface Props {
  run?: boolean;
  /** Whether the sim starts running, so the button reads "Pause". */
  running?: boolean;
  animate?: string;
  step?: boolean;
  reset?: boolean;
}
const { run = true, running = false, animate, step = false, reset = true } = Astro.props;
---

<div class="actions">
  {
    animate ? (
      <button type="button" class="btn" id="run">{animate}</button>
    ) : (
      run && (
        <button type="button" class="btn" id="run" aria-pressed={String(running)}>
          {running ? 'Pause' : 'Run'}
        </button>
      )
    )
  }
  {step && <button type="button" class="btn ghost" id="step">Step</button>}
  {reset && <button type="button" class="btn ghost" id="reset">Reset</button>}
  <slot />
</div>
