---
/**
 * The entries of a small matrix (or a pair of vectors) as sliders laid out in
 * the matrix's own shape, optionally with the matrix printed above them. The
 * sim wires them with `matrix()` from lib/panel.
 */
interface Props {
  label?: string;
  entries: { id: string; label: string; value: number }[];
  min?: number;
  max?: number;
  step?: number;
  /** Print the current matrix in brackets above the sliders. */
  view?: boolean;
}
const { label, entries, min = -3, max = 3, step = 0.05, view = false } = Astro.props;
---

<div class="control">
  {label && <span class="section-label" set:html={label} />}
  {
    view && (
      <div class="matrix-view" aria-label="current matrix">
        <span class="bracket" aria-hidden="true"></span>
        <div class="matrix-cells">{entries.map((e) => <b id={`m-${e.id}`}>{e.value.toFixed(2)}</b>)}</div>
        <span class="bracket" aria-hidden="true"></span>
      </div>
    )
  }
  <div class="mgrid">
    {
      entries.map((e) => (
        <div>
          <label for={e.id}>{e.label} <b id={`${e.id}val`}>{e.value.toFixed(2)}</b></label>
          <input type="range" id={e.id} min={min} max={max} step={step} value={e.value} />
        </div>
      ))
    }
  </div>
</div>
