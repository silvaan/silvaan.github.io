---
/**
 * The headline number under the stage: a label, the value, a status and one
 * sentence. The sim fills it with `result()` from lib/panel.
 */
interface Props {
  label: string;
  id?: string;
}
const { label, id = 'result' } = Astro.props;
---

<div class="result-strip" id={id} aria-live="polite">
  <div>
    <span class="section-label" id={`${id}-label`} set:html={label} />
    <strong id={`${id}-value`}>—</strong>
  </div>
  <div>
    <b id={`${id}-status`}>—</b>
    <p id={`${id}-note`}></p>
  </div>
</div>
