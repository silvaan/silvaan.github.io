---
/** Legend and interaction hint directly under the stage. */
interface Props {
  legend?: { label: string; color: string; id?: string }[];
  hint?: string;
  /** Id of the hint paragraph, for sims that rewrite it; pages with two captions pass distinct ids. */
  hintId?: string;
}
const { legend, hint, hintId = 'scene-hint' } = Astro.props;
---

<div class="scene-caption">
  {
    legend && (
      <div class="legend">
        {legend.map((l) => <span id={l.id} style={`--dot:${l.color}`} set:html={l.label} />)}
      </div>
    )
  }
  {hint && <p id={hintId}>{hint}</p>}
</div>
