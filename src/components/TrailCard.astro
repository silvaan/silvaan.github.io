---
import { sim, type Trail } from '../data/explore';

interface Props {
  trail: Trail;
}
const { trail } = Astro.props;
const steps = trail.steps.map((k) => sim(k)!).filter(Boolean);
---

<article class="trail-card" id={`path-${trail.slug}`}>
  <header>
    <h3>{trail.title}</h3>
    <p>{trail.blurb}</p>
  </header>
  <ol class="trail-steps">
    {
      steps.map((s) => (
        <li style={`--area:${s.color}`}>
          <a href={s.href}>{s.title}</a>
        </li>
      ))
    }
  </ol>
  <a class="trail-start" href={steps[0].href}>Start with {steps[0].title} →</a>
</article>
