---
import { sim, type Trail } from '../data/explore';

interface Props {
  trail: Trail;
  /** One short card: title, blurb, a dot per step. For the home page. */
  compact?: boolean;
}
const { trail, compact = false } = Astro.props;
const steps = trail.steps.map((k) => sim(k)!).filter(Boolean);
---

{
  compact ? (
    <a class="trail-card trail-mini" href={steps[0].href}>
      <h3>{trail.title}</h3>
      <p>{trail.blurb}</p>
      <span class="trail-mini-foot">
        <span class="trail-dots" aria-hidden="true">
          {steps.map((s) => (
            <i style={`--area:${s.color}`} />
          ))}
        </span>
        {steps.length} sims · Start →
      </span>
    </a>
  ) : (

<article class="trail-card" id={`path-${trail.slug}`}>
  <header>
    <h3>{trail.title}</h3>
    <p>{trail.blurb}</p>
  </header>
  <ol class="trail-steps">
    {
      steps.map((s) => (
        <li style={`--area:${s.color}`}>
          <a href={s.href}>{s.title}</a>
        </li>
      ))
    }
  </ol>
  <a class="trail-start" href={steps[0].href}>Start with {steps[0].title} →</a>
</article>
  )
}
