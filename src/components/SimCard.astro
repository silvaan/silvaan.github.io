---
import { areaIcon, isNew, type SimEntry } from '../data/explore';

interface Props {
  sim: SimEntry;
  /** Show the area name above the title (for mixed lists like "New"). */
  showArea?: boolean;
}
const { sim, showArea = false } = Astro.props;
---

<a class="sim-card" href={sim.href} style={`--area:${sim.color}`}>
  <div class="sim-thumb">
    {
      sim.thumb ? (
        <>
          <img class="thumb-dark" src={sim.thumb.dark} alt="" loading="lazy" decoding="async" width="560" height="350" />
          <img class="thumb-light" src={sim.thumb.light} alt="" loading="lazy" decoding="async" width="560" height="350" />
        </>
      ) : (
        <span class="sim-thumb-empty" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
            <path d={areaIcon(sim.area)} />
          </svg>
        </span>
      )
    }
    {isNew(sim) && <span class="sim-new">new</span>}
  </div>
  <div class="sim-card-body">
    {showArea && <span class="sim-card-area">{sim.area.title}</span>}
    <h3>{sim.title}</h3>
    <p>{sim.description}</p>
  </div>
</a>
