---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    {import.meta.env.PROD && (
      <script is:inline data-goatcounter="https://silvaan.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
    )}
  </head>
  <body>
    <Header />
    <main>
      <div class={`container${wide ? ' container-wide' : ''}`}>
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
