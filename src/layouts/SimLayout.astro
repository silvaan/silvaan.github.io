---
import BaseLayout from './BaseLayout.astro';
import { getArea } from '../data/tools';

type Shortcut = 'run' | 'animate' | 'step' | 'reset' | 'fullscreen';

interface Props {
  areaSlug: string;
  title: string;
  description: string;
  /** Which of the shared keyboard shortcuts this sim actually supports. */
  shortcuts?: Shortcut[];
  /**
   * The standard page format: equation and tools in a header row above the
   * canvas, result strip under it, panel built from the sim components.
   * Pass false to keep the older floating toolbar.
   */
  standard?: boolean;
}

const SHORTCUTS: Record<Shortcut, [key: string, does: string]> = {
  run: ['space', 'run/pause'],
  animate: ['space', 'animate'],
  step: ['s', 'step'],
  reset: ['r', 'reset'],
  fullscreen: ['f', 'fullscreen'],
};

const {
  areaSlug,
  title,
  description,
  shortcuts = ['run', 'step', 'reset', 'fullscreen'],
  standard = true,
} = Astro.props;
const area = getArea(areaSlug);
const hasObserve = Astro.slots.has('observe');
---

<BaseLayout title={title} description={description} wide>
  <div class="breadcrumb">
    <a href="/simulations">Simulations</a>
    <span>/</span>
    <a href={`/simulations/${areaSlug}`}>{area?.title ?? areaSlug}</a>
    <span>/</span>
    <span>{title}</span>
  </div>

  <div class="page-head">
    <span class="eyebrow">{area?.title ?? 'Simulator'}</span>
    <h1>{title}</h1>
    <p class="lead">{description}</p>
  </div>

  <div data-sim-format={standard ? 'standard' : 'classic'}>
    <slot />
  </div>

  {
    hasObserve && (
      <section class="observe">
        <h2>What to observe</h2>
        <ol>
          <slot name="observe" />
        </ol>
      </section>
    )
  }

  <p class="sim-hint">
    Shortcuts:
    {shortcuts.map((name, i) => (
      <>
        {i > 0 && ' · '}
        <kbd>{SHORTCUTS[name][0]}</kbd> {SHORTCUTS[name][1]}
      </>
    ))}
  </p>
</BaseLayout>

<script>
  import { initStageChrome } from '../lib/sim';
  initStageChrome();
</script>

<style>
  .sim-hint {
    margin-top: 18px;
    font-size: 0.8rem;
    color: var(--text-faint);
  }
  .sim-hint kbd {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    padding: 1px 6px;
    border: 1px solid var(--border);
    border-bottom-width: 2px;
    border-radius: 5px;
    background: var(--surface);
    color: var(--text-muted);
  }
</style>
