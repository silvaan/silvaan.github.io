---
import BaseLayout from './BaseLayout.astro';
import { getArea } from '../data/tools';

interface Props {
  areaSlug: string;
  title: string;
  description: string;
}

const { areaSlug, title, description } = Astro.props;
const area = getArea(areaSlug);
const hasObserve = Astro.slots.has('observe');
---

<BaseLayout title={title} description={description} wide>
  <div class="breadcrumb">
    <a href="/simulations">Simulations</a>
    <span>/</span>
    <a href={`/simulations/${areaSlug}`}>{area?.title ?? areaSlug}</a>
    <span>/</span>
    <span>{title}</span>
  </div>

  <div class="page-head">
    <span class="eyebrow">{area?.title ?? 'Simulator'}</span>
    <h1>{title}</h1>
    <p class="lead">{description}</p>
  </div>

  <slot />

  {
    hasObserve && (
      <section class="observe">
        <h2>What to observe</h2>
        <ol>
          <slot name="observe" />
        </ol>
      </section>
    )
  }

  <p class="sim-hint">
    Shortcuts: <kbd>space</kbd> run/pause · <kbd>s</kbd> step · <kbd>r</kbd> reset
    · <kbd>f</kbd> fullscreen
  </p>
</BaseLayout>

<script>
  import { initStageChrome } from '../lib/sim';
  initStageChrome();
</script>

<style>
  .sim-hint {
    margin-top: 18px;
    font-size: 0.8rem;
    color: var(--text-faint);
  }
  .sim-hint kbd {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    padding: 1px 6px;
    border: 1px solid var(--border);
    border-bottom-width: 2px;
    border-radius: 5px;
    background: var(--surface);
    color: var(--text-muted);
  }
</style>
