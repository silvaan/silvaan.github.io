---
import BaseLayout from './BaseLayout.astro';
import { getArea } from '../data/tools';
import { sim, trailsFor, areaNeighbours, areaColor } from '../data/explore';

type Shortcut = 'run' | 'animate' | 'step' | 'reset' | 'fullscreen';

interface Props {
  areaSlug: string;
  title: string;
  description: string;
  /** Which of the shared keyboard shortcuts this sim actually supports. */
  shortcuts?: Shortcut[];
  /**
   * The standard page format: equation and tools in a header row above the
   * canvas, result strip under it, panel built from the sim components.
   * Pass false to keep the older floating toolbar.
   */
  standard?: boolean;
}

const SHORTCUTS: Record<Shortcut, [key: string, does: string]> = {
  run: ['space', 'run/pause'],
  animate: ['space', 'animate'],
  step: ['s', 'step'],
  reset: ['r', 'reset'],
  fullscreen: ['f', 'fullscreen'],
};

const {
  areaSlug,
  title,
  description,
  shortcuts = ['run', 'step', 'reset', 'fullscreen'],
  standard = true,
} = Astro.props;
const area = getArea(areaSlug);
const hasObserve = Astro.slots.has('observe');

const key = Astro.url.pathname.replace(/^\/simulations\//, '').replace(/\/$/, '');
const me = sim(key);
const paths = trailsFor(key);
const around = paths.length ? {} : areaNeighbours(key);
---

<BaseLayout title={title} description={description} wide image={me?.og} mainClass="sim-main">
  <div class="sim-page" style={`--area:${areaColor(areaSlug)}`}>
    <div class="sim-top">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/simulations">Simulations</a>
        <span>/</span>
        <a href={`/simulations/${areaSlug}`} class="crumb-area">{area?.title ?? areaSlug}</a>
      </nav>
      <button type="button" class="classroom-btn" data-classroom title="Classroom mode (c)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="12" rx="1.5"></rect>
          <path d="M12 16v4 M8 20h8"></path>
        </svg>
        <span class="classroom-on">Classroom</span>
        <span class="classroom-off">Exit classroom</span>
      </button>
    </div>

    <div class="page-head sim-head">
      <h1>{title}</h1>
      <p class="lead">{description}</p>
    </div>

    <div data-sim-format={standard ? 'standard' : 'classic'}>
      <slot />
    </div>

    <template id="stage-tools-tpl">
      <div class="stage-tools">
        <button type="button" data-share aria-label="Copy shareable link" title="Copy link to this setup">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 15l6-6 M11 6l.5-.5a3.5 3.5 0 0 1 5 5l-1.5 1.5 M13 18l-.5.5a3.5 3.5 0 0 1-5-5L9 12"></path></svg>
          <span class="share-label">Link</span>
        </button>
        <button type="button" data-fullscreen aria-label="Toggle fullscreen" title="Fullscreen (f)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9V5a1 1 0 0 1 1-1h4 M20 9V5a1 1 0 0 0-1-1h-4 M4 15v4a1 1 0 0 0 1 1h4 M20 15v4a1 1 0 0 0-1 1h-4"></path></svg>
        </button>
      </div>
    </template>
    <script is:inline>
      // Put the stage header (equation slot and tools) in place while the page
      // is still being parsed, with room held for the equation, so nothing
      // below it moves when the sim's script arrives and typesets it.
      (function () {
        var stage = document.querySelector('[data-sim-format] .sim-stage');
        var tpl = document.getElementById('stage-tools-tpl');
        if (!stage || !tpl || stage.querySelector('.stage-tools')) return;
        var tools = tpl.content.firstElementChild.cloneNode(true);
        if (!stage.closest('[data-sim-format="standard"]')) {
          stage.appendChild(tools);
          return;
        }
        var head = document.createElement('div');
        head.className = 'stage-head';
        var eq = document.createElement('div');
        eq.className = 'stage-eq';
        head.append(eq, tools);
        stage.insertBefore(head, stage.firstChild);
        stage.classList.add('eq-pending');
      })();
    </script>

    {
      hasObserve && (
        <section class="observe" data-observe>
          <div class="observe-head">
            <h2>What to observe</h2>
            <div class="observe-nav" hidden>
              <button type="button" data-step="-1" aria-label="Previous">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
              </button>
              <span class="observe-count" aria-live="polite"></span>
              <button type="button" data-step="1" aria-label="Next">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
              </button>
            </div>
          </div>
          <ol>
            <slot name="observe" />
          </ol>
          <div class="observe-dots" hidden></div>
        </section>
      )
    }
    <script is:inline>
      // The prompts go under the controls, beside the canvas, so "Show me" is
      // pressed next to what it changes. Done during parsing so it never jumps.
      // (Classic pages float their panel over a fullscreen stage and style it
      // as a direct child of .sim, so they keep the prompts below.)
      (function () {
        var observe = document.querySelector('[data-observe]');
        var sim = document.querySelector('[data-sim-format="standard"] .sim');
        var panel = sim && sim.querySelector(':scope > .sim-panel');
        if (!observe || !panel) return;
        var side = document.createElement('div');
        side.className = 'sim-side';
        panel.replaceWith(side);
        side.append(panel, observe);
      })();
    </script>

    <nav class="sim-next" aria-label="Where to go next">
      {
        paths.map(({ trail, index, prev, next }) => (
          <div class="sim-next-row">
            <div class="sim-next-label">
              <span>Path</span>
              <a href={`/simulations#path-${trail.slug}`}>{trail.title}</a>
              <ol class="sim-next-dots" aria-label={`Step ${index + 1} of ${trail.steps.length}`}>
                {trail.steps.map((k, i) => {
                  const s = sim(k)!;
                  return (
                    <li class={i === index ? 'here' : i < index ? 'done' : ''} style={`--area:${s.color}`}>
                      <a href={s.href} title={s.title} aria-current={i === index ? 'page' : undefined}>
                        <span class="sr-only">{s.title}</span>
                      </a>
                    </li>
                  );
                })}
              </ol>
            </div>
            <div class="sim-next-links">
              {prev ? (
                <a class="prev" href={prev.href} style={`--area:${prev.color}`}>
                  <small>← Before</small>
                  {prev.title}
                </a>
              ) : (
                <span />
              )}
              {next && (
                <a class="next" href={next.href} style={`--area:${next.color}`}>
                  <small>Next →</small>
                  {next.title}
                </a>
              )}
            </div>
          </div>
        ))
      }
      {
        !paths.length && around.prev && around.next && around.prev !== me && (
          <div class="sim-next-row">
            <div class="sim-next-label">
              <span>More in</span>
              <a href={`/simulations/${areaSlug}`}>{area?.title}</a>
            </div>
            <div class="sim-next-links">
              <a class="prev" href={around.prev.href}>
                <small>← Previous</small>
                {around.prev.title}
              </a>
              {around.next !== around.prev && (
                <a class="next" href={around.next.href}>
                  <small>Next →</small>
                  {around.next.title}
                </a>
              )}
            </div>
          </div>
        )
      }
    </nav>

    <p class="sim-hint">
      Shortcuts:
      {shortcuts.map((name, i) => (
        <>
          {i > 0 && ' · '}
          <kbd>{SHORTCUTS[name][0]}</kbd> {SHORTCUTS[name][1]}
        </>
      ))}
      {' · '}<kbd>c</kbd> classroom · <kbd>/</kbd> search
    </p>
  </div>
</BaseLayout>

<script>
  import { initStageChrome } from '../lib/sim';
  import { holdTallest } from '../lib/stable';
  initStageChrome();

  const root = document.documentElement;
  const sim = document.querySelector<HTMLElement>('.sim');
  const observe = document.querySelector<HTMLElement>('[data-observe]');

  // A page that never typesets an equation gives back the room held for one.
  addEventListener('load', () =>
    setTimeout(() => document.querySelector('.sim-stage.eq-pending')?.classList.remove('eq-pending'), 1500)
  );

  /* ---------- What to observe: one item at a time ---------- */
  if (observe) {
    const items = Array.from(observe.querySelectorAll<HTMLLIElement>(':scope > ol > li'));
    if (items.length > 1) {
      const nav = observe.querySelector<HTMLElement>('.observe-nav')!;
      const count = observe.querySelector<HTMLElement>('.observe-count')!;
      const dots = observe.querySelector<HTMLElement>('.observe-dots')!;
      let at = 0;
      dots.innerHTML = items
        .map((_, i) => `<button type="button" aria-label="Item ${i + 1}" data-go="${i}"></button>`)
        .join('');
      const show = (i: number) => {
        at = (i + items.length) % items.length;
        items.forEach((li, j) => li.classList.toggle('on', j === at));
        dots.querySelectorAll('button').forEach((d, j) => d.classList.toggle('on', j === at));
        count.textContent = `${at + 1} / ${items.length}`;
      };
      observe.classList.add('stepped');
      nav.hidden = false;
      dots.hidden = false;
      nav.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
        b.addEventListener('click', () => show(at + Number(b.dataset.step)))
      );
      dots.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-go]');
        if (b) show(Number(b.dataset.go));
      });
      show(0);
      // as tall as the tallest item, so stepping never changes its height
      holdTallest(observe.querySelector('ol')!, items, 'on');
    }
  }

  /* ---------- classroom mode: the stage, the rule and the prompt, big ---------- */
  const toggleClassroom = (on = !root.classList.contains('classroom')) => {
    root.classList.toggle('classroom', on);
    // canvases sized from their box need a nudge to repaint at the new size
    window.dispatchEvent(new Event('resize'));
  };
  document.querySelector('[data-classroom]')?.addEventListener('click', () => toggleClassroom());
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable)) return;
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.key === 'c' || e.key === 'C') toggleClassroom();
    else if (e.key === 'Escape' && root.classList.contains('classroom') && !document.fullscreenElement)
      toggleClassroom(false);
  });

  /* ---------- phones: keep the stage in view while the controls scroll ---------- */
  const stage = sim?.querySelector<HTMLElement>(':scope > .sim-view > .sim-stage');
  if (stage) {
    const fit = () => {
      const narrow = innerWidth <= 820;
      // only when it leaves at least half the screen for the controls
      root.classList.toggle('sticky-stage', narrow && stage.offsetHeight < innerHeight * 0.5);
    };
    fit();
    new ResizeObserver(fit).observe(stage);
    addEventListener('resize', fit);
  }

  /* ---------- embedded in a post: tell the host page how tall we are ---------- */
  if (root.classList.contains('embed') && parent !== window) {
    const send = () =>
      parent.postMessage({ type: 'sim-embed-height', path: location.pathname, h: document.documentElement.scrollHeight }, '*');
    new ResizeObserver(send).observe(document.body);
    send();
  }
</script>

<style>
  .sim-hint {
    margin-top: 18px;
    font-size: 0.8rem;
    color: var(--text-faint);
  }
  .sim-hint kbd {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    padding: 1px 6px;
    border: 1px solid var(--border);
    border-bottom-width: 2px;
    border-radius: 5px;
    background: var(--surface);
    color: var(--text-muted);
  }
</style>
